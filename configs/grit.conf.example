# griTTYkit example build configuration
# Copy to configs/grit.conf or generate with: make menuconfig

# Active target tuple. Presets populate these fields; the tuple is the source of truth.
GRIT_TARGET_PRESET="glinet-mt7621-openwrt-musl"
GRIT_TARGET_NAME=""
GRIT_TARGET_ARCH="mipsel"
GRIT_TARGET_ENDIAN="little"
GRIT_TARGET_CPU="mips32r2-24kc"
GRIT_TARGET_ABI="default"
GRIT_TARGET_LIBC="musl"
GRIT_KERNEL_FLOOR="4.x"
GRIT_STATIC_POLICY="static-preferred"
GRIT_PAYLOAD_TIER="debug"
GRIT_TARGET_QEMU_USER="qemu-mipsel-static"

# Target presets to build when running normal make package without TARGET=.
GRIT_TARGETS="glinet-mt7621-openwrt-musl"

GRIT_PAYLOAD_FORMAT="tgz"
GRIT_PAYLOAD_VERSION="dev"
GRIT_PAYLOAD_PRESET="ssh-operator"
GRIT_RUNTIME_MODE="extract"
GRIT_NORESIDUE_LEVEL="best-effort"
GRIT_RUNTIME_ROOT="./.grit"
GRIT_RUNTIME_ALLOW_FALLBACK_ROOT="no"
GRIT_RUNTIME_FALLBACK_ROOT="/tmp/.grit"
GRIT_RUNTIME_ALLOW_EXTERNAL_WRITES="no"
GRIT_BUILD_INTERNAL_CORE="no"
GRIT_ZERO_ARG_MODE="help"
GRIT_ZERO_ARG_LOG_MODE="quiet"
GRIT_ZERO_ARG_CUSTOM_COMMAND=""
GRIT_TRAILER_OVERRIDES_ENABLE="yes"
GRIT_TRAILER_OVERRIDE_CATEGORIES="runtime operator launch retry"
GRIT_TRAILER_OBFUSCATION="none"
GRIT_TRAILER_XOR_KEY=""
GRIT_RSHELL_TRANSPORT="ssh"
GRIT_RSHELL_AUTHKEYS_MODE="disabled"
GRIT_RSHELL_RUN_MODE="auto"
GRIT_RSHELL_SESSION_POLICY="single"
GRIT_RSHELL_GENERATE_HOSTKEY_IF_MISSING="no"
GRIT_RSHELL_SOCAT_PORT="22203"
GRIT_BUILTIN_TLS_ENABLE="no"
GRIT_AUTORUN_GUARD_ENABLE="yes"
GRIT_AUTORUN_GUARD_PATH="./.grit/autorun"
GRIT_AUTORUN_REENTRY_ACTION="status"
GRIT_AUTORUN_STALE_LOCK_POLICY="recover"
GRIT_OPERATOR_SERVER_HOST=""
GRIT_OPERATOR_SERVER_USER="operator"
GRIT_OPERATOR_SERVER_SSH_PORT="22202"
GRIT_OPERATOR_REMOTE_FORWARD_PORT="2200"
GRIT_OPERATOR_TARGET_DROPBEAR_PORT="2222"
GRIT_OPERATOR_TARGET_BIND_HOST="127.0.0.1"
GRIT_OPERATOR_DBCLIENT_IDENTITY_FILE=""
GRIT_OPERATOR_AUTHORIZED_KEY_FILE=""
GRIT_OPERATOR_KNOWN_HOSTS_POLICY="off"
GRIT_OPERATOR_FILE_SERVICE_ENABLE="no"
GRIT_OPERATOR_FILE_SERVICE_PORT="22204"
GRIT_OPERATOR_FILE_SERVICE_TLS="yes"
GRIT_COMMAND_QUEUE_ENABLE="no"
GRIT_COMMAND_QUEUE_PORT="22205"
GRIT_COMMAND_QUEUE_TLS="yes"
GRIT_COMMAND_QUEUE_REQUIRE_TOKEN="yes"
GRIT_COMMAND_QUEUE_TOKEN_SOURCE="manual"
GRIT_COMMAND_QUEUE_TOKEN=""
GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS="none"
GRIT_COMMAND_QUEUE_EXECUTION="metadata-only"
GRIT_COMMAND_QUEUE_ALLOW_ARBITRARY="no"
GRIT_COMMAND_QUEUE_POLL_INTERVAL_SEC="5"
GRIT_COMMAND_QUEUE_POLL_JITTER_PCT="0"
GRIT_COMMAND_QUEUE_POLL_BACKOFF="none"
GRIT_COMMAND_QUEUE_POLL_MAX_INTERVAL_SEC="300"
GRIT_COMMAND_QUEUE_MAX_POLLS="0"
GRIT_SERVER_CONFIG_PATH="local/server-config.json"
GRIT_BUSYBOX_GROUPS="shell fileops disk process network text system"
GRIT_HEAVY_TOOLS=""
GRIT_DROPBEAR_SERVER_MODE="no"
GRIT_BUSYBOX_APPLETS=""
GRIT_BUSYBOX_APPLET_OVERRIDES=""
GRIT_DOTFILES_ENABLE="yes"
GRIT_DOTFILE_ZSH_MODE="default"
GRIT_DOTFILE_ZSH_USER_FILE=""
GRIT_DOTFILE_BASH_MODE="default"
GRIT_DOTFILE_BASH_USER_FILE=""
GRIT_DOTFILE_TMUX_MODE="default"
GRIT_DOTFILE_TMUX_USER_FILE=""
GRIT_DOTFILE_GDB_MODE="default"
GRIT_DOTFILE_GDB_USER_FILE=""
GRIT_DOTFILE_PROFILE_MODE="default"
GRIT_DOTFILE_PROFILE_USER_FILE=""
GRIT_DROPBEAR_LISTEN_PORT="22"
GRIT_DROPBEAR_AUTHORIZED_KEYS_FILE=""
GRIT_DROPBEAR_KEYTYPES="rsa ecdsa"
GRIT_DROPBEAR_NO_PASSWORD_AUTH="no"
GRIT_DROPBEAR_NO_ROOT_PASSWORD="no"
GRIT_DROPBEAR_PREGENERATE_HOSTKEY="no"
GRIT_GDBSERVER_PROVIDER="auto"
GRIT_GDBSERVER_USER_PATH=""
GRIT_DOOM_WAD_PATH=""
GRIT_RECOVERY_BINARY_NAME="grit_recovery"
