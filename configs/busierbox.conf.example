# BusierBox example build configuration
# Copy to configs/busierbox.conf or generate with: make menuconfig

# Active target tuple. Presets populate these fields; the tuple is the source of truth.
BB_TARGET_PRESET="glinet-mt7621-openwrt-musl"
BB_TARGET_NAME=""
BB_TARGET_ARCH="mipsel"
BB_TARGET_ENDIAN="little"
BB_TARGET_CPU="mips32r2-24kc"
BB_TARGET_ABI="default"
BB_TARGET_LIBC="musl"
BB_KERNEL_FLOOR="4.x"
BB_STATIC_POLICY="static-preferred"
BB_PAYLOAD_TIER="debug"
BB_TARGET_QEMU_USER="qemu-mipsel-static"

# Target presets to build when running normal make package without TARGET=.
BB_TARGETS="glinet-mt7621-openwrt-musl"

BB_PAYLOAD_FORMAT="tgz"
BB_PAYLOAD_VERSION="dev"
BB_BUILD_FULL="yes"
BB_BUILD_STAGER="yes"
BB_BUILD_INTERNAL_CORE="no"
BB_STAGER_INCLUDE_SURVEY="yes"
BB_STAGER_INCLUDE_DOCTOR="yes"
BB_STAGER_INCLUDE_CONFIG_INFO="yes"
BB_STAGER_INCLUDE_EXTRACT="yes"
BB_STAGER_INCLUDE_MINIMAL_BUSYBOX="no"
BB_STAGER_INCLUDE_WGET="no"
BB_STAGER_INCLUDE_CURL="no"
BB_STAGER_INCLUDE_NC="no"
BB_STAGER_FETCH_FULL="yes"
BB_STAGER_CALLBACK_ENABLE="no"
BB_STAGER_CALLBACK_HOST=""
BB_STAGER_CALLBACK_PORT="4444"
BB_STAGER_TOKEN=""
BB_STAGER_CONNECT_TIMEOUT="10"
BB_STAGER_RETRY_COUNT="3"
BB_STAGER_RETRY_DELAY="2"
BB_STAGER_OUTPUT_PATH="/tmp/busierbox-full"
BB_STAGER_ZERO_ARG_MODE="help"
BB_STAGER_POST_RECEIVE_ACTION="callback"
BB_STAGER_CALLBACK_SHELL="sh"
BB_FULL_ZERO_ARG_MODE="help"
BB_ZERO_ARG_CUSTOM_COMMAND=""
BB_RSHELL_MODE="ssh"
BB_AUTORUN_GUARD_ENABLE="yes"
BB_AUTORUN_GUARD_PATH="/tmp/busierbox-autorun"
BB_AUTORUN_REENTRY_ACTION="status"
BB_AUTORUN_STALE_LOCK_POLICY="recover"
BB_OPERATOR_SERVER_HOST=""
BB_OPERATOR_SERVER_USER="operator"
BB_OPERATOR_SERVER_SSH_PORT="22"
BB_OPERATOR_REMOTE_FORWARD_PORT="2200"
BB_OPERATOR_TARGET_DROPBEAR_PORT="2222"
BB_OPERATOR_TARGET_BIND_HOST="127.0.0.1"
BB_OPERATOR_DBCLIENT_IDENTITY_FILE=""
BB_OPERATOR_AUTHORIZED_KEY_FILE=""
BB_OPERATOR_KNOWN_HOSTS_POLICY="off"
BB_SERVER_CONFIG_PATH="local/server-config.json"
BB_BUSYBOX_GROUPS="shell fileops disk process network text system"
BB_HEAVY_TOOLS=""
BB_DROPBEAR_SERVER_MODE="no"
BB_BUSYBOX_APPLETS=""
BB_BUSYBOX_APPLET_OVERRIDES=""
BB_DOTFILE_PROFILE="default-comfort"
BB_DOTFILE_APPS="profile zsh tmux gdb"
BB_DOTFILE_USER_PATH=""
