#!/bin/sh
set -eu

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
MATRIX=${1:-"$ROOT/tests/matrix/targets.example.json"}
ARTIFACT_ROOT=${ARTIFACT_ROOT:-"$ROOT/tests/artifacts/qemu-user"}

. "$ROOT/tests/qemu-user/helpers.sh"

mkdir -p "$ARTIFACT_ROOT"

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "SKIP qemu-user: python3 is required to read $MATRIX"
    exit 0
fi

summary="$ARTIFACT_ROOT/summary.txt"
summary_json="$ARTIFACT_ROOT/summary.json"
: >"$summary"

python3 - "$MATRIX" <<'PY' | while IFS='	' read -r name arch binary qemu
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    data = json.load(fh)

for t in data.get("targets", []):
    print("\t".join([
        t.get("name", ""),
        t.get("arch", ""),
        t.get("binary", ""),
        t.get("qemu_user", "")
    ]))
PY
do
    artifact_dir="$ARTIFACT_ROOT/$name"
    mkdir -p "$artifact_dir"
    printf '%s\n' "qemu-user: $name"

    if [ ! -f "$ROOT/$binary" ]; then
        printf '%s\n' "SKIP $name missing binary $binary" | tee "$artifact_dir/skip.txt"
        printf '%s\n' "SKIP $name missing binary" >>"$summary"
        continue
    fi

    if ! qemu_path=$(find_qemu_user "$qemu"); then
        printf '%s\n' "SKIP $name missing interpreter $qemu" | tee "$artifact_dir/skip.txt"
        printf '%s\n' "SKIP $name missing interpreter" >>"$summary"
        continue
    fi

    if (cd "$ROOT" && tests/qemu-user/smoke.sh "$name" "$qemu_path" "$ROOT/$binary" "$artifact_dir"); then
        printf '%s\n' "PASS $name" >>"$summary"
    else
        printf '%s\n' "FAIL $name" >>"$summary"
    fi
done

cat "$summary"

python3 - "$MATRIX" "$summary" "$summary_json" "$ARTIFACT_ROOT" <<'PY'
import json
import sys
from pathlib import Path

matrix_path, summary_path, summary_json_path, artifact_root = sys.argv[1:]
with open(matrix_path, "r", encoding="utf-8") as fh:
    matrix = json.load(fh)

entries = {
    item.get("name", ""): item
    for item in matrix.get("targets", [])
    if isinstance(item, dict)
}
records = []
status_counts = {}
with open(summary_path, "r", encoding="utf-8") as fh:
    for line in fh:
        parts = line.strip().split(" ", 2)
        if len(parts) < 2:
            continue
        status = parts[0].lower()
        name = parts[1]
        reason = parts[2] if len(parts) > 2 else ""
        target = entries.get(name, {})
        rec = {
            "name": name,
            "arch": target.get("arch", ""),
            "binary": target.get("binary", ""),
            "qemu_user": target.get("qemu_user", ""),
            "status": status,
            "reason": reason,
            "artifact_dir": str(Path(artifact_root) / name),
        }
        records.append(rec)
        status_counts[status] = status_counts.get(status, 0) + 1

doc = {
    "schema": 1,
    "kind": "qemu-user",
    "matrix": matrix_path,
    "artifact_root": artifact_root,
    "summary_text": summary_path,
    "total_count": len(records),
    "status_counts": status_counts,
    "records": records,
    "records_by_name": {rec["name"]: idx for idx, rec in enumerate(records)},
    "records_by_status": {
        status: [idx for idx, rec in enumerate(records) if rec["status"] == status]
        for status in sorted(status_counts)
    },
}
Path(summary_json_path).write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
