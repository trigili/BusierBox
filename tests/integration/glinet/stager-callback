#!/bin/sh
set -eu

target=${TARGET:-mipsel-linux-4.x-musl}
router=${GLINET_HOST:-root@192.168.8.1}
server_host=${BUSIERBOX_SERVER_HOST:-}
server_port=${BUSIERBOX_SERVER_PORT:-4444}
token=${BUSIERBOX_STAGER_TOKEN:-glinet-test-token}
remote_dir=${BUSIERBOX_REMOTE_DIR:-/tmp}
remote_stager="$remote_dir/busierbox-stager"
remote_full="$remote_dir/busierbox-full"
full_artifact=${ARTIFACT:-dist/busierbox-$target-full}
stager_artifact=${STAGER_ARTIFACT:-dist/busierbox-$target-stager}

if [ -z "$server_host" ]; then
    server_host=$(scripts/list-local-ips | sed -n '1p')
fi
[ -n "$server_host" ] || {
    printf '%s\n' "stager-callback: set BUSIERBOX_SERVER_HOST; no local IP candidate found" >&2
    exit 1
}

if [ "${SKIP_BUILD:-0}" != 1 ]; then
    BB_STAGER_CALLBACK_ENABLE=yes \
    BB_STAGER_CALLBACK_HOST="$server_host" \
    BB_STAGER_CALLBACK_PORT="$server_port" \
    BB_STAGER_TOKEN="$token" \
    BB_STAGER_OUTPUT_PATH="$remote_full" \
    BB_STAGER_AUTO_EXEC=doctor \
    TARGET="$target" \
    make package-stager
    [ -f "$full_artifact" ] || VERIFY=1 make package-full TARGET="$target"
fi

[ -f "$full_artifact" ] || {
    printf '%s\n' "stager-callback: missing full artifact: $full_artifact" >&2
    exit 1
}
[ -x "$stager_artifact" ] || {
    printf '%s\n' "stager-callback: missing stager artifact: $stager_artifact" >&2
    exit 1
}

tmp=$(mktemp -d)
trap 'kill "$server_pid" 2>/dev/null || true; rm -rf "$tmp"; if [ "${KEEP_ARTIFACTS:-0}" != 1 ]; then ssh "$router" "rm -f '$remote_stager' '$remote_full'" >/dev/null 2>&1 || true; fi' EXIT HUP INT TERM
server_log="$tmp/server.log"

scripts/busierbox-server --listen "0.0.0.0:$server_port" --token "$token" \
    --artifact "$full_artifact" --remote-path "$remote_full" --send --exec-doctor --yes --once --timeout 60 \
    >"$server_log" 2>&1 &
server_pid=$!
sleep 1

ssh "$router" "cat > '$remote_stager'" <"$stager_artifact"
ssh "$router" "chmod +x '$remote_stager' && '$remote_stager' --callback-host '$server_host' --callback-port '$server_port' --token '$token' --output '$remote_full' --auto-exec doctor"
wait "$server_pid"
server_pid=

grep -q 'Token OK' "$server_log"
grep -q 'doctor exit=0' "$server_log"
printf '%s\n' "glinet stager callback ok"
