#!/bin/sh
set -eu

target=${TARGET:-glinet-mt7621-openwrt-musl}
artifact=${ARTIFACT:-}

if [ "${SKIP_BUILD:-0}" != "1" ]; then
    TARGET="$target" make package
fi

if [ -z "$artifact" ]; then
    resolved=$(scripts/lib/resolve-target "$target" | sed -n 's/^TARGET_NAME=//p')
    artifact="dist/grit-${resolved:-$target}-full"
fi

tests/integration/glinet/push-and-test "$artifact"
