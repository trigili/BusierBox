(artifact_root_path / "summary.json").write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
(artifact_root_path / "summary.txt").write_text(f"{status.upper()} {name} {reason}\n", encoding="utf-8")

artifact_manifest_records = []
for path in sorted(run_dir.iterdir()):
    if not path.is_file() or path.name == "artifact-manifest.json":
        continue
    stat = path.stat()
    artifact_manifest_records.append({
        "name": path.name,
        "path": str(path),
        "size": stat.st_size,
        "mode": f"{stat.st_mode & 0o777:04o}",
        "executable": bool(stat.st_mode & 0o111),
        "sha256": file_sha256(path),
    })
(run_dir / "artifact-manifest.json").write_text(json.dumps({
    "schema": 1,
    "kind": "qemu-flaky-network-artifact-manifest",
    "artifact_dir": str(run_dir),
    "artifact_count": len(artifact_manifest_records),
    "artifacts": artifact_manifest_records,
}, indent=2, sort_keys=True) + "\n", encoding="utf-8")

print(f"{status.upper()} {name} {reason}")
print(f"artifacts={run_dir}")
