    "    printf '%s\\n' 'usage: host-network-setup.sh [setup|cleanup|link ACTION]' >&2",
    "    exit 2",
    "    ;;",
    "esac",
    "",
])

qemu_command_script = [
    "#!/bin/sh",
    "set -eu",
    "",
    "# Per-target QEMU launch commands for the planned flaky-network lab.",
]
for target, command in sorted(qemu_command_templates.items()):
    qemu_command_script.append(f"# {target}")
    qemu_command_script.append(shlex.join(str(item) for item in command))
    qemu_command_script.append("")

def file_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


(run_dir / "topology.json").write_text(json.dumps(topology, indent=2, sort_keys=True) + "\n", encoding="utf-8")
(run_dir / "plan.json").write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")
(run_dir / "operator-commands.sh").write_text("#!/bin/sh\nset -eu\n\n" + "\n".join(operator_commands) + "\n", encoding="utf-8")
(run_dir / "target-commands.sh").write_text("#!/bin/sh\nset -eu\n\n" + "\n".join(target_commands) + "\n", encoding="utf-8")
(run_dir / "host-network-setup.sh").write_text("\n".join(host_network_script), encoding="utf-8")
(run_dir / "qemu-commands.sh").write_text("\n".join(qemu_command_script), encoding="utf-8")
for script_name in ("operator-commands.sh", "target-commands.sh", "host-network-setup.sh", "qemu-commands.sh"):
    (run_dir / script_name).chmod(0o755)
(run_dir / "link-transitions.json").write_text(json.dumps(topology["link_transitions"], indent=2, sort_keys=True) + "\n", encoding="utf-8")
(run_dir / "phase-contracts.json").write_text(json.dumps({
