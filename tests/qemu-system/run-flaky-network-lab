phase_validator_script = r'''#!/usr/bin/env python3
import argparse
import json
import sys
from pathlib import Path


def load_json(path):
    with path.open("r", encoding="utf-8") as fh:
        return json.load(fh)


def resolve_path(value, path):
    def step(current, parts):
        if not parts:
            return current
        part = parts[0]
        if part.endswith("[*]"):
            key = part[:-3]
            current = current[key] if isinstance(current, dict) else current[int(key)]
            if not isinstance(current, list):
                raise KeyError(path)
            return [step(item, parts[1:]) for item in current]
        if "[" in part and part.endswith("]"):
            key, index = part[:-1].split("[", 1)
            if key:
                current = current[key]
            current = current[int(index)]
        elif isinstance(current, dict):
            current = current[part]
        else:
            current = current[int(part)]
        return step(current, parts[1:])

    return step(value, path.split("."))


def check_value(actual, check):
    if "expect" in check:
        return actual == check["expect"]
    if "expect_at_least" in check:
        return actual >= check["expect_at_least"]
    if "expect_present" in check:
        return bool(actual) is bool(check["expect_present"])
    if "expect_all" in check:
        if not isinstance(actual, list):
            return False
        return all(item == check["expect_all"] for item in actual)
    raise KeyError("no expectation in check")


def validate_contracts(contracts):
    records = contracts.get("contracts") or []
    if contracts.get("kind") != "qemu-flaky-network-phase-contracts":
        raise AssertionError("unexpected phase contracts kind")
    if contracts.get("contract_count") != len(records):
        raise AssertionError("phase contract count mismatch")
    for rec in records:
        for key in ("phase", "link_state", "required_artifacts", "target_scope", "assertions", "evidence_checks"):
            if key not in rec:
                raise AssertionError(f"phase {rec.get('phase', '<missing>')} missing {key}")
        if not rec["assertions"]:
            raise AssertionError(f"phase {rec['phase']} has no assertions")
        if not rec["evidence_checks"]:
            raise AssertionError(f"phase {rec['phase']} has no evidence checks")


def expected_validation_records(artifact_dir, contracts):
    records = []
    for rec in contracts.get("contracts") or []:
        missing = sorted({
            check.get("artifact", "")
            for check in rec.get("evidence_checks") or []
            if check.get("artifact") and not (artifact_dir / str(check.get("artifact"))).exists()
        })
        records.append({
            "phase": rec.get("phase", ""),
            "link_state": rec.get("link_state", ""),
            "target_scope": rec.get("target_scope") or [],
            "required_artifacts": rec.get("required_artifacts") or [],
            "assertion_count": len(rec.get("assertions") or []),
            "evidence_check_count": len(rec.get("evidence_checks") or []),
            "missing_evidence_artifacts": missing,
            "missing_evidence_artifact_count": len(missing),
            "status": "pending-evidence" if missing else "ready",
        })
    return records


def validate_report(artifact_dir, contracts):
    report = load_json(artifact_dir / "validation-report.json")
    expected_records = expected_validation_records(artifact_dir, contracts)
    expected_missing = sum(rec["missing_evidence_artifact_count"] for rec in expected_records)
    expected_status = "pending-evidence" if expected_missing else "ready"
    expected_status_counts = {
        status_name: len([rec for rec in expected_records if rec.get("status") == status_name])
        for status_name in ("ready", "pending-evidence")
    }
    if report.get("kind") != "qemu-flaky-network-phase-validation-report":
        raise AssertionError("unexpected validation report kind")
    if report.get("contract_count") != contracts.get("contract_count"):
        raise AssertionError("validation report contract count mismatch")
    if report.get("phase_count") != len(expected_records):
        raise AssertionError("validation report phase count mismatch")
    if report.get("evidence_check_count") != sum(rec["evidence_check_count"] for rec in expected_records):
        raise AssertionError("validation report evidence check count mismatch")
    if report.get("missing_evidence_artifact_count") != expected_missing:
        raise AssertionError("validation report missing evidence count mismatch")
    if report.get("status") != expected_status:
        raise AssertionError("validation report status mismatch")
    if report.get("status_counts") != expected_status_counts:
        raise AssertionError("validation report status counts mismatch")
    by_phase = {rec.get("phase", ""): rec for rec in report.get("records") or []}
    if set(by_phase) != {rec.get("phase", "") for rec in expected_records}:
        raise AssertionError("validation report phase set mismatch")
    for expected in expected_records:
        actual = by_phase.get(expected["phase"]) or {}
        for key in ("link_state", "target_scope", "required_artifacts", "assertion_count",
                    "evidence_check_count", "missing_evidence_artifacts",
                    "missing_evidence_artifact_count", "status"):
            if actual.get(key) != expected.get(key):
                raise AssertionError(f"validation report {expected['phase']} {key} mismatch")


def validate_evidence(artifact_dir, contracts):
    failures = []
    for rec in contracts.get("contracts") or []:
        for check in rec.get("evidence_checks") or []:
            artifact = artifact_dir / check["artifact"]
            if not artifact.exists():
                failures.append(f"{rec['phase']}: missing {check['artifact']}")
                continue
            try:
                data = load_json(artifact)
                actual = resolve_path(data, check["path"])
                if not check_value(actual, check):
                    failures.append(f"{rec['phase']}: {check['artifact']} {check['path']} got {actual!r} for {check!r}")
            except Exception as exc:
                failures.append(f"{rec['phase']}: {check['artifact']} {check.get('path', '<path>')} failed: {exc}")
    if failures:
        raise AssertionError("\n".join(failures))


def main():
    parser = argparse.ArgumentParser(description="Validate QEMU flaky-network phase artifacts against phase-contracts.json")
    parser.add_argument("--artifact-dir", default=".", help="directory containing phase-contracts.json and phase artifacts")
    parser.add_argument("--contract-only", action="store_true", help="validate contract structure without requiring phase artifacts")
    args = parser.parse_args()
    artifact_dir = Path(args.artifact_dir)
    contracts = load_json(artifact_dir / "phase-contracts.json")
    validate_contracts(contracts)
    validate_report(artifact_dir, contracts)
    if not args.contract_only:
        validate_evidence(artifact_dir, contracts)
    print("qemu phase artifact validation ok")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"qemu phase artifact validation failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
'''

def file_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


