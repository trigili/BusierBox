    "gdbserver": {
      "providers": [
        "auto",
        "buildroot",
        "local-dropin",
        "user",
        "overlay",
        "none"
      ],
      "requires_devpts": false,
      "requires_pty": false,
      "requires_ptrace": true,
      "minimum_kernel_floor": "2.6",
      "supported_arches": [
        "mipsel",
        "mips",
        "armv7",
        "aarch64",
        "x86_64",
        "i386",
        "native"
      ],
      "unsupported_libcs": [],
      "build_failures": [
        {
          "arch": [
            "mipsel",
            "mips"
          ],
          "libc": [
            "musl"
          ],
          "reason": "Buildroot GDB 15.x BFD fails to link for mipsel/mips musl targets; gdbserver is pre-excluded in best-effort mode"
        }
      ],
      "known_provider_issues": [
        {
          "arch": [
            "mipsel",
            "mips"
          ],
          "libc": [
            "musl"
          ],
          "static_policy": [
            "static-preferred",
            "static-required"
          ],
          "provider": "buildroot",
          "severity": "warning",
          "message": "Buildroot GDB/BFD is known to fail for mipsel/mips+musl/static builds. The gdbserver Buildroot package will be pre-excluded in best-effort mode.",
          "suggested_action": "Use provider=local-dropin with local/tools/<target>/bin/gdbserver, provider=user with a pre-built static binary, or provider=overlay with the binary under your overlay root/target/bin/."
        }
      ],
      "notes": "Requires ptrace and enough target memory for debug sessions. On mipsel/mips+musl the full GDB BFD library fails to build; use STRICT_HEAVY_TOOLS=1 to treat this as a fatal error. Use GRIT_GDBSERVER_PROVIDER=local-dropin, user, or overlay to supply a pre-built binary.",
      "classification": "debug target payload",
      "expected_payload_size": "large",
      "static_constraints": "Buildroot gdbserver can be statically linked where GDB/BFD supports the tuple; local-dropin/user/overlay providers must match the target ABI."
    },
