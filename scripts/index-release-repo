#!/usr/bin/env python3
"""Index one or more BusierBox release bundles from a source checkout."""

import argparse
import hashlib
import json
import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def die(msg, code=1):
    print(f"index-release-repo: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path, fallback=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        if fallback is not None:
            return fallback
        raise


def sha256_file(path):
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def unique(items):
    out = []
    seen = set()
    for item in items:
        if item and item not in seen:
            out.append(item)
            seen.add(item)
    return out


def candidate_release_dirs(paths):
    roots = [pathlib.Path(p) for p in paths] if paths else [ROOT / "dist" / "releases"]
    out = []
    for root in roots:
        if (root / "release.json").is_file():
            out.append(root)
            continue
        if root.is_dir():
            out.extend(path for path in sorted(root.iterdir()) if (path / "release.json").is_file())
    return unique([str(path) for path in out])


def load_release_index(release_dir):
    index_path = release_dir / "release-index.json"
    if index_path.is_file():
        return load_json(index_path, {})
    release = load_json(release_dir / "release.json", {})
    rows = []
    for rec in release.get("artifacts", []):
        if rec.get("build_status") == "failed":
            continue
        summary = rec.get("tuple_summary") or {}
        rows.append({
            "artifact": rec.get("artifact"),
            "tuple_path": rec.get("tuple_path"),
            "tuple": rec.get("tuple") or {},
            "tuple_artifact": rec.get("tuple_artifact"),
            "payload_preset": rec.get("payload_preset"),
            "runtime_mode": summary.get("runtime_mode") or rec.get("runtime_mode"),
            "noresidue_level": summary.get("noresidue_level"),
            "reverse_access": summary.get("reverse_access") or {},
            "manifest": rec.get("manifest_path") or rec.get("payload_manifest_path"),
            "payload_manifest": rec.get("payload_manifest_path"),
            "tool_provider_status": summary.get("tool_provider_status") or {},
            "doom_wads": summary.get("doom_wads") or [],
            "config": rec.get("config"),
            "sha256": rec.get("sha256"),
            "size": rec.get("size"),
            "tools": unique((summary.get("busybox_applets") or []) + (summary.get("heavy_tools") or [])),
            "trailer_support": rec.get("trailer_support"),
            "compatibility": summary.get("compatibility") or {"schema": 1, "label": "exact", "reasons": []},
        })
    return {
        "schema": 1,
        "release_name": release.get("release_name"),
        "git_commit": release.get("git_commit"),
        "artifacts": rows,
        "tuples": release.get("layout", {}).get("tuples", {}),
        "devices": release.get("layout", {}).get("devices", {}),
    }


def load_release_self_test(release_dir):
    for rel in (
        "release-self-test.json",
        "self-test.json",
        "diagnostics/release-self-test.json",
        "manifests/release-self-test.json",
    ):
        path = release_dir / rel
        if not path.is_file():
            continue
        doc = load_json(path, {})
        if not isinstance(doc, dict):
            continue
        record = dict(doc)
        record["path"] = str(path)
        record["release_self_test_path"] = rel
        record["valid"] = True
        return record
    return {}


def artifact_sha(release_dir, row):
    if row.get("sha256"):
        return row.get("sha256")
    rel = row.get("artifact") or row.get("tuple_artifact")
    if not rel:
        return ""
    path = release_dir / rel
    return sha256_file(path) if path.is_file() else ""


def artifact_features(row):
    features = []
    features.extend(row.get("tools") or [])
    if row.get("payload_preset"):
        features.append(row["payload_preset"])
    transport = (row.get("reverse_access") or {}).get("transport")
    if transport:
        features.append(transport)
        features.append(f"reverse-{transport}")
    if row.get("trailer_support"):
        features.append("trailer")
    runtime = row.get("runtime_mode")
    if runtime:
        features.append(runtime)
    return unique(features)


def compatibility_rank(row):
    label = ((row.get("compatibility") or {}).get("label") or "exact")
    return {"exact": 0, "likely": 1, "heuristic": 2, "unsafe": 3, "incompatible": 4}.get(label, 5)


def recommendation_key(row):
    return (
        compatibility_rank(row),
        -(row.get("release_mtime") or 0),
        row.get("payload_preset") or "",
        row.get("artifact") or "",
    )


def best_record(rows):
    rows = list(rows or [])
    if not rows:
        return None
    return sorted(rows, key=recommendation_key)[0]


def recommendations_from_indexes(devices, indexes):
    by_device = {}
    for alias, metas in devices.items():
        allowed = {(meta.get("release_dir"), meta.get("tuple_path")) for meta in metas}
        selected = best_record(
            record
            for record in indexes["artifacts"]
            if (record.get("release_dir"), record.get("tuple_path")) in allowed
        )
        if selected:
            by_device[alias] = selected

    return {
        "schema": 1,
        "selection_policy": [
            "lowest compatibility risk label",
            "newest release_mtime",
            "payload preset name",
            "artifact path",
        ],
        "by_device": by_device,
        "by_tuple_path": {
            key: best_record(indexes["artifacts_by_tuple_path"][key])
            for key in sorted(indexes["artifacts_by_tuple_path"])
        },
        "by_tool": {
            key: best_record(indexes["artifacts_by_tool"][key])
            for key in sorted(indexes["artifacts_by_tool"])
        },
        "by_payload_preset": {
            key: best_record(indexes["artifacts_by_payload_preset"][key])
            for key in sorted(indexes["artifacts_by_payload_preset"])
        },
        "by_feature": {
            key: best_record(indexes["artifacts_by_feature"][key])
            for key in sorted(indexes["artifacts_by_feature"])
        },
        "by_tool_payload_preset": {
            key: best_record(indexes["artifacts_by_tool_payload_preset"][key])
            for key in sorted(indexes["artifacts_by_tool_payload_preset"])
        },
        "by_feature_payload_preset": {
            key: best_record(indexes["artifacts_by_feature_payload_preset"][key])
            for key in sorted(indexes["artifacts_by_feature_payload_preset"])
        },
        "by_tuple_payload_preset": {
            key: best_record(indexes["artifacts_by_tuple_payload_preset"][key])
            for key in sorted(indexes["artifacts_by_tuple_payload_preset"])
        },
    }


def api_collection_record(name, count, indexes, summary_key, primary_key=""):
    return {
        "name": name,
        "count": count,
        "count_summary_key": summary_key,
        "primary_key": primary_key,
        "indexes": list(indexes),
        "summary_key": summary_key,
    }


def build_repo_index(paths):
    release_dirs = [pathlib.Path(path) for path in candidate_release_dirs(paths)]
    artifacts = []
    devices = {}
    tuples = {}
    by_sha = {}
    tools = {}
    presets = {}
    features = {}
    release_self_tests = []
    release_self_tests_by_release = {}
    release_self_tests_by_status = {}
    release_self_test_command_queue_token_required_count = 0
    release_self_test_command_queue_token_configured_count = 0
    release_self_test_command_queue_execution_supported_count = 0
    release_self_test_command_queue_operator_supplied_command_execution_count = 0

    for release_dir in release_dirs:
        index = load_release_index(release_dir)
        release_name = index.get("release_name") or release_dir.name
        release_mtime = int((release_dir / "release.json").stat().st_mtime)
        release_self_test = load_release_self_test(release_dir)
        if release_self_test:
            release_self_test["release_name"] = release_name
            release_self_test["release_dir"] = str(release_dir)
            release_self_tests.append(release_self_test)
            release_self_tests_by_release.setdefault(release_name, []).append(release_self_test)
            release_self_tests_by_status.setdefault(str(release_self_test.get("status") or "unknown"), []).append(release_self_test)
            release_self_test_command_queue_token_required_count += int(release_self_test.get("command_queue_token_required_count") or 0)
            release_self_test_command_queue_token_configured_count += int(release_self_test.get("command_queue_token_configured_count") or 0)
            release_self_test_command_queue_execution_supported_count += int(release_self_test.get("command_queue_execution_supported_count") or 0)
            release_self_test_command_queue_operator_supplied_command_execution_count += int(
                release_self_test.get("command_queue_operator_supplied_command_execution_count") or 0
            )
        for alias, meta in (index.get("devices") or {}).items():
            devices.setdefault(alias, []).append({
                "release_name": release_name,
                "release_dir": str(release_dir),
                "tuple_path": meta.get("tuple_path"),
                "artifacts": meta.get("artifacts") or [],
            })
        for tuple_path, meta in (index.get("tuples") or {}).items():
            tuples.setdefault(tuple_path, []).append({
                "release_name": release_name,
                "release_dir": str(release_dir),
                "tuple": meta.get("tuple") or {},
                "artifacts": meta.get("artifacts") or [],
            })
        for row in index.get("artifacts") or []:
            sha = artifact_sha(release_dir, row)
            artifact = row.get("tuple_artifact") or row.get("artifact") or ""
            record = dict(row)
            record.update({
                "release_name": release_name,
                "release_dir": str(release_dir),
                "release_mtime": release_mtime,
                "artifact": artifact,
                "artifact_path": str(release_dir / artifact) if artifact else "",
                "sha256": sha,
                "features": artifact_features(row),
                "release_self_test": release_self_test,
                "release_self_test_status": release_self_test.get("status", "") if release_self_test else "",
                "release_self_test_path": release_self_test.get("release_self_test_path", "") if release_self_test else "",
            })
            artifacts.append(record)
            if sha:
                entry = by_sha.setdefault(sha, {"sha256": sha, "count": 0, "artifacts": []})
                entry["count"] += 1
                entry["artifacts"].append({
                    "release_name": release_name,
                    "release_dir": str(release_dir),
                    "artifact": artifact,
                })
            if record.get("payload_preset"):
                presets.setdefault(record["payload_preset"], []).append(record["artifact_path"])
            for tool in record.get("tools") or []:
                tools.setdefault(tool, []).append(record["artifact_path"])
            for feature in record.get("features") or []:
                features.setdefault(feature, []).append(record["artifact_path"])

    artifacts.sort(key=lambda r: (r.get("release_mtime") or 0, r.get("release_name") or "", r.get("artifact") or ""), reverse=True)
    device_records = []
    device_records_by_alias = {}
    device_records_by_tuple_path = {}
    device_records_by_release = {}
    for alias in sorted(devices):
        for item in devices[alias]:
            record = dict(item)
            record["alias"] = alias
            device_records.append(record)
            device_records_by_alias.setdefault(alias, []).append(record)
            if record.get("tuple_path"):
                device_records_by_tuple_path.setdefault(record["tuple_path"], []).append(record)
            if record.get("release_name"):
                device_records_by_release.setdefault(record["release_name"], []).append(record)
    tuple_records = []
    tuple_records_by_tuple_path = {}
    tuple_records_by_release = {}
    for tuple_path in sorted(tuples):
        for item in tuples[tuple_path]:
            record = dict(item)
            record["tuple_path"] = tuple_path
            tuple_records.append(record)
            tuple_records_by_tuple_path.setdefault(tuple_path, []).append(record)
            if record.get("release_name"):
                tuple_records_by_release.setdefault(record["release_name"], []).append(record)
    artifacts_by_sha = {}
    artifacts_by_release = {}
    artifacts_by_tuple_path = {}
    artifacts_by_tool = {}
    artifacts_by_payload_preset = {}
    artifacts_by_feature = {}
    artifacts_by_compatibility = {}
    artifacts_by_tool_payload_preset = {}
    artifacts_by_feature_payload_preset = {}
    artifacts_by_tuple_payload_preset = {}
    artifacts_by_provider_tool = {}
    artifacts_by_provider_status = {}
    artifacts_by_doom_wad_filename = {}
    artifacts_by_doom_wad_sha256 = {}
    for record in artifacts:
        sha = record.get("sha256") or ""
        release_name = record.get("release_name") or ""
        tuple_path = record.get("tuple_path") or ""
        payload_preset = record.get("payload_preset") or ""
        if sha:
            artifacts_by_sha.setdefault(sha, []).append(record)
        if release_name:
            artifacts_by_release.setdefault(release_name, []).append(record)
        if tuple_path:
            artifacts_by_tuple_path.setdefault(tuple_path, []).append(record)
        if payload_preset:
            artifacts_by_payload_preset.setdefault(payload_preset, []).append(record)
        compatibility = ((record.get("compatibility") or {}).get("label") or "exact")
        artifacts_by_compatibility.setdefault(compatibility, []).append(record)
        if tuple_path and payload_preset:
            artifacts_by_tuple_payload_preset.setdefault(f"{tuple_path}:{payload_preset}", []).append(record)
        for tool in record.get("tools") or []:
            artifacts_by_tool.setdefault(tool, []).append(record)
            if payload_preset:
                artifacts_by_tool_payload_preset.setdefault(f"{tool}:{payload_preset}", []).append(record)
        for feature in record.get("features") or []:
            artifacts_by_feature.setdefault(feature, []).append(record)
            if payload_preset:
                artifacts_by_feature_payload_preset.setdefault(f"{feature}:{payload_preset}", []).append(record)
        for provider_tool, provider_status in (record.get("tool_provider_status") or {}).items():
            if not isinstance(provider_status, dict):
                continue
            artifacts_by_provider_tool.setdefault(provider_tool, []).append(record)
            overall = provider_status.get("overall") or provider_status.get("status") or "unknown"
            artifacts_by_provider_status.setdefault(f"{provider_tool}:{overall}", []).append(record)
        for wad in record.get("doom_wads") or []:
            if not isinstance(wad, dict):
                continue
            filename = wad.get("filename")
            sha256 = wad.get("sha256")
            if filename:
                artifacts_by_doom_wad_filename.setdefault(str(filename), []).append(record)
            if sha256:
                artifacts_by_doom_wad_sha256.setdefault(str(sha256), []).append(record)
    indexes = {
        "artifacts": artifacts,
        "artifacts_by_tuple_path": artifacts_by_tuple_path,
        "artifacts_by_tool": artifacts_by_tool,
        "artifacts_by_payload_preset": artifacts_by_payload_preset,
        "artifacts_by_feature": artifacts_by_feature,
        "artifacts_by_tool_payload_preset": artifacts_by_tool_payload_preset,
        "artifacts_by_feature_payload_preset": artifacts_by_feature_payload_preset,
        "artifacts_by_tuple_payload_preset": artifacts_by_tuple_payload_preset,
    }
    artifact_index_names = [
        "artifacts_by_sha",
        "artifacts_by_release",
        "artifacts_by_tuple_path",
        "artifacts_by_tool",
        "artifacts_by_payload_preset",
        "artifacts_by_feature",
        "artifacts_by_compatibility",
        "artifacts_by_tool_payload_preset",
        "artifacts_by_feature_payload_preset",
        "artifacts_by_tuple_payload_preset",
        "artifacts_by_provider_tool",
        "artifacts_by_provider_status",
        "artifacts_by_doom_wad_filename",
        "artifacts_by_doom_wad_sha256",
    ]
    recommendation_index_names = [
        "by_device",
        "by_tuple_path",
        "by_tool",
        "by_payload_preset",
        "by_feature",
        "by_tool_payload_preset",
        "by_feature_payload_preset",
        "by_tuple_payload_preset",
    ]
    recommendations = recommendations_from_indexes(devices, indexes)
    recommendation_count = sum(len(recommendations.get(name) or {}) for name in recommendation_index_names)
    device_record_index_names = [
        "device_records_by_alias",
        "device_records_by_tuple_path",
        "device_records_by_release",
    ]
    tuple_record_index_names = [
        "tuple_records_by_tuple_path",
        "tuple_records_by_release",
    ]
    return {
        "schema": 1,
        "release_count": len(release_dirs),
        "artifact_count": len(artifacts),
        "release_self_test_count": len(release_self_tests),
        "release_self_test_command_queue_token_required_count": release_self_test_command_queue_token_required_count,
        "release_self_test_command_queue_token_configured_count": release_self_test_command_queue_token_configured_count,
        "release_self_test_command_queue_execution_supported_count": release_self_test_command_queue_execution_supported_count,
        "release_self_test_command_queue_operator_supplied_command_execution_count": release_self_test_command_queue_operator_supplied_command_execution_count,
        "deduplicated_artifact_count": len(by_sha),
        "device_count": len(devices),
        "device_record_count": len(device_records),
        "tuple_count": len(tuples),
        "tuple_record_count": len(tuple_records),
        "recommendation_count": recommendation_count,
        "release_dirs": [str(path) for path in release_dirs],
        "release_self_tests": release_self_tests,
        "release_self_tests_by_release": {key: release_self_tests_by_release[key] for key in sorted(release_self_tests_by_release)},
        "release_self_tests_by_status": {key: release_self_tests_by_status[key] for key in sorted(release_self_tests_by_status)},
        "artifacts": artifacts,
        "artifacts_by_sha": {key: artifacts_by_sha[key] for key in sorted(artifacts_by_sha)},
        "artifacts_by_release": {key: artifacts_by_release[key] for key in sorted(artifacts_by_release)},
        "artifacts_by_tuple_path": {key: artifacts_by_tuple_path[key] for key in sorted(artifacts_by_tuple_path)},
        "artifacts_by_tool": {key: artifacts_by_tool[key] for key in sorted(artifacts_by_tool)},
        "artifacts_by_payload_preset": {key: artifacts_by_payload_preset[key] for key in sorted(artifacts_by_payload_preset)},
        "artifacts_by_feature": {key: artifacts_by_feature[key] for key in sorted(artifacts_by_feature)},
        "artifacts_by_compatibility": {key: artifacts_by_compatibility[key] for key in sorted(artifacts_by_compatibility)},
        "artifacts_by_tool_payload_preset": {key: artifacts_by_tool_payload_preset[key] for key in sorted(artifacts_by_tool_payload_preset)},
        "artifacts_by_feature_payload_preset": {key: artifacts_by_feature_payload_preset[key] for key in sorted(artifacts_by_feature_payload_preset)},
        "artifacts_by_tuple_payload_preset": {key: artifacts_by_tuple_payload_preset[key] for key in sorted(artifacts_by_tuple_payload_preset)},
        "artifacts_by_provider_tool": {key: artifacts_by_provider_tool[key] for key in sorted(artifacts_by_provider_tool)},
        "artifacts_by_provider_status": {key: artifacts_by_provider_status[key] for key in sorted(artifacts_by_provider_status)},
        "artifacts_by_doom_wad_filename": {key: artifacts_by_doom_wad_filename[key] for key in sorted(artifacts_by_doom_wad_filename)},
        "artifacts_by_doom_wad_sha256": {key: artifacts_by_doom_wad_sha256[key] for key in sorted(artifacts_by_doom_wad_sha256)},
        "dedupe": {key: by_sha[key] for key in sorted(by_sha)},
        "devices": {key: devices[key] for key in sorted(devices)},
        "device_records": device_records,
        "device_records_by_alias": {key: device_records_by_alias[key] for key in sorted(device_records_by_alias)},
        "device_records_by_tuple_path": {key: device_records_by_tuple_path[key] for key in sorted(device_records_by_tuple_path)},
        "device_records_by_release": {key: device_records_by_release[key] for key in sorted(device_records_by_release)},
        "tuples": {key: tuples[key] for key in sorted(tuples)},
        "tuple_records": tuple_records,
        "tuple_records_by_tuple_path": {key: tuple_records_by_tuple_path[key] for key in sorted(tuple_records_by_tuple_path)},
        "tuple_records_by_release": {key: tuple_records_by_release[key] for key in sorted(tuple_records_by_release)},
        "payload_presets": {key: unique(presets[key]) for key in sorted(presets)},
        "tools_present": {key: unique(tools[key]) for key in sorted(tools)},
        "features": {key: unique(features[key]) for key in sorted(features)},
        "compatibility_counts": {key: len(artifacts_by_compatibility[key]) for key in sorted(artifacts_by_compatibility)},
        "recommendations": recommendations,
        "api_collections": {
            "artifacts": api_collection_record(
                "artifacts",
                len(artifacts),
                artifact_index_names,
                "artifact_count",
                "artifact_path",
            ),
            "release_self_tests": api_collection_record(
                "release_self_tests",
                len(release_self_tests),
                [
                    "release_self_tests_by_release",
                    "release_self_tests_by_status",
                ],
                "release_self_test_count",
                "release_name",
            ),
            "dedupe": api_collection_record(
                "dedupe",
                len(by_sha),
                [],
                "deduplicated_artifact_count",
                "sha256",
            ),
            "devices": api_collection_record(
                "devices",
                len(device_records),
                device_record_index_names,
                "device_record_count",
                "alias",
            ),
            "tuples": api_collection_record(
                "tuples",
                len(tuple_records),
                tuple_record_index_names,
                "tuple_record_count",
                "tuple_path",
            ),
            "recommendations": api_collection_record(
                "recommendations",
                recommendation_count,
                recommendation_index_names,
                "recommendation_count",
                "key",
            ),
        },
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", help="release directory or directory containing release directories")
    parser.add_argument("--write", help="write index JSON to PATH")
    args = parser.parse_args(argv)

    doc = build_repo_index(args.paths)
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if args.write:
        pathlib.Path(args.write).write_text(text, encoding="utf-8")
        print(f"wrote {args.write}")
    else:
        print(text, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
