#!/usr/bin/env python3
"""griTTYkit operator console compatibility wrapper."""

import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from gritlib.command_queue import queue_command
from gritlib.config_utils import load_config
from gritlib.console_app import main
from gritlib.workflow_runners import start_service_process


if __name__ == "__main__":
    raise SystemExit(main())
