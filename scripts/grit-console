                    action_rec = profile_actions_by_id.get(action_id) or {}
                    if action_rec:
                        print(
                            f"  {action_id}: state={action_rec.get('operator_action_state', '') or '-'} "
                            f"reason={action_rec.get('operator_action_reason', '') or '-'} "
