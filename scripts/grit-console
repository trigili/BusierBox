    bridge_hop_index_maps = bridge_hop_indexes(bridge_hop_records)
    service_manager = SERVICE_MANAGER.snapshot()
    service_manager_status_doc = service_manager_status(service_manager)
    service_manager_resources = service_manager_status_doc["resources"]
    service_manager_resource_index_maps = service_manager_status_doc["resource_index_maps"]
