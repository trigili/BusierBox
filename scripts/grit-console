        return line_actions_selected_line_action(cfg, line_action_records())

    def run_line_module_or_service(values=None, dry_run_default=False):
        selector, flags = split_line_run_args(values or [])
        if dry_run_default and "--dry-run" not in flags:
            flags.append("--dry-run")
        if selector:
            if not dry_run_default and not selected_line_action() and selector in line_service_names(service_status_rows(cfg)):
                start_line_service(selector)
                return 0
            select_line_action(selector)
            return run_line_selected_action(flags)
        if selected_line_action():
            return run_line_selected_action(flags)
        if dry_run_default:
            raise ValueError("no selected action module; use check MODULE or use module ACTION first")
        start_line_service("")
        return 0

    def run_line_selected_action(args=None, dry_run_default=False):
        return line_actions_run_line_selected_action(
            cfg,
            selected_line_action(),
            args=args,
            dry_run_default=dry_run_default,
            service_runner=run_service_workflow_action,
            daemon_runner=run_operator_daemon_workflow_action,
            workbench_runner=run_workbench_action_record,
            target_runner=run_target_workflow_action,
            workbench_actions=workbench_action_records(cfg),
            target_input_func=line_input,
        )

