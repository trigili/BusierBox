        )

    def show_line_resource(resource):
        def show_collection(name, render_fn):
            set_line_collection(name)
            return render_fn()

        def show_events(_parsed=None):
            set_line_collection("events")
            snap = workbench_snapshot(cfg)
            print_target_activity_records(snap, target_id=configured_target_filter(cfg), limit=12)

        return dispatch_line_show_resource(resource, {
            "module-kind": lambda p: print_line_actions(
                p["filter_text"], kind_filter=p["kind_filter"], verbose=p["verbose"]),
            "targets": lambda _p: show_collection("targets", print_line_targets),
            "listeners": lambda p: show_collection("listeners", lambda: print_line_services(verbose=p["verbose"])),
            "files": lambda _p: show_collection("files", print_line_files),
            "jobs": lambda _p: show_collection("jobs", print_line_jobs),
            "daemon": lambda _p: show_collection("daemon", print_line_daemon_actions),
            "categories": lambda _p: show_collection("categories", print_line_module_categories),
            "modules": lambda p: show_collection(
                "modules", lambda: print_line_actions(p["filter_text"], verbose=p["verbose"])),
            "sessions": lambda _p: show_collection("sessions", print_line_sessions),
            "routes": lambda p: show_collection("routes", lambda: print_line_routes(verbose=p["verbose"])),
            "queue": lambda p: show_collection("queue", lambda: print_line_command_queue_view(detailed=p["verbose"])),
            "events": show_events,
            "release": lambda _p: show_collection(
                "release", lambda: line_release_print_line_release(cfg, append_event_fn=append_event)),
            "options": lambda _p: print_line_options(),
            "context": lambda _p: print_line_info(),
        })

