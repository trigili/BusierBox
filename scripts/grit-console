    def interact_line_session(selector):
        text = str(selector or "").strip()
        if not text:
            module = str(cfg.get("_line_console_module") or "")
            if module.startswith("session/"):
                text = module.split("/", 1)[1]
        if not text:
            raise ValueError("usage: interact SESSION")
        selected = line_session_record(text)
        if not selected:
            raise ValueError(f"session not found: {text}")
        path = str(selected.get("path") or "")
        headless = view_path_headless_command(cfg, path)
        print_line_session_interaction(selected, headless)
        append_event(cfg, "workbench", "workbench_session_interaction_viewed", details={
            "session_id": selected.get("session_id") or Path(path).name,
            "session_path": path,
            "headless_command": headless,
        })

