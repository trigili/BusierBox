        print("    2 start tls-shell")
        print("    3 start plain-shell")
        print("    4 start file-service")
        print("    5 stop service")
        print("    19 serve probe")
        print("  Targets:")
        print("    15 run target workflow action")
        print("    16 select target filter")
        print("    18 inspect target mailbox/activity")
        print("    20 inspect command queue/results")
        print("    21 inspect target activity feed")
        print("  Bridges:")
