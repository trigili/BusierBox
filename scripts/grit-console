                    f"last_seen: {rec.get('target_last_seen', '') or '-'} via={rec.get('target_last_seen_via', '') or '-'}",
                    f"offline_for_sec: {rec.get('target_offline_for_sec', '') if rec.get('target_offline_for_sec') != '' else '-'}",
                    f"offline_age: {rec.get('target_offline_age_bucket', '') or '-'}",
                    f"next_expected_poll: {rec.get('target_next_expected_poll', '') or '-'}",
                    f"poll_overdue: {'yes' if rec.get('target_poll_overdue') else 'no'}",
                    f"command: {rec.get('command', '') or '-'}",
                    f"command_queue_workflow_actions: {len(command_queue_workflow_actions)}",
                    f"fleet_pending_work: {list_action.get('fleet_mailbox_pending_work_count', 0)}",
                    f"fleet_offline_targets: {list_action.get('fleet_offline_target_count', 0)}",
                    f"fleet_poll_overdue_targets: {list_action.get('fleet_poll_overdue_target_count', 0)}",
                    f"list_action_state: {list_action.get('operator_action_state', '') or '-'} reason={list_action.get('operator_action_reason', '') or '-'}",
                    f"queue_action_state: {queue_action.get('operator_action_state', '') or '-'} reason={queue_action.get('operator_action_reason', '') or '-'}",
                    f"clear_action_state: {clear_action.get('operator_action_state', '') or '-'} reason={clear_action.get('operator_action_reason', '') or '-'}",
                    f"list_command: {list_action.get('headless_command', list_action.get('command', '')) or '-'}",
                    f"queue_command: {queue_action.get('headless_command', queue_action.get('command', '')) or '-'}",
                    "action 20 opens command queue/results",
                ]
            elif pane == 10:
                list_action = command_queue_workflow_actions_by_id.get("command-queue:list-command-queue") or {}
                queue_action = command_queue_workflow_actions_by_id.get("command-queue:queue-command") or {}
                clear_action = command_queue_workflow_actions_by_id.get("command-queue:clear-command-queue") or {}
                start_action = command_queue_workflow_actions_by_id.get("command-queue:start-command-queue-listener") or {}
                stop_action = command_queue_workflow_actions_by_id.get("command-queue:stop-command-queue-listener") or {}
                detail_lines = [
                    f"command_queue_workflow_actions: {len(command_queue_workflow_actions)}",
                    f"fleet_pending_work: {list_action.get('fleet_mailbox_pending_work_count', 0)}",
                    f"fleet_offline_targets: {list_action.get('fleet_offline_target_count', 0)}",
                    f"fleet_poll_overdue_targets: {list_action.get('fleet_poll_overdue_target_count', 0)}",
                    f"list_action_state: {list_action.get('operator_action_state', '') or '-'} reason={list_action.get('operator_action_reason', '') or '-'}",
                    f"queue_action_state: {queue_action.get('operator_action_state', '') or '-'} reason={queue_action.get('operator_action_reason', '') or '-'}",
                    f"clear_action_state: {clear_action.get('operator_action_state', '') or '-'} reason={clear_action.get('operator_action_reason', '') or '-'}",
                    f"start_action_state: {start_action.get('operator_action_state', '') or '-'} reason={start_action.get('operator_action_reason', '') or '-'}",
                    f"stop_action_state: {stop_action.get('operator_action_state', '') or '-'} reason={stop_action.get('operator_action_reason', '') or '-'}",
                    f"list_command: {list_action.get('headless_command', list_action.get('command', '')) or '-'}",
                    f"queue_command: {queue_action.get('headless_command', queue_action.get('command', '')) or '-'}",
                    "action 20 opens command queue/results",
                ]
            elif pane == 11 and config_fields:
                rec = config_fields[min(selected, len(config_fields) - 1)]
                detail_lines = [
                    f"config_key: {rec.get('key', '')}",
                    f"label: {rec.get('label', '')}",
                    f"category: {rec.get('category', '')}",
                    f"value: {rec.get('value', '') or '-'} configured={'yes' if rec.get('configured') else 'no'}",
                    f"config_path: {rec.get('config_path', '')}",
                    f"safety: boundary={rec.get('safety_boundary', '')} control_like={'yes' if rec.get('control_like') else 'no'}",
                    f"explicit_choice: {'yes' if rec.get('requires_explicit_operator_choice') else 'no'}",
                    f"options: {' '.join(rec.get('options') or []) or '-'}",
                    f"examples: {' '.join(rec.get('examples') or []) or '-'}",
                    f"set_command: {rec.get('set_command', '')}",
                    "enter sets this build config field",
                    "action 14 opens guided build config",
                ]
            elif pane == 12 and workbench_jobs:
                rec = workbench_jobs[min(selected, len(workbench_jobs) - 1)]
                exit_status = rec.get("exit_status", "")
                detail_lines = [
                    f"job: {rec.get('id', '') or '-'}",
                    f"action: {rec.get('action_id', '') or '-'} {rec.get('action_label', '') or ''}",
                    f"state: {rec.get('state', '') or '-'} effective={rec.get('effective_state', '') or '-'}",
                    f"outcome: {rec.get('outcome', '') or '-'} exit={exit_status if exit_status != '' else '-'}",
                    f"pid: {rec.get('pid', '') or '-'} alive={'yes' if rec.get('pid_alive') else 'no'} managed={'yes' if rec.get('pid_managed') else 'no'}",
                    f"cancel_supported: {'yes' if rec.get('cancel_supported') else 'no'}",
                    f"started: {rec.get('started_at', '') or '-'}",
                    f"finished: {rec.get('finished_at', '') or '-'}",
                    f"elapsed_sec: {rec.get('elapsed_sec', '') if rec.get('elapsed_sec') != '' else '-'}",
                    f"duration_sec: {rec.get('duration_sec', '') if rec.get('duration_sec') != '' else '-'}",
                    f"log: {rec.get('log_path', '') or '-'} exists={'yes' if rec.get('log_exists') else 'no'}",
                    f"tail_truncated: {'yes' if rec.get('last_output_tail_truncated') else 'no'} lines={rec.get('last_output_tail_count', 0)}",
                    f"command: {rec.get('command', '') or '-'}",
                    "enter cancels this job when supported",
                    "v opens job log in pager",
                    "action 12 starts jobs; action 13 cancels jobs",
                ]
                for line in rec.get("last_output_tail") or []:
                    detail_lines.append(f"| {line}")
            elif pane == 13 and workbench_actions:
                rec = workbench_actions[min(selected, len(workbench_actions) - 1)]
                detail_lines = [
                    f"workflow_action: {rec.get('id', '') or '-'}",
                    f"label: {rec.get('label', '')}",
                    f"category: {rec.get('category', '')}",
                    f"script: {rec.get('script', '')}",
                    f"background_supported: {'yes' if rec.get('background_supported') else 'no'}",
                    f"long_running: {'yes' if rec.get('long_running') else 'no'}",
                    f"foreground_runnable: {'yes' if rec.get('foreground_runnable') else 'no'}",
                    f"dry_run_supported: {'yes' if rec.get('dry_run_supported') else 'no'}",
                    f"requires_confirmation: {'yes' if rec.get('requires_confirmation') else 'no'}",
                    f"operator_action_state: {rec.get('operator_action_state', '') or '-'}",
                    f"operator_action_reason: {rec.get('operator_action_reason', '') or '-'}",
                    f"can_run_from_curses_enter: {'yes' if rec.get('can_run_from_curses_enter') else 'no'}",
                    f"curses_enter_action: {rec.get('curses_enter_action', '') or '-'}",
                    f"writes_config: {'yes' if rec.get('writes_config') else 'no'} runs_build={'yes' if rec.get('runs_build') else 'no'}",
                    f"config_path: {rec.get('config_path', '') or '-'}",
                    f"command: {rec.get('command', '') or '-'}",
                    f"dry_run: {rec.get('dry_run_command', '') or '-'}",
                    f"run: {rec.get('run_command', '') or '-'}",
                    f"start_job: {rec.get('start_job_command', '') or '-'}",
                    "enter starts background workflow job when supported",
                    "action 11 opens full workflow action list",
                ]
            else:
                detail_lines = [
                    f"state: {state_file_path(cfg)}",
                    f"staged: {staged_file_path(cfg)}",
                    f"cert: {cfg.get('tls_cert', '')}",
                    f"key: {cfg.get('tls_key', '')}",
                ]
                unhealthy_state = [
                    rec for rec in snap.get("operator_state_records") or []
                    if rec.get("status") in ("missing", "invalid", "error")
                ]
                if unhealthy_state:
                    detail_lines.append("operator state health:")
                    for rec in unhealthy_state[:5]:
                        detail_lines.append(f"{rec.get('name', '')}: {rec.get('status', '')} {rec.get('path', '')}")
            target_filter = snap.get("target_filter") or {}
            target_evidence = target_filter_evidence_lines(target_filter)
            if target_evidence:
                detail_lines.append("selected target evidence:")
                for line in target_evidence:
                    detail_lines.append(f"selected_target_{line}")
            stdscr.erase()
            height, width = stdscr.getmaxyx()
            active = sum(1 for row in services if row["actual"] == "listening")
            warning_count = len(snap.get("warnings") or [])
            summary = snap.get("summary") or {}
            operator_state_unhealthy = summary.get("operator_state_unhealthy_count", 0)
            workbench = snap.get("workbench") or {}
            refresh_suffix = f"refresh={workbench.get('refresh_count', 0)} last={workbench.get('last_refresh_at', '') or '-'}"
            safe_add(stdscr, 0, 0, f"griTTYkit Operator Workbench | active={active} warnings={warning_count} operator_state_unhealthy={operator_state_unhealthy} | ip={snap['selected_local_ip']} | {utc_now()} | {refresh_suffix} | tab panes j/k move enter start/stop s stage d unstage v view c copy ? help q quit", curses.A_REVERSE)
            target_filter_text = ""
            if target_filter.get("active"):
                target_filter_text = " | " + target_filter_summary_text(target_filter, prefix="selected_target=")
            safe_add(
                stdscr,
                1,
                0,
                "Targets: "
                f"count={summary.get('target_count', 0)} "
                f"with_id={summary.get('target_attribution_with_target_count', 0)} "
                f"legacy_without_id={summary.get('target_attribution_without_target_count', 0)} "
                f"legacy_single_target={'yes' if summary.get('target_legacy_single_target_activity_present') else 'no'}"
                f"{target_filter_text}",
                curses.A_BOLD,
            )
            connectivity_counts = summary.get("target_connectivity_state_counts") or {}
            active_pane_title = pane_titles.get(pane, str(pane))
            active_group = pane_groups.get(pane, "-")
            safe_add(
                stdscr,
                2,
                0,
                "Connectivity: "
                f"online={connectivity_counts.get('online', 0)} "
                f"recent={connectivity_counts.get('recent', 0)} "
                f"stale={connectivity_counts.get('stale', 0)} "
                f"offline={connectivity_counts.get('offline', 0)} "
                f"unknown={connectivity_counts.get('unknown', 0)} "
                f"pending_work={summary.get('target_mailbox_pending_work_count', 0)} "
                f"poll_overdue={summary.get('target_poll_overdue_count', 0)} "
                f"last_phone_home={summary.get('latest_target_seen_at', '') or '-'}",
                curses.A_BOLD,
            )
            safe_add(
                stdscr,
                3,
                0,
                "Groups: [t]argets [a]ctions [m]ailbox [b]ridges [o]daemon [f]iles [w]orkflows [e]vents [g]activity"
                f" | active={active_group}/{active_pane_title}",
                curses.A_BOLD,
            )
            left_w = max(34, width // 3)
            right_w = max(20, width - left_w - 1)
            lower_y = max(14, height // 2)
            draw_list(stdscr, "Services", service_lines, 4, 0, lower_y - 4, left_w, pane == 0)
            draw_list(stdscr, "Details", detail_lines, 4, left_w + 1, lower_y - 4, right_w, False)
            third = max(20, width // 3)
            draw_list(stdscr, "Staged Files", staged_lines, lower_y, 0, 7, third, pane == 1)
            draw_list(stdscr, "Target Files", target_file_lines, lower_y, third + 1, 7, third, pane == 2)
            draw_list(stdscr, "Recent Sessions", session_lines, lower_y, (third + 1) * 2, 7, width - ((third + 1) * 2), pane == 3)
            events_y = min(height - 8, lower_y + 8)
            bottom_y = events_y
            bottom_h = height - bottom_y - 1
            top_bottom_h = max(4, bottom_h // 2)
            lower_bottom_y = bottom_y + top_bottom_h
            lower_bottom_h = max(1, height - lower_bottom_y - 1)
            top_sixth = max(11, width // 6)
            draw_list(stdscr, f"Event Log | {event_tail_status_line}", event_lines, bottom_y, 0, top_bottom_h, top_sixth, pane == 4)
            draw_list(stdscr, "Target Fleet", target_lines, bottom_y, top_sixth + 1, top_bottom_h, top_sixth, pane == 8)
            draw_list(stdscr, "Target Actions", target_action_lines, bottom_y, (top_sixth + 1) * 2, top_bottom_h, top_sixth, pane == 14)
            draw_list(stdscr, "Mailbox", mailbox_lines, bottom_y, (top_sixth + 1) * 3, top_bottom_h, top_sixth, pane == 10)
            draw_list(stdscr, "Bridge Routes", bridge_lines, bottom_y, (top_sixth + 1) * 4, top_bottom_h, top_sixth, pane == 9)
            draw_list(stdscr, "Workflow Actions", action_lines, bottom_y, (top_sixth + 1) * 5, top_bottom_h, width - ((top_sixth + 1) * 5), pane == 13)
            lower_seventh = max(10, width // 7)
            draw_list(stdscr, "Target Commands", command_lines, lower_bottom_y, 0, lower_bottom_h, lower_seventh, pane == 5)
            draw_list(stdscr, "Target Activity", target_activity_lines, lower_bottom_y, lower_seventh + 1, lower_bottom_h, lower_seventh, pane == 16)
            draw_list(stdscr, "Operator Daemon", daemon_lines, lower_bottom_y, (lower_seventh + 1) * 2, lower_bottom_h, lower_seventh, pane == 15)
            draw_list(stdscr, "Build Config", config_lines, lower_bottom_y, (lower_seventh + 1) * 3, lower_bottom_h, lower_seventh, pane == 11)
            draw_list(stdscr, "Jobs", job_lines, lower_bottom_y, (lower_seventh + 1) * 4, lower_bottom_h, lower_seventh, pane == 12)
            draw_list(stdscr, "Release Artifacts", release_lines, lower_bottom_y, (lower_seventh + 1) * 5, lower_bottom_h, lower_seventh, pane == 6)
            draw_list(stdscr, "Devices / Tuples", device_tuple_lines, lower_bottom_y, (lower_seventh + 1) * 6, lower_bottom_h, width - ((lower_seventh + 1) * 6), pane == 7)
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return 0
            if key in (curses.KEY_DOWN, ord("j")):
                selected += 1
            elif key in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif key == ord("\t"):
                pane = (pane + 1) % 17
                selected = 0
            elif key == curses.KEY_BTAB:
                pane = (pane - 1) % 17
                selected = 0
            elif key in pane_shortcuts:
                pane = pane_shortcuts[key]
                selected = 0
            elif key in (ord("1"), ord("2"), ord("3"), ord("4")):
                service = {ord("1"): "ssh", ord("2"): "tls-shell", ord("3"): "plain-shell", ord("4"): "file-service"}[key]
                action = service_workflow_actions_by_id.get(f"{service}:start-service") or {}
                start_service_process(
                    cfg,
                    service,
                    headless_command=action.get("headless_command", action.get("command", "")),
                )
            elif key in (10, 13):
                if pane == 0 and services:
                    row = services[min(selected, len(services) - 1)]
                    service = row["name"]
                    if row["actual"] == "listening":
                        action = service_workflow_actions_by_id.get(f"{service}:stop-service") or {}
                        stop_recorded_service(
                            cfg,
                            service,
                            headless_command=action.get("headless_command", action.get("command", "")),
                        )
                    else:
                        action = service_workflow_actions_by_id.get(f"{service}:start-service") or {}
                        start_service_process(
                            cfg,
                            service,
                            headless_command=action.get("headless_command", action.get("command", "")),
                        )
                elif pane == 1 and staged_names:
                    name = staged_names[min(selected, len(staged_names) - 1)]
                    rec = snap["staged"][name]
                    action = staged_file_workflow_actions_by_id.get(f"{name}:show-fetch-command") or {}
                    command = rec.get("fetch_command") or render_fetch_command(name, cfg, host=snap["selected_local_ip"])
                    safe_add(stdscr, height - 3, 0, f"staged action: {action.get('operator_action_state', '') or 'ready'} {action.get('operator_action_reason', '') or 'show-command'}")
                    safe_add(stdscr, height - 2, 0, command)
                    stdscr.getch()
                elif pane == 6 and release_artifacts:
                    rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                    try:
                        stage_release_artifact(cfg, rec.get("release_path") or rec.get("name") or rec.get("path", ""))
                    except ValueError:
                        pass
                elif pane == 7 and release_nav:
                    rec = release_nav[min(selected, len(release_nav) - 1)]
                    try:
                        stage_release_nav_item(cfg, rec)
                    except ValueError:
                        pass
                elif pane == 8 and targets:
                    rec = targets[min(selected, len(targets) - 1)]
                    try:
                        set_workbench_target_filter(cfg, str(rec.get("target_id") or ""), targets=targets)
                    except ValueError:
                        pass
                elif pane == 9 and bridge_profiles:
                    rec = bridge_profiles[min(selected, len(bridge_profiles) - 1)]
                    name = str(rec.get("name") or "")
                    if name:
                        if rec.get("active"):
                            action = bridge_profile_workflow_actions_by_id.get(f"{name}:stop-profile") or {}
                            stop_recorded_service(
                                cfg,
                                "bridge",
                                headless_command=action.get("headless_command", action.get("command", "")),
                            )
                        else:
                            action = bridge_profile_workflow_actions_by_id.get(f"{name}:start-profile") or {}
                            start_service_process(
                                cfg,
                                "bridge",
                                argv_extra=["--bridge-profile", name],
                                headless_command=action.get("headless_command", action.get("command", "")),
                            )
                elif pane == 10:
                    action = command_queue_workflow_actions_by_id.get("command-queue:list-command-queue") or {}
                    command = action.get("headless_command", action.get("command", "")) or (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --list-command-queue"
                    )
                    safe_add(stdscr, height - 3, 0, f"command queue action: {action.get('operator_action_state', '') or 'ready'} {action.get('operator_action_reason', '') or 'run-now'}")
                    safe_add(stdscr, height - 2, 0, command)
                    stdscr.getch()
                elif pane == 11 and config_fields:
                    rec = config_fields[min(selected, len(config_fields) - 1)]
                    key_name = str(rec.get("key") or "")
                    curses.echo()
                    safe_add(stdscr, height - 2, 0, f"{key_name} value> ")
                    value = stdscr.getstr(height - 2, len(key_name) + 8, 240).decode("utf-8", errors="replace").strip()
                    curses.noecho()
                    if key_name and value:
                        try:
                            set_workbench_build_config(cfg, f"{key_name}={value}")
                        except ValueError as exc:
                            safe_add(stdscr, height - 2, 0, str(exc))
                            stdscr.getch()
                elif pane == 12 and workbench_jobs:
                    rec = workbench_jobs[min(selected, len(workbench_jobs) - 1)]
                    if rec.get("cancel_supported"):
                        try:
                            cancel_workbench_job_record(
                                cfg,
                                workbench_action_records(cfg),
                                str(rec.get("id") or ""),
                            )
                        except ValueError as exc:
                            safe_add(stdscr, height - 2, 0, str(exc))
                            stdscr.getch()
                elif pane == 13 and workbench_actions:
                    rec = workbench_actions[min(selected, len(workbench_actions) - 1)]
                    action_id = str(rec.get("id") or "")
                    if action_id and rec.get("background_supported"):
                        try:
                            started = start_workbench_job_record(
                                cfg,
                                workbench_action_records(cfg),
                                action_id,
                                headless_command=start_workbench_job_headless_command(cfg, action_id),
                            )
                            safe_add(stdscr, height - 2, 0, f"Started job {started.get('id', '')}: log={started.get('log_path', '')}")
                            stdscr.getch()
                        except ValueError as exc:
                            safe_add(stdscr, height - 2, 0, str(exc))
                            stdscr.getch()
                    else:
                        safe_add(stdscr, height - 2, 0, "Foreground actions use action 11 for preview/run confirmation.")
                        stdscr.getch()
                elif pane == 14 and target_workflow_actions:
                    rec = target_workflow_actions[min(selected, len(target_workflow_actions) - 1)]
                    action_id = str(rec.get("action_id") or "")
                    if not rec.get("can_run_from_curses_enter") or action_id in ("inspect-status", "open-workbench"):
                        reason = rec.get("operator_action_reason", "") or "use-line-action"
                        safe_add(stdscr, height - 2, 0, f"Target action {rec.get('operator_action_state', '') or 'not-runnable'}: {reason}; use action 15 or the shown headless command.")
                        stdscr.getch()
                    else:
                        output = io.StringIO()
                        try:
                            with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
                                rc = run_target_workflow_action(cfg, str(rec.get("id") or ""))
                            lines = [line for line in output.getvalue().splitlines() if line.strip()]
                            message = lines[-1] if lines else f"target workflow action exited {rc}"
                            safe_add(stdscr, height - 2, 0, f"target action rc={rc}: {message}")
                            stdscr.getch()
                        except ValueError as exc:
                            safe_add(stdscr, height - 2, 0, str(exc))
                            stdscr.getch()
                elif pane == 15 and daemon_records:
                    try:
                        if daemon_attached:
                            output = io.StringIO()
                            with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
                                rc = run_workbench_action_record(
                                    cfg,
                                    workbench_action_records(cfg),
                                    "operator-daemon-stop",
                                    confirmed=True,
                                )
                            lines = [line for line in output.getvalue().splitlines() if line.strip()]
                            message = lines[-1] if lines else f"operator daemon stop exited {rc}"
                            safe_add(stdscr, height - 2, 0, f"daemon stop rc={rc}: {message}")
                        else:
                            started = start_workbench_job_record(
                                cfg,
                                workbench_action_records(cfg),
                                "operator-daemon-start",
                                headless_command=start_workbench_job_headless_command(cfg, "operator-daemon-start"),
                            )
                            safe_add(stdscr, height - 2, 0, f"Started daemon job {started.get('id', '')}: log={started.get('log_path', '')}")
                        stdscr.getch()
                    except ValueError as exc:
                        safe_add(stdscr, height - 2, 0, str(exc))
                        stdscr.getch()
            elif key == ord("5"):
                curses.echo()
                safe_add(stdscr, height - 2, 0, "service> ")
                service = stdscr.getstr(height - 2, 9, 32).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if service:
                    action = service_workflow_actions_by_id.get(f"{service}:stop-service") or {}
                    stop_recorded_service(
                        cfg,
                        service,
                        headless_command=action.get("headless_command", action.get("command", "")),
                    )
            elif key in (ord("6"), ord("s")) and pane == 6 and release_artifacts:
                rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                try:
                    stage_release_artifact(cfg, rec.get("release_path") or rec.get("name") or rec.get("path", ""))
                except ValueError:
                    pass
            elif key in (ord("6"), ord("s")) and pane == 7 and release_nav:
                rec = release_nav[min(selected, len(release_nav) - 1)]
                try:
                    stage_release_nav_item(cfg, rec)
                except ValueError:
                    pass
            elif key in (ord("6"), ord("s")):
                curses.echo()
                safe_add(stdscr, height - 3, 0, "local file> ")
                path = stdscr.getstr(height - 3, 12, 240).decode("utf-8", errors="replace").strip()
                safe_add(stdscr, height - 2, 0, "target request name> ")
                name = stdscr.getstr(height - 2, 21, 240).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if path and name:
                    try:
                        stage_file(cfg, path, name)
                    except ValueError:
                        pass
            elif key in (ord("d"), ord("D")) and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)] if pane == 1 else ""
                if name:
                    unstage_file(cfg, name)
            elif key in (ord("v"), ord("V")):
                path = selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples)
                message = ""
                if path:
                    try:
                        curses.def_prog_mode()
                        curses.endwin()
                        message = open_path_in_pager(path)
                    finally:
                        curses.reset_prog_mode()
                        stdscr.keypad(True)
                        curses.curs_set(0)
                else:
                    message = "no local path for selected item"
                safe_add(stdscr, height - 2, 0, message)
                stdscr.getch()
            elif key in (ord("?"),):
                safe_add(stdscr, height - 2, 0, "Help: arrows/jk move, Tab panes, t/a/m/b/o/f/w/e/g jump groups, Enter act, s stage, d unstage, v view, c copy, r refresh, q quit")
                stdscr.getch()
            elif key in (ord("r"), ord("R")):
                rec = record_workbench_refresh(cfg)
                safe_add(stdscr, height - 2, 0, f"Refreshed workbench at {rec.get('last_refresh_at', '')}")
                stdscr.getch()
            elif key in (ord("c"), ord("C")):
                if snap.get("target_command_records"):
                    idx = min(selected, len(snap["target_command_records"]) - 1) + 1 if pane == 5 else 1
                    try:
                        rec = copy_generated_command(cfg, idx)
                        safe_add(stdscr, height - 2, 0, f"Copied command {idx} to {rec['path']} clipboard={'yes' if rec['clipboard'] else 'no'}")
                    except ValueError as exc:
                        safe_add(stdscr, height - 2, 0, str(exc))
                else:
                    safe_add(stdscr, height - 2, 0, "No generated target commands.")
                stdscr.getch()
            max_items = (
                len(services) if pane == 0 else
                len(staged_names) if pane == 1 else
                len(target_file_transfer_records) if pane == 2 else
                len(snap["sessions"]) if pane == 3 else
                len(recent_events) if pane == 4 else
                len(snap.get("target_command_records") or []) if pane == 5 else
                len(release_artifacts) if pane == 6 else
                (1 + len(release_devices[:5]) + len(release_tuples[:5])) if pane == 7 else
                len(targets) if pane == 8 else
                len(bridge_profiles) if pane == 9 else
                len(mailbox_records) if pane == 10 else
                len(config_fields) if pane == 11 else
                len(workbench_jobs) if pane == 12 else
                len(workbench_actions) if pane == 13 else
                len(target_workflow_actions) if pane == 14 else
                len(daemon_records) if pane == 15 else
                len(target_activity_records) if pane == 16 else
                1
            )
            selected = min(max(0, selected), max(0, max_items - 1))
        return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0

    return curses.wrapper(draw)


def run_line_console(cfg):
    """Default interactive mode: readline line console."""
    update_server_state(cfg, "workbench", "open", {"state_file": str(state_file_path(cfg)), "workbench_mode": "starting"})
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "noninteractive",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "noninteractive"})
        print_workbench(cfg)
        return 0
    try:
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "line",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "line"})
        return run_line_tui(cfg)
    except KeyboardInterrupt:
        request_shutdown("keyboard_interrupt")
        print("grit-console: interrupted, shutting down workbench", file=sys.stderr)
        return 130
    finally:
        stop_workbench_started_services(cfg)
        mark_service_stopped(cfg, "workbench", SHUTDOWN_REASON or "quit")
        append_event(cfg, "workbench", "shutdown", details={"reason": SHUTDOWN_REASON or "quit"})


def run_tui(cfg):
    """--tui flag: curses full-screen UI, falls back to line console on dumb terminals."""
    update_server_state(cfg, "workbench", "open", {"state_file": str(state_file_path(cfg)), "workbench_mode": "starting"})
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "noninteractive",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "noninteractive"})
        print_workbench(cfg)
        return 0
    try:
        if os.environ.get("TERM", "").strip().lower() in ("", "dumb"):
            print("terminal does not support curses, using line console", file=sys.stderr)
            update_server_state(cfg, "workbench", "open", {
                "state_file": str(state_file_path(cfg)),
                "workbench_mode": "line",
            })
            append_event(cfg, "workbench", "workbench_opened", details={"mode": "line"})
            return run_line_tui(cfg)
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "curses",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "curses"})
        return run_curses_tui(cfg)
    except KeyboardInterrupt:
        request_shutdown("keyboard_interrupt")
        print("grit-console: interrupted, shutting down workbench", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"curses workbench unavailable, using line console: {exc}", file=sys.stderr)
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "line",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "line", "fallback_reason": str(exc)})
        return run_line_tui(cfg)
    finally:
        stop_workbench_started_services(cfg)
        mark_service_stopped(cfg, "workbench", SHUTDOWN_REASON or "quit")
        append_event(cfg, "workbench", "shutdown", details={"reason": SHUTDOWN_REASON or "quit"})


def main(argv=None):
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        description="Catch griTTYkit reverse-access transports from a target.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Transport modes:
  ssh         — Paramiko reverse-forward listener for Dropbear/dbclient (GRIT_RSHELL_TRANSPORT=ssh)
  tls-shell   — TLS shell listener accepting builtin+tls AND socat+tls transports
  plain-shell — Plaintext shell listener (debug/insecure; socat+none or builtin+none)
  file-service — Receive-only TLS upload service for target-initiated files/evidence
  command-queue — Explicit command queue poll listener
  bridge      — Explicit TCP bridge from a local listener to a configured host:port
  probe — Serve a /bin/sh probe script over HTTP and receive its result
  probe-tftp — Serve the same probe script over UDP TFTP for first-contact fallback
  probe-ftp — Serve the same probe script over simple FTP RETR
  probe-dns — Serve the same probe script as DNS TXT chunks

File staging:
  --transport file-service --serve-file ./tool --as /tmp/tool
  --transport file-service --serve-dir local/operator-files
  --stage-release-artifact by-tuple/.../bin/grit-target-full
  --release-dir dist/releases/lab --stage-release-artifact bin/grit-target-full
  --transport file-service --list-staged
  --save-bridge-profile lab-http --bridge-port 22206 --bridge-dest-host 10.0.0.8 --bridge-dest-port 80
  --inspect-bridge-profile lab-http
  --delete-bridge-profile lab-http
  --transport bridge --bridge-profile lab-http

Command queue:
  --queue-command 'grit reality-test --json'
  --list-command-queue
  --record-command-result cq-id --result-json result.json
  --clear-command-queue

Operator daemon:
  --daemon --daemon-service file-service --daemon-service command-queue
  --daemon --timeout 60
  --systemd-user-action print --daemon-service file-service
  --systemd-user-action install --systemd-user-unit-dir ~/.config/systemd/user

Build configuration:
  --build-config configs/grit.conf --list-build-config
  --build-config configs/grit.conf --set-build-config GRIT_NORESIDUE_LEVEL=aggressive

Aliases accepted: ssh-reverse=ssh, socat-tls=tls-shell, builtin-tls=tls-shell
""",
    )
    parser.add_argument("--config", default=str(DEFAULT_CONFIG),
                        help="JSON config written by menuconfig")
    parser.add_argument("--build-config", default="configs/grit.conf",
                        help="griTTYkit shell build config used by scripts/menuconfig and make package")
    parser.add_argument("--transport",
                        choices=("ssh", "ssh-reverse", "tls-shell", "socat-tls",
                                 "builtin-tls", "plain-shell", "file-service", "command-queue", "bridge", "probe", "probe-tftp", "probe-ftp", "probe-dns"),
                        help="transport to listen for (overrides config)")
