                    "headless_command": headless,
                    "target_command": rec.get("target_command", "") if rec else "",
                    "route_kind": rec.get("route_kind", "") if rec else "",
                    "bridge_profile": rec.get("bridge_profile", "") if rec else "",
                    "probe_workflow_action_count": len(snap.get("probe_workflow_actions") or []),
                })
                start_service_process(
                    cfg,
                    "probe",
                    argv_extra=argv_extra,
                    headless_command=headless,
                )
        elif choice == "20":
            print_line_command_queue_view(detailed=True)
        elif choice == "21":
            unfiltered_cfg = dict(cfg)
            unfiltered_cfg.pop("_target_id_filter", None)
            unfiltered_cfg.pop("_target_label_filter", None)
            snap = workbench_snapshot(unfiltered_cfg)
            targets = snap.get("targets") or []
            current = configured_target_filter(cfg)
            if targets:
                for idx, rec in enumerate(targets, 1):
                    marker = "*" if str(rec.get("target_id") or "") == current else " "
                    print(
                        f"{idx}:{marker} {rec.get('target_id', '')} "
                        f"label={rec.get('label', '') or '-'} "
                        f"state={rec.get('connectivity_state', '') or '-'} "
                        f"mailbox_pending={rec.get('mailbox_pending_work_count', 0)} "
                        f"poll_overdue={'yes' if rec.get('poll_overdue') else 'no'} "
                        f"last_seen={rec.get('last_seen', '') or rec.get('last_seen_at', '') or '-'}"
                    )
            else:
                print("no known targets")
            selected_line = line_input("target number/id/label, current, or all> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if not selected:
                continue
            try:
                scope = "target"
                target = {}
                target_id = ""
                target_label = ""
                if selected.lower() == "current":
                    if not current:
                        raise ValueError("no current target filter is selected")
                    for rec in targets:
                        if str(rec.get("target_id") or "") == current:
                            target = rec
                            break
                    if not target:
                        raise ValueError(f"target not found: {current}")
                elif selected.lower() in ("all", "*"):
                    scope = "all"
                elif selected.isdigit():
                    idx = int(selected) - 1
                    if idx < 0 or idx >= len(targets):
                        raise ValueError(f"target number out of range: {selected}")
                    target = targets[idx]
                else:
                    lower = selected.lower()
                    for rec in targets:
                        candidate_id = str(rec.get("target_id") or "")
                        label = str(rec.get("label") or "")
                        aliases = [str(item) for item in rec.get("aliases") or []]
                        if selected == candidate_id or lower == label.lower() or lower in [alias.lower() for alias in aliases]:
                            target = rec
                            break
                    if not target:
                        raise ValueError(f"target not found: {selected}")
                if scope == "all":
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --json-status"
                    )
                    activity_doc = snap
                    print("Target activity feed: all")
                    print_target_activity_records(activity_doc, limit=12)
                    activity_count = len(activity_doc.get("target_activity_records") or [])
                    append_event(cfg, "workbench", "workbench_target_activity_inspected", details={
                        "headless_command": headless,
                        "scope": "all",
                        "target_activity_record_count": activity_count,
                    })
                else:
                    target_id = str(target.get("target_id") or "")
                    target_label = str(target.get("label") or target.get("target_label") or "")
                    scoped = scoped_target_cfg(cfg, target_id, target_label=target_label)
                    activity_doc = workbench_snapshot(scoped)
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --target-id "
                        + shquote(target_id)
                        + " --json-status"
                    )
                    print(f"Target activity feed: {target_id} label={target_label or '-'}")
                    print_target_activity_records(activity_doc, target_id=target_id, limit=12)
                    activity_count = len(activity_doc.get("target_activity_records") or [])
                    append_event(cfg, "workbench", "workbench_target_activity_inspected", details={
                        "headless_command": headless,
                        "scope": "target",
                        "target_id": target_id,
                        "target_label": target_label,
                        "target_activity_record_count": activity_count,
                    })
            except ValueError as exc:
                print(exc)
        elif choice == "?":
            print("Keys: 1-4 start services, 5 stop, 6 stage file, 10 stage item, 11 actions, 12 start job, 13 cancel job, 14 config, 15 target action, 16 target filter, 17 bridges, 18 target detail, 19 probe, 20 command queue, 21 target activity, 22 serve binary, 8/d unstage, 9/v view, c copy commands, r refresh, q quit.")
    for _sig, _prev in ((signal.SIGTERM, _prev_sigterm), (signal.SIGINT, _prev_sigint)):
        if _prev is not None:
            try:
                signal.signal(_sig, _prev)
            except (OSError, ValueError):
                pass
    return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0


def run_curses_tui(cfg):
    import curses

    pane_titles = {
        0: "Services",
        1: "Staged Files",
        2: "Target Files",
        3: "Recent Sessions",
        4: "Event Log",
        5: "Target Commands",
        6: "Release Artifacts",
        7: "Devices / Tuples",
        8: "Target Fleet",
        9: "Bridge Routes",
        10: "Mailbox",
        11: "Build Config",
        12: "Jobs",
        13: "Workflow Actions",
        14: "Target Actions",
        15: "Operator Daemon",
        16: "Target Activity",
    }
    pane_groups = {
        0: "Services",
        1: "Files",
        2: "Files",
        3: "Activity",
        4: "Activity",
        5: "Targets",
        6: "Files",
        7: "Files",
        8: "Targets",
        9: "Bridges",
        10: "Targets",
        11: "Automation",
        12: "Automation",
        13: "Automation",
        14: "Targets",
        15: "Daemon",
        16: "Activity",
    }
    pane_shortcuts = {
        ord("t"): 8,
        ord("a"): 14,
        ord("m"): 10,
        ord("b"): 9,
        ord("o"): 15,
        ord("f"): 2,
        ord("w"): 13,
        ord("e"): 4,
        ord("g"): 16,
    }

    def safe_add(stdscr, row, col, text, attr=0):
        height, width = stdscr.getmaxyx()
        if row < 0 or row >= height or col >= width:
            return
        try:
            stdscr.addstr(row, col, str(text)[:max(0, width - col - 1)], attr)
        except curses.error:
            pass

    def draw_list(stdscr, title, lines, row, col, height, width, selected=False):
        attr = curses.A_REVERSE if selected else curses.A_BOLD
        safe_add(stdscr, row, col, title[:width - 1], attr)
        for idx, line in enumerate(lines[:max(0, height - 1)], 1):
            safe_add(stdscr, row + idx, col, line[:width - 1])

    def selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples):
        if pane == 0 and services:
            row = services[min(selected, len(services) - 1)]
            return row.get("session_log") or row.get("process_log") or ""
        if pane == 1 and staged_names:
            rec = snap["staged"][staged_names[min(selected, len(staged_names) - 1)]]
            return rec.get("source_path", "")
        if pane == 2 and snap.get("target_file_transfer_records"):
            rec = snap["target_file_transfer_records"][min(selected, len(snap["target_file_transfer_records"]) - 1)]
            return rec.get("metadata_path") or rec.get("stored_path") or rec.get("source_path") or ""
        if pane == 3 and snap["sessions"]:
            rec = snap["sessions"][min(selected, len(snap["sessions"]) - 1)]
            return rec.get("path", "")
        if pane == 4:
            return str(Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "events.jsonl")
        if pane == 5:
            return ""
        if pane == 6 and release_artifacts:
            rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
            return rec.get("path", "")
        if pane == 7:
            combined = release_nav_records(release, release_devices, release_tuples)
            rec = combined[min(selected, len(combined) - 1)] if combined else {}
            record = rec.get("record") or {}
            artifact_paths = record.get("artifact_paths") or []
            return rec.get("path") or record.get("filesystem_path") or record.get("path") or (artifact_paths[0] if artifact_paths else "") or release.get("release_json", "")
        if pane == 12 and snap.get("workbench_jobs"):
            rec = snap["workbench_jobs"][min(selected, len(snap["workbench_jobs"]) - 1)]
            return rec.get("log_path", "")
        return ""

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        pane = 0
        selected = 0
        while not SHUTDOWN.is_set():
            snap = workbench_snapshot(cfg)
            services = [row["status_row"] for row in snap["services"].values()]
            staged_names = sorted(snap["staged"])
            target_file_transfer_records = snap.get("target_file_transfer_records") or []
            target_file_lines = [
                (
                    f"{'>' if pane == 2 and idx == selected else ' '} "
                    f"{m.get('target_id', '') or '-'} "
                    f"{m.get('operation', '') or '-'} "
                    f"{m.get('filename') or m.get('request_name') or '-'} "
                    f"status={m.get('status', '') or '-'} "
                    f"route={m.get('route_kind', '') or '-'}"
                )
                for idx, m in enumerate(target_file_transfer_records)
            ] or ["none"]
            session_lines = [
                f"{'>' if pane == 3 and idx == selected else ' '} {s.get('service', '')} {Path(s.get('path', '')).name} up={s.get('upload_count', 0)} fetch={s.get('fetch_count', 0)} ev={s.get('event_count', 0)} exit={s.get('exit_reason', '') or '-'}"
                for idx, s in enumerate(snap["sessions"])
            ] or ["none"]
            targets = snap.get("targets") or []
            target_lines = [
                (
                    f"{'>' if pane == 8 and idx == selected else ' '} "
                    f"{rec.get('target_id', '') or '-'} "
                    f"state={rec.get('connectivity_state', '') or '-'} "
                    f"pending={rec.get('mailbox_pending_work_count', 0)} "
                    f"overdue={'yes' if rec.get('poll_overdue') else 'no'} "
                    f"last={rec.get('last_seen', '') or rec.get('last_seen_at', '') or '-'}"
                )
                for idx, rec in enumerate(targets)
            ] or ["none"]
            target_workflow_actions = snap.get("target_workflow_actions") or []
            target_action_lines = [
                (
                    f"{'>' if pane == 14 and idx == selected else ' '} "
                    f"{rec.get('target_id', '') or '-'}:{rec.get('action_id', '') or '-'} "
                    f"wf={rec.get('workflow', '') or '-'} "
                    f"state={rec.get('operator_action_state', '') or '-'} "
                    f"reason={rec.get('operator_action_reason', '') or '-'}"
                )
                for idx, rec in enumerate(target_workflow_actions)
            ] or ["none"]
            target_activity_records = snap.get("target_activity_records") or []
            target_activity_lines = [
                (
                    f"{'>' if pane == 16 and idx == selected else ' '} "
                    f"{rec.get('target_id', '') or '-'} "
                    f"{rec.get('category', '') or '-'}:{rec.get('operation', '') or '-'} "
                    f"status={rec.get('status', '') or '-'} "
                    f"target_state={rec.get('target_connectivity_state', '') or '-'} "
                    f"offline_age={rec.get('target_offline_age_bucket', '') or '-'} "
                    f"pending={'yes' if rec.get('pending_work') else 'no'} "
                    f"at={rec.get('timestamp', '') or '-'}"
                )
                for idx, rec in enumerate(target_activity_records)
            ] or ["none"]
            bridge_profiles = snap.get("bridge_profiles") or []
            bridge_profile_workflow_actions_by_profile = snap.get("bridge_profile_workflow_actions_by_bridge_profile") or {}
            bridge_profile_workflow_actions_by_id = snap.get("bridge_profile_workflow_actions_by_id") or {}
            bridge_lines = [
                (
                    f"{'>' if pane == 9 and idx == selected else ' '} "
                    f"{rec.get('name', '') or '-'} "
                    f"state={rec.get('current_state', '') or '-'} "
                    f"target={rec.get('target_id', '') or '-'} "
                    f"hops={rec.get('hop_count', 0)} "
                    f"fail={'yes' if rec.get('has_last_failure') else 'no'}"
                )
                for idx, rec in enumerate(bridge_profiles)
            ] or ["none"]
            mailbox_records = snap.get("target_mailbox_records") or []
            mailbox_lines = [
                (
                    f"{'>' if pane == 10 and idx == selected else ' '} "
                    f"{rec.get('command_id', '') or '-'} "
                    f"target={rec.get('target_id', '') or '-'} "
                    f"status={rec.get('status', '') or '-'} "
                    f"pending={'yes' if rec.get('pending_work') else 'no'} "
                    f"reason={rec.get('pending_reason', '') or '-'}"
                )
                for idx, rec in enumerate(mailbox_records)
            ] or ["none"]
            config_fields = snap.get("workbench_config_fields") or []
            config_lines = [
                (
                    f"{'>' if pane == 11 and idx == selected else ' '} "
                    f"{rec.get('key', '')} "
                    f"cat={rec.get('category', '')} "
                    f"set={'yes' if rec.get('configured') else 'no'} "
                    f"value={rec.get('value', '') or '-'}"
                )
                for idx, rec in enumerate(config_fields)
            ] or ["none"]
            workbench_jobs = snap.get("workbench_jobs") or []
            job_lines = [
                (
                    f"{'>' if pane == 12 and idx == selected else ' '} "
                    f"{rec.get('id', '') or '-'} "
                    f"{rec.get('effective_state', '') or '-'} "
                    f"action={rec.get('action_id', '') or '-'} "
                    f"cancel={'yes' if rec.get('cancel_supported') else 'no'}"
                )
                for idx, rec in enumerate(workbench_jobs)
            ] or ["none"]
            workbench_actions = snap.get("workbench_actions") or []
            action_lines = [
                (
                    f"{'>' if pane == 13 and idx == selected else ' '} "
                    f"{rec.get('id', '') or '-'} "
                    f"cat={rec.get('category', '') or '-'} "
                    f"bg={'yes' if rec.get('background_supported') else 'no'} "
                    f"confirm={'yes' if rec.get('requires_confirmation') else 'no'}"
                )
                for idx, rec in enumerate(workbench_actions)
            ] or ["none"]
            actions_by_id = {
                str(rec.get("id") or ""): rec
                for rec in workbench_actions
                if isinstance(rec, dict) and rec.get("id")
            }
            service_workflow_actions_by_service = snap.get("service_workflow_actions_by_service") or {}
            service_workflow_actions_by_id = snap.get("service_workflow_actions_by_id") or {}
            staged_file_workflow_actions_by_request = snap.get("staged_file_workflow_actions_by_request_name") or {}
            staged_file_workflow_actions_by_id = snap.get("staged_file_workflow_actions_by_id") or {}
            file_service_workflow_actions = snap.get("file_service_workflow_actions") or []
            file_service_workflow_actions_by_id = snap.get("file_service_workflow_actions_by_id") or {}
            command_queue_workflow_actions = snap.get("command_queue_workflow_actions") or []
            command_queue_workflow_actions_by_id = snap.get("command_queue_workflow_actions_by_id") or {}
            operator_daemon_workflow_actions = snap.get("operator_daemon_workflow_actions") or []
            operator_daemon_workflow_actions_by_id = snap.get("operator_daemon_workflow_actions_by_id") or {}
            services_by_name = {str(row.get("name") or ""): row for row in services}
            daemon_service_names = configured_daemon_services(cfg, []) or ["file-service", "command-queue"]
            daemon_start_action = operator_daemon_workflow_actions_by_id.get("operator-daemon-start") or {}
            daemon_records = [{
                "kind": "daemon",
                "name": "operator-daemon",
                "row": {
                    "actual": daemon_start_action.get("daemon_status", "unknown"),
                    "pid": ",".join(str(pid) for pid in daemon_start_action.get("daemon_child_pids") or []),
                    "managed_by": "operator-daemon" if daemon_start_action.get("daemon_attached") else "",
                },
            }]
            daemon_records.extend(
                {"kind": "child", "name": name, "row": services_by_name.get(name) or {}}
                for name in daemon_service_names
            )
            daemon_attached = any(
                rec.get("daemon_attached") is True
                for rec in operator_daemon_workflow_actions
            )
            daemon_lines = [
                (
                    f"{'>' if pane == 15 and idx == selected else ' '} "
                    f"{rec.get('name', '')} "
                    f"{(rec.get('row') or {}).get('actual', 'unknown') or 'unknown'} "
                    f"pid={(rec.get('row') or {}).get('pid') or '-'} "
                    f"managed_by={(rec.get('row') or {}).get('managed_by') or '-'} "
                    f"pending_work={daemon_start_action.get('fleet_mailbox_pending_work_count', 0)}"
                )
                for idx, rec in enumerate(daemon_records)
            ] or ["none"]
            release = snap.get("release") or {}
            release_artifacts = release.get("artifacts") or []
            release_devices = release.get("devices") or []
            release_tuples = release.get("tuples") or []
            release_artifact_workflow_actions = snap.get("release_artifact_workflow_actions") or []
            release_artifact_workflow_actions_by_release_path = snap.get("release_artifact_workflow_actions_by_release_path") or {}
            release_artifact_workflow_actions_by_selector_kind = snap.get("release_artifact_workflow_actions_by_selector_kind") or {}
            release_nav = release_nav_records(release, release_devices, release_tuples)
            release_lines = [
                f"{'>' if pane == 6 and idx == selected else ' '} {a.get('name', '')} {a.get('payload_preset', '')} {a.get('tuple_path', '')}"
                for idx, a in enumerate(release_artifacts[:10])
            ] or ["none"]
            device_tuple_lines = [
                f"{'>' if pane == 7 and idx == selected else ' '} {rec.get('label', '')}"
                for idx, rec in enumerate(release_nav[:12])
            ]
            device_tuple_lines = device_tuple_lines or ["none"]
            recent_events = snap["events"][-8:]
            event_tail_status_line = event_tail_availability_text(snap)
            event_lines = [
                f"{'>' if pane == 4 and idx == selected else ' '} {e.get('ts', '')} {e.get('level', '')} {e.get('service', '')}:{e.get('event', '')}"
                for idx, e in enumerate(recent_events)
            ] or ["none"]
            target_command_records = snap.get("target_command_records") or []
            command_lines = [
                target_command_display_line(
                    rec,
                    prefix=f"{'>' if pane == 5 and idx == selected else ' '} ",
                )
                for idx, rec in enumerate(target_command_records)
                if isinstance(rec, dict)
            ] or ["none"]
            service_lines = []
            for idx, row in enumerate(services):
                prefix = ">" if pane == 0 and idx == selected else " "
                tls = "yes" if row["tls"] else "no"
                service_name = str(row.get("name") or "")
                start_action = service_workflow_actions_by_id.get(f"{service_name}:start-service") or {}
                stop_action = service_workflow_actions_by_id.get(f"{service_name}:stop-service") or {}
                enter_action = start_action if start_action.get("can_run_from_curses_enter") else stop_action
                service_lines.append(
                    f"{prefix} {row['name']:12s} {row['actual']}/{row['configured']} "
                    f"port={row['port']} tls={tls} pid={row['pid'] or '-'} "
                    f"enter={enter_action.get('curses_enter_action', '') or '-'}"
                )
            staged_lines = []
            for idx, name in enumerate(staged_names):
                rec = snap["staged"][name]
                prefix = ">" if pane == 1 and idx == selected else " "
                show_action = staged_file_workflow_actions_by_id.get(f"{name}:show-fetch-command") or {}
                staged_lines.append(
                    f"{prefix} {name} {rec.get('stage_kind', 'file')} {rec.get('size', '')}B "
                    f"{str(rec.get('sha256', ''))[:8]} enter={show_action.get('curses_enter_action', '') or '-'}"
                )
            staged_lines = staged_lines or [" none"]
            detail_lines = []
            if pane == 0 and services:
                row = services[min(selected, len(services) - 1)]
                service_name = str(row.get("name") or "")
                service_actions = service_workflow_actions_by_service.get(service_name) or []
                start_action = service_workflow_actions_by_id.get(f"{service_name}:start-service") or {}
                stop_action = service_workflow_actions_by_id.get(f"{service_name}:stop-service") or {}
                inspect_action = service_workflow_actions_by_id.get(f"{service_name}:inspect-status") or {}
                detail_lines = [
                    f"service: {row['name']}",
                    f"port: {row['port']}",
                    f"desired: {row['configured']}",
                    f"actual: {row['actual']}",
                    f"tls: {'yes' if row['tls'] else 'no'}",
                    f"pid: {row['pid'] or '-'} alive={row['pid_alive']}",
                    f"session_log: {row['session_log'] or '-'}",
                    f"process_log: {row['process_log'] or '-'}",
                    f"error: {row['error'] or '-'}",
                    f"service_workflow_actions: {len(service_actions)}",
                    f"fleet_pending_work: {inspect_action.get('fleet_mailbox_pending_work_count', 0)}",
                    f"fleet_offline_targets: {inspect_action.get('fleet_offline_target_count', 0)}",
                    f"fleet_poll_overdue: {inspect_action.get('fleet_poll_overdue_target_count', 0)}",
                    f"inspect_action_state: {inspect_action.get('operator_action_state', '') or '-'} reason={inspect_action.get('operator_action_reason', '') or '-'}",
                    f"start_action_state: {start_action.get('operator_action_state', '') or '-'} reason={start_action.get('operator_action_reason', '') or '-'}",
                    f"stop_action_state: {stop_action.get('operator_action_state', '') or '-'} reason={stop_action.get('operator_action_reason', '') or '-'}",
                    f"start_command: {start_action.get('headless_command', start_action.get('command', '')) or '-'}",
                    f"stop_command: {stop_action.get('headless_command', stop_action.get('command', '')) or '-'}",
                    "enter follows service workflow action readiness",
                    "action 11 includes service workflow actions",
                ]
            elif pane == 1 and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)]
                rec = snap["staged"][name]
                staged_actions = staged_file_workflow_actions_by_request.get(name) or []
                show_action = staged_file_workflow_actions_by_id.get(f"{name}:show-fetch-command") or {}
                queue_action = staged_file_workflow_actions_by_id.get(f"{name}:queue-staged-fetch") or {}
                unstage_action = staged_file_workflow_actions_by_id.get(f"{name}:unstage") or {}
                list_action = file_service_workflow_actions_by_id.get("file-service:list-staged-files") or {}
                stage_action = file_service_workflow_actions_by_id.get("file-service:stage-file") or {}
                detail_lines = [
                    f"request: {name}",
                    f"kind: {rec.get('stage_kind', 'file')}",
                    f"source: {rec.get('source_path', '')}",
                    f"release_path: {rec.get('release_path', '')}",
                    f"tuple_path: {rec.get('tuple_path', '')}",
                    f"payload_preset: {rec.get('payload_preset', '')}",
                    f"size: {rec.get('size', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"staged: {rec.get('staged_at', '')}",
                    f"source_exists: {rec.get('source_exists', False)}",
                    f"target_id: {rec.get('target_id', '') or '-'}",
                    f"target_label: {rec.get('target_label', '') or '-'}",
