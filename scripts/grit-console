    # ── probe commands ──────────────────────────────────────────────────────

    def print_line_probe_script(paste=False, base64_mode=False):
        route = probe_route_context(cfg)
        route_host = str(route.get("host", "OPERATOR_IP") or "OPERATOR_IP")
        route_port = int(route.get("port", cfg.get("GRIT_PROBE_PORT", 22207)) or 22207)
        script_text = probe_script_fn(cfg, route_host, route_port).rstrip()
        if base64_mode:
            print(render_probe_base64_paste(script_text))
            return
        if paste:
            print(render_probe_paste(script_text))
            return
        print(script_text)

    def probe_line_start(queue=False, start_service=False):
        # If operator host isn't pinned and we have an interactive terminal,
        # let the user pick from local IPs rather than auto-selecting blindly.
        if not str(cfg.get("GRIT_OPERATOR_SERVER_HOST") or "").strip() and sys.stdin.isatty():
            candidates = local_ip_choice_candidates()
            if len(candidates) > 1:
                print("Multiple local IPs — which should the target use to POST results back?")
                print("")
                for i, ip in enumerate(candidates, 1):
                    print(f"  {i}  {ip}")
                print(f"  o  Other (enter manually)")
                print("")
                choice_line = line_input(f"  Select (1-{len(candidates)}, o, or enter for {candidates[0]})> ")
                choice = (choice_line or "").strip()
                if not choice:
                    cfg["GRIT_OPERATOR_SERVER_HOST"] = candidates[0]
                elif choice.lower() == "o":
                    other = (line_input("  IP address> ") or "").strip()
                    if other:
                        cfg["GRIT_OPERATOR_SERVER_HOST"] = other
                elif choice.isdigit() and 1 <= int(choice) <= len(candidates):
                    cfg["GRIT_OPERATOR_SERVER_HOST"] = candidates[int(choice) - 1]
                print(f"  Using: {cfg.get('GRIT_OPERATOR_SERVER_HOST', candidates[0])}")
                print("")
            elif len(candidates) == 1:
                cfg["GRIT_OPERATOR_SERVER_HOST"] = candidates[0]

        command = render_probe_command(cfg)
        snap = workbench_snapshot(cfg)
        actions = snap.get("probe_workflow_actions_by_id") or {}
        start_action = actions.get("probe:start-probe") or {}
        start_headless = (
            start_action.get("run_command")
            or start_action.get("headless_command")
            or service_start_headless_command(cfg, "probe")
        )

        svc = line_service_record(service_status_rows(cfg), "probe")
        already_listening = str(svc.get("actual") or "") == "listening"

        started = False
        if start_service and not already_listening:
            start_service_process(cfg, "probe", headless_command=start_headless)
            started = True
        elif start_service and already_listening:
            print("Probe listener already running.")

        port = cfg.get("GRIT_PROBE_PORT", 22207)
        script_name = cfg.get("GRIT_PROBE_NAME", "probe.sh")

        if not already_listening and not started:
            print(f"[!] Probe listener is NOT running on port {port}.")
            print(f"    The target command below will fail until you start it.")
            print(f"    Run:  probe --start")
            print("")

        print(f"Probe  —  port {port}  |  script {script_name}  |  {'listening' if (already_listening or started) else 'NOT listening'}")

        queued = {}
        target_id = configured_target_filter(cfg)
        if queue:
            if not target_id:
                raise ValueError("select an agent before probe --queue; use agent NAME or use target ID")
            queued = queue_command(cfg, command, metadata={
                "work_kind": "probe",
                "workflow": "probe",
                "request_name": str(script_name),
                "route_kind": "bridge" if cfg.get("bridge_profile") else "direct",
                "bridge_profile": str(cfg.get("bridge_profile") or ""),
            })
            print(f"  queued: {queued['id']}")
            print(f"  target: {queued.get('target_id', '')} ({queued.get('target_label', '') or '-'})")

        if already_listening or started:
            _print_probe_delivery()

        append_event(cfg, "workbench", "workbench_probe_command_shown", details={
            "target_command": command,
            "target_id": target_id,
            "target_label": str(selected_target_context(cfg).get("target_label") or ""),
            "queued": bool(queue),
            "command_id": queued.get("id", "") if queued else "",
            "started_service": started,
            "already_listening": already_listening,
            "GRIT_PROBE_NAME": str(script_name),
            "GRIT_PROBE_PORT": port,
        })
        return command

    # keep old name as alias
    def survey_line_bootstrap(queue=False, start_service=False):
        return probe_line_start(queue=queue, start_service=start_service)

    def find_survey_uploads(limit=20):
