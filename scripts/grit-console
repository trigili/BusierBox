    def view_line_path(path_text):
        return operator_io_view_line_path(cfg, path_text, append_event_fn=append_event)

    install_readline_completer(_readline, HAVE_READLINE, line_completion_candidates)

    render_full = False
    compact_next_prompt = False
    pending_console_lines = []
    line_history = []
    while not SHUTDOWN.is_set():
        snap = None
        if compact_next_prompt:
            compact_next_prompt = False
        elif render_full:
            print("")
            print_workbench(cfg, include_api_summary=False)
            render_full = False
            snap = workbench_snapshot(cfg)
        else:
            print("")
            snap = workbench_snapshot(cfg)
            print_line_console_banner(snap, grit_version())
        if pending_console_lines:
            line = pending_console_lines.pop(0)
            print(f"{line_repl_prompt()}{line}")
        else:
            line = line_input(line_repl_prompt())
        if line is None:
            break
        choice = line.strip()
        if not choice:
            compact_next_prompt = True
            continue
        replayed_history = False
        try:
            if choice == "!!" or (choice.startswith("!") and choice[1:].isdigit()):
                choice = line_history_command(line_history, choice)
                replayed_history = True
                print(f"replay: {choice}")
            elif choice.lower().startswith("repeat "):
                repeat_args = shlex.split(choice)
                if len(repeat_args) != 2:
                    raise ValueError("usage: repeat N")
                choice = line_history_command(line_history, repeat_args[1])
                replayed_history = True
                print(f"replay: {choice}")
        except ValueError as exc:
            print(exc)
            continue
        record_line_history(line_history, choice, readline_module=_readline if HAVE_READLINE else None)
        if replayed_history and choice.isdigit():
            clear_line_selectable_results()
        console_args = []
        if not (choice.isdigit() or choice in {"c", "d", "r", "v", "q"}):
            try:
                console_args = shlex.split(choice)
            except ValueError as exc:
                print(exc)
                continue
            cmd = console_args[0].lower() if console_args else ""
            compact_next_prompt = True
            preserve_line_results = cmd == "use" and len(console_args) == 2 and console_args[1].isdigit()
            if not preserve_line_results:
                clear_line_selectable_results()
            # Handle "<topic> ?" syntax, e.g. "files ?", "routes ?"
            if len(console_args) >= 2 and console_args[-1] == "?":
                print_line_command_help(cmd)
                continue
            if cmd in {"q", "quit", "exit"}:
                choice = "q"
            elif cmd == "?":
                if len(console_args) >= 2:
                    print_line_command_help(console_args[1])
                else:
                    print_context_line_help()
                continue
            elif cmd == "help":
                if len(console_args) >= 2:
                    print_line_command_help(console_args[1])
                else:
                    print_context_line_help()
                continue
            elif (completion_cmd := parse_line_completion_command(cmd, console_args[1:])):
                print_line_completions(completion_cmd["prefix"])
                continue
            elif (resource_cmd := parse_line_resource_command(cmd, console_args[1:])):
                dispatch_line_resource_command(
                    resource_cmd,
                    history_func=lambda limit="": line_resources_print_line_history(
                        line_history,
                        limit,
                    ),
                    load_func=lambda path: pending_console_lines.extend(
                        load_line_resource(cfg, path)
                    ),
                    save_func=lambda path: write_line_makerc(cfg, path, line_history),
                )
                continue
            elif (events_cmd := parse_line_events_command(cmd, console_args[1:])):
                dispatch_line_events_command(events_cmd, print_func=print_line_events)
                continue
            elif (search_cmd := parse_line_search_command(cmd, console_args[1:])):
                dispatch_line_search_command(search_cmd, search_func=search_line_resources)
                continue
            elif (workspace_cmd := parse_line_workspace_command(cmd, console_args[1:])):
                workspace_result = dispatch_line_workspace_command(
                    workspace_cmd,
                    status_func=lambda: print(line_repl_status_bar(workbench_snapshot(cfg))),
                    ips_func=lambda: print_line_local_ips(workbench_snapshot(cfg)),
                    workspace_func=lambda: (clear_line_module(quiet=True), print_line_workspace()),
                    reload_func=reload_line_config_for_repl,
                    root_func=clear_line_context,
                    info_func=print_line_info,
                    next_func=print_line_next,
                    options_func=print_line_options,
                )
                if workspace_result == "refresh":
                    compact_next_prompt = False
                    choice = "r"
                continue
            elif (build_cmd := parse_line_build_command(cmd, console_args[1:])):
                dispatch_line_build_command(
                    build_cmd,
                    set_context_func=set_line_collection,
                    run_func=lambda args: run_line_build_command(cfg, args),
                )
                continue
            elif (option_cmd := parse_line_option_command(cmd, console_args[1:])):
                dispatch_line_option_command(
                    option_cmd,
                    set_global_func=lambda key, value: set_line_global_build_option(
                        cfg, key, value,
                    ),
                    set_context_func=lambda key, value: line_options_set_line_option(
                        cfg, key, value,
                    ),
                    unset_global_func=lambda key: unset_line_global_build_option(cfg, key),
                    unset_context_func=unset_line_option,
                )
                continue
            elif (metadata_cmd := parse_line_target_metadata_command(cmd, console_args[1:])):
                dispatch_line_target_metadata_command(
                    metadata_cmd,
                    rename_func=lambda value: line_options_rename_line_target(cfg, value),
                    note_func=lambda value: line_options_note_line_target(cfg, value),
                    alias_func=lambda value: line_options_alias_line_target(cfg, value),
                )
                continue
            elif (show_cmd := parse_line_show_command(cmd, console_args[1:])):
                dispatch_line_show_command(show_cmd, show_func=show_line_resource)
                continue
            elif (commands_cmd := parse_line_generated_commands_command(cmd, console_args[1:])):
                dispatch_line_generated_commands_command(
                    commands_cmd,
                    run_func=lambda args: run_line_generated_command(cfg, args),
                )
                continue
            elif (copy_cmd := parse_line_copy_command(cmd, console_args[1:])):
                dispatch_line_copy_command(
                    copy_cmd,
                    service_copy_func=lambda subcmd: copy_line_service_command(
                        cfg,
                        subcmd,
                        lambda command, label: copy_text_for_operator(cfg, command, label=label),
                        start_command=lambda svc: service_start_headless_command(cfg, svc),
                        stop_command=lambda svc: service_stop_headless_command(cfg, svc),
                    ),
                    generated_copy_func=lambda selector: copy_line_generated_command(
                        cfg,
                        selector,
                    ),
                )
                continue
            elif (listener_cmd := parse_line_listener_command(cmd, console_args[1:])):
                dispatch_line_listener_command(
                    listener_cmd,
                    list_func=lambda verbose=False: (
                        set_line_collection("listeners"),
                        print_line_services(verbose=verbose),
                    ),
                    select_func=select_line_service,
                )
                continue
            elif (target_cmd := parse_line_target_command(cmd, console_args[1:])):
                dispatch_line_target_command(
                    target_cmd,
                    list_func=lambda: (
                        set_line_collection("targets"),
                        print_line_targets(),
                    ),
                    select_func=select_line_target,
                )
                continue
            elif (session_cmd := parse_line_sessions_command(cmd, console_args[1:])):
                dispatch_line_sessions_command(
                    session_cmd,
                    clear_func=clear_line_sessions,
                    help_func=print_line_command_help,
                    interact_func=interact_line_session,
                    list_func=lambda verbose=False: (
                        set_line_collection("sessions"),
                        print_line_sessions(verbose=verbose),
                    ),
                )
                continue
            elif (route_cmd := parse_line_route_command(cmd, console_args[1:])):
                dispatch_line_route_command(
                    route_cmd,
                    add_func=add_line_route,
                    start_func=start_line_route,
                    stop_func=stop_line_route,
                    delete_func=delete_line_route,
                    help_func=print_line_command_help,
                    select_func=select_line_route,
                    list_func=lambda verbose=False: (
                        set_line_collection("routes"),
                        print_line_routes(verbose=verbose),
                    ),
                )
                continue
            elif (use_cmd := parse_line_use_command(cmd, console_args[1:])):
                dispatch_line_use_command(
                    use_cmd,
                    alias_recorder=record_line_alias,
                    number_func=use_line_search_result,
                    target_func=select_line_target,
                    listener_func=select_line_service,
                    route_func=select_line_route,
                    session_func=select_line_session,
                    job_func=select_line_job,
                    action_func=select_line_action,
                    after_number_func=clear_line_selectable_results,
                )
                continue
            elif (context_cmd := parse_line_context_command(cmd, console_args[1:])):
                dispatch_line_context_command(
                    context_cmd,
                    clear_target_func=lambda: select_line_target("all", targets=[]),
                    root_func=clear_line_context,
                    back_func=back_line_module,
                )
                continue
            elif (service_cmd := parse_line_service_control_command(cmd, console_args[1:])):
                dispatch_line_service_control_command(
                    service_cmd,
                    start_func=start_line_service,
                    stop_func=stop_line_service,
                )
                continue
            elif (action_cmd := parse_line_action_command(cmd, console_args[1:])):
                dispatch_line_action_command(
                    action_cmd,
                    alias_recorder=record_line_alias,
                    start_job_func=start_line_job,
                    cancel_job_func=cancel_line_job,
                    run_func=run_line_module_or_service,
                )
                continue
            elif (interact_cmd := parse_line_interact_command(
                cmd,
                console_args[1:],
                target_selected=bool(configured_target_filter(cfg)),
                module=cfg.get("_line_console_module"),
            )):
                dispatch_line_interact_command(
                    interact_cmd,
                    target_func=interact_line_target,
                    session_func=interact_line_session,
                )
                continue
            elif (download_cmd := parse_line_download_command(cmd, console_args[1:])):
                dispatch_line_download_command(
                    download_cmd,
                    download_func=download_line_target,
                    set_context_func=lambda: set_line_collection("files"),
                )
                continue
            elif (probe_cmd := parse_line_probe_command(cmd, console_args[1:])):
                dispatch_line_probe_command(
                    probe_cmd,
                    set_context_func=set_line_collection,
                    results_func=lambda: probe_results_print_line_probe_results(
                        cfg, append_event_fn=append_event,
                    ),
                    config_func=lambda args: configure_line_probe_config(
                        cfg, args, append_event_fn=append_event,
                    ),
                    clear_func=lambda args: probe_results_clear_line_probe_results(
                        cfg, args, append_event_fn=append_event,
                    ),
                    serve_func=lambda args: probe_serve_run_line_probe_serve(
                        cfg, args, line_input, stage_line_release,
                        append_event_fn=append_event,
                    ),
                    delivery_func=_print_probe_delivery,
                    paste_func=lambda base64_mode=False: print_line_probe_script(
                        paste=True,
                        base64_mode=base64_mode,
                    ),
                    script_func=lambda: print_line_probe_script(paste=False),
                    help_func=print_line_command_help,
                    start_func=probe_line_start,
                )
                continue
            elif (survey_cmd := parse_line_survey_command(cmd, console_args[1:])):
                dispatch_line_survey_command(
                    survey_cmd,
                    set_context_func=set_line_collection,
                    results_func=lambda: configure_print_line_survey_status(
                        cfg, append_event_fn=append_event,
                    ),
                    config_func=lambda args: configure_line_survey_config(
                        cfg, args, find_survey_uploads,
                        append_event_fn=append_event,
                    ),
                    preset_func=lambda args: configure_line_survey_preset(
                        cfg, args, find_survey_uploads,
                        append_event_fn=append_event,
                    ),
                    help_func=print_line_command_help,
                )
                continue
            elif (daemon_cmd := parse_line_daemon_command(cmd, console_args[1:])):
                dispatch_line_daemon_command(
                    daemon_cmd,
                    set_context_func=set_line_collection,
                    run_func=run_line_daemon_action,
                )
                continue
            elif (release_cmd := parse_line_release_alias_command(cmd, console_args[1:])):
                dispatch_line_release_command(
                    release_cmd,
                    list_func=lambda: (
                        set_line_collection("release"),
                        line_release_print_line_release(cfg, append_event_fn=append_event),
                    ),
                    stage_func=lambda selector, start_file_service=False: (
                        stage_line_release(
                            selector,
                            start_file_service=start_file_service,
                        ),
                        set_line_collection("files"),
                    ),
                    help_func=print_line_command_help,
                )
                continue
            elif (file_cmd := parse_line_file_transfer_command(cmd, console_args[1:])):
                dispatch_line_file_command(
                    file_cmd,
                    upload_func=stage_line_file,
                    fetch_func=fetch_line_staged,
                    unstage_func=unstage_line_file,
                    set_context_func=lambda: set_line_collection("files"),
                )
                continue
            elif (view_cmd := parse_line_view_command(cmd, console_args[1:])):
                dispatch_line_view_command(view_cmd, view_func=view_line_path)
                continue
            elif (files_cmd := parse_line_files_command(cmd, console_args[1:])):
                dispatch_line_file_command(
                    files_cmd,
                    upload_func=stage_line_file,
                    fetch_func=fetch_line_staged,
                    unstage_func=unstage_line_file,
                    clear_func=lambda confirm=False: line_files_clear_line_files(
                        cfg,
                        confirm=confirm,
                        target_filter_id=configured_target_filter(cfg),
                        append_event_fn=append_event,
                    ),
                    list_func=lambda verbose=False: print_line_files(verbose=verbose),
                    set_context_func=lambda: set_line_collection("files"),
                )
                continue
            elif (queue_cmd := parse_line_queue_command(cmd, console_args[1:])):
                dispatch_line_queue_command(
                    queue_cmd,
                    original_cmd=cmd,
                    set_context_func=lambda: set_line_collection("queue"),
                    run_func=run_line_queue_command,
                    view_func=print_line_command_queue_view,
                )
                continue
            elif (jobs_cmd := parse_line_jobs_command(cmd, console_args[1:])):
                dispatch_line_jobs_command(
                    jobs_cmd,
                    cancel_func=cancel_line_job,
                    select_func=select_line_job,
                    list_func=lambda verbose=False: (
                        set_line_collection("jobs"),
                        print_line_jobs(verbose=verbose),
                    ),
                )
                continue
            elif (binary_cmd := parse_line_binary_command(cmd, console_args[1:])):
                dispatch_line_binary_command(
                    binary_cmd,
                    stage_binary_func=stage_line_binary,
                    set_context_func=lambda: set_line_collection("files"),
                )
                continue
            elif (configure_cmd := parse_line_configure_command(cmd, console_args[1:])):
                dispatch_line_configure_command(
                    configure_cmd,
                    configure_func=configure_line_artifact,
                    set_context_func=lambda: set_line_collection("files"),
                )
                continue
            else:
                print(line_unknown_command_message(cmd))
                continue
        if choice in {"q", "quit", "exit"}:
            # Leave any selected context first; a second q/quit at root exits.
            if str(cfg.get("_line_console_module") or "") or configured_target_filter(cfg):
                clear_line_context()
                compact_next_prompt = True
                continue
            mark_service_stopped(cfg, "workbench", "quit")
            return 0
        # If a number was entered and there are active search results (e.g. from
        # `listeners`, `targets`, `search`, etc.), use those — the numbers shown
        # in any list command correspond to search result positions.
        if choice.isdigit() and cfg.get("_line_console_search_results"):
            search_results = cfg.get("_line_console_search_results") or []
            idx = int(choice) - 1
            if 0 <= idx < len(search_results):
                try:
                    use_line_search_result(choice)
                    clear_line_selectable_results()
                except ValueError as exc:
                    print(exc)
                compact_next_prompt = True
                continue
            print(f"search result number out of range: {choice}")
            compact_next_prompt = True
            continue
        if choice in {"1", "2", "3", "4"}:
            service = {"1": "ssh", "2": "tls-shell", "3": "plain-shell", "4": "file-service"}[choice]
            start_line_service(service)
            # Brief poll so the banner reflects actual listening state
            for _ in range(10):
                time.sleep(0.1)
                if str((line_service_record(service_status_rows(cfg), service) or {}).get("actual") or "") == "listening":
                    break
        elif choice == "5":
            service = line_input("service> ")
            if service is not None:
                stop_line_service(service.strip())
        elif choice == "6":
            path_line = line_input("local file> ")
            name_line = line_input("target request name> ")
            path = path_line.strip() if path_line is not None else ""
            name = name_line.strip() if name_line is not None else ""
            try:
                headless = (
                    "scripts/grit-console --config "
                    + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                    + " --serve-file "
                    + shquote(path)
                    + " --as "
                    + shquote(name)
                    + " --list-staged"
                )
                rec = stage_file(cfg, path, name)
                print(f"staged {rec['request_name']}")
                print(render_fetch_command(rec["request_name"], cfg))
                append_event(cfg, "workbench", "workbench_file_staged", details={
                    "headless_command": headless,
                    "request_name": rec.get("request_name", ""),
                    "source_path": rec.get("source_path", ""),
                    "stage_kind": rec.get("stage_kind", ""),
                    "target_id": rec.get("target_id", ""),
                    "target_label": rec.get("target_label", ""),
                })
            except ValueError as exc:
                print(exc)
        elif choice == "7":
            print_staged(cfg)
            snap = workbench_snapshot(cfg)
            file_actions = snap.get("file_service_workflow_actions") or []
            if file_actions:
                print("File service workflow actions:")
                for rec in file_actions:
                    print(
                        f"  {rec.get('id', '')} "
                        f"state={rec.get('operator_action_state', '') or '-'} "
                        f"reason={rec.get('operator_action_reason', '') or '-'} "
                        f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                        f"fleet_targets={rec.get('fleet_target_count', 0)} "
                        f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                        f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                        f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                    )
                    if rec.get("target_command_template"):
                        print(f"    target_command_template: {rec.get('target_command_template', '')}")
            staged_actions = snap.get("staged_file_workflow_actions") or []
            if staged_actions:
                print("Staged file workflow actions:")
                for rec in staged_actions:
                    print(
                        f"  {rec.get('id', '')} "
                        f"state={rec.get('operator_action_state', '') or '-'} "
                        f"reason={rec.get('operator_action_reason', '') or '-'} "
                        f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                        f"target_pending={rec.get('target_mailbox_pending_work_count', 0)} "
                        f"fleet_pending={rec.get('fleet_mailbox_pending_work_count', 0)} "
                        f"poll_overdue={'yes' if rec.get('target_poll_overdue') else 'no'}"
                    )
            headless = (
                "scripts/grit-console --config "
                + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                + " --list-staged"
            )
            append_event(cfg, "workbench", "workbench_staged_files_viewed", details={
                "headless_command": headless,
                "staged_count": len(snap.get("staged_records") or []),
                "file_service_workflow_action_count": len(file_actions),
                "staged_file_workflow_action_count": len(staged_actions),
            })
        elif choice == "8" or choice == "d":
            name_line = line_input("target request name> ")
            name = name_line.strip() if name_line is not None else ""
            if name:
                try:
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --unstage "
                        + shquote(name)
                        + " --list-staged"
                    )
                    existed = unstage_file(cfg, name)
                    print("unstaged" if existed else "not staged")
                    append_event(cfg, "workbench", "workbench_file_unstaged", details={
                        "headless_command": headless,
                        "request_name": name,
                        "existed": existed,
                    })
                except ValueError as exc:
                    print(exc)
        elif choice == "9" or choice == "v":
            path_line = line_input("local path> ")
            path = path_line.strip() if path_line is not None else ""
            if path:
                operator_io_view_line_path(cfg, path, append_event_fn=append_event)
        elif choice == "10":
            rel = release_context(cfg)
            if not rel:
                print("no release bundle detected")
                continue
            nav = release_nav_records(rel, rel.get("devices") or [], rel.get("tuples") or [], limit=12)
            for idx, rec in enumerate(nav, 1):
                print(f"{idx}: {rec.get('label', '')}")
            selector_line = line_input(
                "release selection number, recommendation id, artifact path, "
                "by_device:NAME, by_device_payload_preset:NAME:PRESET, "
                "by_tuple_path:PATH, or by_tuple_payload_preset:PATH:PRESET> "
            )
            selector = selector_line.strip() if selector_line is not None else ""
            if selector:
                try:
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --stage-release-artifact "
                        + shquote(selector)
                    )
                    rec = stage_release_selection(cfg, selector)
                    print(f"staged {rec['request_name']}")
                    print(render_fetch_command(rec["request_name"], cfg))
                    append_event(cfg, "workbench", "workbench_release_artifact_staged", details={
                        "selector": selector,
                        "headless_command": headless,
                        "request_name": rec.get("request_name", ""),
                        "release_artifact_name": rec.get("release_artifact_name", ""),
                        "release_path": rec.get("release_path", ""),
                        "tuple_path": rec.get("tuple_path", ""),
                        "payload_preset": rec.get("payload_preset", ""),
                    })
                except ValueError as exc:
                    print(exc)
        elif choice == "22":
            try:
                stage_line_binary()
            except ValueError as exc:
                print(exc)
        elif choice == "11":
            headless = (
                "scripts/grit-console --config "
                + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                + " --status"
            )
            snap = workbench_snapshot(cfg)
            summary = snap.get("summary") or {}
            print(
                "Workbench action summary: "
                f"total={summary.get('workbench_action_count', 0)} "
                f"background_supported={summary.get('workbench_action_background_supported_count', 0)} "
                f"foreground_runnable={summary.get('workbench_action_foreground_runnable_count', 0)} "
                f"requires_confirmation={summary.get('workbench_action_requires_confirmation_count', 0)}"
            )
            print(
                "Operator daemon workflow action summary: "
                f"total={summary.get('operator_daemon_workflow_action_count', 0)} "
                f"attached={summary.get('operator_daemon_workflow_action_attached_count', 0)} "
                f"enter_runnable={summary.get('operator_daemon_workflow_action_can_run_from_curses_enter_count', 0)} "
                f"fleet_pending_work={format_counts(summary.get('operator_daemon_workflow_action_fleet_mailbox_pending_work_count_counts') or {})} "
                f"fleet_offline={format_counts(summary.get('operator_daemon_workflow_action_fleet_offline_target_count_counts') or {})} "
                f"fleet_poll_overdue={format_counts(summary.get('operator_daemon_workflow_action_fleet_poll_overdue_target_count_counts') or {})}"
            )
            action_preview = []
            seen_action_ids = set()
            for rec in snap.get("workbench_actions") or []:
                rec_id = str(rec.get("id") or "")
                if rec_id in (
                    "operator-daemon-start",
                    "operator-daemon-status",
                    "operator-daemon-stop",
                    "systemd-user-status",
                ) or rec.get("background_supported") is True:
                    if rec_id and rec_id not in seen_action_ids:
                        seen_action_ids.add(rec_id)
                        action_preview.append(rec)
                if len(action_preview) >= 8:
                    break
            for idx, rec in enumerate(action_preview, 1):
                print(f"{idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(
                    f"   category={rec.get('category', '')} background_supported={'yes' if rec.get('background_supported') else 'no'} "
                    f"confirm={'yes' if rec.get('requires_confirmation') else 'no'} "
                    f"foreground_runnable={'yes' if rec.get('foreground_runnable') else 'no'} "
                    f"state={rec.get('operator_action_state', '') or '-'} "
                    f"reason={rec.get('operator_action_reason', '') or '-'} "
                    f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                    f"enter_action={rec.get('curses_enter_action', '') or '-'} "
                    f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                    f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                    f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                )
            service_actions = snap.get("service_workflow_actions") or []
            service_action_preview = []
            seen_service_action_ids = set()
            for rec in service_actions:
                if rec.get("can_run_from_curses_enter") or rec.get("service") == "file-service":
                    rec_id = str(rec.get("id") or "")
                    if rec_id and rec_id not in seen_service_action_ids:
                        seen_service_action_ids.add(rec_id)
                        service_action_preview.append(rec)
                if len(service_action_preview) >= 10:
                    break
            if service_actions:
                print(
                    "Service workflow actions: "
                    f"total={len(service_actions)} preview={len(service_action_preview)} "
                    f"runnable/file-service actions shown"
                )
            for idx, rec in enumerate(service_action_preview, 1):
                print(f"service {idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(
                    f"   service={rec.get('service', '')} category={rec.get('category', '')} "
                    f"actual={rec.get('actual', '') or '-'} configured={rec.get('configured', '') or '-'} "
                    f"confirm={'yes' if rec.get('requires_confirmation') else 'no'} "
                    f"state={rec.get('operator_action_state', '') or '-'} "
                    f"reason={rec.get('operator_action_reason', '') or '-'} "
                    f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                    f"enter_action={rec.get('curses_enter_action', '') or '-'} "
                    f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                    f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                    f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                )
            target_actions = snap.get("target_workflow_actions") or []
            if target_actions:
                print(f"Target workflow actions: total={len(target_actions)}; use action 15 for the prompted target workflow list")
            append_event(cfg, "workbench", "workbench_actions_viewed", details={
                "headless_command": headless,
                "action_count": len(snap.get("workbench_actions") or []),
                "service_workflow_action_count": len(snap.get("service_workflow_actions") or []),
                "target_workflow_action_count": len(snap.get("target_workflow_actions") or []),
            })
            selected_line = line_input("operator action id/number to run, or blank> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if selected:
                try:
                    action = select_workbench_action(workbench_action_records(cfg), selected)
                    if action.get("background_supported") is True:
                        print("background action; use action 12 to start it as a managed job")
                        continue
                    dry_line = line_input("dry-run/preview only? [Y/n]> ")
                    dry_run = dry_line is None or dry_line.strip().lower() not in ("n", "no")
                    confirmed = False
                    if not dry_run and action.get("requires_confirmation") is True:
                        confirm_line = line_input("run confirmed action now? type yes> ")
                        confirmed = confirm_line is not None and confirm_line.strip().lower() == "yes"
                    rc = run_workbench_action_record(
                        cfg,
                        workbench_action_records(cfg),
                        action.get("id", selected),
                        dry_run=dry_run,
                        confirmed=confirmed,
                        show_commands=False,
                    )
                    print(f"workbench_action_returncode={rc}")
                except (ValueError, IndexError) as exc:
                    print(exc)
        elif choice == "15":
            snap = workbench_snapshot(cfg)
            actions = snap.get("target_workflow_actions") or []
            for idx, rec in enumerate(actions, 1):
                print(f"{idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(f"   target={rec.get('target_id', '')} workflow={rec.get('workflow', '')} input={'yes' if rec.get('requires_input') else 'no'}")
            selected_line = line_input("target workflow action id or number> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if selected:
                try:
                    rec = select_workflow_action(actions, selected, "target")
                    rc = run_target_workflow_action(cfg, rec.get("id", selected), input_func=line_input, show_commands=False)
                    print(f"target_workflow_action_returncode={rc}")
                    target_id = str(rec.get("target_id") or "")
                    if target_id:
                        target_label = str(rec.get("target_label") or "")
                        scoped = scoped_target_cfg(cfg, target_id, target_label=target_label)
                        print("Target activity after action:")
                        print_target_summary(workbench_snapshot(scoped), limit=2)
                except (ValueError, IndexError) as exc:
                    print(exc)
        elif choice == "16":
            unfiltered_cfg = dict(cfg)
            unfiltered_cfg.pop("_target_id_filter", None)
            unfiltered_cfg.pop("_target_label_filter", None)
