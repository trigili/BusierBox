                        help="clear explicit operator command queue entries")
    parser.add_argument("--listen-host", help="listener bind address")
    parser.add_argument("--ssh-port", type=int, help="SSH reverse-forward listener port")
    parser.add_argument("--shell-port", type=int,
                        help="TLS/plain shell listener port (socat-port alias also accepted)")
    parser.add_argument("--socat-port", type=int,
                        help=argparse.SUPPRESS)  # compat alias for --shell-port
    parser.add_argument("--forward-port", type=int,
                        help="remote forward port exposed on the operator workstation")
    parser.add_argument("--file-port", type=int,
                        help="receive-only file service listener port")
    parser.add_argument("--command-queue-port", type=int,
                        help="command queue poll listener port")
    parser.add_argument("--bridge-port", type=int,
                        help="TCP bridge listener port")
    parser.add_argument("--bridge-dest-host",
                        help="TCP bridge destination host")
    parser.add_argument("--bridge-dest-port", type=int,
                        help="TCP bridge destination port")
    parser.add_argument("--bridge-profile",
                        help="named bridge profile to use for bridge listener/status context")
    parser.add_argument("--save-bridge-profile",
                        help="create or update a named bridge profile from current bridge flags")
    parser.add_argument("--bridge-profile-purpose",
                        help="purpose text stored with --save-bridge-profile")
    parser.add_argument("--bridge-profile-notes",
                        help="operator notes stored with --save-bridge-profile")
    parser.add_argument("--bridge-hop", action="append", default=[],
                        help="explicit bridge profile hop FROM=TO; may be repeated for multi-hop chains")
    parser.add_argument("--inspect-bridge-profile",
                        help="inspect one named bridge profile")
    parser.add_argument("--delete-bridge-profile",
                        help="delete one named bridge profile")
    parser.add_argument("--list-bridge-profiles", action="store_true",
                        help="list named bridge profiles")
    parser.add_argument("--json-bridge-profiles", action="store_true",
                        help="print named bridge profiles as JSON")
    parser.add_argument("--probe-port", type=int,
                        help="probe HTTP listener port")
    parser.add_argument("--probe-tftp-port", type=int,
                        help="probe TFTP UDP listener port")
    parser.add_argument("--probe-ftp-port", type=int,
                        help="probe FTP listener port")
    parser.add_argument("--probe-dns-port", type=int,
                        help="probe DNS UDP listener port")
    parser.add_argument("--probe-dns-name",
                        help="probe DNS TXT query name, default probe.grit")
    parser.add_argument("--probe-name",
                        help="probe script filename, default probe.sh")
    parser.add_argument("--file-service-tls", choices=("yes", "no"),
                        help="use TLS for file-service uploads (default yes)")
    parser.add_argument("--timeout", type=float, default=0,
                        help="seconds to wait for a connection; 0 waits forever")
    parser.add_argument("--no-stdin", action="store_true",
                        help="do not relay local stdin to the remote shell")
    parser.add_argument("--log-only", action="store_true",
                        help="alias for --no-stdin; receive stdout/session log only")
    parser.add_argument("--one-shot", action="store_true",
                        help="exit after one shell session instead of waiting for reconnects")
    parser.add_argument("--script",
                        help="file containing shell input to send after tls/plain shell connect")
    parser.add_argument("--expect",
                        help="literal text that must appear in captured shell output")
    parser.add_argument("--session-timeout", type=float, default=30,
                        help="seconds to allow a scripted shell session; 0 disables the limit")
    parser.add_argument("--managed-by", help=argparse.SUPPRESS)
    parser.add_argument("--process-log", help=argparse.SUPPRESS)
    if "--version" in raw_argv or "-V" in raw_argv:
        print(f"griTTYkit {grit_version()}")
        return 0
    if "--help-console" in raw_argv:
        print_console_help_reference()
        return 0
    if any(arg in ("-h", "--help") for arg in raw_argv):
        print_concise_help()
        return 0
    if "--help-all" in raw_argv:
        raw_argv = [arg for arg in raw_argv if arg != "--help-all"]
        parser.print_help()
        return 0
    args = parser.parse_args(raw_argv)

    cfg = load_config(args.config)
    cfg["_config_path"] = args.config
    cfg["_build_config_path"] = args.build_config
    if args.listen_host:
        cfg["listen_host"] = args.listen_host
    if args.ssh_port:
        cfg["ssh_listen_port"] = args.ssh_port
    shell_port = args.shell_port or args.socat_port
    if shell_port:
        cfg["GRIT_RSHELL_SOCAT_PORT"] = shell_port
    if args.forward_port:
        cfg["GRIT_OPERATOR_REMOTE_FORWARD_PORT"] = args.forward_port
    if args.file_port:
        cfg["GRIT_OPERATOR_FILE_SERVICE_PORT"] = args.file_port
    if args.command_queue_port:
        cfg["GRIT_COMMAND_QUEUE_PORT"] = str(args.command_queue_port)
    if args.bridge_port:
        cfg["bridge_listen_port"] = args.bridge_port
    if args.bridge_dest_host:
        cfg["bridge_dest_host"] = args.bridge_dest_host
    if args.bridge_dest_port:
        cfg["bridge_dest_port"] = args.bridge_dest_port
    if args.probe_port:
        cfg["GRIT_PROBE_PORT"] = args.probe_port
    if args.probe_tftp_port:
        cfg["GRIT_PROBE_TFTP_PORT"] = args.probe_tftp_port
    if args.probe_ftp_port:
        cfg["GRIT_PROBE_FTP_PORT"] = args.probe_ftp_port
    if args.probe_dns_port:
        cfg["GRIT_PROBE_DNS_PORT"] = args.probe_dns_port
    if args.probe_dns_name:
        cfg["GRIT_PROBE_DNS_NAME"] = args.probe_dns_name
    if args.probe_name:
        cfg["GRIT_PROBE_NAME"] = args.probe_name
    if args.file_service_tls:
        cfg["GRIT_OPERATOR_FILE_SERVICE_TLS"] = args.file_service_tls
    if args.state_file:
        cfg["server_state"] = args.state_file
    if args.staged_file:
        cfg["staged_files"] = args.staged_file
    if args.command_queue_file:
        cfg["command_queue_file"] = args.command_queue_file
    if args.command_copy_file:
        cfg["command_copy_file"] = args.command_copy_file
    if args.targets_file:
        cfg["targets_file"] = args.targets_file
    if args.bridge_profiles_file:
        cfg["bridge_profiles_file"] = args.bridge_profiles_file
    if args.target_id:
        cfg["_target_id_filter"] = args.target_id
    if args.target_label:
        cfg["_target_label_filter"] = args.target_label
    if args.target_alias:
        cfg["_target_alias_filter"] = args.target_alias
    if args.release_dir:
        cfg["release_dir"] = args.release_dir
    if args.managed_by:
        cfg["_managed_by"] = args.managed_by
    if args.process_log:
        cfg["_process_log"] = args.process_log
    if args.bridge_profile:
        try:
            apply_bridge_profile(cfg, args.bridge_profile)
        except ValueError as exc:
            print(f"grit-console: {exc}", file=sys.stderr)
            return 2
    if args.event_limit < 0:
        print("grit-console: --event-limit must be >= 0", file=sys.stderr)
        return 2
    cfg["_event_limit"] = args.event_limit

    try:
        if args.save_bridge_profile:
            rec = save_bridge_profile(cfg, args.save_bridge_profile, purpose=args.bridge_profile_purpose or "", notes=args.bridge_profile_notes or "", hop_args=args.bridge_hop)
            print(f"saved bridge profile {rec.get('name', '')}: {rec.get('route_path', '')}")
            print(f"bridge_profiles_file={bridge_profiles_path(cfg)}")
            if not (args.inspect_bridge_profile or args.delete_bridge_profile or args.list_bridge_profiles or args.json_bridge_profiles):
                return 0
        if args.delete_bridge_profile:
            rec = delete_bridge_profile(cfg, args.delete_bridge_profile)
            print(f"deleted bridge profile {rec.get('name', '')}: {rec.get('route_path', '')}")
            print(f"bridge_profiles_file={bridge_profiles_path(cfg)}")
            if not (args.inspect_bridge_profile or args.list_bridge_profiles or args.json_bridge_profiles):
                return 0
        if args.inspect_bridge_profile:
            return print_bridge_profile(cfg, args.inspect_bridge_profile, json_output=args.json_bridge_profiles)
        if args.list_bridge_profiles or args.json_bridge_profiles:
            return print_bridge_profiles(cfg, json_output=args.json_bridge_profiles)
        if args.start_workbench_job:
            print(f"workbench action: {args.start_workbench_job}")
            headless = start_workbench_job_headless_command(
                cfg,
                args.start_workbench_job,
                command_override=args.job_command,
            )
            rec = start_workbench_job_record(
                cfg,
                workbench_action_records(cfg),
                args.start_workbench_job,
                command_override=args.job_command,
                headless_command=headless,
            )
            print(f"started workbench job {rec.get('id', '')}: pid={rec.get('pid', '')}")
            print(f"log={rec.get('log_path', '')}")
            print(f"command={rec.get('command', '')}")
            return 0
        if args.cancel_workbench_job:
            headless = cancel_workbench_job_headless_command(cfg, args.cancel_workbench_job)
            rec = cancel_workbench_job_record(
                cfg,
                workbench_action_records(cfg),
                args.cancel_workbench_job,
                headless_command=headless,
            )
            print(f"cancel requested for workbench job {rec.get('id', args.cancel_workbench_job)}")
            print(f"pid={rec.get('pid', '')}")
            return 0
        if args.run_workbench_action:
            return run_workbench_action_record(
                cfg,
                workbench_action_records(cfg),
                args.run_workbench_action,
                dry_run=args.workbench_action_dry_run,
                confirmed=args.confirm_workbench_action,
            )
        if args.run_service_workflow_action:
            return run_service_workflow_action(
                cfg,
                args.run_service_workflow_action,
                dry_run=args.service_workflow_dry_run,
                confirmed=args.confirm_service_workflow_action,
            )
        if args.run_operator_daemon_workflow_action:
            return run_operator_daemon_workflow_action(
                cfg,
                args.run_operator_daemon_workflow_action,
                dry_run=args.operator_daemon_workflow_dry_run,
                confirmed=args.confirm_operator_daemon_workflow_action,
            )
        if args.run_release_artifact_workflow_action:
            return run_release_artifact_workflow_action(
                cfg,
                args.run_release_artifact_workflow_action,
                dry_run=args.release_artifact_workflow_dry_run,
            )
        if args.run_command_queue_workflow_action:
            return run_command_queue_workflow_action(
                cfg,
                args.run_command_queue_workflow_action,
                command_input=args.command_queue_workflow_command or "",
                dry_run=args.command_queue_workflow_dry_run,
                confirmed=args.confirm_command_queue_workflow_action,
            )
        if args.run_probe_workflow_action:
            return run_probe_workflow_action(
                cfg,
                args.run_probe_workflow_action,
                dry_run=args.probe_workflow_dry_run,
                confirmed=args.confirm_probe_workflow_action,
            )
        if args.run_bridge_profile_workflow_action:
            return run_bridge_profile_workflow_action(
                cfg,
                args.run_bridge_profile_workflow_action,
                dry_run=args.bridge_profile_workflow_dry_run,
                confirmed=args.confirm_bridge_profile_workflow_action,
            )
        if args.run_file_service_workflow_action:
            return run_file_service_workflow_action(
                cfg,
                args.run_file_service_workflow_action,
                local_file=args.file_service_workflow_local_file or "",
                request_name=args.file_service_workflow_request_name or "",
                target_path=args.file_service_workflow_target_path or "",
                dry_run=args.file_service_workflow_dry_run,
                confirmed=args.confirm_file_service_workflow_action,
            )
        if args.run_staged_file_workflow_action:
            return run_staged_file_workflow_action(
                cfg,
                args.run_staged_file_workflow_action,
                dry_run=args.staged_file_workflow_dry_run,
                confirmed=args.confirm_staged_file_workflow_action,
            )
        if args.run_target_workflow_action:
            return run_target_workflow_action(
                cfg,
                args.run_target_workflow_action,
                command_input=args.target_workflow_command or "",
                local_file=args.target_workflow_local_file or "",
                request_name=args.target_workflow_request_name or "",
            )
        if args.list_build_config:
            for rec in workbench_config_field_records(cfg):
                print(f"{rec.get('key', '')}={shell_double_quote(rec.get('value', ''))} category={rec.get('category', '')} configured={'yes' if rec.get('configured') else 'no'}")
                print(f"  safety: boundary={rec.get('safety_boundary', '')} control_like={'yes' if rec.get('control_like') else 'no'} explicit_choice={'yes' if rec.get('requires_explicit_operator_choice') else 'no'}")
                print(f"  label: {rec.get('label', '')}")
                print(f"  set: {rec.get('set_command', '')}")
            append_event(cfg, "workbench", "workbench_config_viewed", details={"config_path": str(build_config_path(cfg)), "field_count": len(workbench_config_field_records(cfg))})
            return 0
        if args.set_build_config:
            for assignment in args.set_build_config:
                rec = set_workbench_build_config(cfg, assignment)
                print(f"set {rec.get('key', '')}={shell_double_quote(rec.get('value', ''))} in {rec.get('config_path', '')}")
            return 0
        if args.copy_target_command:
            rec = copy_generated_command(cfg, args.copy_target_command)
            print(f"copied target command {args.copy_target_command} to {rec['path']}")
            print(f"clipboard={'yes' if rec['clipboard'] else 'no'}")
            print(rec["text"])
            return 0
        if args.view_path:
            headless = view_path_headless_command(cfg, args.view_path)
            result = open_path_in_pager(args.view_path)
            print(result)
            append_event(cfg, "workbench", "workbench_path_viewed", details={
                "headless_command": headless,
                "path": args.view_path,
                "result": result,
                "viewable": viewable_path(args.view_path) is not None,
                "via": "server-view-path",
            })
            return 0
        if args.set_target_label:
            if args.target_label is None:
                raise ValueError("--set-target-label requires --target-label")
            rec = set_target_label(
                cfg, args.set_target_label, args.target_label,
                aliases=args.target_alias or [], notes=args.target_notes,
            )
            print(f"target {rec.get('target_id', '')} label={rec.get('label', '')}")
            if str(rec.get("notes") or "").strip():
                print(f"notes={str(rec.get('notes') or '').strip()}")
            print(f"targets_file={targets_path(cfg)}")
            return 0
    except ValueError as exc:
        print(f"grit-console: {exc}", file=sys.stderr)
        return 2

    try:
        if args.clear_command_queue:
            count = clear_command_queue(cfg)
            print(f"cleared {count} command queue entr{'y' if count == 1 else 'ies'}")
            if not (args.queue_command or args.list_command_queue or args.json_command_queue):
                return 0
        if args.queue_command:
            rec = queue_command(
                cfg,
                args.queue_command,
                timeout_sec=args.queue_timeout,
                max_output_bytes=args.queue_max_output,
                expire_sec=args.queue_expire_sec,
            )
            print(f"queued {rec['id']}: {rec['command']}")
            if rec.get("target_id"):
                print(f"target={rec.get('target_id', '')} label={rec.get('target_label', '')}")
            print(f"execution_supported={'yes' if rec.get('execution_supported') else 'no'} delivery_supported=no")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.record_command_result:
            if not args.result_json:
                raise ValueError("--record-command-result requires --result-json")
            rec = record_command_result(cfg, args.record_command_result, args.result_json)
            print(f"recorded result for {rec['id']}: status={rec.get('result', {}).get('status', '')}")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.list_command_queue or args.json_command_queue:
            print_command_queue(cfg, json_output=args.json_command_queue)
            return 0
    except ValueError as exc:
        print(f"grit-console: {exc}", file=sys.stderr)
        return 2

    if args.status or args.json_status or args.api_status:
        return print_status(cfg, json_output=args.json_status or args.api_status)
    if args.stop_service:
        stop_recorded_service(
            cfg,
            args.stop_service,
            via="server-stop-service",
            headless_command=service_stop_headless_command(cfg, args.stop_service),
        )
        return 0
    if args.stop:
        return stop_managed_services(cfg)
    if args.systemd_user_action:
        try:
            return handle_systemd_user_action(
                cfg,
                args.systemd_user_action,
                args.daemon_service,
                args.systemd_user_unit_name,
                unit_dir=args.systemd_user_unit_dir,
                dry_run=args.systemd_user_dry_run,
            )
        except ValueError as exc:
            print(f"grit-console: {exc}", file=sys.stderr)
            return 2

    timeout = None if args.timeout == 0 else args.timeout
    if args.daemon:
        try:
            return run_operator_daemon(cfg, args.daemon_service, timeout=timeout)
        except ValueError as exc:
            print(f"grit-console: {exc}", file=sys.stderr)
            return 2
    action = "file-service" if args.file_service else resolve_transport(cfg, args.transport)
    script_bytes = None
    if args.script:
        script_bytes = Path(args.script).read_bytes()
        if script_bytes and not script_bytes.endswith(b"\n"):
            script_bytes += b"\n"
    session_timeout = None if args.session_timeout == 0 else args.session_timeout

    try:
        if args.serve_file:
            request_name = args.serve_as or Path(args.serve_file).name
            rec = stage_file(cfg, args.serve_file, request_name)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            if rec.get("target_id"):
                print(f"target={rec.get('target_id', '')} label={rec.get('target_label', '')}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.serve_dir:
            records = stage_dir(cfg, args.serve_dir)
            for rec in records:
                print(f"staged {rec['request_name']} <- {rec['source_path']}")
                if rec.get("target_id"):
                    print(f"target={rec.get('target_id', '')} label={rec.get('target_label', '')}")
                print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.stage_release_artifact:
            rec = stage_release_artifact(cfg, args.stage_release_artifact)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            if rec.get("target_id"):
                print(f"target={rec.get('target_id', '')} label={rec.get('target_label', '')}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.unstage:
            existed = unstage_file(cfg, args.unstage)
            print(f"unstaged {args.unstage}" if existed else f"not staged {args.unstage}")
        if args.list_staged:
            print_staged(cfg)
            return 0
    except ValueError as exc:
        print(f"grit-console: {exc}", file=sys.stderr)
        return 2

    if args.tui:
        return run_tui(cfg)
    # Open the console when no explicit service/transport action was requested.
    # --config, --release-dir, --target-id etc. are context flags, not actions.
    _explicit_action = bool(
        args.transport or args.daemon or getattr(args, "file_service", False)
        or getattr(args, "serve_file", None) or getattr(args, "serve_dir", None)
        or getattr(args, "stage_release_artifact", None)
        or getattr(args, "list_staged", False) or getattr(args, "unstage", None)
        or getattr(args, "stop", False)
        or getattr(args, "status", False) or getattr(args, "json_status", False)
        or getattr(args, "api_status", False)
        or getattr(args, "systemd_user_action", None)
    )
    if not _explicit_action and not args.no_tui and sys.stdin.isatty() and sys.stdout.isatty():
        return run_line_console(cfg)

    try:
        if action == "ssh":
            return serve_ssh(cfg, timeout)
        if action == "tls-shell":
            return serve_tls_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                   max_sessions=shell_listener_max_sessions(cfg, explicit_one_shot=args.one_shot, scripted=bool(args.script)),
                                   script_bytes=script_bytes, expect=args.expect,
                                   session_timeout=session_timeout)
        if action == "plain-shell":
            return serve_plain_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                     max_sessions=shell_listener_max_sessions(cfg, explicit_one_shot=args.one_shot, scripted=bool(args.script)),
                                     script_bytes=script_bytes, expect=args.expect,
                                     session_timeout=session_timeout)
        if action == "file-service":
            return serve_file_service(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "command-queue":
            return serve_command_queue(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "bridge":
            return serve_bridge(cfg, timeout, max_sessions=1 if args.one_shot else 0,
                                session_timeout=session_timeout)
        if action == "probe":
            return serve_probe(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "probe-tftp":
            return serve_probe_tftp(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "probe-ftp":
            return serve_probe_ftp(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "probe-dns":
            return serve_probe_dns(cfg, timeout, max_sessions=1 if args.one_shot else 0)
    except KeyboardInterrupt:
        print("grit-console: interrupted, shutting down", file=sys.stderr)
        request_shutdown("keyboard_interrupt")
        record_shutdown_event(cfg, action)
        mark_service_stopped(cfg, action, "keyboard_interrupt")
        return 130
    except OSError:
        return 1
    print(f"unsupported transport: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    install_shutdown_handlers()
    raise SystemExit(main())
