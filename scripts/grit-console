#!/usr/bin/env python3
"""griTTYkit operator console and service supervisor.

This helper manages target-initiated reverse-access transports, probe
bootstrap listeners, staged file delivery, command queues, bridge routes,
release artifact selection, and the interactive operator console.

Transport model:
  ssh        — Dropbear/dbclient reverse SSH (GRIT_RSHELL_TRANSPORT=ssh)
  tls-shell  — wolfSSL or socat TLS shell (builtin+tls or socat+tls)
  plain-shell — plaintext shell (debug/insecure; socat+none or builtin+none)
"""

