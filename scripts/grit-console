        f"events={summary.get('event_count', 0)}"
    )
    print(
        "  session durations: "
        f"known={summary.get('session_duration_known_count', 0)} "
        f"total_sec={summary.get('session_total_duration_sec', 0)} "
        f"avg_sec={summary.get('session_average_duration_sec', 0)} "
