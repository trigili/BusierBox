        total = len(all_sessions)
        search_records = print_line_session_records(
            all_sessions,
            verbose=verbose,
            view_command=lambda path: view_path_headless_command(cfg, path),
            quote=shquote,
        )
        cfg["_line_console_search_results"] = search_records
        append_event(cfg, "workbench", "workbench_sessions_listed", details={
            "session_count": total,
            "shown_count": len(search_records),
            "verbose": bool(verbose),
        })

