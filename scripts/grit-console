        print("  Files and releases:")
        print("    6 stage file")
        print("    7 list staged")
        print("    8 unstage file")
        print("    9 open local path in pager")
        print("    10 stage release recommendation/device/tuple")
        print("    22 serve griTTYkit binary")
        print("    c show/copy generated commands")
        print("  Automation and config:")
        print("    11 show operator workflow actions")
        print("    12 start background workflow job")
        print("    13 cancel background workflow job")
        print("    14 configure griTTYkit build field")
        print("  r refresh")
        print("  ? help")
        print("  q quit")

    if HAVE_READLINE:
        _rl_completion_cache = {"line": None, "candidates": []}

        def _rl_completer(text, state):
            try:
                line = _readline.get_line_buffer()
                if line != _rl_completion_cache["line"]:
                    _rl_completion_cache["line"] = line
                    _rl_completion_cache["candidates"] = line_completion_candidates(line)
                candidates = _rl_completion_cache["candidates"]
                if state < len(candidates):
                    return candidates[state]
            except Exception:
                pass
            return None

        _readline.set_completer(_rl_completer)
        _readline.set_completer_delims("\t\n")
        _readline.parse_and_bind("tab: complete")

    def _print_local_ips():
        import socket
        snap = workbench_snapshot(cfg)
        candidates = snap.get("local_ips") or []
        print("Local IPs:")
        if candidates:
            for ip in candidates:
                print(f"  {ip}")
        else:
            # fallback: enumerate directly
            try:
                addrs = set()
                for info in socket.getaddrinfo(socket.gethostname(), None):
                    addr = info[4][0]
                    if not addr.startswith("127.") and addr != "::1":
                        addrs.add(addr)
                for addr in sorted(addrs):
                    print(f"  {addr}")
            except Exception:
                print("  (could not determine local IPs)")
        print("  use: set GRIT_OPERATOR_SERVER_HOST <IP>  to configure")

    render_full = False
    compact_next_prompt = False
    pending_console_lines = []
    line_history = []
    while not SHUTDOWN.is_set():
        snap = None
        if compact_next_prompt:
            compact_next_prompt = False
        elif render_full:
            print("")
            print_workbench(cfg, include_api_summary=False)
            render_full = False
            snap = workbench_snapshot(cfg)
        else:
            print("")
            snap = workbench_snapshot(cfg)
            print_line_console_banner(snap)
        if pending_console_lines:
            line = pending_console_lines.pop(0)
            print(f"{line_tui_prompt()}{line}")
        else:
            line = line_input(line_tui_prompt())
        if line is None:
            break
        choice = line.strip()
        if not choice:
            continue
        try:
            if choice == "!!" or (choice.startswith("!") and choice[1:].isdigit()):
                choice = line_history_command(choice)
                print(f"replay: {choice}")
            elif choice.lower().startswith("repeat "):
                repeat_args = shlex.split(choice)
                if len(repeat_args) != 2:
                    raise ValueError("usage: repeat N")
                choice = line_history_command(repeat_args[1])
                print(f"replay: {choice}")
        except ValueError as exc:
            print(exc)
            continue
        record_line_history(choice)
        console_args = []
        if not (choice.isdigit() or choice in {"c", "d", "r", "v", "q"}):
            try:
                console_args = shlex.split(choice)
            except ValueError as exc:
                print(exc)
                continue
            cmd = console_args[0].lower() if console_args else ""
            compact_next_prompt = True
            # Handle "<topic> ?" syntax, e.g. "files ?", "routes ?"
            if len(console_args) >= 2 and console_args[-1] == "?":
                print_line_command_help(cmd)
                continue
            if cmd in {"q", "quit", "exit"}:
                choice = "q"
            elif cmd in {"help", "?"}:
                print_line_command_help(console_args[1] if len(console_args) >= 2 else "")
                continue
            elif cmd in {"complete", "completions"}:
                print_line_completions(" ".join(console_args[1:]).strip())
                continue
            elif cmd == "history":
                try:
                    print_line_history(console_args[1] if len(console_args) >= 2 else "")
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "events":
                try:
                    print_line_events(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "resource":
                try:
                    pending_console_lines.extend(load_line_resource(" ".join(console_args[1:]).strip()))
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "makerc":
                try:
                    write_line_makerc(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "search":
                try:
                    search_line_resources(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"status", "summary"}:
                print(line_tui_status_bar(workbench_snapshot(cfg)))
                continue
            elif cmd == "reload":
                config_path = str(cfg.get("_config_path") or DEFAULT_CONFIG)
                try:
                    new_cfg = load_config(config_path)
                    # Preserve internal session/console state keys
                    internal = {k: v for k, v in cfg.items() if k.startswith("_")}
                    cfg.clear()
                    cfg.update(new_cfg)
                    cfg.update(internal)
                    print(f"Config reloaded: {config_path}")
                    changed = [k for k in new_cfg if not k.startswith("_") and new_cfg.get(k) != DEFAULTS.get(k)]
                    print(f"  {len(changed)} setting(s) active from config file")
                    append_event(cfg, "workbench", "workbench_config_reloaded", details={
                        "config_path": config_path,
                        "changed_count": len(changed),
                    })
                except Exception as exc:
                    print(f"reload failed: {exc}")
                continue
            elif cmd in {"ips", "local-ips", "list-local-ips"}:
                _print_local_ips()
                continue
            elif cmd in {"workspace", "overview", "dashboard"}:
                print_line_workspace()
                continue
            elif cmd in {"main", "home", "root"}:
                clear_line_context()
                continue
            elif cmd == "info":
                print_line_info()
                continue
            elif cmd == "next":
                print_line_next()
                continue
            elif cmd in {"options", "opts"}:
                print_line_options()
                continue
            elif cmd == "build":
                try:
                    run_line_build_command(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "set":
                try:
                    if len(console_args) >= 2 and "=" in console_args[1]:
                        opt_key, opt_value = console_args[1].split("=", 1)
                        if len(console_args) > 2:
                            opt_value = opt_value + " " + " ".join(console_args[2:])
                    else:
                        opt_key = console_args[1] if len(console_args) >= 2 else ""
                        opt_value = " ".join(console_args[2:]).strip()
                    set_line_option(opt_key, opt_value)
                except (IndexError, ValueError) as exc:
                    print(exc)
                continue
            elif cmd == "rename":
                try:
                    rename_line_target(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"note", "notes"}:
                try:
                    note_line_target(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "alias":
                try:
                    alias_line_target(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "setg":
                try:
                    if len(console_args) >= 2 and "=" in console_args[1]:
                        opt_key, opt_value = console_args[1].split("=", 1)
                        if len(console_args) > 2:
                            opt_value = opt_value + " " + " ".join(console_args[2:])
                    else:
                        opt_key = console_args[1] if len(console_args) >= 2 else ""
                        opt_value = " ".join(console_args[2:]).strip()
                    set_line_global_option(opt_key, opt_value)
                except (IndexError, ValueError) as exc:
                    print(exc)
                continue
            elif cmd == "unset":
                try:
                    unset_line_option(console_args[1] if len(console_args) >= 2 else "")
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "unsetg":
                try:
                    unset_line_global_option(console_args[1] if len(console_args) >= 2 else "")
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "show":
                try:
                    show_line_resource(" ".join(console_args[1:]).strip() if len(console_args) >= 2 else "options")
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"commands", "target-commands"}:
                try:
                    run_line_generated_command(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "copy":
                subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                if subcmd in {"start", "stop"}:
                    key = f"_service_{subcmd}_command"
                    command = str(cfg.get(key) or "")
                    if not command:
                        # derive on demand from current service context
                        module = str(cfg.get("_line_console_module") or "")
                        if module.startswith("service/"):
                            svc = module.split("/", 1)[1]
                            command = (service_start_headless_command(cfg, svc)
                                       if subcmd == "start"
                                       else service_stop_headless_command(cfg, svc))
                    if not command:
                        print(f"no {subcmd} command available — select a service first")
                    else:
                        rec = copy_text_for_operator(cfg, command, label=f"{subcmd} command")
                        print(f"copied {subcmd} command  clipboard={'yes' if rec.get('clipboard') else 'no'}")
                        print(f"  {command}")
                else:
                    try:
                        copy_line_generated_command(" ".join(console_args[1:]).strip())
                    except ValueError as exc:
                        print(exc)
                continue
            elif cmd in {"categories", "category", "module-categories"}:
                print_line_module_categories()
                continue
            elif cmd in {"modules", "module"}:
                print_line_actions(" ".join(console_args[1:]).strip())
                continue
            elif cmd in {"services", "listeners"}:
                print_line_services(verbose=len(console_args) >= 2 and console_args[1] in {"-v", "--verbose"})
                continue
            elif cmd == "listener":
                if len(console_args) >= 2 and console_args[1] in {"-v", "--verbose"}:
                    print_line_services(verbose=True)
                    continue
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print_line_services()
                    continue
                try:
                    select_line_service(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"targets", "agents", "hosts"}:
                print_line_targets()
                continue
            elif cmd in {"target", "agent", "host"}:
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print_line_targets()
                    continue
                try:
                    select_line_target(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"sessions", "session"}:
                if len(console_args) >= 2 and console_args[1].lower() in {"clear", "prune", "clean"}:
                    flags = {a.lower() for a in console_args[2:]}
                    clear_line_sessions(
                        all_sessions="--all" in flags,
                        confirm="--confirm" in flags,
                    )
                elif cmd == "session" and len(console_args) >= 2:
                    try:
                        interact_line_session(" ".join(console_args[1:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif len(console_args) >= 3 and console_args[1] in {"-i", "--interact"}:
                    try:
                        interact_line_session(" ".join(console_args[2:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif len(console_args) >= 2 and console_args[1] in {"-h", "--help"}:
                    print_line_command_help("sessions")
                elif len(console_args) >= 2 and console_args[1] in {"-v", "--verbose"}:
                    print_line_sessions(verbose=True)
                elif len(console_args) >= 2 and console_args[1] not in {"-l", "--list"}:
                    try:
                        interact_line_session(" ".join(console_args[1:]).strip())
                    except ValueError as exc:
                        print(exc)
                else:
                    print_line_sessions()
                continue
            elif cmd in {"routes", "route"}:
                route_subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                if cmd == "route" and route_subcmd == "add":
                    try:
                        add_line_route(console_args[1:])
                    except ValueError as exc:
                        print(exc)
                elif cmd == "route" and route_subcmd == "start":
                    try:
                        start_line_route(" ".join(console_args[2:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif cmd == "route" and route_subcmd == "stop":
                    try:
                        stop_line_route(" ".join(console_args[2:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif cmd == "route" and route_subcmd in {"delete", "rm", "remove"}:
                    try:
                        delete_line_route(" ".join(console_args[2:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif len(console_args) >= 2 and console_args[1] in {"-h", "--help"}:
                    print_line_command_help("routes")
                elif len(console_args) >= 2 and console_args[1] in {"-v", "--verbose", "print"}:
                    print_line_routes(verbose=True)
                elif cmd == "route" and len(console_args) >= 2:
                    try:
                        select_line_route(" ".join(console_args[1:]).strip())
                    except ValueError as exc:
                        print(exc)
                else:
                    print_line_routes()
                continue
            elif cmd == "use" and len(console_args) == 2 and console_args[1].isdigit():
                try:
                    use_line_search_result(console_args[1])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "target":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use target ID|LABEL|NUMBER|all")
                    continue
                try:
                    select_line_target(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() in {"agent", "host"}:
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use agent ID|LABEL|NUMBER|all")
                    continue
                try:
                    select_line_target(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "service":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use service SERVICE")
                    continue
                try:
                    select_line_service(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "listener":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use listener SERVICE")
                    continue
                try:
                    select_line_service(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "route":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use route NAME|NUMBER")
                    continue
                try:
                    select_line_route(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "session":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use session SESSION")
                    continue
                try:
                    select_line_session(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "job":
                selector = " ".join(console_args[2:]).strip()
                if not selector:
                    print("usage: use job ID|NUMBER")
                    continue
                try:
                    select_line_job(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "action":
                selector = " ".join(console_args[2:]).strip()
                try:
                    select_line_action(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "use" and len(console_args) >= 2 and console_args[1].lower() == "module":
                selector = " ".join(console_args[2:]).strip()
                try:
                    select_line_action(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"useagent", "usehost", "usetarget"}:
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print("usage: useagent ID|LABEL|NUMBER|all")
                    continue
                try:
                    record_line_alias(cmd, "use agent")
                    select_line_target(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"uselistener", "useservice"}:
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print("usage: uselistener SERVICE")
                    continue
                try:
                    record_line_alias(cmd, "use listener")
                    select_line_service(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "useroute":
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print("usage: useroute NAME|NUMBER")
                    continue
                try:
                    record_line_alias(cmd, "use route")
                    select_line_route(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "usesession":
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print("usage: usesession SESSION")
                    continue
                try:
                    record_line_alias(cmd, "use session")
                    select_line_session(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"usemodule", "useaction"}:
                selector = " ".join(console_args[1:]).strip()
                if not selector:
                    print("usage: usemodule ACTION")
                    continue
                try:
                    record_line_alias(cmd, "use module")
                    select_line_action(selector)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "clear" and len(console_args) >= 2 and console_args[1].lower() == "target":
                try:
                    select_line_target("all", targets=[])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "back" and len(console_args) >= 2 and console_args[1].lower() in {"all", "main", "root"}:
                clear_line_context()
                continue
            elif cmd in {"back", "background", "bg", "unset"}:
                clear_line_module()
                continue
            elif cmd == "start":
                try:
                    start_line_service(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "stop":
                try:
                    stop_line_service(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"run", "execute", "exploit"}:
                try:
                    if cmd != "run":
                        record_line_alias(cmd, "run")
                    if any(item in {"-j", "--job"} for item in console_args[1:]):
                        action_selector = " ".join(item for item in console_args[1:] if item not in {"-j", "--job"}).strip()
                        start_line_job(action_selector)
                    else:
                        run_line_module_or_service(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "check":
                try:
                    run_line_module_or_service(console_args[1:], dry_run_default=True)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "interact":
                try:
                    if len(console_args) >= 2 and console_args[1].lower() in {"agent", "target", "host"}:
                        interact_line_target(" ".join(console_args[2:]).strip())
                    elif len(console_args) == 1 and configured_target_filter(cfg) and not str(cfg.get("_line_console_module") or "").startswith("session/"):
                        interact_line_target()
                    else:
                        interact_line_session(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"kill", "cancel"}:
                try:
                    cancel_line_job(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "queue" and len(console_args) >= 2:
                try:
                    run_line_queue_command(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"download", "get"}:
                try:
                    target_path, queue_download, start_download_service = parse_line_download_args(console_args[1:])
                    download_line_target(target_path, queue=queue_download, start_file_service=start_download_service)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "probe":
                subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                try:
                    if subcmd in {"results", "result"}:
                        print_line_probe_results()
                    elif subcmd == "config":
                        run_line_probe_config(console_args[2:])
                    elif subcmd == "clear":
                        clear_line_probe_results(console_args[2:])
                    elif subcmd == "serve":
                        run_line_probe_serve(console_args[2:])
                    elif subcmd in {"delivery", "deliver", "commands"}:
                        if len(console_args) > 2:
                            raise ValueError("usage: probe delivery")
                        _print_probe_delivery()
                    elif subcmd in {"paste", "serial", "heredoc"}:
                        if len(console_args) > 2:
                            raise ValueError("usage: probe paste")
                        print_line_probe_script(paste=True)
                    elif subcmd in {"script", "raw"}:
                        if len(console_args) > 2:
                            raise ValueError("usage: probe script")
                        print_line_probe_script(paste=False)
                    elif subcmd in {"help", "-h", "--help"}:
                        print_line_command_help("probe")
                    else:
                        queue_probe, start_probe = parse_line_probe_args(console_args[1:])
                        probe_line_start(queue=queue_probe, start_service=start_probe)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "survey":
                subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                try:
                    if subcmd in {"results", "result"} or not subcmd:
                        print_line_survey_status()
                    elif subcmd == "config":
                        run_line_survey_config(console_args[2:])
                    elif subcmd == "preset":
                        run_line_survey_preset(console_args[2:])
                    elif subcmd in {"help", "-h", "--help"}:
                        print_line_command_help("survey")
                    else:
                        raise ValueError("usage: survey [results|config|preset]  —  see: survey ?")
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "daemon":
                try:
                    run_line_daemon_action(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"release", "releases"}:
                subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                if not subcmd or subcmd in {"list", "show", "recommendations", "artifacts"}:
                    print_line_release()
                elif subcmd in {"stage", "use", "select"}:
                    try:
                        selector, start_release_service = parse_line_release_stage_args(console_args[2:])
                        stage_line_release(selector, start_file_service=start_release_service)
                    except ValueError as exc:
                        print(exc)
                elif len(console_args) >= 2 and console_args[1] in {"-h", "--help"}:
                    print_line_command_help("release")
                else:
                    print("usage: release [list|stage SELECTOR]")
                continue
            elif cmd == "stage-release":
                try:
                    selector, start_release_service = parse_line_release_stage_args(console_args[1:])
                    stage_line_release(selector, start_file_service=start_release_service)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"upload", "stage", "serve-file"}:
                try:
                    selector, request_name, start_upload_service = parse_line_file_args(console_args[1:])
                    stage_line_file(selector, request_name, start_file_service=start_upload_service)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"fetch", "deploy", "queue-fetch"}:
                try:
                    request_name, queue_fetch, start_fetch_service = parse_line_fetch_args(console_args[1:], queue_default=cmd == "queue-fetch")
                    fetch_line_staged(request_name, queue=queue_fetch, start_file_service=start_fetch_service)
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"unstage", "rmfile", "rm-file"}:
                try:
                    unstage_line_file(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"view", "cat", "less"}:
                try:
                    view_line_path(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"files", "staged", "stagers", "loot", "downloads"}:
                subcmd = console_args[1].lower() if len(console_args) >= 2 else ""
                if subcmd in {"upload", "stage", "serve-file"}:
                    try:
                        selector, request_name, start_svc = parse_line_file_args(console_args[2:])
                        stage_line_file(selector, request_name, start_file_service=start_svc)
                    except ValueError as exc:
                        print(exc)
                elif subcmd in {"fetch", "deploy"}:
                    try:
                        request_name, queue_fetch, start_svc = parse_line_fetch_args(console_args[2:])
                        fetch_line_staged(request_name, queue=queue_fetch, start_file_service=start_svc)
                    except ValueError as exc:
                        print(exc)
                elif subcmd in {"unstage", "rm", "remove"}:
                    try:
                        unstage_line_file(" ".join(console_args[2:]).strip())
                    except ValueError as exc:
                        print(exc)
                elif subcmd in {"clear", "purge"}:
                    flags = {a.lower() for a in console_args[2:]}
                    staged = load_staged(cfg).get("staged", {})
                    target_filter_id = configured_target_filter(cfg)
                    if target_filter_id:
                        staged = {n: r for n, r in staged.items()
                                  if str(r.get("target_id") or "") == target_filter_id}
                    if not staged:
                        print("No staged files to clear.")
                    else:
                        for name in sorted(staged):
                            print(f"  {name}")
                        if "--confirm" not in flags:
                            print(f"\n  {len(staged)} file(s) would be unstaged.  Run: files clear --confirm")
                        else:
                            removed = 0
                            for name in list(staged):
                                if unstage_file(cfg, name):
                                    removed += 1
                            print(f"\n  Cleared {removed} staged file(s).")
                            append_event(cfg, "workbench", "workbench_files_cleared", details={
                                "removed": removed,
                                "target_filter": target_filter_id or "all",
                            })
                elif subcmd in {"-v", "--verbose"}:
                    print_line_files(verbose=True)
                else:
                    print_line_files()
                continue
            elif cmd in {"mailbox", "queue"}:
                compact_next_prompt = False
                choice = "20"
            elif cmd == "jobs":
                try:
                    if len(console_args) >= 3 and console_args[1] in {"-k", "--kill", "--cancel"}:
                        cancel_line_job(" ".join(console_args[2:]).strip())
                    elif len(console_args) >= 3 and console_args[1] in {"-i", "--info", "info"}:
                        select_line_job(" ".join(console_args[2:]).strip())
                    elif len(console_args) >= 2 and console_args[1] in {"-v", "--verbose"}:
                        print_line_jobs(verbose=True)
                    else:
                        print_line_jobs()
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "job":
                try:
                    select_line_job(" ".join(console_args[1:]).strip())
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"serve-binary", "binary"}:
                try:
                    selector, request_name, start_binary_service, no_start_binary_service = parse_line_binary_args(console_args[1:])
                    stage_line_binary(
                        selector,
                        request_name,
                        prompt_for_missing=not selector,
                        prompt_start=(not selector and not no_start_binary_service),
                        start_file_service=start_binary_service,
                    )
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd in {"configure", "trailer"}:
                try:
                    configure_line_artifact(console_args[1:])
                except ValueError as exc:
                    print(exc)
                continue
            elif cmd == "refresh":
                compact_next_prompt = False
                choice = "r"
            else:
                print(f"unknown command: {cmd}; type help")
                continue
        if choice in {"q", "quit", "exit"}:
            # If in a subcontext, go back one level instead of quitting
            if str(cfg.get("_line_console_module") or ""):
                clear_line_module()
                compact_next_prompt = True
                continue
            mark_service_stopped(cfg, "workbench", "quit")
            return 0
        # If a number was entered and there are active search results (e.g. from
        # `listeners`, `targets`, `search`, etc.), use those — the numbers shown
        # in any list command correspond to search result positions.
        if choice.isdigit() and cfg.get("_line_console_search_results"):
            try:
                use_line_search_result(choice)
            except ValueError as exc:
                print(exc)
            compact_next_prompt = True
            continue
        if choice in {"1", "2", "3", "4"}:
            service = {"1": "ssh", "2": "tls-shell", "3": "plain-shell", "4": "file-service"}[choice]
            start_line_service(service)
            # Brief poll so the banner reflects actual listening state
            for _ in range(10):
                time.sleep(0.1)
                if str((line_service_record(service) or {}).get("actual") or "") == "listening":
                    break
        elif choice == "5":
            service = line_input("service> ")
            if service is not None:
                stop_line_service(service.strip())
        elif choice == "6":
            path_line = line_input("local file> ")
            name_line = line_input("target request name> ")
            path = path_line.strip() if path_line is not None else ""
            name = name_line.strip() if name_line is not None else ""
            try:
                headless = (
                    "scripts/grit-console --config "
                    + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                    + " --serve-file "
                    + shquote(path)
                    + " --as "
                    + shquote(name)
                    + " --list-staged"
                )
                rec = stage_file(cfg, path, name)
                print(f"staged {rec['request_name']}")
                print(f"headless_command: {headless}")
                print(render_fetch_command(rec["request_name"], cfg))
                append_event(cfg, "workbench", "workbench_file_staged", details={
                    "headless_command": headless,
                    "request_name": rec.get("request_name", ""),
                    "source_path": rec.get("source_path", ""),
                    "stage_kind": rec.get("stage_kind", ""),
                    "target_id": rec.get("target_id", ""),
                    "target_label": rec.get("target_label", ""),
                })
            except ValueError as exc:
                print(exc)
        elif choice == "7":
            print_staged(cfg)
            snap = workbench_snapshot(cfg)
            file_actions = snap.get("file_service_workflow_actions") or []
            if file_actions:
                print("File service workflow actions:")
                for rec in file_actions:
                    print(
                        f"  {rec.get('id', '')} "
                        f"state={rec.get('operator_action_state', '') or '-'} "
                        f"reason={rec.get('operator_action_reason', '') or '-'} "
                        f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                        f"fleet_targets={rec.get('fleet_target_count', 0)} "
                        f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                        f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                        f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                    )
                    print(f"    command: {rec.get('headless_command', rec.get('command', ''))}")
                    if rec.get("target_command_template"):
                        print(f"    target_command_template: {rec.get('target_command_template', '')}")
            staged_actions = snap.get("staged_file_workflow_actions") or []
            if staged_actions:
                print("Staged file workflow actions:")
                for rec in staged_actions:
                    print(
                        f"  {rec.get('id', '')} "
                        f"state={rec.get('operator_action_state', '') or '-'} "
                        f"reason={rec.get('operator_action_reason', '') or '-'} "
                        f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                        f"target_pending={rec.get('target_mailbox_pending_work_count', 0)} "
                        f"fleet_pending={rec.get('fleet_mailbox_pending_work_count', 0)} "
                        f"poll_overdue={'yes' if rec.get('target_poll_overdue') else 'no'}"
                    )
                    print(f"    command: {rec.get('headless_command', rec.get('command', ''))}")
            headless = (
                "scripts/grit-console --config "
                + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                + " --list-staged"
            )
            print(f"headless_command: {headless}")
            append_event(cfg, "workbench", "workbench_staged_files_viewed", details={
                "headless_command": headless,
                "staged_count": len(snap.get("staged_records") or []),
                "file_service_workflow_action_count": len(file_actions),
                "staged_file_workflow_action_count": len(staged_actions),
            })
        elif choice == "8" or choice == "d":
            name_line = line_input("target request name> ")
            name = name_line.strip() if name_line is not None else ""
            if name:
                try:
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --unstage "
                        + shquote(name)
                        + " --list-staged"
                    )
                    existed = unstage_file(cfg, name)
                    print("unstaged" if existed else "not staged")
                    print(f"headless_command: {headless}")
                    append_event(cfg, "workbench", "workbench_file_unstaged", details={
                        "headless_command": headless,
                        "request_name": name,
                        "existed": existed,
                    })
                except ValueError as exc:
                    print(exc)
        elif choice == "9" or choice == "v":
            path_line = line_input("local path> ")
            path = path_line.strip() if path_line is not None else ""
            if path:
                headless = view_path_headless_command(cfg, path)
                print(f"headless_command: {headless}")
                result = open_path_in_pager(path)
                print(result)
                append_event(cfg, "workbench", "workbench_path_viewed", details={
                    "headless_command": headless,
                    "path": path,
                    "result": result,
                    "viewable": viewable_path(path) is not None,
                })
        elif choice == "10":
            rel = release_context(cfg)
            if not rel:
                print("no release bundle detected")
                continue
            nav = release_nav_records(rel, rel.get("devices") or [], rel.get("tuples") or [], limit=12)
            for idx, rec in enumerate(nav, 1):
                print(f"{idx}: {rec.get('label', '')}")
            selector_line = line_input(
                "release selection number, recommendation id, artifact path, "
                "by_device:NAME, by_device_payload_preset:NAME:PRESET, "
                "by_tuple_path:PATH, or by_tuple_payload_preset:PATH:PRESET> "
            )
            selector = selector_line.strip() if selector_line is not None else ""
            if selector:
                try:
                    headless = (
                        "scripts/grit-console --config "
                        + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                        + " --stage-release-artifact "
                        + shquote(selector)
                    )
                    rec = stage_release_selection(cfg, selector)
                    print(f"staged {rec['request_name']}")
                    print(f"headless_command: {headless}")
                    print(render_fetch_command(rec["request_name"], cfg))
                    append_event(cfg, "workbench", "workbench_release_artifact_staged", details={
                        "selector": selector,
                        "headless_command": headless,
                        "request_name": rec.get("request_name", ""),
                        "release_artifact_name": rec.get("release_artifact_name", ""),
                        "release_path": rec.get("release_path", ""),
                        "tuple_path": rec.get("tuple_path", ""),
                        "payload_preset": rec.get("payload_preset", ""),
                    })
                except ValueError as exc:
                    print(exc)
        elif choice == "22":
            try:
                stage_line_binary()
            except ValueError as exc:
                print(exc)
        elif choice == "11":
            headless = (
                "scripts/grit-console --config "
                + shquote(str(cfg.get("_config_path", DEFAULT_CONFIG)))
                + " --status"
            )
            snap = workbench_snapshot(cfg)
            summary = snap.get("summary") or {}
            print(
                "Workbench action summary: "
                f"total={summary.get('workbench_action_count', 0)} "
                f"background_supported={summary.get('workbench_action_background_supported_count', 0)} "
                f"foreground_runnable={summary.get('workbench_action_foreground_runnable_count', 0)} "
                f"requires_confirmation={summary.get('workbench_action_requires_confirmation_count', 0)}"
            )
            print(
                "Operator daemon workflow action summary: "
                f"total={summary.get('operator_daemon_workflow_action_count', 0)} "
                f"attached={summary.get('operator_daemon_workflow_action_attached_count', 0)} "
                f"enter_runnable={summary.get('operator_daemon_workflow_action_can_run_from_curses_enter_count', 0)} "
                f"fleet_pending_work={format_counts(summary.get('operator_daemon_workflow_action_fleet_mailbox_pending_work_count_counts') or {})} "
                f"fleet_offline={format_counts(summary.get('operator_daemon_workflow_action_fleet_offline_target_count_counts') or {})} "
                f"fleet_poll_overdue={format_counts(summary.get('operator_daemon_workflow_action_fleet_poll_overdue_target_count_counts') or {})}"
            )
            print(f"headless_command: {headless}")
            action_preview = []
            seen_action_ids = set()
            for rec in snap.get("workbench_actions") or []:
                rec_id = str(rec.get("id") or "")
                if rec_id in (
                    "operator-daemon-start",
                    "operator-daemon-status",
                    "operator-daemon-stop",
                    "systemd-user-status",
                ) or rec.get("background_supported") is True:
                    if rec_id and rec_id not in seen_action_ids:
                        seen_action_ids.add(rec_id)
                        action_preview.append(rec)
                if len(action_preview) >= 8:
                    break
            for idx, rec in enumerate(action_preview, 1):
                print(f"{idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(f"   command: {rec.get('headless_command', rec.get('command', ''))}")
                print(
                    f"   category={rec.get('category', '')} background_supported={'yes' if rec.get('background_supported') else 'no'} "
                    f"confirm={'yes' if rec.get('requires_confirmation') else 'no'} "
                    f"foreground_runnable={'yes' if rec.get('foreground_runnable') else 'no'} "
                    f"state={rec.get('operator_action_state', '') or '-'} "
                    f"reason={rec.get('operator_action_reason', '') or '-'} "
                    f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                    f"enter_action={rec.get('curses_enter_action', '') or '-'} "
                    f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                    f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                    f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                )
                if rec.get("dry_run_command"):
                    print(f"   dry_run: {rec.get('dry_run_command', '')}")
                if rec.get("run_command"):
                    print(f"   run: {rec.get('run_command', '')}")
                if rec.get("start_job_command"):
                    print(f"   start_job: {rec.get('start_job_command', '')}")
            service_actions = snap.get("service_workflow_actions") or []
            service_action_preview = []
            seen_service_action_ids = set()
            for rec in service_actions:
                if rec.get("can_run_from_curses_enter") or rec.get("service") == "file-service":
                    rec_id = str(rec.get("id") or "")
                    if rec_id and rec_id not in seen_service_action_ids:
                        seen_service_action_ids.add(rec_id)
                        service_action_preview.append(rec)
                if len(service_action_preview) >= 10:
                    break
            if service_actions:
                print(
                    "Service workflow actions: "
                    f"total={len(service_actions)} preview={len(service_action_preview)} "
                    f"headless commands shown for runnable/file-service actions"
                )
            for idx, rec in enumerate(service_action_preview, 1):
                print(f"service {idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(f"   command: {rec.get('headless_command', rec.get('command', ''))}")
                print(
                    f"   service={rec.get('service', '')} category={rec.get('category', '')} "
                    f"actual={rec.get('actual', '') or '-'} configured={rec.get('configured', '') or '-'} "
                    f"confirm={'yes' if rec.get('requires_confirmation') else 'no'} "
                    f"state={rec.get('operator_action_state', '') or '-'} "
                    f"reason={rec.get('operator_action_reason', '') or '-'} "
                    f"enter={'yes' if rec.get('can_run_from_curses_enter') else 'no'} "
                    f"enter_action={rec.get('curses_enter_action', '') or '-'} "
                    f"pending_work={rec.get('fleet_mailbox_pending_work_count', 0)} "
                    f"offline_targets={rec.get('fleet_offline_target_count', 0)} "
                    f"poll_overdue={rec.get('fleet_poll_overdue_target_count', 0)}"
                )
            target_actions = snap.get("target_workflow_actions") or []
            if target_actions:
                print(f"Target workflow actions: total={len(target_actions)}; use action 15 for the prompted target workflow list")
            append_event(cfg, "workbench", "workbench_actions_viewed", details={
                "headless_command": headless,
                "action_count": len(snap.get("workbench_actions") or []),
                "service_workflow_action_count": len(snap.get("service_workflow_actions") or []),
                "target_workflow_action_count": len(snap.get("target_workflow_actions") or []),
            })
            selected_line = line_input("operator action id/number to run, or blank> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if selected:
                try:
                    action = workbench_action_by_selector(cfg, selected)
                    if action.get("background_supported") is True:
                        print("background action; use action 12 to start it as a managed job")
                        continue
                    dry_line = line_input("dry-run/preview only? [Y/n]> ")
                    dry_run = dry_line is None or dry_line.strip().lower() not in ("n", "no")
                    confirmed = False
                    if not dry_run and action.get("requires_confirmation") is True:
                        confirm_line = line_input("run confirmed action now? type yes> ")
                        confirmed = confirm_line is not None and confirm_line.strip().lower() == "yes"
                    rc = run_workbench_action(
                        cfg,
                        action.get("id", selected),
                        dry_run=dry_run,
                        confirmed=confirmed,
                    )
                    print(f"workbench_action_returncode={rc}")
                except (ValueError, IndexError) as exc:
                    print(exc)
        elif choice == "15":
            snap = workbench_snapshot(cfg)
