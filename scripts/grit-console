                    print(f"headless_command: {action_rec.get('headless_command', bridge_profile_headless_command('delete', name))}")
                    append_event(cfg, "workbench", "workbench_bridge_profile_deleted", details={
                        "name": name,
                        "route_path": deleted.get("route_path", ""),
                        "headless_command": action_rec.get("headless_command", bridge_profile_headless_command("delete", name)),
                    })
                elif action:
                    print(f"unknown bridge action: {action}")
            except ValueError as exc:
                print(exc)
        elif choice == "18":
