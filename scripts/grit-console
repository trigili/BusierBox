    def line_session_record(selector):
        return line_session_record_by_selector(
            workbench_snapshot(cfg).get("sessions") or [],
            selector,
        )

    def select_line_session(selector):
        text = str(selector or "").strip()
        if not text:
            raise ValueError("usage: use session SESSION")
        selected = line_session_record(text)
        if not selected:
            raise ValueError(f"session not found: {text}")
        session_id = str(selected.get("session_id") or Path(str(selected.get("path", ""))).name)
        path = str(selected.get("path") or "")
        cfg["_line_console_module"] = f"session/{session_id}"
        cfg.pop("_line_console_action_kind", None)
        cfg.pop("_line_console_action_id", None)
        print_selected_line_session(selected)
        append_event(cfg, "workbench", "workbench_session_selected", details={
            "session_id": session_id,
            "session_path": path,
            "service": selected.get("service", ""),
            "state": selected.get("state", ""),
        })
        return selected

    def print_line_sessions(verbose=False):
