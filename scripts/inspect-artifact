#!/usr/bin/env python3
import gzip
import hashlib
import io
import json
import pathlib
import sys
import tarfile

MAGIC = b"BBXPAYLOADv1"
TRAILER_SIZE = 512
CONFIG_MAGIC = b"BBXCONFIGv1"
CONFIG_TRAILER_SIZE = 4096


def die(msg):
    print(f"inspect-artifact: {msg}", file=sys.stderr)
    raise SystemExit(1)


def require_list(manifest, key):
    val = manifest.get(key)
    if not isinstance(val, list):
        die(f"manifest {key} must be a list")
    seen = set()
    for item in val:
        if not isinstance(item, str) or not item:
            die(f"manifest {key} contains invalid item")
        if item in seen:
            die(f"manifest {key} contains duplicate item: {item}")
        seen.add(item)
    return val


def check_executable_member(members, name, label):
    info = members.get(name)
    if not info:
        die(f"{label} missing from payload: {name}")
    if info.isfile() and not (info.mode & 0o111):
        die(f"{label} is not executable in payload: {name}")
    if not (info.isfile() or info.issym() or info.islnk()):
        die(f"{label} is not a file/link in payload: {name}")


def validate_static(manifest, members, contents):
    check_executable_member(members, "payload/bin/busybox", "BusyBox")
    applets = require_list(manifest, "busybox_applets")
    staged = require_list(manifest, "staged_payload_tools")
    built = require_list(manifest, "built_payload_tools")
    requested = require_list(manifest, "requested_payload_tools")
    missing = require_list(manifest, "missing_payload_tools")
    overlay_tools = require_list(manifest, "overlay_tools")
    overlay_files = require_list(manifest, "overlay_files")
    overlay_paths = require_list(manifest, "overlay_applied_paths")
    symlink_skips = require_list(manifest, "applet_symlink_skips")

    expected_missing = sorted(tool for tool in requested if tool not in built)
    if sorted(missing) != expected_missing:
        die(f"manifest missing_payload_tools inconsistent: expected {' '.join(expected_missing)} got {' '.join(sorted(missing))}")
    reasons = manifest.get("missing_payload_tool_reasons", {})
    if missing and not isinstance(reasons, dict):
        die("manifest missing_payload_tool_reasons must be an object when tools are missing")
    for tool in missing:
        if not reasons.get(tool):
            die(f"missing tool lacks reason: {tool}")

    for applet in applets:
        if applet == "busybox":
            continue
        path = f"payload/bin/{applet}"
        info = members.get(path)
        if applet in symlink_skips:
            if not info:
                die(f"skipped applet has no payload/bin entry: {applet}")
            continue
        if not info:
            die(f"BusyBox applet symlink missing: {path}")
        if not info.issym():
            die(f"BusyBox applet entry is not a symlink: {path}")
        if info.linkname != "busybox":
            die(f"BusyBox applet symlink target is not busybox: {path} -> {info.linkname}")

    for tool in staged:
        check_executable_member(members, f"payload/bin/{tool}", "staged tool")
    for tool in overlay_tools:
        if tool not in staged:
            die(f"overlay tool not listed as staged: {tool}")
        check_executable_member(members, f"payload/bin/{tool}", "overlay tool")
    for item in overlay_files:
        if ":" not in item:
            die(f"overlay file entry lacks label/path: {item}")
        rel = item.split(":", 1)[1]
        if f"payload/{rel}" not in members:
            die(f"overlay file listed but missing from payload: {rel}")
    for item in overlay_paths:
        if not isinstance(item, str) or not item:
            die("overlay_applied_paths contains invalid entry")

    bad_needles = (b"mock heavy tool", b"payload is not staged")
    for name, data in contents.items():
        if not name.startswith("payload/bin/"):
            continue
        for needle in bad_needles:
            if needle in data:
                die(f"placeholder payload script detected: {name}")

    if "tmux" in staged:
        has_terminfo = any(
            name.startswith("payload/share/terminfo/")
            and (name.endswith("/tmux") or name.endswith("/tmux-256color") or name.endswith("/screen") or name.endswith("/xterm"))
            for name in members
        )
        if not has_terminfo:
            die("tmux is staged but no terminal capability data was found")


def one_line(value):
    return str(value).replace("\n", " ").replace("\r", " ")


def provider_status_lines(manifest):
    status_map = manifest.get("tool_provider_status") or {}
    if not isinstance(status_map, dict):
        return []
    lines = []
    for tool, status in sorted(status_map.items()):
        if not isinstance(tool, str) or not isinstance(status, dict):
            continue
        overall = status.get("overall") or status.get("status") or "unknown"
        lines.append(f"provider_status_{one_line(tool)}={one_line(overall)}")
        search_paths = status.get("search_paths") or []
        if not isinstance(search_paths, list):
            continue
        for entry in search_paths:
            if not isinstance(entry, dict) or not entry.get("executable"):
                continue
            path = entry.get("path")
            if path:
                lines.append(f"provider_path_{one_line(tool)}={one_line(path)}")
                break
    return lines


def doom_wad_lines(manifest):
    lines = []
    for wad in manifest.get("doom_wads") or []:
        if not isinstance(wad, dict):
            continue
        filename = wad.get("filename")
        if not filename:
            continue
        size = wad.get("size", "")
        sha256 = wad.get("sha256", "")
        lines.append(f"doom_wad={one_line(filename)} size={one_line(size)} sha256={one_line(sha256)}")
    return lines


if len(sys.argv) != 2:
    die("usage: scripts/inspect-artifact dist/busierbox-<target>")

path = pathlib.Path(sys.argv[1])
data = path.read_bytes()
config_trailer = len(data) >= CONFIG_TRAILER_SIZE and data[-CONFIG_TRAILER_SIZE:].startswith(CONFIG_MAGIC)
payload_data = data[:-CONFIG_TRAILER_SIZE] if config_trailer else data
if len(payload_data) < TRAILER_SIZE:
    die("artifact too small")
trailer = payload_data[-TRAILER_SIZE:].split(b"\0", 1)[0].decode("ascii", "replace")
lines = trailer.splitlines()
if not lines or lines[0].encode() != MAGIC:
    die("embedded payload trailer missing")
meta = {}
for line in lines[1:]:
    if line == "END":
        break
    if "=" in line:
        k, v = line.split("=", 1)
        meta[k] = v

offset = int(meta.get("offset", "0"))
size = int(meta.get("size", "0"))
if offset <= 0 or size <= 0 or offset + size > len(payload_data) - TRAILER_SIZE:
    die("payload trailer offset/size outside artifact bounds")
payload = payload_data[offset : offset + size]
sha = hashlib.sha256(payload).hexdigest()
hash_ok = sha == meta.get("sha256")

print(f"payload_present=yes")
for key in ("offset", "size", "sha256", "version", "format", "compressed_size"):
    print(f"{key}={meta.get(key, '')}")
print(f"hash_ok={'yes' if hash_ok else 'no'}")
print(f"config_trailer_present={'yes' if config_trailer else 'no'}")

manifest = None
members = {}
contents = {}
stream = io.BytesIO(payload)
try:
    if meta.get("format") == "tgz":
        stream = io.BytesIO(gzip.decompress(payload))
    with tarfile.open(fileobj=stream, mode="r:") as tf:
        members = {m.name: m for m in tf.getmembers()}
        member = tf.extractfile("payload/manifest.json")
        if member:
            manifest = json.load(member)
        for name, info in members.items():
            if not info.isfile():
                continue
            fh = tf.extractfile(info)
            if fh:
                contents[name] = fh.read(16384)
except Exception as exc:
    die(f"payload inspection failed: {exc}")

if manifest:
    validate_static(manifest, members, contents)
    print(f"manifest_target={manifest.get('target', '')}")
    print(f"manifest_arch={manifest.get('arch', '')}")
    print(f"manifest_libc={manifest.get('libc', '')}")
    print(f"busybox_applet_count={len(manifest.get('busybox_applets') or [])}")
    print("staged_tools=" + " ".join(manifest.get("staged_payload_tools") or []))
    print("missing_tools=" + " ".join(manifest.get("missing_payload_tools") or []))
    for line in doom_wad_lines(manifest):
        print(line)
    print(f"gdbserver_provider={manifest.get('gdbserver_provider', 'auto')}")
    for line in provider_status_lines(manifest):
        print(line)
    print(f"overlay_enabled={'yes' if manifest.get('overlay_enabled') else 'no'}")
    if manifest.get("overlay_root"):
        print(f"overlay_root={manifest['overlay_root']}")
    if manifest.get("overlay_tools"):
        print("overlay_tools=" + " ".join(manifest["overlay_tools"]))
    if manifest.get("user_provided_tools"):
        print("user_provided_tools=" + " ".join(manifest["user_provided_tools"]))
    for w in manifest.get("overlay_warnings") or []:
        print(f"overlay_warning={w}")
else:
    die("payload manifest missing")

if not hash_ok:
    raise SystemExit(1)
