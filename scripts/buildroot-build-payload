make_payload_archives
if [ "$PAYLOAD_FORMAT" = "tar" ]; then selected=dist/payload.tar; else selected=dist/payload.tar.gz; fi
payload_sha=$(payload_sha_file "$selected")
write_manifest "$static_status" "$payload_sha"
make_payload_archives
