#!/bin/sh
set -eu

TARGET=${TARGET:-mipsel-linux-2.6-uclibc}
PREPARE_ONLY=0
if [ "${1:-}" = "--prepare-only" ]; then
    PREPARE_ONLY=1
fi
BUILDROOT_VERSION=${BUILDROOT_VERSION:-2026.02.2}
BUILDROOT_TARBALL=${BUILDROOT_TARBALL:-dl/buildroot-$BUILDROOT_VERSION.tar.xz}
BUILDROOT_DIR=${BUILDROOT_DIR:-buildroot/buildroot-$BUILDROOT_VERSION}
PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-tgz}
OUT_BASE=${BUILDROOT_OUTPUT_BASE:-buildroot/output}
JOBS=${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf 2)}
STRICT_HEAVY_TOOLS=${STRICT_HEAVY_TOOLS:-0}
PATH="$(pwd)/scripts/shims:$PATH"
export PATH

profile=${TARGET_PROFILE_FILE:-payloads/profiles/$TARGET.mk}
defconfig=${TARGET_BUILDROOT_DEFCONFIG:-buildroot/configs/${TARGET}_defconfig}
out_dir="$OUT_BASE/$TARGET"
case "$out_dir" in
    /*) out_abs=$out_dir ;;
    *) out_abs="$(pwd)/$out_dir" ;;
esac

profile_value() {
    key=$1
    awk -v key="$key" '
        $1 == key && ($2 == ":=" || $2 == "=") {
            $1 = ""; $2 = ""; sub(/^[[:space:]]+/, ""); print; exit
        }
    ' "$profile"
}

die() {
    printf '%s\n' "buildroot-build-payload: $*" >&2
    exit 1
}

ensure_buildroot() {
    if [ -f "$BUILDROOT_DIR/Makefile" ]; then
        return 0
    fi
    if [ ! -f "$BUILDROOT_TARBALL" ]; then
        die "missing $BUILDROOT_TARBALL; run 'make fetch-sources' or 'make buildroot'"
    fi
    mkdir -p buildroot
    tar -C buildroot -xf "$BUILDROOT_TARBALL"
}

stage_dotfiles() {
    mkdir -p runtime/payload/home
    [ "${BB_DOTFILES_ENABLE:-yes}" = yes ] || return 0
    [ "${BB_RUNTIME_MODE:-extract}" != core-only ] || return 0
    stage_dotfile_one profile "${BB_DOTFILE_PROFILE_MODE:-default}" "${BB_DOTFILE_PROFILE_USER_FILE:-}" ".profile"
    stage_dotfile_one zsh "${BB_DOTFILE_ZSH_MODE:-default}" "${BB_DOTFILE_ZSH_USER_FILE:-}" ".zshrc"
    stage_dotfile_one tmux "${BB_DOTFILE_TMUX_MODE:-default}" "${BB_DOTFILE_TMUX_USER_FILE:-}" ".tmux.conf"
    stage_dotfile_one gdb "${BB_DOTFILE_GDB_MODE:-default}" "${BB_DOTFILE_GDB_USER_FILE:-}" ".gdbinit"
}

stage_dotfile_one() {
    _app=$1
    _mode=$2
    _user_file=$3
    _name=$4
    case "$_mode" in
        none|"") return 0 ;;
        default)
            _src="payloads/dotfiles/$_name"
            [ -f "$_src" ] || die "missing BusierBox default dotfile for $_app: $_src"
            ;;
        user)
            [ -n "$_user_file" ] && [ -f "$_user_file" ] || die "$_app dotfile mode is user but file is missing: ${_user_file:-not set}"
            _src=$_user_file
            ;;
        *) die "invalid $_app dotfile mode: $_mode" ;;
    esac
    cp "$_src" "runtime/payload/home/$_name"
}

copy_shared_libs_if_dynamic() {
    busybox=$1
    if command -v file >/dev/null 2>&1 && file "$busybox" | grep -qi 'statically linked'; then
        printf '%s\n' static
        return 0
    fi
    mkdir -p runtime/payload/lib
    if [ -d "$out_dir/target/lib" ]; then
        find "$out_dir/target/lib" -maxdepth 1 \( -name '*.so' -o -name '*.so.*' -o -name 'ld-*.so*' \) -exec cp -P {} runtime/payload/lib/ \;
    fi
    if [ -d "$out_dir/target/usr/lib" ]; then
        find "$out_dir/target/usr/lib" -maxdepth 1 \( -name '*.so' -o -name '*.so.*' \) -exec cp -P {} runtime/payload/lib/ \;
    fi
    printf '%s\n' dynamic
}

copy_shared_libs_for_dynamic_payload_tools() {
    status=${1:-static}
    if ! command -v file >/dev/null 2>&1; then
        printf '%s\n' "$status"
        return 0
    fi
    find runtime/payload/bin -maxdepth 1 -type f -perm /111 -print 2>/dev/null | while IFS= read -r exe; do
        if file "$exe" | grep -qi 'dynamically linked'; then
            printf '%s\n' "$exe"
        fi
    done >runtime/payload/dynamic-tools.txt
    if [ -s runtime/payload/dynamic-tools.txt ]; then
        mkdir -p runtime/payload/lib
        if [ -d "$out_dir/target/lib" ]; then
            find "$out_dir/target/lib" -maxdepth 1 \( -name '*.so' -o -name '*.so.*' -o -name 'ld-*.so*' \) -exec cp -P {} runtime/payload/lib/ \;
        fi
        if [ -d "$out_dir/target/usr/lib" ]; then
            find "$out_dir/target/usr/lib" -maxdepth 1 \( -name '*.so' -o -name '*.so.*' \) -exec cp -P {} runtime/payload/lib/ \;
        fi
        printf '%s\n' "buildroot-build-payload: WARNING: staged dynamic payload tools require bundled shared libraries in runtime/payload/lib" >&2
        printf '%s\n' dynamic
    else
        rm -f runtime/payload/dynamic-tools.txt
        printf '%s\n' "$status"
    fi
}

tool_requested() {
    needle=$1
    for item in $requested_tools; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

stage_tool_path() {
    requested=$1
    src=$2
    dst=${3:-${src##*/}}
    [ -x "$src" ] || return 1
    cp "$src" "runtime/payload/bin/$dst"
    chmod 0755 "runtime/payload/bin/$dst"
    printf '%s\n' "$dst" >>runtime/payload/staged-tools.txt
    printf '%s\n' "$requested" >>runtime/payload/built-tools.txt
}

stage_first_found() {
    requested=$1
    shift
    staged=1
    for rel in "$@"; do
        if [ -x "$out_dir/target/$rel" ]; then
            stage_tool_path "$requested" "$out_dir/target/$rel" "${rel##*/}" || true
            staged=0
        fi
    done
    return "$staged"
}

payload_sha_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf '%s\n' unknown
    fi
}

in_list() {
    _needle=$1; shift
    for _x in "$@"; do [ "$_x" = "$_needle" ] && return 0; done
    return 1
}

check_bin_arch_warn() {
    _bin=$1
    _name=$2
    command -v file >/dev/null 2>&1 || return 0
    _fout=$(file "$_bin" 2>/dev/null || true)
    case "$_fout" in *ELF*) ;; *) return 0 ;; esac
    _want=
    case "${TARGET:-}" in
        *mipsel*)  _want="MIPS.*LSB" ;;
        *mips*)    _want="MIPS.*MSB" ;;
        *aarch64*) _want="aarch64" ;;
        *arm*)     _want="ARM" ;;
        *x86_64*)  _want="x86-64" ;;
        *i386*)    _want="80386" ;;
        *) return 0 ;;
    esac
    if ! printf '%s\n' "$_fout" | grep -qi "$_want"; then
        printf '%s\n' "buildroot-build-payload: WARNING: '$_name' may not match target arch for ${TARGET:-}: $_fout" >&2
        mkdir -p runtime/payload/share/busierbox
        printf '%s\n' "arch-mismatch:$_name" >>runtime/payload/share/busierbox/overlay-warnings.txt
    fi
}

stage_user_binary() {
    _tool=$1
    _src=$2
    if [ ! -f "$_src" ]; then
        printf '%s\n' "buildroot-build-payload: user-supplied $_tool not found: $_src" >&2
        return 1
    fi
    if [ ! -x "$_src" ]; then
        printf '%s\n' "buildroot-build-payload: user-supplied $_tool is not executable: $_src" >&2
        return 1
    fi
    check_bin_arch_warn "$_src" "$_tool"
    cp "$_src" "runtime/payload/bin/$_tool"
    chmod 0755 "runtime/payload/bin/$_tool"
    printf '%s\n' "$_tool" >>runtime/payload/staged-tools.txt
    printf '%s\n' "$_tool" >>runtime/payload/built-tools.txt
    printf '%s\n' "$_tool" >>runtime/payload/user-provided-tools.txt
    printf '%s\n' "buildroot-build-payload: staged user-supplied $_tool from $_src"
    return 0
}

apply_overlay_dir() {
    _src=$1
    _label=$2
    _warn="runtime/payload/share/busierbox/overlay-warnings.txt"
    [ -d "$_src" ] || return 0
    for _subdir in bin lib share home etc; do
        _subdir_src="$_src/$_subdir"
        [ -d "$_subdir_src" ] || continue
        mkdir -p "runtime/payload/$_subdir"
        for _f in "$_subdir_src/"*; do
            [ -e "$_f" ] || continue
            _fname="${_f##*/}"
            case "$_fname" in
                .git|.gitignore|.gitmodules|*.swp|*~|.DS_Store|.keep|.gitkeep|THIS_IS_YOUR_ROOT_FILESYSTEM) continue ;;
            esac
            _target="runtime/payload/$_subdir/$_fname"
            if [ -e "$_target" ]; then
                if [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" = "yes" ]; then
                    printf '%s\n' "buildroot-build-payload: overlay [$_label] overriding: $_subdir/$_fname" >&2
                else
                    printf '%s\n' "buildroot-build-payload: overlay [$_label] conflict (not overwriting): $_subdir/$_fname — set BB_USER_OVERLAY_ALLOW_OVERRIDE=yes to override" >&2
                    mkdir -p runtime/payload/share/busierbox
                    printf '%s\n' "conflict:$_label:$_subdir/$_fname" >>"$_warn"
                    continue
                fi
            fi
            if [ -L "$_f" ]; then
                cp -P "$_f" "$_target" 2>/dev/null || cp "$_f" "$_target" || continue
            else
                cp "$_f" "$_target" || continue
            fi
            printf '%s\n' "$_label:$_subdir/$_fname" >>runtime/payload/overlay-files.txt
            if [ "$_subdir" = "bin" ]; then
                chmod 0755 "$_target"
                check_bin_arch_warn "$_target" "$_fname"
                printf '%s\n' "$_fname" >>runtime/payload/staged-tools.txt
                printf '%s\n' "$_fname" >>runtime/payload/built-tools.txt
                printf '%s\n' "$_fname" >>runtime/payload/overlay-tools.txt
                printf '%s\n' "buildroot-build-payload: staged overlay [$_label] bin/$_fname"
            fi
        done
    done
}

apply_overlays() {
    [ "$BB_USER_OVERLAY_ENABLE" = "yes" ] || return 0
    [ -n "${BB_USER_OVERLAY_ROOT:-}" ] || return 0
    if [ ! -d "$BB_USER_OVERLAY_ROOT" ]; then
        printf '%s\n' "buildroot-build-payload: WARNING: overlay root not found: $BB_USER_OVERLAY_ROOT" >&2
        return 0
    fi
    # The overlay root is the common directory; a <TARGET>/ subdir is applied on top.
    apply_overlay_dir "$BB_USER_OVERLAY_ROOT" "common"
    printf '%s\n' "$BB_USER_OVERLAY_ROOT" >>runtime/payload/overlay-paths.txt
    _toverlay="$BB_USER_OVERLAY_ROOT/$TARGET"
    if [ -d "$_toverlay" ]; then
        apply_overlay_dir "$_toverlay" "$TARGET"
        printf '%s\n' "$_toverlay" >>runtime/payload/overlay-paths.txt
    fi
    printf '%s\n' "buildroot-build-payload: overlay applied from $BB_USER_OVERLAY_ROOT"
}

write_exclusion_reasons() {
    _pre=$1
    _failed=$2
    _dir="runtime/payload/share/busierbox"
    mkdir -p "$_dir"
    _file="$_dir/exclusion-reasons.txt"
    : >"$_file"
    for _t in ${_pre:-}; do
        _reason=$(profile_value "EXCLUDED_REASON_${_t}" 2>/dev/null || true)
        [ -n "$_reason" ] || _reason="pre-excluded by gen-buildroot-defconfig"
        printf '%s=%s\n' "$_t" "$_reason" >>"$_file"
    done
    for _t in ${_failed:-}; do
        printf '%s=Buildroot build failed; optional heavy tool dropped in retry\n' "$_t" >>"$_file"
    done
    [ -s "$_file" ] || rm -f "$_file"
}

make_payload_archives() {
    rm -f dist/payload.tar dist/payload.tar.gz
    if tar --version 2>/dev/null | grep -qi 'GNU tar'; then
        tar --format=ustar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' -C runtime -cf dist/payload.tar payload
    elif tar --format=ustar -cf /dev/null -C runtime payload >/dev/null 2>&1; then
        tar --format=ustar -C runtime -cf dist/payload.tar payload
    else
        printf '%s\n' "buildroot-build-payload: tar does not support --format=ustar; refusing to create payload for the built-in extractor" >&2
        exit 1
    fi
    scripts/check-payload-tar dist/payload.tar
    if command -v gzip >/dev/null 2>&1; then
        gzip -n -c dist/payload.tar >dist/payload.tar.gz
    else
        printf '%s\n' "buildroot-build-payload: gzip is required for PAYLOAD_FORMAT=tgz" >&2
        [ "$PAYLOAD_FORMAT" = tar ] || exit 1
    fi
}

write_manifest() {
    static_status=$1
    payload_sha=$2
    arch=$(profile_value ARCH)
    libc=$(profile_value LIBC)
    kernel_floor=$(profile_value KERNEL_FLOOR)
    if command -v strings >/dev/null 2>&1; then
        busybox_version=$(strings runtime/payload/bin/busybox | sed -n 's/^BusyBox v\([^ ]*\).*/\1/p' | sed -n '1p')
    else
        busybox_version=unknown
    fi
    [ -n "$busybox_version" ] || busybox_version=unknown
    scripts/write-payload-manifest --target "$TARGET" --arch "$arch" --libc "$libc" --kernel-floor "$kernel_floor" --busybox-version "$busybox_version" --static-status "$static_status" --payload-sha256 "$payload_sha" --requested-tools "$requested_tools" --overlay-enable "${BB_USER_OVERLAY_ENABLE:-no}" --overlay-root "${BB_USER_OVERLAY_ROOT:-}" --gdbserver-provider "$GDBSERVER_PROVIDER"
}

[ -f "$profile" ] || die "unknown TARGET=$TARGET; missing $profile"
[ -f "$defconfig" ] || die "missing Buildroot defconfig $defconfig"
requested_tools=$(profile_value REQUESTED_TOOLS)
_profile_operator_identity=$(profile_value OPERATOR_DBCLIENT_IDENTITY_FILE 2>/dev/null || true)
BB_OPERATOR_DBCLIENT_IDENTITY_FILE=${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-$_profile_operator_identity}
_profile_operator_authkey=$(profile_value OPERATOR_AUTHORIZED_KEY_FILE 2>/dev/null || true)
BB_OPERATOR_AUTHORIZED_KEY_FILE=${BB_OPERATOR_AUTHORIZED_KEY_FILE:-$_profile_operator_authkey}
BB_DOTFILES_ENABLE=${BB_DOTFILES_ENABLE:-$(profile_value DOTFILES_ENABLE 2>/dev/null || true)}
BB_DOTFILE_ZSH_MODE=${BB_DOTFILE_ZSH_MODE:-$(profile_value DOTFILE_ZSH_MODE 2>/dev/null || true)}
BB_DOTFILE_ZSH_USER_FILE=${BB_DOTFILE_ZSH_USER_FILE:-$(profile_value DOTFILE_ZSH_USER_FILE 2>/dev/null || true)}
BB_DOTFILE_TMUX_MODE=${BB_DOTFILE_TMUX_MODE:-$(profile_value DOTFILE_TMUX_MODE 2>/dev/null || true)}
BB_DOTFILE_TMUX_USER_FILE=${BB_DOTFILE_TMUX_USER_FILE:-$(profile_value DOTFILE_TMUX_USER_FILE 2>/dev/null || true)}
BB_DOTFILE_GDB_MODE=${BB_DOTFILE_GDB_MODE:-$(profile_value DOTFILE_GDB_MODE 2>/dev/null || true)}
BB_DOTFILE_GDB_USER_FILE=${BB_DOTFILE_GDB_USER_FILE:-$(profile_value DOTFILE_GDB_USER_FILE 2>/dev/null || true)}
BB_DOTFILE_PROFILE_MODE=${BB_DOTFILE_PROFILE_MODE:-$(profile_value DOTFILE_PROFILE_MODE 2>/dev/null || true)}
BB_DOTFILE_PROFILE_USER_FILE=${BB_DOTFILE_PROFILE_USER_FILE:-$(profile_value DOTFILE_PROFILE_USER_FILE 2>/dev/null || true)}
BB_DOTFILES_ENABLE=${BB_DOTFILES_ENABLE:-yes}
BB_DOTFILE_ZSH_MODE=${BB_DOTFILE_ZSH_MODE:-default}
BB_DOTFILE_TMUX_MODE=${BB_DOTFILE_TMUX_MODE:-default}
BB_DOTFILE_GDB_MODE=${BB_DOTFILE_GDB_MODE:-default}
BB_DOTFILE_PROFILE_MODE=${BB_DOTFILE_PROFILE_MODE:-default}
BB_BUSYBOX_GROUPS=$(profile_value BUSYBOX_GROUPS 2>/dev/null || true)
pre_excluded=$(profile_value EXCLUDED_TOOLS 2>/dev/null || true)
GDBSERVER_PROVIDER=$(profile_value GDBSERVER_PROVIDER 2>/dev/null || true)
GDBSERVER_USER_PATH=$(profile_value GDBSERVER_USER_PATH 2>/dev/null || true)
TARGET_STATIC_POLICY=$(profile_value STATIC_POLICY 2>/dev/null || true)
BB_USER_OVERLAY_ENABLE=$(profile_value USER_OVERLAY_ENABLE 2>/dev/null || true)
BB_USER_OVERLAY_ROOT=$(profile_value USER_OVERLAY_ROOT 2>/dev/null || true)
BB_USER_OVERLAY_ALLOW_OVERRIDE=$(profile_value USER_OVERLAY_ALLOW_OVERRIDE 2>/dev/null || true)
GDBSERVER_PROVIDER=${GDBSERVER_PROVIDER:-auto}
BB_USER_OVERLAY_ENABLE=${BB_USER_OVERLAY_ENABLE:-no}
BB_USER_OVERLAY_ALLOW_OVERRIDE=${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}

ensure_buildroot
if [ "$PREPARE_ONLY" -eq 1 ]; then
    printf '%s\n' "Buildroot ready at $BUILDROOT_DIR"
    exit 0
fi
mkdir -p "$out_dir" runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home dist

printf '%s\n' "configuring Buildroot payload for $TARGET..."
cp "$defconfig" "$out_dir/.config"
make -C "$BUILDROOT_DIR" O="$out_abs" BR2_EXTERNAL="$(pwd)/buildroot/external/busierbox" olddefconfig
if [ "${BUSIERBOX_BUILDROOT_CONFIG_ONLY:-0}" = "1" ]; then
    printf '%s\n' "Buildroot configuration validated for $TARGET"
    exit 0
fi

if tool_requested socat && [ "${TARGET_STATIC_POLICY:-}" = dynamic ]; then
    printf '%s\n' "buildroot-build-payload: rebuilding socat for TLS/OpenSSL dynamic payload support"
    make -C "$BUILDROOT_DIR" O="$out_abs" BR2_EXTERNAL="$(pwd)/buildroot/external/busierbox" socat-dirclean >/dev/null 2>&1 || true
fi

printf '%s\n' "building Buildroot BusyBox payload for $TARGET..."
build_failed_tools=
_build_ok=0
if make -C "$BUILDROOT_DIR" O="$out_abs" BR2_EXTERNAL="$(pwd)/buildroot/external/busierbox" -j"$JOBS"; then
    _build_ok=1
fi

if [ "$_build_ok" = "0" ]; then
    if [ "$STRICT_HEAVY_TOOLS" = "1" ]; then
        die "Buildroot build failed for $TARGET; inspect $out_dir/build"
    fi
    printf '%s\n' "buildroot-build-payload: Buildroot build failed; retrying without optional heavy tools (set STRICT_HEAVY_TOOLS=1 to treat as fatal)..." >&2
    for _t in $requested_tools; do
        if in_list "$_t" ${pre_excluded:-}; then continue; fi
        case "$_t" in
            strace|gdbserver|curl|dropbear|zsh|tmux|socat|tcpdump|rsync|mtr|iperf3|ethtool|iw|minicom|mosh-client|ripgrep|jq|file|htop|screen|ltrace|readelf|objdump|usbutils|pciutils|nmap|nmap-ncat|psmisc|openssl|fd|zoxide|mtd-utils|ubi-utils|i2c-tools|spi-tools|mmc-utils|e2fsprogs|parted|doom)
                build_failed_tools="${build_failed_tools:+$build_failed_tools }$_t"
                ;;
        esac
    done
    _retry_cfg=$(mktemp)
    grep -v \
        -e '^BR2_PACKAGE_GDB' \
        -e '^BR2_PACKAGE_STRACE' \
        -e '^BR2_PACKAGE_LIBCURL' \
        -e '^BR2_PACKAGE_DROPBEAR' \
        -e '^BR2_PACKAGE_ZSH' \
        -e '^BR2_PACKAGE_TMUX' \
        -e '^BR2_PACKAGE_SOCAT' \
        -e '^BR2_PACKAGE_TCPDUMP' \
        -e '^BR2_PACKAGE_RSYNC' \
        -e '^BR2_PACKAGE_MTR' \
        -e '^BR2_PACKAGE_IPERF3' \
        -e '^BR2_PACKAGE_ETHTOOL' \
        -e '^BR2_PACKAGE_IW' \
        -e '^BR2_PACKAGE_MINICOM' \
        -e '^BR2_PACKAGE_MOSH' \
        -e '^BR2_PACKAGE_RIPGREP' \
        -e '^BR2_PACKAGE_JQ' \
        -e '^BR2_PACKAGE_FILE' \
        -e '^BR2_PACKAGE_HTOP' \
        -e '^BR2_PACKAGE_SCREEN' \
        -e '^BR2_PACKAGE_LTRACE' \
        -e '^BR2_PACKAGE_BINUTILS' \
        -e '^BR2_PACKAGE_USBUTILS' \
        -e '^BR2_PACKAGE_PCIUTILS' \
        -e '^BR2_PACKAGE_NMAP' \
        -e '^BR2_PACKAGE_PSMISC' \
        -e '^BR2_PACKAGE_OPENSSL' \
        -e '^BR2_PACKAGE_FD' \
        -e '^BR2_PACKAGE_ZOXIDE' \
        -e '^BR2_PACKAGE_MTD' \
        -e '^BR2_PACKAGE_I2C_TOOLS' \
        -e '^BR2_PACKAGE_SPI_TOOLS' \
        -e '^BR2_PACKAGE_MMC_UTILS' \
        -e '^BR2_PACKAGE_E2FSPROGS' \
        -e '^BR2_PACKAGE_PARTED' \
        -e 'BR2_TOOLCHAIN_BUILDROOT_CXX=y' \
        "$out_dir/.config" >"$_retry_cfg" 2>/dev/null || true
    printf '%s\n' "BR2_TOOLCHAIN_BUILDROOT_CXX=n" >>"$_retry_cfg"
    cp "$_retry_cfg" "$out_dir/.config"
    rm -f "$_retry_cfg"
    make -C "$BUILDROOT_DIR" O="$out_abs" BR2_EXTERNAL="$(pwd)/buildroot/external/busierbox" olddefconfig
    if ! make -C "$BUILDROOT_DIR" O="$out_abs" BR2_EXTERNAL="$(pwd)/buildroot/external/busierbox" -j"$JOBS"; then
        die "Buildroot build failed even without optional heavy tools for $TARGET; inspect $out_dir/build"
    fi
fi

busybox_src="$out_dir/target/bin/busybox"
[ -x "$busybox_src" ] || busybox_src="$out_dir/target/usr/bin/busybox"
[ -x "$busybox_src" ] || die "Buildroot completed but busybox was not found in $out_dir/target"

rm -rf runtime/payload
mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home
cp "$busybox_src" runtime/payload/bin/busybox
chmod 0755 runtime/payload/bin/busybox
static_status=$(copy_shared_libs_if_dynamic runtime/payload/bin/busybox)
_bb_build_cfg=$(find "$out_dir/build" -maxdepth 2 -path '*/busybox-*/.config' -type f | sort | sed -n '1p')
if [ -n "$_bb_build_cfg" ]; then
    scripts/busybox-applets-from-config "$_bb_build_cfg" >runtime/payload/busybox-applets.txt
else
    scripts/discover-buildroot-applets "$out_dir/target" runtime/payload/busybox-applets.txt
fi
rm -f runtime/payload/staged-tools.txt runtime/payload/built-tools.txt \
    runtime/payload/user-provided-tools.txt runtime/payload/overlay-tools.txt \
    runtime/payload/overlay-files.txt runtime/payload/overlay-paths.txt
: >runtime/payload/staged-tools.txt
: >runtime/payload/built-tools.txt
: >runtime/payload/user-provided-tools.txt
mkdir -p runtime/payload/share/busierbox

if tool_requested strace; then
    stage_first_found strace usr/bin/strace bin/strace || printf '%s\n' "buildroot-build-payload: requested strace but no built binary was found" >&2
fi
if tool_requested gdbserver; then
    _gdb_staged=0
    case "$GDBSERVER_PROVIDER" in
        buildroot|auto)
            if stage_first_found gdbserver usr/bin/gdbserver usr/sbin/gdbserver bin/gdbserver sbin/gdbserver; then
                _gdb_staged=1
            fi
            ;;
    esac
    if [ "$_gdb_staged" = "0" ]; then
        case "$GDBSERVER_PROVIDER" in
            user)
                if [ -n "${GDBSERVER_USER_PATH:-}" ]; then
                    if stage_user_binary gdbserver "$GDBSERVER_USER_PATH"; then
                        _gdb_staged=1
                    fi
                else
                    printf '%s\n' "buildroot-build-payload: GDBSERVER_PROVIDER=user but GDBSERVER_USER_PATH not set" >&2
                fi
                ;;
            auto)
                if [ -n "${GDBSERVER_USER_PATH:-}" ]; then
                    if stage_user_binary gdbserver "$GDBSERVER_USER_PATH"; then
                        _gdb_staged=1
                    fi
                fi
                ;;
        esac
    fi
    if [ "$_gdb_staged" = "0" ] && [ "$GDBSERVER_PROVIDER" != "none" ]; then
        printf '%s\n' "buildroot-build-payload: gdbserver not yet staged (provider=$GDBSERVER_PROVIDER); will check overlay if enabled" >&2
    fi
fi
