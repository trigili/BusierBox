#!/usr/bin/env python3
"""Populate or plan a BusierBox source mirror from manifests/sources.lock.json."""

import argparse
import hashlib
import json
import pathlib
import shutil
import subprocess
import sys
import urllib.request


ROOT = pathlib.Path(__file__).resolve().parents[1]


def load_lock(path):
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    if data.get("schema") not in (1, 2):
        raise SystemExit(f"mirror-sources: unsupported lock schema {data.get('schema')!r}")
    return data


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch(urls, dest):
    tmp = dest.with_suffix(dest.suffix + ".tmp")
    tmp.unlink(missing_ok=True)
    for url in urls:
        try:
            with urllib.request.urlopen(url, timeout=60) as src, open(tmp, "wb") as out:
                shutil.copyfileobj(src, out)
            tmp.replace(dest)
            return
        except Exception:
            tmp.unlink(missing_ok=True)
    raise SystemExit(f"mirror-sources: all URLs failed for {dest.name}")


def matrix_reasons(args):
    reasons = []
    if args.matrix:
        reasons.append(f"matrix:{args.matrix}")
    if args.targets:
        reasons.append(f"targets:{args.targets}")
    if args.payloads:
        reasons.append(f"payloads:{args.payloads}")
    return reasons or ["lockfile"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", default="manifests/sources.lock.json")
    parser.add_argument("--out", required=True)
    parser.add_argument("--matrix")
    parser.add_argument("--targets")
    parser.add_argument("--payloads")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    lock_path = ROOT / args.manifest
    data = load_lock(lock_path)
    out = pathlib.Path(args.out)
    source_dir = out / "sources"
    buildroot_dl = out / "buildroot-dl"
    manifest_rows = []
    reasons = matrix_reasons(args)

    if not args.dry_run:
        source_dir.mkdir(parents=True, exist_ok=True)
        buildroot_dl.mkdir(parents=True, exist_ok=True)

    for src in data.get("sources", []):
        filename = pathlib.Path(src["filename"]).name
        urls = src.get("urls") or [src.get("url")]
        dest = source_dir / filename
        status = "planned"
        if not args.dry_run:
            if not dest.exists():
                fetch(urls, dest)
            actual = sha256_file(dest)
            if actual != src["sha256"].lower():
                raise SystemExit(f"mirror-sources: sha256 mismatch for {filename}")
            shutil.copy2(dest, buildroot_dl / filename)
            status = "present"
        manifest_rows.append({
            "name": src.get("name"),
            "version": src.get("version"),
            "filename": filename,
            "sha256": src.get("sha256"),
            "urls": urls,
            "reason": reasons,
            "status": status,
        })

    mirror_manifest = {
        "schema": 1,
        "source_lock": str(lock_path),
        "sources": manifest_rows,
        "limitations": [
            "This mirror covers BusierBox-pinned sources in manifests/sources.lock.json.",
            "Buildroot package tarballs beyond the pinned Buildroot archive must be populated through Buildroot DL_DIR for the selected defconfigs.",
        ],
    }
    if args.dry_run:
        print(json.dumps(mirror_manifest, indent=2, sort_keys=True))
    else:
        out.mkdir(parents=True, exist_ok=True)
        shutil.copy2(lock_path, out / "sources.lock.json")
        (out / "mirror-manifest.json").write_text(json.dumps(mirror_manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        print(f"mirror={out}")
        print(f"manifest={out / 'mirror-manifest.json'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
