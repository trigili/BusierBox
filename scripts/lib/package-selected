#!/bin/sh
set -eu

target=${TARGET:-}
config=${GRIT_CONFIG:-configs/grit.conf}

if [ -n "$target" ]; then
    scripts/lib/package-target "$target"
else
    targets=
    if [ -f "$config" ]; then
        # shellcheck disable=SC1091
        . "$config"
        targets=${GRIT_TARGETS:-}
        if [ "$targets" = "native" ] && [ "${GRIT_TARGET_PRESET:-native}" != "native" ]; then
            targets=$GRIT_TARGET_PRESET
        fi
    fi
    if [ -z "$targets" ]; then
        scripts/lib/package-target --config
    else
        for t in $targets; do
            [ "$t" != default ] || {
                printf '%s\n' "package-selected: default is a blank target configuration; choose native or a concrete target before building." >&2
                exit 1
            }
            scripts/lib/package-target "$t"
        done
    fi
fi
