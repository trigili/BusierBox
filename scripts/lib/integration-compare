#!/usr/bin/env python3
"""Compare two griTTYkit integration summary files."""

import argparse
import json
import pathlib


def load(path):
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def by_case(summary):
    return {case.get("case", ""): case for case in summary.get("cases") or [] if case.get("case")}


def records_by_key(records, key):
    out = {}
    for record in records:
        if not isinstance(record, dict):
            continue
        value = record.get(key)
        if value is None:
            continue
        out.setdefault(str(value), []).append(record)
    return out


def index_records(records, key, *, boolean=False):
    out = {}
    for idx, record in enumerate(records):
        if not isinstance(record, dict):
            continue
        value = record.get(key)
        if boolean:
            value = "yes" if value else "no"
        else:
            value = str(value if value is not None else "")
        out.setdefault(value, []).append(idx)
    return out


def api_collection_record(name, records, indexes, summary_key, primary_key):
    return {
        "name": name,
        "count": len(records),
        "summary_key": summary_key,
        "count_summary_key": summary_key,
        "primary_key": primary_key,
        "indexes": indexes,
    }


def api_resource_record(name, records_key, collection_key, count, summary_key, primary_key, indexes):
    return {
        "name": name,
        "records_key": records_key,
        "collection_key": collection_key,
        "count": count,
        "summary_key": summary_key,
        "count_summary_key": summary_key,
        "primary_key": primary_key,
        "indexes": indexes,
    }


def api_resource_indexes(records):
    return {
        "api_resources_by_name": {rec.get("name", ""): rec for rec in records if rec.get("name")},
        "api_resources_by_records_key": records_by_key(records, "records_key"),
        "api_resources_by_summary_key": records_by_key(records, "summary_key"),
        "api_resources_by_primary_key": records_by_key(records, "primary_key"),
    }


def size_delta(old, new):
    old_size = old.get("artifact_size") or old.get("size")
    new_size = new.get("artifact_size") or new.get("size")
    if isinstance(old_size, int) and isinstance(new_size, int):
        return new_size - old_size
    return ""


def duration_value(case):
    for key in ("duration_sec", "duration", "elapsed_sec"):
        value = case.get(key)
        if isinstance(value, (int, float)):
            return float(value)
    timing = case.get("timing") or {}
    value = timing.get("duration_sec")
    if isinstance(value, (int, float)):
        return float(value)
    return None


def duration_delta(old, new):
    old_duration = duration_value(old)
    new_duration = duration_value(new)
    if old_duration is None or new_duration is None:
        return ""
    return round(new_duration - old_duration, 3)


def classify_change(name, before, after, status_before, status_after, sha_before, sha_after, delta, ddelta):
    if not before:
        if status_after == "fail":
            return "new_failure"
        return "new_case"
    if not after:
        return "removed"
    if status_before != "fail" and status_after == "fail":
        return "regression"
    if status_before == "fail" and status_after != "fail":
        return "fixed"
    if status_before != status_after:
        return "status_changed"
    if sha_before != sha_after:
        return "artifact_changed"
    if delta not in ("", 0):
        return "size_changed"
    if ddelta not in ("", 0):
        return "duration_changed"
    return "unchanged"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("old_summary")
    parser.add_argument("new_summary")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    old = load(args.old_summary)
    new = load(args.new_summary)
    old_cases = by_case(old)
    new_cases = by_case(new)
    changes = []
    for name in sorted(set(old_cases) | set(new_cases)):
        before = old_cases.get(name, {})
        after = new_cases.get(name, {})
        status_before = before.get("status", "missing")
        status_after = after.get("status", "missing")
        sha_before = before.get("artifact_sha256", "")
        sha_after = after.get("artifact_sha256", "")
        delta = size_delta(before, after)
        ddelta = duration_delta(before, after)
        classification = classify_change(
            name, before, after, status_before, status_after, sha_before, sha_after, delta, ddelta
        )
        changed = classification != "unchanged"
        changes.append({
            "case": name,
            "classification": classification,
            "old_status": status_before,
            "new_status": status_after,
            "old_sha256": sha_before,
            "new_sha256": sha_after,
            "artifact_size_delta": delta,
            "duration_delta_sec": ddelta,
            "changed": changed,
            "new_reason": after.get("reason") or after.get("error") or "",
        })

    result = {
        "schema": 1,
        "old_status": old.get("status"),
        "new_status": new.get("status"),
        "regressions": [c for c in changes if c["classification"] == "regression"],
        "new_failures": [c for c in changes if c["classification"] == "new_failure"],
        "fixed": [c for c in changes if c["classification"] == "fixed"],
        "changes": changes,
    }
    result.update({
        "change_count": len(changes),
        "changed_count": sum(1 for c in changes if c.get("changed")),
        "regression_count": len(result["regressions"]),
        "new_failure_count": len(result["new_failures"]),
        "fixed_count": len(result["fixed"]),
        "changes_by_case": index_records(changes, "case"),
        "changes_by_classification": index_records(changes, "classification"),
        "changes_by_old_status": index_records(changes, "old_status"),
        "changes_by_new_status": index_records(changes, "new_status"),
        "changes_by_changed": index_records(changes, "changed", boolean=True),
        "changes_by_old_new_status": index_records(
            [
                dict(change, old_new_status=f"{change.get('old_status', '')}:{change.get('new_status', '')}")
                for change in changes
            ],
            "old_new_status",
        ),
    })
    result["api_collections"] = {
        "changes": api_collection_record(
            "changes",
            changes,
            [
                "changes_by_case",
                "changes_by_classification",
                "changes_by_old_status",
                "changes_by_new_status",
                "changes_by_changed",
                "changes_by_old_new_status",
            ],
            "change_count",
            "case",
        ),
        "regressions": api_collection_record(
            "regressions",
            result["regressions"],
            ["changes_by_classification"],
            "regression_count",
            "case",
        ),
        "new_failures": api_collection_record(
            "new_failures",
            result["new_failures"],
            ["changes_by_classification"],
            "new_failure_count",
            "case",
        ),
        "fixed": api_collection_record(
            "fixed",
            result["fixed"],
            ["changes_by_classification"],
            "fixed_count",
            "case",
        ),
    }
    resources = [
        api_resource_record(
            "changes",
            "changes",
            "api_collections.changes",
            len(changes),
            "change_count",
            "case",
            result["api_collections"]["changes"]["indexes"],
        ),
        api_resource_record(
            "regressions",
            "regressions",
            "api_collections.regressions",
            len(result["regressions"]),
            "regression_count",
            "case",
            ["changes_by_classification"],
        ),
        api_resource_record(
            "new_failures",
            "new_failures",
            "api_collections.new_failures",
            len(result["new_failures"]),
            "new_failure_count",
            "case",
            ["changes_by_classification"],
        ),
        api_resource_record(
            "fixed",
            "fixed",
            "api_collections.fixed",
            len(result["fixed"]),
            "fixed_count",
            "case",
            ["changes_by_classification"],
        ),
    ]
    result["api"] = {
        "schema": 1,
        "resource_count": len(resources),
        "resources_key": "api_resources",
        "collections_key": "api_collections",
    }
    result["api_resources"] = resources
    result.update(api_resource_indexes(resources))
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"old_status={result['old_status']}")
        print(f"new_status={result['new_status']}")
        print(
            f"{'Case':<24} {'Old':<8} {'New':<8} {'Class':<16} "
            f"{'Size Delta':>10} {'Duration':>10} Notes"
        )
        for change in changes:
            notes = []
            if change["classification"] in ("regression", "new_failure", "fixed", "status_changed"):
                notes.append(change["classification"].replace("_", " "))
            if change["old_sha256"] != change["new_sha256"]:
                notes.append("artifact changed")
            if change["artifact_size_delta"] not in ("", 0):
                notes.append("size changed")
            if change["duration_delta_sec"] not in ("", 0):
                notes.append("duration changed")
            if change["new_reason"]:
                notes.append(change["new_reason"])
            note = "; ".join(notes)
            print(
                f"{change['case']:<24} {change['old_status']:<8} {change['new_status']:<8} "
                f"{change['classification']:<16} {str(change['artifact_size_delta']):>10} "
                f"{str(change['duration_delta_sec']):>10} {note}"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
