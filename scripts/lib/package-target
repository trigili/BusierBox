#!/bin/sh
set -eu

usage() {
    printf '%s\n' "usage: scripts/lib/package-target TARGET|--config" >&2
}

target=${1:-}
[ -n "$target" ] || { usage; exit 2; }
requested_target=$target

capture_env_override() {
    name=$1
    eval "case \"\${$name+x}\" in x) ${name}_ENV_SET=1; ${name}_ENV_VALUE=\${$name} ;; *) ${name}_ENV_SET=0; ${name}_ENV_VALUE= ;; esac"
}

restore_env_override() {
    name=$1
    eval "if [ \"\$${name}_ENV_SET\" = 1 ]; then $name=\$${name}_ENV_VALUE; fi"
}

die() {
    printf '%s\n' "package-target: $*" >&2
    exit 1
}

PACKAGE_TARGET_LOCK_DIR=${PACKAGE_TARGET_LOCK_DIR:-local/tmp/package-target.lock}
PACKAGE_TARGET_LOCK_HELD=0

cleanup_package_target_lock() {
    if [ "${PACKAGE_TARGET_LOCK_HELD:-0}" = 1 ]; then
        rm -f "$PACKAGE_TARGET_LOCK_DIR/pid" "$PACKAGE_TARGET_LOCK_DIR/target" 2>/dev/null || true
        rmdir "$PACKAGE_TARGET_LOCK_DIR" 2>/dev/null || true
        PACKAGE_TARGET_LOCK_HELD=0
    fi
}

release_package_target_lock() {
    cleanup_package_target_lock
}

package_target_signal() {
    cleanup_package_target_lock
    cleanup_isolated_package_payload
    exit 130
}

cleanup_isolated_package_payload() {
    if [ -n "${package_payload_stage:-}" ]; then
        rm -rf "$package_payload_stage" "${package_payload_archive_prefix%/*}" 2>/dev/null || true
        package_payload_stage=
    fi
}

acquire_package_target_lock() {
    [ "${GRIT_PACKAGE_TARGET_LOCK:-yes}" != no ] || return 0

    lock_parent=$(dirname "$PACKAGE_TARGET_LOCK_DIR")
    mkdir -p "$lock_parent"
    waited=0
    while ! mkdir "$PACKAGE_TARGET_LOCK_DIR" 2>/dev/null; do
        if [ -f "$PACKAGE_TARGET_LOCK_DIR/pid" ]; then
            owner_pid=$(sed -n '1p' "$PACKAGE_TARGET_LOCK_DIR/pid" 2>/dev/null || true)
            case "$owner_pid" in
                ""|*[!0-9]*)
                    rm -f "$PACKAGE_TARGET_LOCK_DIR/pid" "$PACKAGE_TARGET_LOCK_DIR/target" 2>/dev/null || true
                    rmdir "$PACKAGE_TARGET_LOCK_DIR" 2>/dev/null || true
                    ;;
                *)
                    if ! kill -0 "$owner_pid" 2>/dev/null; then
                        rm -f "$PACKAGE_TARGET_LOCK_DIR/pid" "$PACKAGE_TARGET_LOCK_DIR/target" 2>/dev/null || true
                        rmdir "$PACKAGE_TARGET_LOCK_DIR" 2>/dev/null || true
                    fi
                    ;;
            esac
        fi
        waited=$((waited + 1))
        if [ "$waited" = 1 ]; then
            printf '%s\n' "package-target: waiting for shared payload staging lock: $PACKAGE_TARGET_LOCK_DIR" >&2
        fi
        sleep 1
    done
    PACKAGE_TARGET_LOCK_HELD=1
    trap cleanup_package_target_lock EXIT
    trap package_target_signal HUP INT TERM
    printf '%s\n' "$$" >"$PACKAGE_TARGET_LOCK_DIR/pid" 2>/dev/null || true
    printf '%s\n' "${target:-unknown}" >"$PACKAGE_TARGET_LOCK_DIR/target" 2>/dev/null || true
    printf '%s\n' "package-target: acquired shared payload staging lock for ${target:-unknown}" >&2
}

