sha256_write() {
    file=$1
    out=$2
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" >"$out"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" >"$out"
    else
        printf '%s\n' "sha256 unavailable  $file" >"$out"
    fi
}

payload_suffix() {
    if [ "$PAYLOAD_FORMAT" = tar ]; then
        printf '%s\n' tar
    else
        printf '%s\n' tar.gz
    fi
}

copy_payload_artifacts() {
    suffix=$(payload_suffix)
    [ -f "$package_payload_archive_prefix.$suffix" ] || die "payload archive $package_payload_archive_prefix.$suffix was not produced"
    cp "$package_payload_archive_prefix.tar" "dist/payload-$target.tar"
    sha256_write "dist/payload-$target.tar" "dist/payload-$target.tar.sha256"
    if [ -f "$package_payload_archive_prefix.tar.gz" ]; then
        cp "$package_payload_archive_prefix.tar.gz" "dist/payload-$target.tar.gz"
        sha256_write "dist/payload-$target.tar.gz" "dist/payload-$target.tar.gz.sha256"
    fi
}

find_cross_cc() {
    out_dir="$BUILDROOT_OUTPUT_BASE/$target"
    host_bin="$out_dir/host/bin"
    [ -d "$host_bin" ] || return 1
    find "$host_bin" \( -type f -o -type l \) -name '*-gcc' ! -name gcc | sort | sed -n '1p'
}

bool01() {
    case "$1" in
        yes|1|true|on) printf 1 ;;
        *) printf 0 ;;
    esac
}

has_item() {
    case " ${1:-} " in
        *" $2 "*) return 0 ;;
        *) return 1 ;;
    esac
}

is_int_value() {
    case "${1:-}" in
        -[0-9]*|[0-9]*)
            case "${1#-}" in
                *[!0-9]*|"") return 1 ;;
                *) return 0 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

is_uint_value() {
    case "${1:-}" in
        *[!0-9]*|"") return 1 ;;
        *) return 0 ;;
    esac
}

validate_build_config() {
    errors=

    case "$GRIT_RUNTIME_MODE" in
        extract|core-only|no-residue) ;;
        *) errors="$errors
- invalid runtime mode: $GRIT_RUNTIME_MODE." ;;
    esac
    case "$GRIT_NORESIDUE_LEVEL" in
        best-effort|aggressive) ;;
        *) errors="$errors
- invalid no-residue level: $GRIT_NORESIDUE_LEVEL." ;;
    esac
    if [ "$GRIT_RUNTIME_MODE" = no-residue ] && [ "$GRIT_NORESIDUE_LEVEL" = aggressive ] && [ "$GRIT_RUNTIME_ALLOW_FALLBACK_ROOT" = yes ]; then
        errors="$errors
- aggressive no-residue cannot use runtime fallback root; set GRIT_RUNTIME_ALLOW_FALLBACK_ROOT=no or use GRIT_NORESIDUE_LEVEL=best-effort."
    fi

    case "$GRIT_ZERO_ARG_MODE" in
        help|survey|rshell|custom|command) ;;
        *) errors="$errors
- invalid zero-arg mode: $GRIT_ZERO_ARG_MODE." ;;
    esac

    case "$GRIT_RSHELL_TRANSPORT" in
        none|builtin|socat|ssh) ;;
        *) errors="$errors
- invalid rshell transport: $GRIT_RSHELL_TRANSPORT." ;;
    esac

    if [ "$GRIT_RUNTIME_MODE" = core-only ]; then
        case "$GRIT_RSHELL_TRANSPORT" in
            ssh|socat) errors="$errors
- core-only + transport=$GRIT_RSHELL_TRANSPORT: staged tools unavailable in core-only mode." ;;
        esac
        [ -z "${GRIT_HEAVY_TOOLS:-}" ] || errors="$errors
- core-only runtime cannot stage heavy tools. Clear GRIT_HEAVY_TOOLS or change runtime mode."
        [ "$GRIT_DOTFILES_ENABLE" != yes ] || errors="$errors
- core-only runtime cannot stage per-app dotfiles. Set GRIT_DOTFILES_ENABLE=no."
        [ "${GRIT_USER_OVERLAY_ENABLE:-no}" != yes ] || errors="$errors
- core-only runtime cannot stage a user overlay. Set GRIT_USER_OVERLAY_ENABLE=no."
    fi

    if [ "$GRIT_ZERO_ARG_MODE" = rshell ] && [ "$GRIT_RSHELL_TRANSPORT" = none ]; then
        errors="$errors
- zero-arg mode is 'rshell' but reverse shell is disabled (transport=none)."
    fi
    if [ "$GRIT_ZERO_ARG_MODE" = rshell ] && [ "$GRIT_RSHELL_TRANSPORT" != none ] && [ -z "${GRIT_OPERATOR_SERVER_HOST:-}" ] && [ "$GRIT_ALLOW_UNCONFIGURED_OPERATOR_HOST" != yes ]; then
        errors="$errors
- zero-arg rshell mode requires operator host/IP to be set."
    fi
    if [ "$GRIT_ZERO_ARG_MODE" = custom ] && [ -z "${GRIT_ZERO_ARG_CUSTOM_COMMAND:-}" ]; then
        errors="$errors
- zero-arg custom mode requires GRIT_ZERO_ARG_CUSTOM_COMMAND to be set."
    fi

    if [ "$GRIT_RSHELL_TRANSPORT" = builtin ] && [ "$GRIT_RSHELL_ENCRYPTION" = none ]; then
        errors="$errors
- builtin plaintext is not implemented. Use encryption=tls or a different transport."
    elif [ "$GRIT_RSHELL_ENCRYPTION" = none ] && [ "$GRIT_RSHELL_TRANSPORT" != none ] && [ "$GRIT_RSHELL_ALLOW_PLAINTEXT" != yes ]; then
        errors="$errors
- encryption=none requires GRIT_RSHELL_ALLOW_PLAINTEXT=yes."
    fi

    if [ "$GRIT_RSHELL_TRANSPORT" = ssh ] && [ "$GRIT_RUNTIME_MODE" != core-only ] && ! has_item "$GRIT_HEAVY_TOOLS" dropbear; then
        errors="$errors
- transport=ssh but dropbear is not in heavy tools."
    fi
    if [ "$GRIT_RSHELL_TRANSPORT" = socat ] && [ "$GRIT_RUNTIME_MODE" != core-only ] && ! has_item "$GRIT_HEAVY_TOOLS" socat; then
        errors="$errors
- transport=socat but socat is not in heavy tools."
    fi

    case "$GRIT_RSHELL_AUTHKEYS_MODE" in
        root-copy|root-merge)
            [ "$GRIT_RUNTIME_ALLOW_EXTERNAL_WRITES" = yes ] || errors="$errors
- authkeys mode $GRIT_RSHELL_AUTHKEYS_MODE writes outside the runtime root. Set GRIT_RUNTIME_ALLOW_EXTERNAL_WRITES=yes or choose another authkeys mode." ;;
        disabled|payload-home) ;;
        *) errors="$errors
- invalid rshell authkeys mode: $GRIT_RSHELL_AUTHKEYS_MODE." ;;
    esac

    case "$GRIT_RSHELL_RUN_MODE" in
        foreground|background|auto) ;;
        *) errors="$errors
- invalid rshell run mode: $GRIT_RSHELL_RUN_MODE." ;;
    esac

    case "$GRIT_RSHELL_SESSION_POLICY" in
        single|reconnect|persistent) ;;
        *) errors="$errors
- invalid rshell session policy: $GRIT_RSHELL_SESSION_POLICY." ;;
    esac

    case "$GRIT_RSHELL_SHELL_PROVIDER" in
        auto|target-sh) ;;
        payload-busybox-sh|payload-busybox-ash)
            [ "$GRIT_RUNTIME_MODE" != core-only ] || errors="$errors
- shell provider $GRIT_RSHELL_SHELL_PROVIDER is invalid in core-only mode." ;;
        payload-zsh)
            [ "$GRIT_RUNTIME_MODE" != core-only ] || errors="$errors
- shell provider payload-zsh is invalid in core-only mode."
            has_item "$GRIT_HEAVY_TOOLS" zsh || errors="$errors
- shell provider payload-zsh requires zsh in heavy tools." ;;
        custom)
            [ -n "${GRIT_RSHELL_CUSTOM_SHELL:-}" ] || errors="$errors
- shell provider custom requires GRIT_RSHELL_CUSTOM_SHELL to be set." ;;
        *) errors="$errors
- invalid shell provider: $GRIT_RSHELL_SHELL_PROVIDER." ;;
    esac

    case "$GRIT_RSHELL_RETRY_BACKOFF" in
        none|linear|exponential) ;;
        *) errors="$errors
- invalid rshell retry backoff: $GRIT_RSHELL_RETRY_BACKOFF." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_ENABLE" in
        no|yes) ;;
        *) errors="$errors
- invalid command queue enable value: $GRIT_COMMAND_QUEUE_ENABLE." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_TLS" in
        no|yes) ;;
        *) errors="$errors
- invalid command queue TLS value: $GRIT_COMMAND_QUEUE_TLS." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_REQUIRE_TOKEN" in
        no|yes) ;;
        *) errors="$errors
- invalid command queue token requirement: $GRIT_COMMAND_QUEUE_REQUIRE_TOKEN." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_TOKEN_SOURCE" in
        manual|generated) ;;
        *) errors="$errors
- invalid command queue token source: $GRIT_COMMAND_QUEUE_TOKEN_SOURCE." ;;
    esac
    if [ "$GRIT_COMMAND_QUEUE_ENABLE" = yes ] && [ "$GRIT_COMMAND_QUEUE_REQUIRE_TOKEN" = yes ] && [ -z "$GRIT_COMMAND_QUEUE_TOKEN" ]; then
        errors="$errors
- enabled command queue requires GRIT_COMMAND_QUEUE_TOKEN when token requirement is yes."
    fi
    case "$GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS" in
        none|grit-only|allowlist|custom) ;;
        *) errors="$errors
- invalid command queue allowed commands policy: $GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_EXECUTION" in
        metadata-only|execute) ;;
        *) errors="$errors
- invalid command queue execution mode: $GRIT_COMMAND_QUEUE_EXECUTION." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_ALLOW_ARBITRARY" in
        no|yes) ;;
        *) errors="$errors
- invalid command queue arbitrary-execution flag: $GRIT_COMMAND_QUEUE_ALLOW_ARBITRARY." ;;
    esac
    case "$GRIT_COMMAND_QUEUE_POLL_BACKOFF" in
        none|linear|exponential) ;;
        *) errors="$errors
- invalid command queue poll backoff: $GRIT_COMMAND_QUEUE_POLL_BACKOFF." ;;
    esac
    is_int_value "$GRIT_RSHELL_RETRY_COUNT" || errors="$errors
- GRIT_RSHELL_RETRY_COUNT must be an integer (-1 means retry indefinitely)."
    is_uint_value "$GRIT_RSHELL_RETRY_INTERVAL_SEC" || errors="$errors
- GRIT_RSHELL_RETRY_INTERVAL_SEC must be a non-negative integer."
    is_uint_value "$GRIT_RSHELL_RETRY_JITTER_PCT" || errors="$errors
- GRIT_RSHELL_RETRY_JITTER_PCT must be a non-negative integer."
    is_uint_value "$GRIT_RSHELL_RETRY_MAX_INTERVAL_SEC" || errors="$errors
- GRIT_RSHELL_RETRY_MAX_INTERVAL_SEC must be a non-negative integer."
    is_uint_value "$GRIT_COMMAND_QUEUE_PORT" || errors="$errors
- GRIT_COMMAND_QUEUE_PORT must be a non-negative integer."
    is_uint_value "$GRIT_COMMAND_QUEUE_POLL_INTERVAL_SEC" || errors="$errors
- GRIT_COMMAND_QUEUE_POLL_INTERVAL_SEC must be a non-negative integer."
    is_uint_value "$GRIT_COMMAND_QUEUE_POLL_JITTER_PCT" || errors="$errors
- GRIT_COMMAND_QUEUE_POLL_JITTER_PCT must be a non-negative integer."
    is_uint_value "$GRIT_COMMAND_QUEUE_POLL_MAX_INTERVAL_SEC" || errors="$errors
- GRIT_COMMAND_QUEUE_POLL_MAX_INTERVAL_SEC must be a non-negative integer."
    is_uint_value "$GRIT_COMMAND_QUEUE_MAX_POLLS" || errors="$errors
- GRIT_COMMAND_QUEUE_MAX_POLLS must be a non-negative integer."
    if [ "$GRIT_COMMAND_QUEUE_ENABLE" != yes ]; then
        [ "$GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS" = none ] || errors="$errors
- command queue is disabled but allowed commands is $GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS; keep disabled queues at policy=none."
        [ "$GRIT_COMMAND_QUEUE_EXECUTION" = metadata-only ] || errors="$errors
- command queue is disabled but execution mode is $GRIT_COMMAND_QUEUE_EXECUTION; keep disabled queues at execution=metadata-only."
        [ "$GRIT_COMMAND_QUEUE_ALLOW_ARBITRARY" = no ] || errors="$errors
- command queue is disabled but arbitrary execution is allowed."
    fi
    if [ "$GRIT_COMMAND_QUEUE_EXECUTION" = execute ] && [ "$GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS" = none ]; then
        errors="$errors
- command queue execution mode execute requires a non-none allowed commands policy."
    fi
    if [ "$GRIT_COMMAND_QUEUE_ALLOW_ARBITRARY" = yes ] && [ "$GRIT_COMMAND_QUEUE_ALLOWED_COMMANDS" != custom ]; then
        errors="$errors
- arbitrary command queue execution requires allowed commands policy custom."
    fi

    if [ -n "$errors" ]; then
        printf '%s\n' "package-target: invalid configuration:" >&2
        printf '%s\n' "$errors" >&2
        exit 1
    fi
}

