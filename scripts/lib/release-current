#!/bin/sh
set -eu

usage() {
    printf '%s\n' "usage: scripts/lib/release-current [TARGET|--config]" >&2
}

target_arg=${1:---config}
case "$target_arg" in
    -h|--help) usage; exit 0 ;;
esac

if [ -f configs/grit.conf ]; then
    . ./configs/grit.conf
fi

if [ "$target_arg" = --config ] || [ "$target_arg" = config ]; then
    resolved=$(scripts/lib/resolve-target --config 2>&1) || {
        printf '%s\n' "release-current: $resolved" >&2
        exit 1
    }
else
    resolved=$(scripts/lib/resolve-target "$target_arg" 2>&1) || {
        printf '%s\n' "release-current: $resolved" >&2
        exit 1
    }
fi
eval "$resolved"

target=$TARGET_NAME
version=${GRIT_PAYLOAD_VERSION:-dev}
release_name=${GRIT_RELEASE_NAME:-$version-$target}
release_dir=${GRIT_RELEASE_DIR:-dist/releases/$release_name}

TARGET="$target_arg" VERIFY=1 scripts/lib/package-selected

artifact="dist/grit-$target-full"
[ -f "$artifact" ] || {
    printf '%s\n' "release-current: artifact missing after package: $artifact" >&2
    exit 1
}

mkdir -p "$release_dir/manifests"
cp "$artifact" "$release_dir/"
[ -f "$artifact.sha256" ] && cp "$artifact.sha256" "$release_dir/"

if [ -f "dist/payload-$target.tar" ]; then
    cp "dist/payload-$target.tar" "$release_dir/"
fi
if [ -f "dist/payload-$target.tar.sha256" ]; then
    cp "dist/payload-$target.tar.sha256" "$release_dir/"
fi
if [ -f "dist/payload-$target.tar.gz" ]; then
    cp "dist/payload-$target.tar.gz" "$release_dir/"
fi
if [ -f "dist/payload-$target.tar.gz.sha256" ]; then
    cp "dist/payload-$target.tar.gz.sha256" "$release_dir/"
fi

scripts/lib/inspect-artifact "$artifact" >"$release_dir/manifests/$target-full.inspect.txt"

(
    cd "$release_dir"
    if command -v sha256sum >/dev/null 2>&1; then
        : >SHA256SUMS
        find . -type f ! -name SHA256SUMS | LC_ALL=C sort |
        while IFS= read -r file; do
            sha256sum "$file" >>SHA256SUMS
        done
    elif command -v shasum >/dev/null 2>&1; then
        : >SHA256SUMS
        find . -type f ! -name SHA256SUMS | LC_ALL=C sort |
        while IFS= read -r file; do
            shasum -a 256 "$file" >>SHA256SUMS
        done
    else
        printf '%s\n' "sha256 tool unavailable" >SHA256SUMS
    fi
)

printf '%s\n' "release staged: $release_dir"
