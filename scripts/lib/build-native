# GRIT_BUILTIN_TLS_ENABLE is derived from transport; only override if explicitly set
if [ -z "${GRIT_BUILTIN_TLS_ENABLE:-}" ]; then
    [ "$GRIT_RSHELL_TRANSPORT" = builtin ] && GRIT_BUILTIN_TLS_ENABLE=yes || GRIT_BUILTIN_TLS_ENABLE=no
fi
: "${GRIT_AUTORUN_GUARD_ENABLE:=yes}"
# Derive guard path from runtime root if still at the old /tmp default
if [ "${GRIT_AUTORUN_GUARD_PATH:-/tmp/grit-autorun}" = "/tmp/grit-autorun" ]; then
    GRIT_AUTORUN_GUARD_PATH="${GRIT_RUNTIME_ROOT}/run"
fi
: "${GRIT_AUTORUN_GUARD_PATH:=${GRIT_RUNTIME_ROOT}/run}"
: "${GRIT_AUTORUN_REENTRY_ACTION:=status}"
: "${GRIT_AUTORUN_STALE_LOCK_POLICY:=recover}"
: "${GRIT_OPERATOR_REMOTE_FORWARD_PORT:=2200}"
: "${GRIT_OPERATOR_TARGET_DROPBEAR_PORT:=2222}"
: "${GRIT_OPERATOR_SERVER_HOST:=}"
: "${GRIT_OPERATOR_SERVER_USER:=operator}"
: "${GRIT_OPERATOR_SERVER_SSH_PORT:=22}"
: "${GRIT_OPERATOR_TARGET_BIND_HOST:=127.0.0.1}"
