fi
if [ -z "${GRIT_PAYLOAD_VERSION:-}" ]; then
    _ver_base=$(cat "$(dirname "$0")/../../VERSION" 2>/dev/null || printf '0.1')
    _ver_patch=$(git rev-list --count HEAD 2>/dev/null || printf '0')
    GRIT_PAYLOAD_VERSION="${_ver_base}.${_ver_patch}"
fi
