src="src/grit.c src/payload_runtime.c src/applet_extract.c src/applet_list.c src/applet_manifest.c src/applet_doctor.c src/applet_reality_test.c src/applet_config_info.c src/applet_clean.c src/applet_plan.c src/applet_recovery.c src/applet_survey.c src/applet_envfix.c src/applet_fetch.c src/applet_rshell.c src/applet_upload.c src/applet_command_queue.c src/command_queue_policy.c src/ledger.c src/runtime_paths.c src/runtime_probe.c src/json_helpers.c src/payload_extract.c src/payload_dispatch.c src/trailer_config.c src/runtime_config.c src/sha256.c"
miniz_src="third_party/miniz/miniz.c"
miniz_cflags="-Os -std=c99 -Ithird_party/miniz"
tmp="${OUT}.$$.tmp"

mkdir -p src dist

scripts/lib/gen-tool-headers

quote_c() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Normalise old transport names for backward compat
case "$GRIT_RSHELL_TRANSPORT" in
    builtin-tls) GRIT_RSHELL_TRANSPORT=builtin; GRIT_RSHELL_ENCRYPTION=${GRIT_RSHELL_ENCRYPTION:-tls} ;;
    socat-tls)   GRIT_RSHELL_TRANSPORT=socat;   GRIT_RSHELL_ENCRYPTION=${GRIT_RSHELL_ENCRYPTION:-tls} ;;
esac
: "${GRIT_RSHELL_ENCRYPTION:=tls}"

case "$GRIT_NORESIDUE_LEVEL" in
    best-effort|aggressive) ;;
    *)
        printf '%s\n' "build-native: invalid GRIT_NORESIDUE_LEVEL=$GRIT_NORESIDUE_LEVEL (expected best-effort or aggressive)" >&2
        exit 1
        ;;
esac
if [ "$GRIT_RUNTIME_MODE" = no-residue ] && [ "$GRIT_NORESIDUE_LEVEL" = aggressive ] && [ "$GRIT_RUNTIME_ALLOW_FALLBACK_ROOT" = yes ]; then
    printf '%s\n' "build-native: aggressive no-residue cannot use runtime fallback root; set GRIT_RUNTIME_ALLOW_FALLBACK_ROOT=no or use GRIT_NORESIDUE_LEVEL=best-effort" >&2
    exit 1
fi

# Validate transport+encryption combination
if [ "$GRIT_RSHELL_TRANSPORT" = builtin ] && [ "$GRIT_RSHELL_ENCRYPTION" = none ]; then
    printf '%s\n' "build-native: transport=builtin encryption=none is not implemented" >&2
    exit 1
fi
if [ "$GRIT_RSHELL_TRANSPORT" != none ] && [ "$GRIT_RSHELL_TRANSPORT" = builtin ] && [ "$GRIT_RSHELL_ENCRYPTION" = tls ] && [ "$GRIT_BUILTIN_TLS_ENABLE" != yes ]; then
    printf '%s\n' "build-native: transport=builtin encryption=tls requires GRIT_BUILTIN_TLS_ENABLE=yes (wolfSSL)" >&2
    exit 1
fi

if [ "$GRIT_BUILTIN_TLS_ENABLE" = yes ]; then
    _wolfssl_ok=0
    wolfssl_cflags=""
    wolfssl_libs=""
    _wolfssl_source=""

    if [ -n "${WOLFSSL_CFLAGS:-}" ] || [ -n "${WOLFSSL_LIBS:-}" ]; then
        wolfssl_cflags="${WOLFSSL_CFLAGS:-}"
        wolfssl_libs="${WOLFSSL_LIBS:--lwolfssl}"
        _wolfssl_source="env WOLFSSL_CFLAGS/WOLFSSL_LIBS"
    elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists wolfssl 2>/dev/null; then
        wolfssl_cflags=$(pkg-config --cflags wolfssl 2>/dev/null || true)
        wolfssl_libs=$(pkg-config --libs wolfssl 2>/dev/null || true)
        _wolfssl_source="pkg-config"
    else
        wolfssl_cflags=""
        wolfssl_libs="-lwolfssl"
        _wolfssl_source="-lwolfssl fallback (no pkg-config match)"
    fi

    _probe_dir=$(mktemp -d)
    printf '#include <wolfssl/options.h>\n#include <wolfssl/ssl.h>\nint main(void){wolfSSL_Init();wolfSSL_Cleanup();return 0;}\n' >"$_probe_dir/probe.c"
    _probe_err=$("$CC" $wolfssl_cflags -static "$_probe_dir/probe.c" -o "$_probe_dir/probe" $wolfssl_libs 2>&1) && _wolfssl_ok=1 || true
    if [ "$_wolfssl_ok" != 1 ]; then
        _probe_err_dynamic=$("$CC" $wolfssl_cflags "$_probe_dir/probe.c" -o "$_probe_dir/probe" $wolfssl_libs 2>&1) && _wolfssl_ok=1 || true
        if [ "$_wolfssl_ok" != 1 ] && [ -n "$_probe_err_dynamic" ]; then
            _probe_err="static probe: $_probe_err
dynamic probe: $_probe_err_dynamic"
        fi
    fi
    rm -rf "$_probe_dir"

    if [ "$_wolfssl_ok" = 1 ]; then
        CPPFLAGS="$CPPFLAGS -DHAVE_WOLFSSL ${wolfssl_cflags:+$wolfssl_cflags}"
        LDFLAGS="$LDFLAGS $wolfssl_libs"
        src="$src src/rshell_tls.c"
        printf '%s\n' "build-native: wolfSSL detected via $_wolfssl_source, builtin TLS enabled"
    else
        printf '%s\n' "build-native: GRIT_BUILTIN_TLS_ENABLE=yes but wolfSSL compile probe failed" >&2
        printf '%s\n' "  Detection attempted via: $_wolfssl_source" >&2
        if [ -n "$_probe_err" ]; then
            printf '%s\n' "  Probe error: $_probe_err" >&2
        fi
        if command -v pkg-config >/dev/null 2>&1; then
            if pkg-config --exists wolfssl 2>/dev/null; then
                printf '%s\n' "  pkg-config --exists wolfssl: yes" >&2
                printf '%s\n' "  pkg-config --cflags wolfssl: $(pkg-config --cflags wolfssl 2>&1)" >&2
                printf '%s\n' "  pkg-config --libs wolfssl: $(pkg-config --libs wolfssl 2>&1)" >&2
            else
                printf '%s\n' "  pkg-config --exists wolfssl: no" >&2
            fi
        else
            printf '%s\n' "  pkg-config: not in PATH" >&2
        fi
        if [ -f /usr/include/wolfssl/ssl.h ]; then
            printf '%s\n' "  /usr/include/wolfssl/ssl.h: found" >&2
        else
            printf '%s\n' "  /usr/include/wolfssl/ssl.h: not found" >&2
        fi
        printf '%s\n' "  To override: export WOLFSSL_CFLAGS=... WOLFSSL_LIBS=... before building" >&2
        printf '%s\n' "  Debian/Ubuntu: apt install libwolfssl-dev" >&2
        exit 1
    fi
fi

