#!/bin/sh
set -eu

out_dir=${1:-}
[ -n "$out_dir" ] || {
    printf '%s\n' "usage: repair-buildroot-host-tools OUT_DIR" >&2
    exit 2
}

case "$out_dir" in
    /*) out_abs=$out_dir ;;
    *) out_abs=$(CDPATH= cd -- "$out_dir" && pwd) ;;
esac

host_dir=$out_abs/host
fakeroot=$host_dir/bin/fakeroot

[ -f "$fakeroot" ] || exit 0

if ! grep '^FAKEROOT_PREFIX=' "$fakeroot" >/dev/null 2>&1; then
    exit 0
fi

current=$(sed -n 's/^FAKEROOT_PREFIX=//p' "$fakeroot" | sed -n '1p')
[ "$current" != "$host_dir" ] || exit 0

tmp=$fakeroot.tmp.$$
trap 'rm -f "$tmp"' EXIT HUP INT TERM

sed \
    -e "s|^FAKEROOT_PREFIX=.*|FAKEROOT_PREFIX=$host_dir|" \
    -e "s|^FAKEROOT_BINDIR=.*|FAKEROOT_BINDIR=$host_dir/bin|" \
    -e "s|^PATHS=.*|PATHS=$host_dir/lib:\${FAKEROOT_PREFIX}/lib64/libfakeroot:\${FAKEROOT_PREFIX}/lib32/libfakeroot|" \
    "$fakeroot" >"$tmp"
chmod 0755 "$tmp"
mv "$tmp" "$fakeroot"
trap - EXIT HUP INT TERM

printf '%s\n' "repair-buildroot-host-tools: updated host fakeroot paths in $fakeroot"
