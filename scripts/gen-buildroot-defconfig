#!/bin/sh
set -eu

config=${BUSIERBOX_CONFIG:-configs/busierbox.conf}
resolve_err=$(mktemp)
trap 'rm -f "$resolve_err"' EXIT HUP INT TERM

usage() {
    cat <<'EOF'
usage:
  scripts/gen-buildroot-defconfig --from-config [CONFIG]
  scripts/gen-buildroot-defconfig TARGET_NAME

Generates:
  buildroot/generated-configs/<target>_defconfig
  payloads/generated-profiles/<target>.mk
EOF
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --from-config)
        [ -n "${2:-}" ] && config=$2
        resolved=$(BUSIERBOX_CONFIG="$config" scripts/resolve-target --config)
        ;;
    "")
        resolved=$(scripts/resolve-target --config)
        ;;
    *)
        if ! resolved=$(scripts/resolve-target "$1" 2>"$resolve_err"); then
            active=$(scripts/resolve-target --config)
            eval "$active"
            if [ "${TARGET_NAME:-}" = "$1" ]; then
                resolved=$active
            else
                cat "$resolve_err" >&2
                exit 1
            fi
        fi
        ;;
esac

eval "$resolved"

BB_RSHELL_TRANSPORT=${BB_RSHELL_TRANSPORT:-${BB_RSHELL_MODE:-ssh}}
BB_BUILTIN_TLS_ENABLE=${BB_BUILTIN_TLS_ENABLE:-no}
BB_HEAVY_TOOLS=${BB_HEAVY_TOOLS:-}
BB_BUSYBOX_GROUPS=${BB_BUSYBOX_GROUPS:-shell fileops disk process network text system}
BB_BUSYBOX_APPLETS=${BB_BUSYBOX_APPLETS:-}
BB_BUSYBOX_APPLET_OVERRIDES=${BB_BUSYBOX_APPLET_OVERRIDES:-}
BB_DOTFILES_ENABLE=${BB_DOTFILES_ENABLE:-yes}
BB_DOTFILE_ZSH_MODE=${BB_DOTFILE_ZSH_MODE:-default}
BB_DOTFILE_ZSH_USER_FILE=${BB_DOTFILE_ZSH_USER_FILE:-}
BB_DOTFILE_BASH_MODE=${BB_DOTFILE_BASH_MODE:-default}
BB_DOTFILE_BASH_USER_FILE=${BB_DOTFILE_BASH_USER_FILE:-}
BB_DOTFILE_TMUX_MODE=${BB_DOTFILE_TMUX_MODE:-default}
BB_DOTFILE_TMUX_USER_FILE=${BB_DOTFILE_TMUX_USER_FILE:-}
BB_DOTFILE_GDB_MODE=${BB_DOTFILE_GDB_MODE:-default}
BB_DOTFILE_GDB_USER_FILE=${BB_DOTFILE_GDB_USER_FILE:-}
BB_DOTFILE_PROFILE_MODE=${BB_DOTFILE_PROFILE_MODE:-default}
BB_DOTFILE_PROFILE_USER_FILE=${BB_DOTFILE_PROFILE_USER_FILE:-}
if [ -f "$config" ]; then
    . "$config"
    [ -n "${BB_STATIC_POLICY:-}" ] && TARGET_STATIC_POLICY=$BB_STATIC_POLICY
    BB_RSHELL_TRANSPORT=${BB_RSHELL_TRANSPORT:-${BB_RSHELL_MODE:-ssh}}
    # Derive BB_BUILTIN_TLS_ENABLE from transport, consistent with menuconfig
    [ "$BB_RSHELL_TRANSPORT" = builtin ] && BB_BUILTIN_TLS_ENABLE=yes || BB_BUILTIN_TLS_ENABLE=no
    BB_HEAVY_TOOLS=${BB_HEAVY_TOOLS:-}
    BB_BUSYBOX_GROUPS=${BB_BUSYBOX_GROUPS:-shell fileops disk process network text system}
    BB_BUSYBOX_APPLETS=${BB_BUSYBOX_APPLETS:-}
    BB_BUSYBOX_APPLET_OVERRIDES=${BB_BUSYBOX_APPLET_OVERRIDES:-}
    BB_DOTFILES_ENABLE=${BB_DOTFILES_ENABLE:-yes}
    BB_DOTFILE_ZSH_MODE=${BB_DOTFILE_ZSH_MODE:-default}
    BB_DOTFILE_ZSH_USER_FILE=${BB_DOTFILE_ZSH_USER_FILE:-}
    BB_DOTFILE_BASH_MODE=${BB_DOTFILE_BASH_MODE:-default}
    BB_DOTFILE_BASH_USER_FILE=${BB_DOTFILE_BASH_USER_FILE:-}
    BB_DOTFILE_TMUX_MODE=${BB_DOTFILE_TMUX_MODE:-default}
    BB_DOTFILE_TMUX_USER_FILE=${BB_DOTFILE_TMUX_USER_FILE:-}
    BB_DOTFILE_GDB_MODE=${BB_DOTFILE_GDB_MODE:-default}
    BB_DOTFILE_GDB_USER_FILE=${BB_DOTFILE_GDB_USER_FILE:-}
    BB_DOTFILE_PROFILE_MODE=${BB_DOTFILE_PROFILE_MODE:-default}
    BB_DOTFILE_PROFILE_USER_FILE=${BB_DOTFILE_PROFILE_USER_FILE:-}
    BB_GDBSERVER_PROVIDER=${BB_GDBSERVER_PROVIDER:-auto}
    BB_GDBSERVER_USER_PATH=${BB_GDBSERVER_USER_PATH:-}
    BB_USER_OVERLAY_ENABLE=${BB_USER_OVERLAY_ENABLE:-no}
    BB_USER_OVERLAY_ROOT=${BB_USER_OVERLAY_ROOT:-}
    BB_USER_OVERLAY_ALLOW_OVERRIDE=${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}
fi
BB_GDBSERVER_PROVIDER=${BB_GDBSERVER_PROVIDER:-auto}
BB_GDBSERVER_USER_PATH=${BB_GDBSERVER_USER_PATH:-}
BB_USER_OVERLAY_ENABLE=${BB_USER_OVERLAY_ENABLE:-no}
BB_USER_OVERLAY_ROOT=${BB_USER_OVERLAY_ROOT:-}
BB_USER_OVERLAY_ALLOW_OVERRIDE=${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}

STRICT_HEAVY_TOOLS=${BB_STRICT_HEAVY_TOOLS:-${STRICT_HEAVY_TOOLS:-0}}

# Sets EXCLUSION_REASON and returns 1 if tool has a known build failure for
# the current tuple, returns 0 if expected to build fine.
check_tool_build_compat() {
    _ctbc_tool=$1
    EXCLUSION_REASON=
    case "$_ctbc_tool:${TARGET_ARCH:-}:${TARGET_LIBC:-}" in
        gdbserver:mipsel:musl|gdbserver:mips:musl)
            EXCLUSION_REASON="Buildroot GDB BFD fails for ${TARGET_ARCH}-${TARGET_LIBC}; gdbserver not buildable on this tuple"
            return 1
            ;;
        ltrace:*:musl)
            EXCLUSION_REASON="Buildroot ltrace depends on uClibc or glibc and is unavailable for musl"
            return 1
            ;;
    esac
    if [ "${TARGET_STATIC_POLICY:-static-preferred}" != dynamic ]; then
        case "$_ctbc_tool" in
            htop)
                EXCLUSION_REASON="Buildroot htop depends on dynamic libraries (!BR2_STATIC_LIBS)"
                return 1
                ;;
            ltrace)
                EXCLUSION_REASON="Buildroot ltrace depends on dynamic libraries (!BR2_STATIC_LIBS)"
                return 1
                ;;
            mosh-client)
                EXCLUSION_REASON="Buildroot mosh depends on dynamic libraries through protobuf (!BR2_STATIC_LIBS)"
                return 1
                ;;
        esac
    fi
    return 0
}

is_pre_excluded() {
    _needle=$1
    for _e in ${pre_excluded:-}; do
        [ "$_e" = "$_needle" ] && return 0
    done
    return 1
}

die() {
    printf '%s\n' "gen-buildroot-defconfig: $*" >&2
    exit 1
}

[ "$TARGET_ARCH" != native ] || die "native does not use a Buildroot defconfig"
[ "$TARGET_STATUS" = supported ] || die "target $TARGET_NAME is $TARGET_STATUS: $TARGET_NOTES"

case "$TARGET_ARCH:$TARGET_LIBC" in
    mipsel:musl|mipsel:uclibc|mips:musl|mips:uclibc|armv7:musl|armv7:uclibc|aarch64:musl|x86_64:musl|i386:musl) ;;
    *) die "unsupported generated tuple arch=$TARGET_ARCH libc=$TARGET_LIBC" ;;
esac

defconfig_dir=buildroot/generated-configs
profile_dir=payloads/generated-profiles
defconfig="$defconfig_dir/${TARGET_NAME}_defconfig"
profile="$profile_dir/${TARGET_NAME}.mk"
mkdir -p "$defconfig_dir" "$profile_dir"

libc_symbol=
case "$TARGET_LIBC" in
    musl) libc_symbol=BR2_TOOLCHAIN_BUILDROOT_MUSL ;;
    uclibc) libc_symbol=BR2_TOOLCHAIN_BUILDROOT_UCLIBC ;;
    *) die "unsupported libc $TARGET_LIBC" ;;
esac

static_symbol=BR2_STATIC_LIBS
if [ "$TARGET_STATIC_POLICY" = dynamic ]; then
    static_symbol=
fi

# Build pre-exclusion list for tools with known build failures (skipped unless strict mode).
# Tools handled by a non-Buildroot provider are not Buildroot-built and skip this check.
pre_excluded=
if [ "$STRICT_HEAVY_TOOLS" != "1" ]; then
    for tool in $BB_HEAVY_TOOLS; do
        if [ "$tool" = "gdbserver" ]; then
            case "$BB_GDBSERVER_PROVIDER" in
                user|local-dropin|overlay|none) continue ;;
            esac
        fi
        EXCLUSION_REASON=
        if ! check_tool_build_compat "$tool"; then
            pre_excluded="${pre_excluded:+$pre_excluded }$tool"
            printf '%s\n' "gen-buildroot-defconfig: $tool pre-excluded (best-effort; use STRICT_HEAVY_TOOLS=1 to force): $EXCLUSION_REASON" >&2
        fi
    done
fi

needs_cxx=0
for tool in $BB_HEAVY_TOOLS; do
    is_pre_excluded "$tool" && continue
    case "$tool" in
        gdbserver|mosh-client|ripgrep) needs_cxx=1 ;;
    esac
done

hostname=$(printf '%s' "busierbox-$TARGET_NAME" | tr -c 'A-Za-z0-9._-' '-')

{
    printf '%s\n' "# Generated by scripts/gen-buildroot-defconfig."
    printf '%s\n' "# Tuple: arch=$TARGET_ARCH cpu=$TARGET_CPU endian=$TARGET_ENDIAN abi=$TARGET_ABI libc=$TARGET_LIBC kernel_floor=$TARGET_KERNEL_FLOOR static_policy=$TARGET_STATIC_POLICY payload_tier=$TARGET_PAYLOAD_TIER"
    printf '%s\n' "# Kernel floor policy is advisory here; Buildroot olddefconfig resolves exact supported headers."
    case "$TARGET_ARCH" in
        mipsel)
            printf '%s\n' "BR2_mipsel=y"
            ;;
        mips)
            printf '%s\n' "BR2_mips=y"
            ;;
        armv7)
            printf '%s\n' "BR2_arm=y"
            case "$TARGET_CPU" in
                cortex-a7) printf '%s\n' "BR2_cortex_a7=y" ;;
                *) printf '%s\n' "BR2_cortex_a9=y" ;;
            esac
            case "$TARGET_ABI" in
                hardfloat|eabihf) printf '%s\n' "BR2_ARM_EABIHF=y" ;;
                *) printf '%s\n' "BR2_ARM_EABI=y" ;;
            esac
            ;;
        aarch64)
            printf '%s\n' "BR2_aarch64=y"
            ;;
        x86_64)
            printf '%s\n' "BR2_x86_64=y"
            ;;
        i386)
            printf '%s\n' "BR2_i386=y"
            ;;
        *)
            die "unsupported arch $TARGET_ARCH"
            ;;
    esac
    printf '%s=y\n' "$libc_symbol"
    if [ -n "$static_symbol" ]; then
        printf '%s=y\n' "$static_symbol"
    else
        printf '%s\n' "BR2_SHARED_LIBS=y"
    fi
    if [ "$needs_cxx" -eq 1 ]; then
        printf '%s\n' "BR2_TOOLCHAIN_BUILDROOT_CXX=y"
    else
        printf '%s\n' "BR2_TOOLCHAIN_BUILDROOT_CXX=n"
    fi
    printf '%s\n' "BR2_INIT_NONE=y"
    printf '%s\n' "BR2_SYSTEM_BIN_SH_BUSYBOX=y"
    printf '%s\n' "BR2_ROOTFS_DEVICE_CREATION_STATIC=y"
    printf '%s\n' "BR2_TARGET_GENERIC_HOSTNAME=\"$hostname\""
    printf '%s\n' "BR2_TARGET_GENERIC_ISSUE=\"BusierBox $TARGET_NAME payload\""
    printf '%s\n' "BR2_PACKAGE_BUSYBOX=y"
    _bbcfg=$(BB_BUSYBOX_GROUPS="${BB_BUSYBOX_GROUPS:-}" BB_BUSYBOX_APPLETS="${BB_BUSYBOX_APPLETS:-}" BB_BUSYBOX_APPLET_OVERRIDES="${BB_BUSYBOX_APPLET_OVERRIDES:-}" TARGET="$TARGET_NAME" TARGET_LIBC="$TARGET_LIBC" BUILDROOT_VERSION="${BUILDROOT_VERSION:-2026.02.2}" OUT_DIR="$(pwd)/$defconfig_dir" scripts/gen-buildroot-busybox-config 2>/dev/null) || _bbcfg=
    if [ -n "$_bbcfg" ] && [ -f "$_bbcfg" ]; then
        printf '%s\n' "BR2_PACKAGE_BUSYBOX_CONFIG=\"$_bbcfg\""
    else
        printf '%s\n' "BR2_PACKAGE_BUSYBOX_CONFIG=\"package/busybox/busybox.config\""
    fi
    for tool in $BB_HEAVY_TOOLS; do
        if [ "$tool" = "gdbserver" ]; then
            case "$BB_GDBSERVER_PROVIDER" in
                user|local-dropin|overlay|none)
                    printf '%s\n' "# gdbserver: provider=$BB_GDBSERVER_PROVIDER (not Buildroot), no BR2 symbol emitted"
                    continue
                    ;;
            esac
        fi
        if is_pre_excluded "$tool"; then
            EXCLUSION_REASON=
            check_tool_build_compat "$tool" || true
            printf '%s\n' "# $tool pre-excluded (best-effort): ${EXCLUSION_REASON:-known build failure for this tuple}"
            continue
        fi
        case "$tool" in
            strace) printf '%s\n' "BR2_PACKAGE_STRACE=y" ;;
            curl)
                printf '%s\n' "BR2_PACKAGE_LIBCURL=y"
                printf '%s\n' "BR2_PACKAGE_LIBCURL_CURL=y"
                printf '%s\n' "BR2_PACKAGE_LIBCURL_TLS_NONE=y"
                ;;
            dropbear)
                printf '%s\n' "BR2_PACKAGE_DROPBEAR=y"
                printf '%s\n' "BR2_PACKAGE_DROPBEAR_CLIENT=y"
                ;;
            bash) printf '%s\n' "BR2_PACKAGE_BASH=y" ;;
            zsh) printf '%s\n' "BR2_PACKAGE_ZSH=y" ;;
            tmux) printf '%s\n' "BR2_PACKAGE_TMUX=y" ;;
            gdbserver)
                printf '%s\n' "BR2_PACKAGE_GDB=y"
                printf '%s\n' "BR2_PACKAGE_GDB_SERVER=y"
                ;;
            socat)
                printf '%s\n' "BR2_PACKAGE_SOCAT=y"
                if [ "$BB_RSHELL_ENCRYPTION" = tls ] && [ "$TARGET_STATIC_POLICY" = dynamic ]; then
                    printf '%s\n' "BR2_PACKAGE_OPENSSL=y"
                    printf '%s\n' "BR2_PACKAGE_LIBOPENSSL=y"
                fi
                ;;
            tcpdump) printf '%s\n' "BR2_PACKAGE_TCPDUMP=y" ;;
            rsync) printf '%s\n' "BR2_PACKAGE_RSYNC=y" ;;
            mtr) printf '%s\n' "BR2_PACKAGE_MTR=y" ;;
            iperf3) printf '%s\n' "BR2_PACKAGE_IPERF3=y" ;;
            ethtool) printf '%s\n' "BR2_PACKAGE_ETHTOOL=y" ;;
            iw) printf '%s\n' "BR2_PACKAGE_IW=y" ;;
            minicom) printf '%s\n' "BR2_PACKAGE_MINICOM=y" ;;
            mosh-client) printf '%s\n' "BR2_PACKAGE_MOSH=y" ;;
            ripgrep) printf '%s\n' "BR2_PACKAGE_RIPGREP=y" ;;
            jq) printf '%s\n' "BR2_PACKAGE_JQ=y" ;;
            file) printf '%s\n' "BR2_PACKAGE_FILE=y" ;;
            htop) printf '%s\n' "BR2_PACKAGE_HTOP=y" ;;
            screen) printf '%s\n' "BR2_PACKAGE_SCREEN=y" ;;
            ltrace) printf '%s\n' "BR2_PACKAGE_LTRACE=y" ;;
            readelf|objdump)
                printf '%s\n' "BR2_PACKAGE_BINUTILS=y"
                printf '%s\n' "BR2_PACKAGE_BINUTILS_TARGET=y"
                ;;
            xxd)
                printf '%s\n' "# xxd is provided by the selected BusyBox applet set when staged"
                ;;
            usbutils) printf '%s\n' "BR2_PACKAGE_USBUTILS=y" ;;
            pciutils) printf '%s\n' "BR2_PACKAGE_PCIUTILS=y" ;;
            nmap)
                printf '%s\n' "BR2_PACKAGE_NMAP=y"
                printf '%s\n' "BR2_PACKAGE_NMAP_NMAP=y"
                ;;
            nmap-ncat)
                printf '%s\n' "BR2_PACKAGE_NMAP=y"
                printf '%s\n' "BR2_PACKAGE_NMAP_NCAT=y"
                ;;
            psmisc) printf '%s\n' "BR2_PACKAGE_PSMISC=y" ;;
            openssl) printf '%s\n' "BR2_PACKAGE_OPENSSL=y" ;;
            fd) printf '%s\n' "BR2_PACKAGE_FD=y" ;;
            zoxide) printf '%s\n' "BR2_PACKAGE_ZOXIDE=y" ;;
            mtd-utils)
                printf '%s\n' "BR2_PACKAGE_MTD=y"
                printf '%s\n' "BR2_PACKAGE_MTD_FLASH_ERASE=y"
                printf '%s\n' "BR2_PACKAGE_MTD_MTD_DEBUG=y"
                printf '%s\n' "BR2_PACKAGE_MTD_NANDDUMP=y"
                printf '%s\n' "BR2_PACKAGE_MTD_NANDWRITE=y"
                ;;
            ubi-utils)
                printf '%s\n' "BR2_PACKAGE_MTD=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIATTACH=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIDETACH=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBINFO=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIMKVOL=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIRMVOL=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIRSVOL=y"
                printf '%s\n' "BR2_PACKAGE_MTD_UBIUPDATEVOL=y"
                ;;
            i2c-tools) printf '%s\n' "BR2_PACKAGE_I2C_TOOLS=y" ;;
            spi-tools) printf '%s\n' "BR2_PACKAGE_SPI_TOOLS=y" ;;
            mmc-utils) printf '%s\n' "BR2_PACKAGE_MMC_UTILS=y" ;;
            e2fsprogs)
                printf '%s\n' "BR2_PACKAGE_E2FSPROGS=y"
                printf '%s\n' "BR2_PACKAGE_E2FSPROGS_DEBUGFS=y"
                ;;
            parted) printf '%s\n' "BR2_PACKAGE_PARTED=y" ;;
            doom) printf '%s\n' "BR2_PACKAGE_BUSIERBOX_DOOM_ASCII=y" ;;
            *) printf '%s\n' "# Unknown heavy tool requested: $tool" ;;
        esac
    done
    needs_terminfo=0
    for tool in $BB_HEAVY_TOOLS; do
        is_pre_excluded "$tool" && continue
        case "$tool" in
            tmux|zsh) needs_terminfo=1 ;;
        esac
    done
    if [ "$needs_terminfo" -eq 1 ]; then
        printf '%s\n' "BR2_PACKAGE_NCURSES=y"
        printf '%s\n' "BR2_PACKAGE_NCURSES_WCHAR=y"
        printf '%s\n' "BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO=\"t/tmux t/tmux-256color\""
    fi
    # wolfSSL: required by builtin transport; built in the cross sysroot so
    # package-target can auto-detect staging/usr/include and staging/usr/lib.
    if [ "$BB_BUILTIN_TLS_ENABLE" = yes ]; then
        printf '%s\n' "BR2_PACKAGE_WOLFSSL=y"
        printf '%s\n' "BR2_PACKAGE_WOLFSSL_OPENSSLEXTRA=y"
    fi
    printf '%s\n' "BR2_TARGET_ROOTFS_TAR=y"
} >"$defconfig"

{
    printf '%s\n' "# Generated by scripts/gen-buildroot-defconfig."
    printf '%s\n' "TARGET := $TARGET_NAME"
    printf '%s\n' "ARCH := $TARGET_ARCH"
    [ -n "$TARGET_ENDIAN" ] && [ "$TARGET_ENDIAN" != auto ] && printf '%s\n' "ENDIAN := $TARGET_ENDIAN"
    [ -n "$TARGET_CPU" ] && printf '%s\n' "CPU := $TARGET_CPU"
    [ -n "$TARGET_ABI" ] && printf '%s\n' "ABI := $TARGET_ABI"
    printf '%s\n' "LIBC := $TARGET_LIBC"
    printf '%s\n' "KERNEL_FLOOR := $TARGET_KERNEL_FLOOR"
    printf '%s\n' "STATIC_POLICY := $TARGET_STATIC_POLICY"
    printf '%s\n' "PAYLOAD_TIER := $TARGET_PAYLOAD_TIER"
    printf '%s\n' "REQUESTED_TOOLS := $BB_HEAVY_TOOLS"
    printf '%s\n' "EXCLUDED_TOOLS := $pre_excluded"
    for tool in ${pre_excluded:-}; do
        EXCLUSION_REASON=
        check_tool_build_compat "$tool" || true
        printf '%s\n' "EXCLUDED_REASON_${tool} := ${EXCLUSION_REASON:-known build failure for this tuple}"
    done
    printf '%s\n' "DOTFILES_ENABLE := ${BB_DOTFILES_ENABLE:-yes}"
    printf '%s\n' "DOTFILE_ZSH_MODE := ${BB_DOTFILE_ZSH_MODE:-default}"
    printf '%s\n' "DOTFILE_ZSH_USER_FILE := ${BB_DOTFILE_ZSH_USER_FILE:-}"
    printf '%s\n' "DOTFILE_BASH_MODE := ${BB_DOTFILE_BASH_MODE:-default}"
    printf '%s\n' "DOTFILE_BASH_USER_FILE := ${BB_DOTFILE_BASH_USER_FILE:-}"
    printf '%s\n' "DOTFILE_TMUX_MODE := ${BB_DOTFILE_TMUX_MODE:-default}"
    printf '%s\n' "DOTFILE_TMUX_USER_FILE := ${BB_DOTFILE_TMUX_USER_FILE:-}"
    printf '%s\n' "DOTFILE_GDB_MODE := ${BB_DOTFILE_GDB_MODE:-default}"
    printf '%s\n' "DOTFILE_GDB_USER_FILE := ${BB_DOTFILE_GDB_USER_FILE:-}"
    printf '%s\n' "DOTFILE_PROFILE_MODE := ${BB_DOTFILE_PROFILE_MODE:-default}"
    printf '%s\n' "DOTFILE_PROFILE_USER_FILE := ${BB_DOTFILE_PROFILE_USER_FILE:-}"
    printf '%s\n' "OPERATOR_DBCLIENT_IDENTITY_FILE := ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}"
    printf '%s\n' "OPERATOR_AUTHORIZED_KEY_FILE := ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-}"
    printf '%s\n' "BUSYBOX_GROUPS := $BB_BUSYBOX_GROUPS"
    printf '%s\n' "BUSYBOX_APPLETS := $BB_BUSYBOX_APPLETS"
    printf '%s\n' "BUSYBOX_APPLET_OVERRIDES := $BB_BUSYBOX_APPLET_OVERRIDES"
    printf '%s\n' "GDBSERVER_PROVIDER := $BB_GDBSERVER_PROVIDER"
    printf '%s\n' "GDBSERVER_USER_PATH := ${BB_GDBSERVER_USER_PATH:-}"
    printf '%s\n' "USER_OVERLAY_ENABLE := $BB_USER_OVERLAY_ENABLE"
    printf '%s\n' "USER_OVERLAY_ROOT := ${BB_USER_OVERLAY_ROOT:-}"
    printf '%s\n' "USER_OVERLAY_ALLOW_OVERRIDE := $BB_USER_OVERLAY_ALLOW_OVERRIDE"
    printf '%s\n' "BUILDROOT_DEFCONFIG := $defconfig"
    printf '%s\n' "QEMU_USER := $TARGET_QEMU_USER"
} >"$profile"

printf '%s\n' "TARGET_NAME=$TARGET_NAME"
printf '%s\n' "BUILDROOT_DEFCONFIG=$defconfig"
printf '%s\n' "PAYLOAD_PROFILE=$profile"
