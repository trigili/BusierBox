#!/usr/bin/env python3
"""Check whether a BusierBox source mirror is ready for offline use."""

import argparse
import hashlib
import json
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mirror", required=True)
    parser.add_argument("--manifest", default="manifests/sources.lock.json")
    parser.add_argument("--matrix")
    args = parser.parse_args()

    mirror = pathlib.Path(args.mirror)
    lock = ROOT / args.manifest
    with open(lock, "r", encoding="utf-8") as fh:
        data = json.load(fh)

    errors = []
    for src in data.get("sources", []):
        filename = pathlib.Path(src["filename"]).name
        candidates = [mirror / "sources" / filename, mirror / "buildroot-dl" / filename]
        if not any(path.exists() for path in candidates):
            errors.append(f"missing {filename}")
            continue
        for path in candidates:
            if path.exists() and sha256_file(path) != src["sha256"].lower():
                errors.append(f"sha256 mismatch {path}")

    if args.matrix:
        proc = subprocess.run(
            [str(ROOT / "scripts" / "build-matrix"), "--matrix", args.matrix, "--offline", "--mirror-dir", str(mirror), "--dry-run"],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if proc.returncode != 0:
            errors.append("build-matrix offline dry-run failed")

    if errors:
        for err in errors:
            print(f"offline-readiness: {err}", file=sys.stderr)
        raise SystemExit(1)
    print(f"offline-readiness ok: {mirror}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
