#!/usr/bin/env python3
"""Render a BusierBox integration summary as a compact report."""

import argparse
import json
import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
RUN_ROOT = ROOT / "local" / "integration-runs"


def latest_summary():
    summaries = sorted(RUN_ROOT.glob("*/summary.json"))
    if not summaries:
        raise SystemExit("integration-report: no local integration summaries found")
    return summaries[-1]


def load_summary(ref):
    path = latest_summary() if ref == "latest" else pathlib.Path(ref)
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    return path, data


def resolve_existing_path(summary_path, value):
    if not value:
        return None
    path = pathlib.Path(str(value))
    candidates = [path]
    if not path.is_absolute():
        candidates.append(summary_path.parent / path)
        candidates.append(ROOT / path)
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def event_log_ref(data):
    for key in ("event_log", "operator_event_log", "events_jsonl"):
        if data.get(key):
            return data.get(key)
    status = data.get("operator_status") or {}
    if isinstance(status, dict):
        return status.get("event_log")
    return None


def release_self_test_ref(data):
    for key in ("release_self_test_json", "release_self_test", "release_self_test_diagnostics"):
        value = data.get(key)
        if isinstance(value, str) and value:
            return value
        if isinstance(value, dict) and value.get("path"):
            return value.get("path")
    release = data.get("release") or {}
    if isinstance(release, dict):
        for key in ("self_test_json", "release_self_test_json"):
            if release.get(key):
                return release.get(key)
    return None


def load_event_summary(summary_path, data, limit=8):
    ref = event_log_ref(data)
    path = resolve_existing_path(summary_path, ref)
    if not path:
        return {}
    counts = {}
    services = {}
    levels = {}
    service_events = {}
    remotes = {}
    sessions = {}
    recent = []
    total = 0
    invalid_count = 0
    first_ts = ""
    latest_ts = ""
    with path.open("r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                invalid_count += 1
                continue
            if not isinstance(event, dict):
                invalid_count += 1
                continue
            total += 1
            event_name = str(event.get("event", "unknown") or "unknown")
            service = str(event.get("service", "unknown") or "unknown")
            level = str(event.get("level", "unknown") or "unknown")
            remote = str(event.get("remote", "") or "")
            session = str(event.get("session", "") or "")
            ts = str(event.get("ts", "") or "")
            counts[event_name] = counts.get(event_name, 0) + 1
            services[service] = services.get(service, 0) + 1
            levels[level] = levels.get(level, 0) + 1
            service_event = f"{service}:{event_name}"
            service_events[service_event] = service_events.get(service_event, 0) + 1
            if remote:
                remotes[remote] = remotes.get(remote, 0) + 1
            if session:
                sessions[session] = sessions.get(session, 0) + 1
            if ts and (not first_ts or ts < first_ts):
                first_ts = ts
            if ts and ts > latest_ts:
                latest_ts = ts
            recent.append({
                "ts": ts,
                "level": level,
                "service": service,
                "event": event_name,
                "session": session,
                "remote": remote,
                "details": event.get("details", {}),
            })
            if len(recent) > limit:
                recent = recent[-limit:]
    return {
        "path": str(path),
        "total_count": total,
        "invalid_count": invalid_count,
        "first_event_at": first_ts,
        "latest_event_at": latest_ts,
        "event_counts": counts,
        "service_counts": services,
        "level_counts": levels,
        "service_event_counts": service_events,
        "remote_counts": remotes,
        "session_counts": sessions,
        "recent": recent,
    }


def load_release_self_test_summary(summary_path, data):
    ref = release_self_test_ref(data)
    path = resolve_existing_path(summary_path, ref)
    if not path:
        return {}
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return {
            "path": str(path),
            "valid": False,
            "error": str(exc),
        }
    if not isinstance(raw, dict):
        return {
            "path": str(path),
            "valid": False,
            "error": "release self-test JSON is not an object",
        }
    summary = dict(raw)
    summary["path"] = str(path)
    summary["valid"] = True
    return summary


def report_document(path, data):
    doc = dict(data)
    events = load_event_summary(path, data)
    if events:
        doc["operator_events"] = events
    release_self_test = load_release_self_test_summary(path, data)
    if release_self_test:
        doc["release_self_test"] = release_self_test
    return doc


def case_reason(case):
    return case.get("reason") or case.get("error") or case.get("cleanup_error") or ""


def normalize_status(value):
    if value is True:
        return "pass"
    if value is False:
        return "fail"
    if value is None:
        return ""
    text = str(value).strip().lower()
    if text in ("ok", "success", "succeeded", "passed"):
        return "pass"
    if text in ("error", "failed"):
        return "fail"
    return text


def phase_status(case, phase):
    phases = case.get("phases") or {}
    value = phases.get(phase)
    if isinstance(value, dict):
        value = value.get("status") or value.get("result")
    if value is None:
        value = case.get(f"{phase}_status")
    return normalize_status(value) or "-"


def case_duration(case):
    for key in ("duration_sec", "duration", "elapsed_sec"):
        value = case.get(key)
        if isinstance(value, (int, float)):
            return f"{value:.3f}s"
    timing = case.get("timing") or {}
    value = timing.get("duration_sec")
    if isinstance(value, (int, float)):
        return f"{value:.3f}s"
    return ""


def case_counts(cases):
    counts = {"pass": 0, "fail": 0, "skip": 0}
    for case in cases:
        status = case.get("status", "fail")
        counts[status] = counts.get(status, 0) + 1
    return counts


def print_table(path, data):
    cases = data.get("cases") or []
    counts = data.get("counts") or case_counts(cases)
    failures = data.get("failure_reasons") or [
        {
            "case": case.get("case", ""),
            "status": case.get("status", ""),
            "reason": case_reason(case),
            "logs": case.get("logs") or case.get("case_dir") or data.get("log_dir", ""),
        }
        for case in cases
        if case_reason(case)
    ]
    print(f"summary={path}")
    print(f"status={data.get('status', '')}")
    print(f"host={data.get('host', '')}")
    print(f"log_dir={data.get('log_dir', '')}")
    print(f"counts=pass:{counts.get('pass', 0)} fail:{counts.get('fail', 0)} skip:{counts.get('skip', 0)}")
    events = load_event_summary(path, data)
    if events:
        counts_text = " ".join(
            f"{name}:{count}" for name, count in sorted(events.get("event_counts", {}).items())
        )
        level_text = " ".join(
            f"{name}:{count}" for name, count in sorted(events.get("level_counts", {}).items())
        )
        service_text = " ".join(
            f"{name}:{count}" for name, count in sorted(events.get("service_counts", {}).items())
        )
        service_event_text = " ".join(
            f"{name}:{count}" for name, count in sorted(events.get("service_event_counts", {}).items())
        )
        print(f"event_log={events.get('path', '')}")
        print(f"event_total={events.get('total_count', 0)} invalid={events.get('invalid_count', 0)} first={events.get('first_event_at', '')} latest={events.get('latest_event_at', '')}")
        print(f"event_counts={counts_text}")
        print(f"event_levels={level_text}")
        print(f"event_services={service_text}")
        print(f"event_service_events={service_event_text}")
        if events.get("recent"):
            print("recent_events:")
            for event in events["recent"]:
                print(f"  {event.get('ts', '')} {event.get('level', '')} {event.get('service', '')}:{event.get('event', '')}")
    release_self_test = load_release_self_test_summary(path, data)
    if release_self_test:
        print(f"release_self_test={release_self_test.get('path', '')}")
        if not release_self_test.get("valid", False):
            print(f"release_self_test_valid=no error={release_self_test.get('error', '')}")
        else:
            print(
                "release_self_test_status="
                f"{release_self_test.get('status', '')} "
                f"release={release_self_test.get('release_name', '')} "
                f"artifacts={release_self_test.get('checked_artifact_count', 0)} "
                f"tuples={release_self_test.get('release_tuple_count', 0)} "
                f"devices={release_self_test.get('release_device_count', 0)} "
                f"command_queue_enabled={release_self_test.get('command_queue_enabled_count', 0)} "
                f"command_queue_token_required={release_self_test.get('command_queue_token_required_count', 0)} "
                f"command_queue_token_configured={release_self_test.get('command_queue_token_configured_count', 0)} "
                f"command_queue_exec={release_self_test.get('command_queue_execution_supported_count', 0)} "
                f"command_queue_operator_exec={release_self_test.get('command_queue_operator_supplied_command_execution_count', 0)}"
            )
    if failures:
        print("failure_reasons:")
        for item in failures:
            print(f"  {item.get('case', '')}: {item.get('status', '')}: {item.get('reason', '')}")
    print("")
    print(
        f"{'Case':<24} {'Build':<8} {'Transfer':<8} {'Run':<8} "
        f"{'Validation':<10} {'Cleanup':<8} {'Status':<8} {'Duration':>10} "
        f"{'Artifact Size':>13} {'SHA256':<12} Log"
    )
    for case in cases:
        sha = case.get("artifact_sha256") or ""
        size = case.get("artifact_size") or case.get("size") or ""
        log_dir = case.get("case_dir") or case.get("log_dir") or data.get("log_dir", "")
        print(
            f"{case.get('case',''):<24} "
            f"{phase_status(case, 'build'):<8} "
            f"{phase_status(case, 'transfer'):<8} "
            f"{phase_status(case, 'run'):<8} "
            f"{phase_status(case, 'validation'):<10} "
            f"{phase_status(case, 'cleanup'):<8} "
            f"{case.get('status',''):<8} "
            f"{case_duration(case):>10} "
            f"{str(size):>13} {sha[:12]:<12} {log_dir}"
        )
        reason = case_reason(case)
        if reason:
            print(f"  reason: {reason}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("summary", nargs="?", default="latest", help="summary.json path or 'latest'")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    path, data = load_summary(args.summary)
    if args.json:
        print(json.dumps(report_document(path, data), indent=2, sort_keys=True))
    else:
        print_table(path, data)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
