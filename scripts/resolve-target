#!/bin/sh
set -eu

presets=${GRIT_PRESETS:-targets/presets.json}
local_preset_dirs=${GRIT_LOCAL_TARGET_PRESETS:-local/presets/targets:local/targets/presets}
config=${GRIT_CONFIG:-configs/grit.conf}
mode=target
target=

case "${1:-}" in
    --list)
        mode=list
        ;;
    --list-tree)
        mode=list_tree
        ;;
    --config|--custom)
        mode=config
        ;;
    --help|-h)
        cat <<'EOF'
usage:
  scripts/resolve-target --config
  scripts/resolve-target --list
  scripts/resolve-target --list-tree
  scripts/resolve-target PRESET_OR_TARGET

Prints shell assignments describing the active tuple target. Presets are
templates; the emitted TARGET_NAME is generated from tuple fields unless an
explicit target name override is configured.

The flat --list output is kept stable for scripts. --list-tree prints the
same presets grouped by display_path-style categories for humans.

Local single-preset JSON files are also discovered from
GRIT_LOCAL_TARGET_PRESETS, defaulting to:
  local/presets/targets:local/targets/presets
EOF
        exit 0
        ;;
    "")
        mode=config
        ;;
    *)
        target=$1
        ;;
esac

[ -f "$presets" ] || {
    printf '%s\n' "resolve-target: missing presets $presets" >&2
    exit 1
}

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "resolve-target: python3 is required for strict JSON parsing" >&2
    exit 1
fi

if [ "$mode" = config ]; then
    if [ -f "$config" ]; then
        . "$config"
    fi
    if [ "${GRIT_TARGET_PRESET:-}" = default ] || [ -z "${GRIT_TARGET_ARCH:-}" ]; then
        python3 - <<'PY'
import shlex

def emit(key, value):
    print(f"{key}={shlex.quote(str(value or ''))}")

emit("TARGET_NAME", "")
emit("TARGET_STATUS", "blank")
emit("TARGET_SOURCE", "config")
emit("TARGET_ARCH", "")
emit("TARGET_ENDIAN", "auto")
emit("TARGET_CPU", "generic")
emit("TARGET_ABI", "default")
emit("TARGET_LIBC", "")
emit("TARGET_KERNEL_FLOOR", "")
emit("TARGET_STATIC_POLICY", "static-preferred")
emit("TARGET_PAYLOAD_TIER", "core")
emit("TARGET_QEMU_USER", "")
emit("TARGET_PROFILE_FILE", "")
emit("TARGET_BUILDROOT_DEFCONFIG", "")
emit("TARGET_NOTES", "default is a blank target configuration; choose native or a concrete target before building.")
PY
        exit 0
    fi
    if [ -z "${GRIT_TARGET_ARCH:-}" ] && [ "${GRIT_ENABLE_CUSTOM_TARGET:-no}" = yes ]; then
        GRIT_TARGET_ARCH=${GRIT_CUSTOM_ARCH:-native}
        GRIT_TARGET_ENDIAN=${GRIT_CUSTOM_ENDIAN:-auto}
        GRIT_TARGET_ABI=${GRIT_CUSTOM_ABI:-default}
        GRIT_TARGET_LIBC=${GRIT_CUSTOM_LIBC:-host}
        GRIT_KERNEL_FLOOR=${GRIT_CUSTOM_KERNEL_FLOOR:-host}
    fi
    GRIT_TARGET_ARCH=${GRIT_TARGET_ARCH:-native}
    GRIT_TARGET_ENDIAN=${GRIT_TARGET_ENDIAN:-auto}
    GRIT_TARGET_CPU=${GRIT_TARGET_CPU:-generic}
    GRIT_TARGET_ABI=${GRIT_TARGET_ABI:-default}
    if [ "$GRIT_TARGET_ARCH" = native ]; then
        GRIT_TARGET_LIBC=${GRIT_TARGET_LIBC:-host}
        GRIT_KERNEL_FLOOR=${GRIT_KERNEL_FLOOR:-host}
    else
        GRIT_TARGET_LIBC=${GRIT_TARGET_LIBC:-}
        GRIT_KERNEL_FLOOR=${GRIT_KERNEL_FLOOR:-}
    fi
    GRIT_STATIC_POLICY=${GRIT_STATIC_POLICY:-static-preferred}
    GRIT_PAYLOAD_TIER=${GRIT_PAYLOAD_TIER:-core}
    GRIT_TARGET_NAME=${GRIT_TARGET_NAME:-}
    GRIT_TARGET_QEMU_USER=${GRIT_TARGET_QEMU_USER:-}

    python3 - "$GRIT_TARGET_ARCH" "$GRIT_TARGET_ENDIAN" "$GRIT_TARGET_CPU" "$GRIT_TARGET_ABI" "$GRIT_TARGET_LIBC" "$GRIT_KERNEL_FLOOR" "$GRIT_STATIC_POLICY" "$GRIT_PAYLOAD_TIER" "$GRIT_TARGET_NAME" "$GRIT_TARGET_QEMU_USER" <<'PY'
import shlex
import sys

arch, endian, cpu, abi, libc, kernel, static_policy, tier, override, qemu = sys.argv[1:]

def generated_name():
    if override:
        return override
    if arch == "native":
        return "native"
    name = f"{arch}-linux-{kernel}-{libc}"
    if abi and abi not in ("default", "hardfloat"):
        name = f"{name}-{abi}"
    return name

def default_qemu():
    if qemu:
        return qemu
    return {
        "native": "native",
        "mipsel": "qemu-mipsel-static",
        "mips": "qemu-mips-static",
        "armv7": "qemu-arm-static",
        "aarch64": "qemu-aarch64-static",
        "x86_64": "qemu-x86_64-static",
        "i386": "qemu-i386-static",
    }.get(arch, "")

supported = False
notes = ""
if arch == "native":
    supported = True
    notes = "native host tuple"
elif not libc or not kernel:
    missing = []
    if not libc:
        missing.append("libc")
    if not kernel:
        missing.append("kernel_floor")
    notes = "missing required tuple field(s): " + ", ".join(missing)
elif (arch, libc) in {
    ("mipsel", "musl"),
    ("mipsel", "uclibc"),
    ("mips", "musl"),
    ("mips", "uclibc"),
    ("armv7", "musl"),
    ("aarch64", "musl"),
    ("x86_64", "musl"),
    ("i386", "musl"),
}:
    supported = True
    notes = "Buildroot defconfig can be generated from tuple"
else:
    notes = f"unsupported generated tuple arch={arch} libc={libc}"

name = generated_name()

def emit(key, value):
    print(f"{key}={shlex.quote(str(value or ''))}")

emit("TARGET_NAME", name)
emit("TARGET_STATUS", "supported" if supported else "unsupported")
emit("TARGET_SOURCE", "config")
emit("TARGET_ARCH", arch)
emit("TARGET_ENDIAN", endian)
emit("TARGET_CPU", cpu)
emit("TARGET_ABI", abi)
emit("TARGET_LIBC", libc)
emit("TARGET_KERNEL_FLOOR", kernel)
emit("TARGET_STATIC_POLICY", static_policy)
emit("TARGET_PAYLOAD_TIER", tier)
emit("TARGET_QEMU_USER", default_qemu())
emit("TARGET_PROFILE_FILE", "" if arch == "native" else f"payloads/generated-profiles/{name}.mk")
emit("TARGET_BUILDROOT_DEFCONFIG", "" if arch == "native" else f"buildroot/generated-configs/{name}_defconfig")
emit("TARGET_NOTES", notes)
PY
    exit 0
fi

if [ "$mode" = list ]; then
    python3 - "$presets" "$local_preset_dirs" <<'PY'
import json
import pathlib
import sys

presets_path, local_dirs = sys.argv[1:]

def default_qemu(arch):
    return {
        "native": "native",
        "mipsel": "qemu-mipsel-static",
        "mips": "qemu-mips-static",
        "armv7": "qemu-arm-static",
        "aarch64": "qemu-aarch64-static",
        "x86_64": "qemu-x86_64-static",
        "i386": "qemu-i386-static",
    }.get(arch or "", "")

def normalize(item, source="builtin"):
    item = dict(item)
    if "preset_name" not in item and "name" in item:
        notes = item.get("notes", "")
        if isinstance(notes, list):
            notes = "; ".join(str(note) for note in notes if note)
        item = {
            **item,
            "preset_name": item.get("name"),
            "support_status": item.get("support_status", "supported"),
            "payload_tier": item.get("payload_tier", "core"),
            "qemu_user": item.get("qemu_user", default_qemu(item.get("arch"))),
            "notes": notes,
            "category": item.get("category", "local/generated"),
            "display_path": item.get("display_path", f"local/generated/{item.get('name', '')}"),
        }
    item["_source"] = source
    return item

def load_presets():
    with open(presets_path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    out = [normalize(item) for item in data.get("presets", [])]
    seen = {item.get("preset_name") for item in out}
    for dirname in [part for part in local_dirs.split(":") if part]:
        directory = pathlib.Path(dirname)
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.json")):
            try:
                item = normalize(json.load(open(path, "r", encoding="utf-8")), source=str(path))
            except Exception as exc:
                print(f"resolve-target: skipping invalid local preset {path}: {exc}", file=sys.stderr)
                continue
            name = item.get("preset_name")
            if name and name not in seen:
                out.append(item)
                seen.add(name)
    return out

for p in load_presets():
    print("\t".join([
        p.get("preset_name", ""),
        p.get("support_status", ""),
        p.get("description", ""),
    ]))
PY
    exit 0
fi

if [ "$mode" = list_tree ]; then
    python3 - "$presets" "$local_preset_dirs" <<'PY'
import json
import pathlib
import sys

presets_path, local_dirs = sys.argv[1:]

def default_qemu(arch):
    return {
        "native": "native",
        "mipsel": "qemu-mipsel-static",
        "mips": "qemu-mips-static",
        "armv7": "qemu-arm-static",
        "aarch64": "qemu-aarch64-static",
        "x86_64": "qemu-x86_64-static",
        "i386": "qemu-i386-static",
    }.get(arch or "", "")

def normalize(item):
    item = dict(item)
    if "preset_name" not in item and "name" in item:
        notes = item.get("notes", "")
        if isinstance(notes, list):
            notes = "; ".join(str(note) for note in notes if note)
        item = {
            **item,
            "preset_name": item.get("name"),
            "support_status": item.get("support_status", "supported"),
            "payload_tier": item.get("payload_tier", "core"),
            "qemu_user": item.get("qemu_user", default_qemu(item.get("arch"))),
            "notes": notes,
            "category": item.get("category", "local/generated"),
            "display_path": item.get("display_path", f"local/generated/{item.get('name', '')}"),
        }
    return item

def load_presets():
    with open(presets_path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    out = [normalize(item) for item in data.get("presets", [])]
    seen = {item.get("preset_name") for item in out}
    for dirname in [part for part in local_dirs.split(":") if part]:
        directory = pathlib.Path(dirname)
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.json")):
            try:
                item = normalize(json.load(open(path, "r", encoding="utf-8")))
            except Exception as exc:
                print(f"resolve-target: skipping invalid local preset {path}: {exc}", file=sys.stderr)
                continue
            name = item.get("preset_name")
            if name and name not in seen:
                out.append(item)
                seen.add(name)
    return out

current = None
for p in load_presets():
    category = p.get("category") or "uncategorized"
    if category != current:
        current = category
        print(f"[{category}]")
    name = p.get("preset_name", "")
    status = p.get("support_status", "")
    desc = p.get("description", "")
    print(f"  {name}\t{status}\t{desc}")
PY
    exit 0
fi

python3 - "$presets" "$local_preset_dirs" "$target" <<'PY'
import json
import pathlib
import shlex
import sys

presets, local_dirs, target = sys.argv[1:]

def default_qemu(arch):
    return {
        "native": "native",
        "mipsel": "qemu-mipsel-static",
        "mips": "qemu-mips-static",
        "armv7": "qemu-arm-static",
        "aarch64": "qemu-aarch64-static",
        "x86_64": "qemu-x86_64-static",
        "i386": "qemu-i386-static",
    }.get(arch or "", "")

def normalize(item, source="builtin"):
    item = dict(item)
    if "preset_name" not in item and "name" in item:
        notes = item.get("notes", "")
        if isinstance(notes, list):
            notes = "; ".join(str(note) for note in notes if note)
        item = {
            **item,
            "preset_name": item.get("name"),
            "support_status": item.get("support_status", "supported"),
            "payload_tier": item.get("payload_tier", "core"),
            "qemu_user": item.get("qemu_user", default_qemu(item.get("arch"))),
            "notes": notes,
            "category": item.get("category", "local/generated"),
            "display_path": item.get("display_path", f"local/generated/{item.get('name', '')}"),
        }
    item["_source"] = source
    return item

def load_presets():
    with open(presets, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    out = [normalize(item) for item in data.get("presets", [])]
    seen = {item.get("preset_name") for item in out}
    for dirname in [part for part in local_dirs.split(":") if part]:
        directory = pathlib.Path(dirname)
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.json")):
            try:
                item = normalize(json.load(open(path, "r", encoding="utf-8")), source=str(path))
            except Exception as exc:
                print(f"resolve-target: skipping invalid local preset {path}: {exc}", file=sys.stderr)
                continue
            name = item.get("preset_name")
            if name and name not in seen:
                out.append(item)
                seen.add(name)
    return out

preset = None
for item in load_presets():
    if item.get("preset_name") == target:
        preset = item
        break

def emit(key, value):
    print(f"{key}={shlex.quote(str(value or ''))}")

if preset is None:
    # Treat a stable target-looking name as an explicit generated target only
    # if it matches the current active tuple. This avoids silently inventing
    # tuple fields from lossy string parsing.
    print(f"resolve-target: unknown preset or active target {target}", file=sys.stderr)
    sys.exit(3)

arch = preset.get("arch", "")
abi = preset.get("abi", "default")
libc = preset.get("libc", "")
kernel = preset.get("kernel_floor", "")
name = preset.get("target_name") or ("native" if arch == "native" else f"{arch}-linux-{kernel}-{libc}")
if preset.get("support_status") == "blank" or not arch:
    name = preset.get("target_name", "")
if arch != "native" and abi not in ("", "default", "hardfloat") and not name.endswith(f"-{abi}"):
    name = f"{name}-{abi}"

emit("TARGET_NAME", name)
emit("TARGET_STATUS", preset.get("support_status", "unsupported"))
emit("TARGET_SOURCE", "preset")
emit("TARGET_ARCH", arch)
emit("TARGET_ENDIAN", preset.get("endian", "auto"))
emit("TARGET_CPU", preset.get("cpu", "generic"))
emit("TARGET_ABI", abi)
emit("TARGET_LIBC", libc)
emit("TARGET_KERNEL_FLOOR", kernel)
emit("TARGET_STATIC_POLICY", preset.get("static_policy", "static-preferred"))
emit("TARGET_PAYLOAD_TIER", preset.get("payload_tier", "core"))
emit("TARGET_QEMU_USER", preset.get("qemu_user", ""))
if preset.get("support_status") == "blank" or not arch:
    emit("TARGET_PROFILE_FILE", "")
    emit("TARGET_BUILDROOT_DEFCONFIG", "")
    emit("TARGET_NOTES", "default is a blank target configuration; choose native or a concrete target before building.")
else:
    emit("TARGET_PROFILE_FILE", "" if arch == "native" else f"payloads/generated-profiles/{name}.mk")
    emit("TARGET_BUILDROOT_DEFCONFIG", "" if arch == "native" else f"buildroot/generated-configs/{name}_defconfig")
    emit("TARGET_NOTES", preset.get("notes", ""))
PY
