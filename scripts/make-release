#!/usr/bin/env python3
"""Build or assemble BusierBox multi-artifact release bundles."""

import argparse
import datetime as dt
import hashlib
import io
import json
import os
import pathlib
import platform
import shutil
import subprocess
import sys
import tarfile
import textwrap

import busierbox_matrix as matrix


ROOT = pathlib.Path(__file__).resolve().parents[1]
SCHEMA_VERSION = 1
PAYLOAD_MAGIC = b"BBXPAYLOADv1"
PAYLOAD_TRAILER_SIZE = 512
CONFIG_MAGIC = b"BBXCONFIGv1"
CONFIG_TRAILER_SIZE = 4096
REVERSE_ACCESS_PROFILES = {
    "builtin": "builtin-core-shell",
    "builtin-core-shell": "builtin-core-shell",
    "socat": "socat-rescue",
    "socat-rescue": "socat-rescue",
    "ssh": "ssh-operator",
    "ssh-operator": "ssh-operator",
}


def die(msg, code=1):
    print(f"make-release: {msg}", file=sys.stderr)
    raise SystemExit(code)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def write_executable(path, text):
    path.write_text(textwrap.dedent(text).lstrip(), encoding="utf-8")
    path.chmod(0o755)


def csv_items(value):
    return matrix.csv_items(value)


def load_release_matrix(path):
    if not path:
        return {}
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def matrix_include_options(data):
    include = data.get("include") or {}
    return include if isinstance(include, dict) else {}


def matrix_list(args, data, key, fallback):
    cli = getattr(args, key.replace("_", "-"), None)
    if cli is None:
        cli = getattr(args, key, None)
    return csv_items(cli) or data.get(key) or data.get(key.replace("_", "s")) or fallback


def ordered_unique(items):
    out = []
    seen = set()
    for item in items:
        if item not in seen:
            out.append(item)
            seen.add(item)
    return out


def selected_reverse_access_profiles(args, data):
    return csv_items(args.reverse_access_profiles) or data.get("reverse_access_profiles") or []


def payloads_for_reverse_access_profiles(profiles):
    payloads = []
    unknown = []
    for profile in profiles:
        if profile == "all":
            payloads.extend(REVERSE_ACCESS_PROFILES.values())
        elif profile in REVERSE_ACCESS_PROFILES:
            payloads.append(REVERSE_ACCESS_PROFILES[profile])
        else:
            unknown.append(profile)
    if unknown:
        die("invalid reverse access profile(s): " + ", ".join(unknown))
    return ordered_unique(payloads)


def selected_jobs(args, data):
    targets = csv_items(args.targets) or data.get("targets") or ["native"]
    profiles = selected_reverse_access_profiles(args, data)
    profile_payloads = payloads_for_reverse_access_profiles(profiles)
    configured_payloads = csv_items(args.payload_presets) or data.get("payload_presets") or data.get("payloads")
    payloads = ordered_unique((configured_payloads or ["default"]) + profile_payloads)
    formats = csv_items(args.formats) or data.get("formats") or ["tgz"]
    runtime_modes = csv_items(args.runtime_modes) or data.get("runtime_modes") or [None]
    config_sources = [args.config] if args.config else data.get("configs") or [None]
    if targets == ["all"]:
        targets = matrix.list_targets()
    if payloads == ["all"]:
        payloads = matrix.list_payloads()

    jobs = []
    for target in targets:
        for payload in payloads:
            for fmt in formats:
                for runtime_mode in runtime_modes:
                    for config_source in config_sources:
                        config_label = pathlib.Path(config_source).stem if config_source else None
                        config_suffix = f"-{config_label}" if config_label else ""
                        name = f"{target}-{payload}{config_suffix}-{fmt}"
                        if runtime_mode:
                            name = f"{name}-{runtime_mode}"
                        jobs.append(
                            {
                                "name": name,
                                "target": target,
                                "payload": payload,
                                "format": fmt,
                                "runtime_mode": runtime_mode,
                                "config_source": config_source,
                                "reverse_access_profiles": profiles,
                                "variant": {},
                            }
                        )
    return jobs


def validate_selected_jobs(jobs):
    errors = []
    seen_payloads = set()
    seen_targets = set()
    seen_configs = set()
    resolved_targets = {}

    for job in jobs:
        payload = job["payload"]
        if payload not in seen_payloads:
            seen_payloads.add(payload)
            if not (matrix.PAYLOAD_PRESETS / f"{payload}.conf").exists():
                errors.append(f"missing payload preset {payload}")

        target = job["target"]
        if target not in seen_targets:
            seen_targets.add(target)
            try:
                resolved_targets[target] = matrix.resolve_target(target)
            except RuntimeError as exc:
                errors.append(f"unresolved target {target}: {exc}")

        config_source = job.get("config_source")
        if config_source and config_source not in seen_configs:
            seen_configs.add(config_source)
            if not pathlib.Path(config_source).is_file():
                errors.append(f"missing config {config_source}")

    seen_outputs = {}
    for job in jobs:
        resolved = resolved_targets.get(job["target"]) or {}
        resolved_target = resolved.get("TARGET_NAME") or job["target"]
        config_stem, artifact_stem = job_stems(job, resolved_target)
        for label, relpath in (
            ("config", f"configs/{config_stem}.conf"),
            ("artifact", f"bin/{artifact_stem}"),
            ("log", f"logs/{artifact_stem}.log"),
        ):
            other = seen_outputs.get(relpath)
            if other and other != job["name"]:
                errors.append(f"release {label} path collision: {relpath} from {other} and {job['name']}")
            else:
                seen_outputs[relpath] = job["name"]

    if errors:
        die("invalid release selection:\n  " + "\n  ".join(errors))


def config_label(job):
    source = job.get("config_source")
    return safe_stem(pathlib.Path(source).stem) if source else ""


def config_suffix(job):
    label = config_label(job)
    return f"-{label}" if label else ""


def safe_stem(value):
    return "".join(ch if ch.isalnum() or ch in "._-" else "-" for ch in value).strip("-") or "item"


def format_suffix(job):
    fmt = job.get("format") or "tgz"
    return "" if fmt == "tgz" else f"-{safe_stem(fmt)}"


def runtime_suffix(job):
    return f"-{safe_stem(job['runtime_mode'])}" if job.get("runtime_mode") else ""


def job_stems(job, resolved_target=None):
    resolved_target = resolved_target or job["target"]
    artifact_target = resolved_target if job["target"] in ("--config", "config") else job["target"]
    suffix = f"{config_suffix(job)}{format_suffix(job)}{runtime_suffix(job)}"
    config_stem = f"{safe_stem(job['target'])}-{safe_stem(job['payload'])}{suffix}"
    artifact_stem = f"busierbox-{safe_stem(artifact_target)}-{safe_stem(job['payload'])}{suffix}-full"
    return config_stem, artifact_stem


def tuple_value(value, fallback="unknown", lower=False):
    text = str(value or "").strip()
    if not text:
        text = fallback
    return text.lower() if lower else text


def tuple_component(value, fallback="unknown"):
    return safe_stem(tuple_value(value, fallback=fallback, lower=True).replace("/", "-"))


def tuple_discriminator(resolved):
    cpu = resolved.get("TARGET_CPU") or ""
    abi = resolved.get("TARGET_ABI") or ""
    if cpu and cpu not in {"generic", "host"}:
        return cpu
    if abi and abi not in {"default", "hardfloat"}:
        return abi
    return cpu or abi or "default"


def tuple_metadata(resolved):
    arch = tuple_value(resolved.get("TARGET_ARCH"), lower=True)
    libc = tuple_value(resolved.get("TARGET_LIBC"), lower=True)
    kernel = tuple_value(resolved.get("TARGET_KERNEL_FLOOR"), lower=True)
    cpu = tuple_value(resolved.get("TARGET_CPU"), fallback="")
    abi = tuple_value(resolved.get("TARGET_ABI"), fallback="")
    discriminator = tuple_discriminator({"TARGET_CPU": cpu, "TARGET_ABI": abi})
    components = {
        "arch": tuple_component(arch),
        "libc": tuple_component(libc),
        "kernel_floor": tuple_component(kernel),
        "discriminator": tuple_component(discriminator),
    }
    rel = "/".join([
        "by-tuple",
        components["arch"],
        components["libc"],
        components["kernel_floor"],
        components["discriminator"],
    ])
    return {
        "arch": arch,
        "libc": libc,
        "kernel_floor": kernel,
        "cpu": cpu,
        "abi": abi,
        "endian": tuple_value(resolved.get("TARGET_ENDIAN"), fallback=""),
        "static_policy": tuple_value(resolved.get("TARGET_STATIC_POLICY"), fallback=""),
        "payload_tier": tuple_value(resolved.get("TARGET_PAYLOAD_TIER"), fallback=""),
        "qemu_user": tuple_value(resolved.get("TARGET_QEMU_USER"), fallback=""),
        "discriminator": discriminator,
        "path_components": components,
        "path": rel,
    }


def validate_tuple_metadata(tuple_info, context="tuple"):
    required = ("arch", "libc", "kernel_floor", "discriminator")
    missing = [key for key in required if not tuple_info.get(key) or tuple_info.get(key) == "unknown"]
    if missing:
        die(f"{context}: incomplete tuple metadata: " + ", ".join(missing))
    components = tuple_info.get("path_components") or {}
    expected = "/".join([
        "by-tuple",
        components.get("arch") or tuple_component(tuple_info.get("arch")),
        components.get("libc") or tuple_component(tuple_info.get("libc")),
        components.get("kernel_floor") or tuple_component(tuple_info.get("kernel_floor")),
        components.get("discriminator") or tuple_component(tuple_info.get("discriminator")),
    ])
    if tuple_info.get("path") != expected:
        die(f"{context}: tuple path drift: {tuple_info.get('path')} != {expected}")


def path_to(from_dir, target):
    return os.path.relpath(target, start=from_dir)


def place_entry(src, dest, mode):
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() or dest.is_symlink():
        if dest.is_dir() and not dest.is_symlink():
            shutil.rmtree(dest)
        else:
            dest.unlink()
    if mode == "copy":
        shutil.copy2(src, dest)
    else:
        dest.symlink_to(path_to(dest.parent, src))


def target_aliases(job, resolved):
    aliases = []
    target = job.get("target") or ""
    resolved_target = resolved.get("TARGET_NAME") or ""
    for alias in (target, resolved_target):
        if alias and alias not in aliases:
            aliases.append(alias)
    if target.startswith("glinet-mt7621"):
        for alias in ("glinet-mt7621", "glinet-mt1300"):
            if alias not in aliases:
                aliases.append(alias)
    return aliases


def write_config(path, job, base_config=None):
    if base_config:
        text = pathlib.Path(base_config).read_text(encoding="utf-8").rstrip()
        lines = [
            text,
            "",
            "# generated by scripts/make-release",
            f"BB_TARGET_PRESET={matrix.shell_quote(job['target'])}",
            f"BB_PAYLOAD_PRESET={matrix.shell_quote(job['payload'])}",
            f"PAYLOAD_FORMAT={matrix.shell_quote(job['format'])}",
        ]
    else:
        matrix.write_config(path, job["target"], job["payload"], job["format"], job.get("variant"))
        lines = path.read_text(encoding="utf-8").rstrip().splitlines()
    if job.get("runtime_mode"):
        lines.append(f"BB_RUNTIME_MODE={matrix.shell_quote(job['runtime_mode'])}")
    path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def resolve_job(job, config, dry_run=False):
    try:
        return matrix.resolve_target(job["target"], config=config)
    except RuntimeError:
        if dry_run:
            return {"TARGET_NAME": job["target"], "TARGET_ARCH": "unknown", "TARGET_LIBC": "unknown"}
        raise


def run_capture(cmd, path, env=None, required=False):
    with open(path, "w", encoding="utf-8") as fh:
        proc = subprocess.run(
            cmd,
            cwd=ROOT,
            env=env,
            stdout=fh,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
        )
    if required and proc.returncode != 0:
        raise RuntimeError(f"{cmd[0]} failed, see {path}")
    return proc.returncode


def write_release_helpers(script_dir):
    write_executable(
        script_dir / "verify-checksums",
        r'''
        #!/bin/sh
        set -eu
        root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
        mode=original
        write=no
        case "${1:-}" in
            --configured) mode=configured; shift ;;
            --original) mode=original; shift ;;
            --write-configured) mode=configured; write=yes; shift ;;
            --help|-h)
                printf '%s\n' "usage: scripts/verify-checksums [--original|--configured|--write-configured]"
                exit 0
                ;;
        esac
        file="$root/SHA256SUMS.$mode"
        if [ "$write" = yes ]; then
            tmp="$file.tmp"
            : >"$tmp"
            (
                cd "$root"
                find . -type f \
                    ! -name 'SHA256SUMS' \
                    ! -name 'SHA256SUMS.original' \
                    ! -name 'SHA256SUMS.configured' \
                    ! -name 'SHA256SUMS.configured.tmp' \
                    ! -name '*.tar.gz' |
                LC_ALL=C sort |
                while IFS= read -r item; do
                    item=${item#./}
                    if command -v sha256sum >/dev/null 2>&1; then
                        sha256sum "$item"
                    else
                        shasum -a 256 "$item"
                    fi
                done
            ) >"$tmp"
            mv "$tmp" "$file"
            cp "$file" "$root/SHA256SUMS"
            printf '%s\n' "wrote $file"
            exit 0
        fi
        [ -f "$file" ] || {
            printf '%s\n' "verify-checksums: missing $file" >&2
            exit 1
        }
        (
            cd "$root"
            if command -v sha256sum >/dev/null 2>&1; then
                sha256sum -c "$file"
            else
                shasum -a 256 -c "$file"
            fi
        )
        ''',
    )
    write_executable(
        script_dir / "configure-artifact",
        r'''
        #!/bin/sh
        set -eu
        root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
        usage() {
            cat >&2 <<'EOF'
        usage:
          scripts/configure-artifact ARTIFACT --show
          scripts/configure-artifact ARTIFACT --clear
          scripts/configure-artifact ARTIFACT --import FILE [--obfuscation none|xor]
          scripts/configure-artifact ARTIFACT --export FILE
          scripts/configure-artifact ARTIFACT [options]

        options map to allowlisted trailer keys:
          --operator-host HOST
          --operator-user USER
          --ssh-port PORT
          --shell-port PORT
          --remote-forward-port PORT
          --target-bind-host HOST
          --transport ssh|builtin|socat
          --encryption tls|none
          --run-mode auto|foreground|background
          --session-policy single|reconnect|persistent
          --shell-provider auto|target-sh|payload-busybox-sh|payload-busybox-ash|payload-zsh|custom
          --zero-arg-mode help|rshell|command
          --zero-arg-log-mode none|quiet|status|verbose
          --runtime-mode extract|no-residue
          --noresidue-level best-effort|aggressive
          --obfuscation none|xor

        XOR is not encryption and must not be used for secrets.
        EOF
            exit 2
        }
        [ $# -ge 2 ] || usage
        artifact=$1
        shift
        obfuscation=none
        kv=
        while [ $# -gt 0 ]; do
            case "$1" in
                --show) exec "$root/scripts/artifact-config" show "$artifact" ;;
                --clear)
                    "$root/scripts/artifact-config" clear "$artifact"
                    "$root/scripts/verify-checksums" --write-configured >/dev/null
                    exit 0
                    ;;
                --export)
                    [ $# -ge 2 ] || usage
                    "$root/scripts/artifact-config" export "$artifact" >"$2"
                    exit 0
                    ;;
                --import)
                    [ $# -ge 2 ] || usage
                    import_file=$2
                    shift
                    ;;
                --obfuscation) [ $# -ge 2 ] || usage; obfuscation=$2; shift ;;
                --operator-host) [ $# -ge 2 ] || usage; kv="$kv BB_OPERATOR_SERVER_HOST=$2"; shift ;;
                --operator-user) [ $# -ge 2 ] || usage; kv="$kv BB_OPERATOR_SERVER_USER=$2"; shift ;;
                --ssh-port) [ $# -ge 2 ] || usage; kv="$kv BB_OPERATOR_SERVER_SSH_PORT=$2"; shift ;;
                --shell-port) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_SOCAT_PORT=$2"; shift ;;
                --remote-forward-port) [ $# -ge 2 ] || usage; kv="$kv BB_OPERATOR_REMOTE_FORWARD_PORT=$2"; shift ;;
                --target-bind-host) [ $# -ge 2 ] || usage; kv="$kv BB_OPERATOR_TARGET_BIND_HOST=$2"; shift ;;
                --transport) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_TRANSPORT=$2"; shift ;;
                --encryption) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_ENCRYPTION=$2"; shift ;;
                --run-mode) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_RUN_MODE=$2"; shift ;;
                --session-policy) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_SESSION_POLICY=$2"; shift ;;
                --shell-provider) [ $# -ge 2 ] || usage; kv="$kv BB_RSHELL_SHELL_PROVIDER=$2"; shift ;;
                --zero-arg-mode) [ $# -ge 2 ] || usage; kv="$kv BB_ZERO_ARG_MODE=$2"; shift ;;
                --zero-arg-log-mode) [ $# -ge 2 ] || usage; kv="$kv BB_ZERO_ARG_LOG_MODE=$2"; shift ;;
                --runtime-mode) [ $# -ge 2 ] || usage; kv="$kv BB_RUNTIME_MODE=$2"; shift ;;
                --noresidue-level) [ $# -ge 2 ] || usage; kv="$kv BB_NORESIDUE_LEVEL=$2"; shift ;;
                --help|-h) usage ;;
                *) printf '%s\n' "configure-artifact: unknown option $1" >&2; usage ;;
            esac
            shift
        done
        if [ "${import_file:-}" ]; then
            "$root/scripts/artifact-config" import --obfuscation "$obfuscation" "$artifact" "$import_file"
        else
            [ -n "$kv" ] || usage
            # shellcheck disable=SC2086
            "$root/scripts/artifact-config" set --obfuscation "$obfuscation" "$artifact" $kv
        fi
        "$root/scripts/verify-checksums" --write-configured >/dev/null
        ''',
    )
    write_executable(
        script_dir / "configure-all",
        r'''
        #!/bin/sh
        set -eu
        root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
        found=no
        for artifact in "$root"/bin/busierbox-*-full; do
            [ -e "$artifact" ] || continue
            found=yes
            "$root/scripts/configure-artifact" "$artifact" "$@"
        done
        [ "$found" = yes ] || {
            printf '%s\n' "configure-all: no artifacts under bin/" >&2
            exit 1
        }
        ''',
    )
    write_executable(
        script_dir / "release-index",
        r'''
        #!/usr/bin/env python3
        import json
        import pathlib
        import sys

        root = pathlib.Path(__file__).resolve().parents[1]

        def load(path, fallback):
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                return fallback

        def unique(items):
            out = []
            seen = set()
            for item in items:
                if item and item not in seen:
                    out.append(item)
                    seen.add(item)
            return out

        def build_index():
            release = load(root / "release.json", {})
            artifacts = []
            tools = {}
            presets = {}
            transports = {}
            for rec in release.get("artifacts", []):
                if rec.get("build_status") == "failed":
                    continue
                summary = rec.get("tuple_summary") or {}
                present_tools = unique((summary.get("busybox_applets") or []) + (summary.get("heavy_tools") or []))
                row = {
                    "artifact": rec.get("artifact"),
                    "tuple_path": rec.get("tuple_path"),
                    "tuple": rec.get("tuple") or {},
                    "tuple_artifact": rec.get("tuple_artifact"),
                    "payload_preset": rec.get("payload_preset"),
                    "runtime_mode": summary.get("runtime_mode") or rec.get("runtime_mode"),
                    "noresidue_level": summary.get("noresidue_level"),
                    "reverse_access": summary.get("reverse_access") or {},
                    "manifest": rec.get("manifest_path") or rec.get("payload_manifest_path"),
                    "payload_manifest": rec.get("payload_manifest_path"),
                    "tool_provider_status": summary.get("tool_provider_status") or {},
                    "doom_wads": summary.get("doom_wads") or [],
                    "config": rec.get("config"),
                    "sha256": rec.get("sha256"),
                    "size": rec.get("size"),
                    "tools": present_tools,
                    "trailer_support": rec.get("trailer_support"),
                    "compatibility": summary.get("compatibility") or {
                        "schema": 1,
                        "label": "exact",
                        "reasons": [f"tuple_path={rec.get('tuple_path') or ''}"],
                    },
                }
                artifacts.append(row)
                preset = row.get("payload_preset")
                if preset:
                    presets.setdefault(preset, []).append(row.get("artifact"))
                transport = (row.get("reverse_access") or {}).get("transport")
                if transport:
                    transports.setdefault(transport, []).append(row.get("artifact"))
                for tool in present_tools:
                    tools.setdefault(tool, []).append(row.get("artifact"))
            return {
                "schema": 1,
                "release_name": release.get("release_name"),
                "git_commit": release.get("git_commit"),
                "artifacts": artifacts,
                "tuples": release.get("layout", {}).get("tuples", {}),
                "devices": release.get("layout", {}).get("devices", {}),
                "payload_presets": {key: unique(value) for key, value in sorted(presets.items())},
                "tools_present": {key: unique(value) for key, value in sorted(tools.items())},
                "reverse_access": {key: unique(value) for key, value in sorted(transports.items())},
                "trailer_support": {
                    "helpers": [
                        "scripts/artifact-config",
                        "scripts/busierbox-server",
                        "scripts/configure-artifact",
                        "scripts/configure-all",
                        "scripts/verify-checksums",
                    ],
                    "note": "Trailer overrides cannot change target tuple or payload contents.",
                },
                "checksums": {
                    "original": "SHA256SUMS.original",
                    "configured": "SHA256SUMS.configured",
                },
            }

        if len(sys.argv) > 1 and sys.argv[1] in {"--help", "-h"}:
            print("usage: scripts/release-index [--write]")
            raise SystemExit(0)
        index = build_index()
        if len(sys.argv) > 1 and sys.argv[1] == "--write":
            (root / "release-index.json").write_text(json.dumps(index, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            print("wrote release-index.json")
        else:
            print(json.dumps(index, indent=2, sort_keys=True))
        ''',
    )
    write_executable(
        script_dir / "release-find",
        r'''
        #!/usr/bin/env python3
        import argparse
        import json
        import pathlib
        import sys

        root = pathlib.Path(__file__).resolve().parents[1]

        def load(path):
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                raise SystemExit(f"release-find: cannot read {path}: {exc}")

        def ensure_index():
            path = root / "release-index.json"
            if path.exists():
                return load(path)
            release = load(root / "release.json")
            return {
                "schema": 1,
                "artifacts": [
                    {
                        "artifact": rec.get("artifact"),
                        "tuple_path": rec.get("tuple_path"),
                        "tuple": rec.get("tuple") or {},
                        "tuple_artifact": rec.get("tuple_artifact"),
                        "payload_preset": rec.get("payload_preset"),
                        "runtime_mode": (rec.get("tuple_summary") or {}).get("runtime_mode") or rec.get("runtime_mode"),
                        "noresidue_level": (rec.get("tuple_summary") or {}).get("noresidue_level"),
                        "reverse_access": (rec.get("tuple_summary") or {}).get("reverse_access") or {},
                        "manifest": rec.get("manifest_path") or rec.get("payload_manifest_path"),
                        "payload_manifest": rec.get("payload_manifest_path"),
                        "tool_provider_status": (rec.get("tuple_summary") or {}).get("tool_provider_status") or {},
                        "doom_wads": (rec.get("tuple_summary") or {}).get("doom_wads") or [],
                        "tools": ((rec.get("tuple_summary") or {}).get("busybox_applets") or []) + ((rec.get("tuple_summary") or {}).get("heavy_tools") or []),
                        "compatibility": (rec.get("tuple_summary") or {}).get("compatibility") or {
                            "schema": 1,
                            "label": "exact",
                            "reasons": [f"tuple_path={rec.get('tuple_path') or ''}"],
                        },
                    }
                    for rec in release.get("artifacts", [])
                    if rec.get("build_status") != "failed"
                ],
                "devices": release.get("layout", {}).get("devices", {}),
            }

        def tuple_match(index, row, args):
            tuple_info = (
                (index.get("tuples", {}).get(row.get("tuple_path") or "", {}) or {}).get("tuple")
                or row.get("tuple")
                or {}
            )
            if args.arch and tuple_info.get("arch") != args.arch:
                return False
            if args.libc and tuple_info.get("libc") != args.libc:
                return False
            if args.kernel and tuple_info.get("kernel_floor") != args.kernel:
                return False
            return True

        def useful(value):
            if value in (None, "", "unknown", "auto"):
                return ""
            return str(value)

        def arch_norm(machine):
            machine = str(machine or "unknown").lower()
            table = {
                "mips": "mips",
                "mips64": "mips",
                "mipsel": "mipsel",
                "mips64el": "mipsel",
                "armv7l": "armv7",
                "armv6l": "armv7",
                "aarch64": "aarch64",
                "x86_64": "x86_64",
                "amd64": "x86_64",
                "i386": "i386",
                "i486": "i386",
                "i586": "i386",
                "i686": "i386",
            }
            return table.get(machine, machine or "")

        def kernel_floor(release):
            release = str(release or "")
            parts = release.split(".", 2)
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                major = int(parts[0])
                minor = int(parts[1])
                if major < 3:
                    return f"{major}.{minor}"
                if major == 3:
                    return "3.x"
                if major == 4:
                    return "4.x"
                return "current"
            return ""

        def kernel_rank(value):
            table = {"2.4": 24, "2.6": 26, "3.x": 30, "4.x": 40, "current": 90, "host": 100}
            return table.get(str(value or ""), 0)

        def boolish(value):
            if isinstance(value, bool):
                return value
            if isinstance(value, str):
                return value.lower() in {"1", "yes", "true", "ok", "pass", "basic-ok", "present"}
            return bool(value)

        def survey_facts(path):
            if not path:
                return {}
            data = load(pathlib.Path(path))
            recs = data.get("recommendations") or {}
            uname = data.get("uname") or {}
            facts = {
                "arch": useful(recs.get("target_arch_guess")) or arch_norm(data.get("arch") or uname.get("machine")),
                "endian": useful(recs.get("endian_guess")) or useful(data.get("endianness")),
                "libc": useful(recs.get("libc_guess")) or useful(data.get("libc")),
                "kernel_floor": useful(recs.get("kernel_floor_guess")) or kernel_floor(data.get("kernel") or uname.get("release")),
                "cpu": useful(recs.get("target_cpu_guess")),
                "abi": useful(recs.get("target_abi_guess")),
            }
            for name in ("dirs", "writable_dirs"):
                for entry in data.get(name) or []:
                    if isinstance(entry, dict) and entry.get("path") == "/tmp":
                        facts["tmp_noexec"] = boolish(entry.get("noexec"))
                        facts["tmp_writable"] = boolish(entry.get("writable"))
                    if isinstance(entry, dict) and boolish(entry.get("writable")):
                        try:
                            free_bytes = int(entry.get("free_bytes"))
                        except (TypeError, ValueError):
                            free_bytes = -1
                        if 0 <= free_bytes < 4 * 1024 * 1024:
                            facts["low_storage"] = True
                            facts["low_storage_free_bytes"] = free_bytes
            if boolish(recs.get("low_disk")):
                facts["low_storage"] = True
            if boolish(recs.get("noexec_tmp")):
                facts["tmp_noexec"] = True
            if recs.get("recommended_extract_dir") == "none":
                facts["payload_possible"] = False
            return {key: value for key, value in facts.items() if value not in (None, "")}

        def reality_facts(path):
            if not path:
                return {}
            data = load(pathlib.Path(path))
            facts = {}
            checks = data.get("checks") or []
            for check in checks:
                if not isinstance(check, dict):
                    continue
                name = check.get("name")
                ok = boolish(check.get("ok")) or check.get("status") == "pass"
                available = boolish(check.get("available")) if "available" in check else ok
                detected = boolish(check.get("detected")) if "detected" in check else ok
                detail = str(check.get("detail") or "").lower()
                if name == "tmp_noexec":
                    facts["tmp_noexec"] = detected
                elif name == "rootfs_read_only":
                    facts["rootfs_read_only"] = detected
                elif name == "runtime_root_executable" and not available:
                    facts["runtime_exec_blocked"] = True
                elif name == "extract_core_payload" and not available:
                    facts["payload_possible"] = False
                elif name == "procfs_partial":
                    facts["procfs_partial"] = detected if "detected" in check else not ok
                elif name == "temporary_file" and not available:
                    facts["runtime_write_blocked"] = True
                if "low storage" in detail:
                    facts["low_storage"] = True
            return facts

        def degrade(label, new_label):
            order = ["exact", "likely", "heuristic", "unsafe", "incompatible"]
            return new_label if order.index(new_label) > order.index(label) else label

        def score_candidate(index, row, args):
            tuple_info = (
                (index.get("tuples", {}).get(row.get("tuple_path") or "", {}) or {}).get("tuple")
                or row.get("tuple")
                or {}
            )
            facts = {}
            facts.update(survey_facts(args.survey_json))
            facts.update(reality_facts(args.reality_json))
            for key, value in (("arch", args.arch), ("libc", args.libc), ("kernel_floor", args.kernel), ("endian", args.endian), ("cpu", args.cpu), ("abi", args.abi)):
                if useful(value):
                    facts[key] = value

            label = "exact" if facts else ((row.get("compatibility") or {}).get("label") or "exact")
            reasons = []
            exact_factors = 0
            checked_factors = 0
            for key in ("arch", "endian", "libc", "cpu", "abi"):
                expected = useful(tuple_info.get(key))
                actual = useful(facts.get(key))
                if not expected or not actual or expected in {"auto", "host"} or actual in {"auto", "host"}:
                    if expected and not actual and key in {"arch", "endian", "libc"}:
                        label = degrade(label, "heuristic")
                        reasons.append(f"{key} unknown for target; artifact expects {expected}")
                    continue
                checked_factors += 1
                if actual == expected:
                    exact_factors += 1
                    reasons.append(f"{key} exact: {actual}")
                else:
                    label = degrade(label, "incompatible" if key in {"arch", "endian"} else "unsafe")
                    reasons.append(f"{key} mismatch: target {actual}, artifact {expected}")

            expected_kernel = useful(tuple_info.get("kernel_floor"))
            actual_kernel = useful(facts.get("kernel_floor"))
            if expected_kernel and actual_kernel and expected_kernel not in {"host"} and actual_kernel not in {"host"}:
                checked_factors += 1
                if kernel_rank(actual_kernel) >= kernel_rank(expected_kernel):
                    exact_factors += 1 if actual_kernel == expected_kernel else 0
                    reasons.append(f"kernel floor compatible: target {actual_kernel}, artifact {expected_kernel}")
                    if actual_kernel != expected_kernel:
                        label = degrade(label, "likely")
                else:
                    label = degrade(label, "incompatible")
                    reasons.append(f"kernel floor too old: target {actual_kernel}, artifact {expected_kernel}")
            elif expected_kernel and not actual_kernel:
                label = degrade(label, "heuristic")
                reasons.append(f"kernel floor unknown; artifact expects {expected_kernel}")

            if checked_factors and exact_factors < checked_factors and label == "exact":
                label = "likely"
            if facts.get("tmp_noexec"):
                label = degrade(label, "likely")
                reasons.append("/tmp noexec: avoid /tmp extraction")
            if facts.get("rootfs_read_only"):
                label = degrade(label, "likely")
                reasons.append("rootfs read-only: prefer runtime root or core-only modes")
            if facts.get("runtime_exec_blocked"):
                label = degrade(label, "unsafe")
                reasons.append("runtime root execution failed in reality-test")
            if facts.get("runtime_write_blocked"):
                label = degrade(label, "unsafe")
                reasons.append("runtime file creation failed in reality-test")
            if facts.get("payload_possible") is False:
                label = degrade(label, "unsafe")
                reasons.append("payload extraction was not proven possible")
            if facts.get("low_storage"):
                label = degrade(label, "likely")
                reasons.append("storage low: prefer core-only or smaller payload preset")
            if facts.get("procfs_partial"):
                label = degrade(label, "heuristic")
                reasons.append("procfs partial/broken: static survey evidence may be incomplete")
            if not reasons:
                reasons.append(f"artifact tuple baseline: {row.get('tuple_path') or 'unknown'}")
            return {"schema": 1, "label": label, "reasons": reasons, "facts": facts}

        def score_rank(label):
            return {"exact": 0, "likely": 1, "heuristic": 2, "unsafe": 3, "incompatible": 4}.get(label, 5)

        parser = argparse.ArgumentParser(description="Find BusierBox release artifacts by tuple, device, feature, tool, or preset.")
        parser.add_argument("--arch")
        parser.add_argument("--endian")
        parser.add_argument("--libc")
        parser.add_argument("--kernel")
        parser.add_argument("--cpu")
        parser.add_argument("--abi")
        parser.add_argument("--device")
        parser.add_argument("--feature")
        parser.add_argument("--tool")
        parser.add_argument("--payload-preset")
        parser.add_argument("--doom-wad", help="match artifacts that stage a Doom WAD with this basename")
        parser.add_argument("--doom-wad-sha256", help="match artifacts that stage a Doom WAD with this SHA-256")
        parser.add_argument("--survey-json", help="score candidates against survey --json output")
        parser.add_argument("--reality-json", help="score candidates against reality-test --json output")
        parser.add_argument("--max-compatibility", choices=("exact", "likely", "heuristic", "unsafe", "incompatible"),
                            help="exclude artifacts riskier than this compatibility label")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args()

        index = ensure_index()
        candidates = list(index.get("artifacts") or [])
        if args.device:
            device = index.get("devices", {}).get(args.device)
            if not device:
                raise SystemExit(f"release-find: unknown device alias {args.device}")
            candidates = [row for row in candidates if row.get("tuple_path") == device.get("tuple_path")]
        if args.payload_preset:
            candidates = [row for row in candidates if row.get("payload_preset") == args.payload_preset]
        if args.tool:
            candidates = [row for row in candidates if args.tool in (row.get("tools") or [])]
        if args.doom_wad:
            candidates = [
                row for row in candidates
                if any(isinstance(wad, dict) and wad.get("filename") == args.doom_wad for wad in (row.get("doom_wads") or []))
            ]
        if args.doom_wad_sha256:
            candidates = [
                row for row in candidates
                if any(isinstance(wad, dict) and wad.get("sha256") == args.doom_wad_sha256 for wad in (row.get("doom_wads") or []))
            ]
        if args.feature:
            candidates = [
                row for row in candidates
                if args.feature in (row.get("tools") or [])
                or args.feature == (row.get("reverse_access") or {}).get("transport")
                or args.feature == row.get("payload_preset")
            ]
        candidates = [row for row in candidates if tuple_match(index, row, args)]
        if not candidates:
            raise SystemExit("release-find: no matching artifact")
        for candidate in candidates:
            candidate["compatibility"] = score_candidate(index, candidate, args)
        scored_count = len(candidates)
        if args.max_compatibility:
            max_rank = score_rank(args.max_compatibility)
            candidates = [
                row for row in candidates
                if score_rank((row.get("compatibility") or {}).get("label")) <= max_rank
            ]
        if not candidates:
            raise SystemExit("release-find: no matching artifact within compatibility threshold")
        candidates.sort(key=lambda item: (score_rank((item.get("compatibility") or {}).get("label")), item.get("payload_preset") or "", item.get("artifact") or ""))
        row = candidates[0]
        selection = {
            "schema": 1,
            "selected_artifact": row.get("tuple_artifact") or row.get("artifact") or "",
            "candidate_count": scored_count,
            "eligible_count": len(candidates),
            "filtered_out_by_threshold_count": scored_count - len(candidates),
            "max_compatibility": args.max_compatibility or "",
            "policy": [
                "filter by requested device/tuple/tool/feature/payload preset",
                "score with survey/reality facts when provided",
                "exclude artifacts riskier than max compatibility when set",
                "prefer lower-risk compatibility labels",
                "tie-break by payload preset then artifact path",
            ],
            "filters": {
                "arch": args.arch or "",
                "endian": args.endian or "",
                "libc": args.libc or "",
                "kernel": args.kernel or "",
                "cpu": args.cpu or "",
                "abi": args.abi or "",
                "device": args.device or "",
                "feature": args.feature or "",
                "tool": args.tool or "",
                "payload_preset": args.payload_preset or "",
                "doom_wad": args.doom_wad or "",
                "doom_wad_sha256": args.doom_wad_sha256 or "",
                "survey_json": args.survey_json or "",
                "reality_json": args.reality_json or "",
                "max_compatibility": args.max_compatibility or "",
            },
        }
        row["selection"] = selection
        if args.json:
            print(json.dumps(row, indent=2, sort_keys=True))
            raise SystemExit(0)
        artifact = row.get("tuple_artifact") or row.get("artifact")
        print(f"recommended_artifact={artifact}")
        print(f"candidate_count={selection['candidate_count']}")
        print(f"eligible_count={selection['eligible_count']}")
        print(f"filtered_out_by_threshold_count={selection['filtered_out_by_threshold_count']}")
        print(f"selection_policy={'; '.join(selection['policy'])}")
        print(f"tuple_path={row.get('tuple_path')}")
        print(f"payload_preset={row.get('payload_preset')}")
        print(f"runtime_mode={row.get('runtime_mode') or ''}")
        print(f"noresidue_level={row.get('noresidue_level') or ''}")
        print(f"reverse_access_default={(row.get('reverse_access') or {}).get('transport') or ''}")
        print(f"compatibility={(row.get('compatibility') or {}).get('label') or ''}")
        for reason in (row.get("compatibility") or {}).get("reasons") or []:
            print(f"compatibility_reason={reason}")
        for wad in row.get("doom_wads") or []:
            if isinstance(wad, dict) and wad.get("filename"):
                print(f"doom_wad={wad.get('filename')} size={wad.get('size', '')} sha256={wad.get('sha256', '')}")
        print(f"manifest={row.get('manifest') or ''}")
        print(f"first_command=./{pathlib.Path(artifact).name} survey --json")
        ''',
    )
    write_executable(
        script_dir / "release-self-test",
        r'''
        #!/usr/bin/env python3
        import json
        import os
        import pathlib
        import shutil
        import subprocess
        import sys
        import tempfile

        root = pathlib.Path(__file__).resolve().parents[1]

        def fail(msg):
            print(f"release-self-test: {msg}", file=sys.stderr)
            raise SystemExit(1)

        def load_json(path):
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                fail(f"invalid JSON {path}: {exc}")

        def tuple_path_for(info):
            components = info.get("path_components") or {}
            arch = components.get("arch") or str(info.get("arch") or "unknown").strip().lower().replace("/", "-")
            libc = components.get("libc") or str(info.get("libc") or "unknown").strip().lower().replace("/", "-")
            kernel = components.get("kernel_floor") or str(info.get("kernel_floor") or "unknown").strip().lower().replace("/", "-")
            discr = components.get("discriminator") or str(info.get("discriminator") or "unknown").strip().lower().replace("/", "-")
            return f"by-tuple/{arch}/{libc}/{kernel}/{discr}"

        def validate_tuple(info, context):
            for key in ("arch", "libc", "kernel_floor", "discriminator"):
                if not info.get(key) or info.get(key) == "unknown":
                    fail(f"{context}: incomplete tuple field {key}")
            if info.get("path") != tuple_path_for(info):
                fail(f"{context}: tuple path drift {info.get('path')} != {tuple_path_for(info)}")

        def run(cmd, required=True):
            proc = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)
            if required and proc.returncode != 0:
                fail(f"{' '.join(map(str, cmd))} failed:\n{proc.stdout}")
            return proc

        release = load_json(root / "release.json")
        run([str(root / "scripts" / "verify-checksums"), "--original"])
        for helper in ("artifact-config", "busierbox-server", "configure-artifact", "configure-all", "verify-checksums", "release-index", "release-find"):
            path = root / "scripts" / helper
            if not os.access(path, os.X_OK):
                fail(f"helper is not executable: scripts/{helper}")
        if not (root / "release-index.json").exists():
            run([str(root / "scripts" / "release-index"), "--write"])
        index = load_json(root / "release-index.json")
        layout_tuples = release.get("layout", {}).get("tuples") or {}
        index_tuples = index.get("tuples") or {}
        if sorted(index_tuples) != sorted(layout_tuples):
            fail("release-index tuple keys differ from release layout")
        for path in root.glob("by-tuple/**/MANIFEST.json"):
            load_json(path)
        for rec in release.get("artifacts", []):
            if rec.get("build_status") == "failed":
                continue
            validate_tuple(rec.get("tuple") or {}, rec.get("artifact") or "artifact")
            for key in ("artifact", "config"):
                rel = rec.get(key)
                if rel and not (root / rel).exists():
                    fail(f"missing {key}: {rel}")
            for key in ("manifest_path", "payload_manifest_path", "config_info_path"):
                rel = rec.get(key)
                if rel and not (root / rel).exists():
                    fail(f"missing manifest sidecar: {rel}")
            artifact = root / rec["artifact"]
            run([str(root / "scripts" / "artifact-config"), "show", str(artifact)])
            if rec.get("tuple_path") and not (root / rec["tuple_path"]).is_dir():
                fail(f"missing tuple dir: {rec['tuple_path']}")
            if rec.get("tuple_path") != (rec.get("tuple") or {}).get("path"):
                fail(f"artifact tuple_path disagrees with tuple metadata: {rec.get('artifact')}")
            if rec.get("tuple_artifact") and not (root / rec["tuple_artifact"]).exists():
                fail(f"missing tuple artifact: {rec['tuple_artifact']}")
            if rec.get("tuple", {}).get("arch") == "native" and os.access(artifact, os.X_OK):
                run([str(artifact), "manifest", "--json"])
            with tempfile.TemporaryDirectory(prefix=".self-test-", dir=root) as tmp:
                test_artifact = pathlib.Path(tmp) / artifact.name
                shutil.copy2(artifact, test_artifact)
                run([str(root / "scripts" / "artifact-config"), "set", str(test_artifact), "BB_ZERO_ARG_LOG_MODE=quiet"])
                run([str(root / "scripts" / "artifact-config"), "clear", str(test_artifact)])
        for alias, item in (release.get("layout", {}).get("devices") or {}).items():
            dev = root / item.get("path", "")
            if not dev.is_dir():
                fail(f"missing device alias dir: {alias}")
            target = root / item.get("tuple_path", "")
            if not target.is_dir():
                fail(f"device alias {alias} points at missing tuple {item.get('tuple_path')}")
            artifacts = dev / "artifacts"
            if not artifacts.exists():
                fail(f"device alias {alias} lacks artifacts pointer")
        for path in root.rglob("*"):
            if path.is_symlink() and not path.exists():
                fail(f"broken symlink: {path.relative_to(root)}")
        print("release-self-test ok")
        ''',
    )


def copy_bundle_support(release_dir, include_sources_manifest=False):
    script_dir = release_dir / "scripts"
    doc_dir = release_dir / "docs"
    config_dir = release_dir / "config-examples"
    manifest_dir = release_dir / "manifests"
    script_dir.mkdir(parents=True, exist_ok=True)
    doc_dir.mkdir(parents=True, exist_ok=True)
    config_dir.mkdir(parents=True, exist_ok=True)
    manifest_dir.mkdir(parents=True, exist_ok=True)
    for name in ("LICENSE", "NOTICE"):
        src = ROOT / name
        if src.exists():
            shutil.copy2(src, release_dir / name)
    shutil.copy2(ROOT / "scripts" / "artifact-config", script_dir / "artifact-config")
    (script_dir / "artifact-config").chmod(0o755)
    shutil.copy2(ROOT / "scripts" / "busierbox-server", script_dir / "busierbox-server")
    (script_dir / "busierbox-server").chmod(0o755)
    write_release_helpers(script_dir)
    for name in ("busierbox.conf.example", "native-linux.example"):
        src = ROOT / "configs" / name
        if src.exists():
            shutil.copy2(src, config_dir / name)
    for name in (
        "artifact-runtime-overrides.md",
        "cleanup-ledger.md",
        "command-queue.md",
        "gdbserver-workflow.md",
        "licensing.md",
        "manifest.md",
        "recovery.md",
        "survey-and-bringup.md",
    ):
        src = ROOT / "docs" / name
        if src.exists():
            shutil.copy2(src, doc_dir / name)
    trailer_doc = ROOT / "docs" / "artifact-runtime-overrides.md"
    if trailer_doc.exists():
        shutil.copy2(trailer_doc, doc_dir / "trailer-overrides.md")
    src_doc = ROOT / "docs" / "release-bundles.md"
    if src_doc.exists():
        shutil.copy2(src_doc, doc_dir / "README-release.md")
    license_policy = ROOT / "manifests" / "license-policy.json"
    if license_policy.exists():
        shutil.copy2(license_policy, manifest_dir / "license-policy.json")
    if include_sources_manifest and (ROOT / "manifests" / "sources.lock.json").exists():
        sources_lock = ROOT / "manifests" / "sources.lock.json"
        shutil.copy2(sources_lock, release_dir / "sources.lock.json")
        shutil.copy2(sources_lock, manifest_dir / "sources.lock.json")


def write_release_quickstart(path, name):
    path.write_text(
        textwrap.dedent(
            f"""
            BusierBox Release Quickstart: {name}
            ======================================

            1. Verify the bundle before touching artifacts:

               scripts/verify-checksums --original
               scripts/release-self-test

            2. Choose an artifact:

               scripts/release-find --device glinet-mt1300
               scripts/release-find --payload-preset survey-core

               Device aliases live under devices/<alias>/ and canonical tuples live
               under by-tuple/<arch>/<libc>/<kernel-floor>/<cpu-or-abi>/.

            3. Configure operator settings with trailer overrides:

               scripts/configure-artifact bin/busierbox-...-full \\
                 --operator-host 192.168.8.241 \\
                 --transport builtin \\
                 --shell-port 22203

               scripts/configure-all --operator-host 192.168.8.241 --transport builtin
               scripts/verify-checksums --configured

               Trailer edits cannot change target tuple compatibility, payload
               contents, dotfiles, overlays, or compiled features. XOR obfuscation
               is not encryption.

            4. First contact on the target:

               chmod +x ./busierbox
               ./busierbox survey --json
               ./busierbox manifest --json
               ./busierbox doctor
               ./busierbox plan extract

            5. Start an operator listener only when reverse access is intended:

               scripts/busierbox-server --transport tls-shell --shell-port 22203
               scripts/busierbox-server --transport ssh --ssh-port 22202
               scripts/busierbox-server --file-service --file-port 22204

               ./busierbox put /tmp/evidence.txt
               ./busierbox survey push
               ./busierbox reality-test push
               ./busierbox manifest push
               ./busierbox config-push
               ./busierbox evidence push

               The bundled server catches target-initiated reverse access and
               receive-only file uploads. It is not an artifact sender, target
               command executor, or callback RPC server.

            6. Cleanup and recovery checks:

               ./busierbox cleanup-ledger --json
               ./busierbox clean --dry-run
               ./busierbox persistence --survey
               ./busierbox persistence --plan

            7. Evidence and logs:

               Keep target survey, manifest, doctor, and cleanup-ledger JSON with
               the bundle's release.json and release-index.json. Receive-only file
               uploads store under local/sessions/<timestamp>-file-service/files/
               with per-file metadata JSON.
            """
        ).lstrip(),
        encoding="utf-8",
    )


def write_release_readme(path, name):
    path.write_text(
        textwrap.dedent(
            f"""
            # BusierBox Release Bundle: {name}

            Artifacts are under `bin/`. They are built with conservative defaults; post-build
            trailer overrides can adjust selected runtime/operator settings without changing
            target compatibility, payload contents, dotfiles, overlays, or compiled features.

            Common commands:

            ```sh
            scripts/verify-checksums --original
            scripts/release-self-test
            scripts/release-find --device glinet-mt1300
            scripts/configure-artifact bin/busierbox-...-full --operator-host 192.168.8.241 --transport builtin --shell-port 22203
            scripts/configure-all --operator-host 192.168.8.241 --transport builtin --shell-port 22203
            scripts/verify-checksums --configured
            ```

            Start with `devices/<alias>/` when you know the device exemplar, or
            `by-tuple/<arch>/<libc>/<kernel-floor>/<cpu-or-abi>/` when you know
            the compatibility tuple. The flat `bin/`, `configs/`, and
            `manifests/` directories remain stable script-facing paths.

            XOR trailer obfuscation is not encryption and must not be used for secrets or
            private keys. Network autorun and external writes are not enabled by this bundle
            tooling by default.
            """
        ).lstrip(),
        encoding="utf-8",
    )


def checksum_manifest(release_dir, name):
    lines = []
    for path in sorted(release_dir.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(release_dir).as_posix()
        if rel in {"SHA256SUMS", "SHA256SUMS.original", "SHA256SUMS.configured"}:
            continue
        if rel.endswith(".tar.gz"):
            continue
        lines.append(f"{sha256_file(path)}  {rel}\n")
    out = release_dir / name
    out.write_text("".join(lines), encoding="utf-8")
    return out


def make_tarball(release_dir):
    tar_path = release_dir.with_suffix(".tar.gz")
    with tarfile.open(tar_path, "w:gz") as tf:
        tf.add(release_dir, arcname=release_dir.name)
    return tar_path


def safe_build_host_metadata():
    return {
        "system": platform.system(),
        "machine": platform.machine(),
        "python_version": platform.python_version(),
    }


def source_lock_metadata():
    path = ROOT / "manifests" / "sources.lock.json"
    if not path.exists():
        return {"present": False}
    info = {
        "present": True,
        "path": "manifests/sources.lock.json",
        "sha256": sha256_file(path),
        "sources": [],
    }
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        info["error"] = f"invalid json: {exc}"
        return info
    info["schema"] = data.get("schema")
    for source in data.get("sources", []):
        if not isinstance(source, dict):
            continue
        info["sources"].append(
            {
                "name": source.get("name"),
                "version": source.get("version"),
                "filename": source.get("filename"),
                "sha256": source.get("sha256"),
            }
        )
    return info


def read_json_file(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def embedded_payload_manifest(path):
    try:
        data = path.read_bytes()
    except OSError:
        return None
    if len(data) >= CONFIG_TRAILER_SIZE and data[-CONFIG_TRAILER_SIZE:].startswith(CONFIG_MAGIC):
        data = data[:-CONFIG_TRAILER_SIZE]
    if len(data) < PAYLOAD_TRAILER_SIZE:
        return None
    trailer = data[-PAYLOAD_TRAILER_SIZE:].split(b"\0", 1)[0].decode("ascii", "replace")
    lines = trailer.splitlines()
    if not lines or lines[0].encode() != PAYLOAD_MAGIC:
        return None
    meta = {}
    for line in lines[1:]:
        if line == "END":
            break
        if "=" in line:
            key, value = line.split("=", 1)
            meta[key] = value
    try:
        offset = int(meta.get("offset", "0"))
        size = int(meta.get("size", "0"))
    except ValueError:
        return None
    if offset <= 0 or size <= 0 or offset + size > len(data) - PAYLOAD_TRAILER_SIZE:
        return None
    try:
        with tarfile.open(fileobj=io.BytesIO(data[offset : offset + size]), mode="r:*") as tf:
            member = tf.extractfile("payload/manifest.json")
            return json.load(member) if member else None
    except (OSError, tarfile.TarError, json.JSONDecodeError):
        return None


def write_build_missing_report(path, rec, payload_manifest):
    missing = payload_manifest.get("missing_payload_tools") or []
    reasons = payload_manifest.get("missing_payload_tool_reasons") or {}
    requested = payload_manifest.get("requested_payload_tools") or []
    built = set(payload_manifest.get("built_payload_tools") or [])
    rows = []
    for tool in missing:
        rows.append(
            {
                "requested_tool": tool,
                "provider": payload_manifest.get("gdbserver_provider") if tool == "gdbserver" else "auto",
                "reason_missing": reasons.get(tool, "not built or not staged"),
                "known_build_failure": None,
                "compatibility_note": f"{tool} is absent from this artifact and is not part of the positive runtime inventory.",
                "suggested_provider_or_drop_in_workaround": "Enable a compatible Buildroot provider or stage a target-compatible user/provider binary where supported.",
            }
        )
    report = {
        "schema": 1,
        "artifact": rec.get("artifact"),
        "target": rec.get("resolved_target") or rec.get("target"),
        "payload_preset": rec.get("payload_preset"),
        "requested_tools": requested,
        "built_tools": sorted(built),
        "missing_tools": rows,
    }
    path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def write_build_report(release_dir, records):
    reports = []
    for rec in records:
        if rec.get("build_missing_path"):
            reports.append(
                {
                    "artifact": rec.get("artifact"),
                    "target": rec.get("resolved_target") or rec.get("target"),
                    "payload_preset": rec.get("payload_preset"),
                    "build_missing": rec.get("build_missing_path"),
                }
            )
    report = {
        "schema": 1,
        "failures": [rec for rec in records if rec.get("build_status") == "failed"],
        "missing_reports": reports,
    }
    path = release_dir / "build-report.json"
    path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return path


def artifact_summary(release_dir, rec, include_missing=False):
    manifest = read_json_file(release_dir / rec.get("manifest_path", "")) if rec.get("manifest_path") else None
    payload_manifest = read_json_file(release_dir / rec.get("payload_manifest_path", "")) if rec.get("payload_manifest_path") else None
    payload_tools = (manifest or {}).get("payload_tools") or {}
    native_features = (manifest or {}).get("native_features") or {}
    runtime = (manifest or {}).get("runtime") or {}
    rshell = (manifest or {}).get("rshell") or {}
    command_queue = ((manifest or {}).get("operator_services") or {}).get("command_queue") or {}
    trailer_keys = sorted(((manifest or {}).get("effective_config") or {}).keys())
    heavy = payload_tools.get("heavy_tools") or payload_tools.get("staged_payload_tools") or (payload_manifest or {}).get("staged_payload_tools") or []
    busybox = payload_tools.get("busybox_applets") or (payload_manifest or {}).get("busybox_applets") or []
    tool_provider_status = (payload_manifest or {}).get("tool_provider_status") or {}
    doom_wads = (payload_manifest or {}).get("doom_wads") or []
    native = [key for key, value in sorted(native_features.items()) if value is True]
    noresidue_level = runtime.get("noresidue_level")
    rshell_policy = rshell.get("session_policy")
    rshell_policy_summary = rshell_session_policy_summary(rshell_policy, rshell.get("retry") or {})
    summary = {
        "artifact": rec.get("artifact"),
        "target": (payload_manifest or {}).get("target") or rec.get("resolved_target") or rec.get("target"),
        "payload_manifest": rec.get("payload_manifest_path"),
        "payload_preset": rec.get("payload_preset"),
        "runtime_mode": rec.get("runtime_mode") or runtime.get("mode"),
        "noresidue_level": noresidue_level,
        "noresidue_policy": noresidue_policy_summary(runtime.get("mode"), noresidue_level),
        "recovery_workflows": recovery_workflows_summary(native_features),
        "reverse_access": {
            "transport": rshell.get("transport"),
            "session_policy": rshell_policy,
            "session_policy_valid": rshell.get("session_policy_valid", rshell_policy_summary.get("valid")),
            "session_policy_errors": rshell.get("session_policy_errors", rshell_policy_summary.get("errors")),
            "session_policy_summary": rshell_policy_summary,
            "operator_host": rshell.get("operator_host"),
            "operator_shell_port": rshell.get("operator_shell_port"),
            "operator_ssh_port": rshell.get("operator_ssh_port"),
            "remote_forward_port": rshell.get("remote_forward_port"),
        },
        "command_queue": {
            "enabled": command_queue.get("enabled", "no"),
            "default_enabled": command_queue.get("default_enabled", False),
            "port": command_queue.get("port", ""),
            "tls": command_queue.get("tls", ""),
            "require_token": command_queue.get("require_token", ""),
            "token_source": command_queue.get("token_source", ""),
            "allowed_commands": command_queue.get("allowed_commands", "none"),
            "allow_arbitrary": command_queue.get("allow_arbitrary", "no"),
            "poll_interval_sec": command_queue.get("poll_interval_sec", "5"),
            "poll_jitter_pct": command_queue.get("poll_jitter_pct", "0"),
            "poll_backoff": command_queue.get("poll_backoff", "none"),
            "poll_max_interval_sec": command_queue.get("poll_max_interval_sec", "300"),
            "max_polls": command_queue.get("max_polls", "0"),
            "daemon_state_file": command_queue.get("daemon_state_file", ""),
            "daemon_state_file_supported": command_queue.get("daemon_state_file_supported", False),
            "daemon_status_supported": command_queue.get("daemon_status_supported", False),
            "daemon_stop_supported": command_queue.get("daemon_stop_supported", False),
            "policy_valid": command_queue.get("policy_valid", False),
            "policy_errors": command_queue.get("policy_errors", []),
            "arbitrary_policy_requested": command_queue.get("arbitrary_policy_requested", False),
            "arbitrary_execution_allowed": command_queue.get("arbitrary_execution_allowed", False),
            "target_polling": command_queue.get("target_polling", False),
            "poll_transport_supported": command_queue.get("poll_transport_supported", True),
            "live_polling_supported": command_queue.get("live_polling_supported", True),
            "delivery_supported": command_queue.get("delivery_supported", False),
            "result_upload_supported": command_queue.get("result_upload_supported", False),
            "executes_commands": command_queue.get("executes_commands", False),
            "mode_records": command_queue.get("mode_records", []),
            "mode_records_by_mode": command_queue.get("mode_records_by_mode", {}),
            "mode_records_by_lifecycle": command_queue.get("mode_records_by_lifecycle", {}),
            "mode_records_by_would_poll_if_configured": command_queue.get("mode_records_by_would_poll_if_configured", {}),
            "mode_records_by_target_polling_supported": command_queue.get("mode_records_by_target_polling_supported", {}),
            "mode_records_by_execution_supported": command_queue.get("mode_records_by_execution_supported", {}),
            "mode_records_by_active_control_channel": command_queue.get("mode_records_by_active_control_channel", {}),
            "mode_summary": command_queue.get("mode_summary", {}),
            "api_collections": command_queue.get("api_collections", {}),
        },
        "native_applets": native,
        "busybox_applets": busybox,
        "core_extraction_behavior": "BusyBox applet dispatch extracts a core payload subset; heavy tools upgrade to full extraction.",
        "heavy_tools": heavy,
        "tool_provider_status": tool_provider_status,
        "doom_wads": doom_wads,
        "trailer_overridable_fields": trailer_keys,
        "size": rec.get("size"),
        "sha256": rec.get("sha256"),
        "config": rec.get("config"),
        "manifest": rec.get("manifest_path"),
        "config_info": rec.get("config_info_path"),
        "compatibility": compatibility_baseline(rec.get("tuple") or {}),
    }
    if include_missing:
        summary["missing_tools"] = payload_tools.get("missing_payload_tools") or (payload_manifest or {}).get("missing_payload_tools") or []
        summary["missing_tool_reasons"] = payload_tools.get("missing_payload_tool_reasons") or (payload_manifest or {}).get("missing_payload_tool_reasons") or {}
        summary["build_missing"] = rec.get("build_missing_path")
    return summary


def recovery_workflows_summary(native_features):
    available = bool(native_features.get("persistence"))
    alias_available = bool(native_features.get("recovery_alias"))
    actions = []
    if available:
        actions = [
            "status-only",
            "rshell",
            "evidence-push",
            "evidence-then-rshell",
            "dmesg-push",
            "command",
            "script",
        ]
    return {
        "available": available,
        "primary_command": "persistence" if available else "",
        "deprecated_alias": "recovery" if alias_available else "",
        "actions": actions,
        "evidence_actions": [a for a in actions if a in ("evidence-push", "evidence-then-rshell", "dmesg-push")],
        "default_action": "status-only" if available else "",
        "dry_run_supported": available,
        "uninstall_supported": available,
        "requires_apply": True,
        "real_root_requires_external_apply": True,
        "visible_reversible_ledgered": True,
        "stealth": False,
        "self_reinstall": False,
        "factory_reset_survival_claim": False,
    }


def noresidue_policy_summary(runtime_mode, level):
    level = level or "best-effort"
    aggressive = level == "aggressive"
    active = runtime_mode == "no-residue"
    return {
        "level": level,
        "runtime_mode": runtime_mode or "",
        "active": active,
        "best_effort_cleanup": True,
        "forensic_no_trace": False,
        "aggressive_minimizes_runtime_residue": aggressive,
        "scope": "BusierBox-owned runtime roots and ledgered files where reasonable; external writes require explicit operator action",
        "caveat": (
            "aggressive minimizes BusierBox runtime residue but cannot guarantee absence of residue"
            if aggressive else
            "best-effort cleanup removes owned runtime state where reasonable"
        ),
    }


def rshell_session_policy_summary(policy, retry):
    policy = policy or "single"
    valid = policy in ("single", "reconnect", "persistent")
    reconnects = policy in ("reconnect", "persistent")
    persistent = policy == "persistent"
    return {
        "valid": valid,
        "errors": [] if valid else ["unsupported rshell session policy"],
        "retry_scope": "pre-connect+post-disconnect" if reconnects else "pre-connect",
        "retry_until_first_connection": True,
        "stop_after_first_success": policy == "single",
        "reconnect_after_disconnect": reconnects,
        "persistent_lifecycle": persistent,
        "fresh_session_on_reconnect": reconnects,
        "session_resume_supported": False,
        "pre_connect_retry_count": str((retry or {}).get("count", "")),
        "post_disconnect_retry_count": "-1" if persistent else ("0" if policy == "single" else str((retry or {}).get("count", ""))),
    }


def compatibility_baseline(tuple_info):
    reasons = []
    for key in ("arch", "endian", "libc", "kernel_floor", "cpu", "abi", "static_policy"):
        value = tuple_info.get(key)
        if value:
            reasons.append(f"{key}={value}")
    return {
        "schema": 1,
        "label": "exact",
        "reasons": reasons,
        "note": "Baseline tuple metadata for this artifact; use release-find with survey/reality JSON for target-specific scoring.",
    }


def manifest_text_for_tuple(tuple_info, records, include_missing=False):
    lines = [
        "BusierBox compatibility tuple",
        f"tuple_path={tuple_info['path']}",
        f"arch={tuple_info.get('arch', '')}",
        f"libc={tuple_info.get('libc', '')}",
        f"kernel_floor={tuple_info.get('kernel_floor', '')}",
        f"cpu={tuple_info.get('cpu', '')}",
        f"abi={tuple_info.get('abi', '')}",
        f"endian={tuple_info.get('endian', '')}",
        f"static_policy={tuple_info.get('static_policy', '')}",
        "compatibility_baseline=exact",
        "",
        "Payload variants:",
    ]
    for rec in records:
        summary = rec.get("tuple_summary") or {}
        lines.extend([
            f"- {rec.get('payload_preset')} -> {rec.get('tuple_artifact', rec.get('artifact', ''))}",
            f"  status={rec.get('build_status', '')}",
            f"  runtime_mode={summary.get('runtime_mode') or rec.get('runtime_mode') or ''}",
            f"  noresidue_level={summary.get('noresidue_level') or ''}",
            "  noresidue_policy=" + json.dumps(summary.get("noresidue_policy") or {}, sort_keys=True),
            "  recovery_workflows=" + json.dumps(summary.get("recovery_workflows") or {}, sort_keys=True),
            f"  size={rec.get('size', '')}",
            f"  sha256={rec.get('sha256', '')}",
            f"  config={rec.get('config', '')}",
            f"  manifest={rec.get('tuple_manifest', rec.get('manifest_path') or '')}",
            f"  payload_manifest={rec.get('tuple_payload_manifest', rec.get('payload_manifest_path') or '')}",
            f"  compatibility={((summary.get('compatibility') or {}).get('label') or 'exact')}",
            f"  native_applets={', '.join(summary.get('native_applets') or [])}",
            f"  busybox_applets={', '.join(summary.get('busybox_applets') or [])}",
            f"  core_extraction={summary.get('core_extraction_behavior', '')}",
            f"  heavy_tools={', '.join(summary.get('heavy_tools') or [])}",
            "  tool_provider_status=" + json.dumps(summary.get("tool_provider_status") or {}, sort_keys=True),
            "  doom_wads=" + json.dumps(summary.get("doom_wads") or [], sort_keys=True),
        ])
        if include_missing:
            lines.append(f"  missing_tools={', '.join(summary.get('missing_tools') or [])}")
            reasons = summary.get("missing_tool_reasons") or {}
            if reasons:
                lines.append("  missing_tool_reasons=" + json.dumps(reasons, sort_keys=True))
            if summary.get("build_missing"):
                lines.append(f"  build_missing={summary.get('build_missing')}")
        reverse = summary.get("reverse_access") or {}
        lines.append("  reverse_access_defaults=" + json.dumps(reverse, sort_keys=True))
        lines.append("  command_queue_policy=" + json.dumps(summary.get("command_queue") or {}, sort_keys=True))
        lines.append("  trailer_overridable_fields=" + ", ".join(summary.get("trailer_overridable_fields") or []))
    if records:
        example = records[0].get("tuple_artifact") or records[0].get("artifact", "bin/busierbox-...-full")
        example_name = pathlib.Path(example).name
        lines.extend([
            "",
            "Tuple quickstart:",
            f"- choose_artifact: scripts/release-find --payload-preset {records[0].get('payload_preset', '')}",
            f"- configure_trailer: scripts/configure-artifact {example} --operator-host 192.168.8.241 --transport builtin --shell-port 22203",
            "- verify_checksums: scripts/verify-checksums --configured",
            f"- first_contact: ./{example_name} survey --json",
            f"- manifest: ./{example_name} manifest --json",
            f"- doctor: ./{example_name} doctor",
            f"- rshell_status: ./{example_name} rshell status --json",
            f"- cleanup_ledger: ./{example_name} cleanup-ledger --json",
            f"- clean_dry_run: ./{example_name} clean --dry-run",
            f"- recovery_plan: ./{example_name} persistence --plan",
        ])
    lines.append("")
    return "\n".join(lines)


def write_tuple_layout(release_dir, records, layout_mode, include_missing=False):
    tuples = {}
    devices = {}

    for rec in records:
        if rec.get("build_status") == "failed" or not rec.get("artifact"):
            continue
        tuple_info = rec.get("tuple") or {}
        tuple_path = tuple_info.get("path")
        if not tuple_path:
            continue
        validate_tuple_metadata(tuple_info, context=rec.get("artifact") or rec.get("name") or "tuple")
        tuple_dir = release_dir / tuple_path
        tuple_dir.mkdir(parents=True, exist_ok=True)
        for sub in ("bin", "configs", "manifests"):
            (tuple_dir / sub).mkdir(exist_ok=True)

        flat_artifact = release_dir / rec["artifact"]
        flat_config = release_dir / rec["config"]
        tuple_artifact = tuple_dir / "bin" / pathlib.Path(rec["artifact"]).name
        tuple_config = tuple_dir / "configs" / pathlib.Path(rec["config"]).name
        place_entry(flat_artifact, tuple_artifact, layout_mode)
        place_entry(flat_config, tuple_config, layout_mode)
        rec["tuple_path"] = tuple_path
        rec["tuple_artifact"] = tuple_artifact.relative_to(release_dir).as_posix()
        rec["tuple_config"] = tuple_config.relative_to(release_dir).as_posix()

        if rec.get("manifest_path"):
            flat_manifest = release_dir / rec["manifest_path"]
            tuple_manifest = tuple_dir / "manifests" / flat_manifest.name
            place_entry(flat_manifest, tuple_manifest, layout_mode)
            rec["tuple_manifest"] = tuple_manifest.relative_to(release_dir).as_posix()
        if rec.get("payload_manifest_path"):
            flat_payload_manifest = release_dir / rec["payload_manifest_path"]
            tuple_payload_manifest = tuple_dir / "manifests" / flat_payload_manifest.name
            place_entry(flat_payload_manifest, tuple_payload_manifest, layout_mode)
            rec["tuple_payload_manifest"] = tuple_payload_manifest.relative_to(release_dir).as_posix()
        if rec.get("config_info_path"):
            flat_config_info = release_dir / rec["config_info_path"]
            tuple_config_info = tuple_dir / "manifests" / flat_config_info.name
            place_entry(flat_config_info, tuple_config_info, layout_mode)
            rec["tuple_config_info"] = tuple_config_info.relative_to(release_dir).as_posix()
        if rec.get("build_missing_path"):
            flat_build_missing = release_dir / rec["build_missing_path"]
            tuple_build_missing = tuple_dir / "manifests" / flat_build_missing.name
            place_entry(flat_build_missing, tuple_build_missing, layout_mode)
            rec["tuple_build_missing"] = tuple_build_missing.relative_to(release_dir).as_posix()

        rec["tuple_summary"] = artifact_summary(release_dir, rec, include_missing=include_missing)
        bucket = tuples.setdefault(tuple_path, {"tuple": tuple_info, "artifacts": []})
        bucket["artifacts"].append(rec)

        for alias in rec.get("device_aliases") or []:
            devices.setdefault(alias, {"alias": alias, "tuple_path": tuple_path, "artifacts": []})
            devices[alias]["artifacts"].append(rec.get("tuple_artifact") or rec.get("artifact"))

    for tuple_path, item in sorted(tuples.items()):
        tuple_dir = release_dir / tuple_path
        manifest = {
            "schema": 1,
            "tuple": item["tuple"],
            "artifacts": [rec.get("tuple_summary") for rec in item["artifacts"]],
        }
        (tuple_dir / "MANIFEST.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        (tuple_dir / "MANIFEST.txt").write_text(manifest_text_for_tuple(item["tuple"], item["artifacts"], include_missing=include_missing), encoding="utf-8")
        (tuple_dir / "README.txt").write_text(
            f"BusierBox artifacts for compatibility tuple {tuple_path}.\n"
            "Use this tuple when the target arch/libc/kernel floor match, regardless of device name.\n"
            "The flat top-level bin/, configs/, and manifests/ paths are kept for scripts.\n",
            encoding="utf-8",
        )

    devices_dir = release_dir / "devices"
    for alias, item in sorted(devices.items()):
        device_dir = devices_dir / safe_stem(alias)
        device_dir.mkdir(parents=True, exist_ok=True)
        target_json = {
            "schema": 1,
            "alias": alias,
            "tuple_path": item["tuple_path"],
            "artifacts": item["artifacts"],
        }
        (device_dir / "target.json").write_text(json.dumps(target_json, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        (device_dir / "README.txt").write_text(
            f"{alias}\n\nThis device/exemplar alias maps to `{item['tuple_path']}`.\n",
            encoding="utf-8",
        )
        (device_dir / "notes.md").write_text(
            f"# {alias}\n\nUse the canonical compatibility tuple at `{item['tuple_path']}`.\n",
            encoding="utf-8",
        )
        artifacts_link = device_dir / "artifacts"
        if artifacts_link.exists() or artifacts_link.is_symlink():
            if artifacts_link.is_dir() and not artifacts_link.is_symlink():
                shutil.rmtree(artifacts_link)
            else:
                artifacts_link.unlink()
        if layout_mode == "copy":
            shutil.copytree(release_dir / item["tuple_path"], artifacts_link, symlinks=True)
        else:
            artifacts_link.symlink_to(path_to(device_dir, release_dir / item["tuple_path"]))

    return {
        "mode": layout_mode,
        "tuples": {
            key: {
                "tuple": value["tuple"],
                "artifacts": [rec.get("artifact") for rec in value["artifacts"]],
                "tuple_artifacts": [rec.get("tuple_artifact") for rec in value["artifacts"]],
                "manifest": f"{key}/MANIFEST.json",
            }
            for key, value in sorted(tuples.items())
        },
        "devices": {
            key: {
                "path": f"devices/{safe_stem(key)}",
                "tuple_path": value["tuple_path"],
                "artifacts": value["artifacts"],
            }
            for key, value in sorted(devices.items())
        },
    }


def build_or_copy(job, config, release_dir, args, dry_run=False):
    resolved = resolve_job(job, config, dry_run=dry_run)
    resolved_target = resolved.get("TARGET_NAME") or job["target"]
    tuple_info = tuple_metadata(resolved)
    config_stem, stem = job_stems(job, resolved_target)
    rec = {
        "name": job["name"],
        "target": job["target"],
        "resolved_target": resolved_target,
        "payload_preset": job["payload"],
        "format": job["format"],
        "runtime_mode": job.get("runtime_mode"),
        "base_config": job.get("config_source"),
        "reverse_access_profiles": job.get("reverse_access_profiles", []),
        "config": f"configs/{config_stem}.conf",
        "artifact": f"bin/{stem}",
        "tuple": tuple_info,
        "tuple_path": tuple_info["path"],
        "device_aliases": target_aliases(job, resolved),
        "build_status": "dry-run" if dry_run else "pending",
        "trailer_support": "artifact-config bundled",
    }
    if dry_run:
        rec["command"] = f"BUSIERBOX_CONFIG={config} PAYLOAD_FORMAT={job['format']} scripts/package-target {job['target']}"
        return rec

    log = release_dir / "logs" / f"{stem}.log"
    env = os.environ.copy()
    env["BUSIERBOX_CONFIG"] = str(config)
    env["PAYLOAD_FORMAT"] = job["format"]
    if args.skip_build:
        rc = 0
    else:
        rc = run_capture([str(ROOT / "scripts" / "package-target"), job["target"]], log, env=env)
    rec["log"] = f"logs/{log.name}"
    if rc != 0:
        rec["build_status"] = "failed"
        rec["reason"] = f"build failed, see {rec['log']}"
        return rec

    source = ROOT / "dist" / f"busierbox-{resolved_target}-full"
    if not source.exists():
        rec["build_status"] = "failed"
        rec["reason"] = f"missing artifact {source}"
        return rec
    dest = release_dir / "bin" / stem
    shutil.copy2(source, dest)
    digest = sha256_file(dest)
    (dest.with_suffix(dest.suffix + ".sha256")).write_text(f"{digest}  {dest.name}\n", encoding="utf-8")
    rec.update({"build_status": "built" if not args.skip_build else "copied", "sha256": digest, "size": dest.stat().st_size})

    manifest = release_dir / "manifests" / f"{stem}.manifest.json"
    payload_manifest_path = release_dir / "manifests" / f"{stem}.payload-manifest.json"
    config_info = release_dir / "manifests" / f"{stem}.config-info.txt"
    inspect_txt = release_dir / "manifests" / f"{stem}.inspect.txt"
    run_capture([str(ROOT / "scripts" / "inspect-artifact"), str(dest)], inspect_txt)
    payload_manifest = embedded_payload_manifest(dest)
    if payload_manifest:
        payload_manifest_path.write_text(json.dumps(payload_manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        if args.include_missing_reports:
            build_missing = release_dir / "manifests" / f"{stem}.build-missing.json"
            write_build_missing_report(build_missing, rec, payload_manifest)
            rec["build_missing_path"] = f"manifests/{build_missing.name}"
    if resolved.get("TARGET_ARCH") == "native" and os.access(dest, os.X_OK):
        run_capture([str(dest), "manifest", "--json"], manifest)
        run_capture([str(dest), "config-info"], config_info)
    rec["manifest_path"] = f"manifests/{manifest.name}" if manifest.exists() and manifest.stat().st_size else None
    rec["payload_manifest_path"] = f"manifests/{payload_manifest_path.name}" if payload_manifest_path.exists() and payload_manifest_path.stat().st_size else None
    rec["config_info_path"] = f"manifests/{config_info.name}" if config_info.exists() and config_info.stat().st_size else None
    return rec


def failed_record(job, config, reason):
    config_stem, _stem = job_stems(job, job["target"])
    return {
        "name": job["name"],
        "target": job["target"],
        "resolved_target": job["target"],
        "payload_preset": job["payload"],
        "format": job["format"],
        "runtime_mode": job.get("runtime_mode"),
        "base_config": job.get("config_source"),
        "reverse_access_profiles": job.get("reverse_access_profiles", []),
        "config": f"configs/{config_stem}.conf",
        "build_status": "failed",
        "reason": reason,
    }


def print_summary(records, release_dir, tarball=None):
    print(f"{'Status':<10} {'Target':<34} {'Payload':<20} Artifact")
    for rec in records:
        print(f"{rec.get('build_status',''):<10} {rec.get('resolved_target', rec['target']):<34} {rec['payload_preset']:<20} {rec.get('artifact','')}")
    print(f"release_dir={release_dir}")
    if tarball:
        print(f"tarball={tarball}")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--name", required=True)
    parser.add_argument("--targets")
    parser.add_argument("--payload-presets")
    parser.add_argument("--formats")
    parser.add_argument("--runtime-modes")
    parser.add_argument("--reverse-access-profiles", help="comma-separated profiles to add: builtin, ssh, socat, or all")
    parser.add_argument("--config")
    parser.add_argument("--matrix")
    parser.add_argument("--include-sources-manifest", action="store_true")
    parser.add_argument("--include-missing-reports", action="store_true",
                        help="emit builder-facing build-missing reports for requested but unavailable payload tools")
    parser.add_argument("--skip-build", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--symlink-layout", dest="layout_mode", action="store_const", const="symlink", default="symlink",
                        help="populate by-tuple/devices layout with symlinks to flat files (default)")
    parser.add_argument("--copy-layout", dest="layout_mode", action="store_const", const="copy",
                        help="populate by-tuple/devices layout with copied files for portability")
    parser.add_argument("--fail-fast", action="store_true")
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--out-dir")
    args = parser.parse_args(argv)

    data = load_release_matrix(args.matrix)
    release_name = data.get("name") or args.name
    release_version = data.get("version")
    include_options = matrix_include_options(data)
    include_sources_manifest = bool(args.include_sources_manifest or include_options.get("sources_manifest") or include_options.get("source_lock"))
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S")
    release_dir = pathlib.Path(args.out_dir) if args.out_dir else ROOT / "dist" / "releases" / f"{safe_stem(args.name)}-{stamp}"
    jobs = selected_jobs(args, data)
    validate_selected_jobs(jobs)
    if args.dry_run:
        print(f"release={release_name}")
        if release_version:
            print(f"version={release_version}")
        print(f"release_dir={release_dir}")
        print(f"layout={args.layout_mode}")
        for job in jobs:
            runtime = f" runtime={job['runtime_mode']}" if job.get("runtime_mode") else ""
            config = f" config={job['config_source']}" if job.get("config_source") else ""
            print(f"would build target={job['target']} payload={job['payload']} format={job['format']}{runtime}{config}")
        return 0

    for sub in ("bin", "configs", "manifests", "logs", "scripts", "docs"):
        (release_dir / sub).mkdir(parents=True, exist_ok=True)
    copy_bundle_support(release_dir, include_sources_manifest=include_sources_manifest)
    write_release_quickstart(release_dir / "RELEASE-QUICKSTART.txt", release_name)
    write_release_readme(release_dir / "docs" / "README-release.md", release_name)

    records = []
    git_commit = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True, stdout=subprocess.PIPE, check=False).stdout.strip()
    for job in jobs:
        config_stem, _stem = job_stems(job)
        config = release_dir / "configs" / f"{config_stem}.conf"
        write_config(config, job, base_config=job.get("config_source"))
        try:
            rec = build_or_copy(job, config, release_dir, args)
        except Exception as exc:
            rec = failed_record(job, config, str(exc))
        records.append(rec)
        if args.fail_fast and rec.get("build_status") == "failed":
            break

    layout = write_tuple_layout(release_dir, records, args.layout_mode, include_missing=args.include_missing_reports)
    build_report_path = write_build_report(release_dir, records) if args.include_missing_reports else None

    release = {
        "schema_version": SCHEMA_VERSION,
        "release_name": release_name,
        "release_version": release_version,
        "timestamp": stamp,
        "git_commit": git_commit,
        "build_host": safe_build_host_metadata(),
        "source_lock": source_lock_metadata(),
        "matrix": {
            "path": args.matrix,
            "name": data.get("name"),
            "version": release_version,
            "include": include_options,
            "targets": [job["target"] for job in jobs],
            "payload_presets": [job["payload"] for job in jobs],
            "configs": [job.get("config_source") for job in jobs if job.get("config_source")],
            "formats": [job["format"] for job in jobs],
            "runtime_modes": [job.get("runtime_mode") for job in jobs if job.get("runtime_mode")],
            "reverse_access_profiles": selected_reverse_access_profiles(args, data),
        },
        "include_sources_manifest": include_sources_manifest,
        "include_missing_reports": bool(args.include_missing_reports),
        "skip_build": bool(args.skip_build),
        "layout": layout,
        "build_report": build_report_path.relative_to(release_dir).as_posix() if build_report_path else None,
        "artifacts": records,
        "failures": [rec for rec in records if rec.get("build_status") == "failed"],
        "trailer_support_status": "bundled artifact-config helpers; XOR is not encryption",
    }
    (release_dir / "release.json").write_text(json.dumps(release, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    run_capture([str(release_dir / "scripts" / "release-index"), "--write"], release_dir / "logs" / "release-index.log", required=True)
    original = checksum_manifest(release_dir, "SHA256SUMS.original")
    shutil.copy2(original, release_dir / "SHA256SUMS")
    tarball = make_tarball(release_dir)
    print_summary(records, release_dir, tarball)
    failed = bool(release["failures"])
    if failed and args.strict:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
