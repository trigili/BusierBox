#!/usr/bin/env python3
"""Repeatable GL.iNet integration harness for griTTYkit artifacts."""

import argparse
import hashlib
import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
RUN_ROOT = ROOT / "local" / "integration-runs"
DEFAULT_TARGET = "glinet-mt7621-openwrt-musl"
SAFE_CASES = [
    "survey-core",
    "trailer-runtime-override",
    "recovery-fakeroot",
    "no-residue-cleanup",
    "default-extract-help",
    "builtin-core-shell",
    "zero-arg-builtin",
]
ALL_CASES = SAFE_CASES + ["socat-rescue", "ssh-operator"]
PORTS = {
    "ssh": 22202,
    "shell": 22203,
    "forward": 2200,
    "dropbear": 2222,
}


class SkipCase(RuntimeError):
    pass


PAYLOAD_PRESETS = {
    "survey-core": "survey-core",
    "trailer-runtime-override": "survey-core",
    "recovery-fakeroot": "survey-core",
    "no-residue-cleanup": "default",
    "default-extract-help": "default",
    "builtin-core-shell": "builtin-core-shell",
    "zero-arg-builtin": "builtin-core-shell",
    "socat-rescue": "socat-rescue",
    "ssh-operator": "ssh-operator",
}


def log(msg):
    print(msg, flush=True)


def remote_host_name(host):
    return host.rsplit("@", 1)[-1].split(":", 1)[0]


def local_operator_host(host=None):
    if host:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            try:
                sock.connect((remote_host_name(host), 1))
                ip = sock.getsockname()[0]
                if ip and not ip.startswith("127."):
                    return ip
            except OSError:
                pass
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        try:
            sock.connect(("8.8.8.8", 80))
            return sock.getsockname()[0]
        except OSError:
            return "127.0.0.1"


def run_cmd(cmd, *, cwd=ROOT, env=None, timeout=120, log_path=None, check=False):
    cmd_text = " ".join(shlex.quote(str(x)) for x in cmd)
    if log_path is not None:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("ab") as fh:
            fh.write(f"$ {cmd_text}\n".encode())
            proc = subprocess.run(cmd, cwd=cwd, env=env, timeout=timeout,
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            fh.write(proc.stdout)
            fh.write(f"\n[exit {proc.returncode}]\n".encode())
    else:
        proc = subprocess.run(cmd, cwd=cwd, env=env, timeout=timeout,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if check and proc.returncode != 0:
        raise RuntimeError(f"command failed ({proc.returncode}): {cmd_text}")
    return proc


def ssh_cmd(host, remote, *, timeout=60, log_path=None, check=False, retries=0):
    last_exc = None
    for attempt in range(retries + 1):
        try:
            return run_cmd([
                "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, remote
            ], timeout=timeout, log_path=log_path, check=check)
        except subprocess.TimeoutExpired as exc:
            last_exc = exc
            if log_path is not None:
                log_path.parent.mkdir(parents=True, exist_ok=True)
                with log_path.open("ab") as fh:
                    fh.write(f"\n[timeout after {timeout}s attempt {attempt + 1}/{retries + 1}]\n".encode())
            if attempt < retries:
                time.sleep(1)
                continue
            raise
    raise last_exc


def scp_to(host, local, remote, *, timeout=120, log_path=None, check=False):
    return run_cmd([
        "scp", "-O", "-q", str(local), f"{host}:{remote}"
    ], timeout=timeout, log_path=log_path, check=check)


def sha256(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def write_case_config(case_dir, case, operator_host, args):
    preset = PAYLOAD_PRESETS[case]
    preset_path = ROOT / "presets" / "payload" / f"{preset}.conf"
    if not preset_path.is_file():
        raise RuntimeError(f"missing payload preset: {preset_path}")
    text = preset_path.read_text(encoding="utf-8")
    lines = [
        f"# generated by scripts/integration-glinet for {case}",
        text.rstrip(),
        f'GRIT_OPERATOR_SERVER_HOST="{operator_host}"',
        f'GRIT_OPERATOR_SERVER_SSH_PORT="{args.ssh_port}"',
        f'GRIT_OPERATOR_REMOTE_FORWARD_PORT="{args.forward_port}"',
        f'GRIT_OPERATOR_TARGET_DROPBEAR_PORT="{args.dropbear_port}"',
        f'GRIT_RSHELL_SOCAT_PORT="{args.shell_port}"',
        'GRIT_RSHELL_AUTHKEYS_MODE="disabled"',
        'GRIT_RSHELL_SESSION_POLICY="single"',
        'GRIT_RUNTIME_ALLOW_EXTERNAL_WRITES="no"',
    ]
    if case == "ssh-operator":
        lines.extend([
            'GRIT_OPERATOR_DBCLIENT_IDENTITY_FILE="local/operator-session/id_dbclient"',
            'GRIT_OPERATOR_AUTHORIZED_KEY_FILE="local/operator-session/operator_ed25519.pub"',
            'GRIT_RSHELL_GENERATE_HOSTKEY_IF_MISSING="yes"',
        ])
    if case == "builtin-core-shell":
        lines.append('GRIT_ZERO_ARG_MODE="help"')
    if case == "zero-arg-builtin":
        lines.append('GRIT_ZERO_ARG_MODE="rshell"')
        lines.append('GRIT_RSHELL_RUN_MODE="auto"')
    if case == "socat-rescue":
        lines.append('GRIT_STATIC_POLICY="dynamic"')
    if case == "no-residue-cleanup":
        lines.append('GRIT_RUNTIME_MODE="no-residue"')
        lines.append('GRIT_RUNTIME_ROOT="./.grit-nores"')
    config = case_dir / "grit.conf"
    config.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return config


def resolve_artifact(target):
    proc = run_cmd(["scripts/resolve-target", target], timeout=30, check=True)
    name = ""
    for raw in proc.stdout.decode().splitlines():
        if raw.startswith("TARGET_NAME="):
            name = raw.split("=", 1)[1].strip().strip("'")
    if not name:
        name = target
    return ROOT / "dist" / f"grit-{name}-full"


def build_artifact(case_dir, target, config, args):
    env = os.environ.copy()
    env["GRIT_CONFIG"] = str(config)
    env["TARGET"] = target
    env["PAYLOAD_FORMAT"] = args.payload_format
    if 'GRIT_STATIC_POLICY="dynamic"' in config.read_text(encoding="utf-8"):
        env["BUILDROOT_OUTPUT_BASE"] = str(ROOT / "local" / "integration-buildroot-output" / "dynamic")
    log_path = case_dir / "build.log"
    run_cmd(["make", "package"], env=env, timeout=args.build_timeout,
            log_path=log_path, check=True)
    artifact = resolve_artifact(target)
    if not artifact.is_file():
        raise RuntimeError(f"artifact missing after build: {artifact}")
    (case_dir / "artifact.json").write_text(json.dumps({
        "path": str(artifact),
        "sha256": sha256(artifact),
        "size": artifact.stat().st_size,
    }, indent=2) + "\n", encoding="utf-8")
    return artifact


def apply_case_artifact_overrides(case, artifact, case_dir):
    if case != "trailer-runtime-override":
        return artifact
    configured = case_dir / "grit-trailer"
    shutil.copy2(artifact, configured)
    configured.chmod(0o755)
    run_cmd([
        "scripts/artifact-config", "set", str(configured),
        "GRIT_OPERATOR_SERVER_HOST=198.51.100.88",
        "GRIT_OPERATOR_SERVER_SSH_PORT=22088",
        "GRIT_OPERATOR_REMOTE_FORWARD_PORT=2288",
        "GRIT_RSHELL_TRANSPORT=ssh",
        "GRIT_ZERO_ARG_LOG_MODE=status",
    ], timeout=60, log_path=case_dir / "artifact-config.log", check=True)
    return configured


def collect_target_facts(host, remote_dir, case_dir):
    facts = [
        ("uname.txt", "uname -a; uname -m"),
        ("os-release.txt", "cat /etc/os-release 2>/dev/null || true; cat /etc/openwrt_release 2>/dev/null || true"),
        ("df-free-id-mount.txt", "df -h /tmp . 2>/dev/null || df -h; free 2>/dev/null || true; id; mount"),
    ]
    for name, remote in facts:
        ssh_cmd(host, f"mkdir -p {shlex.quote(remote_dir)}; {remote}",
                timeout=30, log_path=case_dir / name)


def prepare_remote(host, remote_dir, artifact, case_dir):
    quoted = shlex.quote(remote_dir)
    ssh_cmd(host, f"rm -rf {quoted}; mkdir -p {quoted}",
            timeout=30, log_path=case_dir / "ssh-transcript.log", check=True)
    scp_to(host, artifact, f"{remote_dir}/grit",
           timeout=180, log_path=case_dir / "ssh-transcript.log", check=True)
    ssh_cmd(host, f"chmod +x {quoted}/grit",
            timeout=30, log_path=case_dir / "ssh-transcript.log", check=True)


def cleanup_remote(host, remote_dir, case_dir, keep_remote):
    quoted = shlex.quote(remote_dir)
    ssh_cmd(host, f"cd {quoted} 2>/dev/null && ./grit rshell stop >/dev/null 2>&1 || true",
            timeout=30, log_path=case_dir / "cleanup.log", retries=2)
    if not keep_remote:
        ssh_cmd(host, f"rm -rf {quoted}", timeout=30, log_path=case_dir / "cleanup.log", retries=2)


def run_remote_case(host, remote_dir, case_dir, command, timeout=120, check=True):
    quoted = shlex.quote(remote_dir)
    remote = f"set -eu; cd {quoted}; {command}"
    proc = ssh_cmd(host, remote, timeout=timeout, log_path=case_dir / "target-run.log",
                   check=False)
    if check and proc.returncode != 0:
        raise RuntimeError(f"remote command failed for {case_dir.name}: {command}")
    return proc


def captured_stdout(log_path):
    lines = Path(log_path).read_text(encoding="utf-8", errors="replace").splitlines()
    body = []
    for line in lines:
        if line.startswith("$ "):
            body = []
            continue
        if line.startswith("[exit "):
            break
        body.append(line)
    return "\n".join(body).strip()


def validate_captured_json(log_path):
    text = captured_stdout(log_path)
    if not text:
        raise RuntimeError(f"captured JSON log is empty: {log_path}")
    try:
        json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"captured JSON log is invalid: {log_path}: {exc}") from exc


def summarize_cases(cases):
    counts = {"pass": 0, "fail": 0, "skip": 0}
    failures = []
    for case in cases:
        status = case.get("status", "fail")
        counts[status] = counts.get(status, 0) + 1
        reason = case.get("error") or case.get("reason")
        if reason:
            failures.append({
                "case": case.get("case", ""),
                "status": status,
                "reason": reason,
                "logs": case.get("logs", ""),
            })
    return counts, failures


def mark_phase(result, phase, status):
    result.setdefault("phases", {})[phase] = status


def capture_grit_outputs(host, remote_dir, case_dir):
    commands = [
        ("manifest-json.log", "./grit manifest --json"),
        ("doctor-json.log", "./grit doctor --json"),
        ("runtime-config-json.log", "./grit runtime-config --json"),
        ("cleanup-ledger-json.log", "./grit cleanup-ledger --json"),
        ("plan-json.log", "./grit plan --json"),
        ("plan-extract-json.log", "./grit plan extract --json"),
        ("plan-rshell-json.log", "./grit plan rshell --json"),
        ("plan-clean-json.log", "./grit plan clean --json"),
        ("plan-recovery-rshell-json.log", "./grit plan recovery install --method openwrt-procd --action rshell --json"),
        ("plan-recovery-command-json.log", "./grit plan recovery install --method cron-reboot --action command --json -- 'grit rshell start'"),
        ("reality-test-json.log", "./grit reality-test --json"),
        ("clean-dry-run.log", "./grit clean --dry-run"),
        ("clean-dry-run-json.log", "./grit clean --dry-run --json"),
        ("clean-external-dry-run-json.log", "./grit clean --dry-run --external --json"),
        ("clean-external-no-apply.log", "./grit clean --external"),
        ("rshell-status-json.log", "./grit rshell status --json"),
        ("recovery-status-json.log", "./grit recovery status --json"),
    ]
    for log_name, command in commands:
        quoted = shlex.quote(remote_dir)
        log_path = case_dir / log_name
        ssh_cmd(host, f"cd {quoted}; {command}",
                timeout=60, log_path=log_path, check=False, retries=2)
        if log_name.endswith("-json.log"):
            validate_captured_json(log_path)


def validate_root_ssh_unchanged(host, remote_dir, case_dir, action):
    snapshot = r'''
snapshot_root_ssh() {
    if [ ! -e /root/.ssh ]; then echo __MISSING__; return 0; fi
    if [ ! -d /root/.ssh ]; then ls -ld /root/.ssh; return 0; fi
    find /root/.ssh -maxdepth 1 -mindepth 1 -type f -print 2>/dev/null | sort | while IFS= read -r f; do
        if command -v sha256sum >/dev/null 2>&1; then sha256sum "$f"; else ls -l "$f"; fi
    done
}
'''
    remote = f"""
set -eu
cd {shlex.quote(remote_dir)}
{snapshot}
snapshot_root_ssh > root-ssh.before
{action}
snapshot_root_ssh > root-ssh.after
cmp -s root-ssh.before root-ssh.after
"""
    proc = ssh_cmd(host, remote, timeout=180, log_path=case_dir / "root-ssh-policy.log")
    if proc.returncode != 0:
        raise RuntimeError("/root/.ssh changed during disabled/payload-home policy case")


def write_operator_server_config(case_dir, args):
    operator_dir = case_dir / "operator-session"
    session_root = case_dir / "operator-sessions"
    cfg = {
        "listen_host": "0.0.0.0",
        "ssh_listen_port": args.ssh_port,
        "shell_listen_port": args.shell_port,
        "forward_port": args.forward_port,
        "file_service_port": 22204,
        "operator_session_dir": str(operator_dir),
        "server_state": str(operator_dir / "server-state.json"),
        "staged_files": str(operator_dir / "staged-files.json"),
        "command_queue_file": str(operator_dir / "command-queue.json"),
        "command_copy_file": str(operator_dir / "last-command.txt"),
        "session_root": str(session_root),
        "tls_cert": str(operator_dir / "shell-server.crt"),
        "tls_key": str(operator_dir / "shell-server.key"),
        "operator_host_key": str(operator_dir / "operator_ssh_host_key"),
        "authorized_dbclient_pubkey": str(operator_dir / "id_dbclient.pub"),
    }
    operator_dir.mkdir(parents=True, exist_ok=True)
    path = case_dir / "operator-server-config.json"
    path.write_text(json.dumps(cfg, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return path


def start_shell_server(case_dir, transport, port, marker, args):
    script = case_dir / "server-script.sh"
    script.write_text(f"echo {marker}\nuname -m\nexit\n", encoding="utf-8")
    config = write_operator_server_config(case_dir, args)
    log_file = (case_dir / "server.log").open("wb")
    proc = subprocess.Popen([
        sys.executable, "-u", "scripts/grit-server",
        "--config", str(config),
        "--transport", transport,
        "--shell-port", str(port),
        "--timeout", str(args.connect_timeout),
        "--one-shot",
        "--script", str(script),
        "--expect", marker,
        "--session-timeout", str(args.session_timeout),
    ], cwd=ROOT, stdout=log_file, stderr=subprocess.STDOUT)
    return proc, log_file


def wait_server(proc, log_file, timeout):
    try:
        rc = proc.wait(timeout=timeout)
    finally:
        log_file.close()
    return rc


def case_survey_core(ctx):
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "./grit survey --json > survey.json; ./grit config-info > config-info.out")
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "python3 -m json.tool survey.json >/dev/null 2>&1 || "
                    "grep -q '\"arch\"\\|\"kernel\"\\|\"os\"' survey.json")
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "grep -E '^(runtime_mode=core-only|rshell_transport=none)' config-info.out; "
                    "test ! -d .grit/payload/bin")


def case_trailer_runtime_override(ctx):
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "./grit runtime-config > runtime-config.out; "
                    "grep -q '^effective_config_source=trailer$' runtime-config.out; "
                    "grep -q '^trailer_present=yes$' runtime-config.out; "
                    "grep -q '^trailer_valid=yes$' runtime-config.out; "
                    "grep -q '^trailer_encoding=plain$' runtime-config.out; "
                    "grep -q '^effective_GRIT_OPERATOR_SERVER_HOST=198.51.100.88$' runtime-config.out; "
                    "grep -q '^effective_GRIT_OPERATOR_SERVER_SSH_PORT=22088$' runtime-config.out; "
                    "grep -q '^effective_GRIT_OPERATOR_REMOTE_FORWARD_PORT=2288$' runtime-config.out; "
                    "grep -q '^effective_GRIT_RSHELL_TRANSPORT=ssh$' runtime-config.out; "
                    "grep -q '^effective_GRIT_ZERO_ARG_LOG_MODE=status$' runtime-config.out; "
                    "./grit config-info > config-info.out; "
                    "grep -q '^trailer_override_present=yes$' config-info.out; "
                    "grep -q '^trailer_override_valid=yes$' config-info.out; "
                    "grep -q '^effective_config_source=trailer$' config-info.out; "
                    "./grit rshell status --json > rshell-status-trailer.json; "
                    "grep -q '\"effective_config_source\":\"trailer\"' rshell-status-trailer.json; "
                    "grep -q '\"operator_host\":\"198.51.100.88\"' rshell-status-trailer.json; "
                    "grep -q '\"operator_ssh_port\":\"22088\"' rshell-status-trailer.json; "
                    "grep -q '\"remote_forward_port\":\"2288\"' rshell-status-trailer.json")


def case_recovery_fakeroot(ctx):
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "rm -rf fake-root; mkdir -p fake-root/etc; "
                    "printf '# existing rc.local\\n' > fake-root/etc/rc.local; "
                    "root=$PWD/fake-root; "
                    "./grit recovery install --method rc-local --action command --dry-run "
                    "--root \"$root\" --name bbx_itest -- 'grit rshell start' > recovery-dry-run.out; "
                    "grep -q 'Would install persistence method=rc-local' recovery-dry-run.out; "
                    "grep -q 'Action: command' recovery-dry-run.out; "
                    "grep -q 'Generated command: grit rshell start' recovery-dry-run.out; "
                    "./grit recovery install --method rc-local --action command --apply "
                    "--root \"$root\" --name bbx_itest -- 'grit rshell start' > recovery-install.out; "
                    "test -x fake-root/usr/bin/bbx_itest; "
                    "grep -q 'BEGIN GRIT RECOVERY grit_itest' fake-root/etc/rc.local; "
                    "grep -q 'action=command' fake-root/etc/rc.local; "
                    "./grit recovery status --json --root \"$root\" --name bbx_itest > recovery-fakeroot-status.json; "
                    "grep -q '\"installed\":true' recovery-fakeroot-status.json; "
                    "grep -q '\"method\":\"rc-local\"' recovery-fakeroot-status.json; "
                    "grep -q '\"action\":\"command\"' recovery-fakeroot-status.json; "
                    "grep -q '\"generated_command\":\"grit rshell start\"' recovery-fakeroot-status.json; "
                    "./grit recovery uninstall --method rc-local --apply "
                    "--root \"$root\" --name bbx_itest > recovery-uninstall.out; "
                    "./grit recovery status --json --root \"$root\" --name bbx_itest > recovery-fakeroot-after.json; "
                    "grep -q '\"installed\":false' recovery-fakeroot-after.json; "
                    "test ! -e fake-root/usr/bin/bbx_itest; "
                    "! grep -q 'BEGIN GRIT RECOVERY grit_itest' fake-root/etc/rc.local; "
                    "./grit recovery install --method rc-local --action evidence-push --dry-run "
                    "--root \"$root\" --name bbx_itest > recovery-evidence-dry-run.out; "
                    "grep -q 'Action: evidence-push' recovery-evidence-dry-run.out; "
                    "grep -q 'Generated command: /usr/bin/bbx_itest evidence push --quiet' recovery-evidence-dry-run.out; "
                    "./grit recovery install --method rc-local --action evidence-push --apply "
                    "--root \"$root\" --name bbx_itest > recovery-evidence-install.out; "
                    "grep -q 'action=evidence-push' fake-root/etc/rc.local; "
                    "grep -q '/usr/bin/bbx_itest evidence push --quiet' fake-root/etc/rc.local; "
                    "./grit recovery status --json --root \"$root\" --name bbx_itest > recovery-evidence-status.json; "
                    "grep -q '\"action\":\"evidence-push\"' recovery-evidence-status.json; "
                    "grep -q '\"action_category\":\"evidence\"' recovery-evidence-status.json; "
                    "grep -q '\"uploads_evidence\":true' recovery-evidence-status.json; "
                    "grep -q '\"executes_operator_supplied_command\":false' recovery-evidence-status.json; "
                    "./grit recovery uninstall --method rc-local --apply "
                    "--root \"$root\" --name bbx_itest > recovery-evidence-uninstall.out; "
                    "./grit recovery install --method rc-local --action evidence-then-rshell --apply "
                    "--root \"$root\" --name bbx_itest > recovery-evidence-rshell-install.out; "
                    "grep -q 'action=evidence-then-rshell' fake-root/etc/rc.local; "
                    "grep -q '/usr/bin/bbx_itest evidence push --quiet && /usr/bin/bbx_itest rshell start' fake-root/etc/rc.local; "
                    "./grit recovery status --json --root \"$root\" --name bbx_itest > recovery-evidence-rshell-status.json; "
                    "grep -q '\"action\":\"evidence-then-rshell\"' recovery-evidence-rshell-status.json; "
                    "grep -q '\"starts_rshell\":true' recovery-evidence-rshell-status.json; "
                    "grep -q '\"starts_rshell_after_evidence\":true' recovery-evidence-rshell-status.json; "
                    "./grit recovery uninstall --method rc-local --apply "
                    "--root \"$root\" --name bbx_itest > recovery-evidence-rshell-uninstall.out; "
                    "./grit recovery install --method rc-local --action dmesg-push --dry-run "
                    "--root \"$root\" --name bbx_itest > recovery-dmesg-dry-run.out; "
                    "grep -q 'Action: dmesg-push' recovery-dmesg-dry-run.out; "
                    "grep -q 'dmesg >\"$bbx_dmesg\"' recovery-dmesg-dry-run.out; "
                    "grep -q -- '--dest bbx_itest-dmesg.txt' recovery-dmesg-dry-run.out; "
                    "./grit recovery install --method rc-local --action dmesg-push --apply "
                    "--root \"$root\" --name bbx_itest > recovery-dmesg-install.out; "
                    "grep -q 'action=dmesg-push' fake-root/etc/rc.local; "
                    "grep -q 'rm -f \"$bbx_dmesg\"' fake-root/etc/rc.local; "
                    "./grit recovery status --json --root \"$root\" --name bbx_itest > recovery-dmesg-status.json; "
                    "grep -q '\"action\":\"dmesg-push\"' recovery-dmesg-status.json; "
                    "grep -q '\"collects_dmesg\":true' recovery-dmesg-status.json; "
                    "grep -q '\"uploads_evidence\":true' recovery-dmesg-status.json")


def case_no_residue_cleanup(ctx):
    run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                    "./grit sh -c 'echo nores-ok' > nores.out; "
                    "grep -q '^nores-ok$' nores.out; "
                    "test ! -e .grit-nores; "
                    "./grit sh -c 'while :; do sleep 1; done' >/dev/null 2>nores-term.err & "
                    "pid=$!; i=0; "
                    "while [ ! -e .grit-nores ]; do "
                    "i=$((i + 1)); "
                    "if [ \"$i\" -gt 80 ]; then kill \"$pid\" 2>/dev/null || true; exit 1; fi; "
                    "sleep 0.1; "
                    "done; "
                    "kill -TERM \"$pid\"; "
                    "if wait \"$pid\"; then exit 1; else rc=$?; [ \"$rc\" -eq 143 ]; fi; "
                    "test ! -e .grit-nores")


def case_default_extract_help(ctx):
    action = ("./grit > zero-arg.out 2>&1 || true; "
              "grep -Ei 'usage|grit|commands' zero-arg.out; "
              "./grit extract > extract.out 2>&1; "
              "./grit doctor > doctor.out 2>&1; "
              "./grit config-info > config-info.out 2>&1; "
              "grep -q '^runtime_root=./.grit' config-info.out; "
              "test -d .grit/payload/bin")
    validate_root_ssh_unchanged(ctx["host"], ctx["remote_dir"], ctx["case_dir"], action)


def case_builtin_core_shell(ctx):
    marker = "GRIT_ITEST_BUILTIN_OK"
    server, log_file = start_shell_server(ctx["case_dir"], "tls-shell", ctx["args"].shell_port,
                                          marker, ctx["args"])
    try:
        run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                        "./grit rshell start > rshell-start.out 2>&1 || cat rshell-start.out",
                        timeout=ctx["args"].session_timeout + 30, check=False)
        rc = wait_server(server, log_file, ctx["args"].session_timeout + 30)
        if rc != 0:
            raise RuntimeError(f"scripted TLS shell server failed with exit {rc}")
    finally:
        if server.poll() is None:
            server.terminate()


def case_zero_arg_builtin(ctx):
    marker = "GRIT_ITEST_ZERO_ARG_OK"
    server, log_file = start_shell_server(ctx["case_dir"], "tls-shell", ctx["args"].shell_port,
                                          marker, ctx["args"])
    try:
        run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                        "./grit > zero-arg.out 2>&1 || true; sleep 1; "
                        "./grit rshell status > status-running.out 2>&1 || true",
                        timeout=60, check=False)
        rc = wait_server(server, log_file, ctx["args"].session_timeout + 30)
        if rc != 0:
            raise RuntimeError(f"scripted zero-arg TLS shell server failed with exit {rc}")
        run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                        "./grit rshell stop > stop.out 2>&1 || true; "
                        "./grit rshell status > status-stopped.out 2>&1 || true",
                        timeout=60, check=False)
    finally:
        if server.poll() is None:
            server.terminate()


def case_socat_rescue(ctx):
    marker = "GRIT_ITEST_SOCAT_OK"
    probe = run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                            "./grit extract >/dev/null 2>&1 || true; "
                            "test -x .grit/payload/bin/socat; "
                            "./grit socat -hh > socat-help.out 2>&1 || true; "
                            "grep -Eq 'OPENSSL|SSL-L' socat-help.out",
                            timeout=60, check=False)
    if probe.returncode != 0:
        raise SkipCase("staged socat lacks OPENSSL address support on this static target")
    server, log_file = start_shell_server(ctx["case_dir"], "tls-shell", ctx["args"].shell_port,
                                          marker, ctx["args"])
    try:
        run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                        "./grit rshell start > rshell-start.out 2>&1 || cat rshell-start.out",
                        timeout=ctx["args"].session_timeout + 30, check=False)
        rc = wait_server(server, log_file, ctx["args"].session_timeout + 30)
        if rc != 0:
            raise RuntimeError(f"scripted socat TLS shell server failed with exit {rc}")
    finally:
        if server.poll() is None:
            server.terminate()


def case_ssh_operator(ctx):
    config = write_operator_server_config(ctx["case_dir"], ctx["args"])
    log_file = (ctx["case_dir"] / "server.log").open("wb")
    server = subprocess.Popen([
        sys.executable, "-u", "scripts/grit-server",
        "--config", str(config),
        "--transport", "ssh",
        "--ssh-port", str(ctx["args"].ssh_port),
        "--forward-port", str(ctx["args"].forward_port),
        "--timeout", str(ctx["args"].connect_timeout),
    ], cwd=ROOT, stdout=log_file, stderr=subprocess.STDOUT)
    try:
        time.sleep(1)
        validate_root_ssh_unchanged(
            ctx["host"], ctx["remote_dir"], ctx["case_dir"],
            "./grit rshell start > rshell-start.out 2>&1 || true; sleep 4",
        )
        marker = "GRIT_ITEST_SSH_OK"
        ssh_log = ctx["case_dir"] / "operator-ssh.log"
        cmd = [
            "ssh",
            "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "ConnectTimeout=2",
            "-i", "local/operator-session/operator_ed25519",
            "-p", str(ctx["args"].forward_port),
            "root@127.0.0.1",
            f"echo {marker}; uname -m",
        ]
        ok = False
        for _ in range(10):
            proc = run_cmd(cmd, timeout=10, log_path=ssh_log)
            if proc.returncode == 0 and marker.encode() in proc.stdout:
                ok = True
                break
            time.sleep(1)
        if not ok:
            raise RuntimeError("reverse SSH forward did not produce marker output")
        run_remote_case(ctx["host"], ctx["remote_dir"], ctx["case_dir"],
                        "./grit rshell status > status-running.out 2>&1 || true; "
                        "./grit rshell stop > stop.out 2>&1 || true; "
                        "./grit rshell status > status-stopped.out 2>&1 || true",
                        timeout=60, check=False)
    finally:
        if server.poll() is None:
            server.terminate()
            try:
                server.wait(timeout=10)
            except subprocess.TimeoutExpired:
                server.kill()
        log_file.close()


CASE_FUNCS = {
    "survey-core": case_survey_core,
    "trailer-runtime-override": case_trailer_runtime_override,
    "recovery-fakeroot": case_recovery_fakeroot,
    "no-residue-cleanup": case_no_residue_cleanup,
    "default-extract-help": case_default_extract_help,
    "builtin-core-shell": case_builtin_core_shell,
    "zero-arg-builtin": case_zero_arg_builtin,
    "socat-rescue": case_socat_rescue,
    "ssh-operator": case_ssh_operator,
}


def run_case(case, args, run_dir, operator_host):
    case_dir = run_dir / case
    case_dir.mkdir(parents=True, exist_ok=True)
    remote_dir = args.remote_dir or f"/tmp/grit-itest-{int(time.time())}-{case}"
    result = {
        "case": case,
        "status": "fail",
        "logs": str(case_dir),
        "remote_dir": remote_dir,
        "phases": {
            "build": "pending",
            "transfer": "pending",
            "run": "pending",
            "validation": "pending",
            "cleanup": "pending",
        },
    }
    started = time.monotonic()
    try:
        config = write_case_config(case_dir, case, operator_host, args)
        result["config"] = str(config)
        artifact = Path(args.artifact) if args.artifact else build_artifact(case_dir, args.target_preset, config, args)
        artifact = apply_case_artifact_overrides(case, artifact, case_dir)
        result["artifact"] = str(artifact)
        result["artifact_sha256"] = sha256(artifact)
        result["artifact_size"] = artifact.stat().st_size
        mark_phase(result, "build", "pass")
        prepare_remote(args.host, remote_dir, artifact, case_dir)
        collect_target_facts(args.host, remote_dir, case_dir)
        mark_phase(result, "transfer", "pass")
        CASE_FUNCS[case]({
            "host": args.host,
            "remote_dir": remote_dir,
            "case_dir": case_dir,
            "args": args,
            "operator_host": operator_host,
        })
        mark_phase(result, "run", "pass")
        capture_grit_outputs(args.host, remote_dir, case_dir)
        mark_phase(result, "validation", "pass")
        result["status"] = "pass"
    except SkipCase as exc:
        result["status"] = "skip"
        result["reason"] = str(exc)
        for phase, status in result["phases"].items():
            if status == "pending":
                mark_phase(result, phase, "skip")
        log(f"{case}: SKIP: {exc}")
    except Exception as exc:
        result["error"] = str(exc)
        for phase, status in result["phases"].items():
            if status == "pending":
                mark_phase(result, phase, "fail")
                break
        log(f"{case}: FAIL: {exc}")
    finally:
        try:
            cleanup_remote(args.host, remote_dir, case_dir, args.keep_remote)
            mark_phase(result, "cleanup", "pass")
        except Exception as exc:
            mark_phase(result, "cleanup", "fail")
            result["cleanup_error"] = str(exc)
            if result["status"] == "pass":
                result["status"] = "fail"
                result["error"] = str(exc)
            log(f"{case}: cleanup failed: {exc}")
        result["duration_sec"] = round(time.monotonic() - started, 3)
        event_log = case_dir / "operator-session" / "events.jsonl"
        if event_log.is_file():
            result["operator_event_log"] = str(event_log)
    return result


def aggregate_operator_events(run_dir, summary):
    combined = run_dir / "operator-events.jsonl"
    count = 0
    with combined.open("w", encoding="utf-8") as out:
        for case in summary.get("cases", []):
            path = case.get("operator_event_log")
            if not path:
                continue
            event_log = Path(path)
            if not event_log.is_file():
                continue
            for line in event_log.read_text(encoding="utf-8", errors="replace").splitlines():
                if not line.strip():
                    continue
                out.write(line.rstrip() + "\n")
                count += 1
    if count:
        summary["event_log"] = str(combined)
        summary["event_count"] = count
    else:
        try:
            combined.unlink()
        except FileNotFoundError:
            pass


def check_target(args, run_dir):
    proc = ssh_cmd(args.host, "true", timeout=10, log_path=run_dir / "target-reachability.log")
    if proc.returncode == 0:
        return True
    msg = f"target unreachable: {args.host}"
    if args.require_target:
        raise RuntimeError(msg)
    return False


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Run griTTYkit integration cases on a GL.iNet exemplar.")
    parser.add_argument("--host", default=os.environ.get("ROUTER", "root@192.168.8.1"))
    parser.add_argument("--operator-host", default=os.environ.get("OPERATOR_HOST", "auto"))
    parser.add_argument("--target-preset", default=DEFAULT_TARGET)
    parser.add_argument("--case", action="append", choices=ALL_CASES + ["list"],
                        help="case to run; repeatable; use 'list' to show cases")
    parser.add_argument("--all-safe", action="store_true",
                        help="run safe non-root-writing cases")
    parser.add_argument("--include-root-write-tests", action="store_true",
                        help="reserved for explicit root-copy/root-merge tests")
    parser.add_argument("--require-target", action="store_true",
                        help="fail instead of skip when the router is unreachable")
    parser.add_argument("--remote-dir",
                        help="remote workdir; defaults to /tmp/grit-itest-<timestamp>-<case>")
    parser.add_argument("--keep-remote", action="store_true")
    parser.add_argument("--keep-local", action="store_true",
                        help="accepted for symmetry; logs are always kept under local/integration-runs")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--artifact",
                        help="reuse an existing artifact instead of building per case")
    parser.add_argument("--payload-format", default=os.environ.get("PAYLOAD_FORMAT", "tgz"))
    parser.add_argument("--ssh-port", type=int, default=PORTS["ssh"])
    parser.add_argument("--shell-port", type=int, default=PORTS["shell"])
    parser.add_argument("--forward-port", type=int, default=PORTS["forward"])
    parser.add_argument("--dropbear-port", type=int, default=PORTS["dropbear"])
    parser.add_argument("--timeout", type=int, default=120)
    parser.add_argument("--build-timeout", type=int, default=1800)
    parser.add_argument("--connect-timeout", type=int, default=60)
    parser.add_argument("--session-timeout", type=int, default=45)
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    if args.case and "list" in args.case:
        print("\n".join(ALL_CASES))
        return 0
    cases = args.case or (SAFE_CASES if args.all_safe else ["survey-core"])
    operator_host = local_operator_host(args.host) if args.operator_host == "auto" else args.operator_host
    run_dir = RUN_ROOT / time.strftime("%Y%m%d-%H%M%S")
    run_dir.mkdir(parents=True, exist_ok=True)
    summary = {
        "status": "fail",
        "host": args.host,
        "operator_host": operator_host,
        "target_preset": args.target_preset,
        "log_dir": str(run_dir),
        "cases": [],
    }
    (run_dir / "args.json").write_text(json.dumps(vars(args), indent=2) + "\n", encoding="utf-8")
    log(f"integration logs: {run_dir}")
    log(f"operator host: {operator_host}")
    if args.dry_run:
        summary["status"] = "dry-run"
        summary["cases"] = [{"case": c, "status": "planned"} for c in cases]
        aggregate_operator_events(run_dir, summary)
        (run_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
        print(json.dumps(summary, indent=2))
        return 0
    if not check_target(args, run_dir):
        summary["status"] = "skip"
        summary["reason"] = f"target unreachable: {args.host}"
        aggregate_operator_events(run_dir, summary)
        (run_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
        print(json.dumps(summary, indent=2))
        return 0
    for case in cases:
        log(f"case {case}: start")
        result = run_case(case, args, run_dir, operator_host)
        summary["cases"].append(result)
        log(f"case {case}: {result['status']}")
    if all(c["status"] == "pass" for c in summary["cases"]):
        summary["status"] = "pass"
    elif all(c["status"] in ("pass", "skip") for c in summary["cases"]):
        summary["status"] = "pass"
    elif any(c["status"] == "pass" for c in summary["cases"]):
        summary["status"] = "partial"
    summary["counts"], summary["failure_reasons"] = summarize_cases(summary["cases"])
    aggregate_operator_events(run_dir, summary)
    (run_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(summary, indent=2))
    return 0 if summary["status"] in ("pass", "skip") else 1


if __name__ == "__main__":
    raise SystemExit(main())
