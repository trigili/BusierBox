#!/usr/bin/env python3
"""Inspect and edit BusierBox post-build runtime override trailers."""

import hashlib
import os
import pathlib
import secrets
import stat
import sys
import tempfile


MAGIC = b"BBXCONFIGv1"
TRAILER_SIZE = 4096

ALLOWED_KEYS = {
    "BB_RUNTIME_MODE",
    "BB_RUNTIME_ROOT",
    "BB_RUNTIME_ALLOW_FALLBACK_ROOT",
    "BB_RUNTIME_FALLBACK_ROOT",
    "BB_ZERO_ARG_MODE",
    "BB_ZERO_ARG_LOG_MODE",
    "BB_ZERO_ARG_CUSTOM_COMMAND",
    "BB_RSHELL_TRANSPORT",
    "BB_RSHELL_ENCRYPTION",
    "BB_RSHELL_ALLOW_PLAINTEXT",
    "BB_RSHELL_AUTHKEYS_MODE",
    "BB_RSHELL_RUN_MODE",
    "BB_RSHELL_SESSION_POLICY",
    "BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING",
    "BB_RSHELL_SOCAT_PORT",
    "BB_RSHELL_SHELL_PROVIDER",
    "BB_RSHELL_CUSTOM_SHELL",
    "BB_RSHELL_RETRY_COUNT",
    "BB_RSHELL_RETRY_INTERVAL_SEC",
    "BB_RSHELL_RETRY_JITTER_PCT",
    "BB_RSHELL_RETRY_BACKOFF",
    "BB_RSHELL_RETRY_MAX_INTERVAL_SEC",
    "BB_AUTORUN_GUARD_ENABLE",
    "BB_AUTORUN_GUARD_PATH",
    "BB_AUTORUN_REENTRY_ACTION",
    "BB_AUTORUN_STALE_LOCK_POLICY",
    "BB_OPERATOR_REMOTE_FORWARD_PORT",
    "BB_OPERATOR_SERVER_HOST",
    "BB_OPERATOR_SERVER_USER",
    "BB_OPERATOR_SERVER_SSH_PORT",
    "BB_OPERATOR_TARGET_BIND_HOST",
    "BB_OPERATOR_TARGET_DROPBEAR_PORT",
    "BB_OPERATOR_KNOWN_HOSTS_POLICY",
    "BB_OPERATOR_FILE_SERVICE_ENABLE",
    "BB_OPERATOR_FILE_SERVICE_PORT",
    "BB_OPERATOR_FILE_SERVICE_TLS",
}


def die(msg, code=1):
    print(f"artifact-config: {msg}", file=sys.stderr)
    raise SystemExit(code)


def usage():
    print(
        """usage:
  scripts/artifact-config show ARTIFACT
  scripts/artifact-config export ARTIFACT
  scripts/artifact-config set [--obfuscation none|xor] [--key HEX] ARTIFACT KEY=VALUE...
  scripts/artifact-config import [--obfuscation none|xor] [--key HEX] ARTIFACT FILE|-
  scripts/artifact-config clear ARTIFACT

Only selected runtime/operator keys are accepted. Target tuple, payload tools,
dotfiles, overlays, and compiled feature keys are intentionally rejected.
XOR obfuscation is casual string hiding only; it is not encryption.""",
        file=sys.stderr,
    )
    raise SystemExit(2)


def has_trailer(data):
    return len(data) >= TRAILER_SIZE and data[-TRAILER_SIZE : -TRAILER_SIZE + len(MAGIC)] == MAGIC


def strip_trailer(data):
    return data[:-TRAILER_SIZE] if has_trailer(data) else data


def parse_kv(text, reject_unknown=True):
    vals = {}
    for lineno, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            die(f"line {lineno}: expected KEY=VALUE")
        key, val = line.split("=", 1)
        if key not in ALLOWED_KEYS:
            if reject_unknown:
                die(f"key is not trailer-overridable: {key}")
            continue
        reject_secret_like_value(key, val)
        vals[key] = val
    return vals


def reject_secret_like_value(key, val):
    upper = val.upper()
    secret_markers = (
        "-----BEGIN OPENSSH PRIVATE KEY-----",
        "-----BEGIN RSA PRIVATE KEY-----",
        "-----BEGIN DSA PRIVATE KEY-----",
        "-----BEGIN EC PRIVATE KEY-----",
        "-----BEGIN PRIVATE KEY-----",
        "PASSWORD=",
        "PASSWD=",
        "TOKEN=",
        "PRIVATE_KEY=",
    )
    if any(marker in upper for marker in secret_markers):
        die(f"refusing secret-like trailer value for {key}")


def decode_trailer(data, reject_unknown=False):
    if not has_trailer(data):
        return {"present": False, "valid": False, "status": "absent", "values": {}}
    raw = data[-TRAILER_SIZE:].split(b"\0", 1)[0]
    try:
        text = raw.decode("ascii")
    except UnicodeDecodeError:
        return {"present": True, "valid": False, "status": "metadata is not ascii", "values": {}}
    lines = text.splitlines()
    if not lines or lines[0] != MAGIC.decode():
        return {"present": True, "valid": False, "status": "bad magic", "values": {}}
    meta = {}
    payload_lines = []
    in_payload = False
    for line in lines[1:]:
        if not in_payload and line == "ENDMETA":
            in_payload = True
            continue
        if in_payload:
            payload_lines.append(line)
            continue
        if "=" in line:
            key, val = line.split("=", 1)
            meta[key] = val
    try:
        size = int(meta.get("size", "0"))
        offset = int(meta.get("payload_offset", "0"))
    except ValueError:
        return {"present": True, "valid": False, "status": "non-integer size/offset", "values": {}, "meta": meta}
    if meta.get("version") != "1":
        return {"present": True, "valid": False, "status": "unsupported version", "values": {}, "meta": meta}
    if size <= 0 or offset <= 0 or offset + size > len(raw):
        return {"present": True, "valid": False, "status": "payload bounds invalid", "values": {}, "meta": meta}
    payload = bytearray(raw[offset : offset + size])
    payload_format = meta.get("payload_format", "raw")
    if payload_format == "hex":
        try:
            payload = bytearray(bytes.fromhex(payload.decode("ascii")))
        except (UnicodeDecodeError, ValueError):
            return {"present": True, "valid": False, "status": "invalid hex payload", "values": {}, "meta": meta}
    elif payload_format != "raw":
        return {"present": True, "valid": False, "status": f"unsupported payload format {payload_format}", "values": {}, "meta": meta}
    encoding = meta.get("encoding", "plain")
    if encoding == "xor":
        try:
            key = bytes.fromhex(meta.get("key_hex", ""))
        except ValueError:
            return {"present": True, "valid": False, "status": "invalid xor key", "values": {}, "meta": meta}
        if not key:
            return {"present": True, "valid": False, "status": "missing xor key", "values": {}, "meta": meta}
        for i in range(len(payload)):
            payload[i] ^= key[i % len(key)]
    elif encoding != "plain":
        return {"present": True, "valid": False, "status": f"unsupported encoding {encoding}", "values": {}, "meta": meta}
    got = hashlib.sha256(payload).hexdigest()
    if got != meta.get("sha256"):
        return {"present": True, "valid": False, "status": "checksum mismatch", "values": {}, "meta": meta}
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError:
        return {"present": True, "valid": False, "status": "payload is not utf-8", "values": {}, "meta": meta}
    vals = parse_kv(payload_text, reject_unknown=reject_unknown)
    return {"present": True, "valid": True, "status": "ok", "values": vals, "meta": meta, "payload": payload_text}


def normalize_options(args):
    mode = os.environ.get("BB_TRAILER_OBFUSCATION", "none")
    key_hex = os.environ.get("BB_TRAILER_XOR_KEY", "")
    rest = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--obfuscation":
            i += 1
            if i >= len(args):
                usage()
            mode = args[i]
        elif arg.startswith("--obfuscation="):
            mode = arg.split("=", 1)[1]
        elif arg == "--key":
            i += 1
            if i >= len(args):
                usage()
            key_hex = args[i]
        elif arg.startswith("--key="):
            key_hex = arg.split("=", 1)[1]
        else:
            rest.append(arg)
        i += 1
    if mode not in {"none", "xor"}:
        die("obfuscation must be none or xor", 2)
    if key_hex:
        try:
            key = bytes.fromhex(key_hex)
        except ValueError:
            die("--key must be hex", 2)
        if not key:
            die("--key must not be empty", 2)
    return mode, key_hex, rest


def build_trailer(values, mode="none", key_hex=""):
    payload = "".join(f"{key}={values[key]}\n" for key in sorted(values)).encode("utf-8")
    sha = hashlib.sha256(payload).hexdigest()
    encoding = "plain"
    encoded = bytearray(payload)
    if mode == "xor":
        encoding = "xor"
        if not key_hex:
            key_hex = secrets.token_hex(16)
        key = bytes.fromhex(key_hex)
        for i in range(len(encoded)):
            encoded[i] ^= key[i % len(key)]
    trailer_payload = bytes(encoded)
    payload_format = "raw"
    if encoding == "xor":
        # Keep the fixed-size trailer ASCII-safe; raw XOR can contain NUL bytes.
        trailer_payload = bytes(encoded).hex().encode("ascii")
        payload_format = "hex"
    meta_prefix = (
        f"{MAGIC.decode()}\n"
        "version=1\n"
        f"encoding={encoding}\n"
        f"payload_format={payload_format}\n"
        f"size={len(trailer_payload)}\n"
        f"sha256={sha}\n"
        f"key_hex={key_hex if encoding == 'xor' else ''}\n"
    )
    offset = 0
    while True:
        next_offset = len((meta_prefix + f"payload_offset={offset}\nENDMETA\n").encode("ascii"))
        if next_offset == offset:
            break
        offset = next_offset
    meta = meta_prefix + f"payload_offset={offset}\nENDMETA\n"
    trailer = meta.encode("ascii") + trailer_payload
    if len(trailer) > TRAILER_SIZE:
        die("override trailer too large")
    return trailer + b"\0" * (TRAILER_SIZE - len(trailer))


def replace_file(path, data):
    st = path.stat()
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp_name, stat.S_IMODE(st.st_mode))
        os.replace(tmp_name, path)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def read_import(path):
    if path == "-":
        return sys.stdin.read()
    return pathlib.Path(path).read_text(encoding="utf-8")


def main(argv):
    if len(argv) < 2 or argv[1] in {"--help", "-h"}:
        usage()
    cmd = argv[1]
    if cmd in {"show", "export", "clear"}:
        if len(argv) != 3:
            usage()
        artifact = pathlib.Path(argv[2])
        data = artifact.read_bytes()
        info = decode_trailer(data)
        if cmd == "clear":
            replace_file(artifact, strip_trailer(data))
            print(f"cleared {artifact}")
            return 0
        if cmd == "show":
            print(f"artifact={artifact}")
            print(f"trailer_present={'yes' if info['present'] else 'no'}")
            print(f"trailer_valid={'yes' if info['valid'] else 'no'}")
            print(f"trailer_status={info['status']}")
            meta = info.get("meta") or {}
            for key in ("version", "encoding", "size", "payload_offset", "sha256"):
                if key in meta:
                    print(f"{key}={meta[key]}")
            for key, val in sorted(info["values"].items()):
                print(f"{key}={val}")
            return 0 if info["valid"] or not info["present"] else 1
        for key, val in sorted(info["values"].items()):
            print(f"{key}={val}")
        return 0 if info["valid"] or not info["present"] else 1

    if cmd in {"set", "import"}:
        mode, key_hex, rest = normalize_options(argv[2:])
        if cmd == "set":
            if len(rest) < 2:
                usage()
            artifact = pathlib.Path(rest[0])
            new_values = parse_kv("\n".join(rest[1:]))
        else:
            if len(rest) != 2:
                usage()
            artifact = pathlib.Path(rest[0])
            new_values = parse_kv(read_import(rest[1]))
        data = artifact.read_bytes()
        existing = decode_trailer(data, reject_unknown=False)
        values = dict(existing["values"]) if existing["valid"] else {}
        values.update(new_values)
        trailer = build_trailer(values, mode=mode, key_hex=key_hex)
        replace_file(artifact, strip_trailer(data) + trailer)
        print(f"updated {artifact}: {len(values)} override(s), obfuscation={mode}")
        if mode == "xor":
            print("warning=XOR obfuscation is not encryption and does not protect secrets")
        return 0

    usage()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
