                    print(f"    {line}")
                for line in artifact_provider_status_lines(artifact):
                    print(f"    {line}")
                for line in artifact_doom_wad_lines(artifact):
                    print(f"    {line}")
                print(f"    stage: scripts/busierbox-server --stage-release-artifact {shquote(artifact.get('release_path') or artifact.get('name', ''))}")
        else:
            print("  artifacts: none")
        print("Release recommendations:")
        recommendation_lines = release_recommendation_lines(rel)
        if recommendation_lines:
            for line in recommendation_lines:
                print(f"  {line}")
        else:
            print("  none")
        print("Release devices:")
        for device in rel.get("devices", [])[:12] or [{"name": "none", "tuple_path": ""}]:
            print(f"  {device.get('name', '')} -> {device.get('tuple_path', '')} artifacts={device.get('artifact_count', len(device.get('artifacts') or []))}")
            for path in (device.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")
        print("Release tuples:")
        for item in rel.get("tuples", [])[:12] or [{"path": "none"}]:
            print(f"  {item.get('path', '')} artifacts={item.get('artifact_count', len(item.get('artifacts') or []))}")
            for path in (item.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")


def start_service_process(cfg, service, argv_extra=None):
    current = {row["name"]: row for row in service_status_rows(cfg)}.get(service)
    if current and current.get("actual") == "listening":
        append_event(
            cfg,
            service,
            "service_start_skipped",
            details={
                "reason": "already-listening",
                "port": current.get("port", 0),
                "listener_pids": current.get("listener_pids") or [],
                "pid": current.get("pid", ""),
            },
        )
        print(f"{service}: already listening on port {current.get('port', '')}; not starting duplicate")
        return None
    cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--config",
        str(Path(str(cfg.get("_config_path", DEFAULT_CONFIG)))),
        "--transport",
        service,
    ]
    cmd.extend(["--state-file", str(state_file_path(cfg)), "--staged-file", str(staged_file_path(cfg))])
    if service == "file-service":
        cmd.extend(["--file-service-tls", str(cfg.get("file_service_tls", "yes"))])
    if argv_extra:
        cmd.extend(argv_extra)
    log_root = Path(str(cfg.get("session_root", "local/sessions")))
    log_root.mkdir(parents=True, exist_ok=True)
    log_path = log_root / f"operator-{service}-{int(time.time())}.log"
    cmd.extend(["--managed-by", str(os.getpid()), "--process-log", str(log_path)])
    with log_path.open("ab") as log:
        proc = start_child_process(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    update_server_state(cfg, service, "starting", {"pid": proc.pid, "managed_by": os.getpid(), "process_log": str(log_path)})
    append_event(cfg, service, "service_start_requested", details={"pid": proc.pid, "process_log": str(log_path), "managed_by": os.getpid()})
    started = cfg.setdefault("_workbench_started_services", [])
    if service not in started:
        started.append(service)
    print(f"started {service}: pid={proc.pid} log={log_path}")
    return proc


def stop_workbench_started_services(cfg):
    for service in reversed(cfg.get("_workbench_started_services") or []):
        stop_recorded_service(cfg, service)
    cfg["_workbench_started_services"] = []


def stop_recorded_service(cfg, service):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    rec = (state.get("services") or {}).get(service, {})
    pid = rec.get("pid")
    if not pid:
        print(f"{service}: no recorded pid")
        mark_service_stopped(cfg, service, "workbench-stop:no-pid")
        append_event(cfg, service, "service_stop", details={"reason": "no-pid", "via": "workbench-stop"})
        return
    if not pid_alive(pid):
        print(f"{service}: stale pid {pid}; marked stopped")
        mark_service_stopped(cfg, service, "workbench-stop:stale-pid")
        append_event(cfg, service, "service_stop", details={"pid": pid, "reason": "stale-pid", "via": "workbench-stop"})
        return
    ownership_evidence = managed_server_evidence(pid, cfg=cfg, rec=rec)
    if not ownership_evidence:
        print(f"{service}: skipped pid {pid}; not clearly a managed busierbox-server process")
        append_event(cfg, service, "service_stop_skipped", details={"pid": pid, "reason": "unmanaged-pid", "via": "workbench-stop"})
        return
    try:
        append_event(cfg, service, "shutdown", details={"pid": pid, "reason": "SIGTERM", "via": "workbench-stop", "ownership_evidence": ownership_evidence})
        os.kill(int(pid), signal.SIGTERM)
        if wait_service_port_released(cfg, service, pid=pid):
            print(f"stopped {service}: pid={pid}; port released")
            mark_service_stopped(cfg, service, "workbench-stop:SIGTERM")
            append_event(cfg, service, "service_stop", details={"pid": pid, "via": "workbench-stop", "ownership_evidence": ownership_evidence, "port_released": True})
        else:
            raise TimeoutError(f"listener port {service_port(cfg, service)} still appears bound after SIGTERM")
    except OSError as exc:
        mark_service_error(cfg, service, exc)
        print(f"{service}: unable to stop pid {pid}: {exc}", file=sys.stderr)
    except TimeoutError as exc:
        mark_service_error(cfg, service, exc)
        append_event(cfg, service, "service_stop_failed", "error", details={"pid": pid, "reason": "port-still-bound", "via": "workbench-stop", "error": str(exc)})
        print(f"{service}: unable to stop pid {pid}: {exc}", file=sys.stderr)


def run_line_tui(cfg):
    def line_input(prompt):
        sys.stdout.write(prompt)
        sys.stdout.flush()
        while not SHUTDOWN.is_set():
            try:
                ready, _w, _x = select.select([sys.stdin], [], [], 0.5)
            except (OSError, ValueError):
                request_shutdown("input_error")
                return None
            if not ready:
                continue
            line = sys.stdin.readline()
            if line == "":
                request_shutdown("input_eof")
                return None
            return line.rstrip("\n")
        return None

    while not SHUTDOWN.is_set():
        print("")
        print_workbench(cfg, include_api_summary=False)
        print("")
        print("Actions:")
        print("  1 start ssh")
        print("  2 start tls-shell")
        print("  3 start plain-shell")
        print("  4 start file-service")
        print("  5 stop service")
        print("  6 stage file")
        print("  7 list staged")
        print("  8 unstage file")
        print("  9 open local path in pager")
        print("  10 stage release recommendation/device/tuple")
        print("  11 show operator workflow actions")
        print("  12 start background workflow job")
        print("  13 cancel background workflow job")
        print("  14 configure BusierBox build field")
        print("  c show/copy generated commands")
        print("  r refresh")
        print("  ? help")
        print("  q quit")
        line = line_input("> ")
        if line is None:
            break
        choice = line.strip()
        if choice == "q":
            mark_service_stopped(cfg, "workbench", "quit")
            return 0
        if choice in {"1", "2", "3", "4"}:
            service = {"1": "ssh", "2": "tls-shell", "3": "plain-shell", "4": "file-service"}[choice]
            start_service_process(cfg, service)
        elif choice == "5":
            service = line_input("service> ")
            if service is not None:
                stop_recorded_service(cfg, service.strip())
        elif choice == "6":
            path_line = line_input("local file> ")
            name_line = line_input("target request name> ")
            path = path_line.strip() if path_line is not None else ""
            name = name_line.strip() if name_line is not None else ""
            try:
                rec = stage_file(cfg, path, name)
                print(f"staged {rec['request_name']}")
                print(render_fetch_command(rec["request_name"], cfg))
            except ValueError as exc:
                print(exc)
        elif choice == "7":
            print_staged(cfg)
        elif choice == "8" or choice == "d":
            name_line = line_input("target request name> ")
            name = name_line.strip() if name_line is not None else ""
            if name:
                try:
                    print("unstaged" if unstage_file(cfg, name) else "not staged")
                except ValueError as exc:
                    print(exc)
        elif choice == "9" or choice == "v":
            path_line = line_input("local path> ")
            path = path_line.strip() if path_line is not None else ""
            if path:
                print(open_path_in_pager(path))
        elif choice == "10":
            rel = release_context(cfg)
            if not rel:
                print("no release bundle detected")
                continue
            nav = release_nav_records(rel, rel.get("devices") or [], rel.get("tuples") or [], limit=12)
            for idx, rec in enumerate(nav, 1):
                print(f"{idx}: {rec.get('label', '')}")
            selector_line = line_input("release selection number, recommendation id, artifact path, by_device:NAME, or by_tuple_path:PATH> ")
            selector = selector_line.strip() if selector_line is not None else ""
            if selector:
                try:
                    rec = stage_release_selection(cfg, selector)
                    print(f"staged {rec['request_name']}")
                    print(render_fetch_command(rec["request_name"], cfg))
                except ValueError as exc:
                    print(exc)
        elif choice == "11":
            snap = workbench_snapshot(cfg)
            print_workbench_action_summary(snap)
            for idx, rec in enumerate(snap.get("workbench_actions") or [], 1):
                print(f"{idx}: {rec.get('id', '')} {rec.get('label', '')}")
                print(f"   command: {rec.get('command', '')}")
                print(f"   category={rec.get('category', '')} background_supported={'yes' if rec.get('background_supported') else 'no'} confirm={'yes' if rec.get('requires_confirmation') else 'no'}")
            append_event(cfg, "workbench", "workbench_actions_viewed", details={"action_count": len(snap.get("workbench_actions") or [])})
        elif choice == "12":
            snap = workbench_snapshot(cfg)
            runnable = [rec for rec in snap.get("workbench_actions") or [] if rec.get("background_supported")]
            for idx, rec in enumerate(runnable, 1):
                print(f"{idx}: {rec.get('id', '')} {rec.get('command', '')}")
            selected_line = line_input("background action id or number> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if selected:
                try:
                    action = runnable[int(selected) - 1]["id"] if selected.isdigit() else selected
                    rec = start_workbench_job(cfg, action)
                    print(f"started job {rec.get('id', '')}: pid={rec.get('pid', '')} log={rec.get('log_path', '')}")
                    print(f"command: {rec.get('command', '')}")
                except (ValueError, IndexError) as exc:
                    print(exc)
        elif choice == "13":
            snap = workbench_snapshot(cfg)
            for rec in snap.get("workbench_jobs") or []:
                print(f"{rec.get('id', '')}: action={rec.get('action_id', '')} state={rec.get('effective_state', '')} managed={'yes' if rec.get('pid_managed') else 'no'} cancel_supported={'yes' if rec.get('cancel_supported') else 'no'}")
            job_line = line_input("job id> ")
            job_id = job_line.strip() if job_line is not None else ""
            if job_id:
                try:
                    rec = cancel_workbench_job(cfg, job_id)
                    print(f"cancel requested for {rec.get('id', job_id)}")
                except ValueError as exc:
                    print(exc)
        elif choice == "14":
            fields = workbench_config_field_records(cfg)
            for idx, rec in enumerate(fields, 1):
                print(f"{idx}: {rec.get('key', '')}={shell_double_quote(rec.get('value', ''))} category={rec.get('category', '')}")
                print(f"   {rec.get('label', '')}")
                print(f"   command: {rec.get('set_command', '')}")
            selected_line = line_input("build config key or number> ")
            selected = selected_line.strip() if selected_line is not None else ""
            if selected:
                try:
                    rec = fields[int(selected) - 1] if selected.isdigit() else {item.get("key"): item for item in fields}.get(selected, {})
                    key = rec.get("key")
                    if not key:
                        raise ValueError(f"unknown build config field: {selected}")
                    print(f"current {key}={shell_double_quote(rec.get('value', ''))}")
                    print(f"underlying command: scripts/busierbox-server --build-config {shquote(str(build_config_path(cfg)))} --set-build-config {shquote(key + '=VALUE')}")
                    value_line = line_input("new value> ")
                    value = value_line if value_line is not None else ""
                    updated = set_workbench_build_config(cfg, f"{key}={value}")
                    print(f"set {updated.get('key', key)}={shell_double_quote(updated.get('value', value))}")
                except (ValueError, IndexError) as exc:
                    print(exc)
        elif choice == "r":
            rec = record_workbench_refresh(cfg)
            print(f"refreshed workbench at {rec.get('last_refresh_at', '')}")
        elif choice == "c":
            commands = generated_target_commands(cfg)
            for idx, cmd in enumerate(commands, 1):
                print(f"{idx}: {cmd}")
            chosen_line = line_input("copy command number, or blank to skip> ")
            chosen = chosen_line.strip() if chosen_line is not None else ""
            if chosen:
                try:
                    rec = copy_generated_command(cfg, chosen)
                    print(f"copied command to {rec['path']} clipboard={'yes' if rec['clipboard'] else 'no'}")
                except ValueError as exc:
                    print(exc)
        elif choice == "?":
            print("Keys: 1-4 start services, 5 stop, 6 stage file, 10 stage release item, 11 actions, 12 start job, 13 cancel job, 14 config, 8/d unstage, 9/v view, c copy commands, r refresh, q quit.")
    return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0


def run_curses_tui(cfg):
    import curses

    def safe_add(stdscr, row, col, text, attr=0):
        height, width = stdscr.getmaxyx()
        if row < 0 or row >= height or col >= width:
            return
        try:
            stdscr.addstr(row, col, str(text)[:max(0, width - col - 1)], attr)
        except curses.error:
            pass

    def draw_list(stdscr, title, lines, row, col, height, width, selected=False):
        attr = curses.A_REVERSE if selected else curses.A_BOLD
        safe_add(stdscr, row, col, title[:width - 1], attr)
        for idx, line in enumerate(lines[:max(0, height - 1)], 1):
            safe_add(stdscr, row + idx, col, line[:width - 1])

    def selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples):
        if pane == 0 and services:
            row = services[min(selected, len(services) - 1)]
            return row.get("session_log") or row.get("process_log") or ""
        if pane == 1 and staged_names:
            rec = snap["staged"][staged_names[min(selected, len(staged_names) - 1)]]
            return rec.get("source_path", "")
        if pane == 2 and snap["uploads"]:
            rec = snap["uploads"][min(selected, len(snap["uploads"]) - 1)]
            return rec.get("metadata_path") or rec.get("_metadata_path") or rec.get("stored_path") or ""
        if pane == 3 and snap["sessions"]:
            rec = snap["sessions"][min(selected, len(snap["sessions"]) - 1)]
            return rec.get("path", "")
        if pane == 4:
            return str(Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "events.jsonl")
        if pane == 5:
            return ""
        if pane == 6 and release_artifacts:
            rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
            return rec.get("path", "")
        if pane == 7:
            combined = release_nav_records(release, release_devices, release_tuples)
            rec = combined[min(selected, len(combined) - 1)] if combined else {}
            record = rec.get("record") or {}
            artifact_paths = record.get("artifact_paths") or []
            return rec.get("path") or record.get("filesystem_path") or record.get("path") or (artifact_paths[0] if artifact_paths else "") or release.get("release_json", "")
        return ""

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        pane = 0
        selected = 0
        while not SHUTDOWN.is_set():
            snap = workbench_snapshot(cfg)
            services = [row["status_row"] for row in snap["services"].values()]
            staged_names = sorted(snap["staged"])
            upload_lines = [
                f"{'>' if pane == 2 and idx == selected else ' '} {m.get('filename', '')} {m.get('size', '')}B {m.get('sha256_prefix', str(m.get('sha256', ''))[:12])} status={m.get('status', '')}"
                for idx, m in enumerate(snap["uploads"])
            ] or ["none"]
            session_lines = [
                f"{'>' if pane == 3 and idx == selected else ' '} {s.get('service', '')} {Path(s.get('path', '')).name} up={s.get('upload_count', 0)} fetch={s.get('fetch_count', 0)} ev={s.get('event_count', 0)} exit={s.get('exit_reason', '') or '-'}"
                for idx, s in enumerate(snap["sessions"])
            ] or ["none"]
            release = snap.get("release") or {}
            release_artifacts = release.get("artifacts") or []
            release_devices = release.get("devices") or []
            release_tuples = release.get("tuples") or []
            release_nav = release_nav_records(release, release_devices, release_tuples)
            release_lines = [
                f"{'>' if pane == 6 and idx == selected else ' '} {a.get('name', '')} {a.get('payload_preset', '')} {a.get('tuple_path', '')}"
                for idx, a in enumerate(release_artifacts[:10])
            ] or ["none"]
            device_tuple_lines = [
                f"{'>' if pane == 7 and idx == selected else ' '} {rec.get('label', '')}"
                for idx, rec in enumerate(release_nav[:12])
            ]
            device_tuple_lines = device_tuple_lines or ["none"]
            recent_events = snap["events"][-8:]
            event_lines = [
                f"{'>' if pane == 4 and idx == selected else ' '} {e.get('ts', '')} {e.get('level', '')} {e.get('service', '')}:{e.get('event', '')}"
                for idx, e in enumerate(recent_events)
            ] or ["none"]
            command_lines = [
                f"{'>' if pane == 5 and idx == selected else ' '} {idx + 1}: {cmd}"
                for idx, cmd in enumerate(snap["target_commands"])
            ] or ["none"]
            service_lines = []
            for idx, row in enumerate(services):
                prefix = ">" if pane == 0 and idx == selected else " "
                tls = "yes" if row["tls"] else "no"
                service_lines.append(f"{prefix} {row['name']:12s} {row['actual']}/{row['configured']} port={row['port']} tls={tls} pid={row['pid'] or '-'}")
            staged_lines = []
            for idx, name in enumerate(staged_names):
                rec = snap["staged"][name]
                prefix = ">" if pane == 1 and idx == selected else " "
                staged_lines.append(f"{prefix} {name} {rec.get('stage_kind', 'file')} {rec.get('size', '')}B {str(rec.get('sha256', ''))[:8]}")
            staged_lines = staged_lines or [" none"]
            detail_lines = []
            if pane == 0 and services:
                row = services[min(selected, len(services) - 1)]
                detail_lines = [
                    f"service: {row['name']}",
                    f"port: {row['port']}",
                    f"desired: {row['configured']}",
                    f"actual: {row['actual']}",
                    f"tls: {'yes' if row['tls'] else 'no'}",
                    f"pid: {row['pid'] or '-'} alive={row['pid_alive']}",
                    f"session_log: {row['session_log'] or '-'}",
                    f"process_log: {row['process_log'] or '-'}",
                    f"error: {row['error'] or '-'}",
                ]
            elif pane == 1 and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)]
                rec = snap["staged"][name]
                detail_lines = [
                    f"request: {name}",
                    f"kind: {rec.get('stage_kind', 'file')}",
                    f"source: {rec.get('source_path', '')}",
                    f"release_path: {rec.get('release_path', '')}",
                    f"tuple_path: {rec.get('tuple_path', '')}",
                    f"payload_preset: {rec.get('payload_preset', '')}",
                    f"size: {rec.get('size', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"staged: {rec.get('staged_at', '')}",
                    f"source_exists: {rec.get('source_exists', False)}",
                    rec.get("fetch_command") or render_fetch_command(name, cfg, host=snap["selected_local_ip"]),
                    rec.get("fetch_command_force") or render_fetch_command(name, cfg, host=snap["selected_local_ip"], force=True),
                    "v opens source in pager",
                ]
            elif pane == 2 and snap["uploads"]:
                rec = snap["uploads"][min(selected, len(snap["uploads"]) - 1)]
                detail_lines = [
                    f"upload: {rec.get('filename', '')}",
                    f"kind: {rec.get('upload_kind', 'file')}",
                    f"source: {rec.get('source_path', '')}",
                    f"stored: {rec.get('stored_path', '')}",
                    f"metadata: {rec.get('metadata_path', rec.get('_metadata_path', ''))}",
                    f"session: {rec.get('session_id', '')}",
                    f"session_path: {rec.get('session_path', '')}",
                    f"stored_exists: {rec.get('stored_exists', False)}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"remote: {rec.get('remote_addr', '')}",
                    "v opens metadata in pager",
                ]
            elif pane == 3 and snap["sessions"]:
                rec = snap["sessions"][min(selected, len(snap["sessions"]) - 1)]
                detail_lines = [
                    f"session: {rec.get('session_id', Path(rec.get('path', '')).name)}",
                    f"service: {rec.get('service', '')}",
                    f"path: {rec.get('path', '')}",
                    f"metadata: {rec.get('metadata_path', '')}",
                    f"event_log: {rec.get('event_log', '')}",
                    f"state: {rec.get('state', '')}",
                    f"exit: {rec.get('exit_reason', '') or '-'}",
                    f"uploads: {rec.get('upload_count', 0)}",
                    f"fetches: {rec.get('fetch_count', 0)}",
                    f"events: {rec.get('event_count', 0)}",
                    f"artifacts: {rec.get('artifact_count', 0)}",
                    "v opens session metadata in pager",
                ]
            elif pane == 4 and recent_events:
                event = recent_events[min(selected, len(recent_events) - 1)]
                details = event.get("details") if isinstance(event.get("details"), dict) else {}
                detail_lines = [
                    f"event: {event.get('event', '')}",
                    f"event_id: {event.get('id', '')}",
                    f"ts: {event.get('ts', '')}",
                    f"level: {event.get('level', '')}",
                    f"service: {event.get('service', '')}",
                    f"session: {event.get('session', '') or '-'}",
                    f"session_path: {event.get('session_path', '') or '-'}",
                    f"remote: {event.get('remote', '') or '-'}",
                    f"outcome: {compact_event_details(event) or '-'}",
                    f"details_json: {json.dumps(details, sort_keys=True)}",
                    "v opens operator event log in pager",
                ]
            elif pane == 6 and release_artifacts:
                rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                detail_lines = [
                    f"release: {release.get('release_name', '')}",
                    f"artifact: {rec.get('name', '')}",
                    f"path: {rec.get('path', '')}",
                    f"tuple: {rec.get('tuple_path', '')}",
                    f"payload: {rec.get('payload_preset', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                ]
                detail_lines.extend(artifact_compatibility_lines(rec))
                detail_lines.extend([
                    "enter/s stages for fetch",
                    "v opens artifact in pager",
                ])
            elif pane == 7:
                nav = release_nav
                rec = nav[min(selected, len(nav) - 1)] if nav else {}
                source = rec.get("record") or rec
                detail_lines = [
                    f"release: {release.get('release_name', '')}",
                    f"index: {release.get('release_index', '')}",
                    f"selection_kind: {rec.get('kind', '')}",
                    f"devices: {len(release_devices)}",
                    f"tuples: {len(release_tuples)}",
                    f"recommendations: {len(release.get('recommendation_records') or [])}",
                    f"selected_artifacts: {source.get('artifact_count', len(source.get('artifacts') or []))}",
                    "enter/s stages recommended artifact when available",
                    "v opens selected local path in pager",
                ]
                if rec.get("kind") == "recommendation":
                    recommendation = rec.get("record") or {}
                    detail_lines.extend([
                        f"recommendation: {recommendation.get('scope', '')}:{recommendation.get('key', '')}",
                        f"artifact: {recommendation.get('artifact', '')}",
                        f"payload: {recommendation.get('payload_preset', '')}",
                    ])
                    detail_lines.extend(artifact_compatibility_lines({"compatibility": recommendation.get("compatibility") or {}}))
                for path in (source.get("artifact_paths") or [])[:6]:
                    detail_lines.append(f"artifact_path: {path}")
            elif pane == 5 and snap["target_commands"]:
                command = snap["target_commands"][min(selected, len(snap["target_commands"]) - 1)]
                detail_lines = [
                    "generated target command:",
                    command,
                    f"copy_file: {command_copy_path(cfg)}",
                    "c copies command locally",
                ]
            else:
                detail_lines = [
                    f"state: {state_file_path(cfg)}",
                    f"staged: {staged_file_path(cfg)}",
                    f"cert: {cfg.get('tls_cert', '')}",
                    f"key: {cfg.get('tls_key', '')}",
                ]
            stdscr.erase()
            height, width = stdscr.getmaxyx()
            active = sum(1 for row in services if row["actual"] == "listening")
            warning_count = len(snap.get("warnings") or [])
            workbench = snap.get("workbench") or {}
            refresh_suffix = f"refresh={workbench.get('refresh_count', 0)} last={workbench.get('last_refresh_at', '') or '-'}"
            safe_add(stdscr, 0, 0, f"BusierBox Operator Workbench | active={active} warnings={warning_count} | ip={snap['selected_local_ip']} | {utc_now()} | {refresh_suffix} | tab panes j/k move enter start/stop s stage d unstage v view c copy ? help q quit", curses.A_REVERSE)
            left_w = max(34, width // 3)
            right_w = max(20, width - left_w - 1)
            lower_y = max(12, height // 2)
            draw_list(stdscr, "Services", service_lines, 2, 0, lower_y - 2, left_w, pane == 0)
            draw_list(stdscr, "Details", detail_lines, 2, left_w + 1, lower_y - 2, right_w, False)
            third = max(20, width // 3)
            draw_list(stdscr, "Staged Files", staged_lines, lower_y, 0, 7, third, pane == 1)
            draw_list(stdscr, "Recent Uploads", upload_lines, lower_y, third + 1, 7, third, pane == 2)
            draw_list(stdscr, "Recent Sessions", session_lines, lower_y, (third + 1) * 2, 7, width - ((third + 1) * 2), pane == 3)
            events_y = min(height - 8, lower_y + 8)
            draw_list(stdscr, "Event Log", event_lines, events_y, 0, height - events_y - 1, width // 4, pane == 4)
            draw_list(stdscr, "Generated Target Commands", command_lines, events_y, width // 4 + 1, height - events_y - 1, width // 4, pane == 5)
            draw_list(stdscr, "Release Artifacts", release_lines, events_y, (width // 4 + 1) * 2, height - events_y - 1, width // 4, pane == 6)
            draw_list(stdscr, "Devices / Tuples", device_tuple_lines, events_y, (width // 4 + 1) * 3, height - events_y - 1, width - ((width // 4 + 1) * 3), pane == 7)
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return 0
            if key in (curses.KEY_DOWN, ord("j")):
                selected += 1
            elif key in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif key == ord("\t"):
                pane = (pane + 1) % 8
                selected = 0
            elif key == curses.KEY_BTAB:
                pane = (pane - 1) % 8
                selected = 0
            elif key in (ord("1"), ord("2"), ord("3"), ord("4")):
                service = {ord("1"): "ssh", ord("2"): "tls-shell", ord("3"): "plain-shell", ord("4"): "file-service"}[key]
                start_service_process(cfg, service)
            elif key in (10, 13):
                if pane == 0 and services:
                    service = services[min(selected, len(services) - 1)]["name"]
                    if services[min(selected, len(services) - 1)]["actual"] == "listening":
                        stop_recorded_service(cfg, service)
                    else:
                        start_service_process(cfg, service)
                elif pane == 6 and release_artifacts:
                    rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                    try:
                        stage_release_artifact(cfg, rec.get("release_path") or rec.get("name") or rec.get("path", ""))
                    except ValueError:
                        pass
                elif pane == 7 and release_nav:
                    rec = release_nav[min(selected, len(release_nav) - 1)]
                    try:
                        stage_release_nav_item(cfg, rec)
                    except ValueError:
                        pass
            elif key == ord("5"):
                curses.echo()
                safe_add(stdscr, height - 2, 0, "service> ")
                service = stdscr.getstr(height - 2, 9, 32).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if service:
                    stop_recorded_service(cfg, service)
            elif key in (ord("6"), ord("s")) and pane == 6 and release_artifacts:
                rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                try:
                    stage_release_artifact(cfg, rec.get("release_path") or rec.get("name") or rec.get("path", ""))
                except ValueError:
                    pass
            elif key in (ord("6"), ord("s")) and pane == 7 and release_nav:
                rec = release_nav[min(selected, len(release_nav) - 1)]
                try:
                    stage_release_nav_item(cfg, rec)
                except ValueError:
                    pass
            elif key in (ord("6"), ord("s")):
                curses.echo()
                safe_add(stdscr, height - 3, 0, "local file> ")
                path = stdscr.getstr(height - 3, 12, 240).decode("utf-8", errors="replace").strip()
                safe_add(stdscr, height - 2, 0, "target request name> ")
                name = stdscr.getstr(height - 2, 21, 240).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if path and name:
                    try:
                        stage_file(cfg, path, name)
                    except ValueError:
                        pass
            elif key in (ord("d"), ord("D")) and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)] if pane == 1 else ""
                if name:
                    unstage_file(cfg, name)
            elif key in (ord("v"), ord("V")):
                path = selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples)
                message = ""
                if path:
                    try:
                        curses.def_prog_mode()
                        curses.endwin()
                        message = open_path_in_pager(path)
                    finally:
                        curses.reset_prog_mode()
                        stdscr.keypad(True)
                        curses.curs_set(0)
                else:
                    message = "no local path for selected item"
                safe_add(stdscr, height - 2, 0, message)
                stdscr.getch()
            elif key in (ord("?"),):
                safe_add(stdscr, height - 2, 0, "Help: arrows/jk move, Tab panes, Enter start/stop, s stage, d unstage, v view, c copy command, r refresh, q quit")
                stdscr.getch()
            elif key in (ord("r"), ord("R")):
                rec = record_workbench_refresh(cfg)
                safe_add(stdscr, height - 2, 0, f"Refreshed workbench at {rec.get('last_refresh_at', '')}")
                stdscr.getch()
            elif key in (ord("c"), ord("C")):
                if snap["target_commands"]:
                    idx = min(selected, len(snap["target_commands"]) - 1) + 1 if pane == 5 else 1
                    try:
                        rec = copy_generated_command(cfg, idx)
                        safe_add(stdscr, height - 2, 0, f"Copied command {idx} to {rec['path']} clipboard={'yes' if rec['clipboard'] else 'no'}")
                    except ValueError as exc:
                        safe_add(stdscr, height - 2, 0, str(exc))
                else:
                    safe_add(stdscr, height - 2, 0, "No generated target commands.")
                stdscr.getch()
            max_items = (
                len(services) if pane == 0 else
                len(staged_names) if pane == 1 else
                len(snap["uploads"]) if pane == 2 else
                len(snap["sessions"]) if pane == 3 else
                len(recent_events) if pane == 4 else
                len(snap["target_commands"]) if pane == 5 else
                len(release_artifacts) if pane == 6 else
                (1 + len(release_devices[:5]) + len(release_tuples[:5])) if pane == 7 else
                1
            )
            selected = min(max(0, selected), max(0, max_items - 1))
        return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0

    return curses.wrapper(draw)


def run_tui(cfg):
    update_server_state(cfg, "workbench", "open", {"state_file": str(state_file_path(cfg)), "workbench_mode": "starting"})
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "noninteractive",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "noninteractive"})
        print_workbench(cfg)
        return 0
    try:
        if os.environ.get("TERM", "").strip().lower() in ("", "dumb"):
            print("terminal does not support curses, using line menu", file=sys.stderr)
            update_server_state(cfg, "workbench", "open", {
                "state_file": str(state_file_path(cfg)),
                "workbench_mode": "line",
            })
            append_event(cfg, "workbench", "workbench_opened", details={"mode": "line"})
            return run_line_tui(cfg)
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "curses",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "curses"})
        return run_curses_tui(cfg)
    except KeyboardInterrupt:
        request_shutdown("keyboard_interrupt")
        print("busierbox-server: interrupted, shutting down workbench", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"curses workbench unavailable, using line menu: {exc}", file=sys.stderr)
        update_server_state(cfg, "workbench", "open", {
            "state_file": str(state_file_path(cfg)),
            "workbench_mode": "line",
        })
        append_event(cfg, "workbench", "workbench_opened", details={"mode": "line", "fallback_reason": str(exc)})
        return run_line_tui(cfg)
    finally:
        stop_workbench_started_services(cfg)
        mark_service_stopped(cfg, "workbench", SHUTDOWN_REASON or "quit")
        append_event(cfg, "workbench", "shutdown", details={"reason": SHUTDOWN_REASON or "quit"})


def _resolve_transport(cfg, args_transport):
    """Map --transport flag and config fields to a canonical action."""
    if args_transport:
        t = args_transport
        # Aliases
        if t == "ssh-reverse":
            t = "ssh"
        elif t == "socat-tls":
            t = "tls-shell"
        elif t == "builtin-tls":
            t = "tls-shell"
        return t

    # Derive from config transport + encryption
    if yes(cfg.get("file_service_enable", "no")):
        return "file-service"
    t = cfg.get("transport", "ssh")
    enc = cfg.get("encryption", "tls")
    if t == "ssh":
        return "ssh"
    if enc == "tls":
        return "tls-shell"
    return "plain-shell"


def main(argv=None):
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        description="Catch BusierBox reverse-access transports from a target.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Transport modes:
  ssh         — Paramiko reverse-forward listener for Dropbear/dbclient (BB_RSHELL_TRANSPORT=ssh)
  tls-shell   — TLS shell listener accepting builtin+tls AND socat+tls transports
  plain-shell — Plaintext shell listener (debug/insecure; socat+none or builtin+none)
  file-service — Receive-only TLS upload service for target-initiated files/evidence
  command-queue — Explicit command queue poll listener; records polls only

File staging:
  --transport file-service --serve-file ./tool --as /tmp/tool
  --transport file-service --serve-dir local/operator-files
  --stage-release-artifact by-tuple/.../bin/busierbox-target-full
  --release-dir dist/releases/lab --stage-release-artifact bin/busierbox-target-full
  --transport file-service --list-staged

Command queue:
  --queue-command 'busierbox reality-test --json'
  --list-command-queue
  --record-command-result cq-id --result-json result.json
  --clear-command-queue

Build configuration:
  --build-config configs/busierbox.conf --list-build-config
  --build-config configs/busierbox.conf --set-build-config BB_NORESIDUE_LEVEL=aggressive

Aliases accepted: ssh-reverse=ssh, socat-tls=tls-shell, builtin-tls=tls-shell
""",
    )
    parser.add_argument("--config", default=str(DEFAULT_CONFIG),
                        help="JSON config written by menuconfig")
    parser.add_argument("--build-config", default="configs/busierbox.conf",
                        help="BusierBox shell build config used by scripts/menuconfig and make package")
    parser.add_argument("--transport",
                        choices=("ssh", "ssh-reverse", "tls-shell", "socat-tls",
                                 "builtin-tls", "plain-shell", "file-service", "command-queue"),
                        help="transport to listen for (overrides config)")
    parser.add_argument("--file-service", action="store_true",
                        help="receive target-initiated file uploads and store them under local/sessions")
    parser.add_argument("--tui", action="store_true",
                        help="open the operator-side service/file staging workbench")
    parser.add_argument("--no-tui", action="store_true",
                        help="preserve direct listener CLI behavior when running interactively with no args")
    parser.add_argument("--status", action="store_true",
                        help="show managed service state, actual listeners, sessions, uploads, and stale warnings")
    parser.add_argument("--json-status", action="store_true",
                        help="print --status information as JSON")
    parser.add_argument("--api-status", action="store_true",
                        help="alias for --json-status for future frontend/API consumers")
    parser.add_argument("--event-limit", type=int, default=12,
                        help="number of recent structured events to include in --status/--json-status output")
    parser.add_argument("--stop", action="store_true",
                        help="stop known managed listeners from server-state PID records")
    parser.add_argument("--serve-file",
                        help="stage a local file for explicit target fetch")
    parser.add_argument("--as", dest="serve_as",
                        help="target request name for --serve-file, for example /tmp/myfile")
    parser.add_argument("--serve-dir",
                        help="stage direct child files from a local directory for explicit target fetch")
    parser.add_argument("--stage-release-artifact",
                        help="stage an artifact from the current or configured release bundle for explicit target fetch")
    parser.add_argument("--release-dir",
                        help="release bundle directory to inspect for status or --stage-release-artifact")
    parser.add_argument("--list-staged", action="store_true",
                        help="list operator-staged target fetch files and commands")
    parser.add_argument("--unstage",
                        help="remove a staged target fetch request name")
    parser.add_argument("--state-file",
                        help="operator workbench state JSON path")
    parser.add_argument("--staged-file",
                        help="operator staged-files JSON path")
    parser.add_argument("--command-queue-file",
                        help="operator command queue JSON path")
    parser.add_argument("--command-copy-file",
                        help="operator last copied/generated command text path")
    parser.add_argument("--copy-target-command", type=int,
                        help="copy/export generated target command N to clipboard when available and to the command copy file")
    parser.add_argument("--start-workbench-job",
                        help="start a background-capable operator workflow action by id")
    parser.add_argument("--cancel-workbench-job",
                        help="cancel a managed workbench background job by id when ownership evidence matches")
    parser.add_argument("--job-command", help=argparse.SUPPRESS)
    parser.add_argument("--list-build-config", action="store_true",
                        help="list guided BusierBox build configuration fields")
    parser.add_argument("--set-build-config", action="append", default=[],
                        help="set a guided BusierBox build config value as KEY=VALUE")
    parser.add_argument("--queue-command",
                        help="record an explicit operator command queue entry; the poll listener may deliver metadata but will not execute it")
    parser.add_argument("--queue-timeout", type=int,
                        help="timeout metadata for --queue-command, in seconds")
    parser.add_argument("--queue-max-output", type=int,
                        help="max output metadata for --queue-command, in bytes")
    parser.add_argument("--list-command-queue", action="store_true",
                        help="list explicit operator command queue entries")
    parser.add_argument("--json-command-queue", action="store_true",
                        help="print command queue entries as JSON")
    parser.add_argument("--record-command-result",
                        help="record structured JSON result metadata for a queued command id")
    parser.add_argument("--result-json",
                        help="JSON object to attach with --record-command-result")
    parser.add_argument("--clear-command-queue", action="store_true",
                        help="clear explicit operator command queue entries")
    parser.add_argument("--listen-host", help="listener bind address")
    parser.add_argument("--ssh-port", type=int, help="SSH reverse-forward listener port")
    parser.add_argument("--shell-port", type=int,
                        help="TLS/plain shell listener port (socat-port alias also accepted)")
    parser.add_argument("--socat-port", type=int,
                        help=argparse.SUPPRESS)  # compat alias for --shell-port
    parser.add_argument("--forward-port", type=int,
                        help="remote forward port exposed on the operator workstation")
    parser.add_argument("--file-port", type=int,
                        help="receive-only file service listener port")
    parser.add_argument("--file-service-tls", choices=("yes", "no"),
                        help="use TLS for file-service uploads (default yes)")
    parser.add_argument("--timeout", type=float, default=0,
                        help="seconds to wait for a connection; 0 waits forever")
    parser.add_argument("--no-stdin", action="store_true",
                        help="do not relay local stdin to the remote shell")
    parser.add_argument("--log-only", action="store_true",
                        help="alias for --no-stdin; receive stdout/session log only")
    parser.add_argument("--one-shot", action="store_true",
                        help="exit after one shell session instead of waiting for reconnects")
    parser.add_argument("--script",
                        help="file containing shell input to send after tls/plain shell connect")
    parser.add_argument("--expect",
                        help="literal text that must appear in captured shell output")
    parser.add_argument("--session-timeout", type=float, default=30,
                        help="seconds to allow a scripted shell session; 0 disables the limit")
    parser.add_argument("--managed-by", help=argparse.SUPPRESS)
    parser.add_argument("--process-log", help=argparse.SUPPRESS)
    args = parser.parse_args(raw_argv)

    cfg = load_config(args.config)
    cfg["_config_path"] = args.config
    cfg["_build_config_path"] = args.build_config
    if args.listen_host:
        cfg["listen_host"] = args.listen_host
    if args.ssh_port:
        cfg["ssh_listen_port"] = args.ssh_port
    shell_port = args.shell_port or args.socat_port
    if shell_port:
        cfg["shell_listen_port"] = shell_port
    if args.forward_port:
        cfg["forward_port"] = args.forward_port
    if args.file_port:
        cfg["file_service_port"] = args.file_port
    if args.file_service_tls:
        cfg["file_service_tls"] = args.file_service_tls
    if args.state_file:
        cfg["server_state"] = args.state_file
    if args.staged_file:
        cfg["staged_files"] = args.staged_file
    if args.command_queue_file:
        cfg["command_queue_file"] = args.command_queue_file
    if args.command_copy_file:
        cfg["command_copy_file"] = args.command_copy_file
    if args.release_dir:
        cfg["release_dir"] = args.release_dir
    if args.managed_by:
        cfg["_managed_by"] = args.managed_by
    if args.process_log:
        cfg["_process_log"] = args.process_log
    if args.event_limit < 0:
        print("busierbox-server: --event-limit must be >= 0", file=sys.stderr)
        return 2
    cfg["_event_limit"] = args.event_limit

    try:
        if args.start_workbench_job:
            print(f"workbench action: {args.start_workbench_job}")
            rec = start_workbench_job(cfg, args.start_workbench_job, command_override=args.job_command)
            print(f"started workbench job {rec.get('id', '')}: pid={rec.get('pid', '')}")
            print(f"log={rec.get('log_path', '')}")
            print(f"command={rec.get('command', '')}")
            return 0
        if args.cancel_workbench_job:
            rec = cancel_workbench_job(cfg, args.cancel_workbench_job)
            print(f"cancel requested for workbench job {rec.get('id', args.cancel_workbench_job)}")
            print(f"pid={rec.get('pid', '')}")
            return 0
        if args.list_build_config:
            for rec in workbench_config_field_records(cfg):
                print(f"{rec.get('key', '')}={shell_double_quote(rec.get('value', ''))} category={rec.get('category', '')} configured={'yes' if rec.get('configured') else 'no'}")
                print(f"  safety: boundary={rec.get('safety_boundary', '')} control_like={'yes' if rec.get('control_like') else 'no'} explicit_choice={'yes' if rec.get('requires_explicit_operator_choice') else 'no'}")
                print(f"  label: {rec.get('label', '')}")
                print(f"  set: {rec.get('set_command', '')}")
            append_event(cfg, "workbench", "workbench_config_viewed", details={"config_path": str(build_config_path(cfg)), "field_count": len(workbench_config_field_records(cfg))})
            return 0
        if args.set_build_config:
            for assignment in args.set_build_config:
                rec = set_workbench_build_config(cfg, assignment)
                print(f"set {rec.get('key', '')}={shell_double_quote(rec.get('value', ''))} in {rec.get('config_path', '')}")
            return 0
        if args.copy_target_command:
            rec = copy_generated_command(cfg, args.copy_target_command)
            print(f"copied target command {args.copy_target_command} to {rec['path']}")
            print(f"clipboard={'yes' if rec['clipboard'] else 'no'}")
            print(rec["text"])
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    try:
        if args.clear_command_queue:
            count = clear_command_queue(cfg)
            print(f"cleared {count} command queue entr{'y' if count == 1 else 'ies'}")
            if not (args.queue_command or args.list_command_queue or args.json_command_queue):
                return 0
        if args.queue_command:
            rec = queue_command(cfg, args.queue_command, timeout_sec=args.queue_timeout, max_output_bytes=args.queue_max_output)
            print(f"queued {rec['id']}: {rec['command']}")
            print("execution_supported=no delivery_supported=no")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.record_command_result:
            if not args.result_json:
                raise ValueError("--record-command-result requires --result-json")
            rec = record_command_result(cfg, args.record_command_result, args.result_json)
            print(f"recorded result for {rec['id']}: status={rec.get('result', {}).get('status', '')}")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.list_command_queue or args.json_command_queue:
            print_command_queue(cfg, json_output=args.json_command_queue)
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    if args.status or args.json_status or args.api_status:
        return print_status(cfg, json_output=args.json_status or args.api_status)
    if args.stop:
        return stop_managed_services(cfg)

    timeout = None if args.timeout == 0 else args.timeout
    action = "file-service" if args.file_service else _resolve_transport(cfg, args.transport)
    script_bytes = None
    if args.script:
        script_bytes = Path(args.script).read_bytes()
        if script_bytes and not script_bytes.endswith(b"\n"):
            script_bytes += b"\n"
    session_timeout = None if args.session_timeout == 0 else args.session_timeout

    try:
        if args.serve_file:
            request_name = args.serve_as or Path(args.serve_file).name
            rec = stage_file(cfg, args.serve_file, request_name)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.serve_dir:
            records = stage_dir(cfg, args.serve_dir)
            for rec in records:
                print(f"staged {rec['request_name']} <- {rec['source_path']}")
                print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.stage_release_artifact:
            rec = stage_release_artifact(cfg, args.stage_release_artifact)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.unstage:
            existed = unstage_file(cfg, args.unstage)
            print(f"unstaged {args.unstage}" if existed else f"not staged {args.unstage}")
        if args.list_staged:
            print_staged(cfg)
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    if args.tui or (not raw_argv and not args.no_tui and sys.stdin.isatty() and sys.stdout.isatty()):
        return run_tui(cfg)

    try:
        if action == "ssh":
            return serve_ssh(cfg, timeout)
        if action == "tls-shell":
            return serve_tls_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                   max_sessions=1 if args.one_shot or args.script else 0,
                                   script_bytes=script_bytes, expect=args.expect,
                                   session_timeout=session_timeout)
        if action == "plain-shell":
            return serve_plain_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                     max_sessions=1 if args.one_shot or args.script else 0,
                                     script_bytes=script_bytes, expect=args.expect,
                                     session_timeout=session_timeout)
        if action == "file-service":
            return serve_file_service(cfg, timeout, max_sessions=1 if args.one_shot else 0)
        if action == "command-queue":
            return serve_command_queue(cfg, timeout, max_sessions=1 if args.one_shot else 0)
    except KeyboardInterrupt:
        print("busierbox-server: interrupted, shutting down", file=sys.stderr)
        request_shutdown("keyboard_interrupt")
        record_shutdown_event(cfg, action)
        mark_service_stopped(cfg, action, "keyboard_interrupt")
        return 130
    except OSError:
        return 1
    print(f"unsupported transport: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    install_shutdown_handlers()
