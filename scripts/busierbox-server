#!/usr/bin/env python3
"""BusierBox reverse access convenience server.

This helper catches target-initiated reverse-access transports. It does not
implement the retired BusierBox framed artifact-upload protocol.
"""

import argparse
import base64
import json
import os
import select
import socket
import ssl
import sys
import threading
import time
from pathlib import Path

try:
    import paramiko
    HAVE_PARAMIKO = True
except ImportError:
    HAVE_PARAMIKO = False


DEFAULT_CONFIG = Path("local/server-config.json")
DEFAULTS = {
    "transport": "ssh",
    "listen_host": "0.0.0.0",
    "ssh_listen_port": 22202,
    "socat_listen_port": 22203,
    "forward_host": "127.0.0.1",
    "forward_port": 2200,
    "authorized_dbclient_pubkey": "local/operator-session/id_dbclient.pub",
    "operator_host_key": "local/operator-session/operator_ssh_host_key",
    "tls_cert": "local/operator-session/socat-server.crt",
    "tls_key": "local/operator-session/socat-server.key",
    "tls_verify": "no",
    "session_root": "local/sessions",
}


def load_config(path):
    cfg = dict(DEFAULTS)
    p = Path(path)
    if p.is_file():
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            for key, value in data.items():
                if value not in (None, ""):
                    cfg[key] = value
        except (OSError, json.JSONDecodeError) as exc:
            print(f"warning: unable to read {p}: {exc}", file=sys.stderr)
    for key in ("ssh_listen_port", "socat_listen_port", "forward_port"):
        cfg[key] = int(cfg[key])
    return cfg


def local_ips():
    ips = []
    seen = set()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("8.8.8.8", 80))
            ips.append(sock.getsockname()[0])
    except OSError:
        pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ips.append(info[4][0])
    except OSError:
        pass
    out = []
    for ip in ips:
        if ip and not ip.startswith("127.") and ip not in seen:
            seen.add(ip)
            out.append(ip)
    return out


def session_log_dir(cfg, transport):
    root = Path(str(cfg["session_root"]))
    path = root / (time.strftime("%Y%m%d-%H%M%S") + "-" + transport)
    path.mkdir(parents=True, exist_ok=True)
    return path


def print_candidates(cfg, port):
    print(f"Listening on {cfg['listen_host']}:{port}")
    candidates = local_ips()
    if candidates:
        print("Candidate target connect-back hosts:")
        for ip in candidates:
            print(f"  {ip}:{port}")
    else:
        print("Candidate target connect-back hosts: unable to infer local IPs")


def load_public_key(path):
    if not HAVE_PARAMIKO:
        return None
    key_path = Path(path).expanduser()
    if not key_path.is_file():
        raise RuntimeError(f"authorized dbclient public key not found: {key_path}")
    text = key_path.read_text(encoding="utf-8").strip()
    key_type, key_data = text.split()[:2]
    blob = base64.b64decode(key_data.encode("ascii"))
    for cls in (paramiko.RSAKey, paramiko.ECDSAKey, paramiko.Ed25519Key):
        try:
            return cls(data=blob)
        except Exception:
            continue
    raise RuntimeError(f"unsupported public key: {key_path}")


def ensure_host_key(path):
    if not HAVE_PARAMIKO:
        return None
    key_path = Path(path).expanduser()
    key_path.parent.mkdir(parents=True, exist_ok=True)
    if key_path.is_file():
        return paramiko.RSAKey(filename=str(key_path))
    key = paramiko.RSAKey.generate(3072)
    key.write_private_key_file(str(key_path))
    return key


class ReverseSSHServer(paramiko.ServerInterface if HAVE_PARAMIKO else object):
    def __init__(self, authorized_key, forward_host, forward_port):
        self.authorized_key = authorized_key
        self.forward_host = forward_host
        self.forward_port = forward_port
        self.forward_requests = []
        self.transport = None
        self.listener = None

    def set_transport(self, transport):
        self.transport = transport

    def check_auth_publickey(self, username, key):
        if self.authorized_key and key == self.authorized_key:
            print(f"SSH auth OK for {username}")
            return paramiko.AUTH_SUCCESSFUL
        print(f"SSH auth rejected for {username}")
        return paramiko.AUTH_FAILED

    def get_allowed_auths(self, username):
        return "publickey"

    def check_port_forward_request(self, address, port):
        requested = int(port)
        if requested != int(self.forward_port):
            print(f"reject remote forward {address}:{port}; expected port {self.forward_port}")
            return False
        self.forward_requests.append((address, requested))
        self.start_forward_listener()
        print(f"Reverse SSH forward active: {address}:{requested}")
        print(f"Connect with: ssh -p {requested} root@127.0.0.1")
        return requested

    def check_channel_direct_tcpip_request(self, chanid, origin, destination):
        return paramiko.OPEN_SUCCEEDED

    def start_forward_listener(self):
        if self.listener is not None:
            return

        def run():
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                sock.bind((str(self.forward_host), int(self.forward_port)))
                sock.listen(20)
                self.listener = sock
                while self.transport and self.transport.is_active():
                    try:
                        local, origin = sock.accept()
                    except OSError:
                        break
                    try:
                        chan = self.transport.open_forwarded_tcpip_channel(
                            (str(self.forward_host), int(self.forward_port)),
                            origin,
                        )
                    except Exception as exc:
                        print(f"forward channel failed: {exc}", file=sys.stderr)
                        local.close()
                        continue
                    threading.Thread(target=pipe, args=(local, chan), daemon=True).start()
                    threading.Thread(target=pipe, args=(chan, local), daemon=True).start()

        threading.Thread(target=run, daemon=True).start()


def pipe(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def serve_ssh(cfg, timeout):
    if not HAVE_PARAMIKO:
        print("Paramiko is required for SSH reverse-forward mode.", file=sys.stderr)
        print("Install python3-paramiko or use --transport socat-tls.", file=sys.stderr)
        return 2
    host_key = ensure_host_key(cfg["operator_host_key"])
    authorized = load_public_key(cfg["authorized_dbclient_pubkey"])
    log_dir = session_log_dir(cfg, "ssh")
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")

    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((str(cfg["listen_host"]), int(cfg["ssh_listen_port"])))
        sock.listen(20)
        sock.settimeout(timeout)
        print_candidates(cfg, cfg["ssh_listen_port"])
        print(f"Authorized target key: {cfg['authorized_dbclient_pubkey']}")
        try:
            client, addr = sock.accept()
        except socket.timeout:
            print("timeout waiting for reverse SSH connection", file=sys.stderr)
            return 1
    print(f"Connection from {addr[0]}:{addr[1]}")

    transport = paramiko.Transport(client)
    transport.add_server_key(host_key)
    # Dropbear sends X25519 key exchange data in a format that triggers a paramiko
    # bug (ValueError: An X25519 public key is 32 bytes long).  Exclude curve25519
    # from the offered kex algorithms so Dropbear falls back to ecdh-sha2-nistp256.
    _sec = transport.get_security_options()
    _sec.kex = tuple(k for k in _sec.kex if "curve25519" not in k.lower())
    server = ReverseSSHServer(authorized, cfg["forward_host"], cfg["forward_port"])
    server.set_transport(transport)
    transport.start_server(server=server)
    try:
        while transport.is_active():
            time.sleep(1.0)
    finally:
        transport.close()
    return 0


def relay_stdio(conn):
    print("TLS shell connected. Ctrl-C to close.")
    conn.setblocking(False)
    while True:
        readable, _, _ = select.select([conn, sys.stdin], [], [])
        if conn in readable:
            try:
                data = conn.recv(65536)
            except OSError:
                break
            if not data:
                break
            os.write(sys.stdout.fileno(), data)
        if sys.stdin in readable:
            data = os.read(sys.stdin.fileno(), 65536)
            if not data:
                break
            conn.sendall(data)


def serve_socat_tls(cfg, timeout):
    cert = Path(str(cfg["tls_cert"]))
    key = Path(str(cfg["tls_key"]))
    if not cert.is_file() or not key.is_file():
        print(f"TLS cert/key missing: {cert} / {key}", file=sys.stderr)
        return 2
    log_dir = session_log_dir(cfg, "socat-tls")
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(str(cert), str(key))
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((str(cfg["listen_host"]), int(cfg["socat_listen_port"])))
        sock.listen(1)
        sock.settimeout(timeout)
        print_candidates(cfg, cfg["socat_listen_port"])
        try:
            raw, addr = sock.accept()
        except socket.timeout:
            print("timeout waiting for socat TLS shell", file=sys.stderr)
            return 1
    print(f"TLS connection from {addr[0]}:{addr[1]}")
    with context.wrap_socket(raw, server_side=True) as conn:
        relay_stdio(conn)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Catch BusierBox reverse-access transports from a target."
    )
    parser.add_argument("--config", default=str(DEFAULT_CONFIG),
                        help="JSON config written by menuconfig")
    parser.add_argument("--transport", choices=("ssh", "ssh-reverse", "socat-tls", "tls-shell"),
                        help="transport to listen for")
    parser.add_argument("--listen-host", help="listener bind address")
    parser.add_argument("--ssh-port", type=int, help="SSH reverse-forward listener port")
    parser.add_argument("--socat-port", type=int, help="socat TLS shell listener port")
    parser.add_argument("--forward-port", type=int,
                        help="remote forward port exposed on the operator workstation")
    parser.add_argument("--timeout", type=float, default=0,
                        help="seconds to wait for a connection; 0 waits forever")
    args = parser.parse_args(argv)

    cfg = load_config(args.config)
    if args.transport:
        cfg["transport"] = "ssh" if args.transport == "ssh-reverse" else (
            "socat-tls" if args.transport == "tls-shell" else args.transport
        )
    if args.listen_host:
        cfg["listen_host"] = args.listen_host
    if args.ssh_port:
        cfg["ssh_listen_port"] = args.ssh_port
    if args.socat_port:
        cfg["socat_listen_port"] = args.socat_port
    if args.forward_port:
        cfg["forward_port"] = args.forward_port

    timeout = None if args.timeout == 0 else args.timeout
    transport = cfg["transport"]
    if transport == "ssh":
        return serve_ssh(cfg, timeout)
    if transport == "socat-tls":
        return serve_socat_tls(cfg, timeout)
    print(f"unsupported transport: {transport}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
