        "release_artifact_provider_tool_counts": (release.get("artifact_stats") or {}).get("by_provider_tool") or {},
        "release_artifact_provider_status_counts": (release.get("artifact_stats") or {}).get("by_provider_status") or {},
        "release_artifact_doom_wad_filename_counts": (release.get("artifact_stats") or {}).get("by_doom_wad_filename") or {},
        "release_artifact_doom_wad_sha256_counts": (release.get("artifact_stats") or {}).get("by_doom_wad_sha256") or {},
        "release_artifact_doom_wad_count": (release.get("artifact_stats") or {}).get("doom_wad_count", 0),
    })
    return {
        "schema": 1,
        "generated_at": utc_now(),
        "operator_session_dir": str(operator_dir),
        "state_file": str(state_file_path(cfg)),
        "staged_files": str(staged_file_path(cfg)),
        "command_queue_file": str(command_queue_path(cfg)),
        "command_copy_file": str(command_copy_path(cfg)),
        "event_log": str(event_log_path),
        "session_root": session_root,
        "tls_cert": str(cfg.get("tls_cert", "")),
        "tls_key": str(cfg.get("tls_key", "")),
        "paths": paths,
        "path_status": path_status,
        "browser_paths": browser_paths,
        "browser_paths_by_kind": browser_paths_by_kind,
        "browser_paths_by_path": browser_paths_by_path,
        "browser_paths_by_source_id": browser_paths_by_source_id,
        "browser_paths_by_kind_source_id": browser_paths_by_kind_source_id,
        "browser_path_summary": browser_summary,
        "server_state": server_state,
        "staged_files_state": staged_files_state,
        "command_queue_state": command_queue_state,
        "services": services,
        "services_by_name": services_by_name,
        "services_by_actual": services_by_actual,
        "services_by_configured": services_by_configured,
        "services_by_port": services_by_port,
        "services_by_pid": services_by_pid,
        "services_by_listener_pid": services_by_listener_pid,
        "ports": ports,
        "ports_by_number": ports_by_number,
        "ports_by_service": ports_by_service,
        "ports_by_actual": ports_by_actual,
        "summary": summary,
        "warnings": warnings,
        "warnings_by_type": warnings_by_type,
        "warnings_by_service": warnings_by_service,
        "warnings_by_port": warnings_by_port,
        "warnings_by_pid": warnings_by_pid,
        "warnings_by_listener_pid": warnings_by_listener_pid,
        "warnings_by_owner_pid": warnings_by_owner_pid,
        "warnings_by_path": warnings_by_path,
        "warnings_by_type_path": warnings_by_type_path,
        "warning_stats": warning_summary,
        "local_ips": ips,
        "selected_local_ip": (ips or ["OPERATOR_IP"])[0],
        "target_commands": [rec["command"] for rec in target_command_records],
        "target_command_records": target_command_records,
        "target_command_summary": target_command_summary,
        "target_commands_by_service": target_commands_by_service,
        "target_commands_by_request": target_commands_by_request,
        "target_commands_by_side": target_commands_by_side,
        "target_commands_by_purpose": target_commands_by_purpose,
        "target_commands_by_service_purpose": target_commands_by_service_purpose,
        "target_commands_by_side_purpose": target_commands_by_side_purpose,
        "staged": staged,
        "staged_records": staged_records,
        "staged_by_request": staged_by_request,
        "staged_by_sha256": staged_by_sha256,
        "staged_by_source_path": staged_by_source_path,
        "uploads": uploads,
        "uploads_by_session": records_by_session(uploads),
        "uploads_by_filename": uploads_by_filename,
        "uploads_by_sha256": uploads_by_sha256,
        "uploads_by_source_path": uploads_by_source_path,
        "uploads_by_stored_path": uploads_by_stored_path,
        "uploads_by_remote_addr": uploads_by_remote_addr,
        "uploads_by_status": uploads_by_status,
        "fetches": fetches,
        "fetches_by_session": records_by_session(fetches),
        "fetches_by_request": fetches_by_request,
        "fetches_by_sha256": fetches_by_sha256,
        "fetches_by_source_path": fetches_by_source_path,
        "fetches_by_status": fetches_by_status,
        "fetches_by_http_status": fetches_by_http_status,
        "fetches_by_remote_addr": fetches_by_remote_addr,
        "sessions": sessions,
        "session_root_state": session_root_state,
        "sessions_by_id": sessions_by_id,
        "sessions_by_service": sessions_by_service,
        "sessions_by_state": sessions_by_state,
        "sessions_by_exit_reason": sessions_by_exit_reason,
        "sessions_by_remote": sessions_by_remote,
        "events": events,
        "events_by_id": events_by_id,
        "events_by_session": events_by_session,
        "events_by_service": events_by_service,
        "events_by_event": events_by_event,
        "events_by_level": events_by_level,
        "events_by_remote": events_by_remote,
        "events_by_service_event": events_by_service_event,
        "events_by_session_event": events_by_session_event,
        "event_log_state": event_log_state,
        "event_log_stats": {
            key: value for key, value in event_stats.items() if key != "tail"
        },
        "release_state": release_state,
        "release": release,
        "command_queue": command_queue,
    }


def generated_target_commands(cfg, staged=None):
    return [rec["command"] for rec in generated_target_command_records(cfg, staged)]


def print_command_queue_mode_lines(queue):
    mode_summary = queue.get("mode_summary") or {}
    print(
        "  modes: "
        f"total={mode_summary.get('mode_count', 0)} "
        f"would_poll_if_configured={mode_summary.get('polling_mode_count', 0)} "
        f"operator_host_required={mode_summary.get('operator_host_required_mode_count', 0)} "
        f"execution_supported={mode_summary.get('execution_supported_mode_count', 0)} "
        f"active_control_channel={mode_summary.get('active_control_channel_mode_count', 0)}"
    )
    for name in ("status", "poll", "once", "daemon"):
        rec = (queue.get("mode_semantics") or {}).get(name) or {}
        print(
            f"  mode {name}: "
            f"lifecycle={rec.get('lifecycle', '')} "
            f"requires_operator_host={'yes' if rec.get('requires_operator_host') else 'no'} "
            f"would_poll_if_configured={'yes' if rec.get('would_poll_if_configured') else 'no'} "
            f"execution_supported={'yes' if rec.get('execution_supported') else 'no'} "
            f"active_control_channel={'yes' if rec.get('active_control_channel') else 'no'}"
        )


def rshell_session_policy_record(cfg):
    policy = str(cfg.get("rshell_session_policy") or cfg.get("BB_RSHELL_SESSION_POLICY") or "single")
    valid = policy in ("single", "reconnect", "persistent")
    reconnects = policy in ("reconnect", "persistent")
    summary = {
        "valid": valid,
        "retry_scope": "pre-connect+post-disconnect" if reconnects else "pre-connect",
        "stops_after_success": policy == "single",
        "reconnects_after_disconnect": reconnects,
        "persistent_lifecycle": policy == "persistent",
        "fresh_session_on_reconnect": reconnects,
        "session_resume_supported": False,
    }
    return {
        "session_policy": policy,
        "session_policy_valid": valid,
        "session_policy_errors": [] if valid else ["unsupported rshell session policy"],
        "session_semantics": {
            "retry_until_first_connection": valid,
            "stop_after_first_success": policy == "single",
            "reconnect_after_disconnect": reconnects,
            "persistent_lifecycle": policy == "persistent",
            "fresh_session_on_reconnect": reconnects,
            "session_resume_supported": False,
        },
        "session_policy_summary": summary,
    }


def generated_target_command_records(cfg, staged=None):
    staged = staged if staged is not None else load_staged(cfg).get("staged", {})
    host = (local_ips() or ["OPERATOR_IP"])[0]
    records = [
        {
            "command": render_file_service_command(["put", "/etc/config/network"], cfg, host=host),
            "purpose": "explicitly upload a target file to the operator file service",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": render_file_service_command(["survey", "push"], cfg, host=host),
            "purpose": "explicitly upload passive target survey evidence",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": render_file_service_command(["reality-test", "push"], cfg, host=host),
            "purpose": "explicitly upload active target capability evidence",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": render_file_service_command(["manifest", "push"], cfg, host=host),
            "purpose": "explicitly upload runtime manifest metadata",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": render_file_service_command(["config-push"], cfg, host=host),
            "purpose": "explicitly upload effective runtime configuration",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": render_file_service_command(["evidence", "push"], cfg, host=host),
            "purpose": "explicitly upload an evidence bundle",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
        },
        {
            "command": "./busierbox rshell start",
            "purpose": "start the configured reverse shell transport from the target",
            "side": "target",
            "service": "rshell",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
            "metadata": rshell_session_policy_record(cfg),
        },
    ]
    for name in sorted(staged):
        rec = staged.get(name) if isinstance(staged, dict) else {}
        records.append({
            "command": render_fetch_command(name, cfg, host=host),
            "purpose": "explicitly fetch an operator-staged file",
            "side": "target",
            "service": "file-service",
            "network": True,
            "requires_explicit_target_action": True,
            "executes_operator_supplied_commands": False,
            "request_name": name,
            "source_path": str((rec or {}).get("source_path", "")) if isinstance(rec, dict) else "",
            "source_sha256": str((rec or {}).get("sha256", "")) if isinstance(rec, dict) else "",
            "source_size": (rec or {}).get("size", "") if isinstance(rec, dict) else "",
        })
    return records


def print_status(cfg, json_output=False):
    doc = status_document(cfg)
    if json_output:
        print(json.dumps(doc, indent=2, sort_keys=True))
        return 0
    print("BusierBox server status")
    print(f"  state_file: {doc['state_file']}")
    print(f"  staged_files: {doc['staged_files']}")
    print(f"  command_queue_file: {doc['command_queue_file']}")
    print(f"  command_copy_file: {doc['command_copy_file']}")
    print(f"  session_root: {doc['session_root']}")
    print("")
    print("Path health:")
    for name in sorted(doc.get("path_status") or {}):
        rec = doc["path_status"][name]
        exists = "yes" if rec.get("exists") else "no"
        parent_exists = "yes" if rec.get("parent_exists") else "no"
        writable = "yes" if rec.get("writable") else "no"
        print(f"  {name}: exists={exists} parent_exists={parent_exists} writable={writable} kind={rec.get('expected_kind', '')} path={rec.get('path', '')}")
    print("")
    print("Services:")
    for row in doc["services"]:
        stale = " stale-state" if row["stale"] else ""
        pid = f" pid={row['pid']}" if row["pid"] else ""
        tls = "yes" if row["tls"] else "no"
        bind_address = row.get("bind_address") or ""
        print(f"  {row['name']:12s} bind={bind_address} port={row['port']} tls={tls} configured={row['configured']} actual={row['actual']}{pid}{stale}")
        if row["pid"] and row.get("pid_managed"):
            print(f"    ownership: {','.join(row.get('ownership_evidence') or [])}")
        elif row["pid"] and row.get("pid_alive"):
            print("    ownership: unverified; --stop will skip this PID")
        if row["listener_endpoints"]:
            for endpoint in row["listener_endpoints"]:
                pids = ",".join(str(pid) for pid in endpoint.get("pids", [])) or "unknown"
                print(f"    listener={endpoint.get('address', '')}:{endpoint.get('port', '')} family={endpoint.get('family', '')} pids={pids}")
        if row["listener_processes"]:
            for owner in row["listener_processes"]:
                print(f"    listener_pid={owner['pid']} {owner.get('cmdline', '')}")
        if row["owners"]:
            for owner in row["owners"]:
                print(f"    recorded_owner_pid={owner.get('pid', '')} {owner.get('cmdline', '')}")
        if row["error"]:
            print(f"    error: {row['error']}")
        if row["process_log"]:
            print(f"    process_log: {row['process_log']}")
        if row["session_log"]:
            print(f"    session_log: {row['session_log']}")
    warnings_printed = False
    def print_warnings_header_once():
        nonlocal warnings_printed
        if not warnings_printed:
            print("")
            print("Warnings:")
            warnings_printed = True
    if doc["summary"].get("path_kind_mismatch_count", 0):
        print_warnings_header_once()
        for rec in (doc.get("path_status") or {}).values():
            if rec.get("expected_kind_mismatch"):
                actual = "dir" if rec.get("is_dir") else ("file" if rec.get("is_file") else "other")
                print(f"  operator path kind mismatch: {rec.get('path', '')} expected={rec.get('expected_kind', '')} actual={actual}")
    if any(row["stale"] for row in doc["services"]):
        print_warnings_header_once()
        print("  stale state detected; run scripts/busierbox-server --stop to clean managed records")
    if any(row["actual"] == "listening" and row["configured"] not in ("listening", "starting") for row in doc["services"]):
        print_warnings_header_once()
        print("  actual listener detected while configured state is not listening; inspect listener PID ownership")
    if any(row["pid"] and row.get("pid_alive") and not row.get("pid_managed") for row in doc["services"]):
        print_warnings_header_once()
        print("  recorded live PID without ownership evidence detected; --stop will skip it")
    if doc["summary"].get("event_invalid_count", 0):
        print_warnings_header_once()
        print(f"  event log contains {doc['summary'].get('event_invalid_count', 0)} invalid JSONL record(s); inspect {doc['event_log']}")
    invalid_state_warnings = [
        item for item in doc.get("warnings") or []
        if item.get("type") in ("invalid_server_state", "invalid_staged_files_state", "invalid_command_queue_state")
    ]
    if invalid_state_warnings:
        print_warnings_header_once()
        for warning in invalid_state_warnings:
            suffix = f": {warning.get('error', '')}" if warning.get("error") else ""
            print(f"  {warning.get('message', 'operator state file is invalid')}: {warning.get('path', '')}{suffix}")
    invalid_release_warnings = [
        item for item in doc.get("warnings") or []
        if item.get("type") == "invalid_release_state"
    ]
    if invalid_release_warnings:
        print_warnings_header_once()
        for warning in invalid_release_warnings:
            print(f"  release bundle state is invalid: {warning.get('path', '')}")
            for error in warning.get("errors") or []:
                print(f"    {error}")
    if not doc["command_queue"].get("policy_valid", True):
        print_warnings_header_once()
        print("  command queue policy is invalid; target polling is not configured")
        for error in doc["command_queue"].get("policy_errors") or []:
            print(f"    {error}")
    print("")
    print("Recent sessions:")
    if doc["sessions"]:
        for session in doc["sessions"]:
            print(f"  {session.get('service', '')} {session.get('path', '')} state={session.get('state', '')} exit={session.get('exit_reason', '')}")
            print(f"    uploads={session.get('upload_count', 0)} fetches={session.get('fetch_count', 0)} events={session.get('event_count', 0)} artifacts={session.get('artifact_count', 0)} updated={session.get('updated_at', '')}")
            print(f"    metadata: {session.get('metadata_path', '')}")
            if session.get("event_log"):
                print(f"    event_log: {session.get('event_log', '')}")
    else:
        print("  none")
    print("")
    print("Recent uploads:")
    if doc["uploads"]:
        for meta in doc["uploads"]:
            print(f"  {meta.get('filename', '')} size={meta.get('size', '')} sha256={meta.get('sha256_prefix', '')} status={meta.get('status', '')} stored_exists={meta.get('stored_exists', False)}")
            print(f"    source: {meta.get('source_path', '')}")
            print(f"    stored: {meta.get('stored_path', '')}")
            print(f"    metadata: {meta.get('metadata_path', meta.get('_metadata_path', ''))}")
            print(f"    session: {meta.get('session_id', '')} {meta.get('session_path', '')}")
    else:
        print("  none")
    print("")
    print("Recent fetches:")
    if doc["fetches"]:
        for meta in doc["fetches"]:
            print(f"  {meta.get('request_name', '')} size={meta.get('size', '')} sha256={meta.get('sha256_prefix', '')} status={meta.get('status', '')} http={meta.get('http_status', '')} source_exists={meta.get('source_exists', False)}")
            print(f"    source: {meta.get('source_path', '')}")
            print(f"    session: {meta.get('session_id', '')} {meta.get('session_path', '')}")
            if meta.get("event_log"):
                print(f"    event_log: {meta.get('event_log', '')}")
    else:
        print("  none")
    print("")
    print("Command queue:")
    queue = doc["command_queue"]
    print(f"  path: {queue.get('path', '')}")
    print(f"  enabled={queue.get('enabled', 'no')} default_enabled=no port={queue.get('port', '')} tls={queue.get('tls', '')} require_token={queue.get('require_token', '')}")
    print(f"  allowed_commands={queue.get('allowed_commands', '')} allow_arbitrary={queue.get('allow_arbitrary', '')} active_control_channel=no")
    print(f"  policy_valid={'yes' if queue.get('policy_valid') else 'no'} configured_for_polling={'yes' if queue.get('configured_for_polling') else 'no'} arbitrary_policy_requested={'yes' if queue.get('arbitrary_policy_requested') else 'no'} arbitrary_execution_allowed=no")
    for error in queue.get("policy_errors") or []:
        print(f"  policy_error={error}")
    print(f"  queued: {queue.get('queued_count', 0)} results={queue.get('result_count', 0)} output_exceeded={queue.get('result_output_exceeded_count', 0)} total={queue.get('total_count', 0)} execution_supported=no delivery_supported=no")
    print(f"  latest_created={queue.get('latest_created_at', '') or '-'} latest_result={queue.get('latest_result_received_at', '') or '-'}")
    print_command_queue_mode_lines(queue)
    for rec in (queue.get("commands") or [])[:8]:
        print(f"  {rec.get('id', '')} {rec.get('status', '')} {rec.get('command', '')}")
        if rec.get("result_received_at"):
            print(f"    result: {rec.get('result_received_at', '')} source={rec.get('result_source_path', '')}")
            print(f"    result_output={rec.get('result_output_bytes', '')} limit={rec.get('result_output_limit_bytes', '')} exceeded_limit={'yes' if rec.get('result_output_exceeded_limit') else 'no'}")
    print("")
    print("Event log:")
    stats = doc.get("event_log_stats") or {}
    print(f"  path: {doc.get('event_log', '')}")
    print(f"  total={stats.get('total_count', 0)} tail={stats.get('tail_count', 0)} invalid={stats.get('invalid_count', 0)} limit={stats.get('tail_limit', 0)}")
    print(f"  first={stats.get('first_event_at', '') or '-'} latest={stats.get('latest_event_at', '') or '-'}")
    print(f"  services: {format_counts(stats.get('by_service') or {})}")
    print(f"  events: {format_counts(stats.get('by_event') or {})}")
    print(f"  levels: {format_counts(stats.get('by_level') or {})}")
    print(f"  remotes: {format_counts(stats.get('by_remote') or {})}")
    if doc["events"]:
        for event in doc["events"][-8:]:
            suffix = compact_event_details(event)
            if suffix:
                suffix = f" {suffix}"
            print(f"  {event.get('ts', '')} {event.get('level', '')} {event.get('service', '')}:{event.get('event', '')}{suffix}")
    else:
        print("  events_tail: none")
    if doc["release"]:
        print("")
        print("Release browser:")
        print(f"  release_dir: {doc['release'].get('release_dir', '')}")
        print(f"  release_name: {doc['release'].get('release_name', '')}")
        for artifact in doc["release"].get("artifacts", [])[:12]:
            compat = (artifact.get("compatibility") or {}).get("label") or ""
            suffix = f" compatibility={compat}" if compat else ""
            print(f"  artifact {artifact.get('name', '')} tuple={artifact.get('tuple_path', '')} preset={artifact.get('payload_preset', '')}{suffix}")
            for line in artifact_compatibility_lines(artifact):
                print(f"    {line}")
        for device in doc["release"].get("devices", [])[:8]:
            print(f"  device {device.get('name', '')} -> {device.get('tuple_path', '')} artifacts={device.get('artifact_count', len(device.get('artifacts') or []))}")
            for path in (device.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")
        for item in doc["release"].get("tuples", [])[:8]:
            print(f"  tuple {item.get('path', '')} artifacts={item.get('artifact_count', len(item.get('artifacts') or []))}")
            for path in (item.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")
    return 0


def stop_managed_services(cfg):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    services = state.get("services") if isinstance(state, dict) else {}
    if not isinstance(services, dict):
        services = {}
    stopped = 0
    skipped = 0
    for name, rec in sorted(services.items()):
        pid = rec.get("pid") if isinstance(rec, dict) else None
        if isinstance(rec, dict) and rec.get("status") == "stopped":
            print(f"{name}: already stopped")
            skipped += 1
            continue
        if not pid:
            mark_service_stopped(cfg, name)
            append_event(cfg, name, "service_stop", details={"reason": "no-pid", "via": "server-stop"})
            print(f"{name}: no pid recorded; marked stopped")
            skipped += 1
            continue
        if not pid_alive(pid):
            mark_service_stopped(cfg, name)
            append_event(cfg, name, "service_stop", details={"pid": pid, "reason": "stale-pid", "via": "server-stop"})
            print(f"{name}: stale pid {pid}; marked stopped")
            skipped += 1
            continue
        ownership_evidence = managed_server_evidence(pid, cfg=cfg, rec=rec)
        if not ownership_evidence:
            print(f"{name}: skipped pid {pid}; not clearly a managed busierbox-server process")
            append_event(cfg, name, "service_stop_skipped", details={"pid": pid, "reason": "unmanaged-pid", "via": "server-stop"})
            skipped += 1
            continue
        try:
            append_event(cfg, name, "shutdown", details={"pid": pid, "reason": "SIGTERM", "via": "server-stop", "ownership_evidence": ownership_evidence})
            os.kill(int(pid), signal.SIGTERM)
            if wait_service_port_released(cfg, name, pid=pid):
                stopped += 1
                mark_service_stopped(cfg, name)
                append_event(cfg, name, "service_stop", details={"pid": pid, "via": "server-stop", "ownership_evidence": ownership_evidence, "port_released": True})
                print(f"{name}: stopped pid {pid}; port released")
            else:
                raise TimeoutError(f"listener port {service_port(cfg, name)} still appears bound after SIGTERM")
        except OSError as exc:
            mark_service_error(cfg, name, exc)
            print(f"{name}: failed to stop pid {pid}: {exc}", file=sys.stderr)
            skipped += 1
        except TimeoutError as exc:
            mark_service_error(cfg, name, exc)
            append_event(cfg, name, "service_stop_failed", "error", details={"pid": pid, "reason": "port-still-bound", "via": "server-stop", "error": str(exc)})
            print(f"{name}: failed to stop pid {pid}: {exc}", file=sys.stderr)
            skipped += 1
    if stopped == 0 and skipped == 0:
        print("No managed services recorded.")
    return 0


def print_workbench(cfg):
    snap = workbench_snapshot(cfg)
    summary = snap.get("summary") or {}
    print("BusierBox Operator Workbench")
    print(f"Current time: {utc_now()}")
    print(f"Selected local IP: {snap['selected_local_ip']}")
    print(
        "Service summary: "
        f"listening={summary.get('listening_count', 0)} "
        f"configured_listening={summary.get('configured_listening_count', 0)} "
        f"errors={summary.get('error_count', 0)} "
        f"stale={summary.get('stale_count', 0)} "
        f"warnings={len(snap.get('warnings') or [])}"
    )
    print("")
    print("Operator paths:")
    paths = snap.get("paths") or {}
    for label, key in (
        ("state_file", "state_file"),
        ("staged_files", "staged_files"),
        ("command_queue_file", "command_queue_file"),
        ("command_copy_file", "command_copy_file"),
        ("event_log", "event_log"),
        ("session_root", "session_root"),
    ):
        print(f"  {label}: {paths.get(key, snap.get(key, ''))}")
    print(f"  tls_cert: {cfg.get('tls_cert', '')}")
    print(f"  tls_key: {cfg.get('tls_key', '')}")
    print("")
    print("Path health:")
    path_status = snap.get("path_status") or {}
    for name in sorted(path_status):
        rec = path_status[name]
        exists = "yes" if rec.get("exists") else "no"
        parent_exists = "yes" if rec.get("parent_exists") else "no"
        writable = "yes" if rec.get("writable") else "no"
        print(f"  {name}: exists={exists} parent_exists={parent_exists} writable={writable} kind={rec.get('expected_kind', '')}")
    print("")
    print("Local IP candidates:")
    candidates = snap["local_ips"]
    if candidates:
        for ip in candidates:
            print(f"  {ip}")
    else:
        print("  OPERATOR_IP")
    print("")
    print("Services:")
    for row in snap["services"].values():
        item = row["status_row"]
        pid = f" pid={item['pid']}" if item["pid"] else ""
        tls = "yes" if item["tls"] else "no"
        print(f"  {item['name']:12s} bind={item.get('bind_address', '')} port={item['port']} tls={tls} desired={item['configured']} actual={item['actual']}{pid}")
        if item["error"]:
            print(f"    error: {item['error']}")
        if item["session_log"]:
            print(f"    log: {item['session_log']}")
    print("")
    print("Warnings:")
    warnings = snap.get("warnings") or []
    if warnings:
        for warning in warnings:
            service = warning.get("service", "")
            prefix = f"{warning.get('type', '')}"
            if service:
                prefix = f"{prefix} {service}"
            print(f"  {prefix}: {warning.get('message', '')}")
            if warning.get("bind_address") or warning.get("port"):
                print(f"    bind: {warning.get('bind_address', '')}:{warning.get('port', '')}")
            if warning.get("suggested_action"):
                print(f"    suggested_action: {warning.get('suggested_action', '')}")
            if warning.get("error"):
                print(f"    error: {warning.get('error', '')}")
            for owner in warning.get("owners") or []:
                print(f"    owner_pid={owner.get('pid', '')} {owner.get('cmdline', '')}")
            for pid in warning.get("listener_pids") or []:
                print(f"    listener_pid={pid}")
    else:
        print("  none")
    print("")
    print("Staged files:")
    if snap["staged"]:
        for name in sorted(snap["staged"]):
            rec = snap["staged"][name]
            sha = str(rec.get("sha256", ""))[:12]
            print(f"  {name} <- {rec.get('source_path', '')} size={rec.get('size', '')} sha256={sha} staged={rec.get('staged_at', '')}")
            print(f"    {rec.get('fetch_command') or render_fetch_command(name, cfg)}")
    else:
        print("  none")
    print("")
    print("Received uploads:")
    uploads = recent_upload_metadata(cfg)
    if uploads:
        for meta in uploads:
            sha = str(meta.get("sha256", ""))[:12]
            print(f"  {meta.get('filename', '')} size={meta.get('size', '')} sha256={sha} status={meta.get('transfer_status', meta.get('status', ''))}")
            print(f"    source: {meta.get('source_path', '')}")
            print(f"    remote: {meta.get('remote_addr', '')} at {meta.get('timestamp', '')}")
            print(f"    stored: {meta.get('stored_path', '')}")
            print(f"    metadata: {meta.get('metadata_path', meta.get('_metadata_path', ''))}")
            print(f"    session: {meta.get('session_id', '')} {meta.get('session_path', '')}")
            print(f"    stored_exists: {meta.get('stored_exists', False)}")
    else:
        print("  none")
    print("")
    print("Recent sessions:")
    sessions = snap["sessions"]
    if sessions:
        for item in sessions:
            print(f"  {item.get('service', '')} {item.get('path', '')} state={item.get('state', '')} exit={item.get('exit_reason', '')} updated={item.get('updated_at', '')}")
            print(f"    uploads={item.get('upload_count', 0)} fetches={item.get('fetch_count', 0)} events={item.get('event_count', 0)} artifacts={item.get('artifact_count', 0)}")
            print(f"    metadata: {item.get('metadata_path', '')}")
            if item.get("event_log"):
                print(f"    event_log: {item.get('event_log', '')}")
    else:
        print("  none")
    print("")
    print("Generated target commands:")
    for cmd in snap["target_commands"]:
        print(f"  {cmd}")
    print("")
    print("Command queue:")
    queue = snap["command_queue"]
    print(f"  path: {queue.get('path', '')}")
    print(f"  enabled={queue.get('enabled', 'no')} default_enabled=no port={queue.get('port', '')} tls={queue.get('tls', '')} require_token={queue.get('require_token', '')}")
    print(f"  allowed_commands={queue.get('allowed_commands', '')} allow_arbitrary={queue.get('allow_arbitrary', '')} active_control_channel=no")
    print(f"  policy_valid={'yes' if queue.get('policy_valid') else 'no'} configured_for_polling={'yes' if queue.get('configured_for_polling') else 'no'} arbitrary_policy_requested={'yes' if queue.get('arbitrary_policy_requested') else 'no'} arbitrary_execution_allowed=no")
    for error in queue.get("policy_errors") or []:
        print(f"  policy_error={error}")
    print(f"  queued: {queue.get('queued_count', 0)} results={queue.get('result_count', 0)} output_exceeded={queue.get('result_output_exceeded_count', 0)} total={queue.get('total_count', 0)} execution_supported=no delivery_supported=no")
    print(f"  latest_created={queue.get('latest_created_at', '') or '-'} latest_result={queue.get('latest_result_received_at', '') or '-'}")
    print_command_queue_mode_lines(queue)
    for rec in (queue.get("commands") or [])[:8]:
        print(f"  {rec.get('id', '')} {rec.get('status', '')} {rec.get('command', '')}")
        if rec.get("result_received_at"):
            print(f"    result: {rec.get('result_received_at', '')} source={rec.get('result_source_path', '')}")
            print(f"    result_output={rec.get('result_output_bytes', '')} limit={rec.get('result_output_limit_bytes', '')} exceeded_limit={'yes' if rec.get('result_output_exceeded_limit') else 'no'}")
    print("")
    print("Event log:")
    stats = snap.get("event_log_stats") or {}
    print(f"  path: {snap.get('event_log', '')}")
    print(f"  total={stats.get('total_count', 0)} tail={stats.get('tail_count', 0)} invalid={stats.get('invalid_count', 0)} limit={stats.get('tail_limit', 0)}")
    print(f"  first={stats.get('first_event_at', '') or '-'} latest={stats.get('latest_event_at', '') or '-'}")
    print(f"  services: {format_counts(stats.get('by_service') or {})}")
    print(f"  events: {format_counts(stats.get('by_event') or {})}")
    print(f"  levels: {format_counts(stats.get('by_level') or {})}")
    print(f"  remotes: {format_counts(stats.get('by_remote') or {})}")
    if snap["events"]:
        for event in snap["events"][-8:]:
            suffix = compact_event_details(event)
            if suffix:
                suffix = f" {suffix}"
            print(f"  {event.get('ts', '')} {event.get('level', '')} {event.get('service', '')}:{event.get('event', '')}{suffix}")
    else:
        print("  events_tail: none")
    rel = release_context()
    if rel:
        print("")
        print("Release artifact browser:")
        print(f"  release_dir: {rel.get('release_dir', '')}")
        print(f"  release_name: {rel.get('release_name', '')}")
        if rel.get("artifacts"):
            for artifact in rel["artifacts"][:12]:
                sha = str(artifact.get("sha256", ""))[:12]
                compat = (artifact.get("compatibility") or {}).get("label") or ""
                suffix = f" compatibility={compat}" if compat else ""
                print(f"  artifact {artifact.get('name', '')} size={artifact.get('size', '')} sha256={sha} tuple={artifact.get('tuple_path', '')} preset={artifact.get('payload_preset', '')}{suffix}")
                for line in artifact_compatibility_lines(artifact):
                    print(f"    {line}")
                for line in artifact_provider_status_lines(artifact):
                    print(f"    {line}")
                for line in artifact_doom_wad_lines(artifact):
                    print(f"    {line}")
                print(f"    stage: scripts/busierbox-server --stage-release-artifact {shquote(artifact.get('release_path') or artifact.get('name', ''))}")
        else:
            print("  artifacts: none")
        print("Release devices:")
        for device in rel.get("devices", [])[:12] or [{"name": "none", "tuple_path": ""}]:
            print(f"  {device.get('name', '')} -> {device.get('tuple_path', '')} artifacts={device.get('artifact_count', len(device.get('artifacts') or []))}")
            for path in (device.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")
        print("Release tuples:")
        for item in rel.get("tuples", [])[:12] or [{"path": "none"}]:
            print(f"  {item.get('path', '')} artifacts={item.get('artifact_count', len(item.get('artifacts') or []))}")
            for path in (item.get("artifact_paths") or [])[:3]:
                print(f"    artifact_path: {path}")


def start_service_process(cfg, service, argv_extra=None):
    current = {row["name"]: row for row in service_status_rows(cfg)}.get(service)
    if current and current.get("actual") == "listening":
        append_event(
            cfg,
            service,
            "service_start_skipped",
            details={
                "reason": "already-listening",
                "port": current.get("port", 0),
                "listener_pids": current.get("listener_pids") or [],
                "pid": current.get("pid", ""),
            },
        )
        print(f"{service}: already listening on port {current.get('port', '')}; not starting duplicate")
        return None
    cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--config",
        str(Path(str(cfg.get("_config_path", DEFAULT_CONFIG)))),
        "--transport",
        service,
    ]
    cmd.extend(["--state-file", str(state_file_path(cfg)), "--staged-file", str(staged_file_path(cfg))])
    if service == "file-service":
        cmd.extend(["--file-service-tls", str(cfg.get("file_service_tls", "yes"))])
    if argv_extra:
        cmd.extend(argv_extra)
    log_root = Path(str(cfg.get("session_root", "local/sessions")))
    log_root.mkdir(parents=True, exist_ok=True)
    log_path = log_root / f"operator-{service}-{int(time.time())}.log"
    cmd.extend(["--managed-by", str(os.getpid()), "--process-log", str(log_path)])
    with log_path.open("ab") as log:
        proc = start_child_process(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    update_server_state(cfg, service, "starting", {"pid": proc.pid, "managed_by": os.getpid(), "process_log": str(log_path)})
    append_event(cfg, service, "service_start_requested", details={"pid": proc.pid, "process_log": str(log_path), "managed_by": os.getpid()})
    print(f"started {service}: pid={proc.pid} log={log_path}")
    return proc


def stop_recorded_service(cfg, service):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    rec = (state.get("services") or {}).get(service, {})
    pid = rec.get("pid")
    if not pid:
        print(f"{service}: no recorded pid")
        mark_service_stopped(cfg, service)
        append_event(cfg, service, "service_stop", details={"reason": "no-pid", "via": "workbench-stop"})
        return
    if not pid_alive(pid):
        print(f"{service}: stale pid {pid}; marked stopped")
        mark_service_stopped(cfg, service)
        append_event(cfg, service, "service_stop", details={"pid": pid, "reason": "stale-pid", "via": "workbench-stop"})
        return
    ownership_evidence = managed_server_evidence(pid, cfg=cfg, rec=rec)
    if not ownership_evidence:
        print(f"{service}: skipped pid {pid}; not clearly a managed busierbox-server process")
        append_event(cfg, service, "service_stop_skipped", details={"pid": pid, "reason": "unmanaged-pid", "via": "workbench-stop"})
        return
    try:
        append_event(cfg, service, "shutdown", details={"pid": pid, "reason": "SIGTERM", "via": "workbench-stop", "ownership_evidence": ownership_evidence})
        os.kill(int(pid), signal.SIGTERM)
        if wait_service_port_released(cfg, service, pid=pid):
            print(f"stopped {service}: pid={pid}; port released")
            mark_service_stopped(cfg, service)
            append_event(cfg, service, "service_stop", details={"pid": pid, "via": "workbench-stop", "ownership_evidence": ownership_evidence, "port_released": True})
        else:
            raise TimeoutError(f"listener port {service_port(cfg, service)} still appears bound after SIGTERM")
    except OSError as exc:
        mark_service_error(cfg, service, exc)
        print(f"{service}: unable to stop pid {pid}: {exc}", file=sys.stderr)
    except TimeoutError as exc:
        mark_service_error(cfg, service, exc)
        append_event(cfg, service, "service_stop_failed", "error", details={"pid": pid, "reason": "port-still-bound", "via": "workbench-stop", "error": str(exc)})
        print(f"{service}: unable to stop pid {pid}: {exc}", file=sys.stderr)


def run_line_tui(cfg):
    while not SHUTDOWN.is_set():
        print("")
        print_workbench(cfg)
        print("")
        print("Actions:")
        print("  1 start ssh")
        print("  2 start tls-shell")
        print("  3 start plain-shell")
        print("  4 start file-service")
        print("  5 stop service")
        print("  6 stage file")
        print("  7 list staged")
        print("  8 unstage file")
        print("  9 open local path in pager")
        print("  c show/copy generated commands")
        print("  r refresh")
        print("  ? help")
        print("  q quit")
        choice = input("> ").strip()
        if choice == "q":
            mark_service_stopped(cfg, "workbench")
            return 0
        if choice in {"1", "2", "3", "4"}:
            service = {"1": "ssh", "2": "tls-shell", "3": "plain-shell", "4": "file-service"}[choice]
            start_service_process(cfg, service)
        elif choice == "5":
            stop_recorded_service(cfg, input("service> ").strip())
        elif choice == "6":
            path = input("local file> ").strip()
            name = input("target request name> ").strip()
            rec = stage_file(cfg, path, name)
            print(f"staged {rec['request_name']}")
            print(render_fetch_command(rec["request_name"], cfg))
        elif choice == "7":
            print_staged(cfg)
        elif choice == "8" or choice == "d":
            name = input("target request name> ").strip()
            if name:
                print("unstaged" if unstage_file(cfg, name) else "not staged")
        elif choice == "9" or choice == "v":
            path = input("local path> ").strip()
            if path:
                print(open_path_in_pager(path))
        elif choice == "c":
            commands = generated_target_commands(cfg)
            for idx, cmd in enumerate(commands, 1):
                print(f"{idx}: {cmd}")
            chosen = input("copy command number, or blank to skip> ").strip()
            if chosen:
                try:
                    rec = copy_generated_command(cfg, chosen)
                    print(f"copied command to {rec['path']} clipboard={'yes' if rec['clipboard'] else 'no'}")
                except ValueError as exc:
                    print(exc)
        elif choice == "?":
            print("Keys: 1-4 start services, 5 stop, 6 stage, 8/d unstage, 9/v view, c show/copy commands, r refresh, q quit.")
    return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0


def run_curses_tui(cfg):
    import curses

    def safe_add(stdscr, row, col, text, attr=0):
        height, width = stdscr.getmaxyx()
        if row < 0 or row >= height or col >= width:
            return
        try:
            stdscr.addstr(row, col, str(text)[:max(0, width - col - 1)], attr)
        except curses.error:
            pass

    def draw_list(stdscr, title, lines, row, col, height, width, selected=False):
        attr = curses.A_REVERSE if selected else curses.A_BOLD
        safe_add(stdscr, row, col, title[:width - 1], attr)
        for idx, line in enumerate(lines[:max(0, height - 1)], 1):
            safe_add(stdscr, row + idx, col, line[:width - 1])

    def selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples):
        if pane == 0 and services:
            row = services[min(selected, len(services) - 1)]
            return row.get("session_log") or row.get("process_log") or ""
        if pane == 1 and staged_names:
            rec = snap["staged"][staged_names[min(selected, len(staged_names) - 1)]]
            return rec.get("source_path", "")
        if pane == 2 and snap["uploads"]:
            rec = snap["uploads"][min(selected, len(snap["uploads"]) - 1)]
            return rec.get("metadata_path") or rec.get("_metadata_path") or rec.get("stored_path") or ""
        if pane == 3 and snap["sessions"]:
            rec = snap["sessions"][min(selected, len(snap["sessions"]) - 1)]
            return rec.get("path", "")
        if pane == 4:
            return str(Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "events.jsonl")
        if pane == 5:
            return ""
        if pane == 6 and release_artifacts:
            rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
            return rec.get("path", "")
        if pane == 7:
            combined = [{"path": release.get("release_index", "")}] + release_devices + release_tuples
            rec = combined[min(selected, len(combined) - 1)] if combined else {}
            artifact_paths = rec.get("artifact_paths") or []
            return rec.get("filesystem_path") or rec.get("path") or (artifact_paths[0] if artifact_paths else "") or rec.get("release_index") or release.get("release_json", "")
        return ""

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        pane = 0
        selected = 0
        while not SHUTDOWN.is_set():
            snap = workbench_snapshot(cfg)
            services = [row["status_row"] for row in snap["services"].values()]
            staged_names = sorted(snap["staged"])
            upload_lines = [
                f"{'>' if pane == 2 and idx == selected else ' '} {m.get('filename', '')} {m.get('size', '')}B {m.get('sha256_prefix', str(m.get('sha256', ''))[:12])} status={m.get('status', '')}"
                for idx, m in enumerate(snap["uploads"])
            ] or ["none"]
            session_lines = [
                f"{'>' if pane == 3 and idx == selected else ' '} {s.get('service', '')} {Path(s.get('path', '')).name} up={s.get('upload_count', 0)} fetch={s.get('fetch_count', 0)} ev={s.get('event_count', 0)} exit={s.get('exit_reason', '') or '-'}"
                for idx, s in enumerate(snap["sessions"])
            ] or ["none"]
            release = snap.get("release") or {}
            release_artifacts = release.get("artifacts") or []
            release_devices = release.get("devices") or []
            release_tuples = release.get("tuples") or []
            release_lines = [
                f"{'>' if pane == 6 and idx == selected else ' '} {a.get('name', '')} {a.get('payload_preset', '')} {a.get('tuple_path', '')}"
                for idx, a in enumerate(release_artifacts[:10])
            ] or ["none"]
            device_tuple_lines = [
                f"{'>' if pane == 7 and selected == 0 else ' '} index {Path(release.get('release_index', '')).name if release.get('release_index') else '-'}"
            ] + [
                f"{'>' if pane == 7 and idx == selected else ' '} dev {d.get('name', '')} -> {d.get('tuple_path', '')} artifacts={d.get('artifact_count', len(d.get('artifacts') or []))}"
                for idx, d in enumerate(release_devices[:5], 1)
            ] + [
                f"{'>' if pane == 7 and idx == selected else ' '} tuple {t.get('path', '')} artifacts={t.get('artifact_count', len(t.get('artifacts') or []))}"
                for idx, t in enumerate(release_tuples[:5], 1 + len(release_devices[:5]))
            ]
            device_tuple_lines = device_tuple_lines or ["none"]
            recent_events = snap["events"][-8:]
            event_lines = [
                f"{'>' if pane == 4 and idx == selected else ' '} {e.get('ts', '')} {e.get('level', '')} {e.get('service', '')}:{e.get('event', '')}"
                for idx, e in enumerate(recent_events)
            ] or ["none"]
            command_lines = [
                f"{'>' if pane == 5 and idx == selected else ' '} {idx + 1}: {cmd}"
                for idx, cmd in enumerate(snap["target_commands"])
            ] or ["none"]
            service_lines = []
            for idx, row in enumerate(services):
                prefix = ">" if pane == 0 and idx == selected else " "
                tls = "yes" if row["tls"] else "no"
                service_lines.append(f"{prefix} {row['name']:12s} {row['actual']}/{row['configured']} port={row['port']} tls={tls} pid={row['pid'] or '-'}")
            staged_lines = []
            for idx, name in enumerate(staged_names):
                rec = snap["staged"][name]
                prefix = ">" if pane == 1 and idx == selected else " "
                staged_lines.append(f"{prefix} {name} {rec.get('size', '')}B {str(rec.get('sha256', ''))[:8]}")
            staged_lines = staged_lines or [" none"]
            detail_lines = []
            if pane == 0 and services:
                row = services[min(selected, len(services) - 1)]
                detail_lines = [
                    f"service: {row['name']}",
                    f"port: {row['port']}",
                    f"desired: {row['configured']}",
                    f"actual: {row['actual']}",
                    f"tls: {'yes' if row['tls'] else 'no'}",
                    f"pid: {row['pid'] or '-'} alive={row['pid_alive']}",
                    f"session_log: {row['session_log'] or '-'}",
                    f"process_log: {row['process_log'] or '-'}",
                    f"error: {row['error'] or '-'}",
                ]
            elif pane == 1 and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)]
                rec = snap["staged"][name]
                detail_lines = [
                    f"request: {name}",
                    f"source: {rec.get('source_path', '')}",
                    f"size: {rec.get('size', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"staged: {rec.get('staged_at', '')}",
                    f"source_exists: {rec.get('source_exists', False)}",
                    rec.get("fetch_command") or render_fetch_command(name, cfg, host=snap["selected_local_ip"]),
                    rec.get("fetch_command_force") or render_fetch_command(name, cfg, host=snap["selected_local_ip"], force=True),
                    "v opens source in pager",
                ]
            elif pane == 2 and snap["uploads"]:
                rec = snap["uploads"][min(selected, len(snap["uploads"]) - 1)]
                detail_lines = [
                    f"upload: {rec.get('filename', '')}",
                    f"source: {rec.get('source_path', '')}",
                    f"stored: {rec.get('stored_path', '')}",
                    f"metadata: {rec.get('metadata_path', rec.get('_metadata_path', ''))}",
                    f"session: {rec.get('session_id', '')}",
                    f"session_path: {rec.get('session_path', '')}",
                    f"stored_exists: {rec.get('stored_exists', False)}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"remote: {rec.get('remote_addr', '')}",
                    "v opens metadata in pager",
                ]
            elif pane == 3 and snap["sessions"]:
                rec = snap["sessions"][min(selected, len(snap["sessions"]) - 1)]
                detail_lines = [
                    f"session: {rec.get('session_id', Path(rec.get('path', '')).name)}",
                    f"service: {rec.get('service', '')}",
                    f"path: {rec.get('path', '')}",
                    f"metadata: {rec.get('metadata_path', '')}",
                    f"event_log: {rec.get('event_log', '')}",
                    f"state: {rec.get('state', '')}",
                    f"exit: {rec.get('exit_reason', '') or '-'}",
                    f"uploads: {rec.get('upload_count', 0)}",
                    f"fetches: {rec.get('fetch_count', 0)}",
                    f"events: {rec.get('event_count', 0)}",
                    f"artifacts: {rec.get('artifact_count', 0)}",
                    "v opens session metadata in pager",
                ]
            elif pane == 4 and recent_events:
                event = recent_events[min(selected, len(recent_events) - 1)]
                details = event.get("details") if isinstance(event.get("details"), dict) else {}
                detail_lines = [
                    f"event: {event.get('event', '')}",
                    f"event_id: {event.get('id', '')}",
                    f"ts: {event.get('ts', '')}",
                    f"level: {event.get('level', '')}",
                    f"service: {event.get('service', '')}",
                    f"session: {event.get('session', '') or '-'}",
                    f"session_path: {event.get('session_path', '') or '-'}",
                    f"remote: {event.get('remote', '') or '-'}",
                    f"outcome: {compact_event_details(event) or '-'}",
                    f"details_json: {json.dumps(details, sort_keys=True)}",
                    "v opens operator event log in pager",
                ]
            elif pane == 6 and release_artifacts:
                rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                detail_lines = [
                    f"release: {release.get('release_name', '')}",
                    f"artifact: {rec.get('name', '')}",
                    f"path: {rec.get('path', '')}",
                    f"tuple: {rec.get('tuple_path', '')}",
                    f"payload: {rec.get('payload_preset', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                ]
                detail_lines.extend(artifact_compatibility_lines(rec))
                detail_lines.extend([
                    "enter/s stages for fetch",
                    "v opens artifact in pager",
                ])
            elif pane == 7:
                combined = [{"path": release.get("release_index", "")}] + release_devices + release_tuples
                rec = combined[min(selected, len(combined) - 1)] if combined else {}
                detail_lines = [
                    f"release: {release.get('release_name', '')}",
                    f"index: {release.get('release_index', '')}",
                    f"devices: {len(release_devices)}",
                    f"tuples: {len(release_tuples)}",
                    f"selected_artifacts: {rec.get('artifact_count', len(rec.get('artifacts') or []))}",
                    "v opens release index in pager",
                ]
                for path in (rec.get("artifact_paths") or [])[:6]:
                    detail_lines.append(f"artifact_path: {path}")
            elif pane == 5 and snap["target_commands"]:
                command = snap["target_commands"][min(selected, len(snap["target_commands"]) - 1)]
                detail_lines = [
                    "generated target command:",
                    command,
                    f"copy_file: {command_copy_path(cfg)}",
                    "c copies command locally",
                ]
            else:
                detail_lines = [
                    f"state: {state_file_path(cfg)}",
                    f"staged: {staged_file_path(cfg)}",
                    f"cert: {cfg.get('tls_cert', '')}",
                    f"key: {cfg.get('tls_key', '')}",
                ]
            stdscr.erase()
            height, width = stdscr.getmaxyx()
            active = sum(1 for row in services if row["actual"] == "listening")
            warning_count = len(snap.get("warnings") or [])
            safe_add(stdscr, 0, 0, f"BusierBox Operator Workbench | active={active} warnings={warning_count} | ip={snap['selected_local_ip']} | {utc_now()} | tab panes j/k move enter start/stop s stage d unstage v view c copy ? help q quit", curses.A_REVERSE)
            left_w = max(34, width // 3)
            right_w = max(20, width - left_w - 1)
            lower_y = max(12, height // 2)
            draw_list(stdscr, "Services", service_lines, 2, 0, lower_y - 2, left_w, pane == 0)
            draw_list(stdscr, "Details", detail_lines, 2, left_w + 1, lower_y - 2, right_w, False)
            third = max(20, width // 3)
            draw_list(stdscr, "Staged Files", staged_lines, lower_y, 0, 7, third, pane == 1)
            draw_list(stdscr, "Recent Uploads", upload_lines, lower_y, third + 1, 7, third, pane == 2)
            draw_list(stdscr, "Recent Sessions", session_lines, lower_y, (third + 1) * 2, 7, width - ((third + 1) * 2), pane == 3)
            events_y = min(height - 8, lower_y + 8)
            draw_list(stdscr, "Event Log", event_lines, events_y, 0, height - events_y - 1, width // 4, pane == 4)
            draw_list(stdscr, "Generated Target Commands", command_lines, events_y, width // 4 + 1, height - events_y - 1, width // 4, pane == 5)
            draw_list(stdscr, "Release Artifacts", release_lines, events_y, (width // 4 + 1) * 2, height - events_y - 1, width // 4, pane == 6)
            draw_list(stdscr, "Devices / Tuples", device_tuple_lines, events_y, (width // 4 + 1) * 3, height - events_y - 1, width - ((width // 4 + 1) * 3), pane == 7)
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return 0
            if key in (curses.KEY_DOWN, ord("j")):
                selected += 1
            elif key in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif key == ord("\t"):
                pane = (pane + 1) % 8
                selected = 0
            elif key == curses.KEY_BTAB:
                pane = (pane - 1) % 8
                selected = 0
            elif key in (ord("1"), ord("2"), ord("3"), ord("4")):
                service = {ord("1"): "ssh", ord("2"): "tls-shell", ord("3"): "plain-shell", ord("4"): "file-service"}[key]
                start_service_process(cfg, service)
            elif key in (10, 13):
                if pane == 0 and services:
                    service = services[min(selected, len(services) - 1)]["name"]
                    if services[min(selected, len(services) - 1)]["actual"] == "listening":
                        stop_recorded_service(cfg, service)
                    else:
                        start_service_process(cfg, service)
                elif pane == 6 and release_artifacts:
                    rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                    try:
                        stage_file(cfg, rec.get("path", ""), rec.get("request_name") or rec.get("name", ""))
                    except ValueError:
                        pass
            elif key == ord("5"):
                curses.echo()
                safe_add(stdscr, height - 2, 0, "service> ")
                service = stdscr.getstr(height - 2, 9, 32).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if service:
                    stop_recorded_service(cfg, service)
            elif key in (ord("6"), ord("s")) and pane == 6 and release_artifacts:
                rec = release_artifacts[min(selected, len(release_artifacts) - 1)]
                try:
                    stage_file(cfg, rec.get("path", ""), rec.get("request_name") or rec.get("name", ""))
                except ValueError:
                    pass
            elif key in (ord("6"), ord("s")):
                curses.echo()
                safe_add(stdscr, height - 3, 0, "local file> ")
                path = stdscr.getstr(height - 3, 12, 240).decode("utf-8", errors="replace").strip()
                safe_add(stdscr, height - 2, 0, "target request name> ")
                name = stdscr.getstr(height - 2, 21, 240).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if path and name:
                    try:
                        stage_file(cfg, path, name)
                    except ValueError:
                        pass
            elif key in (ord("d"), ord("D")) and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)] if pane == 1 else ""
                if name:
                    unstage_file(cfg, name)
            elif key in (ord("v"), ord("V")):
                path = selected_view_path(pane, selected, snap, services, staged_names, release, release_artifacts, release_devices, release_tuples)
                message = ""
                if path:
                    try:
                        curses.def_prog_mode()
                        curses.endwin()
                        message = open_path_in_pager(path)
                    finally:
                        curses.reset_prog_mode()
                        stdscr.keypad(True)
                        curses.curs_set(0)
                else:
                    message = "no local path for selected item"
                safe_add(stdscr, height - 2, 0, message)
                stdscr.getch()
            elif key in (ord("?"),):
                safe_add(stdscr, height - 2, 0, "Help: arrows/jk move, Tab panes, Enter start/stop, s stage, d unstage, v view, c copy command, r refresh, q quit")
                stdscr.getch()
            elif key in (ord("c"), ord("C")):
                if snap["target_commands"]:
                    idx = min(selected, len(snap["target_commands"]) - 1) + 1 if pane == 5 else 1
                    try:
                        rec = copy_generated_command(cfg, idx)
                        safe_add(stdscr, height - 2, 0, f"Copied command {idx} to {rec['path']} clipboard={'yes' if rec['clipboard'] else 'no'}")
                    except ValueError as exc:
                        safe_add(stdscr, height - 2, 0, str(exc))
                else:
                    safe_add(stdscr, height - 2, 0, "No generated target commands.")
                stdscr.getch()
            max_items = (
                len(services) if pane == 0 else
                len(staged_names) if pane == 1 else
                len(snap["uploads"]) if pane == 2 else
                len(snap["sessions"]) if pane == 3 else
                len(recent_events) if pane == 4 else
                len(snap["target_commands"]) if pane == 5 else
                len(release_artifacts) if pane == 6 else
                (1 + len(release_devices[:5]) + len(release_tuples[:5])) if pane == 7 else
                1
            )
            selected = min(max(0, selected), max(0, max_items - 1))
        return 130 if SHUTDOWN_REASON in ("SIGINT", "SIGTERM", "keyboard_interrupt") else 0

    return curses.wrapper(draw)


def run_tui(cfg):
    update_server_state(cfg, "workbench", "open", {"state_file": str(state_file_path(cfg))})
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print_workbench(cfg)
        return 0
    try:
        return run_curses_tui(cfg)
    except KeyboardInterrupt:
        request_shutdown("keyboard_interrupt")
        print("busierbox-server: interrupted, shutting down workbench", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"curses workbench unavailable, using line menu: {exc}", file=sys.stderr)
        return run_line_tui(cfg)
    finally:
        state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
        for name, rec in (state.get("services") or {}).items():
            if isinstance(rec, dict) and str(rec.get("managed_by", "")) == str(os.getpid()):
                stop_recorded_service(cfg, name)
        mark_service_stopped(cfg, "workbench")
        append_event(cfg, "workbench", "shutdown", details={"reason": SHUTDOWN_REASON or "quit"})


def _resolve_transport(cfg, args_transport):
    """Map --transport flag and config fields to a canonical action."""
    if args_transport:
        t = args_transport
        # Aliases
        if t == "ssh-reverse":
            t = "ssh"
        elif t == "socat-tls":
            t = "tls-shell"
        elif t == "builtin-tls":
            t = "tls-shell"
        return t

    # Derive from config transport + encryption
    if yes(cfg.get("file_service_enable", "no")):
        return "file-service"
    t = cfg.get("transport", "ssh")
    enc = cfg.get("encryption", "tls")
    if t == "ssh":
        return "ssh"
    if enc == "tls":
        return "tls-shell"
    return "plain-shell"


def main(argv=None):
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        description="Catch BusierBox reverse-access transports from a target.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Transport modes:
  ssh         — Paramiko reverse-forward listener for Dropbear/dbclient (BB_RSHELL_TRANSPORT=ssh)
  tls-shell   — TLS shell listener accepting builtin+tls AND socat+tls transports
  plain-shell — Plaintext shell listener (debug/insecure; socat+none or builtin+none)
  file-service — Receive-only TLS upload service for target-initiated files/evidence

File staging:
  --transport file-service --serve-file ./tool --as /tmp/tool
  --transport file-service --serve-dir local/operator-files
  --stage-release-artifact by-tuple/.../bin/busierbox-target-full
  --transport file-service --list-staged

Command queue:
  --queue-command 'busierbox reality-test --json'
  --list-command-queue
  --record-command-result cq-id --result-json result.json
  --clear-command-queue

Aliases accepted: ssh-reverse=ssh, socat-tls=tls-shell, builtin-tls=tls-shell
""",
    )
    parser.add_argument("--config", default=str(DEFAULT_CONFIG),
                        help="JSON config written by menuconfig")
    parser.add_argument("--transport",
                        choices=("ssh", "ssh-reverse", "tls-shell", "socat-tls",
                                 "builtin-tls", "plain-shell", "file-service"),
                        help="transport to listen for (overrides config)")
    parser.add_argument("--file-service", action="store_true",
                        help="receive target-initiated file uploads and store them under local/sessions")
    parser.add_argument("--tui", action="store_true",
                        help="open the operator-side service/file staging workbench")
    parser.add_argument("--no-tui", action="store_true",
                        help="preserve direct listener CLI behavior when running interactively with no args")
    parser.add_argument("--status", action="store_true",
                        help="show managed service state, actual listeners, sessions, uploads, and stale warnings")
    parser.add_argument("--json-status", action="store_true",
                        help="print --status information as JSON")
    parser.add_argument("--api-status", action="store_true",
                        help="alias for --json-status for future frontend/API consumers")
    parser.add_argument("--stop", action="store_true",
                        help="stop known managed listeners from server-state PID records")
    parser.add_argument("--serve-file",
                        help="stage a local file for explicit target fetch")
    parser.add_argument("--as", dest="serve_as",
                        help="target request name for --serve-file, for example /tmp/myfile")
    parser.add_argument("--serve-dir",
                        help="stage direct child files from a local directory for explicit target fetch")
    parser.add_argument("--stage-release-artifact",
                        help="stage an artifact from the current release bundle for explicit target fetch")
    parser.add_argument("--list-staged", action="store_true",
                        help="list operator-staged target fetch files and commands")
    parser.add_argument("--unstage",
                        help="remove a staged target fetch request name")
    parser.add_argument("--state-file",
                        help="operator workbench state JSON path")
    parser.add_argument("--staged-file",
                        help="operator staged-files JSON path")
    parser.add_argument("--command-queue-file",
                        help="operator command queue JSON path")
    parser.add_argument("--command-copy-file",
                        help="operator last copied/generated command text path")
    parser.add_argument("--copy-target-command", type=int,
                        help="copy/export generated target command N to clipboard when available and to the command copy file")
    parser.add_argument("--queue-command",
                        help="record an explicit operator command queue entry; this server does not deliver or execute it")
    parser.add_argument("--queue-timeout", type=int,
                        help="timeout metadata for --queue-command, in seconds")
    parser.add_argument("--queue-max-output", type=int,
                        help="max output metadata for --queue-command, in bytes")
    parser.add_argument("--list-command-queue", action="store_true",
                        help="list explicit operator command queue entries")
    parser.add_argument("--json-command-queue", action="store_true",
                        help="print command queue entries as JSON")
    parser.add_argument("--record-command-result",
                        help="record structured JSON result metadata for a queued command id")
    parser.add_argument("--result-json",
                        help="JSON object to attach with --record-command-result")
    parser.add_argument("--clear-command-queue", action="store_true",
                        help="clear explicit operator command queue entries")
    parser.add_argument("--listen-host", help="listener bind address")
    parser.add_argument("--ssh-port", type=int, help="SSH reverse-forward listener port")
    parser.add_argument("--shell-port", type=int,
                        help="TLS/plain shell listener port (socat-port alias also accepted)")
    parser.add_argument("--socat-port", type=int,
                        help=argparse.SUPPRESS)  # compat alias for --shell-port
    parser.add_argument("--forward-port", type=int,
                        help="remote forward port exposed on the operator workstation")
    parser.add_argument("--file-port", type=int,
                        help="receive-only file service listener port")
    parser.add_argument("--file-service-tls", choices=("yes", "no"),
                        help="use TLS for file-service uploads (default yes)")
    parser.add_argument("--timeout", type=float, default=0,
                        help="seconds to wait for a connection; 0 waits forever")
    parser.add_argument("--no-stdin", action="store_true",
                        help="do not relay local stdin to the remote shell")
    parser.add_argument("--log-only", action="store_true",
                        help="alias for --no-stdin; receive stdout/session log only")
    parser.add_argument("--one-shot", action="store_true",
                        help="exit after one shell session instead of waiting for reconnects")
    parser.add_argument("--script",
                        help="file containing shell input to send after tls/plain shell connect")
    parser.add_argument("--expect",
                        help="literal text that must appear in captured shell output")
    parser.add_argument("--session-timeout", type=float, default=30,
                        help="seconds to allow a scripted shell session; 0 disables the limit")
    parser.add_argument("--managed-by", help=argparse.SUPPRESS)
    parser.add_argument("--process-log", help=argparse.SUPPRESS)
    args = parser.parse_args(raw_argv)

    cfg = load_config(args.config)
    cfg["_config_path"] = args.config
    if args.listen_host:
        cfg["listen_host"] = args.listen_host
    if args.ssh_port:
        cfg["ssh_listen_port"] = args.ssh_port
    shell_port = args.shell_port or args.socat_port
    if shell_port:
        cfg["shell_listen_port"] = shell_port
    if args.forward_port:
        cfg["forward_port"] = args.forward_port
    if args.file_port:
        cfg["file_service_port"] = args.file_port
    if args.file_service_tls:
        cfg["file_service_tls"] = args.file_service_tls
    if args.state_file:
        cfg["server_state"] = args.state_file
    if args.staged_file:
        cfg["staged_files"] = args.staged_file
    if args.command_queue_file:
        cfg["command_queue_file"] = args.command_queue_file
    if args.command_copy_file:
        cfg["command_copy_file"] = args.command_copy_file
    if args.managed_by:
        cfg["_managed_by"] = args.managed_by
    if args.process_log:
        cfg["_process_log"] = args.process_log

    try:
        if args.copy_target_command:
            rec = copy_generated_command(cfg, args.copy_target_command)
            print(f"copied target command {args.copy_target_command} to {rec['path']}")
            print(f"clipboard={'yes' if rec['clipboard'] else 'no'}")
            print(rec["text"])
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    try:
        if args.clear_command_queue:
            count = clear_command_queue(cfg)
            print(f"cleared {count} command queue entr{'y' if count == 1 else 'ies'}")
            if not (args.queue_command or args.list_command_queue or args.json_command_queue):
                return 0
        if args.queue_command:
            rec = queue_command(cfg, args.queue_command, timeout_sec=args.queue_timeout, max_output_bytes=args.queue_max_output)
            print(f"queued {rec['id']}: {rec['command']}")
            print("execution_supported=no delivery_supported=no")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.record_command_result:
            if not args.result_json:
                raise ValueError("--record-command-result requires --result-json")
            rec = record_command_result(cfg, args.record_command_result, args.result_json)
            print(f"recorded result for {rec['id']}: status={rec.get('result', {}).get('status', '')}")
            if not (args.list_command_queue or args.json_command_queue):
                return 0
        if args.list_command_queue or args.json_command_queue:
            print_command_queue(cfg, json_output=args.json_command_queue)
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    if args.status or args.json_status or args.api_status:
        return print_status(cfg, json_output=args.json_status or args.api_status)
    if args.stop:
        return stop_managed_services(cfg)

    timeout = None if args.timeout == 0 else args.timeout
    action = "file-service" if args.file_service else _resolve_transport(cfg, args.transport)
    script_bytes = None
    if args.script:
        script_bytes = Path(args.script).read_bytes()
        if script_bytes and not script_bytes.endswith(b"\n"):
            script_bytes += b"\n"
    session_timeout = None if args.session_timeout == 0 else args.session_timeout

    try:
        if args.serve_file:
            request_name = args.serve_as or Path(args.serve_file).name
            rec = stage_file(cfg, args.serve_file, request_name)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.serve_dir:
            records = stage_dir(cfg, args.serve_dir)
            for rec in records:
                print(f"staged {rec['request_name']} <- {rec['source_path']}")
                print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.stage_release_artifact:
            rec = stage_release_artifact(cfg, args.stage_release_artifact)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.unstage:
            existed = unstage_file(cfg, args.unstage)
            print(f"unstaged {args.unstage}" if existed else f"not staged {args.unstage}")
        if args.list_staged:
            print_staged(cfg)
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    if args.tui or (not raw_argv and not args.no_tui and sys.stdin.isatty() and sys.stdout.isatty()):
        return run_tui(cfg)

    try:
        if action == "ssh":
            return serve_ssh(cfg, timeout)
        if action == "tls-shell":
            return serve_tls_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                   max_sessions=1 if args.one_shot or args.script else 0,
                                   script_bytes=script_bytes, expect=args.expect,
                                   session_timeout=session_timeout)
        if action == "plain-shell":
            return serve_plain_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                     max_sessions=1 if args.one_shot or args.script else 0,
                                     script_bytes=script_bytes, expect=args.expect,
                                     session_timeout=session_timeout)
        if action == "file-service":
            return serve_file_service(cfg, timeout, max_sessions=1 if args.one_shot else 0)
    except KeyboardInterrupt:
        print("busierbox-server: interrupted, shutting down", file=sys.stderr)
        request_shutdown("keyboard_interrupt")
        record_shutdown_event(cfg, action)
        mark_service_stopped(cfg, action)
        return 130
    except OSError:
        return 1
    print(f"unsupported transport: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    install_shutdown_handlers()
