#!/usr/bin/env python3
"""BusierBox reverse access convenience server.

This helper catches target-initiated reverse-access transports. It is not an
artifact sender or target-side command executor.

Transport model:
  ssh        — Dropbear/dbclient reverse SSH (BB_RSHELL_TRANSPORT=ssh)
  tls-shell  — wolfSSL or socat TLS shell (builtin+tls or socat+tls)
  plain-shell — plaintext shell (debug/insecure; socat+none or builtin+none)
"""

