#!/usr/bin/env python3
"""BusierBox reverse access convenience server.

This helper catches target-initiated reverse-access transports. It is not an
artifact sender or target-side command executor.

Transport model:
  ssh        — Dropbear/dbclient reverse SSH (BB_RSHELL_TRANSPORT=ssh)
  tls-shell  — wolfSSL or socat TLS shell (builtin+tls or socat+tls)
  plain-shell — plaintext shell (debug/insecure; socat+none or builtin+none)
"""

import argparse
import atexit
import base64
import hashlib
import json
import os
import select
import signal
import socket
import ssl
import subprocess
import sys
import termios
import threading
import time
import tty
import urllib.parse
from pathlib import Path

try:
    import paramiko
    HAVE_PARAMIKO = True
except ImportError:
    HAVE_PARAMIKO = False


SHUTDOWN = threading.Event()
OWNED_SOCKETS = []
OWNED_TRANSPORTS = []


DEFAULT_CONFIG = Path("local/server-config.json")
DEFAULT_OPERATOR_SESSION_DIR = Path("local/operator-session")
DEFAULT_STATE_FILE = DEFAULT_OPERATOR_SESSION_DIR / "server-state.json"
DEFAULT_STAGED_FILE = DEFAULT_OPERATOR_SESSION_DIR / "staged-files.json"
DEFAULTS = {
    "transport": "ssh",
    "encryption": "tls",
    "listen_host": "0.0.0.0",
    "ssh_listen_port": 22202,
    "shell_listen_port": 22203,
    "forward_host": "127.0.0.1",
    "forward_port": 2200,
    "authorized_dbclient_pubkey": "local/operator-session/id_dbclient.pub",
    "operator_host_key": "local/operator-session/operator_ssh_host_key",
    "tls_cert": "local/operator-session/shell-server.crt",
    "tls_key": "local/operator-session/shell-server.key",
    "tls_verify": "no",
    "session_root": "local/sessions",
    "file_service_enable": "no",
    "file_service_port": 22204,
    "file_service_tls": "yes",
    "operator_session_dir": str(DEFAULT_OPERATOR_SESSION_DIR),
    "server_state": str(DEFAULT_STATE_FILE),
    "staged_files": str(DEFAULT_STAGED_FILE),
}


def utc_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def atomic_write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def read_json_file(path, fallback):
    path = Path(path)
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return fallback


def append_event(cfg, service, event, level="info", session=None, remote=None, details=None):
    session_id = ""
    session_path = None
    if session:
        session_path = Path(str(session))
        session_id = session_path.name
    record = {
        "schema": 1,
        "ts": utc_now(),
        "service": service,
        "session": session_id,
        "event": event,
        "level": level,
        "remote": remote or "",
        "details": details or {},
    }
    operator_dir = Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR)))
    events_path = operator_dir / "events.jsonl"
    events_path.parent.mkdir(parents=True, exist_ok=True)
    with events_path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, sort_keys=True) + "\n")
    if session_path:
        events_path = session_path / "events.jsonl"
        try:
            with events_path.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps(record, sort_keys=True) + "\n")
        except OSError:
            pass


def event_tail(cfg, limit=12):
    path = Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "events.jsonl"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    out = []
    for line in lines[-limit:]:
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            pass
    return out


def staged_file_path(cfg):
    return Path(str(cfg.get("staged_files") or Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "staged-files.json"))


def state_file_path(cfg):
    return Path(str(cfg.get("server_state") or Path(str(cfg.get("operator_session_dir", DEFAULT_OPERATOR_SESSION_DIR))) / "server-state.json"))


def load_staged(cfg):
    data = read_json_file(staged_file_path(cfg), {"schema": 1, "staged": {}})
    if not isinstance(data, dict):
        data = {"schema": 1, "staged": {}}
    if not isinstance(data.get("staged"), dict):
        data["staged"] = {}
    data.setdefault("schema", 1)
    return data


def reject_traversal_request_name(name):
    text = urllib.parse.unquote(str(name or "")).strip()
    if not text:
        raise ValueError("staged request name must not be empty")
    parts = [part for part in text.replace("\\", "/").split("/") if part not in ("", ".")]
    if any(part == ".." for part in parts):
        raise ValueError("staged request name must not contain path traversal")
    return text


def file_sha256(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def stage_file(cfg, path, request_name):
    src = Path(path).expanduser()
    if not src.is_file():
        raise ValueError(f"staged file does not exist or is not a regular file: {src}")
    request = reject_traversal_request_name(request_name)
    stat = src.stat()
    data = load_staged(cfg)
    data["staged"][request] = {
        "request_name": request,
        "source_path": str(src),
        "size": stat.st_size,
        "sha256": file_sha256(src),
        "mtime": int(stat.st_mtime),
        "staged_at": utc_now(),
    }
    atomic_write_json(staged_file_path(cfg), data)
    append_event(cfg, "file-service", "staged_file_add", details=data["staged"][request])
    return data["staged"][request]


def stage_dir(cfg, path):
    root = Path(path).expanduser()
    if not root.is_dir():
        raise ValueError(f"staged directory does not exist: {root}")
    records = []
    for child in sorted(root.iterdir()):
        if child.is_file():
            records.append(stage_file(cfg, child, child.name))
    return records


def update_server_state(cfg, action, status="configured", extra=None):
    data = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}, "sessions": []})
    if not isinstance(data, dict):
        data = {"schema": 1, "services": {}, "sessions": []}
    data.setdefault("schema", 1)
    data.setdefault("services", {})
    data.setdefault("sessions", [])
    service = {
        "status": status,
        "listen_host": str(cfg.get("listen_host", "")),
        "ssh_port": int(cfg.get("ssh_listen_port", 0)),
        "shell_port": int(cfg.get("shell_listen_port", 0)),
        "file_service_port": int(cfg.get("file_service_port", 0)),
        "file_service_tls": str(cfg.get("file_service_tls", "yes")),
        "pid": os.getpid(),
        "updated_at": utc_now(),
    }
    if extra:
        service.update(extra)
    data["services"][action] = service
    atomic_write_json(state_file_path(cfg), data)
    return data


def mark_service_stopped(cfg, action):
    return update_server_state(cfg, action, "stopped", {})


def mark_service_error(cfg, action, reason, extra=None):
    data = {"error": str(reason)}
    if extra:
        data.update(extra)
    append_event(cfg, action, "service_error", "error", details=data)
    return update_server_state(cfg, action, "error", data)


def release_context():
    here = Path.cwd()
    release_json = here / "release.json"
    if release_json.is_file() and (here / "bin").is_dir() and (here / "scripts").is_dir():
        artifacts = []
        for root_name in ("bin", "dist"):
            root = here / root_name
            if root.is_dir():
                artifacts.extend(str(path) for path in sorted(root.iterdir()) if path.is_file())
        return {"release_dir": str(here), "release_json": str(release_json), "artifacts": artifacts}
    return {}


def render_fetch_command(request_name, cfg, host=None, force=False):
    candidates = local_ips()
    host = host or (candidates[0] if candidates else "OPERATOR_IP")
    cmd = [
        "busierbox",
        "fetch",
        request_name,
        "--host",
        host,
        "--port",
        str(cfg.get("file_service_port", 22204)),
    ]
    if not yes(cfg.get("file_service_tls", "yes")):
        cmd.append("--no-tls")
    if force:
        cmd.append("--force")
    return " ".join(shquote(part) for part in cmd)


def print_staged(cfg):
    staged = load_staged(cfg).get("staged", {})
    if not staged:
        print("No staged files.")
        return
    for name in sorted(staged):
        rec = staged[name]
        print(f"{name}\t{rec.get('source_path', '')}\t{rec.get('size', '')}\t{rec.get('sha256', '')}")
        print(f"  {render_fetch_command(name, cfg)}")


def unstage_file(cfg, request_name):
    request = reject_traversal_request_name(request_name)
    data = load_staged(cfg)
    existed = request in data.get("staged", {})
    data.get("staged", {}).pop(request, None)
    atomic_write_json(staged_file_path(cfg), data)
    append_event(cfg, "file-service", "staged_file_remove", details={"request_name": request, "existed": existed})
    return existed


def recent_sessions(cfg, limit=8):
    root = Path(str(cfg.get("session_root", "local/sessions")))
    if not root.is_dir():
        return []
    sessions = [p for p in root.iterdir() if p.is_dir()]
    sessions.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return sessions[:limit]


def recent_session_records(cfg, limit=8):
    out = []
    for path in recent_sessions(cfg, limit):
        meta = read_json_file(path / "session.json", {})
        if isinstance(meta, dict) and meta:
            meta.setdefault("service", path.name.split("-", 2)[-1] if "-" in path.name else "unknown")
            meta.setdefault("path", str(path))
            meta.setdefault("exit_reason", "")
            meta.setdefault("updated_at", utc_now_from_mtime(path.stat().st_mtime))
            out.append(meta)
            continue
        exit_reason = ""
        try:
            exit_reason = (path / "exit-reason").read_text(encoding="utf-8").strip()
        except OSError:
            pass
        service = path.name.split("-", 2)[-1] if "-" in path.name else "unknown"
        out.append({
            "service": service,
            "path": str(path),
            "exit_reason": exit_reason,
            "updated_at": utc_now_from_mtime(path.stat().st_mtime),
        })
    return out


def utc_now_from_mtime(mtime):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(mtime))


def recent_upload_metadata(cfg, limit=8):
    root = Path(str(cfg.get("session_root", "local/sessions")))
    if not root.is_dir():
        return []
    metas = sorted(root.glob("*/files/*.metadata.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    out = []
    for path in metas[:limit]:
        data = read_json_file(path, {})
        if isinstance(data, dict):
            data["_metadata_path"] = str(path)
            out.append(data)
    return out


def shquote(value):
    text = str(value)
    if all(ch.isalnum() or ch in "._-/:=" for ch in text):
        return text
    return "'" + text.replace("'", "'\\''") + "'"


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def pid_cmdline(pid):
    try:
        raw = Path(f"/proc/{int(pid)}/cmdline").read_bytes()
        return raw.replace(b"\0", b" ").decode("utf-8", errors="replace").strip()
    except (OSError, ValueError, TypeError):
        return ""


def pid_is_managed_server(pid):
    cmd = pid_cmdline(pid)
    return "busierbox-server" in cmd or (Path(sys.argv[0]).name == "busierbox-server" and str(os.getpid()) == str(pid))


def port_listener_pids(port):
    inodes = set()
    target = f"{int(port):04X}"
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        path = Path(table)
        if not path.is_file():
            continue
        try:
            lines = path.read_text(encoding="ascii", errors="ignore").splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            cols = line.split()
            if len(cols) > 9 and cols[1].rsplit(":", 1)[-1].upper() == target and cols[3] == "0A":
                inodes.add(cols[9])
    pids = []
    if not inodes:
        return pids
    proc = Path("/proc")
    for pid_dir in proc.iterdir() if proc.is_dir() else []:
        if not pid_dir.name.isdigit():
            continue
        fd_dir = pid_dir / "fd"
        try:
            for fd in fd_dir.iterdir():
                try:
                    target_link = os.readlink(fd)
                except OSError:
                    continue
                if target_link.startswith("socket:[") and target_link[8:-1] in inodes:
                    pids.append(int(pid_dir.name))
                    break
        except OSError:
            continue
    return sorted(set(pids))


def register_socket(sock):
    OWNED_SOCKETS.append(sock)
    return sock


def unregister_socket(sock):
    try:
        OWNED_SOCKETS.remove(sock)
    except ValueError:
        pass


def close_registered_resources():
    SHUTDOWN.set()
    for transport in list(OWNED_TRANSPORTS):
        try:
            transport.close()
        except Exception:
            pass
    for sock in list(OWNED_SOCKETS):
        try:
            sock.close()
        except OSError:
            pass


def _signal_shutdown(_signum, _frame):
    SHUTDOWN.set()
    close_registered_resources()


def install_shutdown_handlers():
    atexit.register(close_registered_resources)
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            signal.signal(sig, _signal_shutdown)
        except (OSError, ValueError):
            pass


def bind_listen_socket(cfg, service, port, backlog):
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((str(cfg["listen_host"]), int(port)))
        sock.listen(backlog)
        register_socket(sock)
        return sock
    except OSError as exc:
        try:
            sock.close()
        except OSError:
            pass
        owners = [{"pid": pid, "cmdline": pid_cmdline(pid)} for pid in port_listener_pids(port)]
        mark_service_error(cfg, service, exc, {"listen_host": str(cfg["listen_host"]), "port": int(port), "owners": owners})
        print(f"{service}: unable to bind {cfg['listen_host']}:{port}: {exc}", file=sys.stderr)
        if owners:
            print("possible listener owners:", file=sys.stderr)
            for owner in owners:
                print(f"  pid={owner['pid']} {owner['cmdline']}", file=sys.stderr)
        print("Run: scripts/busierbox-server --status", file=sys.stderr)
        print("Or stop managed listeners with: scripts/busierbox-server --stop", file=sys.stderr)
        raise


def load_config(path):
    cfg = dict(DEFAULTS)
    p = Path(path)
    if p.is_file():
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            for key, value in data.items():
                if value not in (None, ""):
                    cfg[key] = value
        except (OSError, json.JSONDecodeError) as exc:
            print(f"warning: unable to read {p}: {exc}", file=sys.stderr)
    # Accept legacy field names
    if "socat_listen_port" in cfg and "shell_listen_port" not in cfg:
        cfg["shell_listen_port"] = cfg["socat_listen_port"]
    if "tls_shell_listen_port" in cfg and "shell_listen_port" not in cfg:
        cfg["shell_listen_port"] = cfg["tls_shell_listen_port"]
    # Normalise legacy transport names
    t = cfg.get("transport", "ssh")
    if t == "socat-tls":
        cfg["transport"] = "socat"
        cfg.setdefault("encryption", "tls")
    elif t == "builtin-tls":
        cfg["transport"] = "builtin"
        cfg.setdefault("encryption", "tls")
    for key in ("ssh_listen_port", "shell_listen_port", "forward_port", "file_service_port"):
        cfg[key] = int(cfg[key])
    return cfg


def local_ips():
    ips = []
    seen = set()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("8.8.8.8", 80))
            ips.append(sock.getsockname()[0])
    except OSError:
        pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ips.append(info[4][0])
    except OSError:
        pass
    out = []
    for ip in ips:
        if ip and not ip.startswith("127.") and ip not in seen:
            seen.add(ip)
            out.append(ip)
    return out


def session_log_dir(cfg, label):
    root = Path(str(cfg["session_root"]))
    path = root / (time.strftime("%Y%m%d-%H%M%S") + "-" + label)
    path.mkdir(parents=True, exist_ok=True)
    return path


def session_id(log_dir):
    return Path(log_dir).name


def session_metadata_path(log_dir):
    return Path(log_dir) / "session.json"


def write_session_record(log_dir, record):
    path = session_metadata_path(log_dir)
    current = read_json_file(path, {})
    if not isinstance(current, dict):
        current = {}
    current.update(record)
    current.setdefault("schema", 1)
    current.setdefault("session_id", session_id(log_dir))
    current.setdefault("path", str(log_dir))
    current.setdefault("artifacts", [])
    current.setdefault("uploads", [])
    current.setdefault("fetches", [])
    atomic_write_json(path, current)
    return current


def upsert_state_session(cfg, log_dir, service, state, remote="", exit_reason=""):
    data = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}, "sessions": []})
    if not isinstance(data, dict):
        data = {"schema": 1, "services": {}, "sessions": []}
    data.setdefault("schema", 1)
    data.setdefault("services", {})
    sessions = data.get("sessions")
    if not isinstance(sessions, list):
        sessions = []
    sid = session_id(log_dir)
    summary = {
        "session_id": sid,
        "service": service,
        "path": str(log_dir),
        "state": state,
        "remote": remote or "",
        "exit_reason": exit_reason or "",
        "updated_at": utc_now(),
    }
    replaced = False
    for idx, item in enumerate(sessions):
        if isinstance(item, dict) and item.get("session_id") == sid:
            merged = dict(item)
            merged.update(summary)
            sessions[idx] = merged
            replaced = True
            break
    if not replaced:
        sessions.append(summary)
    data["sessions"] = sessions[-50:]
    atomic_write_json(state_file_path(cfg), data)


def start_session_record(cfg, service, log_dir, remote="", state="starting", details=None):
    upsert_state_session(cfg, log_dir, service, state, remote=remote)
    return write_session_record(log_dir, {
        "schema": 1,
        "session_id": session_id(log_dir),
        "service": service,
        "path": str(log_dir),
        "state": state,
        "started_at": utc_now(),
        "ended_at": "",
        "remote": remote or "",
        "exit_reason": "",
        "details": details or {},
        "artifacts": [],
        "uploads": [],
        "fetches": [],
    })


def update_session_record(log_dir, **fields):
    return write_session_record(log_dir, fields)


def append_session_list_item(log_dir, key, item):
    path = session_metadata_path(log_dir)
    current = read_json_file(path, {})
    if not isinstance(current, dict):
        current = {}
    values = current.get(key)
    if not isinstance(values, list):
        values = []
    values.append(item)
    current[key] = values
    write_session_record(log_dir, current)


def finish_session_record(cfg, service, log_dir, state="stopped", exit_reason=""):
    current = write_session_record(log_dir, {})
    upsert_state_session(cfg, log_dir, service, state, remote=current.get("remote", ""), exit_reason=exit_reason)
    return update_session_record(log_dir, state=state, ended_at=utc_now(), exit_reason=exit_reason)


def exit_reason_for(log_dir):
    path = Path(log_dir) / "exit-reason"
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def print_candidates(cfg, port):
    print(f"Listening on {cfg['listen_host']}:{port}")
    candidates = local_ips()
    if candidates:
        print("Candidate target connect-back hosts:")
        for ip in candidates:
            print(f"  {ip}:{port}")
    else:
        print("Candidate target connect-back hosts: unable to infer local IPs")


def load_public_key(path):
    if not HAVE_PARAMIKO:
        return None
    key_path = Path(path).expanduser()
    if not key_path.is_file():
        raise RuntimeError(f"authorized dbclient public key not found: {key_path}")
    text = key_path.read_text(encoding="utf-8").strip()
    parts = text.split()
    if len(parts) < 2:
        raise RuntimeError(f"malformed public key file: {key_path}")
    key_type, key_data = parts[0], parts[1]
    blob = base64.b64decode(key_data.encode("ascii"))
    for cls in (paramiko.RSAKey, paramiko.ECDSAKey, paramiko.Ed25519Key):
        try:
            return cls(data=blob)
        except Exception:
            continue
    raise RuntimeError(f"unsupported public key type '{key_type}': {key_path}")


def keys_equal(a, b):
    """Compare two Paramiko PKey objects by type and base64 content."""
    if a is None or b is None:
        return False
    return a.get_name() == b.get_name() and a.get_base64() == b.get_base64()


def ensure_host_key(path):
    if not HAVE_PARAMIKO:
        return None
    key_path = Path(path).expanduser()
    key_path.parent.mkdir(parents=True, exist_ok=True)
    if key_path.is_file():
        return paramiko.RSAKey(filename=str(key_path))
    key = paramiko.RSAKey.generate(3072)
    key.write_private_key_file(str(key_path))
    return key


class ReverseSSHServer(paramiko.ServerInterface if HAVE_PARAMIKO else object):
    def __init__(self, authorized_key, forward_host, forward_port):
        self.authorized_key = authorized_key
        self.forward_host = forward_host
        self.forward_port = forward_port
        self.forward_requests = []
        self.transport = None
        self.listener = None
        self._listener_sock = None

    def set_transport(self, transport):
        self.transport = transport

    def close(self):
        try:
            if self._listener_sock:
                self._listener_sock.close()
        except OSError:
            pass
        try:
            if self.transport:
                self.transport.close()
        except Exception:
            pass

    def check_auth_publickey(self, username, key):
        if keys_equal(self.authorized_key, key):
            print(f"SSH auth OK for {username}")
            return paramiko.AUTH_SUCCESSFUL
        print(f"SSH auth rejected for {username} (key mismatch)")
        return paramiko.AUTH_FAILED

    def get_allowed_auths(self, username):
        return "publickey"

    def check_port_forward_request(self, address, port):
        requested = int(port)
        if requested != int(self.forward_port):
            print(f"reject remote forward {address}:{port}; expected port {self.forward_port}")
            return False
        self.forward_requests.append((address, requested))
        self.start_forward_listener()
        print(f"Reverse SSH forward active: {address}:{requested}")
        print(f"Connect with: ssh -p {requested} root@127.0.0.1")
        return requested

    def check_channel_direct_tcpip_request(self, chanid, origin, destination):
        return paramiko.OPEN_SUCCEEDED

    def start_forward_listener(self):
        if self.listener is not None:
            return

        def run():
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind((str(self.forward_host), int(self.forward_port)))
            sock.listen(20)
            register_socket(sock)
            self._listener_sock = sock
            self.listener = sock
            try:
                while not SHUTDOWN.is_set() and self.transport and self.transport.is_active():
                    try:
                        sock.settimeout(2.0)
                        try:
                            local, origin = sock.accept()
                        except socket.timeout:
                            continue
                    except OSError:
                        break
                    try:
                        chan = self.transport.open_forwarded_tcpip_channel(
                            (origin[0], origin[1]),
                            (str(self.forward_host), int(self.forward_port)),
                        )
                    except Exception as exc:
                        print(f"forward channel failed: {exc}", file=sys.stderr)
                        local.close()
                        continue
                    threading.Thread(
                        target=pipe, args=(local, chan), daemon=True
                    ).start()
                    threading.Thread(
                        target=pipe, args=(chan, local), daemon=True
                    ).start()
            finally:
                unregister_socket(sock)
                try:
                    sock.close()
                except OSError:
                    pass

        threading.Thread(target=run, daemon=True).start()


def pipe(src, dst):
    """Relay data bidirectionally between two socket-like objects."""
    try:
        while True:
            try:
                data = src.recv(65536)
            except Exception:
                break
            if not data:
                break
            try:
                dst.sendall(data)
            except Exception:
                break
    finally:
        for obj in (src, dst):
            try:
                obj.shutdown(socket.SHUT_WR)
            except Exception:
                pass
            try:
                obj.close()
            except Exception:
                pass


class _KexGuess2CompatTransport(paramiko.Transport if HAVE_PARAMIKO else object):
    """Paramiko Transport that handles Dropbear's KEXGUESS2 optimistic packet.

    Dropbear advertises kexguess2@matt.ucc.asn.au and sets kex_follows=True in
    its KEXINIT, meaning it speculatively sends its preferred-algorithm kex init
    packet immediately.  If the agreed algorithm differs from the client's first
    choice, that speculative packet must be silently discarded per RFC 4253 §7.1.
    Paramiko ignores kex_follows=True entirely, so we intercept it here.
    """

    def _really_parse_kex_init(self, m, ignore_first_byte=False):
        parsed = super()._really_parse_kex_init(m, ignore_first_byte=ignore_first_byte)
        real_algos = [
            a for a in parsed.get("kex_algo_list", [])
            if not a.startswith("kexguess2") and not a.startswith("ext-info")
            and not a.startswith("kex-strict")
        ]
        self._kexguess2_follows = parsed.get("kex_follows", False)
        self._kexguess2_client_first = real_algos[0] if real_algos else None
        return parsed

    def _parse_kex_init(self, m):
        super()._parse_kex_init(m)
        if not (self._kexguess2_follows and self.server_mode):
            return
        agreed = getattr(self.kex_engine, "name", None)
        if agreed == self._kexguess2_client_first:
            return  # guess was correct; no discard needed
        _original = self.kex_engine.parse_next
        _skipped = [False]

        def _skip_once(ptype, msg):
            if not _skipped[0]:
                _skipped[0] = True
                self._expect_packet(ptype)
                return
            return _original(ptype, msg)

        self.kex_engine.parse_next = _skip_once


def serve_ssh(cfg, timeout):
    service = "ssh"
    if not HAVE_PARAMIKO:
        print("Paramiko is required for SSH reverse-forward mode.", file=sys.stderr)
        print("Install python3-paramiko or use --transport tls-shell.", file=sys.stderr)
        return 2
    host_key = ensure_host_key(cfg["operator_host_key"])
    authorized = load_public_key(cfg["authorized_dbclient_pubkey"])
    log_dir = session_log_dir(cfg, "ssh")
    start_session_record(cfg, service, log_dir, details={"transport": "ssh", "port": int(cfg["ssh_listen_port"])})
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")

    update_server_state(cfg, service, "starting", {"session_log": str(log_dir)})
    sock = None
    transport = None
    server = None
    bound = False
    try:
        sock = bind_listen_socket(cfg, service, cfg["ssh_listen_port"], 20)
        bound = True
        sock.settimeout(timeout)
        update_server_state(cfg, service, "listening", {"session_log": str(log_dir)})
        append_event(cfg, service, "service_start", session=str(log_dir), details={"port": int(cfg["ssh_listen_port"])})
        print_candidates(cfg, cfg["ssh_listen_port"])
        print(f"Authorized target key: {cfg['authorized_dbclient_pubkey']}")
        print("Waiting for dbclient reverse-forward connection...")
        try:
            client, addr = sock.accept()
        except socket.timeout:
            print("timeout waiting for reverse SSH connection", file=sys.stderr)
            return 1
        except OSError:
            if SHUTDOWN.is_set():
                return 0
            raise
        print(f"Connection from {addr[0]}:{addr[1]}")
        update_session_record(log_dir, state="active", remote=f"{addr[0]}:{addr[1]}")
        upsert_state_session(cfg, log_dir, service, "active", remote=f"{addr[0]}:{addr[1]}")
        append_event(cfg, service, "connection_open", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")

        transport = _KexGuess2CompatTransport(client)
        OWNED_TRANSPORTS.append(transport)
        transport.add_server_key(host_key)
        # Pin to the one kex algorithm both Paramiko and the Dropbear build support.
        # Dropbear's first preference is sntrup761 (PQ hybrid), which Paramiko
        # doesn't implement, so we must pin to avoid an impossible negotiation.
        _sec = transport.get_security_options()
        _sec.kex = ("diffie-hellman-group14-sha256",)
        server = ReverseSSHServer(authorized, cfg["forward_host"], cfg["forward_port"])
        server.set_transport(transport)
        transport.start_server(server=server)
        while not SHUTDOWN.is_set() and transport.is_active():
            time.sleep(0.5)
        append_event(cfg, service, "connection_close", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
    finally:
        if server:
            server.close()
        if transport:
            try:
                OWNED_TRANSPORTS.remove(transport)
            except ValueError:
                pass
            transport.close()
        if sock:
            unregister_socket(sock)
            try:
                sock.close()
            except OSError:
                pass
        if bound:
            mark_service_stopped(cfg, service)
            finish_session_record(cfg, service, log_dir)
            append_event(cfg, service, "service_stop", session=str(log_dir))
    return 0


def _set_interactive_tty_raw():
    if not sys.stdin.isatty():
        return None
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setraw(fd)
    return old


def _restore_interactive_tty(old):
    if old is None:
        return
    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
    except termios.error:
        pass


def _recv_ssl_nonblocking(conn):
    try:
        return conn.recv(65536), None
    except ssl.SSLWantReadError:
        return None, "want"
    except ssl.SSLWantWriteError:
        return None, "want"
    except ssl.SSLZeroReturnError:
        return b"", None
    except ssl.SSLError as exc:
        return None, exc
    except OSError as exc:
        return None, exc


def _send_ssl_nonblocking(conn, data):
    try:
        return conn.send(data), None
    except ssl.SSLWantReadError:
        return 0, "want"
    except ssl.SSLWantWriteError:
        return 0, "want"
    except ssl.SSLZeroReturnError:
        return 0, "remote_eof"
    except ssl.SSLError as exc:
        return 0, exc
    except OSError as exc:
        return 0, exc


def relay_stdio(conn, log_dir=None, use_stdin=True, script_bytes=None, expect=None,
                session_timeout=None):
    """Relay from conn to stdout/log and optionally from stdin to conn."""
    scripted = script_bytes is not None
    stdin_interactive = bool(use_stdin and not scripted and sys.stdin.isatty())
    reason = "active"
    log_fp = None
    tty_state = None
    outbound = bytearray(script_bytes or b"")
    captured = bytearray()
    deadline = time.monotonic() + session_timeout if session_timeout else None
    if log_dir is not None:
        log_fp = (Path(log_dir) / "session.log").open("ab", buffering=0)
    if stdin_interactive:
        print("Shell connected. Ctrl-C to close.")
        tty_state = _set_interactive_tty_raw()
    elif scripted:
        print("Shell connected. running scripted shell input.")
    else:
        print("Shell connected. stdin is non-interactive; receiving remote output only.")
    conn.setblocking(False)
    try:
        while True:
            if deadline is not None and time.monotonic() >= deadline:
                reason = "session_timeout"
                break
            readers = [conn]
            if stdin_interactive:
                readers.append(sys.stdin)
            writers = [conn] if outbound else []
            try:
                timeout = 1.0
                if deadline is not None:
                    timeout = max(0.0, min(timeout, deadline - time.monotonic()))
                readable, writable, _ = select.select(readers, writers, [], timeout)
            except KeyboardInterrupt:
                reason = "keyboard_interrupt"
                break
            except (OSError, ValueError):
                reason = "socket_error"
                break

            socket_read_ready = conn in readable
            while socket_read_ready or getattr(conn, "pending", lambda: 0)() > 0:
                socket_read_ready = False
                data, err = _recv_ssl_nonblocking(conn)
                if err == "want":
                    break
                if err is not None:
                    reason = "tls_error" if isinstance(err, ssl.SSLError) else "socket_error"
                    break
                if not data:
                    reason = "remote_eof"
                    break
                if log_fp:
                    log_fp.write(data)
                captured.extend(data)
                os.write(sys.stdout.fileno(), data)
                if getattr(conn, "pending", lambda: 0)() <= 0:
                    break
            if reason in ("tls_error", "socket_error", "remote_eof"):
                break

            if stdin_interactive and sys.stdin in readable:
                try:
                    data = os.read(sys.stdin.fileno(), 65536)
                except OSError:
                    reason = "stdin_eof"
                    break
                if not data:
                    reason = "stdin_eof"
                    break
                outbound.extend(data)

            if outbound and conn in writable:
                sent, err = _send_ssl_nonblocking(conn, bytes(outbound))
                if err == "want":
                    continue
                if err == "remote_eof":
                    reason = "remote_eof"
                    break
                if err is not None:
                    reason = "tls_error" if isinstance(err, ssl.SSLError) else "socket_error"
                    break
                if sent > 0:
                    del outbound[:sent]
    finally:
        _restore_interactive_tty(tty_state)
        if log_fp:
            log_fp.close()
        if log_dir is not None and expect is not None:
            expect_path = Path(log_dir) / "expectation"
            text = captured.decode("utf-8", errors="replace")
            if expect in text:
                expect_path.write_text("matched\n", encoding="utf-8")
            else:
                expect_path.write_text(f"missing: {expect}\n", encoding="utf-8")
                if reason in ("remote_eof", "stdin_eof", "active"):
                    reason = "expectation_missing"
        print(f"relay exit reason: {reason}", file=sys.stderr)
        if log_dir is not None:
            (Path(log_dir) / "exit-reason").write_text(reason + "\n", encoding="utf-8")
    return reason


def generate_tls_cert(cert: Path, key: Path) -> bool:
    """Generate a self-signed TLS cert/key pair. Returns True on success."""
    import subprocess
    cert.parent.mkdir(parents=True, exist_ok=True)
    log = cert.parent / "openssl-generate.log"
    cmd = [
        "openssl", "req", "-x509", "-newkey", "rsa:2048",
        "-keyout", str(key), "-out", str(cert),
        "-days", "3650", "-nodes", "-subj", "/CN=busierbox",
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        log.write_text(
            f"command: {' '.join(cmd)}\nreturncode: {result.returncode}\n"
            f"stdout:\n{result.stdout}\nstderr:\n{result.stderr}",
            encoding="utf-8",
        )
        if result.returncode == 0 and cert.is_file() and key.is_file():
            key.chmod(0o600)
            return True
    except FileNotFoundError:
        log.write_text("openssl not found in PATH\n", encoding="utf-8")
    return False


def yes(value):
    return str(value).lower() in {"1", "true", "yes", "on"}


def safe_upload_name(source_path):
    parsed = urllib.parse.urlparse(source_path or "")
    raw = urllib.parse.unquote(parsed.path or source_path or "upload.bin")
    name = Path(raw).name
    return name or "upload.bin"


def read_http_upload(conn, files_dir, addr):
    deadline = time.monotonic() + 30
    raw = bytearray()
    while b"\r\n\r\n" not in raw:
        if time.monotonic() >= deadline:
            raise RuntimeError("timeout reading upload headers")
        chunk = conn.recv(65536)
        if not chunk:
            raise RuntimeError("connection closed before upload headers")
        raw.extend(chunk)
    header_raw, body = bytes(raw).split(b"\r\n\r\n", 1)
    header_text = header_raw.decode("iso-8859-1", errors="replace")
    lines = header_text.split("\r\n")
    request = lines[0].split()
    if len(request) < 3:
        raise RuntimeError("malformed HTTP request")
    method, target, _version = request[:3]
    headers = {}
    for line in lines[1:]:
        if ":" in line:
            key, value = line.split(":", 1)
            headers[key.strip().lower()] = value.strip()
    if method not in {"PUT", "POST"}:
        return {
            "status": "rejected",
            "reason": "receive-only file service accepts only PUT or POST",
            "method": method,
            "source_path": target,
            "remote_addr": f"{addr[0]}:{addr[1]}",
        }, 405
    if "content-length" not in headers:
        return {
            "status": "rejected",
            "reason": "missing Content-Length",
            "method": method,
            "source_path": target,
            "remote_addr": f"{addr[0]}:{addr[1]}",
        }, 411
    try:
        expected = int(headers["content-length"])
    except ValueError:
        return {
            "status": "rejected",
            "reason": "invalid Content-Length",
            "method": method,
            "source_path": target,
            "remote_addr": f"{addr[0]}:{addr[1]}",
        }, 400
    source_path = headers.get("x-busierbox-source-path") or urllib.parse.urlparse(target).path
    out_name = safe_upload_name(source_path)
    out_path = files_dir / out_name
    if out_path.exists():
        stem = out_path.stem
        suffix = out_path.suffix
        out_path = files_dir / f"{stem}-{int(time.time())}{suffix}"
    h = hashlib.sha256()
    written = 0
    with out_path.open("wb") as fh:
        if body:
            piece = body[:expected]
            fh.write(piece)
            h.update(piece)
            written += len(piece)
        while written < expected:
            chunk = conn.recv(min(65536, expected - written))
            if not chunk:
                break
            fh.write(chunk)
            h.update(chunk)
            written += len(chunk)
    status = "ok" if written == expected else "truncated"
    metadata = {
        "schema": 1,
        "status": status,
        "method": method,
        "source_path": urllib.parse.unquote(source_path),
        "stored_path": str(out_path),
        "filename": out_path.name,
        "size": written,
        "expected_size": expected,
        "sha256": h.hexdigest(),
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "remote_addr": f"{addr[0]}:{addr[1]}",
        "uid": headers.get("x-busierbox-uid", ""),
        "gid": headers.get("x-busierbox-gid", ""),
        "mode": headers.get("x-busierbox-mode", ""),
        "transfer_status": status,
    }
    meta_path = files_dir / f"{out_path.name}.metadata.json"
    metadata["metadata_path"] = str(meta_path)
    meta_path.write_text(json.dumps(metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return metadata, 200 if status == "ok" else 400


def read_http_headers(conn):
    deadline = time.monotonic() + 30
    raw = bytearray()
    while b"\r\n\r\n" not in raw:
        if time.monotonic() >= deadline:
            raise RuntimeError("timeout reading HTTP headers")
        chunk = conn.recv(65536)
        if not chunk:
            raise RuntimeError("connection closed before HTTP headers")
        raw.extend(chunk)
    header_raw, body = bytes(raw).split(b"\r\n\r\n", 1)
    header_text = header_raw.decode("iso-8859-1", errors="replace")
    lines = header_text.split("\r\n")
    request = lines[0].split()
    if len(request) < 3:
        raise RuntimeError("malformed HTTP request")
    headers = {}
    for line in lines[1:]:
        if ":" in line:
            key, value = line.split(":", 1)
            headers[key.strip().lower()] = value.strip()
    return request[0], request[1], request[2], headers, body


def send_http_response(conn, status_code, body=b"", content_type="application/octet-stream", headers=None):
    reason = {
        200: "OK",
        400: "Bad Request",
        404: "Not Found",
        405: "Method Not Allowed",
        411: "Length Required",
        500: "Internal Server Error",
    }.get(status_code, "OK")
    header_lines = [
        f"HTTP/1.1 {status_code} {reason}",
        f"Content-Type: {content_type}",
        f"Content-Length: {len(body)}",
        "Connection: close",
    ]
    for key, value in (headers or {}).items():
        header_lines.append(f"{key}: {value}")
    conn.sendall(("\r\n".join(header_lines) + "\r\n\r\n").encode("ascii") + body)


def stream_fetch_response(conn, src, status_code=200, content_type="application/octet-stream", headers=None, head_only=False):
    src = Path(src)
    reason = {200: "OK"}.get(status_code, "OK")
    header_lines = [
        f"HTTP/1.1 {status_code} {reason}",
        f"Content-Type: {content_type}",
        f"Content-Length: {src.stat().st_size}",
        "Connection: close",
    ]
    for key, value in (headers or {}).items():
        header_lines.append(f"{key}: {value}")
    conn.sendall(("\r\n".join(header_lines) + "\r\n\r\n").encode("ascii"))
    if head_only:
        return
    with src.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            conn.sendall(chunk)


def handle_staged_fetch(cfg, conn, method, target, addr):
    if method not in {"GET", "HEAD"}:
        payload = {"status": "rejected", "reason": "staged fetch accepts only GET or HEAD"}
        send_http_response(conn, 405, json.dumps(payload).encode("utf-8") + b"\n", "application/json")
        return {"status": "rejected", "method": method, "remote_addr": f"{addr[0]}:{addr[1]}"}
    parsed = urllib.parse.urlparse(target)
    if parsed.path not in {"/fetch", "/fetch/"}:
        payload = {"status": "rejected", "reason": "unknown fetch endpoint"}
        send_http_response(conn, 404, json.dumps(payload).encode("utf-8") + b"\n", "application/json")
        return {"status": "rejected", "reason": "unknown endpoint", "remote_addr": f"{addr[0]}:{addr[1]}"}
    query = urllib.parse.parse_qs(parsed.query)
    name = query.get("name", [""])[0]
    try:
        name = reject_traversal_request_name(name)
    except ValueError as exc:
        payload = {"status": "rejected", "reason": str(exc)}
        send_http_response(conn, 400, json.dumps(payload).encode("utf-8") + b"\n", "application/json")
        return {"status": "rejected", "reason": str(exc), "remote_addr": f"{addr[0]}:{addr[1]}"}
    staged = load_staged(cfg).get("staged", {})
    rec = staged.get(name)
    if not rec:
        payload = {"status": "missing", "reason": "no staged file for request", "request_name": name}
        send_http_response(conn, 404, json.dumps(payload).encode("utf-8") + b"\n", "application/json")
        return {"status": "missing", "request_name": name, "remote_addr": f"{addr[0]}:{addr[1]}"}
    src = Path(rec.get("source_path", ""))
    if not src.is_file():
        payload = {"status": "missing", "reason": "staged source file is no longer present", "request_name": name}
        send_http_response(conn, 404, json.dumps(payload).encode("utf-8") + b"\n", "application/json")
        return {"status": "missing-source", "request_name": name, "remote_addr": f"{addr[0]}:{addr[1]}"}
    headers = {
        "X-BusierBox-Request-Name": urllib.parse.quote(name, safe="/._-"),
        "X-BusierBox-Sha256": rec.get("sha256", ""),
        "X-BusierBox-Source-Size": str(src.stat().st_size),
        "Content-Disposition": f"attachment; filename={urllib.parse.quote(Path(name).name or src.name)}",
    }
    stream_fetch_response(conn, src, 200, "application/octet-stream", headers=headers, head_only=(method == "HEAD"))
    return {
        "status": "served",
        "request_name": name,
        "source_path": str(src),
        "size": src.stat().st_size,
        "sha256": rec.get("sha256", ""),
        "timestamp": utc_now(),
        "remote_addr": f"{addr[0]}:{addr[1]}",
    }


def handle_file_service_http(cfg, conn, files_dir, addr):
    method, target, _version, headers, body = read_http_headers(conn)
    if method in {"GET", "HEAD"}:
        return handle_staged_fetch(cfg, conn, method, target, addr), 200
    if method not in {"PUT", "POST"}:
        metadata = {
            "status": "rejected",
            "reason": "file service accepts only target-initiated PUT/POST uploads or GET staged fetches",
            "method": method,
            "source_path": target,
            "remote_addr": f"{addr[0]}:{addr[1]}",
        }
        send_json_response(conn, 405, metadata)
        return metadata, 405
    # Reconstruct the header block for the existing upload reader to keep upload
    # behavior unchanged while sharing the initial parse path with GET.
    request_line = f"{method} {target} HTTP/1.1\r\n"
    header_lines = "".join(f"{key}: {value}\r\n" for key, value in headers.items())
    buffered = request_line.encode("iso-8859-1") + header_lines.encode("iso-8859-1") + b"\r\n" + body

    class BufferedConn:
        def __init__(self, base, first):
            self.base = base
            self.first = bytearray(first)

        def recv(self, n):
            if self.first:
                chunk = bytes(self.first[:n])
                del self.first[:n]
                return chunk
            return self.base.recv(n)

        def sendall(self, data):
            return self.base.sendall(data)

    metadata, status_code = read_http_upload(BufferedConn(conn, buffered), files_dir, addr)
    send_json_response(conn, status_code, metadata)
    return metadata, status_code


def send_json_response(conn, status_code, payload):
    reason = {
        200: "OK",
        400: "Bad Request",
        405: "Method Not Allowed",
        411: "Length Required",
        500: "Internal Server Error",
    }.get(status_code, "OK")
    body = json.dumps(payload, sort_keys=True).encode("utf-8") + b"\n"
    headers = (
        f"HTTP/1.1 {status_code} {reason}\r\n"
        "Content-Type: application/json\r\n"
        f"Content-Length: {len(body)}\r\n"
        "Connection: close\r\n"
        "\r\n"
    ).encode("ascii")
    conn.sendall(headers + body)


def serve_file_service(cfg, timeout, max_sessions=0):
    service = "file-service"
    port = int(cfg["file_service_port"])
    use_tls = yes(cfg.get("file_service_tls", "yes"))
    cert = Path(str(cfg["tls_cert"]))
    key = Path(str(cfg["tls_key"]))
    context = None
    if use_tls:
        if not cert.is_file() or not key.is_file():
            print(f"TLS cert/key not found, generating: {cert}", file=sys.stderr)
            if not generate_tls_cert(cert, key):
                print(f"TLS cert/key generation failed — see {cert.parent}/openssl-generate.log", file=sys.stderr)
                return 2
            print(f"Generated TLS cert/key: {cert}", file=sys.stderr)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        if hasattr(ssl, "TLSVersion"):
            context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain(str(cert), str(key))
    log_dir = session_log_dir(cfg, "file-service")
    start_session_record(cfg, service, log_dir, details={"port": port, "tls": use_tls})
    files_dir = log_dir / "files"
    files_dir.mkdir(parents=True, exist_ok=True)
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    print("Receive-only file service. Accepts target-initiated PUT/POST uploads.")
    print("Also serves operator-staged files only when the target explicitly requests them with busierbox fetch.")
    print("This service does not send artifacts, execute commands, or provide callback RPC.")
    update_server_state(cfg, service, "starting", {"session_log": str(log_dir), "staged_file": str(staged_file_path(cfg))})
    sessions = 0
    sock = None
    bound = False
    try:
        sock = bind_listen_socket(cfg, service, port, 20)
        bound = True
        sock.settimeout(timeout)
        update_server_state(cfg, service, "listening", {"session_log": str(log_dir), "staged_file": str(staged_file_path(cfg))})
        append_event(cfg, service, "service_start", session=str(log_dir), details={"port": port, "tls": use_tls})
        print_candidates(cfg, port)
        while not SHUTDOWN.is_set():
            print("Waiting for file upload/fetch...")
            try:
                raw, addr = sock.accept()
            except socket.timeout:
                print("timeout waiting for file upload/fetch", file=sys.stderr)
                return 1 if sessions == 0 else 0
            except OSError:
                if SHUTDOWN.is_set():
                    return 0
                raise
            try:
                with raw:
                    conn = context.wrap_socket(raw, server_side=True) if context else raw
                    with conn:
                        append_event(cfg, service, "connection_open", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
                        update_session_record(log_dir, state="active", remote=f"{addr[0]}:{addr[1]}")
                        upsert_state_session(cfg, log_dir, service, "active", remote=f"{addr[0]}:{addr[1]}")
                        metadata, status_code = handle_file_service_http(cfg, conn, files_dir, addr)
                        if metadata.get("status") == "served":
                            print(f"file-service fetch served: {metadata.get('request_name')} <- {metadata.get('source_path')}")
                            append_session_list_item(log_dir, "fetches", metadata)
                            append_event(cfg, service, "fetch_start", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}", details={"request_name": metadata.get("request_name", "")})
                            append_event(cfg, service, "fetch_complete", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}", details=metadata)
                        else:
                            print(f"file-service upload {metadata.get('status')}: {metadata.get('stored_path', metadata.get('reason', ''))}")
                            append_session_list_item(log_dir, "uploads", metadata)
                            append_event(cfg, service, "upload_start", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}", details={"filename": metadata.get("filename", ""), "expected_size": metadata.get("expected_size", "")})
                            append_event(cfg, service, "upload_complete", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}", details=metadata)
            except Exception as exc:
                try:
                    send_json_response(raw, 500, {"status": "error", "reason": str(exc)})
                except Exception:
                    pass
                print(f"file-service request failed: {exc}", file=sys.stderr)
                append_event(cfg, service, "request_error", "error", session=str(log_dir), details={"error": str(exc)})
            finally:
                append_event(cfg, service, "connection_close", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
                sessions += 1
            if max_sessions > 0 and sessions >= max_sessions:
                break
    finally:
        if sock:
            unregister_socket(sock)
            try:
                sock.close()
            except OSError:
                pass
        if bound:
            mark_service_stopped(cfg, service)
            finish_session_record(cfg, service, log_dir)
            append_event(cfg, service, "service_stop", session=str(log_dir))
    return 0


def serve_tls_shell(cfg, timeout, use_stdin=True, max_sessions=0, script_bytes=None,
                    expect=None, session_timeout=None):
    """TLS shell listener — accepts both builtin+tls and socat+tls targets."""
    service = "tls-shell"
    cert = Path(str(cfg["tls_cert"]))
    key = Path(str(cfg["tls_key"]))
    if not cert.is_file() or not key.is_file():
        print(f"TLS cert/key not found, generating: {cert}", file=sys.stderr)
        if not generate_tls_cert(cert, key):
            print(f"TLS cert/key generation failed — see {cert.parent}/openssl-generate.log", file=sys.stderr)
            print(f"Manual: openssl req -x509 -newkey rsa:2048 -keyout {key} -out {cert} -days 3650 -nodes -subj /CN=busierbox", file=sys.stderr)
            return 2
        print(f"Generated TLS cert/key: {cert}", file=sys.stderr)
    port = int(cfg["shell_listen_port"])
    log_dir = session_log_dir(cfg, "tls-shell")
    start_session_record(cfg, service, log_dir, details={"port": port, "tls": True})
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    if hasattr(ssl, "TLSVersion"):
        context.maximum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(str(cert), str(key))
    print(f"TLS shell listener — accepts builtin+tls and socat+tls transports")
    sessions = 0
    update_server_state(cfg, service, "starting", {"session_log": str(log_dir)})
    sock = None
    bound = False
    try:
        sock = bind_listen_socket(cfg, service, port, 1)
        bound = True
        sock.settimeout(timeout)
        update_server_state(cfg, service, "listening", {"session_log": str(log_dir)})
        append_event(cfg, service, "service_start", session=str(log_dir), details={"port": port})
        print_candidates(cfg, port)
        while not SHUTDOWN.is_set():
            print("Waiting for TLS shell connection...")
            try:
                raw, addr = sock.accept()
            except socket.timeout:
                print("timeout waiting for TLS shell connection", file=sys.stderr)
                (Path(log_dir) / "exit-reason").write_text("timeout\n", encoding="utf-8")
                print("relay exit reason: timeout", file=sys.stderr)
                return 1 if sessions == 0 else 0
            except OSError:
                if SHUTDOWN.is_set():
                    return 0
                raise
            print(f"TLS connection from {addr[0]}:{addr[1]}")
            update_session_record(log_dir, state="active", remote=f"{addr[0]}:{addr[1]}")
            upsert_state_session(cfg, log_dir, service, "active", remote=f"{addr[0]}:{addr[1]}")
            append_event(cfg, service, "shell_connected", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
            try:
                with context.wrap_socket(raw, server_side=True) as conn:
                    reason = relay_stdio(conn, log_dir, use_stdin=use_stdin,
                                          script_bytes=script_bytes, expect=expect,
                                          session_timeout=session_timeout)
                    if expect is not None and reason == "expectation_missing":
                        return 1
            except ssl.SSLError as exc:
                print(f"TLS session failed: {exc}", file=sys.stderr)
                (Path(log_dir) / "exit-reason").write_text("tls_error\n", encoding="utf-8")
                append_event(cfg, service, "shell_error", "error", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}", details={"error": str(exc)})
            finally:
                exit_reason = exit_reason_for(log_dir)
                sessions += 1
                update_session_record(log_dir, state="listening", exit_reason=exit_reason)
                upsert_state_session(cfg, log_dir, service, "listening", remote=f"{addr[0]}:{addr[1]}", exit_reason=exit_reason)
                append_event(cfg, service, "shell_disconnected", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
            if max_sessions > 0 and sessions >= max_sessions:
                break
            print("Shell session ended; listener remains open for target retry/reconnect.")
    finally:
        if sock:
            unregister_socket(sock)
            try:
                sock.close()
            except OSError:
                pass
        if bound:
            mark_service_stopped(cfg, service)
            finish_session_record(cfg, service, log_dir, exit_reason=exit_reason_for(log_dir))
            append_event(cfg, service, "service_stop", session=str(log_dir))
    return 0


def serve_plain_shell(cfg, timeout, use_stdin=True, max_sessions=0, script_bytes=None,
                      expect=None, session_timeout=None):
    """Plaintext shell listener — debug/insecure; socat+none or builtin+none."""
    service = "plain-shell"
    port = int(cfg["shell_listen_port"])
    print("WARNING: plain-shell is INSECURE and for debug use only!", file=sys.stderr)
    log_dir = session_log_dir(cfg, "plain-shell")
    start_session_record(cfg, service, log_dir, details={"port": port, "tls": False})
    (log_dir / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    sessions = 0
    update_server_state(cfg, service, "starting", {"session_log": str(log_dir)})
    sock = None
    bound = False
    try:
        sock = bind_listen_socket(cfg, service, port, 1)
        bound = True
        sock.settimeout(timeout)
        update_server_state(cfg, service, "listening", {"session_log": str(log_dir)})
        append_event(cfg, service, "service_start", session=str(log_dir), details={"port": port})
        print_candidates(cfg, port)
        while not SHUTDOWN.is_set():
            print("Waiting for plaintext shell connection (INSECURE)...")
            try:
                conn, addr = sock.accept()
            except socket.timeout:
                print("timeout waiting for plain shell connection", file=sys.stderr)
                (Path(log_dir) / "exit-reason").write_text("timeout\n", encoding="utf-8")
                print("relay exit reason: timeout", file=sys.stderr)
                return 1 if sessions == 0 else 0
            except OSError:
                if SHUTDOWN.is_set():
                    return 0
                raise
            print(f"Plain connection from {addr[0]}:{addr[1]}")
            update_session_record(log_dir, state="active", remote=f"{addr[0]}:{addr[1]}")
            upsert_state_session(cfg, log_dir, service, "active", remote=f"{addr[0]}:{addr[1]}")
            append_event(cfg, service, "shell_connected", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
            with conn:
                reason = relay_stdio(conn, log_dir, use_stdin=use_stdin,
                                      script_bytes=script_bytes, expect=expect,
                                      session_timeout=session_timeout)
                if expect is not None and reason == "expectation_missing":
                    return 1
            sessions += 1
            update_session_record(log_dir, state="listening", exit_reason=reason)
            upsert_state_session(cfg, log_dir, service, "listening", remote=f"{addr[0]}:{addr[1]}", exit_reason=reason)
            append_event(cfg, service, "shell_disconnected", session=str(log_dir), remote=f"{addr[0]}:{addr[1]}")
            if max_sessions > 0 and sessions >= max_sessions:
                break
            print("Shell session ended; listener remains open for target retry/reconnect.")
    finally:
        if sock:
            unregister_socket(sock)
            try:
                sock.close()
            except OSError:
                pass
        if bound:
            mark_service_stopped(cfg, service)
            finish_session_record(cfg, service, log_dir, exit_reason=exit_reason_for(log_dir))
            append_event(cfg, service, "service_stop", session=str(log_dir))
    return 0


def service_port(cfg, service):
    if service == "ssh":
        return int(cfg.get("ssh_listen_port", 22202))
    if service in {"tls-shell", "plain-shell"}:
        return int(cfg.get("shell_listen_port", 22203))
    if service == "file-service":
        return int(cfg.get("file_service_port", 22204))
    return 0


def port_listening(host, port):
    del host
    target = f"{int(port):04X}"
    try:
        for table in ("/proc/net/tcp", "/proc/net/tcp6"):
            path = Path(table)
            if not path.is_file():
                continue
            for line in path.read_text(encoding="ascii", errors="ignore").splitlines()[1:]:
                cols = line.split()
                if len(cols) > 3 and cols[1].rsplit(":", 1)[-1].upper() == target and cols[3] == "0A":
                    return True
    except (OSError, ValueError):
        return False
    return False


def raw_service_snapshot(cfg):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    services = {}
    for name in ("ssh", "tls-shell", "plain-shell", "file-service"):
        port = service_port(cfg, name)
        services[name] = {
            "port": port,
            "listening": port_listening(str(cfg.get("listen_host", "127.0.0.1")), port),
            "state": (state.get("services") or {}).get(name, {}),
        }
    return {"state": state, "staged": load_staged(cfg).get("staged", {}), "services": services}


def workbench_snapshot(cfg):
    doc = status_document(cfg)
    services = {}
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    for row in doc["services"]:
        services[row["name"]] = {
            "port": row["port"],
            "listening": row["actual"] == "listening",
            "state": (state.get("services") or {}).get(row["name"], {}),
            "status_row": row,
        }
    return {**doc, "state": state, "services": services}


def service_status_rows(cfg):
    snap = raw_service_snapshot(cfg)
    rows = []
    for name, info in snap["services"].items():
        rec = dict(info["state"])
        pid = rec.get("pid")
        actual = "listening" if info["listening"] else "stopped"
        stale = bool(rec.get("status") == "listening" and not info["listening"])
        rows.append({
            "name": name,
            "port": info["port"],
            "actual": actual,
            "configured": rec.get("status", "unknown"),
            "pid": pid or "",
            "pid_alive": pid_alive(pid) if pid else False,
            "stale": stale,
            "error": rec.get("error", ""),
            "owners": rec.get("owners", []),
            "session_log": rec.get("session_log", ""),
            "process_log": rec.get("process_log", ""),
        })
    return rows


def status_document(cfg):
    staged = load_staged(cfg).get("staged", {})
    ips = local_ips()
    return {
        "schema": 1,
        "state_file": str(state_file_path(cfg)),
        "staged_files": str(staged_file_path(cfg)),
        "session_root": str(cfg.get("session_root", "local/sessions")),
        "services": service_status_rows(cfg),
        "local_ips": ips,
        "selected_local_ip": (ips or ["OPERATOR_IP"])[0],
        "target_commands": generated_target_commands(cfg, staged),
        "staged": staged,
        "uploads": recent_upload_metadata(cfg),
        "sessions": recent_session_records(cfg),
        "events": event_tail(cfg),
        "release": release_context(),
    }


def generated_target_commands(cfg, staged=None):
    staged = staged if staged is not None else load_staged(cfg).get("staged", {})
    host = (local_ips() or ["OPERATOR_IP"])[0]
    commands = [
        f"./busierbox put /etc/config/network --host {host} --port {cfg.get('file_service_port', 22204)}",
        "./busierbox rshell start",
    ]
    for name in sorted(staged):
        commands.append(render_fetch_command(name, cfg, host=host))
    return commands


def print_status(cfg, json_output=False):
    doc = status_document(cfg)
    if json_output:
        print(json.dumps(doc, indent=2, sort_keys=True))
        return 0
    print("BusierBox server status")
    print(f"  state_file: {doc['state_file']}")
    print(f"  staged_files: {doc['staged_files']}")
    print(f"  session_root: {doc['session_root']}")
    print("")
    print("Services:")
    for row in doc["services"]:
        stale = " stale-state" if row["stale"] else ""
        pid = f" pid={row['pid']}" if row["pid"] else ""
        print(f"  {row['name']:12s} port={row['port']} configured={row['configured']} actual={row['actual']}{pid}{stale}")
        if row["error"]:
            print(f"    error: {row['error']}")
        if row["process_log"]:
            print(f"    process_log: {row['process_log']}")
        if row["session_log"]:
            print(f"    session_log: {row['session_log']}")
    if any(row["stale"] for row in doc["services"]):
        print("")
        print("Warnings:")
        print("  stale state detected; run scripts/busierbox-server --stop to clean managed records")
    print("")
    print("Recent sessions:")
    for session in doc["sessions"] or ["none"]:
        print(f"  {session}")
    print("")
    print("Recent uploads:")
    if doc["uploads"]:
        for meta in doc["uploads"]:
            print(f"  {meta.get('filename', '')} size={meta.get('size', '')} metadata={meta.get('_metadata_path', '')}")
    else:
        print("  none")
    return 0


def stop_managed_services(cfg):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    services = state.get("services") if isinstance(state, dict) else {}
    if not isinstance(services, dict):
        services = {}
    stopped = 0
    skipped = 0
    for name, rec in sorted(services.items()):
        pid = rec.get("pid") if isinstance(rec, dict) else None
        if isinstance(rec, dict) and rec.get("status") == "stopped":
            print(f"{name}: already stopped")
            skipped += 1
            continue
        if not pid:
            mark_service_stopped(cfg, name)
            print(f"{name}: no pid recorded; marked stopped")
            skipped += 1
            continue
        if not pid_alive(pid):
            mark_service_stopped(cfg, name)
            print(f"{name}: stale pid {pid}; marked stopped")
            skipped += 1
            continue
        if not pid_is_managed_server(pid):
            print(f"{name}: skipped pid {pid}; not clearly a managed busierbox-server process")
            skipped += 1
            continue
        try:
            os.kill(int(pid), signal.SIGTERM)
            stopped += 1
            mark_service_stopped(cfg, name)
            append_event(cfg, name, "service_stop", details={"pid": pid, "via": "server-stop"})
            print(f"{name}: stopped pid {pid}")
        except OSError as exc:
            mark_service_error(cfg, name, exc)
            print(f"{name}: failed to stop pid {pid}: {exc}", file=sys.stderr)
            skipped += 1
    if stopped == 0 and skipped == 0:
        print("No managed services recorded.")
    return 0


def print_workbench(cfg):
    snap = workbench_snapshot(cfg)
    print("BusierBox Operator Workbench")
    print(f"Current time: {utc_now()}")
    print(f"Selected local IP: {snap['selected_local_ip']}")
    print("")
    print("Local IP candidates:")
    candidates = snap["local_ips"]
    if candidates:
        for ip in candidates:
            print(f"  {ip}")
    else:
        print("  OPERATOR_IP")
    print("")
    print("Services:")
    for row in snap["services"].values():
        item = row["status_row"]
        pid = f" pid={item['pid']}" if item["pid"] else ""
        tls = " tls=yes" if item["name"] in {"tls-shell", "file-service"} and yes(str(snap["state"].get("services", {}).get(item["name"], {}).get("file_service_tls", "yes"))) else ""
        print(f"  {item['name']:12s} port={item['port']} desired={item['configured']} actual={item['actual']}{pid}{tls}")
        if item["error"]:
            print(f"    error: {item['error']}")
        if item["session_log"]:
            print(f"    log: {item['session_log']}")
    print("")
    print("Staged files:")
    if snap["staged"]:
        for name in sorted(snap["staged"]):
            rec = snap["staged"][name]
            sha = str(rec.get("sha256", ""))[:12]
            print(f"  {name} <- {rec.get('source_path', '')} size={rec.get('size', '')} sha256={sha} staged={rec.get('staged_at', '')}")
            print(f"    {render_fetch_command(name, cfg)}")
    else:
        print("  none")
    print("")
    print("Received uploads:")
    uploads = recent_upload_metadata(cfg)
    if uploads:
        for meta in uploads:
            sha = str(meta.get("sha256", ""))[:12]
            print(f"  {meta.get('filename', '')} size={meta.get('size', '')} sha256={sha} status={meta.get('transfer_status', meta.get('status', ''))}")
            print(f"    source: {meta.get('source_path', '')}")
            print(f"    remote: {meta.get('remote_addr', '')} at {meta.get('timestamp', '')}")
            print(f"    stored: {meta.get('stored_path', '')}")
            print(f"    metadata: {meta.get('_metadata_path', '')}")
    else:
        print("  none")
    print("")
    print("Recent sessions:")
    sessions = snap["sessions"]
    if sessions:
        for item in sessions:
            print(f"  {item.get('service', '')} {item.get('path', '')} exit={item.get('exit_reason', '')} updated={item.get('updated_at', '')}")
    else:
        print("  none")
    print("")
    print("Generated target commands:")
    for cmd in snap["target_commands"]:
        print(f"  {cmd}")
    print("")
    print("Event log:")
    if snap["events"]:
        for event in snap["events"][-8:]:
            print(f"  {event.get('ts', '')} {event.get('level', '')} {event.get('service', '')}:{event.get('event', '')}")
    else:
        print("  none")
    rel = release_context()
    if rel:
        print("")
        print("Release:")
        for key, value in sorted(rel.items()):
            if isinstance(value, list):
                print(f"  {key}:")
                for item in value:
                    print(f"    {item}")
            else:
                print(f"  {key}: {value}")


def start_service_process(cfg, service, argv_extra=None):
    cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--config",
        str(Path(str(cfg.get("_config_path", DEFAULT_CONFIG)))),
        "--transport",
        service,
    ]
    cmd.extend(["--state-file", str(state_file_path(cfg)), "--staged-file", str(staged_file_path(cfg))])
    if service == "file-service":
        cmd.extend(["--file-service-tls", str(cfg.get("file_service_tls", "yes"))])
    if argv_extra:
        cmd.extend(argv_extra)
    log_root = Path(str(cfg.get("session_root", "local/sessions")))
    log_root.mkdir(parents=True, exist_ok=True)
    log_path = log_root / f"operator-{service}-{int(time.time())}.log"
    with log_path.open("ab") as log:
        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    update_server_state(cfg, service, "starting", {"pid": proc.pid, "managed_by": os.getpid(), "process_log": str(log_path)})
    append_event(cfg, service, "service_start_requested", details={"pid": proc.pid, "process_log": str(log_path), "managed_by": os.getpid()})
    print(f"started {service}: pid={proc.pid} log={log_path}")


def stop_recorded_service(cfg, service):
    state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
    rec = (state.get("services") or {}).get(service, {})
    pid = rec.get("pid")
    if pid:
        try:
            os.kill(int(pid), 15)
            print(f"stopped {service}: pid={pid}")
        except OSError as exc:
            print(f"{service}: unable to stop pid {pid}: {exc}", file=sys.stderr)
    else:
        print(f"{service}: no recorded pid")
    mark_service_stopped(cfg, service)


def run_line_tui(cfg):
    while True:
        print("")
        print_workbench(cfg)
        print("")
        print("Actions:")
        print("  1 start ssh")
        print("  2 start tls-shell")
        print("  3 start plain-shell")
        print("  4 start file-service")
        print("  5 stop service")
        print("  6 stage file")
        print("  7 list staged")
        print("  8 unstage file")
        print("  c show generated commands")
        print("  r refresh")
        print("  ? help")
        print("  q quit")
        choice = input("> ").strip()
        if choice == "q":
            mark_service_stopped(cfg, "workbench")
            return 0
        if choice in {"1", "2", "3", "4"}:
            service = {"1": "ssh", "2": "tls-shell", "3": "plain-shell", "4": "file-service"}[choice]
            start_service_process(cfg, service)
        elif choice == "5":
            stop_recorded_service(cfg, input("service> ").strip())
        elif choice == "6":
            path = input("local file> ").strip()
            name = input("target request name> ").strip()
            rec = stage_file(cfg, path, name)
            print(f"staged {rec['request_name']}")
            print(render_fetch_command(rec["request_name"], cfg))
        elif choice == "7":
            print_staged(cfg)
        elif choice == "8" or choice == "d":
            name = input("target request name> ").strip()
            if name:
                print("unstaged" if unstage_file(cfg, name) else "not staged")
        elif choice == "c":
            for cmd in generated_target_commands(cfg):
                print(cmd)
        elif choice == "?":
            print("Keys: 1-4 start services, 5 stop, 6 stage, 8/d unstage, c commands, r refresh, q quit.")


def run_curses_tui(cfg):
    import curses

    def safe_add(stdscr, row, col, text, attr=0):
        height, width = stdscr.getmaxyx()
        if row < 0 or row >= height or col >= width:
            return
        try:
            stdscr.addstr(row, col, str(text)[:max(0, width - col - 1)], attr)
        except curses.error:
            pass

    def draw_list(stdscr, title, lines, row, col, height, width, selected=False):
        attr = curses.A_REVERSE if selected else curses.A_BOLD
        safe_add(stdscr, row, col, title[:width - 1], attr)
        for idx, line in enumerate(lines[:max(0, height - 1)], 1):
            safe_add(stdscr, row + idx, col, line[:width - 1])

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        pane = 0
        selected = 0
        while True:
            snap = workbench_snapshot(cfg)
            services = [row["status_row"] for row in snap["services"].values()]
            staged_names = sorted(snap["staged"])
            upload_lines = [
                f"{m.get('filename', '')} {m.get('size', '')}B {str(m.get('sha256', ''))[:8]} {m.get('remote_addr', '')}"
                for m in snap["uploads"]
            ] or ["none"]
            session_lines = [
                f"{s.get('service', '')} {Path(s.get('path', '')).name} exit={s.get('exit_reason', '') or '-'}"
                for s in snap["sessions"]
            ] or ["none"]
            event_lines = [
                f"{e.get('ts', '')} {e.get('service', '')}:{e.get('event', '')}"
                for e in snap["events"][-8:]
            ] or ["none"]
            command_lines = snap["target_commands"] or ["none"]
            service_lines = []
            for idx, row in enumerate(services):
                prefix = ">" if pane == 0 and idx == selected else " "
                service_lines.append(f"{prefix} {row['name']:12s} {row['actual']}/{row['configured']} port={row['port']} pid={row['pid'] or '-'}")
            staged_lines = []
            for idx, name in enumerate(staged_names):
                rec = snap["staged"][name]
                prefix = ">" if pane == 1 and idx == selected else " "
                staged_lines.append(f"{prefix} {name} {rec.get('size', '')}B {str(rec.get('sha256', ''))[:8]}")
            staged_lines = staged_lines or [" none"]
            detail_lines = []
            if pane == 0 and services:
                row = services[min(selected, len(services) - 1)]
                detail_lines = [
                    f"service: {row['name']}",
                    f"port: {row['port']}",
                    f"desired: {row['configured']}",
                    f"actual: {row['actual']}",
                    f"pid: {row['pid'] or '-'} alive={row['pid_alive']}",
                    f"session_log: {row['session_log'] or '-'}",
                    f"process_log: {row['process_log'] or '-'}",
                    f"error: {row['error'] or '-'}",
                ]
            elif pane == 1 and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)]
                rec = snap["staged"][name]
                detail_lines = [
                    f"request: {name}",
                    f"source: {rec.get('source_path', '')}",
                    f"size: {rec.get('size', '')}",
                    f"sha256: {rec.get('sha256', '')}",
                    f"staged: {rec.get('staged_at', '')}",
                    render_fetch_command(name, cfg, host=snap["selected_local_ip"]),
                ]
            else:
                detail_lines = [
                    f"state: {state_file_path(cfg)}",
                    f"staged: {staged_file_path(cfg)}",
                    f"cert: {cfg.get('tls_cert', '')}",
                    f"key: {cfg.get('tls_key', '')}",
                ]
            stdscr.erase()
            height, width = stdscr.getmaxyx()
            active = sum(1 for row in services if row["actual"] == "listening")
            safe_add(stdscr, 0, 0, f"BusierBox Operator Workbench | active={active} | ip={snap['selected_local_ip']} | {utc_now()} | tab panes j/k move enter start/stop s stage d unstage c commands ? help q quit", curses.A_REVERSE)
            left_w = max(34, width // 3)
            right_w = max(20, width - left_w - 1)
            lower_y = max(12, height // 2)
            draw_list(stdscr, "Services", service_lines, 2, 0, lower_y - 2, left_w, pane == 0)
            draw_list(stdscr, "Details", detail_lines, 2, left_w + 1, lower_y - 2, right_w, False)
            third = max(20, width // 3)
            draw_list(stdscr, "Staged Files", staged_lines, lower_y, 0, 7, third, pane == 1)
            draw_list(stdscr, "Recent Uploads", upload_lines, lower_y, third + 1, 7, third, pane == 2)
            draw_list(stdscr, "Recent Sessions", session_lines, lower_y, (third + 1) * 2, 7, width - ((third + 1) * 2), pane == 3)
            events_y = min(height - 8, lower_y + 8)
            draw_list(stdscr, "Event Log", event_lines, events_y, 0, height - events_y - 1, width // 2, pane == 4)
            draw_list(stdscr, "Generated Target Commands", command_lines, events_y, width // 2 + 1, height - events_y - 1, width - width // 2 - 1, pane == 5)
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return 0
            if key in (curses.KEY_DOWN, ord("j")):
                selected += 1
            elif key in (curses.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif key == ord("\t"):
                pane = (pane + 1) % 6
                selected = 0
            elif key == curses.KEY_BTAB:
                pane = (pane - 1) % 6
                selected = 0
            elif key in (ord("1"), ord("2"), ord("3"), ord("4")):
                service = {ord("1"): "ssh", ord("2"): "tls-shell", ord("3"): "plain-shell", ord("4"): "file-service"}[key]
                start_service_process(cfg, service)
            elif key in (10, 13) and pane == 0 and services:
                service = services[min(selected, len(services) - 1)]["name"]
                if services[min(selected, len(services) - 1)]["actual"] == "listening":
                    stop_recorded_service(cfg, service)
                else:
                    start_service_process(cfg, service)
            elif key == ord("5"):
                curses.echo()
                safe_add(stdscr, height - 2, 0, "service> ")
                service = stdscr.getstr(height - 2, 9, 32).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if service:
                    stop_recorded_service(cfg, service)
            elif key in (ord("6"), ord("s")):
                curses.echo()
                safe_add(stdscr, height - 3, 0, "local file> ")
                path = stdscr.getstr(height - 3, 12, 240).decode("utf-8", errors="replace").strip()
                safe_add(stdscr, height - 2, 0, "target request name> ")
                name = stdscr.getstr(height - 2, 21, 240).decode("utf-8", errors="replace").strip()
                curses.noecho()
                if path and name:
                    try:
                        stage_file(cfg, path, name)
                    except ValueError:
                        pass
            elif key in (ord("d"), ord("D")) and staged_names:
                name = staged_names[min(selected, len(staged_names) - 1)] if pane == 1 else ""
                if name:
                    unstage_file(cfg, name)
            elif key in (ord("?"),):
                safe_add(stdscr, height - 2, 0, "Help: arrows/jk move, Tab panes, Enter start/stop, s stage, d unstage, c commands, r refresh, q quit")
                stdscr.getch()
            elif key in (ord("c"), ord("C")):
                safe_add(stdscr, height - 2, 0, "Commands are shown in the lower-right pane. Press any key.")
                stdscr.getch()
            max_items = len(services) if pane == 0 else len(staged_names) if pane == 1 else 1
            selected = min(max(0, selected), max(0, max_items - 1))
        return 0

    return curses.wrapper(draw)


def run_tui(cfg):
    update_server_state(cfg, "workbench", "open", {"state_file": str(state_file_path(cfg))})
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print_workbench(cfg)
        return 0
    try:
        return run_curses_tui(cfg)
    except Exception as exc:
        print(f"curses workbench unavailable, using line menu: {exc}", file=sys.stderr)
        return run_line_tui(cfg)
    finally:
        state = read_json_file(state_file_path(cfg), {"schema": 1, "services": {}})
        for name, rec in (state.get("services") or {}).items():
            if isinstance(rec, dict) and str(rec.get("managed_by", "")) == str(os.getpid()):
                stop_recorded_service(cfg, name)
        mark_service_stopped(cfg, "workbench")
        append_event(cfg, "workbench", "shutdown")


def _resolve_transport(cfg, args_transport):
    """Map --transport flag and config fields to a canonical action."""
    if args_transport:
        t = args_transport
        # Aliases
        if t == "ssh-reverse":
            t = "ssh"
        elif t == "socat-tls":
            t = "tls-shell"
        elif t == "builtin-tls":
            t = "tls-shell"
        return t

    # Derive from config transport + encryption
    if yes(cfg.get("file_service_enable", "no")):
        return "file-service"
    t = cfg.get("transport", "ssh")
    enc = cfg.get("encryption", "tls")
    if t == "ssh":
        return "ssh"
    if enc == "tls":
        return "tls-shell"
    return "plain-shell"


def main(argv=None):
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        description="Catch BusierBox reverse-access transports from a target.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Transport modes:
  ssh         — Paramiko reverse-forward listener for Dropbear/dbclient (BB_RSHELL_TRANSPORT=ssh)
  tls-shell   — TLS shell listener accepting builtin+tls AND socat+tls transports
  plain-shell — Plaintext shell listener (debug/insecure; socat+none or builtin+none)
  file-service — Receive-only TLS upload service for target-initiated files/evidence

File staging:
  --transport file-service --serve-file ./tool --as /tmp/tool
  --transport file-service --serve-dir local/operator-files
  --transport file-service --list-staged

Aliases accepted: ssh-reverse=ssh, socat-tls=tls-shell, builtin-tls=tls-shell
""",
    )
    parser.add_argument("--config", default=str(DEFAULT_CONFIG),
                        help="JSON config written by menuconfig")
    parser.add_argument("--transport",
                        choices=("ssh", "ssh-reverse", "tls-shell", "socat-tls",
                                 "builtin-tls", "plain-shell", "file-service"),
                        help="transport to listen for (overrides config)")
    parser.add_argument("--file-service", action="store_true",
                        help="receive target-initiated file uploads and store them under local/sessions")
    parser.add_argument("--tui", action="store_true",
                        help="open the operator-side service/file staging workbench")
    parser.add_argument("--no-tui", action="store_true",
                        help="preserve direct listener CLI behavior when running interactively with no args")
    parser.add_argument("--status", action="store_true",
                        help="show managed service state, actual listeners, sessions, uploads, and stale warnings")
    parser.add_argument("--json-status", action="store_true",
                        help="print --status information as JSON")
    parser.add_argument("--stop", action="store_true",
                        help="stop known managed listeners from server-state PID records")
    parser.add_argument("--serve-file",
                        help="stage a local file for explicit target fetch")
    parser.add_argument("--as", dest="serve_as",
                        help="target request name for --serve-file, for example /tmp/myfile")
    parser.add_argument("--serve-dir",
                        help="stage direct child files from a local directory for explicit target fetch")
    parser.add_argument("--list-staged", action="store_true",
                        help="list operator-staged target fetch files and commands")
    parser.add_argument("--unstage",
                        help="remove a staged target fetch request name")
    parser.add_argument("--state-file",
                        help="operator workbench state JSON path")
    parser.add_argument("--staged-file",
                        help="operator staged-files JSON path")
    parser.add_argument("--listen-host", help="listener bind address")
    parser.add_argument("--ssh-port", type=int, help="SSH reverse-forward listener port")
    parser.add_argument("--shell-port", type=int,
                        help="TLS/plain shell listener port (socat-port alias also accepted)")
    parser.add_argument("--socat-port", type=int,
                        help=argparse.SUPPRESS)  # compat alias for --shell-port
    parser.add_argument("--forward-port", type=int,
                        help="remote forward port exposed on the operator workstation")
    parser.add_argument("--file-port", type=int,
                        help="receive-only file service listener port")
    parser.add_argument("--file-service-tls", choices=("yes", "no"),
                        help="use TLS for file-service uploads (default yes)")
    parser.add_argument("--timeout", type=float, default=0,
                        help="seconds to wait for a connection; 0 waits forever")
    parser.add_argument("--no-stdin", action="store_true",
                        help="do not relay local stdin to the remote shell")
    parser.add_argument("--log-only", action="store_true",
                        help="alias for --no-stdin; receive stdout/session log only")
    parser.add_argument("--one-shot", action="store_true",
                        help="exit after one shell session instead of waiting for reconnects")
    parser.add_argument("--script",
                        help="file containing shell input to send after tls/plain shell connect")
    parser.add_argument("--expect",
                        help="literal text that must appear in captured shell output")
    parser.add_argument("--session-timeout", type=float, default=30,
                        help="seconds to allow a scripted shell session; 0 disables the limit")
    args = parser.parse_args(raw_argv)

    cfg = load_config(args.config)
    cfg["_config_path"] = args.config
    if args.listen_host:
        cfg["listen_host"] = args.listen_host
    if args.ssh_port:
        cfg["ssh_listen_port"] = args.ssh_port
    shell_port = args.shell_port or args.socat_port
    if shell_port:
        cfg["shell_listen_port"] = shell_port
    if args.forward_port:
        cfg["forward_port"] = args.forward_port
    if args.file_port:
        cfg["file_service_port"] = args.file_port
    if args.file_service_tls:
        cfg["file_service_tls"] = args.file_service_tls
    if args.state_file:
        cfg["server_state"] = args.state_file
    if args.staged_file:
        cfg["staged_files"] = args.staged_file

    if args.status or args.json_status:
        return print_status(cfg, json_output=args.json_status)
    if args.stop:
        return stop_managed_services(cfg)

    timeout = None if args.timeout == 0 else args.timeout
    action = "file-service" if args.file_service else _resolve_transport(cfg, args.transport)
    script_bytes = None
    if args.script:
        script_bytes = Path(args.script).read_bytes()
        if script_bytes and not script_bytes.endswith(b"\n"):
            script_bytes += b"\n"
    session_timeout = None if args.session_timeout == 0 else args.session_timeout

    try:
        if args.serve_file:
            request_name = args.serve_as or Path(args.serve_file).name
            rec = stage_file(cfg, args.serve_file, request_name)
            print(f"staged {rec['request_name']} <- {rec['source_path']}")
            print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.serve_dir:
            records = stage_dir(cfg, args.serve_dir)
            for rec in records:
                print(f"staged {rec['request_name']} <- {rec['source_path']}")
                print(render_fetch_command(rec["request_name"], cfg))
            action = "file-service"
        if args.unstage:
            existed = unstage_file(cfg, args.unstage)
            print(f"unstaged {args.unstage}" if existed else f"not staged {args.unstage}")
        if args.list_staged:
            print_staged(cfg)
            return 0
    except ValueError as exc:
        print(f"busierbox-server: {exc}", file=sys.stderr)
        return 2

    if args.tui or (not raw_argv and not args.no_tui and sys.stdin.isatty() and sys.stdout.isatty()):
        return run_tui(cfg)

    try:
        if action == "ssh":
            return serve_ssh(cfg, timeout)
        if action == "tls-shell":
            return serve_tls_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                   max_sessions=1 if args.one_shot or args.script else 0,
                                   script_bytes=script_bytes, expect=args.expect,
                                   session_timeout=session_timeout)
        if action == "plain-shell":
            return serve_plain_shell(cfg, timeout, use_stdin=not (args.no_stdin or args.log_only),
                                     max_sessions=1 if args.one_shot or args.script else 0,
                                     script_bytes=script_bytes, expect=args.expect,
                                     session_timeout=session_timeout)
        if action == "file-service":
            return serve_file_service(cfg, timeout, max_sessions=1 if args.one_shot else 0)
    except KeyboardInterrupt:
        print("busierbox-server: interrupted, shutting down", file=sys.stderr)
        append_event(cfg, action, "shutdown", details={"reason": "keyboard_interrupt"})
        mark_service_stopped(cfg, action)
        return 130
    except OSError:
        return 1
    print(f"unsupported transport: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    install_shutdown_handlers()
    raise SystemExit(main())
