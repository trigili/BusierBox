#!/usr/bin/env python3
import argparse
import json
import pathlib
import subprocess
import time


def read_list(path):
    path = pathlib.Path(path)
    if not path.exists():
        return []
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        item = line.strip()
        if item and item not in out:
            out.append(item)
    return sorted(out)


def read_tool_provider_status(tool, target, arch, libc):
    script = pathlib.Path(__file__).resolve().parent / "tools" / "dropin-tool-status"
    if not script.exists():
        return {"status": "unavailable", "warning": f"missing helper {script}"}
    try:
        out = subprocess.check_output(
            [
                str(script),
                "--tool",
                tool,
                "--target",
                target,
                "--arch",
                arch,
                "--libc",
                libc,
                "--json",
            ],
            text=True,
            stderr=subprocess.PIPE,
        )
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        return {"status": "unavailable", "warning": str(exc)}


parser = argparse.ArgumentParser()
parser.add_argument("--target", required=True)
parser.add_argument("--arch", required=True)
parser.add_argument("--libc", required=True)
parser.add_argument("--kernel-floor", required=True)
parser.add_argument("--busybox-version", required=True)
parser.add_argument("--static-status", required=True)
parser.add_argument("--payload-sha256", required=True)
parser.add_argument("--requested-tools", default="")
parser.add_argument("--payload-dir", default="runtime/payload")
parser.add_argument("--overlay-enable", default="no")
parser.add_argument("--overlay-root", default="")
parser.add_argument("--gdbserver-provider", default="auto")
args = parser.parse_args()

payload = pathlib.Path(args.payload_dir)
requested = sorted([x for x in args.requested_tools.split() if x])
staged = read_list(payload / "staged-tools.txt")
built = read_list(payload / "built-tools.txt")
missing = sorted([x for x in requested if x not in built])
applets = read_list(payload / "busybox-applets.txt")
libs = []
libdir = payload / "lib"
if libdir.exists():
    libs = sorted(p.name for p in libdir.iterdir() if p.is_file() or p.is_symlink())

exclusion_notes = {}
notes_file = payload / "share" / "busierbox" / "exclusion-reasons.txt"
if notes_file.exists():
    for line in notes_file.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line:
            continue
        idx = line.find("=")
        if idx > 0:
            exclusion_notes[line[:idx]] = line[idx + 1:]

missing_reasons = {}
for tool in missing:
    missing_reasons[tool] = exclusion_notes.get(tool, "requested tool was not staged by any provider")

overlay_tools = read_list(payload / "overlay-tools.txt")
user_provided = read_list(payload / "user-provided-tools.txt")
overlay_files = read_list(payload / "overlay-files.txt")
overlay_paths = read_list(payload / "overlay-paths.txt")
overlay_warnings = []
warn_file = payload / "share" / "busierbox" / "overlay-warnings.txt"
if warn_file.exists():
    overlay_warnings = [l.strip() for l in warn_file.read_text(encoding="utf-8").splitlines() if l.strip()]

tool_provider_status = {}
if "gdbserver" in requested or "gdbserver" in staged or args.gdbserver_provider != "auto":
    tool_provider_status["gdbserver"] = read_tool_provider_status(
        "gdbserver",
        args.target,
        args.arch,
        args.libc,
    )

symlink_count = 0
count_file = payload / "share" / "busierbox" / "applet-symlink-count.txt"
if count_file.exists():
    try:
        symlink_count = int(count_file.read_text(encoding="utf-8").strip())
    except ValueError:
        pass
symlink_skips = read_list(payload / "share" / "busierbox" / "applet-symlink-skips.txt")

manifest = {
    "target": args.target,
    "arch": args.arch,
    "libc": args.libc,
    "kernel_floor": args.kernel_floor,
    "build_timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "busybox_version": args.busybox_version,
    "static_status": args.static_status,
    "busybox_applets": applets,
    "requested_payload_tools": requested,
    "built_payload_tools": built,
    "staged_payload_tools": staged,
    "missing_payload_tools": missing,
    "missing_payload_tool_reasons": missing_reasons,
    "exclusion_notes": exclusion_notes,
    "overlay_enabled": args.overlay_enable == "yes",
    "overlay_root": args.overlay_root,
    "overlay_applied_paths": overlay_paths,
    "overlay_files": overlay_files,
    "overlay_tools": overlay_tools,
    "user_provided_tools": user_provided,
    "overlay_warnings": overlay_warnings,
    "gdbserver_provider": args.gdbserver_provider,
    "tool_provider_status": tool_provider_status,
    "applet_symlink_count": symlink_count,
    "applet_symlink_skips": symlink_skips,
    "included_shared_libs": libs,
    "payload_sha256": args.payload_sha256,
}

(payload / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")

diag = payload / "share" / "busierbox"
diag.mkdir(parents=True, exist_ok=True)
if missing:
    (diag / "missing-tools.txt").write_text("\n".join(missing) + "\n", encoding="utf-8")
else:
    missing_file = diag / "missing-tools.txt"
    if missing_file.exists():
        missing_file.unlink()
