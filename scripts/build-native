#!/bin/sh
set -eu

: "${CC:=cc}"
: "${CFLAGS:=-Os -Wall -Wextra -std=c99}"
: "${CPPFLAGS:=}"
: "${LDFLAGS:=}"
: "${OUT:=dist/busierbox.core}"
: "${ARTIFACT_TIER:=core}"
: "${ADVERTISE_PAYLOAD_TOOLS:=0}"
: "${BB_ENABLE_SURVEY:=1}"
: "${BB_ENABLE_DOCTOR:=1}"
: "${BB_ENABLE_CONFIG_INFO:=1}"
: "${BB_ENABLE_EXTRACT:=1}"
: "${BB_ENABLE_FETCH_FULL:=1}"
: "${BB_STAGER_CALLBACK_ENABLE:=no}"
: "${BB_STAGER_CALLBACK_HOST:=}"
: "${BB_STAGER_CALLBACK_PORT:=}"
: "${BB_STAGER_CALLBACK_SHELL:=sh}"
: "${BB_FULL_CALLBACK_ENABLE:=no}"
: "${BB_FULL_CALLBACK_HOST:=}"
: "${BB_FULL_CALLBACK_PORT:=4444}"
: "${BB_FULL_CALLBACK_TOKEN:=}"
: "${BB_FULL_CALLBACK_TIMEOUT:=10}"
: "${BB_FULL_CALLBACK_RETRY_COUNT:=3}"
: "${BB_FULL_CALLBACK_RETRY_DELAY:=2}"
: "${BB_FULL_CALLBACK_AUTO_EXEC:=doctor}"
: "${BB_ENABLE_CALLBACK:=1}"

src="src/busierbox.c src/applet_payload.c src/applet_survey.c src/applet_envfix.c src/applet_callback.c src/sha256.c"
miniz_src="third_party/miniz/miniz.c"
miniz_cflags="-Os -std=c99 -Ithird_party/miniz"
tmp="${OUT}.$$.tmp"

mkdir -p src dist

scripts/gen-tool-headers

quote_c() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

CPPFLAGS="$CPPFLAGS -DBUSIERBOX_ARTIFACT_TIER=\"$ARTIFACT_TIER\""
CPPFLAGS="$CPPFLAGS -DBUSIERBOX_ADVERTISE_PAYLOAD_TOOLS=$ADVERTISE_PAYLOAD_TOOLS"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_SURVEY=$BB_ENABLE_SURVEY"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_DOCTOR=$BB_ENABLE_DOCTOR"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_CONFIG_INFO=$BB_ENABLE_CONFIG_INFO"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_EXTRACT=$BB_ENABLE_EXTRACT"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_FETCH_FULL=$BB_ENABLE_FETCH_FULL"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_CALLBACK=$BB_ENABLE_CALLBACK"
CPPFLAGS="$CPPFLAGS -DBB_STAGER_CALLBACK_ENABLE=\"$(quote_c "$BB_STAGER_CALLBACK_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_STAGER_CALLBACK_HOST=\"$(quote_c "$BB_STAGER_CALLBACK_HOST")\""
CPPFLAGS="$CPPFLAGS -DBB_STAGER_CALLBACK_PORT=\"$(quote_c "$BB_STAGER_CALLBACK_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_STAGER_CALLBACK_SHELL=\"$(quote_c "$BB_STAGER_CALLBACK_SHELL")\""
CPPFLAGS="$CPPFLAGS -DBB_STAGER_TARGET_NAME=\"$(quote_c "${BB_STAGER_TARGET_NAME:-native}")\""
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_ENABLE=\"$(quote_c "$BB_FULL_CALLBACK_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_HOST=\"$(quote_c "$BB_FULL_CALLBACK_HOST")\""
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_PORT=\"$(quote_c "$BB_FULL_CALLBACK_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_TOKEN=\"$(quote_c "$BB_FULL_CALLBACK_TOKEN")\""
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_TIMEOUT=$BB_FULL_CALLBACK_TIMEOUT"
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_RETRY_COUNT=$BB_FULL_CALLBACK_RETRY_COUNT"
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_RETRY_DELAY=$BB_FULL_CALLBACK_RETRY_DELAY"
CPPFLAGS="$CPPFLAGS -DBB_FULL_CALLBACK_AUTO_EXEC=\"$(quote_c "$BB_FULL_CALLBACK_AUTO_EXEC")\""

printf '%s\n' "building BusierBox core..."

if "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -static -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS > /dev/null 2>&1; then
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with static linking"
else
    rm -f "$tmp"
    printf '%s\n' "static link unavailable; falling back to host dynamic link" >&2
    "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with host dynamic linking"
fi

chmod 0755 "$OUT"
