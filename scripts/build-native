#!/bin/sh
set -eu

: "${CC:=cc}"
: "${CFLAGS:=-Os -Wall -Wextra -std=c99}"
: "${CPPFLAGS:=}"
: "${LDFLAGS:=}"
: "${OUT:=dist/busierbox.core}"

src="src/busierbox.c src/applet_payload.c src/applet_survey.c src/applet_envfix.c src/sha256.c"
miniz_src="third_party/miniz/miniz.c"
miniz_cflags="-Os -std=c99 -Ithird_party/miniz"
tmp="${OUT}.$$.tmp"

# Generate headers based on configs/busierbox.conf and current BusyBox payload build
if [ -f configs/busierbox.conf ]; then
    . configs/busierbox.conf
fi

BB_BUSYBOX_GROUPS="${BB_BUSYBOX_GROUPS:-shell fileops disk process network text system}"
BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:-}"

mkdir -p src dist

printf '%s\n' "generating src/bbx_busybox_applets.h..."
applets_tmp="src/bbx_busybox_applets.h.$$.tmp"
if [ -x runtime/payload/bin/busybox ] && runtime/payload/bin/busybox --list 2>/dev/null | awk '{printf "\"%s\",\n", $1}' > "$applets_tmp" && [ -s "$applets_tmp" ]; then
    mv "$applets_tmp" src/bbx_busybox_applets.h
else
    rm -f "$applets_tmp"
    # Cross payload binaries cannot be executed on the build host.
    printf '"%s",\n' sh ash cat ls cp mv rm mkdir chmod touch dd uname id which readlink stat df free ps mount env grep sleep tee tar gzip gunzip zcat nc sed awk find xargs dmesg ifconfig ip netstat ping wget date hexdump > src/bbx_busybox_applets.h
fi

printf '%s\n' "generating src/bbx_heavy_tools.h..."
: > src/bbx_heavy_tools.h
for t in $BB_HEAVY_TOOLS; do
    printf '"%s",\n' "$t" >> src/bbx_heavy_tools.h
done

printf '%s\n' "building BusierBox core..."

if "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -static -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS > /dev/null 2>&1; then
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with static linking"
else
    rm -f "$tmp"
    printf '%s\n' "static link unavailable; falling back to host dynamic link" >&2
    "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with host dynamic linking"
fi

chmod 0755 "$OUT"
