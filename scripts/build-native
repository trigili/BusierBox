#!/bin/sh
set -eu

: "${CC:=cc}"
: "${CFLAGS:=-Os -Wall -Wextra -std=c99}"
: "${CPPFLAGS:=}"
: "${LDFLAGS:=}"
: "${OUT:=dist/busierbox.core}"
: "${ARTIFACT_TIER:=core}"
: "${ADVERTISE_PAYLOAD_TOOLS:=0}"
: "${BB_ENABLE_SURVEY:=1}"
: "${BB_ENABLE_DOCTOR:=1}"
: "${BB_ENABLE_CONFIG_INFO:=1}"
: "${BB_ENABLE_EXTRACT:=1}"
: "${BB_ENABLE_FETCH_FULL:=1}"
: "${BB_STAGER_CALLBACK_ENABLE:=no}"
: "${BB_STAGER_CALLBACK_HOST:=}"
: "${BB_STAGER_CALLBACK_PORT:=}"
: "${BB_STAGER_CALLBACK_SHELL:=sh}"

src="src/busierbox.c src/applet_payload.c src/applet_survey.c src/applet_envfix.c src/sha256.c"
miniz_src="third_party/miniz/miniz.c"
miniz_cflags="-Os -std=c99 -Ithird_party/miniz"
tmp="${OUT}.$$.tmp"

mkdir -p src dist

scripts/gen-tool-headers

CPPFLAGS="$CPPFLAGS -DBUSIERBOX_ARTIFACT_TIER=\"$ARTIFACT_TIER\" -DBUSIERBOX_ADVERTISE_PAYLOAD_TOOLS=$ADVERTISE_PAYLOAD_TOOLS -DBB_ENABLE_SURVEY=$BB_ENABLE_SURVEY -DBB_ENABLE_DOCTOR=$BB_ENABLE_DOCTOR -DBB_ENABLE_CONFIG_INFO=$BB_ENABLE_CONFIG_INFO -DBB_ENABLE_EXTRACT=$BB_ENABLE_EXTRACT -DBB_ENABLE_FETCH_FULL=$BB_ENABLE_FETCH_FULL -DBB_STAGER_CALLBACK_ENABLE=\"$BB_STAGER_CALLBACK_ENABLE\" -DBB_STAGER_CALLBACK_HOST=\"$BB_STAGER_CALLBACK_HOST\" -DBB_STAGER_CALLBACK_PORT=\"$BB_STAGER_CALLBACK_PORT\" -DBB_STAGER_CALLBACK_SHELL=\"$BB_STAGER_CALLBACK_SHELL\""

printf '%s\n' "building BusierBox core..."

if "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -static -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS > /dev/null 2>&1; then
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with static linking"
else
    rm -f "$tmp"
    printf '%s\n' "static link unavailable; falling back to host dynamic link" >&2
    "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with host dynamic linking"
fi

chmod 0755 "$OUT"
