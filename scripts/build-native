#!/bin/sh
set -eu

: "${CC:=cc}"
: "${CFLAGS:=-Os -Wall -Wextra -std=c99}"
: "${CPPFLAGS:=}"
: "${LDFLAGS:=}"
: "${OUT:=dist/busierbox.core}"
: "${ARTIFACT_TIER:=core}"
: "${ADVERTISE_PAYLOAD_TOOLS:=0}"
: "${BUSIERBOX_BUILD_TIMESTAMP:=${SOURCE_DATE_EPOCH:-unknown}}"
if [ -z "${BUSIERBOX_GIT_COMMIT:-}" ]; then
    BUSIERBOX_GIT_COMMIT=$(git rev-parse --short=12 HEAD 2>/dev/null || printf '%s' unknown)
fi
: "${BB_TARGET_PRESET:=native}"
: "${BB_TARGET_NAME:=native}"
: "${BB_TARGET_ARCH:=native}"
: "${BB_TARGET_ENDIAN:=auto}"
: "${BB_TARGET_CPU:=host}"
: "${BB_TARGET_ABI:=default}"
: "${BB_TARGET_LIBC:=host}"
: "${BB_KERNEL_FLOOR:=host}"
: "${BB_STATIC_POLICY:=static-preferred}"
: "${BB_PAYLOAD_PRESET:=default}"
: "${BB_RUNTIME_MODE:=extract}"
: "${BB_RUNTIME_ROOT:=./.busierbox}"
: "${BB_RUNTIME_ALLOW_FALLBACK_ROOT:=no}"
: "${BB_RUNTIME_FALLBACK_ROOT:=/tmp/.busierbox}"
: "${BB_ENABLE_SURVEY:=1}"
: "${BB_ENABLE_DOCTOR:=1}"
: "${BB_ENABLE_CONFIG_INFO:=1}"
: "${BB_ENABLE_EXTRACT:=1}"
: "${BB_ENABLE_FETCH_FULL:=1}"
: "${BB_ZERO_ARG_MODE:=${BB_FULL_ZERO_ARG_MODE:-help}}"
: "${BB_ZERO_ARG_LOG_MODE:=quiet}"
: "${BB_ZERO_ARG_CUSTOM_COMMAND:=}"
: "${BB_RSHELL_TRANSPORT:=${BB_RSHELL_MODE:-ssh}}"
: "${BB_RSHELL_ENCRYPTION:=tls}"
: "${BB_RSHELL_ALLOW_PLAINTEXT:=no}"
: "${BB_RSHELL_AUTHKEYS_MODE:=disabled}"
: "${BB_RSHELL_RUN_MODE:=auto}"
: "${BB_RSHELL_SESSION_POLICY:=single}"
: "${BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING:=no}"
: "${BB_RSHELL_SOCAT_PORT:=22203}"
: "${BB_RSHELL_SHELL_PROVIDER:=auto}"
: "${BB_RSHELL_CUSTOM_SHELL:=}"
: "${BB_RSHELL_RETRY_COUNT:=1}"
: "${BB_RSHELL_RETRY_INTERVAL_SEC:=5}"
: "${BB_RSHELL_RETRY_JITTER_PCT:=20}"
: "${BB_RSHELL_RETRY_BACKOFF:=none}"
: "${BB_RSHELL_RETRY_MAX_INTERVAL_SEC:=300}"
# BB_BUILTIN_TLS_ENABLE is derived from transport; only override if explicitly set
if [ -z "${BB_BUILTIN_TLS_ENABLE:-}" ]; then
    [ "$BB_RSHELL_TRANSPORT" = builtin ] && BB_BUILTIN_TLS_ENABLE=yes || BB_BUILTIN_TLS_ENABLE=no
fi
: "${BB_AUTORUN_GUARD_ENABLE:=yes}"
# Derive guard path from runtime root if still at the old /tmp default
if [ "${BB_AUTORUN_GUARD_PATH:-/tmp/busierbox-autorun}" = "/tmp/busierbox-autorun" ]; then
    BB_AUTORUN_GUARD_PATH="${BB_RUNTIME_ROOT}/run"
fi
: "${BB_AUTORUN_GUARD_PATH:=${BB_RUNTIME_ROOT}/run}"
: "${BB_AUTORUN_REENTRY_ACTION:=status}"
: "${BB_AUTORUN_STALE_LOCK_POLICY:=recover}"
: "${BB_OPERATOR_REMOTE_FORWARD_PORT:=2200}"
: "${BB_OPERATOR_TARGET_DROPBEAR_PORT:=2222}"
: "${BB_OPERATOR_SERVER_HOST:=}"
: "${BB_OPERATOR_SERVER_USER:=operator}"
: "${BB_OPERATOR_SERVER_SSH_PORT:=22}"
: "${BB_OPERATOR_TARGET_BIND_HOST:=127.0.0.1}"
: "${BB_OPERATOR_KNOWN_HOSTS_POLICY:=off}"
: "${BB_OPERATOR_FILE_SERVICE_ENABLE:=no}"
: "${BB_OPERATOR_FILE_SERVICE_PORT:=22204}"
: "${BB_OPERATOR_FILE_SERVICE_TLS:=yes}"
: "${BB_RECOVERY_BINARY_NAME:=busierbox_recovery}"
: "${BB_DOTFILES_ENABLE:=yes}"
: "${BB_DOTFILE_ZSH_MODE:=default}"
: "${BB_DOTFILE_BASH_MODE:=default}"
: "${BB_DOTFILE_TMUX_MODE:=default}"
: "${BB_DOTFILE_GDB_MODE:=default}"
: "${BB_DOTFILE_PROFILE_MODE:=default}"
: "${BB_USER_OVERLAY_ENABLE:=no}"
: "${BB_USER_OVERLAY_ROOT:=./overlay}"
: "${BB_USER_OVERLAY_ALLOW_OVERRIDE:=no}"
: "${BB_GDBSERVER_PROVIDER:=auto}"

src="src/busierbox.c src/payload_runtime.c src/applet_extract.c src/applet_list.c src/applet_manifest.c src/applet_doctor.c src/applet_reality_test.c src/applet_config_info.c src/applet_clean.c src/applet_plan.c src/applet_recovery.c src/applet_survey.c src/applet_envfix.c src/applet_fetch.c src/applet_rshell.c src/applet_upload.c src/ledger.c src/runtime_paths.c src/runtime_probe.c src/json_helpers.c src/payload_extract.c src/payload_dispatch.c src/trailer_config.c src/runtime_config.c src/sha256.c"
miniz_src="third_party/miniz/miniz.c"
miniz_cflags="-Os -std=c99 -Ithird_party/miniz"
tmp="${OUT}.$$.tmp"

mkdir -p src dist

scripts/gen-tool-headers

quote_c() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Normalise old transport names for backward compat
case "$BB_RSHELL_TRANSPORT" in
    builtin-tls) BB_RSHELL_TRANSPORT=builtin; BB_RSHELL_ENCRYPTION=${BB_RSHELL_ENCRYPTION:-tls} ;;
    socat-tls)   BB_RSHELL_TRANSPORT=socat;   BB_RSHELL_ENCRYPTION=${BB_RSHELL_ENCRYPTION:-tls} ;;
esac
: "${BB_RSHELL_ENCRYPTION:=tls}"

# Validate transport+encryption combination
if [ "$BB_RSHELL_TRANSPORT" = builtin ] && [ "$BB_RSHELL_ENCRYPTION" = none ]; then
    printf '%s\n' "build-native: transport=builtin encryption=none is not implemented" >&2
    exit 1
fi
if [ "$BB_RSHELL_TRANSPORT" != none ] && [ "$BB_RSHELL_TRANSPORT" = builtin ] && [ "$BB_RSHELL_ENCRYPTION" = tls ] && [ "$BB_BUILTIN_TLS_ENABLE" != yes ]; then
    printf '%s\n' "build-native: transport=builtin encryption=tls requires BB_BUILTIN_TLS_ENABLE=yes (wolfSSL)" >&2
    exit 1
fi

if [ "$BB_BUILTIN_TLS_ENABLE" = yes ]; then
    _wolfssl_ok=0
    wolfssl_cflags=""
    wolfssl_libs=""
    _wolfssl_source=""

    if [ -n "${WOLFSSL_CFLAGS:-}" ] || [ -n "${WOLFSSL_LIBS:-}" ]; then
        wolfssl_cflags="${WOLFSSL_CFLAGS:-}"
        wolfssl_libs="${WOLFSSL_LIBS:--lwolfssl}"
        _wolfssl_source="env WOLFSSL_CFLAGS/WOLFSSL_LIBS"
    elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists wolfssl 2>/dev/null; then
        wolfssl_cflags=$(pkg-config --cflags wolfssl 2>/dev/null || true)
        wolfssl_libs=$(pkg-config --libs wolfssl 2>/dev/null || true)
        _wolfssl_source="pkg-config"
    else
        wolfssl_cflags=""
        wolfssl_libs="-lwolfssl"
        _wolfssl_source="-lwolfssl fallback (no pkg-config match)"
    fi

    _probe_dir=$(mktemp -d)
    printf '#include <wolfssl/ssl.h>\nint main(void){wolfSSL_Init();wolfSSL_Cleanup();return 0;}\n' >"$_probe_dir/probe.c"
    _probe_err=$("$CC" $wolfssl_cflags "$_probe_dir/probe.c" -o "$_probe_dir/probe" $wolfssl_libs 2>&1) && _wolfssl_ok=1 || true
    rm -rf "$_probe_dir"

    if [ "$_wolfssl_ok" = 1 ]; then
        CPPFLAGS="$CPPFLAGS -DHAVE_WOLFSSL ${wolfssl_cflags:+$wolfssl_cflags}"
        LDFLAGS="$LDFLAGS $wolfssl_libs"
        src="$src src/rshell_tls.c"
        printf '%s\n' "build-native: wolfSSL detected via $_wolfssl_source, builtin TLS enabled"
    else
        printf '%s\n' "build-native: BB_BUILTIN_TLS_ENABLE=yes but wolfSSL compile probe failed" >&2
        printf '%s\n' "  Detection attempted via: $_wolfssl_source" >&2
        if [ -n "$_probe_err" ]; then
            printf '%s\n' "  Probe error: $_probe_err" >&2
        fi
        if command -v pkg-config >/dev/null 2>&1; then
            if pkg-config --exists wolfssl 2>/dev/null; then
                printf '%s\n' "  pkg-config --exists wolfssl: yes" >&2
                printf '%s\n' "  pkg-config --cflags wolfssl: $(pkg-config --cflags wolfssl 2>&1)" >&2
                printf '%s\n' "  pkg-config --libs wolfssl: $(pkg-config --libs wolfssl 2>&1)" >&2
            else
                printf '%s\n' "  pkg-config --exists wolfssl: no" >&2
            fi
        else
            printf '%s\n' "  pkg-config: not in PATH" >&2
        fi
        if [ -f /usr/include/wolfssl/ssl.h ]; then
            printf '%s\n' "  /usr/include/wolfssl/ssl.h: found" >&2
        else
            printf '%s\n' "  /usr/include/wolfssl/ssl.h: not found" >&2
        fi
        printf '%s\n' "  To override: export WOLFSSL_CFLAGS=... WOLFSSL_LIBS=... before building" >&2
        printf '%s\n' "  Debian/Ubuntu: apt install libwolfssl-dev" >&2
        exit 1
    fi
fi

CPPFLAGS="$CPPFLAGS -DBUSIERBOX_ARTIFACT_TIER=\"$ARTIFACT_TIER\""
CPPFLAGS="$CPPFLAGS -DBUSIERBOX_ADVERTISE_PAYLOAD_TOOLS=$ADVERTISE_PAYLOAD_TOOLS"
CPPFLAGS="$CPPFLAGS -DBUSIERBOX_BUILD_TIMESTAMP=\"$(quote_c "$BUSIERBOX_BUILD_TIMESTAMP")\""
CPPFLAGS="$CPPFLAGS -DBUSIERBOX_GIT_COMMIT=\"$(quote_c "$BUSIERBOX_GIT_COMMIT")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_PRESET=\"$(quote_c "$BB_TARGET_PRESET")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_NAME=\"$(quote_c "$BB_TARGET_NAME")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_ARCH=\"$(quote_c "$BB_TARGET_ARCH")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_ENDIAN=\"$(quote_c "$BB_TARGET_ENDIAN")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_CPU=\"$(quote_c "$BB_TARGET_CPU")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_ABI=\"$(quote_c "$BB_TARGET_ABI")\""
CPPFLAGS="$CPPFLAGS -DBB_TARGET_LIBC=\"$(quote_c "$BB_TARGET_LIBC")\""
CPPFLAGS="$CPPFLAGS -DBB_KERNEL_FLOOR=\"$(quote_c "$BB_KERNEL_FLOOR")\""
CPPFLAGS="$CPPFLAGS -DBB_STATIC_POLICY=\"$(quote_c "$BB_STATIC_POLICY")\""
CPPFLAGS="$CPPFLAGS -DBB_PAYLOAD_PRESET=\"$(quote_c "$BB_PAYLOAD_PRESET")\""
CPPFLAGS="$CPPFLAGS -DBB_RUNTIME_MODE=\"$(quote_c "$BB_RUNTIME_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_RUNTIME_ROOT=\"$(quote_c "$BB_RUNTIME_ROOT")\""
CPPFLAGS="$CPPFLAGS -DBB_RUNTIME_ALLOW_FALLBACK_ROOT=\"$(quote_c "$BB_RUNTIME_ALLOW_FALLBACK_ROOT")\""
CPPFLAGS="$CPPFLAGS -DBB_RUNTIME_FALLBACK_ROOT=\"$(quote_c "$BB_RUNTIME_FALLBACK_ROOT")\""
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_SURVEY=$BB_ENABLE_SURVEY"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_DOCTOR=$BB_ENABLE_DOCTOR"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_CONFIG_INFO=$BB_ENABLE_CONFIG_INFO"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_EXTRACT=$BB_ENABLE_EXTRACT"
CPPFLAGS="$CPPFLAGS -DBB_ENABLE_FETCH_FULL=$BB_ENABLE_FETCH_FULL"
CPPFLAGS="$CPPFLAGS -DBB_ZERO_ARG_MODE=\"$(quote_c "$BB_ZERO_ARG_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_ZERO_ARG_LOG_MODE=\"$(quote_c "$BB_ZERO_ARG_LOG_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_ZERO_ARG_CUSTOM_COMMAND=\"$(quote_c "$BB_ZERO_ARG_CUSTOM_COMMAND")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_TRANSPORT=\"$(quote_c "$BB_RSHELL_TRANSPORT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_MODE=\"$(quote_c "$BB_RSHELL_TRANSPORT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_ENCRYPTION=\"$(quote_c "$BB_RSHELL_ENCRYPTION")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_ALLOW_PLAINTEXT=\"$(quote_c "$BB_RSHELL_ALLOW_PLAINTEXT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_AUTHKEYS_MODE=\"$(quote_c "$BB_RSHELL_AUTHKEYS_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RUN_MODE=\"$(quote_c "$BB_RSHELL_RUN_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_SESSION_POLICY=\"$(quote_c "$BB_RSHELL_SESSION_POLICY")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_GENERATE_HOSTKEY_IF_MISSING=\"$(quote_c "$BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_SOCAT_PORT=\"$(quote_c "$BB_RSHELL_SOCAT_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_SHELL_PROVIDER=\"$(quote_c "$BB_RSHELL_SHELL_PROVIDER")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_CUSTOM_SHELL=\"$(quote_c "$BB_RSHELL_CUSTOM_SHELL")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RETRY_COUNT=\"$(quote_c "$BB_RSHELL_RETRY_COUNT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RETRY_INTERVAL_SEC=\"$(quote_c "$BB_RSHELL_RETRY_INTERVAL_SEC")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RETRY_JITTER_PCT=\"$(quote_c "$BB_RSHELL_RETRY_JITTER_PCT")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RETRY_BACKOFF=\"$(quote_c "$BB_RSHELL_RETRY_BACKOFF")\""
CPPFLAGS="$CPPFLAGS -DBB_RSHELL_RETRY_MAX_INTERVAL_SEC=\"$(quote_c "$BB_RSHELL_RETRY_MAX_INTERVAL_SEC")\""
CPPFLAGS="$CPPFLAGS -DBB_BUILTIN_TLS_ENABLE=\"$(quote_c "$BB_BUILTIN_TLS_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_AUTORUN_GUARD_ENABLE=\"$(quote_c "$BB_AUTORUN_GUARD_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_AUTORUN_GUARD_PATH=\"$(quote_c "$BB_AUTORUN_GUARD_PATH")\""
CPPFLAGS="$CPPFLAGS -DBB_AUTORUN_REENTRY_ACTION=\"$(quote_c "$BB_AUTORUN_REENTRY_ACTION")\""
CPPFLAGS="$CPPFLAGS -DBB_AUTORUN_STALE_LOCK_POLICY=\"$(quote_c "$BB_AUTORUN_STALE_LOCK_POLICY")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_REMOTE_FORWARD_PORT=\"$(quote_c "$BB_OPERATOR_REMOTE_FORWARD_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_TARGET_DROPBEAR_PORT=\"$(quote_c "$BB_OPERATOR_TARGET_DROPBEAR_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_SERVER_HOST=\"$(quote_c "$BB_OPERATOR_SERVER_HOST")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_SERVER_USER=\"$(quote_c "$BB_OPERATOR_SERVER_USER")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_SERVER_SSH_PORT=\"$(quote_c "$BB_OPERATOR_SERVER_SSH_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_TARGET_BIND_HOST=\"$(quote_c "$BB_OPERATOR_TARGET_BIND_HOST")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_KNOWN_HOSTS_POLICY=\"$(quote_c "$BB_OPERATOR_KNOWN_HOSTS_POLICY")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_FILE_SERVICE_ENABLE=\"$(quote_c "$BB_OPERATOR_FILE_SERVICE_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_FILE_SERVICE_PORT=\"$(quote_c "$BB_OPERATOR_FILE_SERVICE_PORT")\""
CPPFLAGS="$CPPFLAGS -DBB_OPERATOR_FILE_SERVICE_TLS=\"$(quote_c "$BB_OPERATOR_FILE_SERVICE_TLS")\""
CPPFLAGS="$CPPFLAGS -DBB_RECOVERY_BINARY_NAME=\"$(quote_c "$BB_RECOVERY_BINARY_NAME")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILES_ENABLE=\"$(quote_c "$BB_DOTFILES_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILE_ZSH_MODE=\"$(quote_c "$BB_DOTFILE_ZSH_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILE_BASH_MODE=\"$(quote_c "$BB_DOTFILE_BASH_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILE_TMUX_MODE=\"$(quote_c "$BB_DOTFILE_TMUX_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILE_GDB_MODE=\"$(quote_c "$BB_DOTFILE_GDB_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_DOTFILE_PROFILE_MODE=\"$(quote_c "$BB_DOTFILE_PROFILE_MODE")\""
CPPFLAGS="$CPPFLAGS -DBB_USER_OVERLAY_ENABLE=\"$(quote_c "$BB_USER_OVERLAY_ENABLE")\""
CPPFLAGS="$CPPFLAGS -DBB_USER_OVERLAY_ROOT=\"$(quote_c "$BB_USER_OVERLAY_ROOT")\""
CPPFLAGS="$CPPFLAGS -DBB_USER_OVERLAY_ALLOW_OVERRIDE=\"$(quote_c "$BB_USER_OVERLAY_ALLOW_OVERRIDE")\""
CPPFLAGS="$CPPFLAGS -DBB_GDBSERVER_PROVIDER=\"$(quote_c "$BB_GDBSERVER_PROVIDER")\""

if ! printf '%s\n' '#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
int main(void) { char *p = NULL; size_t n = 0; FILE *f = open_memstream(&p, &n); if (!f) return 1; fputs("x", f); fclose(f); free(p); return 0; }' |
    "$CC" $CPPFLAGS $CFLAGS -x c -o /dev/null - >/dev/null 2>&1; then
    CPPFLAGS="$CPPFLAGS -DBUSIERBOX_NO_OPEN_MEMSTREAM=1"
fi

printf '%s\n' "building BusierBox core..."

if "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -static -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS > /dev/null 2>&1; then
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with static linking"
else
    rm -f "$tmp"
    printf '%s\n' "static link unavailable; falling back to host dynamic link" >&2
    "$CC" $CPPFLAGS $CFLAGS -Ithird_party/miniz -o "$tmp" $src $miniz_cflags $miniz_src $LDFLAGS
    mv "$tmp" "$OUT"
    printf '%s\n' "built $OUT with host dynamic linking"
fi

chmod 0755 "$OUT"
