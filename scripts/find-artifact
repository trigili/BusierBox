#!/usr/bin/env python3
"""Find artifacts across a local BusierBox release repository index."""

import argparse
import json
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def load_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"find-artifact: cannot read {path}: {exc}")


def useful(value):
    value = "" if value is None else str(value)
    return "" if value in ("", "unknown", "auto", "none") else value


def boolish(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.lower() in {"yes", "true", "1", "ok", "basic-ok", "present"}
    return bool(value)


def kernel_floor(release):
    release = useful(release)
    if not release:
        return ""
    major = release.split(".", 1)[0]
    if major.isdigit():
        return f"{major}.x"
    return ""


def survey_filter_hints(path):
    data = load_json(pathlib.Path(path))
    recs = data.get("recommendations") if isinstance(data.get("recommendations"), dict) else {}
    uname = data.get("uname") if isinstance(data.get("uname"), dict) else {}
    return {
        "arch": useful(recs.get("target_arch_guess")) or useful(data.get("arch")) or useful(uname.get("machine")),
        "libc": useful(recs.get("libc_guess")) or useful(data.get("libc")),
        "kernel": useful(recs.get("kernel_floor_guess")) or kernel_floor(data.get("kernel") or uname.get("release")),
        "cpu": useful(recs.get("target_cpu_guess")) or useful(data.get("cpu")),
        "abi": useful(recs.get("target_abi_guess")) or useful(data.get("abi")),
        "target_preset": useful(recs.get("target_preset_guess")),
    }


def apply_survey_filters(args):
    if not args.survey_json:
        return {}
    hints = survey_filter_hints(args.survey_json)
    applied = {}
    for key in ("arch", "libc", "kernel", "cpu", "abi"):
        value = hints.get(key)
        if value and not getattr(args, key):
            setattr(args, key, value)
            applied[key] = value
    return {
        "path": args.survey_json,
        "hints": hints,
        "applied_filters": applied,
    }


def reality_checks(data):
    if not isinstance(data, dict):
        return {}
    checks = data.get("checks")
    if not isinstance(checks, list):
        return {}
    scanned = {item.get("name"): item for item in checks if isinstance(item, dict) and item.get("name")}
    checks_by_name = data.get("checks_by_name")
    if isinstance(checks_by_name, dict):
        indexed = {}
        for name, indexes in checks_by_name.items():
            if not isinstance(name, str):
                continue
            if isinstance(indexes, int):
                indexes = [indexes]
            if not isinstance(indexes, list):
                continue
            for index in indexes:
                if not isinstance(index, int) or index < 0 or index >= len(checks):
                    continue
                item = checks[index]
                if isinstance(item, dict) and item.get("name") == name:
                    indexed[name] = item
                    break
        if indexed:
            for name, item in scanned.items():
                indexed.setdefault(name, item)
            return indexed
    return scanned


def reality_context(path):
    if not path:
        return {}
    data = load_json(pathlib.Path(path))
    checks_by_name = reality_checks(data)
    summary = data.get("summary") if isinstance(data, dict) and isinstance(data.get("summary"), dict) else {}
    constraints = summary.get("constraints") if isinstance(summary.get("constraints"), dict) else {}

    def check(name):
        return checks_by_name.get(name) or {}

    def failed(name):
        item = check(name)
        if not item or item.get("skipped"):
            return False
        return item.get("status") == "fail" or item.get("ok") is False or item.get("available") is False

    def detected(name):
        item = check(name)
        if item:
            return boolish(item.get("detected"))
        if name in constraints:
            return boolish(constraints.get(name))
        return False

    failed_checks = [
        name for name in sorted(checks_by_name)
        if failed(name)
    ]
    return {
        "path": path,
        "schema": data.get("schema") if isinstance(data, dict) else None,
        "check_count": len(checks_by_name),
        "checks_seen": sorted(checks_by_name),
        "failed_checks": failed_checks,
        "constraints": {
            "tmp_noexec": detected("tmp_noexec"),
            "rootfs_read_only": detected("rootfs_read_only"),
            "procfs_partial": detected("procfs_partial"),
        },
        "status_by_check": {
            name: (item.get("status") or "")
            for name, item in sorted(checks_by_name.items())
            if isinstance(item, dict)
        },
        "summary": summary,
        "api_collections": data.get("api_collections") if isinstance(data.get("api_collections"), dict) else {},
        "selection_note": "reported for audit and UI context; artifact compatibility labels come from the release index",
    }


def build_index(paths):
    cmd = [str(ROOT / "scripts" / "index-release-repo"), *paths]
    return json.loads(subprocess.check_output(cmd, text=True))


def tuple_info(row, index):
    tuple_path = row.get("tuple_path") or ""
    for item in index.get("tuples", {}).get(tuple_path, []):
        if item.get("release_dir") == row.get("release_dir"):
            return item.get("tuple") or row.get("tuple") or {}
    return row.get("tuple") or {}


def matches(row, index, args):
    info = tuple_info(row, index)
    doom_wads = [wad for wad in (row.get("doom_wads") or []) if isinstance(wad, dict)]
    if args.sha256 and row.get("sha256") != args.sha256:
        return False
    if args.doom_wad and not any(wad.get("filename") == args.doom_wad for wad in doom_wads):
        return False
    if args.doom_wad_sha256 and not any(wad.get("sha256") == args.doom_wad_sha256 for wad in doom_wads):
        return False
    if args.release and row.get("release_name") != args.release:
        return False
    if args.tuple_path and row.get("tuple_path") != args.tuple_path:
        return False
    if args.arch and info.get("arch") != args.arch:
        return False
    if args.libc and info.get("libc") != args.libc:
        return False
    if args.kernel and info.get("kernel_floor") != args.kernel:
        return False
    if args.cpu and info.get("cpu") != args.cpu:
        return False
    if args.abi and info.get("abi") != args.abi:
        return False
    if args.payload_preset and row.get("payload_preset") != args.payload_preset:
        return False
    if args.tool and args.tool not in (row.get("tools") or []):
        return False
    if args.feature and args.feature not in (row.get("features") or []):
        return False
    if args.device:
        aliases = index.get("devices", {}).get(args.device) or []
        allowed = {
            (item.get("release_dir"), item.get("tuple_path"))
            for item in aliases
        }
        if (row.get("release_dir"), row.get("tuple_path")) not in allowed:
            return False
    return True


def label_rank(row):
    label = ((row.get("compatibility") or {}).get("label") or "exact")
    return {"exact": 0, "likely": 1, "heuristic": 2, "unsafe": 3, "incompatible": 4}.get(label, 5)


def compatibility_rank(label):
    return {"exact": 0, "likely": 1, "heuristic": 2, "unsafe": 3, "incompatible": 4}.get(label or "", 5)


def print_text(row, index):
    info = tuple_info(row, index)
    compatibility = row.get("compatibility") or {}
    print(f"recommended_artifact={row.get('artifact_path') or ''}")
    print(f"release_name={row.get('release_name') or ''}")
    print(f"release_dir={row.get('release_dir') or ''}")
    print(f"artifact={row.get('artifact') or ''}")
    print(f"sha256={row.get('sha256') or ''}")
    print(f"tuple_path={row.get('tuple_path') or ''}")
    print(f"arch={info.get('arch') or ''}")
    print(f"libc={info.get('libc') or ''}")
    print(f"kernel_floor={info.get('kernel_floor') or ''}")
    print(f"cpu={info.get('cpu') or ''}")
    print(f"abi={info.get('abi') or ''}")
    print(f"payload_preset={row.get('payload_preset') or ''}")
    print(f"compatibility={compatibility.get('label') or ''}")
    for reason in compatibility.get("reasons") or []:
        print(f"compatibility_reason={reason}")
    if compatibility.get("note"):
        print(f"compatibility_note={compatibility.get('note')}")
    if row.get("release_self_test_status"):
        print(f"release_self_test_status={row.get('release_self_test_status')}")
    if row.get("release_self_test_path"):
        print(f"release_self_test_path={row.get('release_self_test_path')}")
    release_self_test = row.get("release_self_test") or {}
    if release_self_test:
        print(
            "release_self_test_command_queue_token_required_count="
            f"{release_self_test.get('command_queue_token_required_count', 0)}"
        )
        print(
            "release_self_test_command_queue_token_configured_count="
            f"{release_self_test.get('command_queue_token_configured_count', 0)}"
        )
        print(
            "release_self_test_command_queue_execution_supported_count="
            f"{release_self_test.get('command_queue_execution_supported_count', 0)}"
        )
        print(
            "release_self_test_command_queue_operator_supplied_command_execution_count="
            f"{release_self_test.get('command_queue_operator_supplied_command_execution_count', 0)}"
        )
    for tool, status in sorted((row.get("tool_provider_status") or {}).items()):
        if isinstance(status, dict):
            print(f"provider_status_{tool}={status.get('overall') or status.get('status') or 'unknown'}")
    for wad in row.get("doom_wads") or []:
        if not isinstance(wad, dict) or not wad.get("filename"):
            continue
        print(f"doom_wad={wad.get('filename')} size={wad.get('size', '')} sha256={wad.get('sha256', '')}")
    print(f"dedupe_count={len((index.get('dedupe', {}).get(row.get('sha256') or '', {}) or {}).get('artifacts') or [])}")
    print("features=" + " ".join(row.get("features") or []))


def active_filters(args):
    keys = (
        "release",
        "tuple_path",
        "device",
        "arch",
        "libc",
        "kernel",
        "cpu",
        "abi",
        "tool",
        "payload_preset",
        "feature",
        "sha256",
        "doom_wad",
        "doom_wad_sha256",
        "max_compatibility",
        "survey_json",
        "reality_json",
    )
    return {key: getattr(args, key) for key in keys if getattr(args, key)}


def filter_records(args, survey_context=None):
    filters = active_filters(args)
    applied = (survey_context or {}).get("applied_filters") or {}
    records = []
    for name in sorted(filters):
        if name == "survey_json":
            source = "explicit"
            reason = "survey evidence path supplied by operator"
        elif name == "reality_json":
            source = "explicit"
            reason = "reality-test evidence path supplied by operator"
        elif name in applied:
            source = "survey"
            reason = "derived from survey evidence because no explicit filter was supplied"
        else:
            source = "explicit"
            reason = "operator-supplied CLI filter"
        records.append({
            "name": name,
            "value": filters[name],
            "source": source,
            "reason": reason,
        })
    return records


def filter_record_indexes(records):
    by_name = {}
    by_source = {}
    by_name_source = {}
    for rec in records or []:
        name = rec.get("name", "")
        source = rec.get("source", "")
        if name:
            by_name[name] = rec
        if source:
            by_source.setdefault(source, []).append(rec)
        if name and source:
            by_name_source[f"{name}:{source}"] = rec
    return by_name, by_source, by_name_source


def add_index(indexes, name, key, row):
    if key:
        indexes.setdefault(name, {}).setdefault(str(key), []).append(row)


def match_indexes(rows):
    indexes = {
        "matches_by_release": {},
        "matches_by_tuple_path": {},
        "matches_by_payload_preset": {},
        "matches_by_compatibility": {},
        "matches_by_tool": {},
        "matches_by_feature": {},
        "matches_by_provider_tool": {},
        "matches_by_provider_status": {},
        "matches_by_doom_wad_filename": {},
        "matches_by_doom_wad_sha256": {},
        "matches_by_command_queue_enabled": {},
        "matches_by_command_queue_execution_supported": {},
        "matches_by_command_queue_operator_supplied_command_execution": {},
    }
    for row in rows:
        add_index(indexes, "matches_by_release", row.get("release_name"), row)
        add_index(indexes, "matches_by_tuple_path", row.get("tuple_path"), row)
        add_index(indexes, "matches_by_payload_preset", row.get("payload_preset"), row)
        add_index(indexes, "matches_by_compatibility", (row.get("compatibility") or {}).get("label") or "exact", row)
        command_queue = row.get("command_queue") or {}
        mode_summary = command_queue.get("mode_summary") or {}
        add_index(
            indexes,
            "matches_by_command_queue_enabled",
            "true" if command_queue.get("enabled") == "yes" or command_queue.get("enabled") is True else "false",
            row,
        )
        add_index(
            indexes,
            "matches_by_command_queue_execution_supported",
            "true" if command_queue.get("execution_supported") is True or command_queue.get("executes_commands") is True else "false",
            row,
        )
        add_index(
            indexes,
            "matches_by_command_queue_operator_supplied_command_execution",
            "true" if int(mode_summary.get("operator_supplied_command_execution_mode_count") or 0) > 0 else "false",
            row,
        )
        for tool in row.get("tools") or []:
            add_index(indexes, "matches_by_tool", tool, row)
        for feature in row.get("features") or []:
            add_index(indexes, "matches_by_feature", feature, row)
        for tool, status in sorted((row.get("tool_provider_status") or {}).items()):
            if isinstance(status, dict):
                add_index(indexes, "matches_by_provider_tool", tool, row)
                add_index(indexes, "matches_by_provider_status", f"{tool}:{status.get('overall') or status.get('status') or 'unknown'}", row)
        for wad in row.get("doom_wads") or []:
            if not isinstance(wad, dict):
                continue
            add_index(indexes, "matches_by_doom_wad_filename", wad.get("filename"), row)
            add_index(indexes, "matches_by_doom_wad_sha256", wad.get("sha256"), row)
    return indexes


def api_collection_record(name, count, indexes, summary_key, primary_key=""):
    return {
        "name": name,
        "count": count,
        "count_summary_key": summary_key,
        "primary_key": primary_key,
        "indexes": list(indexes),
        "summary_key": summary_key,
    }


def recommendation_document(index, rows, args, survey_context=None, reality=None):
    selected = rows[0] if rows else None
    selected_sha = (selected or {}).get("sha256") or ""
    dedupe = (index.get("dedupe", {}).get(selected_sha, {}) or {}).get("artifacts") or []
    visible_matches = rows if args.all else rows[:1]
    indexes = match_indexes(visible_matches)
    filters = filter_records(args, survey_context)
    filters_by_name, filters_by_source, filters_by_name_source = filter_record_indexes(filters)
    return {
        "schema": 1,
        "command": "find-artifact",
        "filters": active_filters(args),
        "filter_records": filters,
        "filters_by_name": filters_by_name,
        "filters_by_source": filters_by_source,
        "filters_by_name_source": filters_by_name_source,
        "filter_count": len(filters),
        "survey": survey_context or {},
        "match_count": len(rows),
        "visible_match_count": len(visible_matches),
        "selection_policy": [
            "lowest compatibility risk label",
            "newest release_mtime",
            "payload preset name",
            "artifact path",
        ],
        "reality": reality or {},
        "selected": selected,
        "dedupe_alternatives": dedupe,
        "dedupe_count": len(dedupe),
        "matches": visible_matches,
        **indexes,
        "api_collections": {
            "matches": api_collection_record(
                "matches",
                len(visible_matches),
                [
                    "matches_by_release",
                    "matches_by_tuple_path",
                    "matches_by_payload_preset",
                    "matches_by_compatibility",
                    "matches_by_tool",
                    "matches_by_feature",
                    "matches_by_provider_tool",
                    "matches_by_provider_status",
                    "matches_by_doom_wad_filename",
                    "matches_by_doom_wad_sha256",
                    "matches_by_command_queue_enabled",
                    "matches_by_command_queue_execution_supported",
                    "matches_by_command_queue_operator_supplied_command_execution",
                ],
                "visible_match_count",
                "artifact_path",
            ),
            "dedupe_alternatives": api_collection_record(
                "dedupe_alternatives",
                len(dedupe),
                [],
                "dedupe_count",
                "artifact_path",
            ),
            "filter_records": api_collection_record(
                "filter_records",
                len(filters),
                [
                    "filters_by_name",
                    "filters_by_source",
                    "filters_by_name_source",
                ],
                "filter_count",
                "name",
            ),
        },
        "index": {
            "release_count": index.get("release_count", 0),
            "artifact_count": index.get("artifact_count", 0),
            "deduplicated_artifact_count": index.get("deduplicated_artifact_count", 0),
            "release_self_test_count": index.get("release_self_test_count", 0),
            "release_self_test_command_queue_token_required_count": index.get("release_self_test_command_queue_token_required_count", 0),
            "release_self_test_command_queue_token_configured_count": index.get("release_self_test_command_queue_token_configured_count", 0),
            "release_self_test_command_queue_execution_supported_count": index.get("release_self_test_command_queue_execution_supported_count", 0),
            "release_self_test_command_queue_operator_supplied_command_execution_count": index.get("release_self_test_command_queue_operator_supplied_command_execution_count", 0),
            "artifacts_by_sha_count": len(index.get("artifacts_by_sha") or {}),
            "artifacts_by_release_count": len(index.get("artifacts_by_release") or {}),
            "artifacts_by_tuple_path_count": len(index.get("artifacts_by_tuple_path") or {}),
            "artifacts_by_tool_count": len(index.get("artifacts_by_tool") or {}),
            "artifacts_by_payload_preset_count": len(index.get("artifacts_by_payload_preset") or {}),
            "artifacts_by_feature_count": len(index.get("artifacts_by_feature") or {}),
            "artifacts_by_compatibility_count": len(index.get("artifacts_by_compatibility") or {}),
            "compatibility_counts": index.get("compatibility_counts") or {},
            "artifacts_by_tool_payload_preset_count": len(index.get("artifacts_by_tool_payload_preset") or {}),
            "artifacts_by_feature_payload_preset_count": len(index.get("artifacts_by_feature_payload_preset") or {}),
            "artifacts_by_tuple_payload_preset_count": len(index.get("artifacts_by_tuple_payload_preset") or {}),
            "artifacts_by_provider_tool_count": len(index.get("artifacts_by_provider_tool") or {}),
            "artifacts_by_provider_status_count": len(index.get("artifacts_by_provider_status") or {}),
            "artifacts_by_doom_wad_filename_count": len(index.get("artifacts_by_doom_wad_filename") or {}),
            "artifacts_by_doom_wad_sha256_count": len(index.get("artifacts_by_doom_wad_sha256") or {}),
            "artifacts_by_command_queue_enabled_count": len(index.get("artifacts_by_command_queue_enabled") or {}),
            "artifacts_by_command_queue_execution_supported_count": len(index.get("artifacts_by_command_queue_execution_supported") or {}),
            "artifacts_by_command_queue_operator_supplied_command_execution_count": len(index.get("artifacts_by_command_queue_operator_supplied_command_execution") or {}),
            "release_self_tests_by_release_count": len(index.get("release_self_tests_by_release") or {}),
            "release_self_tests_by_status_count": len(index.get("release_self_tests_by_status") or {}),
        },
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--index", help="prebuilt index from scripts/index-release-repo")
    parser.add_argument("--release-root", action="append", default=[], help="release dir or directory containing releases; repeatable")
    parser.add_argument("--survey-json", help="derive unset arch/libc/kernel/cpu/abi filters from busierbox survey --json output")
    parser.add_argument("--reality-json", help="include busierbox reality-test --json evidence in recommendation output")
    parser.add_argument("--release")
    parser.add_argument("--tuple-path", help="canonical release tuple path, such as by-tuple/mipsel/musl/4.x/mips32r2-24kc")
    parser.add_argument("--device")
    parser.add_argument("--arch")
    parser.add_argument("--libc")
    parser.add_argument("--kernel")
    parser.add_argument("--cpu")
    parser.add_argument("--abi")
    parser.add_argument("--tool")
    parser.add_argument("--payload-preset")
    parser.add_argument("--feature")
    parser.add_argument("--sha256")
    parser.add_argument("--doom-wad", help="match artifacts that stage a Doom WAD with this basename")
    parser.add_argument("--doom-wad-sha256", help="match artifacts that stage a Doom WAD with this SHA-256")
    parser.add_argument("--max-compatibility", choices=("exact", "likely", "heuristic", "unsafe", "incompatible"),
                        help="exclude artifacts riskier than this compatibility label")
    parser.add_argument("--all", action="store_true", help="print all matches")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--recommendation-json", action="store_true",
                        help="print selected artifact plus filters, match count, and selection policy")
    args = parser.parse_args(argv)
    survey_context = apply_survey_filters(args)
    reality = reality_context(args.reality_json)

    if args.index:
        index = load_json(pathlib.Path(args.index))
    else:
        roots = args.release_root or [str(ROOT / "dist" / "releases")]
        index = build_index(roots)

    rows = [row for row in index.get("artifacts") or [] if matches(row, index, args)]
    if args.max_compatibility:
        max_rank = compatibility_rank(args.max_compatibility)
        rows = [row for row in rows if label_rank(row) <= max_rank]
    rows.sort(key=lambda row: (label_rank(row), -(row.get("release_mtime") or 0), row.get("payload_preset") or "", row.get("artifact") or ""))
    if not rows:
        raise SystemExit("find-artifact: no matching artifact")
    if args.recommendation_json:
        print(json.dumps(recommendation_document(index, rows, args, survey_context, reality), indent=2, sort_keys=True))
        return 0
    if args.json:
        payload = rows if args.all else rows[0]
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    if args.all:
        for row in rows:
            print_text(row, index)
            print()
    else:
        print_text(rows[0], index)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
