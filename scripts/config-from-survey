#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/config-from-survey [options] survey.json

Options:
  --format shell|json
  --write-config PATH
  --prefer-rshell builtin|socat|ssh|none|auto
  --prefer-runtime core-only|extract|no-residue|auto
  --reality-json PATH
  --allow-network-autorun
  --allow-external-writes
  --target-preset auto|NAME
  --payload-preset auto|NAME
EOF
}

format=shell
write_config=
prefer_rshell=auto
prefer_runtime=auto
reality_json=
allow_network_autorun=no
allow_external_writes=no
target_preset=auto
payload_preset=auto

while [ "$#" -gt 0 ]; do
    case "$1" in
        --format)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            format=$2
            shift 2
            ;;
        --format=*)
            format=${1#--format=}
            shift
            ;;
        --write-config)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            write_config=$2
            shift 2
            ;;
        --write-config=*)
            write_config=${1#--write-config=}
            shift
            ;;
        --prefer-rshell)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            prefer_rshell=$2
            shift 2
            ;;
        --prefer-rshell=*)
            prefer_rshell=${1#--prefer-rshell=}
            shift
            ;;
        --prefer-runtime)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            prefer_runtime=$2
            shift 2
            ;;
        --prefer-runtime=*)
            prefer_runtime=${1#--prefer-runtime=}
            shift
            ;;
        --reality-json)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            reality_json=$2
            shift 2
            ;;
        --reality-json=*)
            reality_json=${1#--reality-json=}
            shift
            ;;
        --allow-network-autorun)
            allow_network_autorun=yes
            shift
            ;;
        --allow-external-writes)
            allow_external_writes=yes
            shift
            ;;
        --target-preset)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            target_preset=$2
            shift 2
            ;;
        --target-preset=*)
            target_preset=${1#--target-preset=}
            shift
            ;;
        --payload-preset)
            [ "$#" -gt 1 ] || { usage; exit 2; }
            payload_preset=$2
            shift 2
            ;;
        --payload-preset=*)
            payload_preset=${1#--payload-preset=}
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            usage
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -eq 1 ] || { usage; exit 2; }
survey=$1

python3 - "$survey" "$format" "$write_config" "$prefer_rshell" "$prefer_runtime" "$reality_json" \
    "$allow_network_autorun" "$allow_external_writes" "$target_preset" "$payload_preset" <<'PY'
import json
import pathlib
import shlex
import sys

survey_path, fmt, write_config, prefer_rshell, prefer_runtime, reality_json, allow_network_autorun, allow_external_writes, target_preset_opt, payload_preset_opt = sys.argv[1:]

with open(survey_path, "r", encoding="utf-8") as fh:
    data = json.load(fh)

reality = None
if reality_json:
    with open(reality_json, "r", encoding="utf-8") as fh:
        reality = json.load(fh)

def first(*values, default="unknown"):
    for value in values:
        if value not in (None, ""):
            return value
    return default

def useful(value, allow_auto=False):
    if value in (None, ""):
        return ""
    value = str(value)
    if value == "unknown":
        return ""
    if value == "auto" and not allow_auto:
        return ""
    return value

def boolish(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.lower() in {"yes", "true", "1", "ok", "basic-ok", "present"}
    return bool(value)

def yesno(value):
    return "yes" if boolish(value) else "no"

def reality_checks():
    if not isinstance(reality, dict):
        return {}
    checks = reality.get("checks")
    if not isinstance(checks, list):
        return {}
    scanned = {item.get("name"): item for item in checks if isinstance(item, dict)}
    checks_by_name = reality.get("checks_by_name")
    if isinstance(checks_by_name, dict):
        indexed = {}
        for name, indexes in checks_by_name.items():
            if not isinstance(name, str):
                continue
            if isinstance(indexes, int):
                indexes = [indexes]
            if not isinstance(indexes, list):
                continue
            for index in indexes:
                if not isinstance(index, int) or index < 0 or index >= len(checks):
                    continue
                item = checks[index]
                if isinstance(item, dict) and item.get("name") == name:
                    indexed[name] = item
                    break
        if indexed:
            for name, item in scanned.items():
                indexed.setdefault(name, item)
            return indexed
    return scanned

reality_by_name = reality_checks()
reality_summary = reality.get("summary") if isinstance(reality, dict) and isinstance(reality.get("summary"), dict) else {}
reality_constraints = reality_summary.get("constraints") if isinstance(reality_summary.get("constraints"), dict) else {}

def reality_check(name):
    return reality_by_name.get(name) or {}

def reality_failed(name):
    item = reality_check(name)
    if not item or item.get("skipped"):
        return False
    if item.get("status") == "fail":
        return True
    if "ok" in item and item.get("ok") is False:
        return True
    if "available" in item and item.get("available") is False:
        return True
    return False

def reality_detected(name):
    item = reality_check(name)
    if item:
        return boolish(item.get("detected"))
    if name in reality_constraints:
        return boolish(reality_constraints.get(name))
    return False

def kernel_floor(release):
    release = str(release or "unknown")
    parts = release.split(".", 2)
    if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
        major = int(parts[0])
        minor = int(parts[1])
        if major < 3:
            return f"{major}.{minor}"
        if major == 3:
            return "3.x"
        if major == 4:
            return "4.x"
        return "current"
    return "unknown"

def arch_norm(machine):
    machine = str(machine or "unknown").lower()
    table = {
        "mips": "mips",
        "mips64": "mips",
        "mipsel": "mipsel",
        "mips64el": "mipsel",
        "armv7l": "armv7",
        "armv6l": "armv7",
        "aarch64": "aarch64",
        "x86_64": "x86_64",
        "amd64": "x86_64",
        "i386": "i386",
        "i486": "i386",
        "i586": "i386",
        "i686": "i386",
    }
    return table.get(machine, machine or "unknown")

def guess_libc():
    recs = data.get("recommendations", {})
    for key in ("libc_guess", "libc"):
        if recs.get(key):
            return recs[key]
    shell = data.get("shell_probe", {})
    hints = " ".join(str(x) for x in [
        shell.get("libc_hints", ""),
        data.get("libc", ""),
        data.get("os", ""),
        data.get("os_markers", {}),
    ]).lower()
    if "musl" in hints:
        return "musl"
    if "uclibc" in hints or "u-clibc" in hints:
        return "uclibc"
    if "glibc" in hints or "gnu libc" in hints:
        return "glibc"
    if any("openwrt" in str(x).lower() for x in [data.get("os_markers", {}), data.get("shell_probe", {}), data.get("uname", {})]):
        return "musl"
    return "unknown"

def dir_fact(path, key, default=None):
    for name in ("dirs", "writable_dirs"):
        entries = data.get(name, [])
        if isinstance(entries, list):
            for entry in entries:
                if isinstance(entry, dict) and entry.get("path") == path and key in entry:
                    return entry[key]
    shell_fs = data.get("shell_probe", {}).get("filesystem", {})
    if isinstance(shell_fs, dict):
        for entry in shell_fs.get("dirs", []):
            if isinstance(entry, dict) and entry.get("path") == path and key in entry:
                return entry[key]
    return default

def guess_preset(arch, libc, kernel, machine):
    if target_preset_opt != "auto":
        return target_preset_opt
    text = json.dumps(data, sort_keys=True).lower()
    if "gl.inet" in text or "glinet" in text or "mt7621" in text:
        return "glinet-mt7621-openwrt-musl"
    if arch == "mipsel" and libc == "musl" and "openwrt" in text:
        return "mipsel-linux-4.x-musl"
    if arch == "mipsel" and libc == "uclibc":
        return "mipsel-linux-2.6-uclibc-legacy"
    if arch in {"mips", "mipsel"} and kernel.startswith("2.4"):
        return ""
    return ""

recs = data.get("recommendations", {})
uname = data.get("uname", {})
machine = first(data.get("arch"), uname.get("machine"))
arch = useful(recs.get("target_arch_guess")) or arch_norm(machine)
kernel = first(data.get("kernel"), uname.get("release"))
kfloor = useful(recs.get("kernel_floor_guess")) or kernel_floor(kernel)
endian = useful(recs.get("endian_guess")) or useful(data.get("endianness")) or sys.byteorder
libc = useful(recs.get("libc_guess")) or guess_libc()
preset = target_preset_opt if target_preset_opt != "auto" else (useful(recs.get("target_preset_guess")) or guess_preset(arch, libc, kfloor, machine))
extract_dir = first(recs.get("recommended_extract_dir"), recs.get("runtime_root_recommendation"), default="none")
payload_possible = boolish(recs.get("payload_mode_possible", extract_dir != "none"))
tmp_write = boolish(recs.get("tmp_writable", dir_fact("/tmp", "writable", True)))
cwd_write = boolish(recs.get("cwd_writable", dir_fact(".", "writable", True)))
low_disk = boolish(recs.get("low_disk", False))
noexec_tmp = boolish(recs.get("noexec_tmp", dir_fact("/tmp", "noexec", False)))

warnings = []
if isinstance(recs.get("warnings"), list):
    warnings.extend(str(warning) for warning in recs["warnings"] if warning)
if libc == "unknown":
    warnings.append("unknown libc; keep the recommendation conservative")
if arch in {"unknown", ""}:
    warnings.append("unknown architecture; no hard target preset selected")
if low_disk or not cwd_write:
    warnings.append("low disk or non-writable cwd; prefer core-only or no-residue")
if noexec_tmp:
    warnings.append("/tmp appears noexec; avoid extracting there")

if reality_by_name:
    if reality_failed("runtime_root_writable"):
        payload_possible = False
        warnings.append("reality-test could not write the runtime root; prefer core-only")
    if reality_failed("temporary_file"):
        payload_possible = False
        warnings.append("reality-test could not create a temporary file; prefer core-only")
    if reality_failed("runtime_root_executable"):
        payload_possible = False
        noexec_tmp = noexec_tmp or reality_detected("tmp_noexec")
        warnings.append("reality-test could not execute from the runtime root; prefer core-only")
    if reality_failed("extract_core_payload"):
        payload_possible = False
        warnings.append("reality-test could not extract the core payload; prefer core-only")
    if reality_failed("exec_payload_busybox"):
        payload_possible = False
        warnings.append("reality-test could not execute payload BusyBox; prefer core-only")
    if reality_failed("spawn_sh"):
        warnings.append("reality-test could not spawn /bin/sh; avoid shell-oriented payload assumptions")
    if reality_failed("pty"):
        warnings.append("reality-test could not open a PTY; interactive tools may be degraded")
    if reality_detected("tmp_noexec"):
        noexec_tmp = True
        warnings.append("reality-test detected /tmp noexec; avoid extracting there")
    if reality_detected("rootfs_read_only"):
        warnings.append("reality-test detected read-only rootfs; avoid external writes")
    if reality_detected("procfs_partial"):
        warnings.append("reality-test detected partial/broken procfs; survey facts may be incomplete")
    if reality_failed("ptrace"):
        warnings.append("reality-test could not use ptrace; avoid gdbserver unless target policy is fixed")
    if reality_failed("dmesg_readable"):
        warnings.append("reality-test could not read dmesg; crash evidence may be limited")

compatibility_reasons = []
compatibility_label = "exact"
if arch and arch != "unknown":
    compatibility_reasons.append(f"arch inferred {arch}")
else:
    compatibility_label = "heuristic"
    compatibility_reasons.append("arch unknown")
if libc and libc != "unknown":
    compatibility_reasons.append(f"libc inferred {libc}")
else:
    compatibility_label = "heuristic"
    compatibility_reasons.append("libc unknown")
if kfloor and kfloor != "unknown":
    compatibility_reasons.append(f"kernel floor {kfloor}")
else:
    compatibility_label = "heuristic"
    compatibility_reasons.append("kernel floor unknown")
if preset:
    compatibility_reasons.append(f"target preset {preset}")
else:
    compatibility_label = "heuristic"
    compatibility_reasons.append("no target preset selected")
if low_disk:
    compatibility_label = "heuristic" if compatibility_label == "exact" else compatibility_label
    compatibility_reasons.append("low storage: prefer core-only")
if noexec_tmp:
    compatibility_label = "likely" if compatibility_label == "exact" else compatibility_label
    compatibility_reasons.append("/tmp noexec constraint")
if reality_by_name:
    compatibility_reasons.append("reality-test data applied")
if reality_detected("rootfs_read_only"):
    compatibility_label = "likely" if compatibility_label == "exact" else compatibility_label
    compatibility_reasons.append("read-only rootfs constraint")
if reality_detected("procfs_partial"):
    if compatibility_label in ("exact", "likely"):
        compatibility_label = "heuristic"
    compatibility_reasons.append("procfs partial/broken: survey evidence may be incomplete")
if reality_failed("ptrace"):
    compatibility_label = "likely" if compatibility_label == "exact" else compatibility_label
    compatibility_reasons.append("ptrace unavailable: avoid debugger payloads")
if reality_failed("runtime_root_executable"):
    compatibility_label = "unsafe"
    compatibility_reasons.append("runtime root execution failed in reality-test")
if reality_failed("extract_core_payload"):
    compatibility_label = "unsafe"
    compatibility_reasons.append("core payload extraction failed in reality-test")
if reality_failed("exec_payload_busybox"):
    compatibility_label = "unsafe"
    compatibility_reasons.append("payload BusyBox execution failed in reality-test")

if prefer_runtime != "auto":
    runtime_mode = prefer_runtime
elif not payload_possible or low_disk:
    runtime_mode = "core-only"
elif useful(recs.get("runtime_mode_recommendation")):
    runtime_mode = useful(recs.get("runtime_mode_recommendation"))
elif not cwd_write and tmp_write:
    runtime_mode = "no-residue"
else:
    runtime_mode = "extract"

runtime_root = useful(recs.get("runtime_root_recommendation")) or ("./.busierbox" if cwd_write else "/tmp/.busierbox")

if prefer_rshell != "auto":
    rshell_transport = prefer_rshell
elif useful(recs.get("rshell_transport_recommendation"), allow_auto=False):
    rshell_transport = useful(recs.get("rshell_transport_recommendation"))
elif runtime_mode == "core-only" and boolish(recs.get("builtin_tls_available", False)):
    rshell_transport = "builtin"
else:
    rshell_transport = "none"

if payload_preset_opt != "auto":
    payload_preset = payload_preset_opt
elif prefer_rshell != "auto" and rshell_transport == "builtin":
    payload_preset = "builtin-core-shell"
elif prefer_rshell != "auto" and rshell_transport == "socat":
    payload_preset = "socat-rescue"
elif prefer_rshell != "auto" and rshell_transport == "ssh":
    payload_preset = "ssh-operator"
elif useful(recs.get("payload_preset_recommendation")):
    payload_preset = useful(recs.get("payload_preset_recommendation"))
elif runtime_mode == "core-only":
    payload_preset = "survey-core"
elif rshell_transport == "builtin":
    payload_preset = "builtin-core-shell"
elif rshell_transport == "socat":
    payload_preset = "socat-rescue"
elif rshell_transport == "ssh":
    payload_preset = "ssh-operator"
else:
    payload_preset = "default"

cfg = {
    "BB_TARGET_PRESET": preset,
    "BB_TARGET_ARCH": arch,
    "BB_TARGET_ENDIAN": endian,
    "BB_TARGET_CPU": first(recs.get("target_cpu_guess"), "auto"),
    "BB_TARGET_LIBC": libc,
    "BB_KERNEL_FLOOR": kfloor,
    "BB_STATIC_POLICY": first(recs.get("static_policy"), "static-preferred"),
    "BB_PAYLOAD_PRESET": payload_preset,
    "BB_RUNTIME_MODE": runtime_mode,
    "BB_NORESIDUE_LEVEL": "best-effort",
    "BB_RUNTIME_ROOT": runtime_root,
    "BB_RUNTIME_ALLOW_EXTERNAL_WRITES": "yes" if allow_external_writes == "yes" else "no",
    "BB_ZERO_ARG_MODE": "rshell" if allow_network_autorun == "yes" and rshell_transport != "none" else "help",
    "BB_RSHELL_TRANSPORT": rshell_transport,
    "BB_RSHELL_ENCRYPTION": "tls",
}

result = {
    "schema": 1,
    "source": str(survey_path),
    "compatibility": {
        "schema": 1,
        "label": compatibility_label,
        "reasons": compatibility_reasons,
    },
    "recommendations": cfg,
    "warnings": warnings,
    "facts": {
        "arch": arch,
        "machine": machine,
        "kernel": kernel,
        "kernel_floor": kfloor,
        "libc": libc,
        "endianness": endian,
        "payload_possible": payload_possible,
        "recommended_extract_dir": extract_dir,
        "reality": {
            "source": str(reality_json) if reality_json else "",
            "checks_seen": sorted(reality_by_name.keys()),
            "runtime_root_writable": reality_check("runtime_root_writable").get("status", ""),
            "runtime_root_executable": reality_check("runtime_root_executable").get("status", ""),
            "temporary_file": reality_check("temporary_file").get("status", ""),
            "extract_core_payload": reality_check("extract_core_payload").get("status", ""),
            "exec_payload_busybox": reality_check("exec_payload_busybox").get("status", ""),
            "tmp_noexec_detected": reality_detected("tmp_noexec"),
            "rootfs_read_only_detected": reality_detected("rootfs_read_only"),
            "procfs_partial_detected": reality_detected("procfs_partial"),
            "ptrace": reality_check("ptrace").get("status", ""),
            "dmesg_readable": reality_check("dmesg_readable").get("status", ""),
            "operator_pass": reality_summary.get("operator_pass", ""),
            "operator_fail": reality_summary.get("operator_fail", ""),
            "operator_skipped": reality_summary.get("operator_skipped", ""),
        } if reality_json else {},
    },
}

def shell_quote(value):
    return shlex.quote(str(value))

def render_shell():
    lines = [
        "# BusierBox recommended config generated from survey JSON.",
        "# Defaults are conservative: no external writes and no network autorun.",
        f"# compatibility={compatibility_label}",
    ]
    for reason in compatibility_reasons:
        lines.append(f"# compatibility_reason: {reason}")
    for warning in warnings:
        lines.append(f"# WARNING: {warning}")
    for key in [
        "BB_TARGET_PRESET",
        "BB_TARGET_ARCH",
        "BB_TARGET_ENDIAN",
        "BB_TARGET_CPU",
        "BB_TARGET_LIBC",
        "BB_KERNEL_FLOOR",
        "BB_STATIC_POLICY",
        "BB_PAYLOAD_PRESET",
        "BB_RUNTIME_MODE",
        "BB_NORESIDUE_LEVEL",
        "BB_RUNTIME_ROOT",
        "BB_RUNTIME_ALLOW_EXTERNAL_WRITES",
        "BB_ZERO_ARG_MODE",
        "BB_RSHELL_TRANSPORT",
        "BB_RSHELL_ENCRYPTION",
    ]:
        lines.append(f'{key}={shell_quote(cfg[key])}')
    return "\n".join(lines) + "\n"

if fmt == "json":
    output = json.dumps(result, indent=2, sort_keys=True) + "\n"
elif fmt == "shell":
    output = render_shell()
else:
    raise SystemExit(f"unsupported --format: {fmt}")

if write_config:
    pathlib.Path(write_config).parent.mkdir(parents=True, exist_ok=True)
    pathlib.Path(write_config).write_text(output, encoding="utf-8")
else:
    sys.stdout.write(output)
PY
