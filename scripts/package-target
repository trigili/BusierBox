#!/bin/sh
set -eu

usage() {
    printf '%s\n' "usage: scripts/package-target TARGET|--config" >&2
}

target=${1:-}
[ -n "$target" ] || { usage; exit 2; }
requested_target=$target

PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-tgz}
BUILDROOT_OUTPUT_BASE=${BUILDROOT_OUTPUT_BASE:-buildroot/output}
VERIFY=${VERIFY:-0}
BB_BUILD_FULL=${BB_BUILD_FULL:-yes}
BB_BUILD_STAGER=${BB_BUILD_STAGER:-yes}
BB_BUILD_INTERNAL_CORE=${BB_BUILD_INTERNAL_CORE:-no}

case "$BB_BUILD_FULL:$BB_BUILD_STAGER:$BB_BUILD_INTERNAL_CORE" in
    yes:*|*:yes:*|*:*:yes) ;;
    *) die "no artifact outputs enabled" ;;
esac

if [ -f configs/busierbox.conf ]; then
    . ./configs/busierbox.conf
fi

BB_BUILD_FULL=${BB_BUILD_FULL:-yes}
BB_BUILD_STAGER=${BB_BUILD_STAGER:-yes}
BB_BUILD_INTERNAL_CORE=${BB_BUILD_INTERNAL_CORE:-no}

die() {
    printf '%s\n' "package-target: $*" >&2
    exit 1
}

sha256_write() {
    file=$1
    out=$2
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" >"$out"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" >"$out"
    else
        printf '%s\n' "sha256 unavailable  $file" >"$out"
    fi
}

payload_suffix() {
    if [ "$PAYLOAD_FORMAT" = tar ]; then
        printf '%s\n' tar
    else
        printf '%s\n' tar.gz
    fi
}

copy_payload_artifacts() {
    suffix=$(payload_suffix)
    [ -f "dist/payload.$suffix" ] || die "payload archive dist/payload.$suffix was not produced"
    cp "dist/payload.tar" "dist/payload-$target.tar"
    [ -f dist/payload.tar.sha256 ] && cp dist/payload.tar.sha256 "dist/payload-$target.tar.sha256"
    if [ -f dist/payload.tar.gz ]; then
        cp dist/payload.tar.gz "dist/payload-$target.tar.gz"
        [ -f dist/payload.tar.gz.sha256 ] && cp dist/payload.tar.gz.sha256 "dist/payload-$target.tar.gz.sha256"
    fi
}

find_cross_cc() {
    out_dir="$BUILDROOT_OUTPUT_BASE/$target"
    host_bin="$out_dir/host/bin"
    [ -d "$host_bin" ] || return 1
    find "$host_bin" \( -type f -o -type l \) -name '*-gcc' ! -name gcc | sort | sed -n '1p'
}

bool01() {
    case "$1" in
        yes|1|true|on) printf 1 ;;
        *) printf 0 ;;
    esac
}

if [ "$target" = --config ] || [ "$target" = config ]; then
    resolved=$(scripts/resolve-target --config 2>&1) || die "$resolved"
else
    if ! resolved=$(scripts/resolve-target "$target" 2>&1); then
        resolve_error=$resolved
        if active=$(scripts/resolve-target --config 2>/dev/null); then
            eval "$active"
            if [ "${TARGET_NAME:-}" = "$target" ]; then
                resolved=$active
            else
                die "$resolve_error"
            fi
        else
            die "$resolve_error"
        fi
    fi
fi
eval "$resolved"
target=$TARGET_NAME

[ "$TARGET_STATUS" = supported ] || die "target $target is $TARGET_STATUS: $TARGET_NOTES"

mkdir -p dist dist/internal

core="dist/internal/busierbox-$target.core"
full_core="dist/internal/busierbox-$target.full-core"
artifact="dist/busierbox-$target-full"
compat_artifact="dist/busierbox-$target"
stager_artifact="dist/busierbox-$target-stager"
suffix=$(payload_suffix)
payload="dist/payload-$target.$suffix"

if [ "$target" = native ]; then
    scripts/build-busybox
    TARGET="$target" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" scripts/build-payload
    copy_payload_artifacts
    OUT="$full_core" ARTIFACT_TIER=full ADVERTISE_PAYLOAD_TOOLS=1 scripts/build-native
else
    if [ "$TARGET_SOURCE" = config ]; then
        gen_output=$(scripts/gen-buildroot-defconfig --from-config)
    else
        gen_output=$(scripts/gen-buildroot-defconfig "$requested_target")
    fi
    printf '%s\n' "$gen_output"
    eval "$(printf '%s\n' "$gen_output" | sed -n 's/^\(BUILDROOT_DEFCONFIG\|PAYLOAD_PROFILE\)=/GEN_\1=/p')"
    TARGET_PROFILE_FILE=${GEN_PAYLOAD_PROFILE:-$TARGET_PROFILE_FILE}
    TARGET_BUILDROOT_DEFCONFIG=${GEN_BUILDROOT_DEFCONFIG:-$TARGET_BUILDROOT_DEFCONFIG}
    [ -n "$TARGET_PROFILE_FILE" ] && [ -f "$TARGET_PROFILE_FILE" ] || die "generated profile missing for $target"
    [ -n "$TARGET_BUILDROOT_DEFCONFIG" ] && [ -f "$TARGET_BUILDROOT_DEFCONFIG" ] || die "generated Buildroot defconfig missing for $target"
    TARGET="$target" TARGET_PROFILE_FILE="$TARGET_PROFILE_FILE" TARGET_BUILDROOT_DEFCONFIG="$TARGET_BUILDROOT_DEFCONFIG" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" BUILDROOT_OUTPUT_BASE="$BUILDROOT_OUTPUT_BASE" scripts/buildroot-build-payload
    copy_payload_artifacts
    cross_cc=$(find_cross_cc || true)
    if [ -z "$cross_cc" ]; then
        die "target $target payload support exists, but BusierBox core cross-compile is not wired yet"
    fi
    CC="$cross_cc" OUT="$full_core" ARTIFACT_TIER=full ADVERTISE_PAYLOAD_TOOLS=1 scripts/build-native
fi

scripts/check-payload-tar "dist/payload-$target.tar"
if [ "$BB_BUILD_FULL" = yes ]; then
    scripts/embed-payload "$full_core" "$payload" "$artifact"
    rm -f "$full_core"
    sha256_write "$artifact" "$artifact.sha256"
    cp "$artifact" "$compat_artifact"
    cp "$artifact.sha256" "$compat_artifact.sha256"
else
    rm -f "$full_core"
fi

if [ "$BB_BUILD_STAGER" = yes ]; then
    stager_survey=$(bool01 "${BB_STAGER_INCLUDE_SURVEY:-yes}")
    stager_doctor=$(bool01 "${BB_STAGER_INCLUDE_DOCTOR:-yes}")
    stager_config_info=$(bool01 "${BB_STAGER_INCLUDE_CONFIG_INFO:-yes}")
    stager_extract=$(bool01 "${BB_STAGER_INCLUDE_EXTRACT:-yes}")
    stager_fetch_full=$(bool01 "${BB_STAGER_FETCH_FULL:-yes}")
    if [ "$target" = native ]; then
        OUT="$stager_artifact" ARTIFACT_TIER=stager ADVERTISE_PAYLOAD_TOOLS=0 BB_ENABLE_SURVEY="$stager_survey" BB_ENABLE_DOCTOR="$stager_doctor" BB_ENABLE_CONFIG_INFO="$stager_config_info" BB_ENABLE_EXTRACT="$stager_extract" BB_ENABLE_FETCH_FULL="$stager_fetch_full" BB_STAGER_CALLBACK_ENABLE="${BB_STAGER_CALLBACK_ENABLE:-no}" BB_STAGER_CALLBACK_HOST="${BB_STAGER_CALLBACK_HOST:-}" BB_STAGER_CALLBACK_PORT="${BB_STAGER_CALLBACK_PORT:-}" BB_STAGER_CALLBACK_SHELL="${BB_STAGER_CALLBACK_SHELL:-sh}" scripts/build-native
    else
        CC="$cross_cc" OUT="$stager_artifact" ARTIFACT_TIER=stager ADVERTISE_PAYLOAD_TOOLS=0 BB_ENABLE_SURVEY="$stager_survey" BB_ENABLE_DOCTOR="$stager_doctor" BB_ENABLE_CONFIG_INFO="$stager_config_info" BB_ENABLE_EXTRACT="$stager_extract" BB_ENABLE_FETCH_FULL="$stager_fetch_full" BB_STAGER_CALLBACK_ENABLE="${BB_STAGER_CALLBACK_ENABLE:-no}" BB_STAGER_CALLBACK_HOST="${BB_STAGER_CALLBACK_HOST:-}" BB_STAGER_CALLBACK_PORT="${BB_STAGER_CALLBACK_PORT:-}" BB_STAGER_CALLBACK_SHELL="${BB_STAGER_CALLBACK_SHELL:-sh}" scripts/build-native
    fi
    sha256_write "$stager_artifact" "$stager_artifact.sha256"
fi

if [ "$BB_BUILD_INTERNAL_CORE" = yes ]; then
    if [ "$target" = native ]; then
        OUT="$core" ARTIFACT_TIER=core ADVERTISE_PAYLOAD_TOOLS=0 scripts/build-native
    else
        CC="$cross_cc" OUT="$core" ARTIFACT_TIER=core ADVERTISE_PAYLOAD_TOOLS=0 scripts/build-native
    fi
fi

if [ "$VERIFY" = 1 ] && [ "$BB_BUILD_FULL" = yes ]; then
    scripts/verify-artifact "$artifact"
fi

if [ "$target" = native ] && [ "$BB_BUILD_FULL" = yes ]; then
    cp "$artifact" dist/busierbox-full
    cp "$artifact.sha256" dist/busierbox-full.sha256
    cp "$artifact" dist/busierbox
    cp "$artifact.sha256" dist/busierbox.sha256
fi

if [ "$BB_BUILD_FULL" = yes ]; then
    primary_output=$artifact
elif [ "$BB_BUILD_STAGER" = yes ]; then
    primary_output=$stager_artifact
else
    primary_output=$core
fi

printf '%s\n' "PASS $target -> $primary_output"
