#!/bin/sh
set -eu

usage() {
    printf '%s\n' "usage: scripts/package-target TARGET|--config" >&2
}

target=${1:-}
[ -n "$target" ] || { usage; exit 2; }
requested_target=$target

capture_env_override() {
    name=$1
    eval "case \"\${$name+x}\" in x) ${name}_ENV_SET=1; ${name}_ENV_VALUE=\${$name} ;; *) ${name}_ENV_SET=0; ${name}_ENV_VALUE= ;; esac"
}

restore_env_override() {
    name=$1
    eval "if [ \"\$${name}_ENV_SET\" = 1 ]; then $name=\$${name}_ENV_VALUE; fi"
}

die() {
    printf '%s\n' "package-target: $*" >&2
    exit 1
}

for _name in PAYLOAD_FORMAT BB_BUILD_FULL BB_BUILD_INTERNAL_CORE \
    BUSIERBOX_BUILD_TIMESTAMP BUSIERBOX_GIT_COMMIT \
    BB_TARGET_PRESET BB_PAYLOAD_PRESET \
    BB_RUNTIME_MODE BB_RUNTIME_ROOT BB_RUNTIME_ALLOW_FALLBACK_ROOT BB_RUNTIME_FALLBACK_ROOT \
    BB_ZERO_ARG_MODE BB_ZERO_ARG_LOG_MODE BB_ZERO_ARG_CUSTOM_COMMAND \
    BB_RSHELL_TRANSPORT BB_RSHELL_MODE BB_RSHELL_ENCRYPTION BB_RSHELL_ALLOW_PLAINTEXT \
    BB_RSHELL_AUTHKEYS_MODE BB_RSHELL_RUN_MODE BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING \
    BB_RSHELL_SOCAT_PORT BB_RSHELL_SHELL_PROVIDER BB_RSHELL_CUSTOM_SHELL \
    BB_RSHELL_RETRY_COUNT BB_RSHELL_RETRY_INTERVAL_SEC BB_RSHELL_RETRY_JITTER_PCT \
    BB_RSHELL_RETRY_BACKOFF BB_RSHELL_RETRY_MAX_INTERVAL_SEC BB_BUILTIN_TLS_ENABLE \
    WOLFSSL_CFLAGS WOLFSSL_LIBS \
    BB_AUTORUN_GUARD_ENABLE BB_AUTORUN_GUARD_PATH BB_AUTORUN_REENTRY_ACTION \
    BB_AUTORUN_STALE_LOCK_POLICY BB_OPERATOR_REMOTE_FORWARD_PORT \
    BB_OPERATOR_TARGET_DROPBEAR_PORT BB_OPERATOR_SERVER_HOST \
    BB_OPERATOR_SERVER_USER BB_OPERATOR_SERVER_SSH_PORT \
    BB_OPERATOR_TARGET_BIND_HOST BB_OPERATOR_KNOWN_HOSTS_POLICY \
    BB_OPERATOR_DBCLIENT_IDENTITY_FILE BB_DOTFILES_ENABLE \
    BB_DOTFILE_ZSH_MODE BB_DOTFILE_ZSH_USER_FILE \
    BB_DOTFILE_TMUX_MODE BB_DOTFILE_TMUX_USER_FILE \
    BB_DOTFILE_GDB_MODE BB_DOTFILE_GDB_USER_FILE \
    BB_DOTFILE_PROFILE_MODE BB_DOTFILE_PROFILE_USER_FILE; do
    capture_env_override "$_name"
done

BUILDROOT_OUTPUT_BASE=${BUILDROOT_OUTPUT_BASE:-buildroot/output}
VERIFY=${VERIFY:-0}
BB_BUILD_FULL=${BB_BUILD_FULL:-yes}
BB_BUILD_INTERNAL_CORE=${BB_BUILD_INTERNAL_CORE:-no}
config=${BUSIERBOX_CONFIG:-configs/busierbox.conf}

case "$BB_BUILD_FULL:$BB_BUILD_INTERNAL_CORE" in
    yes:*|*:yes) ;;
    *) die "no artifact outputs enabled" ;;
esac

if [ -f "$config" ]; then
    . "$config"
fi

for _name in PAYLOAD_FORMAT BB_BUILD_FULL BB_BUILD_INTERNAL_CORE \
    BUSIERBOX_BUILD_TIMESTAMP BUSIERBOX_GIT_COMMIT \
    BB_TARGET_PRESET BB_PAYLOAD_PRESET \
    BB_RUNTIME_MODE BB_RUNTIME_ROOT BB_RUNTIME_ALLOW_FALLBACK_ROOT BB_RUNTIME_FALLBACK_ROOT \
    BB_ZERO_ARG_MODE BB_ZERO_ARG_LOG_MODE BB_ZERO_ARG_CUSTOM_COMMAND \
    BB_RSHELL_TRANSPORT BB_RSHELL_MODE BB_RSHELL_ENCRYPTION BB_RSHELL_ALLOW_PLAINTEXT \
    BB_RSHELL_AUTHKEYS_MODE BB_RSHELL_RUN_MODE BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING \
    BB_RSHELL_SOCAT_PORT BB_RSHELL_SHELL_PROVIDER BB_RSHELL_CUSTOM_SHELL \
    BB_RSHELL_RETRY_COUNT BB_RSHELL_RETRY_INTERVAL_SEC BB_RSHELL_RETRY_JITTER_PCT \
    BB_RSHELL_RETRY_BACKOFF BB_RSHELL_RETRY_MAX_INTERVAL_SEC BB_BUILTIN_TLS_ENABLE \
    WOLFSSL_CFLAGS WOLFSSL_LIBS \
    BB_AUTORUN_GUARD_ENABLE BB_AUTORUN_GUARD_PATH BB_AUTORUN_REENTRY_ACTION \
    BB_AUTORUN_STALE_LOCK_POLICY BB_OPERATOR_REMOTE_FORWARD_PORT \
    BB_OPERATOR_TARGET_DROPBEAR_PORT BB_OPERATOR_SERVER_HOST \
    BB_OPERATOR_SERVER_USER BB_OPERATOR_SERVER_SSH_PORT \
    BB_OPERATOR_TARGET_BIND_HOST BB_OPERATOR_KNOWN_HOSTS_POLICY \
    BB_OPERATOR_DBCLIENT_IDENTITY_FILE BB_DOTFILES_ENABLE \
    BB_DOTFILE_ZSH_MODE BB_DOTFILE_ZSH_USER_FILE \
    BB_DOTFILE_TMUX_MODE BB_DOTFILE_TMUX_USER_FILE \
    BB_DOTFILE_GDB_MODE BB_DOTFILE_GDB_USER_FILE \
    BB_DOTFILE_PROFILE_MODE BB_DOTFILE_PROFILE_USER_FILE; do
    restore_env_override "$_name"
done
unset _name

# env > config file BB_PAYLOAD_FORMAT > default
PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-${BB_PAYLOAD_FORMAT:-tgz}}
BB_PAYLOAD_PRESET=${BB_PAYLOAD_PRESET:-default}

BB_BUILD_FULL=${BB_BUILD_FULL:-yes}
BB_BUILD_INTERNAL_CORE=${BB_BUILD_INTERNAL_CORE:-no}
BB_RUNTIME_MODE=${BB_RUNTIME_MODE:-extract}
BB_RUNTIME_ROOT=${BB_RUNTIME_ROOT:-./.busierbox}
BB_RUNTIME_ALLOW_FALLBACK_ROOT=${BB_RUNTIME_ALLOW_FALLBACK_ROOT:-no}
BB_RUNTIME_FALLBACK_ROOT=${BB_RUNTIME_FALLBACK_ROOT:-/tmp/.busierbox}
BB_ZERO_ARG_MODE=${BB_ZERO_ARG_MODE:-${BB_FULL_ZERO_ARG_MODE:-help}}
case "$BB_ZERO_ARG_MODE" in menu|doctor) BB_ZERO_ARG_MODE=help ;; esac
BB_ZERO_ARG_LOG_MODE=${BB_ZERO_ARG_LOG_MODE:-quiet}
BB_ZERO_ARG_CUSTOM_COMMAND=${BB_ZERO_ARG_CUSTOM_COMMAND:-}
BB_RSHELL_TRANSPORT=${BB_RSHELL_TRANSPORT:-${BB_RSHELL_MODE:-ssh}}
BB_RSHELL_MODE=$BB_RSHELL_TRANSPORT
BB_RSHELL_ENCRYPTION=${BB_RSHELL_ENCRYPTION:-tls}
BB_RSHELL_ALLOW_PLAINTEXT=${BB_RSHELL_ALLOW_PLAINTEXT:-no}
BB_RSHELL_AUTHKEYS_MODE=${BB_RSHELL_AUTHKEYS_MODE:-disabled}
BB_RSHELL_RUN_MODE=${BB_RSHELL_RUN_MODE:-auto}
BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING=${BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING:-no}
BB_RSHELL_SOCAT_PORT=${BB_RSHELL_SOCAT_PORT:-22203}
BB_RSHELL_SHELL_PROVIDER=${BB_RSHELL_SHELL_PROVIDER:-auto}
BB_RSHELL_CUSTOM_SHELL=${BB_RSHELL_CUSTOM_SHELL:-}
BB_RSHELL_RETRY_COUNT=${BB_RSHELL_RETRY_COUNT:-1}
BB_RSHELL_RETRY_INTERVAL_SEC=${BB_RSHELL_RETRY_INTERVAL_SEC:-5}
BB_RSHELL_RETRY_JITTER_PCT=${BB_RSHELL_RETRY_JITTER_PCT:-20}
BB_RSHELL_RETRY_BACKOFF=${BB_RSHELL_RETRY_BACKOFF:-none}
BB_RSHELL_RETRY_MAX_INTERVAL_SEC=${BB_RSHELL_RETRY_MAX_INTERVAL_SEC:-300}
if [ -z "${BB_BUILTIN_TLS_ENABLE:-}" ]; then
    [ "$BB_RSHELL_TRANSPORT" = builtin ] && BB_BUILTIN_TLS_ENABLE=yes || BB_BUILTIN_TLS_ENABLE=no
fi
BB_AUTORUN_GUARD_ENABLE=${BB_AUTORUN_GUARD_ENABLE:-yes}
if [ "${BB_AUTORUN_GUARD_PATH:-/tmp/busierbox-autorun}" = "/tmp/busierbox-autorun" ]; then
    BB_AUTORUN_GUARD_PATH="${BB_RUNTIME_ROOT}/run"
fi
: "${BB_AUTORUN_GUARD_PATH:=${BB_RUNTIME_ROOT}/run}"
BB_AUTORUN_REENTRY_ACTION=${BB_AUTORUN_REENTRY_ACTION:-status}
BB_AUTORUN_STALE_LOCK_POLICY=${BB_AUTORUN_STALE_LOCK_POLICY:-recover}
BB_OPERATOR_REMOTE_FORWARD_PORT=${BB_OPERATOR_REMOTE_FORWARD_PORT:-2200}
BB_OPERATOR_TARGET_DROPBEAR_PORT=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-2222}
BB_OPERATOR_SERVER_HOST=${BB_OPERATOR_SERVER_HOST:-}
BB_OPERATOR_SERVER_USER=${BB_OPERATOR_SERVER_USER:-operator}
BB_OPERATOR_SERVER_SSH_PORT=${BB_OPERATOR_SERVER_SSH_PORT:-22}
BB_OPERATOR_TARGET_BIND_HOST=${BB_OPERATOR_TARGET_BIND_HOST:-127.0.0.1}
BB_OPERATOR_KNOWN_HOSTS_POLICY=${BB_OPERATOR_KNOWN_HOSTS_POLICY:-off}
BB_OPERATOR_DBCLIENT_IDENTITY_FILE=${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}
BB_DOTFILES_ENABLE=${BB_DOTFILES_ENABLE:-yes}
BB_DOTFILE_ZSH_MODE=${BB_DOTFILE_ZSH_MODE:-default}
BB_DOTFILE_ZSH_USER_FILE=${BB_DOTFILE_ZSH_USER_FILE:-}
BB_DOTFILE_TMUX_MODE=${BB_DOTFILE_TMUX_MODE:-default}
BB_DOTFILE_TMUX_USER_FILE=${BB_DOTFILE_TMUX_USER_FILE:-}
BB_DOTFILE_GDB_MODE=${BB_DOTFILE_GDB_MODE:-default}
BB_DOTFILE_GDB_USER_FILE=${BB_DOTFILE_GDB_USER_FILE:-}
BB_DOTFILE_PROFILE_MODE=${BB_DOTFILE_PROFILE_MODE:-default}
BB_DOTFILE_PROFILE_USER_FILE=${BB_DOTFILE_PROFILE_USER_FILE:-}

sha256_write() {
    file=$1
    out=$2
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" >"$out"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" >"$out"
    else
        printf '%s\n' "sha256 unavailable  $file" >"$out"
    fi
}

payload_suffix() {
    if [ "$PAYLOAD_FORMAT" = tar ]; then
        printf '%s\n' tar
    else
        printf '%s\n' tar.gz
    fi
}

copy_payload_artifacts() {
    suffix=$(payload_suffix)
    [ -f "dist/payload.$suffix" ] || die "payload archive dist/payload.$suffix was not produced"
    cp "dist/payload.tar" "dist/payload-$target.tar"
    [ -f dist/payload.tar.sha256 ] && cp dist/payload.tar.sha256 "dist/payload-$target.tar.sha256"
    if [ -f dist/payload.tar.gz ]; then
        cp dist/payload.tar.gz "dist/payload-$target.tar.gz"
        [ -f dist/payload.tar.gz.sha256 ] && cp dist/payload.tar.gz.sha256 "dist/payload-$target.tar.gz.sha256"
    fi
}

find_cross_cc() {
    out_dir="$BUILDROOT_OUTPUT_BASE/$target"
    host_bin="$out_dir/host/bin"
    [ -d "$host_bin" ] || return 1
    find "$host_bin" \( -type f -o -type l \) -name '*-gcc' ! -name gcc | sort | sed -n '1p'
}

bool01() {
    case "$1" in
        yes|1|true|on) printf 1 ;;
        *) printf 0 ;;
    esac
}

if [ "$target" = --config ] || [ "$target" = config ]; then
    resolved=$(scripts/resolve-target --config 2>&1) || die "$resolved"
else
    if ! resolved=$(scripts/resolve-target "$target" 2>&1); then
        resolve_error=$resolved
        if active=$(scripts/resolve-target --config 2>/dev/null); then
            eval "$active"
            if [ "${TARGET_NAME:-}" = "$target" ]; then
                resolved=$active
            else
                die "$resolve_error"
            fi
        else
            die "$resolve_error"
        fi
    fi
fi
eval "$resolved"
target=$TARGET_NAME
manifest_target_preset=${BB_TARGET_PRESET:-$requested_target}
[ "$manifest_target_preset" = --config ] && manifest_target_preset=${BB_TARGET_PRESET:-config}

[ "$TARGET_STATUS" = blank ] && die "${TARGET_NOTES:-default is a blank target configuration; choose native or a concrete target before building.}"
[ "$TARGET_STATUS" = supported ] || die "target ${target:-$requested_target} is $TARGET_STATUS: $TARGET_NOTES"

mkdir -p dist dist/internal
rm -f "dist/busierbox-$target-stager" "dist/busierbox-$target-stager.sha256"

core="dist/internal/busierbox-$target.core"
full_core="dist/internal/busierbox-$target.full-core"
artifact="dist/busierbox-$target-full"
compat_artifact="dist/busierbox-$target"
suffix=$(payload_suffix)
payload="dist/payload-$target.$suffix"

if [ "$target" = native ]; then
    scripts/build-busybox
    TARGET="$target" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" \
        BB_RUNTIME_MODE="$BB_RUNTIME_MODE" \
        BB_DOTFILES_ENABLE="$BB_DOTFILES_ENABLE" \
        BB_DOTFILE_ZSH_MODE="$BB_DOTFILE_ZSH_MODE" \
        BB_DOTFILE_ZSH_USER_FILE="$BB_DOTFILE_ZSH_USER_FILE" \
        BB_DOTFILE_TMUX_MODE="$BB_DOTFILE_TMUX_MODE" \
        BB_DOTFILE_TMUX_USER_FILE="$BB_DOTFILE_TMUX_USER_FILE" \
        BB_DOTFILE_GDB_MODE="$BB_DOTFILE_GDB_MODE" \
        BB_DOTFILE_GDB_USER_FILE="$BB_DOTFILE_GDB_USER_FILE" \
        BB_DOTFILE_PROFILE_MODE="$BB_DOTFILE_PROFILE_MODE" \
        BB_DOTFILE_PROFILE_USER_FILE="$BB_DOTFILE_PROFILE_USER_FILE" \
        scripts/build-payload
    copy_payload_artifacts
    OUT="$full_core" ARTIFACT_TIER=full ADVERTISE_PAYLOAD_TOOLS=1 \
        BB_TARGET_PRESET="$manifest_target_preset" \
        BB_TARGET_NAME="$TARGET_NAME" \
        BB_TARGET_ARCH="$TARGET_ARCH" \
        BB_TARGET_ENDIAN="$TARGET_ENDIAN" \
        BB_TARGET_CPU="$TARGET_CPU" \
        BB_TARGET_ABI="$TARGET_ABI" \
        BB_TARGET_LIBC="$TARGET_LIBC" \
        BB_KERNEL_FLOOR="$TARGET_KERNEL_FLOOR" \
        BB_STATIC_POLICY="$TARGET_STATIC_POLICY" \
        BB_PAYLOAD_PRESET="$BB_PAYLOAD_PRESET" \
        BB_RUNTIME_MODE="$BB_RUNTIME_MODE" \
        BB_RUNTIME_ROOT="$BB_RUNTIME_ROOT" \
        BB_RUNTIME_ALLOW_FALLBACK_ROOT="$BB_RUNTIME_ALLOW_FALLBACK_ROOT" \
        BB_RUNTIME_FALLBACK_ROOT="$BB_RUNTIME_FALLBACK_ROOT" \
        BB_ZERO_ARG_MODE="$BB_ZERO_ARG_MODE" \
        BB_ZERO_ARG_LOG_MODE="$BB_ZERO_ARG_LOG_MODE" \
        BB_ZERO_ARG_CUSTOM_COMMAND="$BB_ZERO_ARG_CUSTOM_COMMAND" \
        BB_RSHELL_TRANSPORT="$BB_RSHELL_TRANSPORT" \
        BB_RSHELL_ENCRYPTION="$BB_RSHELL_ENCRYPTION" \
        BB_RSHELL_ALLOW_PLAINTEXT="$BB_RSHELL_ALLOW_PLAINTEXT" \
        BB_RSHELL_AUTHKEYS_MODE="$BB_RSHELL_AUTHKEYS_MODE" \
        BB_RSHELL_RUN_MODE="$BB_RSHELL_RUN_MODE" \
        BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING="$BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING" \
        BB_RSHELL_SOCAT_PORT="$BB_RSHELL_SOCAT_PORT" \
        BB_RSHELL_SHELL_PROVIDER="$BB_RSHELL_SHELL_PROVIDER" \
        BB_RSHELL_CUSTOM_SHELL="$BB_RSHELL_CUSTOM_SHELL" \
        BB_RSHELL_RETRY_COUNT="$BB_RSHELL_RETRY_COUNT" \
        BB_RSHELL_RETRY_INTERVAL_SEC="$BB_RSHELL_RETRY_INTERVAL_SEC" \
        BB_RSHELL_RETRY_JITTER_PCT="$BB_RSHELL_RETRY_JITTER_PCT" \
        BB_RSHELL_RETRY_BACKOFF="$BB_RSHELL_RETRY_BACKOFF" \
        BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" \
        BB_BUILTIN_TLS_ENABLE="$BB_BUILTIN_TLS_ENABLE" \
        WOLFSSL_CFLAGS="${WOLFSSL_CFLAGS:-}" \
        WOLFSSL_LIBS="${WOLFSSL_LIBS:-}" \
        BB_AUTORUN_GUARD_ENABLE="$BB_AUTORUN_GUARD_ENABLE" \
        BB_AUTORUN_GUARD_PATH="$BB_AUTORUN_GUARD_PATH" \
        BB_AUTORUN_REENTRY_ACTION="$BB_AUTORUN_REENTRY_ACTION" \
        BB_AUTORUN_STALE_LOCK_POLICY="$BB_AUTORUN_STALE_LOCK_POLICY" \
        BB_OPERATOR_REMOTE_FORWARD_PORT="$BB_OPERATOR_REMOTE_FORWARD_PORT" \
        BB_OPERATOR_TARGET_DROPBEAR_PORT="$BB_OPERATOR_TARGET_DROPBEAR_PORT" \
        BB_OPERATOR_SERVER_HOST="$BB_OPERATOR_SERVER_HOST" \
        BB_OPERATOR_SERVER_USER="$BB_OPERATOR_SERVER_USER" \
        BB_OPERATOR_SERVER_SSH_PORT="$BB_OPERATOR_SERVER_SSH_PORT" \
        BB_OPERATOR_TARGET_BIND_HOST="$BB_OPERATOR_TARGET_BIND_HOST" \
        BB_OPERATOR_KNOWN_HOSTS_POLICY="$BB_OPERATOR_KNOWN_HOSTS_POLICY" \
        BB_DOTFILES_ENABLE="$BB_DOTFILES_ENABLE" \
        BB_DOTFILE_ZSH_MODE="$BB_DOTFILE_ZSH_MODE" \
        BB_DOTFILE_TMUX_MODE="$BB_DOTFILE_TMUX_MODE" \
        BB_DOTFILE_GDB_MODE="$BB_DOTFILE_GDB_MODE" \
        BB_DOTFILE_PROFILE_MODE="$BB_DOTFILE_PROFILE_MODE" \
        BB_USER_OVERLAY_ENABLE="${BB_USER_OVERLAY_ENABLE:-no}" \
        BB_USER_OVERLAY_ROOT="${BB_USER_OVERLAY_ROOT:-./overlay}" \
        BB_USER_OVERLAY_ALLOW_OVERRIDE="${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}" \
        scripts/build-native
else
    if [ "$TARGET_SOURCE" = config ]; then
        gen_output=$(scripts/gen-buildroot-defconfig --from-config "$config")
    else
        gen_output=$(scripts/gen-buildroot-defconfig "$requested_target")
    fi
    printf '%s\n' "$gen_output"
    eval "$(printf '%s\n' "$gen_output" | sed -n 's/^\(BUILDROOT_DEFCONFIG\|PAYLOAD_PROFILE\)=/GEN_\1=/p')"
    TARGET_PROFILE_FILE=${GEN_PAYLOAD_PROFILE:-$TARGET_PROFILE_FILE}
    TARGET_BUILDROOT_DEFCONFIG=${GEN_BUILDROOT_DEFCONFIG:-$TARGET_BUILDROOT_DEFCONFIG}
    [ -n "$TARGET_PROFILE_FILE" ] && [ -f "$TARGET_PROFILE_FILE" ] || die "generated profile missing for $target"
    [ -n "$TARGET_BUILDROOT_DEFCONFIG" ] && [ -f "$TARGET_BUILDROOT_DEFCONFIG" ] || die "generated Buildroot defconfig missing for $target"
    TARGET="$target" TARGET_PROFILE_FILE="$TARGET_PROFILE_FILE" TARGET_BUILDROOT_DEFCONFIG="$TARGET_BUILDROOT_DEFCONFIG" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" BUILDROOT_OUTPUT_BASE="$BUILDROOT_OUTPUT_BASE" \
        BB_RUNTIME_MODE="$BB_RUNTIME_MODE" \
        BB_OPERATOR_DBCLIENT_IDENTITY_FILE="${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}" \
        BB_DOTFILES_ENABLE="$BB_DOTFILES_ENABLE" \
        BB_DOTFILE_ZSH_MODE="$BB_DOTFILE_ZSH_MODE" \
        BB_DOTFILE_ZSH_USER_FILE="$BB_DOTFILE_ZSH_USER_FILE" \
        BB_DOTFILE_TMUX_MODE="$BB_DOTFILE_TMUX_MODE" \
        BB_DOTFILE_TMUX_USER_FILE="$BB_DOTFILE_TMUX_USER_FILE" \
        BB_DOTFILE_GDB_MODE="$BB_DOTFILE_GDB_MODE" \
        BB_DOTFILE_GDB_USER_FILE="$BB_DOTFILE_GDB_USER_FILE" \
        BB_DOTFILE_PROFILE_MODE="$BB_DOTFILE_PROFILE_MODE" \
        BB_DOTFILE_PROFILE_USER_FILE="$BB_DOTFILE_PROFILE_USER_FILE" \
        scripts/buildroot-build-payload
    copy_payload_artifacts
    cross_cc=$(find_cross_cc || true)
    if [ -z "$cross_cc" ]; then
        die "target $target payload support exists, but BusierBox core cross-compile is not wired yet"
    fi
    # Auto-detect wolfSSL from the buildroot staging sysroot when transport=builtin
    # and the user has not supplied an explicit override.  gen-buildroot-defconfig
    # emits BR2_PACKAGE_WOLFSSL=y so buildroot cross-compiles it for us; after
    # the payload build the headers and library live under staging/.
    if [ "$BB_BUILTIN_TLS_ENABLE" = yes ] && [ -z "${WOLFSSL_CFLAGS:-}" ]; then
        _staging="$BUILDROOT_OUTPUT_BASE/$target/staging"
        if [ -f "$_staging/usr/include/wolfssl/ssl.h" ]; then
            WOLFSSL_CFLAGS="-I$_staging/usr/include"
            WOLFSSL_LIBS="-L$_staging/usr/lib -lwolfssl"
            printf '%s\n' "package-target: wolfSSL auto-detected in buildroot staging ($target)"
        fi
    fi
    # Preflight: probe wolfSSL with the cross compiler before the core build.
    # pkg-config may return empty cflags that work for host gcc but not for a
    # cross compiler whose sysroot does not include /usr/include.
    if [ "$BB_BUILTIN_TLS_ENABLE" = yes ]; then
        _wssl_cflags="${WOLFSSL_CFLAGS:-}"
        _wssl_libs="${WOLFSSL_LIBS:--lwolfssl}"
        _wssl_probe_dir=$(mktemp -d)
        printf '#include <wolfssl/ssl.h>\nint main(void){wolfSSL_Init();wolfSSL_Cleanup();return 0;}\n' \
            >"$_wssl_probe_dir/probe.c"
        if ! "$cross_cc" ${_wssl_cflags:+$_wssl_cflags} \
                "$_wssl_probe_dir/probe.c" -o "$_wssl_probe_dir/probe" \
                ${_wssl_libs:+$_wssl_libs} 2>/dev/null; then
            rm -rf "$_wssl_probe_dir"
            printf '%s\n' "package-target: transport=builtin requires wolfSSL, but the cross-compiler cannot find it." >&2
            printf '%s\n' "  Cross compiler: $cross_cc" >&2
            _staging="$BUILDROOT_OUTPUT_BASE/$target/staging"
            if [ -f "$_staging/usr/include/wolfssl/ssl.h" ]; then
                printf '%s\n' "  wolfSSL staging header found at $_staging/usr/include/wolfssl/ssl.h" >&2
                printf '%s\n' "  but the compile probe still failed — check library linkage." >&2
            else
                printf '%s\n' "  wolfSSL not found in buildroot staging ($target)." >&2
                printf '%s\n' "  Ensure BR2_PACKAGE_WOLFSSL=y is in the generated defconfig and rebuild." >&2
            fi
            printf '%s\n' "  To override: WOLFSSL_CFLAGS=-I... WOLFSSL_LIBS='-L... -lwolfssl' make package" >&2
            exit 1
        fi
        rm -rf "$_wssl_probe_dir"
    fi
    CC="$cross_cc" OUT="$full_core" ARTIFACT_TIER=full ADVERTISE_PAYLOAD_TOOLS=1 \
        BB_TARGET_PRESET="$manifest_target_preset" \
        BB_TARGET_NAME="$TARGET_NAME" \
        BB_TARGET_ARCH="$TARGET_ARCH" \
        BB_TARGET_ENDIAN="$TARGET_ENDIAN" \
        BB_TARGET_CPU="$TARGET_CPU" \
        BB_TARGET_ABI="$TARGET_ABI" \
        BB_TARGET_LIBC="$TARGET_LIBC" \
        BB_KERNEL_FLOOR="$TARGET_KERNEL_FLOOR" \
        BB_STATIC_POLICY="$TARGET_STATIC_POLICY" \
        BB_PAYLOAD_PRESET="$BB_PAYLOAD_PRESET" \
        BB_RUNTIME_MODE="$BB_RUNTIME_MODE" \
        BB_RUNTIME_ROOT="$BB_RUNTIME_ROOT" \
        BB_RUNTIME_ALLOW_FALLBACK_ROOT="$BB_RUNTIME_ALLOW_FALLBACK_ROOT" \
        BB_RUNTIME_FALLBACK_ROOT="$BB_RUNTIME_FALLBACK_ROOT" \
        BB_ZERO_ARG_MODE="$BB_ZERO_ARG_MODE" \
        BB_ZERO_ARG_LOG_MODE="$BB_ZERO_ARG_LOG_MODE" \
        BB_ZERO_ARG_CUSTOM_COMMAND="$BB_ZERO_ARG_CUSTOM_COMMAND" \
        BB_RSHELL_TRANSPORT="$BB_RSHELL_TRANSPORT" \
        BB_RSHELL_ENCRYPTION="$BB_RSHELL_ENCRYPTION" \
        BB_RSHELL_ALLOW_PLAINTEXT="$BB_RSHELL_ALLOW_PLAINTEXT" \
        BB_RSHELL_AUTHKEYS_MODE="$BB_RSHELL_AUTHKEYS_MODE" \
        BB_RSHELL_RUN_MODE="$BB_RSHELL_RUN_MODE" \
        BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING="$BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING" \
        BB_RSHELL_SOCAT_PORT="$BB_RSHELL_SOCAT_PORT" \
        BB_RSHELL_SHELL_PROVIDER="$BB_RSHELL_SHELL_PROVIDER" \
        BB_RSHELL_CUSTOM_SHELL="$BB_RSHELL_CUSTOM_SHELL" \
        BB_RSHELL_RETRY_COUNT="$BB_RSHELL_RETRY_COUNT" \
        BB_RSHELL_RETRY_INTERVAL_SEC="$BB_RSHELL_RETRY_INTERVAL_SEC" \
        BB_RSHELL_RETRY_JITTER_PCT="$BB_RSHELL_RETRY_JITTER_PCT" \
        BB_RSHELL_RETRY_BACKOFF="$BB_RSHELL_RETRY_BACKOFF" \
        BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" \
        BB_BUILTIN_TLS_ENABLE="$BB_BUILTIN_TLS_ENABLE" \
        WOLFSSL_CFLAGS="${WOLFSSL_CFLAGS:-}" \
        WOLFSSL_LIBS="${WOLFSSL_LIBS:-}" \
        BB_AUTORUN_GUARD_ENABLE="$BB_AUTORUN_GUARD_ENABLE" \
        BB_AUTORUN_GUARD_PATH="$BB_AUTORUN_GUARD_PATH" \
        BB_AUTORUN_REENTRY_ACTION="$BB_AUTORUN_REENTRY_ACTION" \
        BB_AUTORUN_STALE_LOCK_POLICY="$BB_AUTORUN_STALE_LOCK_POLICY" \
        BB_OPERATOR_REMOTE_FORWARD_PORT="$BB_OPERATOR_REMOTE_FORWARD_PORT" \
        BB_OPERATOR_TARGET_DROPBEAR_PORT="$BB_OPERATOR_TARGET_DROPBEAR_PORT" \
        BB_OPERATOR_SERVER_HOST="$BB_OPERATOR_SERVER_HOST" \
        BB_OPERATOR_SERVER_USER="$BB_OPERATOR_SERVER_USER" \
        BB_OPERATOR_SERVER_SSH_PORT="$BB_OPERATOR_SERVER_SSH_PORT" \
        BB_OPERATOR_TARGET_BIND_HOST="$BB_OPERATOR_TARGET_BIND_HOST" \
        BB_OPERATOR_KNOWN_HOSTS_POLICY="$BB_OPERATOR_KNOWN_HOSTS_POLICY" \
        BB_DOTFILES_ENABLE="$BB_DOTFILES_ENABLE" \
        BB_DOTFILE_ZSH_MODE="$BB_DOTFILE_ZSH_MODE" \
        BB_DOTFILE_TMUX_MODE="$BB_DOTFILE_TMUX_MODE" \
        BB_DOTFILE_GDB_MODE="$BB_DOTFILE_GDB_MODE" \
        BB_DOTFILE_PROFILE_MODE="$BB_DOTFILE_PROFILE_MODE" \
        BB_USER_OVERLAY_ENABLE="${BB_USER_OVERLAY_ENABLE:-no}" \
        BB_USER_OVERLAY_ROOT="${BB_USER_OVERLAY_ROOT:-./overlay}" \
        BB_USER_OVERLAY_ALLOW_OVERRIDE="${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}" \
        scripts/build-native
fi

scripts/check-payload-tar "dist/payload-$target.tar"
if [ "$BB_BUILD_FULL" = yes ]; then
    scripts/embed-payload "$full_core" "$payload" "$artifact"
    rm -f "$full_core"
    sha256_write "$artifact" "$artifact.sha256"
    cp "$artifact" "$compat_artifact"
    cp "$artifact.sha256" "$compat_artifact.sha256"
else
    rm -f "$full_core"
fi

if [ "$BB_BUILD_INTERNAL_CORE" = yes ]; then
    if [ "$target" = native ]; then
        OUT="$core" ARTIFACT_TIER=core ADVERTISE_PAYLOAD_TOOLS=0 \
            BB_TARGET_PRESET="$manifest_target_preset" \
            BB_TARGET_NAME="$TARGET_NAME" \
            BB_TARGET_ARCH="$TARGET_ARCH" \
            BB_TARGET_ENDIAN="$TARGET_ENDIAN" \
            BB_TARGET_CPU="$TARGET_CPU" \
            BB_TARGET_ABI="$TARGET_ABI" \
            BB_TARGET_LIBC="$TARGET_LIBC" \
            BB_KERNEL_FLOOR="$TARGET_KERNEL_FLOOR" \
            BB_STATIC_POLICY="$TARGET_STATIC_POLICY" \
            BB_PAYLOAD_PRESET="$BB_PAYLOAD_PRESET" \
            BB_RSHELL_SHELL_PROVIDER="$BB_RSHELL_SHELL_PROVIDER" \
            BB_RSHELL_CUSTOM_SHELL="$BB_RSHELL_CUSTOM_SHELL" \
            BB_RSHELL_RUN_MODE="$BB_RSHELL_RUN_MODE" \
            BB_RSHELL_RETRY_COUNT="$BB_RSHELL_RETRY_COUNT" \
            BB_RSHELL_RETRY_INTERVAL_SEC="$BB_RSHELL_RETRY_INTERVAL_SEC" \
            BB_RSHELL_RETRY_JITTER_PCT="$BB_RSHELL_RETRY_JITTER_PCT" \
            BB_RSHELL_RETRY_BACKOFF="$BB_RSHELL_RETRY_BACKOFF" \
            BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" \
            scripts/build-native
    else
        CC="$cross_cc" OUT="$core" ARTIFACT_TIER=core ADVERTISE_PAYLOAD_TOOLS=0 \
            BB_TARGET_PRESET="$manifest_target_preset" \
            BB_TARGET_NAME="$TARGET_NAME" \
            BB_TARGET_ARCH="$TARGET_ARCH" \
            BB_TARGET_ENDIAN="$TARGET_ENDIAN" \
            BB_TARGET_CPU="$TARGET_CPU" \
            BB_TARGET_ABI="$TARGET_ABI" \
            BB_TARGET_LIBC="$TARGET_LIBC" \
            BB_KERNEL_FLOOR="$TARGET_KERNEL_FLOOR" \
            BB_STATIC_POLICY="$TARGET_STATIC_POLICY" \
            BB_PAYLOAD_PRESET="$BB_PAYLOAD_PRESET" \
            BB_RSHELL_SHELL_PROVIDER="$BB_RSHELL_SHELL_PROVIDER" \
            BB_RSHELL_CUSTOM_SHELL="$BB_RSHELL_CUSTOM_SHELL" \
            BB_RSHELL_RUN_MODE="$BB_RSHELL_RUN_MODE" \
            BB_RSHELL_RETRY_COUNT="$BB_RSHELL_RETRY_COUNT" \
            BB_RSHELL_RETRY_INTERVAL_SEC="$BB_RSHELL_RETRY_INTERVAL_SEC" \
            BB_RSHELL_RETRY_JITTER_PCT="$BB_RSHELL_RETRY_JITTER_PCT" \
            BB_RSHELL_RETRY_BACKOFF="$BB_RSHELL_RETRY_BACKOFF" \
            BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" \
            scripts/build-native
    fi
fi

if [ "$VERIFY" = 1 ] && [ "$BB_BUILD_FULL" = yes ]; then
    scripts/verify-artifact "$artifact"
fi

if [ "$target" = native ] && [ "$BB_BUILD_FULL" = yes ]; then
    cp "$artifact" dist/busierbox-full
    cp "$artifact.sha256" dist/busierbox-full.sha256
    cp "$artifact" dist/busierbox
    cp "$artifact.sha256" dist/busierbox.sha256
fi

if [ "$BB_BUILD_FULL" = yes ]; then
    primary_output=$artifact
else
    primary_output=$core
fi

printf '%s\n' "PASS $target -> $primary_output"
