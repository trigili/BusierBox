#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/busierbox-bringup [--host USER@HOST] [options]

Guided target bring-up flow. It builds or reuses a conservative survey
artifact, copies it to the target, captures survey/config-info output, converts
the survey into a recommended BusierBox config, and can then build that
recommended artifact.

What it does:
  - writes local run files under local/bringup-runs/<timestamp>/
  - builds a survey artifact unless --survey-json is supplied
  - transfers only to /tmp/busierbox-bringup-<timestamp>/ on the target
  - runs ./busierbox survey --json and ./busierbox config-info
  - runs ./busierbox reality-test --json when the artifact supports it
  - writes recommended.conf, recommendation.json, and summary.json
  - can generate a local target preset and select a compatible release artifact
  - optionally runs one integration case when --run-integration is set

What it does not do:
  - does not start scripts/busierbox-server
  - does not enable reverse access or network autorun
  - does not install persistence or write outside the remote temp directory
  - does not replace the repeatable integration harness

Options:
  --operator-host HOST|auto   operator address for generated reverse-access config
  --survey-only               stop after survey and recommendation
  --recommend-only            use --survey-json or captured survey; do not build final artifact
  --survey-json PATH          use an existing survey JSON instead of touching target
  --reality-json PATH         use an existing reality-test JSON for release scoring
  --write-target-preset NAME  write local/presets/targets/NAME.json from survey
  --release-dir DIR           choose a compatible artifact from a release bundle
  --max-compatibility LABEL   reject release artifacts riskier than LABEL
  --configure-trailer         print artifact-config command for operator overrides
  --stage-recommended-artifact
                              stage selected/recommended artifact for target fetch
  --json                      print summary JSON to stdout
  --payload-preset NAME       preset for initial survey artifact; default survey-core
  --target-preset NAME        target preset to build; default native
  --run-integration CASE      run one scripts/integration-glinet case after build
  --dry-run                   create local plan/summary only; no build, SSH, or SCP
  --keep-remote               leave remote temp directory for debugging
  --help, -h                  show this help

Examples:
  scripts/busierbox-bringup --host root@192.168.8.1 --operator-host auto
  scripts/busierbox-bringup --host root@192.168.8.1 --survey-only
  scripts/busierbox-bringup --recommend-only --survey-json survey.json
  scripts/busierbox-bringup --recommend-only --survey-json survey.json --write-target-preset lab-router
  scripts/busierbox-bringup --recommend-only --survey-json survey.json --release-dir dist/releases/smoke --json

Use scripts/integration-glinet for repeatable validation runs. Bringup is a
guided onboarding flow; integration-glinet is the regression harness.
EOF
}

host=
operator_host=auto
survey_only=no
recommend_only=no
payload_preset=survey-core
target_preset=native
run_integration=
dry_run=no
keep_remote=no
survey_input=
reality_input=
write_target_preset=
release_dir=
max_compatibility=
configure_trailer=no
stage_recommended_artifact=no
json_output=no
remote_touched=no
target_preset_path=
release_find_json=
selected_artifact=
compatibility_label=
compatibility_reasons_json='[]'
selected_tool_provider_status_json='{}'
trailer_command=
staged_fetch_command=
staged_request_name=
recommended_artifact=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --host) host=$2; shift 2 ;;
        --host=*) host=${1#--host=}; shift ;;
        --operator-host) operator_host=$2; shift 2 ;;
        --operator-host=*) operator_host=${1#--operator-host=}; shift ;;
        --survey-only) survey_only=yes; shift ;;
        --recommend-only) recommend_only=yes; shift ;;
        --survey-json) survey_input=$2; shift 2 ;;
        --survey-json=*) survey_input=${1#--survey-json=}; shift ;;
        --reality-json) reality_input=$2; shift 2 ;;
        --reality-json=*) reality_input=${1#--reality-json=}; shift ;;
        --write-target-preset) write_target_preset=$2; shift 2 ;;
        --write-target-preset=*) write_target_preset=${1#--write-target-preset=}; shift ;;
        --release-dir) release_dir=$2; shift 2 ;;
        --release-dir=*) release_dir=${1#--release-dir=}; shift ;;
        --max-compatibility) max_compatibility=$2; shift 2 ;;
        --max-compatibility=*) max_compatibility=${1#--max-compatibility=}; shift ;;
        --configure-trailer) configure_trailer=yes; shift ;;
        --stage-recommended-artifact) stage_recommended_artifact=yes; shift ;;
        --json) json_output=yes; shift ;;
        --payload-preset) payload_preset=$2; shift 2 ;;
        --payload-preset=*) payload_preset=${1#--payload-preset=}; shift ;;
        --target-preset) target_preset=$2; shift 2 ;;
        --target-preset=*) target_preset=${1#--target-preset=}; shift ;;
        --run-integration) run_integration=$2; shift 2 ;;
        --run-integration=*) run_integration=${1#--run-integration=}; shift ;;
        --dry-run) dry_run=yes; shift ;;
        --keep-remote) keep_remote=yes; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$host" ] || {
    if [ -n "$survey_input" ] || [ "$dry_run" = yes ]; then
        host="USER@TARGET"
    else
        usage
        exit 2
    fi
}

ts=$(date -u +%Y%m%d-%H%M%S)
run_dir="local/bringup-runs/$ts"
remote_dir="/tmp/busierbox-bringup-$ts"
mkdir -p "$run_dir"

summary="$run_dir/summary.json"
config="$run_dir/survey-core.conf"
survey="$run_dir/survey.json"
recommended="$run_dir/recommended.conf"
reality="$run_dir/reality-test.json"

write_summary() {
    status=$1
    reason=${2:-}
    SUMMARY_PATH="$summary" \
    STATUS="$status" \
    REASON="$reason" \
    HOST="$host" \
    RUN_DIR="$run_dir" \
    REMOTE_DIR="$remote_dir" \
    PAYLOAD_PRESET="$payload_preset" \
    TARGET_PRESET="$target_preset" \
    OPERATOR_HOST="$operator_host" \
    SURVEY_JSON="$survey" \
    REALITY_JSON="$reality" \
    RECOMMENDATION_JSON="$run_dir/recommendation.json" \
    RECOMMENDED_CONFIG="$recommended" \
    TARGET_PRESET_PATH="$target_preset_path" \
    RELEASE_DIR="$release_dir" \
    MAX_COMPATIBILITY="$max_compatibility" \
    RELEASE_FIND_JSON="$release_find_json" \
    SELECTED_ARTIFACT="$selected_artifact" \
    COMPATIBILITY_LABEL="$compatibility_label" \
    COMPATIBILITY_REASONS_JSON="$compatibility_reasons_json" \
    SELECTED_TOOL_PROVIDER_STATUS_JSON="$selected_tool_provider_status_json" \
    TRAILER_COMMAND="$trailer_command" \
    STAGED_FETCH_COMMAND="$staged_fetch_command" \
    STAGED_REQUEST_NAME="$staged_request_name" \
    RECOMMENDED_ARTIFACT="$recommended_artifact" \
    python3 - <<'PY'
import json
import os

def env(name):
    return os.environ.get(name, "")

def maybe_file(path):
    return path if path and os.path.exists(path) else ""

def file_record(name, path, expected_kind="file"):
    rec = {
        "name": name,
        "path": path,
        "expected_kind": expected_kind,
        "exists": False,
        "is_file": False,
        "is_dir": False,
        "size": 0,
        "readable": False,
        "writable": False,
    }
    if not path:
        return rec
    rec["exists"] = os.path.exists(path)
    rec["is_file"] = os.path.isfile(path)
    rec["is_dir"] = os.path.isdir(path)
    rec["readable"] = bool(rec["exists"] and os.access(path, os.R_OK))
    rec["writable"] = bool(rec["exists"] and os.access(path, os.W_OK))
    if rec["exists"] and rec["is_file"]:
        try:
            rec["size"] = os.path.getsize(path)
        except OSError:
            rec["size"] = 0
    return rec

def split_lines(text):
    return [line for line in text.splitlines() if line]

try:
    reasons = json.loads(env("COMPATIBILITY_REASONS_JSON") or "[]")
    if not isinstance(reasons, list):
        reasons = [reasons]
except Exception:
    reasons = split_lines(env("COMPATIBILITY_REASONS_JSON"))

try:
    selected_tool_provider_status = json.loads(env("SELECTED_TOOL_PROVIDER_STATUS_JSON") or "{}")
    if not isinstance(selected_tool_provider_status, dict):
        selected_tool_provider_status = {}
except Exception:
    selected_tool_provider_status = {}

host = env("HOST")
operator_host = env("OPERATOR_HOST")
next_operator = [
    "scripts/busierbox-server --transport file-service",
]
if env("TRAILER_COMMAND"):
    next_operator.append(env("TRAILER_COMMAND"))

next_target = [
    "./busierbox survey --json",
    "./busierbox reality-test --json",
]
if env("STAGED_FETCH_COMMAND"):
    next_target.append(env("STAGED_FETCH_COMMAND"))

next_operator_records = [
    {
        "command": "scripts/busierbox-server --transport file-service",
        "purpose": "start receive-only operator file service",
        "side": "operator",
        "service": "file-service",
        "executes_on_target": False,
        "starts_listener": True,
        "requires_explicit_operator_action": True,
    },
]
if env("TRAILER_COMMAND"):
    next_operator_records.append({
        "command": env("TRAILER_COMMAND"),
        "purpose": "configure artifact trailer overrides",
        "side": "operator",
        "service": "artifact-config",
        "executes_on_target": False,
        "starts_listener": False,
        "requires_explicit_operator_action": True,
    })

next_target_records = [
    {
        "command": "./busierbox survey --json",
        "purpose": "collect passive target facts",
        "side": "target",
        "service": "survey",
        "requires_explicit_target_action": True,
        "network": False,
        "executes_operator_supplied_commands": False,
    },
    {
        "command": "./busierbox reality-test --json",
        "purpose": "run active local capability probes",
        "side": "target",
        "service": "reality-test",
        "requires_explicit_target_action": True,
        "network": False,
        "executes_operator_supplied_commands": False,
    },
]
if env("STAGED_FETCH_COMMAND"):
    next_target_records.append({
        "command": env("STAGED_FETCH_COMMAND"),
        "purpose": "explicitly fetch operator-staged artifact or config",
        "side": "target",
        "service": "file-service",
        "requires_explicit_target_action": True,
        "network": True,
        "executes_operator_supplied_commands": False,
    })

command_record_summary = {
    "operator_count": len(next_operator_records),
    "target_count": len(next_target_records),
    "target_network_count": sum(1 for item in next_target_records if item.get("network") is True),
    "operator_listener_count": sum(1 for item in next_operator_records if item.get("starts_listener") is True),
    "target_requires_explicit_action_count": sum(1 for item in next_target_records if item.get("requires_explicit_target_action") is True),
    "target_executes_operator_supplied_commands_count": sum(1 for item in next_target_records if item.get("executes_operator_supplied_commands") is True),
    "operator_executes_on_target_count": sum(1 for item in next_operator_records if item.get("executes_on_target") is True),
    "all_target_commands_require_explicit_action": all(item.get("requires_explicit_target_action") is True for item in next_target_records),
    "all_operator_commands_require_explicit_action": all(item.get("requires_explicit_operator_action") is True for item in next_operator_records),
    "any_operator_command_executes_on_target": any(item.get("executes_on_target") is True for item in next_operator_records),
    "any_target_command_executes_operator_supplied_commands": any(item.get("executes_operator_supplied_commands") is True for item in next_target_records),
}
next_command_records = next_operator_records + next_target_records
next_command_records_by_side = {
    "operator": next_operator_records,
    "target": next_target_records,
}
next_command_records_by_service = {}
next_command_records_by_purpose = {}
next_command_records_by_side_service = {}
next_command_records_by_service_purpose = {}
for item in next_command_records:
    service = item.get("service") or ""
    purpose = item.get("purpose") or ""
    side = item.get("side") or ""
    if service:
        next_command_records_by_service.setdefault(service, []).append(item)
    if purpose:
        next_command_records_by_purpose.setdefault(purpose, []).append(item)
    if side and service:
        next_command_records_by_side_service.setdefault(f"{side}:{service}", []).append(item)
    if service and purpose:
        next_command_records_by_service_purpose.setdefault(f"{service}:{purpose}", []).append(item)

recommendation_summary = {}
recommendation_path = env("RECOMMENDATION_JSON")
if recommendation_path and os.path.exists(recommendation_path):
    try:
        with open(recommendation_path, "r", encoding="utf-8") as fh:
            recommendation_doc = json.load(fh)
        recs = recommendation_doc.get("recommendations") or {}
        facts = recommendation_doc.get("facts") or {}
        recommendation_summary = {
            "warnings": recommendation_doc.get("warnings") or [],
            "facts": {
                "arch": facts.get("arch", ""),
                "libc": facts.get("libc", ""),
                "kernel_floor": facts.get("kernel_floor", ""),
                "endianness": facts.get("endianness", ""),
                "payload_possible": facts.get("payload_possible", ""),
                "recommended_extract_dir": facts.get("recommended_extract_dir", ""),
                "reality": facts.get("reality") or {},
            },
            "config": {
                key: recs.get(key, "")
                for key in (
                    "BB_TARGET_PRESET",
                    "BB_PAYLOAD_PRESET",
                    "BB_RUNTIME_MODE",
                    "BB_RUNTIME_ROOT",
                    "BB_RSHELL_TRANSPORT",
                    "BB_ZERO_ARG_MODE",
                )
            },
        }
    except Exception as exc:
        recommendation_summary = {"warning": f"could not parse recommendation JSON: {exc}"}

doc = {
    "schema": 1,
    "status": env("STATUS"),
    "host": host,
    "run_dir": env("RUN_DIR"),
    "remote_dir": env("REMOTE_DIR"),
    "payload_preset": env("PAYLOAD_PRESET"),
    "target_preset": env("TARGET_PRESET"),
    "operator_host": operator_host,
    "survey_json": env("SURVEY_JSON"),
    "reality_json": maybe_file(env("REALITY_JSON")),
    "recommendation_json": env("RECOMMENDATION_JSON"),
    "recommended_config": env("RECOMMENDED_CONFIG"),
    "recommendation": recommendation_summary,
    "recommended_target_preset": env("TARGET_PRESET_PATH"),
    "release_dir": env("RELEASE_DIR"),
    "max_compatibility": env("MAX_COMPATIBILITY"),
    "release_find_json": maybe_file(env("RELEASE_FIND_JSON")),
    "selected_artifact": env("SELECTED_ARTIFACT"),
    "selected_tool_provider_status": selected_tool_provider_status,
    "compatibility": {
        "label": env("COMPATIBILITY_LABEL"),
        "reasons": reasons,
    },
    "generated_trailer_override_command": env("TRAILER_COMMAND"),
    "staged_request_name": env("STAGED_REQUEST_NAME"),
    "staged_fetch_command": env("STAGED_FETCH_COMMAND"),
    "next_operator_commands": next_operator,
    "next_target_commands": next_target,
    "next_operator_command_records": next_operator_records,
    "next_target_command_records": next_target_records,
    "next_command_records": next_command_records,
    "next_command_records_by_side": next_command_records_by_side,
    "next_command_records_by_service": next_command_records_by_service,
    "next_command_records_by_purpose": next_command_records_by_purpose,
    "next_command_records_by_side_service": next_command_records_by_side_service,
    "next_command_records_by_service_purpose": next_command_records_by_service_purpose,
    "command_record_summary": command_record_summary,
    "safety_boundary": {
        "network_autorun": False,
        "target_must_run_fetch": bool(env("STAGED_FETCH_COMMAND")),
        "remote_command_execution_by_default": False,
        "command_queue_enabled_by_default": False,
        "hidden_control_channel": False,
    },
}
if env("REASON"):
    doc["reason"] = env("REASON")
run_files = {
    "run_dir": file_record("run_dir", env("RUN_DIR"), "dir"),
    "survey_json": file_record("survey_json", env("SURVEY_JSON")),
    "reality_json": file_record("reality_json", env("REALITY_JSON")),
    "recommendation_json": file_record("recommendation_json", env("RECOMMENDATION_JSON")),
    "recommended_config": file_record("recommended_config", env("RECOMMENDED_CONFIG")),
    "recommended_target_preset": file_record("recommended_target_preset", env("TARGET_PRESET_PATH")),
    "release_find_json": file_record("release_find_json", env("RELEASE_FIND_JSON")),
    "selected_artifact": file_record("selected_artifact", env("SELECTED_ARTIFACT")),
    "recommended_artifact": file_record("recommended_artifact", env("RECOMMENDED_ARTIFACT")),
}
doc["run_files"] = run_files
doc["run_file_summary"] = {
    "total_count": len(run_files),
    "exists_count": sum(1 for item in run_files.values() if item.get("exists")),
    "missing_count": sum(1 for item in run_files.values() if not item.get("exists")),
    "readable_count": sum(1 for item in run_files.values() if item.get("readable")),
    "writable_count": sum(1 for item in run_files.values() if item.get("writable")),
    "total_size": sum(int(item.get("size") or 0) for item in run_files.values()),
}
path = env("SUMMARY_PATH")
with open(path, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
    if [ "$json_output" = yes ]; then
        cat "$summary"
    fi
}

shell_quote() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/"
}

remote_quote() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

extract_release_selection() {
    RELEASE_FIND_JSON="$release_find_json" python3 - <<'PY'
import json
import os

path = os.environ["RELEASE_FIND_JSON"]
with open(path, "r", encoding="utf-8") as fh:
    data = json.load(fh)

def first_string(*values):
    for value in values:
        if isinstance(value, str) and value:
            return value
    return ""

artifact = first_string(
    data.get("artifact"),
    data.get("artifact_path"),
    data.get("path"),
    data.get("file"),
)
selected = data.get("selected")
if isinstance(selected, dict):
    artifact = artifact or first_string(
        selected.get("artifact"),
        selected.get("artifact_path"),
        selected.get("path"),
        selected.get("file"),
    )

compat = data.get("compatibility")
label = ""
reasons = []
tool_provider_status = {}
if isinstance(compat, dict):
    label = first_string(compat.get("label"), compat.get("score"), compat.get("status"))
    raw = compat.get("reasons", [])
    reasons = raw if isinstance(raw, list) else [raw]
elif isinstance(compat, str):
    label = compat
if isinstance(selected, dict):
    raw_provider_status = selected.get("tool_provider_status")
    if isinstance(raw_provider_status, dict):
        tool_provider_status = raw_provider_status
if not label:
    label = first_string(data.get("compatibility_label"), data.get("score"), data.get("label"))
if not reasons:
    raw = data.get("reasons", [])
    reasons = raw if isinstance(raw, list) else [raw]

import shlex

values = {
    "selected_artifact": artifact,
    "compatibility_label": label,
    "compatibility_reasons_json": json.dumps([str(x) for x in reasons if x not in (None, "")]),
    "selected_tool_provider_status_json": json.dumps(tool_provider_status),
}
for key, value in values.items():
    print(f"{key}={shlex.quote(str(value))}")
PY
}

choose_release_artifact() {
    [ -n "$release_dir" ] || return 0
    release_find_json="$run_dir/release-find.json"
    max_args=
    case "$max_compatibility" in
        ""|exact|likely|heuristic|unsafe|incompatible) ;;
        *)
            write_summary fail "invalid max compatibility label"
            printf '%s\n' "bringup: invalid --max-compatibility $max_compatibility" >&2
            exit 2
            ;;
    esac
    if [ -n "$max_compatibility" ]; then
        max_args=yes
    fi
    set -- scripts/release-find --release-dir "$release_dir" --survey-json "$survey"
    if [ -f "$reality" ]; then
        set -- "$@" --reality-json "$reality"
    fi
    if [ "$max_args" = yes ]; then
        set -- "$@" --max-compatibility "$max_compatibility"
    fi
    if "$@" --json >"$release_find_json" 2>"$run_dir/release-find.err"; then
        eval "$(extract_release_selection)"
    else
        write_summary fail "release artifact selection failed"
        printf '%s\n' "bringup: release artifact selection failed; see $run_dir/release-find.err" >&2
        exit 1
    fi
}

generate_trailer_command() {
    [ "$configure_trailer" = yes ] || return 0
    artifact_for_trailer=${selected_artifact:-$recommended_artifact}
    [ -n "$artifact_for_trailer" ] || return 0
    host_for_trailer=$operator_host
    [ "$host_for_trailer" = auto ] && host_for_trailer=OPERATOR_IP
    trailer_command="scripts/artifact-config set $(shell_quote "$artifact_for_trailer") BB_OPERATOR_SERVER_HOST=$(shell_quote "$host_for_trailer") BB_OPERATOR_FILE_SERVICE_ENABLE=yes BB_OPERATOR_FILE_SERVICE_PORT=22204"
}

stage_artifact_for_fetch() {
    [ "$stage_recommended_artifact" = yes ] || return 0
    artifact_to_stage=${selected_artifact:-$recommended_artifact}
    [ -n "$artifact_to_stage" ] || artifact_to_stage=$recommended
    [ -n "$artifact_to_stage" ] || return 0
    [ -f "$artifact_to_stage" ] || {
        write_summary fail "artifact selected for staging is missing"
        printf '%s\n' "bringup: artifact selected for staging is missing: $artifact_to_stage" >&2
        exit 1
    }
    staged_request_name=$(basename "$artifact_to_stage")
    scripts/busierbox-server --serve-file "$artifact_to_stage" --as "$staged_request_name" --list-staged >"$run_dir/staged-artifact.out" 2>"$run_dir/staged-artifact.err" || {
        write_summary fail "artifact staging failed"
        printf '%s\n' "bringup: artifact staging failed; see $run_dir/staged-artifact.err" >&2
        exit 1
    }
    staged_fetch_command=$(sed -n 's/^  //p; /^busierbox fetch /p' "$run_dir/staged-artifact.out" | sed -n '1p')
    [ -n "$staged_fetch_command" ] || staged_fetch_command="busierbox fetch $staged_request_name --host OPERATOR_IP --port 22204"
}

cat "presets/payload/$payload_preset.conf" >"$config"
{
    printf '\n# generated by scripts/busierbox-bringup\n'
    printf 'BB_RUNTIME_ALLOW_EXTERNAL_WRITES="no"\n'
    printf 'BB_ZERO_ARG_MODE="help"\n'
} >>"$config"

if [ "$dry_run" = yes ]; then
    generate_trailer_command
    write_summary dry-run
    if [ "$json_output" != yes ]; then
        printf '%s\n' "bringup dry-run: would build $target_preset with $config"
        printf '%s\n' "bringup dry-run: would transfer to $host:$remote_dir"
        printf '%s\n' "bringup dry-run: summary at $summary"
    fi
    exit 0
fi

if [ -n "$survey_input" ]; then
    cp "$survey_input" "$survey"
fi
if [ -n "$reality_input" ]; then
    cp "$reality_input" "$reality"
fi

if [ ! -f "$survey" ]; then
    env BUSIERBOX_CONFIG="$config" TARGET="$target_preset" make package >"$run_dir/build.log" 2>&1 || {
        write_summary fail "survey artifact build failed"
        printf '%s\n' "bringup: survey artifact build failed; see $run_dir/build.log" >&2
        exit 1
    }
    artifact="dist/busierbox-$target_preset-full"
    [ -f "$artifact" ] || artifact="dist/busierbox-native-full"
    ssh "$host" "rm -rf '$(remote_quote "$remote_dir")'; mkdir -p '$(remote_quote "$remote_dir")'" >"$run_dir/ssh.log" 2>&1 || {
        write_summary fail "target unreachable"
        printf '%s\n' "bringup: target unreachable or remote dir unavailable" >&2
        exit 1
    }
    remote_touched=yes
    scp -O -q "$artifact" "$host:$remote_dir/busierbox" >>"$run_dir/ssh.log" 2>&1
    ssh "$host" "cd '$(remote_quote "$remote_dir")' && chmod +x ./busierbox && ./busierbox survey --json > survey.json && ./busierbox config-info > config-info.out && if ./busierbox reality-test --help >/dev/null 2>&1; then ./busierbox reality-test --json > reality-test.json || true; fi" >>"$run_dir/ssh.log" 2>&1 || {
        write_summary fail "survey artifact could not run"
        printf '%s\n' "bringup: survey artifact could not run; likely arch/libc mismatch" >&2
        exit 1
    }
    scp -O -q "$host:$remote_dir/survey.json" "$survey" >>"$run_dir/ssh.log" 2>&1
    scp -O -q "$host:$remote_dir/config-info.out" "$run_dir/config-info.out" >>"$run_dir/ssh.log" 2>&1 || true
    scp -O -q "$host:$remote_dir/reality-test.json" "$reality" >>"$run_dir/ssh.log" 2>&1 || true
fi

if [ -f "$survey" ]; then
    if [ "$target_preset" = native ]; then
        if [ -f "$reality" ]; then
            scripts/config-from-survey --reality-json "$reality" --format shell --write-config "$recommended" "$survey"
            scripts/config-from-survey --reality-json "$reality" --format json "$survey" >"$run_dir/recommendation.json"
        else
            scripts/config-from-survey --format shell --write-config "$recommended" "$survey"
            scripts/config-from-survey --format json "$survey" >"$run_dir/recommendation.json"
        fi
    else
        if [ -f "$reality" ]; then
            scripts/config-from-survey --reality-json "$reality" --target-preset "$target_preset" --format shell --write-config "$recommended" "$survey"
            scripts/config-from-survey --reality-json "$reality" --target-preset "$target_preset" --format json "$survey" >"$run_dir/recommendation.json"
        else
            scripts/config-from-survey --target-preset "$target_preset" --format shell --write-config "$recommended" "$survey"
            scripts/config-from-survey --target-preset "$target_preset" --format json "$survey" >"$run_dir/recommendation.json"
        fi
    fi
else
    write_summary fail "survey json missing"
    printf '%s\n' "bringup: missing $survey" >&2
    exit 1
fi

if [ -n "$write_target_preset" ]; then
    scripts/preset-from-survey --survey "$survey" --name "$write_target_preset" --write-local --overwrite >"$run_dir/target-preset.log" 2>&1 || {
        write_summary fail "target preset generation failed"
        printf '%s\n' "bringup: target preset generation failed; see $run_dir/target-preset.log" >&2
        exit 1
    }
    target_preset_path="local/presets/targets/$write_target_preset.json"
fi

choose_release_artifact
generate_trailer_command
stage_artifact_for_fetch

if [ "$survey_only" = yes ] || [ "$recommend_only" = yes ]; then
    if [ "$remote_touched" = yes ] && [ "$keep_remote" != yes ]; then
        ssh "$host" "rm -rf '$(remote_quote "$remote_dir")'" >>"$run_dir/ssh.log" 2>&1 || true
    fi
    write_summary pass
    if [ "$json_output" != yes ]; then
        printf '%s\n' "bringup: survey and recommendation written under $run_dir"
        printf '%s\n' "bringup: recommended config: $recommended"
        printf '%s\n' "bringup: recommendation JSON: $run_dir/recommendation.json"
        [ -n "$target_preset_path" ] && printf '%s\n' "bringup: recommended target preset: $target_preset_path"
        [ -n "$compatibility_label" ] && printf '%s\n' "bringup: compatibility: $compatibility_label"
        [ -n "$selected_artifact" ] && printf '%s\n' "bringup: selected artifact: $selected_artifact"
        [ -n "$trailer_command" ] && printf '%s\n' "bringup: trailer command: $trailer_command"
        [ -n "$staged_fetch_command" ] && printf '%s\n' "bringup: staged fetch command: $staged_fetch_command"
    fi
    exit 0
fi

env BUSIERBOX_CONFIG="$recommended" make package >"$run_dir/recommended-build.log" 2>&1 || {
    write_summary fail "recommended artifact build failed"
    printf '%s\n' "bringup: recommended artifact build failed; see $run_dir/recommended-build.log" >&2
    exit 1
}
recommended_artifact="dist/busierbox-$target_preset-full"
[ -f "$recommended_artifact" ] || recommended_artifact="dist/busierbox-native-full"
generate_trailer_command
stage_artifact_for_fetch

if [ -n "$run_integration" ]; then
    scripts/integration-glinet --host "$host" --target-preset "$target_preset" --case "$run_integration" >>"$run_dir/integration.log" 2>&1 || {
        write_summary fail "integration failed"
        exit 1
    }
fi

if [ "$remote_touched" = yes ] && [ "$keep_remote" != yes ]; then
    ssh "$host" "rm -rf '$(remote_quote "$remote_dir")'" >>"$run_dir/ssh.log" 2>&1 || true
fi
write_summary pass
if [ "$json_output" != yes ]; then
    printf '%s\n' "bringup: complete; summary at $summary"
    [ -n "$target_preset_path" ] && printf '%s\n' "bringup: recommended target preset: $target_preset_path"
    [ -n "$compatibility_label" ] && printf '%s\n' "bringup: compatibility: $compatibility_label"
    [ -n "$selected_artifact" ] && printf '%s\n' "bringup: selected artifact: $selected_artifact"
    [ -n "$trailer_command" ] && printf '%s\n' "bringup: trailer command: $trailer_command"
    [ -n "$staged_fetch_command" ] && printf '%s\n' "bringup: staged fetch command: $staged_fetch_command"
fi
