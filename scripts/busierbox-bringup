#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/busierbox-bringup [--host USER@HOST] [options]

Guided target bring-up flow. It builds or reuses a conservative survey
artifact, copies it to the target, captures survey/config-info output, converts
the survey into a recommended BusierBox config, and can then build that
recommended artifact.

What it does:
  - writes local run files under local/bringup-runs/<timestamp>-<pid>/
  - builds a survey artifact unless --survey-json is supplied
  - transfers only to /tmp/busierbox-bringup-<timestamp>-<pid>/ on the target
  - runs ./busierbox survey --json and ./busierbox config-info
  - runs ./busierbox reality-test --json when the artifact supports it
  - writes recommended.conf, recommendation.json, and summary.json
  - can generate a local target preset and select a compatible release artifact
  - optionally runs one integration case when --run-integration is set

What it does not do:
  - does not start scripts/busierbox-server
  - does not enable reverse access or network autorun
  - does not install persistence or write outside the remote temp directory
  - does not replace the repeatable integration harness

Options:
  --operator-host HOST|auto   operator address for generated reverse-access config
  --survey-only               stop after survey and recommendation
  --recommend-only            use --survey-json or captured survey; do not build final artifact
  --survey-json PATH          use an existing survey JSON instead of touching target
  --reality-json PATH         use an existing reality-test JSON for release scoring
  --write-target-preset NAME  write local/presets/targets/NAME.json from survey
  --release-dir DIR           choose a compatible artifact from a release bundle or local release repository
  --max-compatibility LABEL   reject release artifacts riskier than LABEL
  --configure-trailer         print artifact-config command for operator overrides
  --stage-recommended-artifact
                              stage selected/recommended artifact for target fetch
  --json                      print summary JSON to stdout
  --payload-preset NAME       preset for initial survey artifact; default survey-core
  --target-preset NAME        target preset to build; default native
  --run-integration CASE      run one scripts/integration-glinet case after build
  --dry-run                   create local plan/summary only; no build, SSH, or SCP
  --keep-remote               leave remote temp directory for debugging
  --help, -h                  show this help

Examples:
  scripts/busierbox-bringup --host root@192.168.8.1 --operator-host auto
  scripts/busierbox-bringup --host root@192.168.8.1 --survey-only
  scripts/busierbox-bringup --recommend-only --survey-json survey.json
  scripts/busierbox-bringup --recommend-only --survey-json survey.json --write-target-preset lab-router
  scripts/busierbox-bringup --recommend-only --survey-json survey.json --release-dir dist/releases/smoke --json

Use scripts/integration-glinet for repeatable validation runs. Bringup is a
guided onboarding flow; integration-glinet is the regression harness.
EOF
}

host=
operator_host=auto
survey_only=no
recommend_only=no
payload_preset=survey-core
target_preset=native
run_integration=
dry_run=no
keep_remote=no
survey_input=
reality_input=
write_target_preset=
release_dir=
max_compatibility=
configure_trailer=no
stage_recommended_artifact=no
json_output=no
remote_touched=no
target_preset_path=
release_find_json=
release_selection_source=
release_selection_command=
selected_artifact=
compatibility_label=
compatibility_reasons_json='[]'
selected_tool_provider_status_json='{}'
selected_doom_wads_json='[]'
selected_artifact_summary_json='{}'
trailer_command=
staged_fetch_command=
staged_request_name=
recommended_artifact=
release_self_test_json=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --host) host=$2; shift 2 ;;
        --host=*) host=${1#--host=}; shift ;;
        --operator-host) operator_host=$2; shift 2 ;;
        --operator-host=*) operator_host=${1#--operator-host=}; shift ;;
        --survey-only) survey_only=yes; shift ;;
        --recommend-only) recommend_only=yes; shift ;;
        --survey-json) survey_input=$2; shift 2 ;;
        --survey-json=*) survey_input=${1#--survey-json=}; shift ;;
        --reality-json) reality_input=$2; shift 2 ;;
        --reality-json=*) reality_input=${1#--reality-json=}; shift ;;
        --write-target-preset) write_target_preset=$2; shift 2 ;;
        --write-target-preset=*) write_target_preset=${1#--write-target-preset=}; shift ;;
        --release-dir) release_dir=$2; shift 2 ;;
        --release-dir=*) release_dir=${1#--release-dir=}; shift ;;
        --max-compatibility) max_compatibility=$2; shift 2 ;;
        --max-compatibility=*) max_compatibility=${1#--max-compatibility=}; shift ;;
        --configure-trailer) configure_trailer=yes; shift ;;
        --stage-recommended-artifact) stage_recommended_artifact=yes; shift ;;
        --json) json_output=yes; shift ;;
        --payload-preset) payload_preset=$2; shift 2 ;;
        --payload-preset=*) payload_preset=${1#--payload-preset=}; shift ;;
        --target-preset) target_preset=$2; shift 2 ;;
        --target-preset=*) target_preset=${1#--target-preset=}; shift ;;
        --run-integration) run_integration=$2; shift 2 ;;
        --run-integration=*) run_integration=${1#--run-integration=}; shift ;;
        --dry-run) dry_run=yes; shift ;;
        --keep-remote) keep_remote=yes; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$host" ] || {
    if [ -n "$survey_input" ] || [ "$dry_run" = yes ]; then
        host="USER@TARGET"
    else
        usage
        exit 2
    fi
}

ts=$(date -u +%Y%m%d-%H%M%S)
run_id="$ts-$$"
run_dir="local/bringup-runs/$run_id"
remote_dir="/tmp/busierbox-bringup-$run_id"
if ! mkdir "$run_dir" 2>/dev/null; then
    i=1
    while :; do
        run_id="$ts-$$-$i"
        run_dir="local/bringup-runs/$run_id"
        remote_dir="/tmp/busierbox-bringup-$run_id"
        if mkdir "$run_dir" 2>/dev/null; then
            break
        fi
        i=$((i + 1))
        if [ "$i" -gt 100 ]; then
            printf '%s\n' "bringup: unable to create unique run directory under local/bringup-runs" >&2
            exit 1
        fi
    done
fi

summary="$run_dir/summary.json"
config="$run_dir/survey-core.conf"
survey="$run_dir/survey.json"
recommended="$run_dir/recommended.conf"
reality="$run_dir/reality-test.json"

write_summary() {
    status=$1
    reason=${2:-}
    SUMMARY_PATH="$summary" \
    STATUS="$status" \
    REASON="$reason" \
    HOST="$host" \
    RUN_DIR="$run_dir" \
    REMOTE_DIR="$remote_dir" \
    PAYLOAD_PRESET="$payload_preset" \
    TARGET_PRESET="$target_preset" \
    OPERATOR_HOST="$operator_host" \
    SURVEY_JSON="$survey" \
    REALITY_JSON="$reality" \
    RECOMMENDATION_JSON="$run_dir/recommendation.json" \
    RECOMMENDED_CONFIG="$recommended" \
    TARGET_PRESET_PATH="$target_preset_path" \
    RELEASE_DIR="$release_dir" \
    MAX_COMPATIBILITY="$max_compatibility" \
    RELEASE_FIND_JSON="$release_find_json" \
    RELEASE_SELECTION_SOURCE="$release_selection_source" \
    RELEASE_SELECTION_COMMAND="$release_selection_command" \
    RELEASE_SELF_TEST_JSON="$release_self_test_json" \
    SELECTED_ARTIFACT="$selected_artifact" \
    COMPATIBILITY_LABEL="$compatibility_label" \
    COMPATIBILITY_REASONS_JSON="$compatibility_reasons_json" \
    SELECTED_TOOL_PROVIDER_STATUS_JSON="$selected_tool_provider_status_json" \
    SELECTED_DOOM_WADS_JSON="$selected_doom_wads_json" \
    SELECTED_ARTIFACT_SUMMARY_JSON="$selected_artifact_summary_json" \
    TRAILER_COMMAND="$trailer_command" \
    STAGED_FETCH_COMMAND="$staged_fetch_command" \
    STAGED_REQUEST_NAME="$staged_request_name" \
    RECOMMENDED_ARTIFACT="$recommended_artifact" \
    python3 - <<'PY'
import json
import os

def env(name):
    return os.environ.get(name, "")

def maybe_file(path):
    return path if path and os.path.exists(path) else ""

def file_record(name, path, expected_kind="file"):
    rec = {
        "name": name,
        "path": path,
        "expected_kind": expected_kind,
        "exists": False,
        "is_file": False,
        "is_dir": False,
        "size": 0,
        "readable": False,
        "writable": False,
    }
    if not path:
        return rec
    rec["exists"] = os.path.exists(path)
    rec["is_file"] = os.path.isfile(path)
    rec["is_dir"] = os.path.isdir(path)
    rec["readable"] = bool(rec["exists"] and os.access(path, os.R_OK))
    rec["writable"] = bool(rec["exists"] and os.access(path, os.W_OK))
    if rec["exists"] and rec["is_file"]:
        try:
            rec["size"] = os.path.getsize(path)
        except OSError:
            rec["size"] = 0
    rec["expected_kind_matches"] = (
        bool(rec["is_dir"]) if expected_kind == "dir" else
        bool(rec["is_file"]) if expected_kind == "file" else
        bool(rec["exists"])
    ) if rec["exists"] else False
    rec["expected_kind_mismatch"] = bool(rec["exists"] and not rec["expected_kind_matches"])
    return rec

def split_lines(text):
    return [line for line in text.splitlines() if line]

try:
    reasons = json.loads(env("COMPATIBILITY_REASONS_JSON") or "[]")
    if not isinstance(reasons, list):
        reasons = [reasons]
except Exception:
    reasons = split_lines(env("COMPATIBILITY_REASONS_JSON"))

try:
    selected_tool_provider_status = json.loads(env("SELECTED_TOOL_PROVIDER_STATUS_JSON") or "{}")
    if not isinstance(selected_tool_provider_status, dict):
        selected_tool_provider_status = {}
except Exception:
    selected_tool_provider_status = {}

try:
    selected_doom_wads = json.loads(env("SELECTED_DOOM_WADS_JSON") or "[]")
    if not isinstance(selected_doom_wads, list):
        selected_doom_wads = []
except Exception:
    selected_doom_wads = []

try:
    selected_artifact_summary = json.loads(env("SELECTED_ARTIFACT_SUMMARY_JSON") or "{}")
    if not isinstance(selected_artifact_summary, dict):
        selected_artifact_summary = {}
except Exception:
    selected_artifact_summary = {}

host = env("HOST")
operator_host = env("OPERATOR_HOST")
next_operator = [
    "scripts/busierbox-server --transport file-service",
]
if env("TRAILER_COMMAND"):
    next_operator.append(env("TRAILER_COMMAND"))

next_target = [
    "./busierbox survey --json",
    "./busierbox reality-test --json",
]
if env("STAGED_FETCH_COMMAND"):
    next_target.append(env("STAGED_FETCH_COMMAND"))

next_operator_records = [
    {
        "command": "scripts/busierbox-server --transport file-service",
        "purpose": "start receive-only operator file service",
        "side": "operator",
        "service": "file-service",
        "executes_on_target": False,
        "starts_listener": True,
        "requires_explicit_operator_action": True,
    },
]
if env("TRAILER_COMMAND"):
    next_operator_records.append({
        "command": env("TRAILER_COMMAND"),
        "purpose": "configure artifact trailer overrides",
        "side": "operator",
        "service": "artifact-config",
        "executes_on_target": False,
        "starts_listener": False,
        "requires_explicit_operator_action": True,
    })

next_target_records = [
    {
        "command": "./busierbox survey --json",
        "purpose": "collect passive target facts",
        "side": "target",
        "service": "survey",
        "requires_explicit_target_action": True,
        "network": False,
        "executes_operator_supplied_commands": False,
    },
    {
        "command": "./busierbox reality-test --json",
        "purpose": "run active local capability probes",
        "side": "target",
        "service": "reality-test",
        "requires_explicit_target_action": True,
        "network": False,
        "executes_operator_supplied_commands": False,
    },
]
staged_stage_kind = ""
staged_source_path = ""
if env("STAGED_FETCH_COMMAND"):
    if env("SELECTED_ARTIFACT"):
        staged_stage_kind = "release-artifact"
        staged_source_path = env("SELECTED_ARTIFACT")
    elif env("RECOMMENDED_ARTIFACT"):
        staged_stage_kind = "recommended-artifact"
        staged_source_path = env("RECOMMENDED_ARTIFACT")
    elif env("RECOMMENDED_CONFIG"):
        staged_stage_kind = "config"
        staged_source_path = env("RECOMMENDED_CONFIG")
if env("STAGED_FETCH_COMMAND"):
    next_target_records.append({
        "command": env("STAGED_FETCH_COMMAND"),
        "purpose": "explicitly fetch operator-staged artifact or config",
        "side": "target",
        "service": "file-service",
        "requires_explicit_target_action": True,
        "network": True,
        "executes_operator_supplied_commands": False,
        "request_name": env("STAGED_REQUEST_NAME"),
        "source_path": staged_source_path,
        "stage_kind": staged_stage_kind,
        "selected_artifact": env("SELECTED_ARTIFACT"),
        "compatibility": {
            "label": env("COMPATIBILITY_LABEL"),
            "reasons": reasons,
        },
    })

next_command_records = next_operator_records + next_target_records

def summary_count_by_key(records, key):
    counts = {}
    for item in records:
        if key not in item:
            continue
        value = item.get(key)
        if value is None or value == "":
            continue
        if isinstance(value, bool):
            value = "true" if value else "false"
        else:
            value = str(value)
        counts[value] = counts.get(value, 0) + 1
    return counts

def summary_count_by_nested_key(records, key, nested_key):
    counts = {}
    for item in records:
        nested = item.get(key)
        if not isinstance(nested, dict):
            continue
        value = nested.get(nested_key)
        if value is None or value == "":
            continue
        value = str(value)
        counts[value] = counts.get(value, 0) + 1
    return counts

command_record_summary = {
    "total_count": len(next_command_records),
    "operator_count": len(next_operator_records),
    "target_count": len(next_target_records),
    "side_counts": summary_count_by_key(next_command_records, "side"),
    "service_counts": summary_count_by_key(next_command_records, "service"),
    "purpose_counts": summary_count_by_key(next_command_records, "purpose"),
    "stage_kind_counts": summary_count_by_key(next_command_records, "stage_kind"),
    "network_counts": summary_count_by_key(next_command_records, "network"),
    "requires_explicit_target_action_counts": summary_count_by_key(next_command_records, "requires_explicit_target_action"),
    "requires_explicit_operator_action_counts": summary_count_by_key(next_command_records, "requires_explicit_operator_action"),
    "executes_operator_supplied_commands_counts": summary_count_by_key(next_command_records, "executes_operator_supplied_commands"),
    "executes_on_target_counts": summary_count_by_key(next_command_records, "executes_on_target"),
    "compatibility_label_counts": summary_count_by_nested_key(next_command_records, "compatibility", "label"),
    "target_network_count": sum(1 for item in next_target_records if item.get("network") is True),
    "operator_listener_count": sum(1 for item in next_operator_records if item.get("starts_listener") is True),
    "target_requires_explicit_action_count": sum(1 for item in next_target_records if item.get("requires_explicit_target_action") is True),
    "target_executes_operator_supplied_commands_count": sum(1 for item in next_target_records if item.get("executes_operator_supplied_commands") is True),
    "operator_executes_on_target_count": sum(1 for item in next_operator_records if item.get("executes_on_target") is True),
    "target_staged_fetch_count": sum(1 for item in next_target_records if item.get("request_name")),
    "all_target_commands_require_explicit_action": all(item.get("requires_explicit_target_action") is True for item in next_target_records),
    "all_operator_commands_require_explicit_action": all(item.get("requires_explicit_operator_action") is True for item in next_operator_records),
    "any_operator_command_executes_on_target": any(item.get("executes_on_target") is True for item in next_operator_records),
    "any_target_command_executes_operator_supplied_commands": any(item.get("executes_operator_supplied_commands") is True for item in next_target_records),
}
next_command_records_by_side = {
    "operator": next_operator_records,
    "target": next_target_records,
}
next_command_records_by_service = {}
next_command_records_by_purpose = {}
next_command_records_by_side_service = {}
next_command_records_by_service_purpose = {}
next_command_records_by_request = {}
next_command_records_by_stage_kind = {}
next_command_records_by_source_path = {}
next_command_records_by_network = {}
next_command_records_by_requires_explicit_target_action = {}
next_command_records_by_requires_explicit_operator_action = {}
next_command_records_by_executes_operator_supplied_commands = {}
next_command_records_by_executes_on_target = {}
for item in next_command_records:
    service = item.get("service") or ""
    purpose = item.get("purpose") or ""
    side = item.get("side") or ""
    request_name = item.get("request_name") or ""
    stage_kind = item.get("stage_kind") or ""
    source_path = item.get("source_path") or ""
    if service:
        next_command_records_by_service.setdefault(service, []).append(item)
    if purpose:
        next_command_records_by_purpose.setdefault(purpose, []).append(item)
    if request_name:
        next_command_records_by_request[request_name] = item
    if stage_kind:
        next_command_records_by_stage_kind.setdefault(stage_kind, []).append(item)
    if source_path:
        next_command_records_by_source_path.setdefault(source_path, []).append(item)
    if side and service:
        next_command_records_by_side_service.setdefault(f"{side}:{service}", []).append(item)
    if service and purpose:
        next_command_records_by_service_purpose.setdefault(f"{service}:{purpose}", []).append(item)
    if "network" in item:
        next_command_records_by_network.setdefault("true" if item.get("network") is True else "false", []).append(item)
    if "requires_explicit_target_action" in item:
        key = "true" if item.get("requires_explicit_target_action") is True else "false"
        next_command_records_by_requires_explicit_target_action.setdefault(key, []).append(item)
    if "requires_explicit_operator_action" in item:
        key = "true" if item.get("requires_explicit_operator_action") is True else "false"
        next_command_records_by_requires_explicit_operator_action.setdefault(key, []).append(item)
    if "executes_operator_supplied_commands" in item:
        key = "true" if item.get("executes_operator_supplied_commands") is True else "false"
        next_command_records_by_executes_operator_supplied_commands.setdefault(key, []).append(item)
    if "executes_on_target" in item:
        key = "true" if item.get("executes_on_target") is True else "false"
        next_command_records_by_executes_on_target.setdefault(key, []).append(item)

def api_collection_record(name, records, indexes, summary_key, primary_key=""):
    return {
        "name": name,
        "count": len(records),
        "count_summary_key": summary_key,
        "primary_key": primary_key,
        "indexes": list(indexes),
        "summary_key": summary_key,
    }

def api_resource_records(api_collections):
    resources = []
    for name in sorted(api_collections):
        collection = api_collections.get(name) or {}
        resources.append({
            "name": name,
            "collection_key": f"api_collections.{name}",
            "records_key": name,
            "count": int(collection.get("count") or 0),
            "summary_key": collection.get("summary_key") or collection.get("count_summary_key") or "",
            "count_summary_key": collection.get("count_summary_key") or collection.get("summary_key") or "",
            "primary_key": collection.get("primary_key") or "",
            "indexes": collection.get("indexes") or [],
        })
    return resources

def api_resource_indexes(resources):
    by_name = {}
    by_records_key = {}
    by_summary_key = {}
    for rec in resources:
        name = rec.get("name") or ""
        records_key = rec.get("records_key") or ""
        summary_key = rec.get("summary_key") or ""
        if name:
            by_name[name] = rec
        if records_key:
            by_records_key.setdefault(records_key, []).append(rec)
        if summary_key:
            by_summary_key.setdefault(summary_key, []).append(rec)
    return by_name, by_records_key, by_summary_key

def records_by_key(records, key):
    grouped = {}
    for rec in records:
        value = rec.get(key)
        if value in (None, ""):
            continue
        grouped.setdefault(str(value), []).append(rec)
    return grouped

selected_tool_provider_status_records = []
for tool, status in sorted(selected_tool_provider_status.items()):
    record = {
        "tool": str(tool),
        "overall": "",
        "status": "",
        "selected_artifact": env("SELECTED_ARTIFACT"),
    }
    if isinstance(status, dict):
        record.update(status)
        record["overall"] = str(status.get("overall") or status.get("status") or "unknown")
        record["status"] = str(status.get("status") or status.get("overall") or "unknown")
    else:
        record["overall"] = str(status)
        record["status"] = str(status)
        record["value"] = status
    selected_tool_provider_status_records.append(record)

selected_tool_provider_status_by_tool = records_by_key(selected_tool_provider_status_records, "tool")
selected_tool_provider_status_by_overall = records_by_key(selected_tool_provider_status_records, "overall")
selected_doom_wad_records = []
for index, wad in enumerate(selected_doom_wads):
    if isinstance(wad, dict):
        record = dict(wad)
    else:
        record = {"value": wad}
    record["index"] = index
    record["filename"] = str(record.get("filename") or "")
    record["sha256"] = str(record.get("sha256") or "")
    record["selected_artifact"] = env("SELECTED_ARTIFACT")
    selected_doom_wad_records.append(record)
selected_doom_wads_by_filename = records_by_key(selected_doom_wad_records, "filename")
selected_doom_wads_by_sha256 = records_by_key(selected_doom_wad_records, "sha256")

recommendation_summary = {}
recommendation_compatibility = {"label": "", "reasons": []}
recommendation_path = env("RECOMMENDATION_JSON")
if recommendation_path and os.path.exists(recommendation_path):
    try:
        with open(recommendation_path, "r", encoding="utf-8") as fh:
            recommendation_doc = json.load(fh)
        recs = recommendation_doc.get("recommendations") or {}
        facts = recommendation_doc.get("facts") or {}
        compat = recommendation_doc.get("compatibility") if isinstance(recommendation_doc, dict) else {}
        if not isinstance(compat, dict):
            compat = {}
        compat_reasons = compat.get("reasons")
        if not isinstance(compat_reasons, list):
            compat_reasons = []
        recommendation_compatibility = {
            "schema": int(compat.get("schema") or 1),
            "label": str(compat.get("label") or ""),
            "reasons": [str(item) for item in compat_reasons if item not in (None, "")],
        }
        recommendation_summary = {
            "warnings": recommendation_doc.get("warnings") or [],
            "compatibility": recommendation_compatibility,
            "facts": {
                "arch": facts.get("arch", ""),
                "libc": facts.get("libc", ""),
                "kernel_floor": facts.get("kernel_floor", ""),
                "endianness": facts.get("endianness", ""),
                "payload_possible": facts.get("payload_possible", ""),
                "recommended_extract_dir": facts.get("recommended_extract_dir", ""),
                "reality": facts.get("reality") or {},
            },
            "config": {
                key: recs.get(key, "")
                for key in (
                    "BB_TARGET_PRESET",
                    "BB_PAYLOAD_PRESET",
                    "BB_RUNTIME_MODE",
                    "BB_RUNTIME_ROOT",
                    "BB_RSHELL_TRANSPORT",
                    "BB_ZERO_ARG_MODE",
                )
            },
        }
    except Exception as exc:
        recommendation_summary = {"warning": f"could not parse recommendation JSON: {exc}"}

reality_summary = {}
reality_path = env("REALITY_JSON")
if reality_path and os.path.exists(reality_path):
    try:
        with open(reality_path, "r", encoding="utf-8") as fh:
            reality_doc = json.load(fh)
        if isinstance(reality_doc, dict):
            checks = reality_doc.get("checks") if isinstance(reality_doc.get("checks"), list) else []
            summary_obj = reality_doc.get("summary") if isinstance(reality_doc.get("summary"), dict) else {}
            api_obj = reality_doc.get("api_collections") if isinstance(reality_doc.get("api_collections"), dict) else {}
            reality_summary = {
                "source": reality_path,
                "check_count": int(summary_obj.get("check_count") or len(checks)),
                "pass": int(summary_obj.get("pass") or 0),
                "fail": int(summary_obj.get("fail") or 0),
                "skipped": int(summary_obj.get("skipped") or 0),
                "capability_pass": int(summary_obj.get("capability_pass") or 0),
                "capability_fail": int(summary_obj.get("capability_fail") or 0),
                "operator_pass": int(summary_obj.get("operator_pass") or 0),
                "operator_fail": int(summary_obj.get("operator_fail") or 0),
                "operator_skipped": int(summary_obj.get("operator_skipped") or 0),
                "constraints": summary_obj.get("constraints") if isinstance(summary_obj.get("constraints"), dict) else {},
                "checks_by_name": reality_doc.get("checks_by_name") if isinstance(reality_doc.get("checks_by_name"), dict) else {},
                "checks_by_status": reality_doc.get("checks_by_status") if isinstance(reality_doc.get("checks_by_status"), dict) else {},
                "checks_by_type": reality_doc.get("checks_by_type") if isinstance(reality_doc.get("checks_by_type"), dict) else {},
                "checks_by_skipped": reality_doc.get("checks_by_skipped") if isinstance(reality_doc.get("checks_by_skipped"), dict) else {},
                "checks_by_available": reality_doc.get("checks_by_available") if isinstance(reality_doc.get("checks_by_available"), dict) else {},
                "checks_by_detected": reality_doc.get("checks_by_detected") if isinstance(reality_doc.get("checks_by_detected"), dict) else {},
                "api_collections": api_obj,
            }
    except Exception as exc:
        reality_summary = {"source": reality_path, "warning": f"could not parse reality-test JSON: {exc}"}

release_self_test_summary = {}
release_self_test_path = env("RELEASE_SELF_TEST_JSON")
if release_self_test_path and os.path.exists(release_self_test_path):
