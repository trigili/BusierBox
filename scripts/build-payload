#!/bin/sh
set -eu

TARGET=${TARGET:-native}
_pf_from_env=${PAYLOAD_FORMAT:-}
_ver_from_env=${BUSIERBOX_PAYLOAD_VERSION:-}
_runtime_from_env=${BB_RUNTIME_MODE:-}
_dotfiles_enable_from_env=${BB_DOTFILES_ENABLE:-}
_dot_zsh_mode_from_env=${BB_DOTFILE_ZSH_MODE:-}
_dot_zsh_file_from_env=${BB_DOTFILE_ZSH_USER_FILE:-}
_dot_tmux_mode_from_env=${BB_DOTFILE_TMUX_MODE:-}
_dot_tmux_file_from_env=${BB_DOTFILE_TMUX_USER_FILE:-}
_dot_gdb_mode_from_env=${BB_DOTFILE_GDB_MODE:-}
_dot_gdb_file_from_env=${BB_DOTFILE_GDB_USER_FILE:-}
_dot_profile_mode_from_env=${BB_DOTFILE_PROFILE_MODE:-}
_dot_profile_file_from_env=${BB_DOTFILE_PROFILE_USER_FILE:-}
PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-tgz}

if [ "$TARGET" != "native" ]; then
    TARGET="$TARGET" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" scripts/buildroot-build-payload
    exit $?
fi

mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home dist
if [ ! -x runtime/payload/bin/busybox ]; then
    printf '%s\n' "runtime/payload/bin/busybox missing; run make busybox first" >&2
    exit 1
fi
busybox_tmp="runtime/busybox.$$"
cp runtime/payload/bin/busybox "$busybox_tmp"
rm -rf runtime/payload
mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home
mv "$busybox_tmp" runtime/payload/bin/busybox
chmod 0755 runtime/payload/bin/busybox

# Read config if it exists
config=${BUSIERBOX_CONFIG:-configs/busierbox.conf}
if [ -f "$config" ]; then
    . "$config"
fi

# Resolve version and format: env > config file > built-in default
VERSION=${_ver_from_env:-${BB_PAYLOAD_VERSION:-dev}}
PAYLOAD_FORMAT=${_pf_from_env:-${BB_PAYLOAD_FORMAT:-tgz}}
printf '%s\n' "$VERSION" >runtime/payload/VERSION

BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:-}"
BB_DROPBEAR_SERVER_MODE="${BB_DROPBEAR_SERVER_MODE:-no}"
BB_DROPBEAR_BIND_HOST="${BB_DROPBEAR_BIND_HOST:-0.0.0.0}"
BB_DROPBEAR_LISTEN_PORT="${BB_DROPBEAR_LISTEN_PORT:-22}"
BB_DROPBEAR_NO_PASSWORD_AUTH="${BB_DROPBEAR_NO_PASSWORD_AUTH:-no}"
BB_DROPBEAR_NO_ROOT_PASSWORD="${BB_DROPBEAR_NO_ROOT_PASSWORD:-no}"
BB_DROPBEAR_AUTHORIZED_KEYS_FILE="${BB_DROPBEAR_AUTHORIZED_KEYS_FILE:-}"
BB_DROPBEAR_PREGENERATE_HOSTKEY="${BB_DROPBEAR_PREGENERATE_HOSTKEY:-no}"
BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:-rsa}"
BB_OPERATOR_DBCLIENT_IDENTITY_FILE="${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}"
BB_USER_OVERLAY_ENABLE="${BB_USER_OVERLAY_ENABLE:-no}"
BB_USER_OVERLAY_ROOT="${BB_USER_OVERLAY_ROOT:-}"
BB_USER_OVERLAY_ALLOW_OVERRIDE="${BB_USER_OVERLAY_ALLOW_OVERRIDE:-no}"
BB_RUNTIME_MODE="${_runtime_from_env:-${BB_RUNTIME_MODE:-extract}}"
BB_TARGET_NAME="${BB_TARGET_NAME:-$TARGET}"
BB_TARGET_ARCH="${BB_TARGET_ARCH:-native}"
BB_TARGET_LIBC="${BB_TARGET_LIBC:-host}"
BB_GDBSERVER_PROVIDER="${BB_GDBSERVER_PROVIDER:-auto}"
BB_GDBSERVER_USER_PATH="${BB_GDBSERVER_USER_PATH:-}"
BB_DOTFILES_ENABLE="${_dotfiles_enable_from_env:-${BB_DOTFILES_ENABLE:-yes}}"
BB_DOTFILE_ZSH_MODE="${_dot_zsh_mode_from_env:-${BB_DOTFILE_ZSH_MODE:-default}}"
BB_DOTFILE_ZSH_USER_FILE="${_dot_zsh_file_from_env:-${BB_DOTFILE_ZSH_USER_FILE:-}}"
BB_DOTFILE_TMUX_MODE="${_dot_tmux_mode_from_env:-${BB_DOTFILE_TMUX_MODE:-default}}"
BB_DOTFILE_TMUX_USER_FILE="${_dot_tmux_file_from_env:-${BB_DOTFILE_TMUX_USER_FILE:-}}"
BB_DOTFILE_GDB_MODE="${_dot_gdb_mode_from_env:-${BB_DOTFILE_GDB_MODE:-default}}"
BB_DOTFILE_GDB_USER_FILE="${_dot_gdb_file_from_env:-${BB_DOTFILE_GDB_USER_FILE:-}}"
BB_DOTFILE_PROFILE_MODE="${_dot_profile_mode_from_env:-${BB_DOTFILE_PROFILE_MODE:-default}}"
BB_DOTFILE_PROFILE_USER_FILE="${_dot_profile_file_from_env:-${BB_DOTFILE_PROFILE_USER_FILE:-}}"
BB_DOOM_USER_PATH="${BB_DOOM_USER_PATH:-}"

stage_dotfiles() {
    [ "$BB_DOTFILES_ENABLE" = yes ] || return 0
    [ "$BB_RUNTIME_MODE" != core-only ] || return 0
    mkdir -p runtime/payload/home
    stage_dotfile_one profile "$BB_DOTFILE_PROFILE_MODE" "$BB_DOTFILE_PROFILE_USER_FILE" ".profile"
    stage_dotfile_one zsh "$BB_DOTFILE_ZSH_MODE" "$BB_DOTFILE_ZSH_USER_FILE" ".zshrc"
    stage_dotfile_one tmux "$BB_DOTFILE_TMUX_MODE" "$BB_DOTFILE_TMUX_USER_FILE" ".tmux.conf"
    stage_dotfile_one gdb "$BB_DOTFILE_GDB_MODE" "$BB_DOTFILE_GDB_USER_FILE" ".gdbinit"
}

stage_dotfile_one() {
    _app=$1
    _mode=$2
    _user_file=$3
    _name=$4
    case "$_mode" in
        none|"") return 0 ;;
        default)
            _src="payloads/dotfiles/$_name"
            [ -f "$_src" ] || {
                printf '%s\n' "build-payload: missing BusierBox default dotfile for $_app: $_src" >&2
                exit 1
            }
            ;;
        user)
            [ -n "$_user_file" ] && [ -f "$_user_file" ] || {
                printf '%s\n' "build-payload: $_app dotfile mode is user but file is missing: ${_user_file:-not set}" >&2
                exit 1
            }
            _src=$_user_file
            ;;
        *)
            printf '%s\n' "build-payload: invalid $_app dotfile mode: $_mode" >&2
            exit 1
            ;;
    esac
    cp "$_src" "runtime/payload/home/$_name"
}

stage_dotfiles

# Clean out unconfigured/stale files from previous builds or default template
for tool in zsh tmux strace gdbserver dropbear dbclient dropbearkey curl dropbear-bin \
    socat tcpdump rsync mtr iperf3 ethtool iw minicom mosh-client rg ripgrep jq file htop screen \
    ltrace readelf objdump lsusb lspci gdb radare2 rizin gcore tshark nmap ncat pstree openssl fd zoxide flash_erase nanddump nandwrite \
    mtd_debug ubinfo ubiattach ubidetach ubimkvol ubirmvol ubirsvol ubiupdatevol i2cdetect i2cget i2cset \
    i2cdump spidev_test spidev_fdx mmc debugfs tune2fs e2fsck lsattr chattr parted doom chocolate-doom; do
    rm -f "runtime/payload/bin/$tool"
done
rm -f runtime/payload/busybox-applets.txt runtime/payload/staged-tools.txt runtime/payload/built-tools.txt \
    runtime/payload/overlay-tools.txt runtime/payload/overlay-files.txt runtime/payload/overlay-paths.txt \
    runtime/payload/user-provided-tools.txt
mkdir -p runtime/payload/share/busierbox
: >runtime/payload/staged-tools.txt
: >runtime/payload/built-tools.txt
: >runtime/payload/overlay-tools.txt
: >runtime/payload/overlay-files.txt
: >runtime/payload/overlay-paths.txt
: >runtime/payload/user-provided-tools.txt

if ! runtime/payload/bin/busybox --list >runtime/payload/busybox-applets.txt 2>/dev/null || [ ! -s runtime/payload/busybox-applets.txt ]; then
    printf '%s\n' "build-payload: unable to discover native BusyBox applets from runtime/payload/bin/busybox --list" >&2
    exit 1
fi

stage_real_tool() {
    tool=$1
    src=$2
    dst=${3:-$tool}
    [ -n "$src" ] && [ -x "$src" ] || return 1
    cp "$src" "runtime/payload/bin/$dst"
    chmod 0755 "runtime/payload/bin/$dst"
    printf '%s\n' "$dst" >>runtime/payload/staged-tools.txt
    printf '%s\n' "$tool" >>runtime/payload/built-tools.txt
    return 0
}

stage_user_binary() {
    tool=$1
    src=$2
    dst=${3:-$tool}
    stage_real_tool "$tool" "$src" "$dst" || return 1
    printf '%s\n' "$tool" >>runtime/payload/user-provided-tools.txt
    return 0
}

dropin_tool_path() {
    _tool=$1
    for _path in \
        "local/tools/${BB_TARGET_NAME}/bin/$_tool" \
        "local/tools/${BB_TARGET_ARCH}-${BB_TARGET_LIBC}/bin/$_tool" \
        "local/tools/generic/${BB_TARGET_ARCH}/bin/$_tool"
    do
        if [ -x "$_path" ]; then
            printf '%s\n' "$_path"
            return 0
        fi
    done
    return 1
}

stage_dropin_tool() {
    _tool=$1
    _path=$(dropin_tool_path "$_tool" 2>/dev/null || true)
    [ -n "$_path" ] || return 1
    if scripts/tools/check-dropin-tool --tool "$_tool" --path "$_path" \
            --target "$BB_TARGET_NAME" --arch "$BB_TARGET_ARCH" --libc "$BB_TARGET_LIBC" >/dev/null; then
        stage_real_tool "$_tool" "$_path" "$_tool" || return 1
        printf '%s\n' "$_tool" >>runtime/payload/user-provided-tools.txt
        printf '%s\n' "build-payload: staged $_tool from local drop-in $_path"
        return 0
    fi
    return 1
}

tool_selected() {
    needle=$1
    for t in $BB_HEAVY_TOOLS; do
        [ "$t" = "$needle" ] && return 0
    done
    return 1
}

stage_host_terminfo() {
    needed=0
    tool_selected tmux && needed=1
    tool_selected screen && needed=1
    tool_selected htop && needed=1
    [ "$needed" -eq 1 ] || return 0

    for root in /usr/share/terminfo /lib/terminfo /usr/lib/terminfo; do
        [ -d "$root" ] || continue
        for term in t/tmux t/tmux-256color t/tmux-direct s/screen s/screen-256color x/xterm x/xterm-256color; do
            [ -f "$root/$term" ] || continue
            mkdir -p "runtime/payload/share/terminfo/${term%/*}"
            cp "$root/$term" "runtime/payload/share/terminfo/$term"
        done
    done
    if [ -d runtime/payload/share/terminfo ]; then
        printf '%s\n' "build-payload: staged host terminfo entries"
    else
        printf '%s\n' "build-payload: WARNING: terminal tools selected but no host terminfo entries were found" >&2
    fi
}

# Set up only selected heavy tools
for tool in zsh tmux strace gdbserver gdb dropbear curl socat tcpdump rsync mtr iperf3 ethtool iw minicom mosh-client ripgrep jq file htop screen ltrace readelf objdump usbutils pciutils nmap nmap-ncat psmisc openssl fd zoxide mtd-utils ubi-utils i2c-tools spi-tools mmc-utils e2fsprogs parted doom; do
    if tool_selected "$tool"; then
        if [ "$tool" = gdbserver ]; then
            case "$BB_GDBSERVER_PROVIDER" in
                none)
                    ;;
                user)
                    if [ -n "$BB_GDBSERVER_USER_PATH" ]; then
                        stage_user_binary gdbserver "$BB_GDBSERVER_USER_PATH" gdbserver || {
                            printf '%s\n' "build-payload: WARNING: BB_GDBSERVER_USER_PATH is not executable: $BB_GDBSERVER_USER_PATH" >&2
                        }
                    else
                        printf '%s\n' "build-payload: WARNING: BB_GDBSERVER_PROVIDER=user but BB_GDBSERVER_USER_PATH is empty" >&2
                    fi
                    ;;
                local-dropin)
                    stage_dropin_tool gdbserver || printf '%s\n' "build-payload: WARNING: no compatible local drop-in gdbserver found" >&2
                    ;;
                auto)
                    stage_dropin_tool gdbserver || {
                        command -v gdbserver >/dev/null 2>&1 && stage_real_tool gdbserver "$(command -v gdbserver)" gdbserver || true
                    }
                    ;;
                buildroot|overlay)
                    printf '%s\n' "build-payload: gdbserver provider $BB_GDBSERVER_PROVIDER is not used by native build-payload; use local-dropin or user for native payloads" >&2
                    ;;
                *)
                    printf '%s\n' "build-payload: WARNING: unknown gdbserver provider: $BB_GDBSERVER_PROVIDER" >&2
                    ;;
            esac
        elif [ "$tool" = gdb ]; then
            stage_dropin_tool gdb || true
        elif [ "$tool" = ripgrep ] && command -v rg >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v rg)" rg || true
        elif [ "$tool" = usbutils ] && command -v lsusb >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v lsusb)" lsusb || true
        elif [ "$tool" = pciutils ] && command -v lspci >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v lspci)" lspci || true
        elif [ "$tool" = nmap-ncat ] && command -v ncat >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v ncat)" ncat || true
        elif [ "$tool" = psmisc ] && command -v pstree >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v pstree)" pstree || true
        elif [ "$tool" = mtd-utils ]; then
            for mtd_tool in flash_erase nanddump nandwrite mtd_debug; do
                command -v "$mtd_tool" >/dev/null 2>&1 && stage_real_tool "$tool" "$(command -v "$mtd_tool")" "$mtd_tool" || true
            done
        elif [ "$tool" = ubi-utils ]; then
            for ubi_tool in ubinfo ubiattach ubidetach ubimkvol ubirmvol ubirsvol ubiupdatevol; do
                command -v "$ubi_tool" >/dev/null 2>&1 && stage_real_tool "$tool" "$(command -v "$ubi_tool")" "$ubi_tool" || true
            done
        elif [ "$tool" = i2c-tools ]; then
            for i2c_tool in i2cdetect i2cget i2cset i2cdump; do
                command -v "$i2c_tool" >/dev/null 2>&1 && stage_real_tool "$tool" "$(command -v "$i2c_tool")" "$i2c_tool" || true
            done
        elif [ "$tool" = spi-tools ]; then
            for spi_tool in spidev_test spidev_fdx; do
                command -v "$spi_tool" >/dev/null 2>&1 && stage_real_tool "$tool" "$(command -v "$spi_tool")" "$spi_tool" || true
            done
        elif [ "$tool" = mmc-utils ] && command -v mmc >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v mmc)" mmc || true
        elif [ "$tool" = e2fsprogs ]; then
            for e2_tool in debugfs tune2fs e2fsck lsattr chattr; do
                command -v "$e2_tool" >/dev/null 2>&1 && stage_real_tool "$tool" "$(command -v "$e2_tool")" "$e2_tool" || true
            done
        elif [ "$tool" = doom ] && [ -n "$BB_DOOM_USER_PATH" ]; then
            stage_user_binary "$tool" "$BB_DOOM_USER_PATH" doom || {
                printf '%s\n' "build-payload: WARNING: BB_DOOM_USER_PATH is not executable: $BB_DOOM_USER_PATH" >&2
            }
        elif [ "$tool" = doom ] && command -v doom >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v doom)" doom || true
        elif [ "$tool" = doom ] && command -v chocolate-doom >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v chocolate-doom)" doom || true
        elif [ "$tool" = dropbear ]; then
            for dropbear_tool in dropbear dbclient dropbearkey; do
                if command -v "$dropbear_tool" >/dev/null 2>&1; then
                    stage_real_tool "$tool" "$(command -v "$dropbear_tool")" "$dropbear_tool" || true
                fi
            done
        elif command -v "$tool" >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v "$tool")" "$tool" || true
        fi
    fi
done

sort -u runtime/payload/staged-tools.txt -o runtime/payload/staged-tools.txt
sort -u runtime/payload/built-tools.txt -o runtime/payload/built-tools.txt

# Dropbear: stage authorized_keys from host if configured
if tool_selected dropbear && [ -n "$BB_DROPBEAR_AUTHORIZED_KEYS_FILE" ]; then
    if [ -f "$BB_DROPBEAR_AUTHORIZED_KEYS_FILE" ]; then
        mkdir -p runtime/payload/home/.ssh
        cp "$BB_DROPBEAR_AUTHORIZED_KEYS_FILE" runtime/payload/home/.ssh/authorized_keys
        chmod 600 runtime/payload/home/.ssh/authorized_keys
        printf '%s\n' "build-payload: staged authorized_keys from $BB_DROPBEAR_AUTHORIZED_KEYS_FILE"
    else
        printf '%s\n' "build-payload: WARNING: BB_DROPBEAR_AUTHORIZED_KEYS_FILE not found: $BB_DROPBEAR_AUTHORIZED_KEYS_FILE" >&2
    fi
fi

if tool_selected dropbear && [ -n "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" ]; then
    if [ -f "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" ]; then
        mkdir -p runtime/payload/home/.ssh
        cp "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" runtime/payload/home/.ssh/id_dbclient
        chmod 600 runtime/payload/home/.ssh/id_dbclient
        printf '%s\n' "build-payload: staged dbclient identity from $BB_OPERATOR_DBCLIENT_IDENTITY_FILE"
    else
        printf '%s\n' "build-payload: WARNING: BB_OPERATOR_DBCLIENT_IDENTITY_FILE not found: $BB_OPERATOR_DBCLIENT_IDENTITY_FILE" >&2
    fi
fi

# Dropbear: pre-generate host key at build time
if tool_selected dropbear && [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ]; then
    mkdir -p runtime/payload/etc/dropbear
    for _kt in $BB_DROPBEAR_KEYTYPES; do
        _kf="runtime/payload/etc/dropbear/dropbear_${_kt}_host_key"
        if [ ! -f "$_kf" ]; then
            if command -v dropbearkey >/dev/null 2>&1; then
                dropbearkey -t "$_kt" -f "$_kf"
                printf '%s\n' "build-payload: generated dropbear $_kt host key"
            else
                printf '%s\n' "build-payload: WARNING: dropbearkey not found; skipping $_kt host key generation" >&2
            fi
        fi
    done
fi

# Dropbear: generate server startup wrapper when server mode is enabled
if tool_selected dropbear && [ "$BB_DROPBEAR_SERVER_MODE" = yes ]; then
    mkdir -p runtime/payload/etc/dropbear
    _db_flags="-p ${BB_DROPBEAR_BIND_HOST}:${BB_DROPBEAR_LISTEN_PORT}"
    [ "$BB_DROPBEAR_NO_PASSWORD_AUTH" = yes ] && _db_flags="$_db_flags -s"
    [ "$BB_DROPBEAR_NO_ROOT_PASSWORD" = yes ]  && _db_flags="$_db_flags -g"
    {
        printf '#!/bin/sh\n'
        printf 'PAYLOAD_DIR="${BUSIERBOX_PAYLOAD_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"\n'
        printf 'DROPBEAR="$PAYLOAD_DIR/bin/dropbear"\n'
        printf 'DROPBEARKEY="$PAYLOAD_DIR/bin/dropbearkey"\n'
        printf 'ETC="$PAYLOAD_DIR/etc/dropbear"\n'
        printf 'mkdir -p "$ETC"\n'
        printf 'for kt in %s; do\n' "$BB_DROPBEAR_KEYTYPES"
        printf '    kf="$ETC/dropbear_${kt}_host_key"\n'
        printf '    [ -f "$kf" ] || "$DROPBEARKEY" -t "$kt" -f "$kf" >/dev/null 2>&1 || true\n'
        printf 'done\n'
        printf 'exec "$DROPBEAR" %s "$@"\n' "$_db_flags"
    } >runtime/payload/bin/dropbear-start
    chmod 0755 runtime/payload/bin/dropbear-start
    printf '%s\n' "build-payload: generated dropbear-start (listen=${BB_DROPBEAR_BIND_HOST}:${BB_DROPBEAR_LISTEN_PORT})"
fi

apply_overlay() {
    [ "$BB_USER_OVERLAY_ENABLE" = "yes" ] || return 0
    [ -n "$BB_USER_OVERLAY_ROOT" ] || return 0
    if [ ! -d "$BB_USER_OVERLAY_ROOT" ]; then
        printf '%s\n' "build-payload: WARNING: overlay root not found: $BB_USER_OVERLAY_ROOT" >&2
        return 0
    fi
    _applied=0
    for _subdir in bin lib share home etc; do
        _src="$BB_USER_OVERLAY_ROOT/$_subdir"
        [ -d "$_src" ] || continue
        mkdir -p "runtime/payload/$_subdir"
        for _f in "$_src/"*; do
            [ -e "$_f" ] || continue
            _fname="${_f##*/}"
            case "$_fname" in
                .git|.gitignore|.gitmodules|*.swp|*~|.DS_Store|.keep|.gitkeep|THIS_IS_YOUR_ROOT_FILESYSTEM) continue ;;
            esac
            _target="runtime/payload/$_subdir/$_fname"
            if [ -e "$_target" ] && [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" != "yes" ]; then
                printf '%s\n' "build-payload: overlay conflict (not overwriting): $_subdir/$_fname" >&2
                continue
            fi
            cp "$_f" "$_target" || continue
            [ "$_subdir" = "bin" ] && chmod 0755 "$_target"
            printf '%s\n' "$_subdir/$_fname" >>runtime/payload/overlay-files.txt
            [ "$_subdir" = "bin" ] && printf '%s\n' "$_fname" >>runtime/payload/overlay-tools.txt
            _applied=$((_applied + 1))
        done
    done
    [ "$_applied" -gt 0 ] && printf '%s\n' "$BB_USER_OVERLAY_ROOT" >>runtime/payload/overlay-paths.txt
    _toverlay="$BB_USER_OVERLAY_ROOT/native"
    if [ -d "$_toverlay" ]; then
        _target_applied=0
        for _subdir in bin lib share home etc; do
            _src="$_toverlay/$_subdir"
            [ -d "$_src" ] || continue
            mkdir -p "runtime/payload/$_subdir"
            for _f in "$_src/"*; do
                [ -e "$_f" ] || continue
                _fname="${_f##*/}"
                case "$_fname" in
                    .git|.gitignore|.gitmodules|*.swp|*~|.DS_Store|.keep|.gitkeep|THIS_IS_YOUR_ROOT_FILESYSTEM) continue ;;
                esac
                _target="runtime/payload/$_subdir/$_fname"
                if [ -e "$_target" ] && [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" != "yes" ]; then
                    printf '%s\n' "build-payload: overlay conflict (not overwriting): native/$_subdir/$_fname" >&2
                    continue
                fi
                cp "$_f" "$_target" || continue
                [ "$_subdir" = "bin" ] && chmod 0755 "$_target"
                printf '%s\n' "native/$_subdir/$_fname" >>runtime/payload/overlay-files.txt
                [ "$_subdir" = "bin" ] && printf '%s\n' "$_fname" >>runtime/payload/overlay-tools.txt
                _target_applied=$((_target_applied + 1))
                _applied=$((_applied + 1))
            done
        done
        [ "$_target_applied" -gt 0 ] && printf '%s\n' "$_toverlay" >>runtime/payload/overlay-paths.txt
    fi
    [ "$_applied" -gt 0 ] && printf '%s\n' "build-payload: overlay applied from $BB_USER_OVERLAY_ROOT ($_applied files)"
    return 0
}

apply_overlay
scripts/install-busybox-symlinks runtime/payload
stage_host_terminfo

if tool_selected doom && [ -e runtime/payload/bin/chocolate-doom ] && [ ! -e runtime/payload/bin/doom ]; then
    cp runtime/payload/bin/chocolate-doom runtime/payload/bin/doom
    chmod 0755 runtime/payload/bin/doom
    printf '%s\n' "doom" >>runtime/payload/overlay-tools.txt
fi

for tool in xxd doom gdb radare2 rizin gcore tshark; do
    if tool_selected "$tool" && [ -e "runtime/payload/bin/$tool" ]; then
        printf '%s\n' "$tool" >>runtime/payload/staged-tools.txt
        printf '%s\n' "$tool" >>runtime/payload/built-tools.txt
    fi
done
sort -u runtime/payload/staged-tools.txt -o runtime/payload/staged-tools.txt
sort -u runtime/payload/built-tools.txt -o runtime/payload/built-tools.txt
sort -u runtime/payload/overlay-tools.txt -o runtime/payload/overlay-tools.txt
sort -u runtime/payload/overlay-files.txt -o runtime/payload/overlay-files.txt
sort -u runtime/payload/overlay-paths.txt -o runtime/payload/overlay-paths.txt
sort -u runtime/payload/user-provided-tools.txt -o runtime/payload/user-provided-tools.txt

payload_sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf '%s\n' unknown
    fi
}

make_payload_archives() {
    rm -f dist/payload.tar dist/payload.tar.gz
    if tar --version 2>/dev/null | grep -qi 'GNU tar'; then
        tar --format=ustar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' -C runtime -cf dist/payload.tar payload
    elif tar --format=ustar -cf /dev/null -C runtime payload >/dev/null 2>&1; then
        tar --format=ustar -C runtime -cf dist/payload.tar payload
    else
        printf '%s\n' "build-payload: tar does not support --format=ustar; refusing to create payload for the built-in extractor" >&2
        exit 1
    fi
    scripts/check-payload-tar dist/payload.tar
    if command -v gzip >/dev/null 2>&1; then
        gzip -n -c dist/payload.tar >dist/payload.tar.gz
    else
        printf '%s\n' "build-payload: gzip is required for PAYLOAD_FORMAT=tgz" >&2
        [ "$PAYLOAD_FORMAT" = "tar" ] || exit 1
    fi
}

static_status=dynamic
if command -v file >/dev/null 2>&1 && file runtime/payload/bin/busybox | grep -qi 'statically linked'; then
    static_status=static
fi
busybox_version=$(runtime/payload/bin/busybox 2>&1 | sed -n 's/^BusyBox v\([^ ]*\).*/\1/p' | sed -n '1p')
[ -n "$busybox_version" ] || busybox_version=unknown
scripts/write-payload-manifest --target native --arch native --libc host --kernel-floor host --busybox-version "$busybox_version" --static-status "$static_status" --payload-sha256 pending --requested-tools "$BB_HEAVY_TOOLS" --gdbserver-provider "$BB_GDBSERVER_PROVIDER"
make_payload_archives
if [ "$PAYLOAD_FORMAT" = "tar" ]; then
    selected=dist/payload.tar
else
    selected=dist/payload.tar.gz
fi
sha=$(payload_sha "$selected")
scripts/write-payload-manifest --target native --arch native --libc host --kernel-floor host --busybox-version "$busybox_version" --static-status "$static_status" --payload-sha256 "$sha" --requested-tools "$BB_HEAVY_TOOLS" --gdbserver-provider "$BB_GDBSERVER_PROVIDER"
make_payload_archives
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && sha256sum dist/payload.tar.gz >dist/payload.tar.gz.sha256
elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && shasum -a 256 dist/payload.tar.gz >dist/payload.tar.gz.sha256
else
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.sha256
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.gz.sha256
fi
printf '%s\n' "created dist/payload.tar and dist/payload.tar.gz"
