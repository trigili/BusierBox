#!/bin/sh
set -eu

TARGET=${TARGET:-native}
VERSION=${BUSIERBOX_PAYLOAD_VERSION:-dev}
PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-tgz}

if [ "$TARGET" != "native" ]; then
    TARGET="$TARGET" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" scripts/buildroot-build-payload
    exit $?
fi

mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home dist
if [ ! -x runtime/payload/bin/busybox ]; then
    printf '%s\n' "runtime/payload/bin/busybox missing; run make busybox first" >&2
    exit 1
fi
printf '%s\n' "$VERSION" >runtime/payload/VERSION
cp payloads/dotfiles/.profile runtime/payload/home/.profile
cp payloads/dotfiles/.tmux.conf runtime/payload/home/.tmux.conf
cp payloads/dotfiles/.zshrc runtime/payload/home/.zshrc
cp payloads/dotfiles/.gdbinit runtime/payload/home/.gdbinit

# Read config if it exists
if [ -f configs/busierbox.conf ]; then
    . configs/busierbox.conf
fi
BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:-}"
BB_DROPBEAR_SERVER_MODE="${BB_DROPBEAR_SERVER_MODE:-no}"

# Clean out unconfigured/stale files from previous builds or default template
for tool in zsh tmux strace gdbserver dropbear curl dropbear-bin; do
    rm -f "runtime/payload/bin/$tool"
done

# Set up only selected heavy tools
for tool in zsh tmux strace gdbserver dropbear curl; do
    configured=0
    for t in $BB_HEAVY_TOOLS; do
        if [ "$t" = "$tool" ]; then
            configured=1
            break
        fi
    done

    if [ "$configured" = 1 ]; then
        host_bin=""
        if command -v "$tool" >/dev/null 2>&1; then
            host_bin=$(command -v "$tool")
        fi

        if [ "$tool" = "dropbear" ] && [ "$BB_DROPBEAR_SERVER_MODE" = "yes" ]; then
            if [ -n "$host_bin" ]; then
                cp "$host_bin" "runtime/payload/bin/dropbear-bin"
            else
                printf '%s\n' "#!/bin/sh" >"runtime/payload/bin/dropbear-bin"
                printf '%s\n' "echo 'mock dropbear-bin server running'" >>"runtime/payload/bin/dropbear-bin"
                chmod 0755 "runtime/payload/bin/dropbear-bin"
            fi

            cat >"runtime/payload/bin/dropbear" <<'EOF'
#!/bin/sh
ETC_DIR="${BBX_RUNTIME:-.busierbox}/etc/dropbear"
mkdir -p "$ETC_DIR"
if [ ! -f "$ETC_DIR/dropbear_rsa_host_key" ]; then
    echo "dropbear wrapper: generating RSA host key..." >&2
    if [ -x "$(dirname "$0")/dropbearkey" ]; then
        "$(dirname "$0")/dropbearkey" -t rsa -f "$ETC_DIR/dropbear_rsa_host_key" >/dev/null 2>&1 || true
    elif command -v dropbearkey >/dev/null 2>&1; then
        dropbearkey -t rsa -f "$ETC_DIR/dropbear_rsa_host_key" >/dev/null 2>&1 || true
    fi
fi
real_bin="$(dirname "$0")/dropbear-bin"
if [ -x "$real_bin" ]; then
    exec "$real_bin" -r "$ETC_DIR/dropbear_rsa_host_key" -F -E "$@"
else
    exec dropbear -r "$ETC_DIR/dropbear_rsa_host_key" -F -E "$@"
fi
EOF
            chmod 0755 "runtime/payload/bin/dropbear"
        else
            if [ -n "$host_bin" ]; then
                cp "$host_bin" "runtime/payload/bin/$tool"
            else
                printf '%s\n' "#!/bin/sh" >"runtime/payload/bin/$tool"
                printf '%s\n' "echo 'mock heavy tool: $tool'" >>"runtime/payload/bin/$tool"
                chmod 0755 "runtime/payload/bin/$tool"
            fi
        fi
    fi
done

payload_sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf '%s\n' unknown
    fi
}

make_payload_archives() {
    rm -f dist/payload.tar dist/payload.tar.gz
    if tar --version 2>/dev/null | grep -qi 'GNU tar'; then
        tar --format=ustar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' -C runtime -cf dist/payload.tar payload
    elif tar --format=ustar -cf /dev/null -C runtime payload >/dev/null 2>&1; then
        tar --format=ustar -C runtime -cf dist/payload.tar payload
    else
        printf '%s\n' "build-payload: tar does not support --format=ustar; refusing to create payload for the built-in extractor" >&2
        exit 1
    fi
    scripts/check-payload-tar dist/payload.tar
    if command -v gzip >/dev/null 2>&1; then
        gzip -n -c dist/payload.tar >dist/payload.tar.gz
    else
        printf '%s\n' "build-payload: gzip is required for PAYLOAD_FORMAT=tgz" >&2
        [ "$PAYLOAD_FORMAT" = "tar" ] || exit 1
    fi
}

static_status=dynamic
if command -v file >/dev/null 2>&1 && file runtime/payload/bin/busybox | grep -qi 'statically linked'; then
    static_status=static
fi
busybox_version=$(runtime/payload/bin/busybox 2>&1 | sed -n 's/^BusyBox v\([^ ]*\).*/\1/p' | sed -n '1p')
[ -n "$busybox_version" ] || busybox_version=unknown
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

tools_json='"busybox"'
for t in $BB_HEAVY_TOOLS; do
    tools_json="$tools_json, \"$t\""
done

cat >runtime/payload/manifest.json <<EOF_MANIFEST
{
  "target": "native",
  "arch": "native",
  "libc": "host",
  "kernel_floor": "host",
  "build_timestamp": "$timestamp",
  "busybox_version": "$busybox_version",
  "static_status": "$static_status",
  "included_payload_tools": [$tools_json],
  "included_shared_libs": [],
  "payload_sha256": "pending"
}
EOF_MANIFEST
make_payload_archives
if [ "$PAYLOAD_FORMAT" = "tar" ]; then
    selected=dist/payload.tar
else
    selected=dist/payload.tar.gz
fi
sha=$(payload_sha "$selected")
sed "s/\"payload_sha256\": \"pending\"/\"payload_sha256\": \"$sha\"/" runtime/payload/manifest.json >runtime/payload/manifest.json.tmp
mv runtime/payload/manifest.json.tmp runtime/payload/manifest.json
make_payload_archives
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && sha256sum dist/payload.tar.gz >dist/payload.tar.gz.sha256
elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && shasum -a 256 dist/payload.tar.gz >dist/payload.tar.gz.sha256
else
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.sha256
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.gz.sha256
fi
printf '%s\n' "created dist/payload.tar and dist/payload.tar.gz"
