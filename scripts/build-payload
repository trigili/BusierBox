#!/bin/sh
set -eu

TARGET=${TARGET:-native}
VERSION=${BUSIERBOX_PAYLOAD_VERSION:-dev}
PAYLOAD_FORMAT=${PAYLOAD_FORMAT:-tgz}

if [ "$TARGET" != "native" ]; then
    TARGET="$TARGET" PAYLOAD_FORMAT="$PAYLOAD_FORMAT" scripts/buildroot-build-payload
    exit $?
fi

mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home dist
if [ ! -x runtime/payload/bin/busybox ]; then
    printf '%s\n' "runtime/payload/bin/busybox missing; run make busybox first" >&2
    exit 1
fi
busybox_tmp="runtime/busybox.$$"
cp runtime/payload/bin/busybox "$busybox_tmp"
rm -rf runtime/payload
mkdir -p runtime/payload/bin runtime/payload/lib runtime/payload/share runtime/payload/home
mv "$busybox_tmp" runtime/payload/bin/busybox
chmod 0755 runtime/payload/bin/busybox
printf '%s\n' "$VERSION" >runtime/payload/VERSION

# Read config if it exists
config=${BUSIERBOX_CONFIG:-configs/busierbox.conf}
if [ -f "$config" ]; then
    . "$config"
fi
BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:-}"
BB_DROPBEAR_SERVER_MODE="${BB_DROPBEAR_SERVER_MODE:-no}"
BB_DOTFILE_PROFILE="${BB_DOTFILE_PROFILE:-default-comfort}"
BB_DOTFILE_USER_PATH="${BB_DOTFILE_USER_PATH:-}"

stage_dotfiles() {
    _profile=$BB_DOTFILE_PROFILE
    _src=payloads/dotfiles
    case "$_profile" in
        none) return 0 ;;
        user-supplied)
            if [ -n "$BB_DOTFILE_USER_PATH" ] && [ -d "$BB_DOTFILE_USER_PATH" ]; then
                cp -r "$BB_DOTFILE_USER_PATH"/. runtime/payload/home/ 2>/dev/null || true
                return 0
            fi
            printf '%s\n' "build-payload: user-supplied dotfiles path not found: $BB_DOTFILE_USER_PATH; using default-comfort" >&2
            _profile=default-comfort
            ;;
    esac
    if [ -d "payloads/dotfiles/$_profile" ]; then
        _src="payloads/dotfiles/$_profile"
    fi
    for _f in .profile .zshrc .tmux.conf .gdbinit; do
        [ -f "$_src/$_f" ] && cp "$_src/$_f" "runtime/payload/home/$_f"
    done
}

stage_dotfiles

# Clean out unconfigured/stale files from previous builds or default template
for tool in zsh tmux strace gdbserver dropbear dbclient dropbearkey curl dropbear-bin \
    socat tcpdump rsync mtr iperf3 ethtool iw minicom mosh-client rg ripgrep jq file htop screen \
    ltrace readelf objdump lsusb lspci; do
    rm -f "runtime/payload/bin/$tool"
done
rm -f runtime/payload/busybox-applets.txt runtime/payload/staged-tools.txt runtime/payload/built-tools.txt
mkdir -p runtime/payload/share/busierbox
: >runtime/payload/staged-tools.txt
: >runtime/payload/built-tools.txt

if ! runtime/payload/bin/busybox --list >runtime/payload/busybox-applets.txt 2>/dev/null || [ ! -s runtime/payload/busybox-applets.txt ]; then
    printf '%s\n' "build-payload: unable to discover native BusyBox applets from runtime/payload/bin/busybox --list" >&2
    exit 1
fi

stage_real_tool() {
    tool=$1
    src=$2
    dst=${3:-$tool}
    [ -n "$src" ] && [ -x "$src" ] || return 1
    cp "$src" "runtime/payload/bin/$dst"
    chmod 0755 "runtime/payload/bin/$dst"
    printf '%s\n' "$dst" >>runtime/payload/staged-tools.txt
    printf '%s\n' "$tool" >>runtime/payload/built-tools.txt
    return 0
}

tool_selected() {
    needle=$1
    for t in $BB_HEAVY_TOOLS; do
        [ "$t" = "$needle" ] && return 0
    done
    return 1
}

stage_host_terminfo() {
    needed=0
    tool_selected tmux && needed=1
    tool_selected screen && needed=1
    tool_selected htop && needed=1
    [ "$needed" -eq 1 ] || return 0

    for root in /usr/share/terminfo /lib/terminfo /usr/lib/terminfo; do
        [ -d "$root" ] || continue
        for term in t/tmux t/tmux-256color t/tmux-direct s/screen s/screen-256color x/xterm x/xterm-256color; do
            [ -f "$root/$term" ] || continue
            mkdir -p "runtime/payload/share/terminfo/${term%/*}"
            cp "$root/$term" "runtime/payload/share/terminfo/$term"
        done
    done
    if [ -d runtime/payload/share/terminfo ]; then
        printf '%s\n' "build-payload: staged host terminfo entries"
    else
        printf '%s\n' "build-payload: WARNING: terminal tools selected but no host terminfo entries were found" >&2
    fi
}

# Set up only selected heavy tools
for tool in zsh tmux strace gdbserver dropbear curl socat tcpdump rsync mtr iperf3 ethtool iw minicom mosh-client ripgrep jq file htop screen ltrace readelf objdump usbutils pciutils; do
    if tool_selected "$tool"; then
        if [ "$tool" = ripgrep ] && command -v rg >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v rg)" rg || true
        elif [ "$tool" = usbutils ] && command -v lsusb >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v lsusb)" lsusb || true
        elif [ "$tool" = pciutils ] && command -v lspci >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v lspci)" lspci || true
        elif command -v "$tool" >/dev/null 2>&1; then
            stage_real_tool "$tool" "$(command -v "$tool")" "$tool" || true
        elif [ "$tool" = dropbear ]; then
            for dropbear_tool in dropbear dbclient dropbearkey; do
                if command -v "$dropbear_tool" >/dev/null 2>&1; then
                    stage_real_tool "$tool" "$(command -v "$dropbear_tool")" "$dropbear_tool" || true
                fi
            done
        fi
    fi
done

sort -u runtime/payload/staged-tools.txt -o runtime/payload/staged-tools.txt
sort -u runtime/payload/built-tools.txt -o runtime/payload/built-tools.txt

scripts/install-busybox-symlinks runtime/payload
stage_host_terminfo

for tool in xxd; do
    if tool_selected "$tool" && [ -e "runtime/payload/bin/$tool" ]; then
        printf '%s\n' "$tool" >>runtime/payload/staged-tools.txt
        printf '%s\n' "$tool" >>runtime/payload/built-tools.txt
    fi
done
sort -u runtime/payload/staged-tools.txt -o runtime/payload/staged-tools.txt
sort -u runtime/payload/built-tools.txt -o runtime/payload/built-tools.txt

payload_sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf '%s\n' unknown
    fi
}

make_payload_archives() {
    rm -f dist/payload.tar dist/payload.tar.gz
    if tar --version 2>/dev/null | grep -qi 'GNU tar'; then
        tar --format=ustar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' -C runtime -cf dist/payload.tar payload
    elif tar --format=ustar -cf /dev/null -C runtime payload >/dev/null 2>&1; then
        tar --format=ustar -C runtime -cf dist/payload.tar payload
    else
        printf '%s\n' "build-payload: tar does not support --format=ustar; refusing to create payload for the built-in extractor" >&2
        exit 1
    fi
    scripts/check-payload-tar dist/payload.tar
    if command -v gzip >/dev/null 2>&1; then
        gzip -n -c dist/payload.tar >dist/payload.tar.gz
    else
        printf '%s\n' "build-payload: gzip is required for PAYLOAD_FORMAT=tgz" >&2
        [ "$PAYLOAD_FORMAT" = "tar" ] || exit 1
    fi
}

static_status=dynamic
if command -v file >/dev/null 2>&1 && file runtime/payload/bin/busybox | grep -qi 'statically linked'; then
    static_status=static
fi
busybox_version=$(runtime/payload/bin/busybox 2>&1 | sed -n 's/^BusyBox v\([^ ]*\).*/\1/p' | sed -n '1p')
[ -n "$busybox_version" ] || busybox_version=unknown
scripts/write-payload-manifest --target native --arch native --libc host --kernel-floor host --busybox-version "$busybox_version" --static-status "$static_status" --payload-sha256 pending --requested-tools "$BB_HEAVY_TOOLS"
make_payload_archives
if [ "$PAYLOAD_FORMAT" = "tar" ]; then
    selected=dist/payload.tar
else
    selected=dist/payload.tar.gz
fi
sha=$(payload_sha "$selected")
scripts/write-payload-manifest --target native --arch native --libc host --kernel-floor host --busybox-version "$busybox_version" --static-status "$static_status" --payload-sha256 "$sha" --requested-tools "$BB_HEAVY_TOOLS"
make_payload_archives
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && sha256sum dist/payload.tar.gz >dist/payload.tar.gz.sha256
elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 dist/payload.tar >dist/payload.tar.sha256
    [ -f dist/payload.tar.gz ] && shasum -a 256 dist/payload.tar.gz >dist/payload.tar.gz.sha256
else
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.sha256
    printf '%s\n' "sha256 unavailable" >dist/payload.tar.gz.sha256
fi
printf '%s\n' "created dist/payload.tar and dist/payload.tar.gz"
