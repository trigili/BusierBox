#!/bin/sh
set -eu

policy=${1:-manifests/license-policy.json}
sources_lock=${2:-manifests/sources.lock.json}

[ -f LICENSE ] || {
    printf '%s\n' "check-licensing: missing LICENSE" >&2
    exit 1
}
[ -f LICENSE.busierbox ] || {
    printf '%s\n' "check-licensing: missing LICENSE.busierbox" >&2
    exit 1
}
[ -f NOTICE ] || {
    printf '%s\n' "check-licensing: missing NOTICE" >&2
    exit 1
}
[ -f "$policy" ] || {
    printf '%s\n' "check-licensing: missing $policy" >&2
    exit 1
}
[ -f "$sources_lock" ] || {
    printf '%s\n' "check-licensing: missing $sources_lock" >&2
    exit 1
}

grep -q 'GNU GENERAL PUBLIC LICENSE' LICENSE
grep -q 'Version 2, June 1991' LICENSE
grep -q 'SPDX-License-Identifier: GPL-2.0-or-later' LICENSE.busierbox
grep -q 'Unless a file states a different license' LICENSE.busierbox
grep -q 'GPL-2.0-or-later' NOTICE
grep -q 'LICENSE.busierbox' NOTICE
grep -q 'GPL-2.0-or-later' README.md
grep -q 'GPL compatibility summary' docs/licensing.md

python3 - "$policy" "$sources_lock" <<'PY'
import json
import sys
from pathlib import Path

policy_path = Path(sys.argv[1])
sources_path = Path(sys.argv[2])
policy = json.loads(policy_path.read_text(encoding="utf-8"))
sources = json.loads(sources_path.read_text(encoding="utf-8"))

project = policy.get("project") or {}
compat = policy.get("compatibility") or {}
artifact_distribution = policy.get("artifact_distribution") or {}
components = {
    item.get("name"): item
    for item in policy.get("components") or []
    if isinstance(item, dict)
}
components_by_lock_name = {
    item.get("source_lock_name"): item
    for item in policy.get("components") or []
    if isinstance(item, dict) and item.get("source_lock_name")
}
locked = {
    item.get("name"): item
    for item in sources.get("sources") or []
    if isinstance(item, dict)
}

for item in sources.get("sources") or []:
    if not isinstance(item, dict):
        raise SystemExit("check-licensing: source lock entries must be objects")
    name = item.get("name")
    if not name:
        raise SystemExit("check-licensing: source lock entry missing name")
    for key in ("version", "sha256", "filename", "license", "homepage"):
        if not item.get(key):
            raise SystemExit(f"check-licensing: source lock {name} missing {key}")
    if not item.get("urls"):
        raise SystemExit(f"check-licensing: source lock {name} missing urls")

if project.get("license") != "GPL-2.0-or-later":
    raise SystemExit("check-licensing: project license must be GPL-2.0-or-later")
if project.get("license_grant_file") != "LICENSE.busierbox":
    raise SystemExit("check-licensing: project license grant file mapping is wrong")
if project.get("license_file") != "LICENSE" or project.get("notice_file") != "NOTICE":
    raise SystemExit("check-licensing: project license/notice file mapping is wrong")
if compat.get("combined_gplv2_compatible") is not True:
    raise SystemExit("check-licensing: GPLv2 compatibility flag must be true")
if compat.get("not_legal_advice") is not True:
    raise SystemExit("check-licensing: policy must be marked as engineering guidance, not legal advice")
if artifact_distribution.get("busierbox_project_terms") != "GPL-2.0-or-later":
    raise SystemExit("check-licensing: artifact distribution project terms must be GPL-2.0-or-later")
if artifact_distribution.get("ok_for_current_default_stack") is not True:
    raise SystemExit("check-licensing: artifact distribution must mark the current default stack as compatible")
for key, needle in {
    "combined_release_terms_when_busybox_included": "GPL-2.0",
    "buildroot_role": "selected packages keep their own licenses",
    "payload_license_rule": "every bundled payload component",
    "user_supplied_data_rule": "Doom WAD",
}.items():
    if needle not in str(artifact_distribution.get(key, "")):
        raise SystemExit(f"check-licensing: artifact distribution {key} missing {needle}")
guidance = "\n".join(str(item) for item in policy.get("distribution_guidance") or [])
for needle in ("LICENSE.busierbox", "LICENSES/", "manifests/sources.lock.json", "sources.lock.json"):
    if needle not in guidance:
        raise SystemExit(f"check-licensing: distribution guidance missing {needle}")

expected = {
    "BusierBox": "GPL-2.0-or-later",
    "BusyBox": "GPL-2.0",
    "Buildroot": "GPL-2.0-or-later with package exceptions",
    "doom-ascii": "GPL-2.0-or-later",
    "miniz": "MIT OR Unlicense",
}
for name, license_id in expected.items():
    item = components.get(name)
    if not item:
        raise SystemExit(f"check-licensing: missing component policy for {name}")
    if item.get("license") != license_id:
        raise SystemExit(f"check-licensing: {name} license mismatch: {item.get('license')!r}")
    if name != "BusierBox" and not item.get("compatibility"):
        raise SystemExit(f"check-licensing: {name} compatibility note missing")

for name, item in components.items():
    source = item.get("source", "")
    if not source:
        raise SystemExit(f"check-licensing: {name} source reference missing")
    if item.get("gplv2_compatible_with_current_stack") is not True:
        raise SystemExit(f"check-licensing: {name} must explicitly be GPLv2-compatible with the current stack")
    if not item.get("distribution_obligations"):
        raise SystemExit(f"check-licensing: {name} distribution obligations missing")
    source_lock_name = item.get("source_lock_name")
    if source_lock_name:
        if source_lock_name not in locked:
            raise SystemExit(f"check-licensing: {name} source lock reference missing: {source_lock_name}")
        expected_locked_license = item.get("source_lock_license")
        if not expected_locked_license:
            raise SystemExit(f"check-licensing: {name} source_lock_license missing")
        locked_license = locked[source_lock_name].get("license")
        if locked_license != expected_locked_license:
            raise SystemExit(
                f"check-licensing: {name} source lock license mismatch: "
                f"{locked_license!r} != {expected_locked_license!r}"
            )
    if source == "this repository":
        continue
    if source.startswith("manifests/sources.lock.json:name="):
        lock_name = source.split("=", 1)[1]
        if lock_name not in locked:
            raise SystemExit(f"check-licensing: {name} source lock reference missing: {lock_name}")
        if item.get("source_lock_name") != lock_name:
            raise SystemExit(f"check-licensing: {name} source_lock_name must be {lock_name}")
        continue
    if not Path(source).exists():
        raise SystemExit(f"check-licensing: {name} source path missing: {source}")

for name in locked:
    if name not in components_by_lock_name:
        raise SystemExit(f"check-licensing: source lock {name} missing compatibility policy component")

lock_expected = {
    "buildroot": "GPL-2.0-or-later",
    "doom-ascii": "GPL-2.0-or-later",
    "miniz": "MIT OR Unlicense",
}
for name, license_id in lock_expected.items():
    item = locked.get(name)
    if not item:
        raise SystemExit(f"check-licensing: missing source lock entry for {name}")
    if item.get("license") != license_id:
        raise SystemExit(f"check-licensing: source lock license mismatch for {name}: {item.get('license')!r}")

if not Path("third_party/miniz/LICENSE").is_file():
    raise SystemExit("check-licensing: missing miniz vendored license")
notice_files = {
    "BusyBox": Path("LICENSES/busybox.txt"),
    "Buildroot": Path("LICENSES/buildroot.txt"),
    "doom-ascii": Path("LICENSES/doom-ascii.txt"),
    "miniz": Path("LICENSES/miniz.txt"),
}
notice_needles = {
    "BusyBox": ("GPL-2.0", "third_party/busybox/LICENSE"),
    "Buildroot": ("GPL-2.0-or-later", "manifests/sources.lock.json"),
    "doom-ascii": ("GPL-2.0-or-later", "BB_DOOM_WAD_PATH"),
    "miniz": ("third_party/miniz/LICENSE", "MIT"),
}
for name, path in notice_files.items():
    if not path.is_file():
        raise SystemExit(f"check-licensing: missing {name} repository notice")
    text = path.read_text(encoding="utf-8")
    for needle in notice_needles[name]:
        if needle not in text:
            raise SystemExit(f"check-licensing: {name} repository notice missing {needle}")
if not Path("third_party/busybox/LICENSE").is_file():
    raise SystemExit("check-licensing: missing BusyBox submodule license")

print("licensing ok")
PY
