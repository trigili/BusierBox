#!/bin/sh
set -eu

config=${1:-configs/busierbox.conf}
compat=${BUSIERBOX_TOOL_COMPAT:-payloads/tool-compat.json}

[ -f "$compat" ] || {
    printf '%s\n' "tool compatibility metadata missing: $compat" >&2
    exit 1
}

if [ -f "$config" ]; then
    . "$config"
fi

tools=${BB_HEAVY_TOOLS:-}
[ -n "$tools" ] || {
    printf '%s\n' "No heavy tools selected."
    exit 0
}

eval "$(BUSIERBOX_CONFIG="$config" scripts/resolve-target --config)"

_static_policy=${TARGET_STATIC_POLICY:-static-preferred}

# Read per-tool provider vars from config
_gdbserver_provider=auto
if [ -f "$config" ]; then
    _gp=$(grep '^BB_GDBSERVER_PROVIDER=' "$config" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')
    [ -n "$_gp" ] && _gdbserver_provider="$_gp"
fi

python3 - "$compat" "$TARGET_ARCH" "$TARGET_LIBC" "$TARGET_KERNEL_FLOOR" "$_static_policy" "$_gdbserver_provider" $tools <<'PY'
import json
import sys

compat, arch, libc, kernel, static_policy, gdbserver_provider, *tools = sys.argv[1:]
with open(compat, "r", encoding="utf-8") as fh:
    data = json.load(fh).get("tools", {})

tool_providers = {"gdbserver": gdbserver_provider}

warnings = []
for tool in tools:
    meta = data.get(tool)
    if not meta:
        warnings.append(f"{tool}: no compatibility metadata yet.")
        continue
    arches = meta.get("supported_arches") or []
    if arch not in arches:
        warnings.append(f"{tool}: arch {arch} is not listed as supported.")
    if libc in (meta.get("unsupported_libcs") or []):
        warnings.append(f"{tool}: libc {libc} is listed as unsupported.")
    reqs = []
    if meta.get("requires_devpts"):
        reqs.append("/dev/pts")
    if meta.get("requires_pty"):
        reqs.append("pty support")
    if meta.get("requires_ptrace"):
        reqs.append("ptrace")
    note = meta.get("notes", "")
    if reqs or note:
        detail = ", ".join(reqs)
        if detail and note:
            warnings.append(f"{tool}: may require {detail}. {note}")
        elif detail:
            warnings.append(f"{tool}: may require {detail}.")
        elif note:
            warnings.append(f"{tool}: {note}")
    # Check provider issues
    provider = tool_providers.get(tool, "auto")
    for issue in meta.get("known_provider_issues") or []:
        issue_arches = issue.get("arch") or []
        issue_libcs = issue.get("libc") or []
        issue_policies = issue.get("static_policy") or []
        issue_provider = issue.get("provider", "")
        if (not issue_arches or arch in issue_arches) and \
           (not issue_libcs or libc in issue_libcs) and \
           (not issue_policies or static_policy in issue_policies) and \
           (not issue_provider or provider in (issue_provider, "auto")):
            warnings.append(
                f"{tool} [provider={provider}]: {issue['message']} "
                f"({issue.get('suggested_action', '')})"
            )

if warnings:
    print("\n".join(warnings))
else:
    print("No tuple-level compatibility warnings for selected heavy tools.")
PY
