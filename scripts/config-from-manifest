#!/usr/bin/env python3
"""Emit a rebuild-oriented BusierBox .conf from manifest/config-export JSON."""

import argparse
import json
import shlex
import sys


def load_json(path):
    if path == "-":
        return json.load(sys.stdin)
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def manifest_from_doc(doc):
    if isinstance(doc, dict) and doc.get("kind") in {"busierbox-config-export", "busierbox-support-token"}:
        return doc.get("manifest") or {}
    return doc


def emit_var(name, value):
    if value is None:
        return
    print(f"{name}={shlex.quote(str(value))}")


def emit_list_var(name, values):
    if not isinstance(values, list):
        return
    items = [str(value) for value in values if value]
    emit_var(name, " ".join(items))


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("manifest", nargs="?", default="-", help="manifest/config-export JSON path, or '-' for stdin")
args = parser.parse_args()

manifest = manifest_from_doc(load_json(args.manifest))
target = manifest.get("target", {})
payload = manifest.get("payload", {})
runtime = manifest.get("runtime", {})
zero_arg = manifest.get("zero_arg", {})
rshell = manifest.get("rshell", {})
operator_services = manifest.get("operator_services", {})
command_queue = operator_services.get("command_queue", {}) if isinstance(operator_services, dict) else {}
dotfiles = manifest.get("dotfiles", {})
overlay = manifest.get("overlay", {})
payload_tools = manifest.get("payload_tools", {})

print("# Generated from BusierBox manifest metadata.")
print("# Review target/operator-specific network fields before rebuilding.")
emit_var("BB_TARGET_PRESET", target.get("preset"))
emit_var("BB_TARGET_NAME", target.get("name"))
emit_var("BB_TARGET_ARCH", target.get("arch"))
emit_var("BB_TARGET_ENDIAN", target.get("endian"))
emit_var("BB_TARGET_CPU", target.get("cpu"))
emit_var("BB_TARGET_ABI", target.get("abi"))
emit_var("BB_TARGET_LIBC", target.get("libc"))
emit_var("BB_KERNEL_FLOOR", target.get("kernel_floor"))
emit_var("BB_STATIC_POLICY", target.get("static_policy"))
emit_var("BB_PAYLOAD_PRESET", payload.get("preset"))
emit_var("BB_GDBSERVER_PROVIDER", payload.get("gdbserver_provider"))
emit_list_var("BB_HEAVY_TOOLS", payload_tools.get("heavy_tools"))
emit_var("BB_RUNTIME_MODE", runtime.get("mode"))
emit_var("BB_NORESIDUE_LEVEL", runtime.get("noresidue_level"))
emit_var("BB_RUNTIME_ROOT", runtime.get("root"))
emit_var("BB_RUNTIME_ALLOW_FALLBACK_ROOT", runtime.get("allow_fallback_root"))
emit_var("BB_RUNTIME_FALLBACK_ROOT", runtime.get("fallback_root"))
emit_var("BB_ZERO_ARG_MODE", zero_arg.get("mode"))
emit_var("BB_ZERO_ARG_LOG_MODE", zero_arg.get("log_mode"))
emit_var("BB_RSHELL_TRANSPORT", rshell.get("transport"))
emit_var("BB_RSHELL_ENCRYPTION", rshell.get("encryption"))
emit_var("BB_RSHELL_RUN_MODE", rshell.get("run_mode"))
emit_var("BB_RSHELL_SESSION_POLICY", rshell.get("session_policy"))
emit_var("BB_RSHELL_SHELL_PROVIDER", rshell.get("shell_provider"))
emit_var("BB_OPERATOR_SERVER_HOST", rshell.get("operator_host"))
emit_var("BB_RSHELL_SOCAT_PORT", rshell.get("operator_shell_port"))
emit_var("BB_OPERATOR_SERVER_SSH_PORT", rshell.get("operator_ssh_port"))
emit_var("BB_OPERATOR_REMOTE_FORWARD_PORT", rshell.get("remote_forward_port"))
target_dropbear = rshell.get("target_dropbear")
if isinstance(target_dropbear, str) and ":" in target_dropbear:
    host, port = target_dropbear.rsplit(":", 1)
    emit_var("BB_OPERATOR_TARGET_BIND_HOST", host)
    emit_var("BB_OPERATOR_TARGET_DROPBEAR_PORT", port)
emit_var("BB_RSHELL_AUTHKEYS_MODE", rshell.get("authkeys_mode"))
retry = rshell.get("retry") if isinstance(rshell.get("retry"), dict) else {}
emit_var("BB_RSHELL_RETRY_COUNT", retry.get("count"))
emit_var("BB_RSHELL_RETRY_INTERVAL_SEC", retry.get("interval_sec"))
emit_var("BB_RSHELL_RETRY_JITTER_PCT", retry.get("jitter_pct"))
emit_var("BB_RSHELL_RETRY_BACKOFF", retry.get("backoff"))
emit_var("BB_RSHELL_RETRY_MAX_INTERVAL_SEC", retry.get("max_interval_sec"))
emit_var("BB_COMMAND_QUEUE_ENABLE", command_queue.get("enabled"))
emit_var("BB_COMMAND_QUEUE_PORT", command_queue.get("port"))
emit_var("BB_COMMAND_QUEUE_TLS", command_queue.get("tls"))
emit_var("BB_COMMAND_QUEUE_REQUIRE_TOKEN", command_queue.get("require_token"))
emit_var("BB_COMMAND_QUEUE_TOKEN_SOURCE", command_queue.get("token_source"))
emit_var("BB_COMMAND_QUEUE_ALLOWED_COMMANDS", command_queue.get("allowed_commands"))
emit_var("BB_COMMAND_QUEUE_ALLOW_ARBITRARY", command_queue.get("allow_arbitrary"))
emit_var("BB_COMMAND_QUEUE_POLL_INTERVAL_SEC", command_queue.get("poll_interval_sec"))
emit_var("BB_COMMAND_QUEUE_MAX_POLLS", command_queue.get("max_polls"))
emit_var("BB_DOTFILES_ENABLE", dotfiles.get("enabled"))
emit_var("BB_DOTFILE_ZSH_MODE", dotfiles.get("zsh"))
emit_var("BB_DOTFILE_BASH_MODE", dotfiles.get("bash"))
emit_var("BB_DOTFILE_TMUX_MODE", dotfiles.get("tmux"))
emit_var("BB_DOTFILE_GDB_MODE", dotfiles.get("gdb"))
emit_var("BB_DOTFILE_PROFILE_MODE", dotfiles.get("profile"))
emit_var("BB_USER_OVERLAY_ENABLE", overlay.get("enabled"))
emit_var("BB_USER_OVERLAY_ROOT", overlay.get("root"))
emit_var("BB_USER_OVERLAY_ALLOW_OVERRIDE", overlay.get("allow_override"))
