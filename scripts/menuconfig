        "3" "File tools ($(busybox_group_status fileops))" \
        "4" "Disk/archive tools ($(busybox_group_status disk))" \
        "5" "Process/system identity tools ($(busybox_group_status process))" \
        "6" "Network tools ($(busybox_group_status network))" \
        "7" "Text tools ($(busybox_group_status text))" \
        "8" "System inspection tools ($(busybox_group_status system))" \
        "9" "Dangerous / destructive tools ($(busybox_group_status dangerous))" \
        "10" "All archival applets ($(busybox_group_status all-archival))" \
        "11" "All console applets ($(busybox_group_status all-console-tools))" \
        "12" "All coreutils applets ($(busybox_group_status all-coreutils))" \
        "13" "All editors applets ($(busybox_group_status all-editors))" \
        "14" "All findutils applets ($(busybox_group_status all-findutils))" \
        "15" "All loginutils applets ($(busybox_group_status all-loginutils))" \
        "16" "All miscutils applets ($(busybox_group_status all-miscutils))" \
        "17" "All modutils applets ($(busybox_group_status all-modutils))" \
        "18" "All networking applets ($(busybox_group_status all-networking))" \
        "19" "All procps applets ($(busybox_group_status all-procps))" \
        "20" "All util-linux applets ($(busybox_group_status all-util-linux))" \
        "21" "All debianutils applets ($(busybox_group_status all-debianutils))" \
        "22" "All e2fsprogs applets ($(busybox_group_status all-e2fsprogs))" \
        "23" "All init applets ($(busybox_group_status all-init))" \
        "24" "All mailutils applets ($(busybox_group_status all-mailutils))" \
        "25" "All printutils applets ($(busybox_group_status all-printutils))" \
        "26" "All runit applets ($(busybox_group_status all-runit))" \
        "27" "All sysklogd applets ($(busybox_group_status all-sysklogd))" \
        "28" "All shell applets ($(busybox_group_status all-shell))" \
        "29" "All klibc-utils applets ($(busybox_group_status all-klibc-utils))" \
        "30" "All selinux applets ($(busybox_group_status all-selinux))" \
        "0" "Back" \
        2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "BusyBox Applet Group Defaults" \
        --checklist "Select applet groups. Individual submenu overrides are preserved." 19 76 8 \
        "shell"   "sh, ash, printf, echo, test"                     "$(has_item "$BB_BUSYBOX_GROUPS" shell   && printf on || printf off)" \
        "fileops" "cat, ls, cp, mv, rm, mkdir, chmod, touch, stat"  "$(has_item "$BB_BUSYBOX_GROUPS" fileops && printf on || printf off)" \
        "disk"    "dd, df, mount, umount, tar, gzip, gunzip, sync"  "$(has_item "$BB_BUSYBOX_GROUPS" disk    && printf on || printf off)" \
        "process" "ps, free, kill, killall, id, whoami, uname, env" "$(has_item "$BB_BUSYBOX_GROUPS" process && printf on || printf off)" \
        "network" "nc, ping, wget, ip, ifconfig, netstat, route"    "$(has_item "$BB_BUSYBOX_GROUPS" network && printf on || printf off)" \
        "text"    "grep, sed, awk, find, sort, head, tail, less"    "$(has_item "$BB_BUSYBOX_GROUPS" text    && printf on || printf off)" \
        "system"  "dmesg, sysctl, date, hexdump, strings, stty"     "$(has_item "$BB_BUSYBOX_GROUPS" system  && printf on || printf off)" \
        "dangerous" "nuke, devmem, reboot, fdisk, mkfs, flash tools" "$(has_item "$BB_BUSYBOX_GROUPS" dangerous && printf on || printf off)" \
        2>"$temp_out" || return 0
                BB_BUSYBOX_GROUPS=$(cat "$temp_out" | tr -d '"')
                BB_BUSYBOX_APPLETS=""
                ;;
            2) configure_busybox_group_applets shell "Shell tools" ;;
            3) configure_busybox_group_applets fileops "File tools" ;;
            4) configure_busybox_group_applets disk "Disk/archive tools" ;;
            5) configure_busybox_group_applets process "Process/system identity tools" ;;
            6) configure_busybox_group_applets network "Network tools" ;;
            7) configure_busybox_group_applets text "Text tools" ;;
            8) configure_busybox_group_applets system "System inspection tools" ;;
            9) configure_busybox_group_applets dangerous "Dangerous / destructive tools" ;;
            10) configure_busybox_group_applets all-archival "All archival applets" ;;
            11) configure_busybox_group_applets all-console-tools "All console applets" ;;
            12) configure_busybox_group_applets all-coreutils "All coreutils applets" ;;
            13) configure_busybox_group_applets all-editors "All editors applets" ;;
            14) configure_busybox_group_applets all-findutils "All findutils applets" ;;
            15) configure_busybox_group_applets all-loginutils "All loginutils applets" ;;
            16) configure_busybox_group_applets all-miscutils "All miscutils applets" ;;
            17) configure_busybox_group_applets all-modutils "All modutils applets" ;;
            18) configure_busybox_group_applets all-networking "All networking applets" ;;
            19) configure_busybox_group_applets all-procps "All procps applets" ;;
            20) configure_busybox_group_applets all-util-linux "All util-linux applets" ;;
            21) configure_busybox_group_applets all-debianutils "All debianutils applets" ;;
            22) configure_busybox_group_applets all-e2fsprogs "All e2fsprogs applets" ;;
            23) configure_busybox_group_applets all-init "All init applets" ;;
            24) configure_busybox_group_applets all-mailutils "All mailutils applets" ;;
            25) configure_busybox_group_applets all-printutils "All printutils applets" ;;
            26) configure_busybox_group_applets all-runit "All runit applets" ;;
            27) configure_busybox_group_applets all-sysklogd "All sysklogd applets" ;;
            28) configure_busybox_group_applets all-shell "All shell applets" ;;
            29) configure_busybox_group_applets all-klibc-utils "All klibc-utils applets" ;;
            30) configure_busybox_group_applets all-selinux "All selinux applets" ;;
            0) return 0 ;;
        esac
    done
}

configure_gdbserver_provider() {
    while :; do
        dialog --title "gdbserver Provider" \
            --menu "Configure how gdbserver is obtained for the active target:" 17 78 6 \
            "1" "Provider: $BB_GDBSERVER_PROVIDER" \
            "2" "User binary path: ${BB_GDBSERVER_USER_PATH:-not set}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                dialog --title "gdbserver provider" \
                    --radiolist "Select how gdbserver is provided:" 17 78 5 \
                    "auto"      "Auto: try Buildroot, then user path, then overlay" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "auto"      ] && printf on || printf off)" \
                    "buildroot" "Buildroot only (may fail for some tuples)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "buildroot"  ] && printf on || printf off)" \
                    "user"      "User-supplied binary (set path below)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "user"       ] && printf on || printf off)" \
                    "overlay"   "Overlay: overlay-root/target/bin/gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "overlay"    ] && printf on || printf off)" \
                    "none"      "Disabled — do not stage gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "none"       ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_GDBSERVER_PROVIDER="$_p"
                ;;
            2)
                dialog --title "gdbserver user binary" \
                    --inputbox "Path to pre-built static gdbserver binary for target arch ($BB_TARGET_ARCH):" \
                    9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                    2>"$temp_out" || true
                BB_GDBSERVER_USER_PATH=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

check_gdbserver_compat_interactive() {
    has_item "$BB_HEAVY_TOOLS" "gdbserver" || return 0
    [ "$BB_TARGET_ARCH" = "native" ] && return 0
    command -v python3 >/dev/null 2>&1 || return 0
    [ -f payloads/tool-compat.json ] || return 0

    _arch=${BB_TARGET_ARCH:-}
    _libc=${BB_TARGET_LIBC:-}
    _policy=${BB_STATIC_POLICY:-static-preferred}
    _provider=${BB_GDBSERVER_PROVIDER:-auto}
    [ -n "$_arch" ] && [ -n "$_libc" ] || return 0

    _result=$(scripts/check-tool-providers \
        --arch "$_arch" --libc "$_libc" --static-policy "$_policy" \
        --tool gdbserver --provider "$_provider" 2>/dev/null) || return 0

    _severity=$(printf '%s\n' "$_result" | sed -n 's/^issue_severity=//p')
    [ "$_severity" = "warning" ] || return 0

    _message=$(printf '%s\n' "$_result" | sed -n 's/^issue_message=//p')
    _action=$(printf '%s\n' "$_result" | sed -n 's/^suggested_action=//p')

    dialog --title "  gdbserver: Compatibility Warning  " \
        --msgbox "gdbserver selected for ${_arch}/${_libc} (provider: ${_provider})\n\n${_message}\n\nSuggested: ${_action}" \
        14 84

    dialog --title "gdbserver: Choose Provider" \
        --menu "How should gdbserver be provided for ${_arch}/${_libc}?" 16 78 5 \
        "auto"      "Auto: try Buildroot, fallback to user path / overlay" \
        "user"      "User-supplied: specify path to a pre-built static binary" \
        "overlay"   "Overlay: place binary at overlay-root/target/bin/gdbserver" \
        "buildroot" "Buildroot anyway (will likely be pre-excluded at build time)" \
        "disable"   "Disable gdbserver" \
        2>"$temp_out" || return 0

    _choice=$(cat "$temp_out" | tr -d '"')
    case "$_choice" in
        disable)
            BB_HEAVY_TOOLS=$(printf '%s\n' $BB_HEAVY_TOOLS | grep -v '^gdbserver$' | tr '\n' ' ')
            BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS% }"
            BB_GDBSERVER_PROVIDER="none"
            ;;
        buildroot|auto)
            BB_GDBSERVER_PROVIDER="$_choice"
            ;;
        user)
            BB_GDBSERVER_PROVIDER="user"
            dialog --title "gdbserver: User-supplied binary" \
                --inputbox "Path to static gdbserver binary for target arch (${_arch}):" \
                9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                2>"$temp_out" || return 0
            _path=$(cat "$temp_out")
            [ -n "$_path" ] && BB_GDBSERVER_USER_PATH="$_path"
            if [ -n "${BB_GDBSERVER_USER_PATH:-}" ] && [ ! -f "$BB_GDBSERVER_USER_PATH" ]; then
                dialog --title "Warning" --msgbox \
                    "File not found: $BB_GDBSERVER_USER_PATH\n\nYou can still save this path and provide the binary before running make package." \
                    9 78
            fi
            ;;
        overlay)
            BB_GDBSERVER_PROVIDER="overlay"
            BB_USER_OVERLAY_ENABLE="yes"
            if [ -z "${BB_USER_OVERLAY_ROOT:-}" ]; then
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory:" 9 78 "./overlay" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
            fi
            _expected="${BB_USER_OVERLAY_ROOT}/bin/gdbserver"
            dialog --title "gdbserver: Overlay path" \
                --msgbox "Place your static gdbserver binary at:\n\n  ${_expected}\n\nbefore running make package." \
                10 84
            ;;
    esac
}

_overlay_mkdir() {
    _root=$1
    [ -n "$_root" ] || return 0
    mkdir -p "$_root/bin" "$_root/lib" "$_root/share" "$_root/home" "$_root/etc"
    dialog --title "Overlay directories created" \
        --msgbox "Created overlay layout under: $_root\n\nPlace files in bin/, lib/, share/, home/, or etc/.\nThey are merged into the payload during build.\n\nFor target-specific files use a subdirectory named\nafter the target (e.g. $_root/mipsel-linux-musl/)." 14 72
}

configure_overlay() {
    while :; do
        dialog --title "Payload / User Overlay" \
            --menu "Stage extra files into the payload from a local directory.\nPlace files in bin/, lib/, share/, home/, or etc/ inside the root." 18 82 5 \
            "1" "Overlay enabled: $BB_USER_OVERLAY_ENABLE" \
            "2" "Overlay root: ${BB_USER_OVERLAY_ROOT:-not set}" \
            "3" "Allow override existing payload files: $BB_USER_OVERLAY_ALLOW_OVERRIDE" \
            "4" "Create overlay directories now" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                if [ "$BB_USER_OVERLAY_ENABLE" = "yes" ]; then
                    BB_USER_OVERLAY_ENABLE="no"
                else
                    BB_USER_OVERLAY_ENABLE="yes"
                fi
                ;;
            2)
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory.\n\nFiles in bin/, lib/, share/, home/, and etc/ are merged into the payload.\nTarget-specific files go in a <target>/ subdirectory." \
                    12 78 "${BB_USER_OVERLAY_ROOT:-./overlay}" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
                ;;
            3)
                if [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" = "yes" ]; then
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="no"
                else
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="yes"
                fi
                ;;
            4)
                if [ -z "${BB_USER_OVERLAY_ROOT:-}" ]; then
                    dialog --title "No overlay root set" \
                        --msgbox "Set an overlay root path (option 2) first." 8 50
                else
                    _overlay_mkdir "$BB_USER_OVERLAY_ROOT"
                fi
                ;;
            0) return 0 ;;
        esac
    done
}

heavy_tool_status() {
    has_item "$BB_HEAVY_TOOLS" "$1" && printf on || printf off
}

heavy_category_summary() {
    _items=$1
    _count=0
    while IFS='|' read -r _tool _desc; do
        [ -n "$_tool" ] || continue
        has_item "$BB_HEAVY_TOOLS" "$_tool" && _count=$((_count + 1))
    done <<EOF
$_items
EOF
    printf '%s selected' "$_count"
}

configure_heavy_tool_category() {
    _category=$1
    case "$_category" in
        debug)
            _category_tools="gdbserver ltrace objdump readelf strace"
            dialog --title "Payload / Heavy tools / Debugging / RE tools" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging." 18 86 8 \
                "gdbserver" "gdb remote debugging stub [config]" "$(heavy_tool_status gdbserver)" \
                "ltrace" "library call tracer" "$(heavy_tool_status ltrace)" \
                "objdump" "object file disassembler" "$(heavy_tool_status objdump)" \
                "readelf" "ELF inspector" "$(heavy_tool_status readelf)" \
                "strace" "syscall tracer" "$(heavy_tool_status strace)" \
                2>"$temp_out" || return 0
            ;;
        misc)
            _category_tools="doom"
            if dialog --title "Payload / Heavy tools / Misc" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging. Use Help for provider notes." 12 86 4 \
                --help-button --item-help \
                "doom" "Classic Doom-compatible game runtime" "$(heavy_tool_status doom)" "Must be provided by overlay/local provider; BusierBox does not fetch or bundle game data." \
                2>"$temp_out"; then
                _dialog_rc=0
            else
                _dialog_rc=$?
            fi
            if [ "$_dialog_rc" -eq 2 ]; then
                dialog --title "doom provider note" \
                    --msgbox "doom is a classic Doom-compatible game runtime entry.\n\nBusierBox does not download Doom or bundle WAD/game data. Provide a target-compatible binary through your overlay/local provider, for example:\n\n  local/overlay/bin/doom\n\nor your configured overlay root." \
                    14 78
                return 0
            fi
            [ "$_dialog_rc" -eq 0 ] || return 0
            ;;
        network)
            _category_tools="curl dropbear ethtool iperf3 iw minicom mosh-client mtr rsync socat tcpdump"
            dialog --title "Payload / Heavy tools / Networking / operator" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging." 24 90 14 \
                "curl" "HTTP client" "$(heavy_tool_status curl)" \
                "dropbear" "SSH client/server [config]" "$(heavy_tool_status dropbear)" \
                "ethtool" "Ethernet device inspection" "$(heavy_tool_status ethtool)" \
                "iperf3" "network throughput tester" "$(heavy_tool_status iperf3)" \
                "iw" "wireless device inspection" "$(heavy_tool_status iw)" \
                "minicom" "serial console client" "$(heavy_tool_status minicom)" \
                "mosh-client" "Mosh client" "$(heavy_tool_status mosh-client)" \
                "mtr" "network path diagnostics" "$(heavy_tool_status mtr)" \
                "rsync" "file transfer/sync" "$(heavy_tool_status rsync)" \
                "socat" "bidirectional relay tool" "$(heavy_tool_status socat)" \
                "tcpdump" "packet capture" "$(heavy_tool_status tcpdump)" \
                2>"$temp_out" || return 0
            ;;
        shell)
            _category_tools="htop screen tmux zsh"
            dialog --title "Payload / Heavy tools / Shell / terminal" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging." 16 86 7 \
                "htop" "interactive process viewer" "$(heavy_tool_status htop)" \
                "screen" "terminal multiplexer" "$(heavy_tool_status screen)" \
                "tmux" "terminal multiplexer" "$(heavy_tool_status tmux)" \
                "zsh" "zsh shell [dotfiles]" "$(heavy_tool_status zsh)" \
                2>"$temp_out" || return 0
            ;;
        system)
            _category_tools="pciutils usbutils"
            dialog --title "Payload / Heavy tools / System inspection" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging." 12 86 4 \
                "pciutils" "lspci provider" "$(heavy_tool_status pciutils)" \
                "usbutils" "lsusb provider" "$(heavy_tool_status usbutils)" \
                2>"$temp_out" || return 0
            ;;
        text)
            _category_tools="file jq ripgrep xxd"
            dialog --title "Payload / Heavy tools / Text / data" \
                --checklist "Select tools to stage into the payload. Availability is verified during packaging." 16 86 7 \
                "file" "file type detection" "$(heavy_tool_status file)" \
                "jq" "JSON processor" "$(heavy_tool_status jq)" \
                "ripgrep" "rg recursive search" "$(heavy_tool_status ripgrep)" \
                "xxd" "hex dump applet/provider" "$(heavy_tool_status xxd)" \
                2>"$temp_out" || return 0
            ;;
        *) return 0 ;;
    esac

    _selected=$(cat "$temp_out" | tr -d '"')
    if has_item "$_selected" doom && ! has_item "$BB_HEAVY_TOOLS" doom; then
        dialog --title "doom provider note" \
            --msgbox "doom selected.\n\nBusierBox will only stage doom if a target-compatible binary is present through overlay/local provider paths. It will not pretend doom is available when no binary is staged." \
            11 76
    fi
    _new=
    for _old in $BB_HEAVY_TOOLS; do
        _in_category=no
        for _tool in $_category_tools; do
            [ "$_old" = "$_tool" ] && _in_category=yes
        done
        [ "$_in_category" = yes ] && continue
        _new="${_new:+$_new }$_old"
    done
    for _tool in $_category_tools; do
        has_item "$_selected" "$_tool" && _new="${_new:+$_new }$_tool"
    done
    BB_HEAVY_TOOLS="$_new"
    check_gdbserver_compat_interactive
    return 0
}

configure_heavy_tools() {
    while :; do
        _network='curl|HTTP client
dropbear|SSH client/server [config]
ethtool|Ethernet device inspection
iperf3|network throughput tester
iw|wireless device inspection
minicom|serial console client
mosh-client|Mosh client
mtr|network path diagnostics
rsync|file transfer/sync
socat|bidirectional relay tool
tcpdump|packet capture'
        _shell='htop|interactive process viewer
screen|terminal multiplexer
tmux|terminal multiplexer
zsh|zsh shell [dotfiles]'
        _text='file|file type detection
jq|JSON processor
ripgrep|rg recursive search
xxd|hex dump applet/provider'
        _debug='gdbserver|gdb remote debugging stub [config]
ltrace|library call tracer
objdump|object file disassembler
readelf|ELF inspector
strace|syscall tracer'
        _system='pciutils|lspci provider
usbutils|lsusb provider'
        _misc='doom|Classic Doom-compatible game runtime'
        dialog --title "Payload / Heavy tools" \
            --menu "Select optional payload tools by category. Tools are alphabetized within each submenu." 17 82 7 \
            "1" "Networking / operator ($(heavy_category_summary "$_network"))" \
            "2" "Shell / terminal ($(heavy_category_summary "$_shell"))" \
            "3" "Text / data ($(heavy_category_summary "$_text"))" \
            "4" "Debugging / RE ($(heavy_category_summary "$_debug"))" \
            "5" "System inspection ($(heavy_category_summary "$_system"))" \
            "6" "Misc ($(heavy_category_summary "$_misc"))" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_heavy_tool_category network ;;
            2) configure_heavy_tool_category shell ;;
            3) configure_heavy_tool_category text ;;
            4) configure_heavy_tool_category debug ;;
            5) configure_heavy_tool_category system ;;
            6) configure_heavy_tool_category misc ;;
            0) return 0 ;;
        esac
    done
}

configure_dropbear() {
    if ! has_item "$BB_HEAVY_TOOLS" "dropbear"; then
        dialog --title "Payload / Dropbear" \
            --msgbox "Dropbear is not selected in Heavy tools.\nEnable it under Heavy Tools first." 9 56
        return 0
    fi
    while :; do
        _auth_keys_disp="${BB_DROPBEAR_AUTHORIZED_KEYS_FILE:-none}"
        _pregen_info=""
        [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ] && \
            _pregen_info=" (key will be embedded at build time)"
        dialog --title "Payload / Dropbear Options" \
            --menu "Configure how Dropbear is staged and launched.\ndropbear = SSH server  dbclient = SSH client  dropbearkey = key generator" 22 80 10 \
            "1" "Server mode (listen for incoming SSH):    $BB_DROPBEAR_SERVER_MODE" \
            "2" "Server bind host:                        ${BB_DROPBEAR_BIND_HOST:-0.0.0.0}" \
            "3" "Server listen port:                      ${BB_DROPBEAR_LISTEN_PORT:-22}" \
            "4" "Authorized keys file (stage from host):  $_auth_keys_disp" \
            "5" "Key types to stage/generate:             ${BB_DROPBEAR_KEYTYPES:-rsa ecdsa}" \
            "6" "Pre-generate host key at build time:     $BB_DROPBEAR_PREGENERATE_HOSTKEY$_pregen_info" \
            "7" "Disable password authentication:         $BB_DROPBEAR_NO_PASSWORD_AUTH" \
            "8" "Disable root password login:             $BB_DROPBEAR_NO_ROOT_PASSWORD" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_DROPBEAR_SERVER_MODE" = yes ]; then
                    BB_DROPBEAR_SERVER_MODE=no
                else
                    BB_DROPBEAR_SERVER_MODE=yes
                fi
                ;;
            2)
                dialog --title "Dropbear Bind Host" \
                    --inputbox "Interface to listen on (0.0.0.0 = all, 127.0.0.1 = loopback only).\nUsed by server mode wrapper." \
                    10 72 "${BB_DROPBEAR_BIND_HOST:-0.0.0.0}" 2>"$temp_out" || true
                BB_DROPBEAR_BIND_HOST=$(cat "$temp_out")
                ;;
            3)
                dialog --title "Dropbear Listen Port" \
                    --inputbox "Port for server mode. Use 22 for standard SSH,\nor a high port (e.g. 2222) to avoid conflicts." \
                    10 72 "${BB_DROPBEAR_LISTEN_PORT:-22}" 2>"$temp_out" || true
                BB_DROPBEAR_LISTEN_PORT=$(cat "$temp_out")
                ;;
            4)
                dialog --title "Authorized Keys File" \
                    --inputbox "Path to an authorized_keys file on this build machine.\nIt will be staged to payload/home/.ssh/authorized_keys.\nLeave blank to skip." \
                    11 78 "$BB_DROPBEAR_AUTHORIZED_KEYS_FILE" 2>"$temp_out" || true
                _f=$(cat "$temp_out")
                if [ -n "$_f" ] && [ ! -f "$_f" ]; then
                    dialog --title "Warning" --msgbox "File not found: $_f\nValue will be saved but staging may fail at build time." 8 72
                fi
                BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$_f"
                ;;
            5)
                dialog --title "Key Types" \
                    --checklist "Select key types to stage/generate for Dropbear:" 12 64 3 \
                    "rsa"     "RSA key (widely compatible)"     "$(has_item "$BB_DROPBEAR_KEYTYPES" rsa    && printf on || printf off)" \
                    "ecdsa"   "ECDSA key (faster handshake)"    "$(has_item "$BB_DROPBEAR_KEYTYPES" ecdsa  && printf on || printf off)" \
                    "ed25519" "Ed25519 key (modern, compact)"   "$(has_item "$BB_DROPBEAR_KEYTYPES" ed25519 && printf on || printf off)" \
                    2>"$temp_out" || true
                _sel=$(cat "$temp_out" | tr -d '"')
                BB_DROPBEAR_KEYTYPES=""
                has_item "$_sel" rsa     && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }rsa"
                has_item "$_sel" ecdsa   && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }ecdsa"
                has_item "$_sel" ed25519 && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }ed25519"
                [ -z "$BB_DROPBEAR_KEYTYPES" ] && BB_DROPBEAR_KEYTYPES="rsa"
                ;;
            6)
                if [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ]; then
                    BB_DROPBEAR_PREGENERATE_HOSTKEY=no
                else
                    dialog --title "Pre-generate Host Key" \
                        --yesno "Generate a Dropbear RSA host key during the build and stage it\ninto the payload? The same key will be in every artifact built\nfrom this config — appropriate for single-target deployments.\n\nContinue?" 12 72 && \
                        BB_DROPBEAR_PREGENERATE_HOSTKEY=yes || true
                fi
                ;;
            7)
                if [ "$BB_DROPBEAR_NO_PASSWORD_AUTH" = yes ]; then
                    BB_DROPBEAR_NO_PASSWORD_AUTH=no
                else
                    BB_DROPBEAR_NO_PASSWORD_AUTH=yes
                fi
                ;;
            8)
                if [ "$BB_DROPBEAR_NO_ROOT_PASSWORD" = yes ]; then
                    BB_DROPBEAR_NO_ROOT_PASSWORD=no
                else
                    BB_DROPBEAR_NO_ROOT_PASSWORD=yes
                fi
                ;;
            0) return 0 ;;
        esac
    done
}

configure_full_callback() {
    while :; do
        _cb_status="disabled"
        [ "$BB_FULL_CALLBACK_ENABLE" = yes ] && _cb_status="ENABLED"
        _host_disp="${BB_FULL_CALLBACK_HOST:-not set}"
        _tok_disp="not set"
        [ -n "$BB_FULL_CALLBACK_TOKEN" ] && _tok_disp="set (${#BB_FULL_CALLBACK_TOKEN} chars)"
        dialog --title "Full Artifact / Callback Configuration" \
            --menu "Full artifact callback: $_cb_status\n'busierbox callback' connects to your operator server.\nRun after full artifact is deployed — no stager needed." 18 78 9 \
            "1" "Enable compiled-in callback defaults: $BB_FULL_CALLBACK_ENABLE" \
            "2" "Server host: $_host_disp" \
            "3" "Server port: $BB_FULL_CALLBACK_PORT" \
            "4" "Token: $_tok_disp" \
            "5" "Connect timeout: ${BB_FULL_CALLBACK_TIMEOUT}s" \
            "6" "Retry count: $BB_FULL_CALLBACK_RETRY_COUNT (-1 = unlimited)" \
            "7" "Retry delay: ${BB_FULL_CALLBACK_RETRY_DELAY}s" \
            "8" "Post-receive behavior: configured under Payload Options -> zero-arg" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_FULL_CALLBACK_ENABLE" = yes ]; then
                    BB_FULL_CALLBACK_ENABLE=no
                else
                    BB_FULL_CALLBACK_ENABLE=yes
                fi
                ;;
            2)
                dialog --title "Full Callback Host" \
                    --inputbox "Operator server host/IP. Leave blank to always use --host at runtime." \
                    9 72 "$BB_FULL_CALLBACK_HOST" 2>"$temp_out" || true
                BB_FULL_CALLBACK_HOST=$(cat "$temp_out")
                ;;
            3)
                dialog --title "Full Callback Port" \
                    --inputbox "Server port (must match busierbox-server --listen port)." \
                    9 60 "$BB_FULL_CALLBACK_PORT" 2>"$temp_out" || true
                BB_FULL_CALLBACK_PORT=$(cat "$temp_out")
                ;;
            4) configure_token_value BB_FULL_CALLBACK_TOKEN "Full Callback Token" ;;
            5)
                dialog --title "Connect Timeout" \
                    --inputbox "Seconds before a connection attempt times out." \
                    9 60 "$BB_FULL_CALLBACK_TIMEOUT" 2>"$temp_out" || true
                BB_FULL_CALLBACK_TIMEOUT=$(cat "$temp_out")
                ;;
            6)
                dialog --title "Retry Count" \
                    --inputbox "Number of connection attempts before giving up.\nUse -1 for unlimited retry while the callback process is running." \
                    9 60 "$BB_FULL_CALLBACK_RETRY_COUNT" 2>"$temp_out" || true
                BB_FULL_CALLBACK_RETRY_COUNT=$(cat "$temp_out")
                ;;
            7)
                dialog --title "Retry Delay" \
                    --inputbox "Seconds between connection attempts." \
                    9 60 "$BB_FULL_CALLBACK_RETRY_DELAY" 2>"$temp_out" || true
                BB_FULL_CALLBACK_RETRY_DELAY=$(cat "$temp_out")
                ;;
            8)
                dialog --title "Post-receive Behavior" \
                    --msgbox "Post-receive behavior is configured under:\n\n  Payload Options -> zero-arg\n\n'post-receive action' means what a receiver asks the full artifact to do after download." \
                    12 76
                ;;
            0) return 0 ;;
        esac
    done
}

configure_callbacks() {
    while :; do
        _scb="$BB_STAGER_CALLBACK_ENABLE"
        [ "$BB_STAGER_CALLBACK_ENABLE" = yes ] && \
            _scb="ENABLED host=${BB_STAGER_CALLBACK_HOST:-?} port=$BB_STAGER_CALLBACK_PORT"
        [ "$BB_BUILD_STAGER" = yes ] || _scb="disabled (stager artifact not selected)"
        _fcb="$BB_FULL_CALLBACK_ENABLE"
        [ "$BB_FULL_CALLBACK_ENABLE" = yes ] && \
            _fcb="ENABLED host=${BB_FULL_CALLBACK_HOST:-?} port=$BB_FULL_CALLBACK_PORT"
        [ "$BB_BUILD_FULL" = yes ] || _fcb="disabled (full artifact not selected)"
        dialog --title "BusierBox menuconfig / Callbacks" \
            --menu "Configure callback addresses compiled into each artifact.\nThe stager calls back on first run; the full artifact calls back\nvia 'busierbox callback'." 16 78 3 \
            "1" "Stager:       $_scb" \
            "2" "Full artifact: $_fcb" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_BUILD_STAGER" = yes ]; then
                    configure_stager_callback
                else
                    dialog --title "Stager not selected" --msgbox "Enable Artifact outputs -> Build stager artifact before configuring stager callbacks." 8 72
                fi
                ;;
            2)
                if [ "$BB_BUILD_FULL" = yes ]; then
                    configure_full_callback
                else
                    dialog --title "Full artifact not selected" --msgbox "Enable Artifact outputs -> Build full artifact before configuring full artifact callbacks." 8 72
                fi
                ;;
            0) return 0 ;;
        esac
    done
}

mode_onoff() {
    [ "$1" = "$2" ] && printf on || printf off
}

configure_autoexec() {
    while :; do
        _stager_zero_label="Stager zero-arg behavior: $BB_STAGER_ZERO_ARG_MODE"
        _stager_post_label="Stager post-receive action: $BB_STAGER_POST_RECEIVE_ACTION"
        _full_zero_label="Full zero-arg behavior: $BB_FULL_ZERO_ARG_MODE"
        _rshell_label="Reverse shell settings: mode=$BB_RSHELL_MODE host=${BB_OPERATOR_SERVER_HOST:-not set}"
        [ "$BB_BUILD_STAGER" = yes ] || {
            _stager_zero_label="Stager zero-arg behavior: disabled (stager artifact not selected)"
            _stager_post_label="Stager post-receive action: disabled (stager artifact not selected)"
        }
        [ "$BB_BUILD_FULL" = yes ] || {
            _full_zero_label="Full zero-arg behavior: disabled (full artifact not selected)"
            _rshell_label="Reverse shell settings: available when full artifact is selected"
        }
        dialog --title "zero-arg" \
            --menu "Configure what happens when an artifact is invoked without arguments. Network behavior only runs when explicitly selected." 22 88 10 \
            "1" "$_stager_zero_label" \
            "2" "$_stager_post_label" \
            "3" "$_full_zero_label" \
            "4" "$_rshell_label" \
            "5" "Autorun guard: enabled=$BB_AUTORUN_GUARD_ENABLE path=$BB_AUTORUN_GUARD_PATH" \
            "6" "Custom zero-arg command: ${BB_ZERO_ARG_CUSTOM_COMMAND:-not set}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_BUILD_STAGER" != yes ]; then
                    dialog --title "Stager not selected" --msgbox "Enable Artifact outputs -> Build stager artifact before configuring stager zero-arg behavior." 8 74
                    continue
                fi
                dialog --title "Stager zero-arg behavior" \
                    --radiolist "What happens when the stager is invoked without arguments? Use callback for constrained launch contexts where argv cannot be supplied." 12 78 2 \
                    "help" "Print usage/help" "$(mode_onoff "$BB_STAGER_ZERO_ARG_MODE" help)" \
                    "callback" "Connect to configured busierbox-server" "$(mode_onoff "$BB_STAGER_ZERO_ARG_MODE" callback)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_STAGER_ZERO_ARG_MODE="$_v"
                ;;
            2)
                if [ "$BB_BUILD_STAGER" != yes ]; then
                    dialog --title "Stager not selected" --msgbox "Enable Artifact outputs -> Build stager artifact before configuring stager post-receive behavior." 8 78
                    continue
                fi
                dialog --title "Stager post-receive action" \
                    --radiolist "What should the stager ask the received full artifact to do after download?" 14 78 4 \
                    "none" "Do not run received artifact" "$(mode_onoff "$BB_STAGER_POST_RECEIVE_ACTION" none)" \
                    "callback" "Run callback using full artifact defaults" "$(mode_onoff "$BB_STAGER_POST_RECEIVE_ACTION" callback)" \
                    "shell" "Start configured reverse shell" "$(mode_onoff "$BB_STAGER_POST_RECEIVE_ACTION" shell)" \
                    "custom" "Run configured custom command" "$(mode_onoff "$BB_STAGER_POST_RECEIVE_ACTION" custom)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_STAGER_POST_RECEIVE_ACTION="$_v"
                BB_STAGER_AUTO_EXEC="$BB_STAGER_POST_RECEIVE_ACTION"
                ;;
            3)
                if [ "$BB_BUILD_FULL" != yes ]; then
                    dialog --title "Full artifact not selected" --msgbox "Enable Artifact outputs -> Build full artifact before configuring full zero-arg behavior." 8 76
                    continue
                fi
                dialog --title "Full zero-arg behavior" \
                    --radiolist "What happens when the full BusierBox artifact is invoked without arguments? Default is help. Network modes are explicit." 14 78 4 \
                    "help" "Print usage/help" "$(mode_onoff "$BB_FULL_ZERO_ARG_MODE" help)" \
                    "callback" "Run BusierBox callback protocol" "$(mode_onoff "$BB_FULL_ZERO_ARG_MODE" callback)" \
                    "shell" "Start configured reverse shell" "$(mode_onoff "$BB_FULL_ZERO_ARG_MODE" shell)" \
                    "custom" "Run configured system command" "$(mode_onoff "$BB_FULL_ZERO_ARG_MODE" custom)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_FULL_ZERO_ARG_MODE="$_v"
                ;;
            4)
                if [ "$BB_BUILD_FULL" != yes ]; then
                    dialog --title "Full artifact not selected" --msgbox "Enable Artifact outputs -> Build full artifact before configuring reverse shell behavior." 8 78
                    continue
                fi
                configure_reverse_shell
                ;;
            5)
                dialog --title "Autorun guard/re-entry behavior" \
                    --menu "The guard prevents repeated zero-arg network/shell launches. Explicit commands bypass it." 19 78 5 \
                    "1" "Guard enabled: $BB_AUTORUN_GUARD_ENABLE" \
                    "2" "Guard path: $BB_AUTORUN_GUARD_PATH" \
                    "3" "Re-entry action: $BB_AUTORUN_REENTRY_ACTION" \
                    "4" "Stale lock policy: $BB_AUTORUN_STALE_LOCK_POLICY" \
                    "0" "Back" \
                    2>"$temp_out" || true
                _g=$(cat "$temp_out")
                case "$_g" in
                    1) [ "$BB_AUTORUN_GUARD_ENABLE" = yes ] && BB_AUTORUN_GUARD_ENABLE=no || BB_AUTORUN_GUARD_ENABLE=yes ;;
                    2) dialog --title "Autorun guard path" --inputbox "Runtime status directory for zero-arg autorun." 9 78 "$BB_AUTORUN_GUARD_PATH" 2>"$temp_out" || true; BB_AUTORUN_GUARD_PATH=$(cat "$temp_out") ;;
                    3) dialog --title "Autorun re-entry action" --radiolist "What to do when autorun is already active?" 15 70 5 \
                        "help" "Print help" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" help)" \
                        "status" "Print autorun status" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" status)" \
                        "menu" "Print menu/help" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" menu)" \
                        "doctor" "Run doctor" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" doctor)" \
                        "shell-again" "Run shell mode anyway" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" shell-again)" \
                        2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_AUTORUN_REENTRY_ACTION="$_v" ;;
                    4) dialog --title "Stale lock policy" --radiolist "Recover removes stale locks when the recorded PID is dead." 12 70 2 \
                        "recover" "Remove stale locks and retry once" "$(mode_onoff "$BB_AUTORUN_STALE_LOCK_POLICY" recover)" \
                        "conservative" "Never remove stale locks automatically" "$(mode_onoff "$BB_AUTORUN_STALE_LOCK_POLICY" conservative)" \
                        2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_AUTORUN_STALE_LOCK_POLICY="$_v" ;;
                esac
                ;;
            6)
                dialog --title "Custom zero-arg command" \
                    --inputbox "Command executed by system(3) when full zero-arg mode is custom. Leave blank to disable." 10 82 "$BB_ZERO_ARG_CUSTOM_COMMAND" \
                    2>"$temp_out" || true
                BB_ZERO_ARG_CUSTOM_COMMAND=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

configure_operator_reverse_ssh_advanced() {
    while :; do
        dialog --title "Operator reverse SSH / Advanced" \
            --menu "Advanced reverse SSH settings. Defaults are generated under local/operator-session and use the Dropbear port from the Dropbear menu." 24 90 11 \
            "1" "Operator workstation SSH user: $BB_OPERATOR_SERVER_USER" \
            "2" "busierbox-server listener port: $BB_OPERATOR_SERVER_SSH_PORT" \
            "3" "Remote forward port: $BB_OPERATOR_REMOTE_FORWARD_PORT" \
            "4" "Target Dropbear bind host: $BB_OPERATOR_TARGET_BIND_HOST" \
            "5" "Target Dropbear port: $BB_OPERATOR_TARGET_DROPBEAR_PORT" \
            "6" "Target -> operator dbclient identity: ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-auto}" \
            "7" "Operator -> target public key: ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-auto}" \
            "8" "Known-hosts policy: $BB_OPERATOR_KNOWN_HOSTS_POLICY" \
            "9" "Regenerate target -> operator identity" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) dialog --title "Operator SSH user" --inputbox "SSH user on the operator workstation." 9 78 "$BB_OPERATOR_SERVER_USER" 2>"$temp_out" || true; BB_OPERATOR_SERVER_USER=$(cat "$temp_out") ;;
            2) dialog --title "busierbox-server listener port" --inputbox "Port busierbox-server listens on for incoming dbclient connections (no root needed for ports >= 1024)." 9 72 "$BB_OPERATOR_SERVER_SSH_PORT" 2>"$temp_out" || true; BB_OPERATOR_SERVER_SSH_PORT=$(cat "$temp_out") ;;
            3) dialog --title "Remote forward port" --inputbox "Port opened on the operator workstation and forwarded back to target Dropbear." 9 70 "$BB_OPERATOR_REMOTE_FORWARD_PORT" 2>"$temp_out" || true; BB_OPERATOR_REMOTE_FORWARD_PORT=$(cat "$temp_out") ;;
            4) dialog --title "Target Dropbear bind host" --inputbox "Target-side Dropbear bind address for the forwarded service." 9 70 "$BB_OPERATOR_TARGET_BIND_HOST" 2>"$temp_out" || true; BB_OPERATOR_TARGET_BIND_HOST=$(cat "$temp_out") ;;
            5) dialog --title "Target Dropbear port" --inputbox "Target-side Dropbear listen port. Defaults to the Dropbear menu listen port." 9 70 "$BB_OPERATOR_TARGET_DROPBEAR_PORT" 2>"$temp_out" || true; BB_OPERATOR_TARGET_DROPBEAR_PORT=$(cat "$temp_out") ;;
            6) dialog --title "dbclient identity" --inputbox "Private key staged to the target for target -> operator SSH authentication. Default: local/operator-session/id_dbclient." 10 82 "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" 2>"$temp_out" || true; BB_OPERATOR_DBCLIENT_IDENTITY_FILE=$(cat "$temp_out") ;;
            7) choose_operator_public_key ;;
            8) dialog --title "Known-hosts policy" --radiolist "Target dbclient host key policy for operator sshd." 12 70 2 \
                "off" "Disable strict known-host checks" "$(mode_onoff "$BB_OPERATOR_KNOWN_HOSTS_POLICY" off)" \
                "strict" "Require known_hosts to be valid" "$(mode_onoff "$BB_OPERATOR_KNOWN_HOSTS_POLICY" strict)" \
                2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_OPERATOR_KNOWN_HOSTS_POLICY="$_v" ;;
            9) generate_dbclient_identity "local/operator-session" ;;
            0) return 0 ;;
        esac
    done
}

_rshell_summary_text() {
    _h=${BB_OPERATOR_SERVER_HOST:-<not set>}
    _u=${BB_OPERATOR_SERVER_USER:-$(id -un 2>/dev/null || printf root)}
    _sp=$BB_OPERATOR_SERVER_SSH_PORT
    _fp=$BB_OPERATOR_REMOTE_FORWARD_PORT
    _tp=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
    _bh=$BB_OPERATOR_TARGET_BIND_HOST
    _id=${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-local/operator-session/id_dbclient}
    _ak=${BB_OPERATOR_AUTHORIZED_KEY_FILE:-<not set>}
    printf '%s\n' \
"  TARGET (${_h})               OPERATOR WORKSTATION" \
"  ┌──────────────────────┐      ┌──────────────────────────────────┐" \
"  │ busierbox rshell     │      │ scripts/busierbox-server --rshell │" \
"  │  dropbear :${_tp}     │      │  listens on *:${_sp}             │" \
"  │  dbclient ──────────────────→ paramiko SSH server               │" \
"  │    -R ${_fp}:${_bh}:${_tp} │  ← reverse-forward :${_fp}        │" \
"  │  identity: ${_id}  │      │  pubkey: ${_ak} │" \
"  └──────────────────────┘      └──────────────────────────────────┘" \
"" \
"  On TARGET:   busierbox rshell" \
"  On OPERATOR: scripts/busierbox-server --rshell" \
"               ssh -p ${_fp} root@127.0.0.1"
}

_rshell_save_info() {
    _out="${1:-local/reverse-shell.md}"
    mkdir -p "$(dirname "$_out")"
    _h=${BB_OPERATOR_SERVER_HOST:-<not set>}
    _u=${BB_OPERATOR_SERVER_USER:-root}
    _sp=$BB_OPERATOR_SERVER_SSH_PORT
    _fp=$BB_OPERATOR_REMOTE_FORWARD_PORT
    _tp=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
    _bh=$BB_OPERATOR_TARGET_BIND_HOST
    _id=${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-local/operator-session/id_dbclient}
    _ak=${BB_OPERATOR_AUTHORIZED_KEY_FILE:-<not set>}
    cat >"$_out" <<MDEOF
# BusierBox Reverse Shell Connection Info

## Connection diagram

\`\`\`
  TARGET (${_h})              OPERATOR WORKSTATION
  ┌─────────────────────┐      ┌────────────────────────────────────┐
  │ busierbox rshell    │      │ scripts/busierbox-server --rshell  │
  │  dropbear :${_tp}    │      │  listens on *:${_sp}               │
  │  dbclient ─────────────────→ paramiko SSH server                 │
  │    -R ${_fp}:${_bh}:${_tp} │  ← reverse-forward :${_fp}         │
  └─────────────────────┘      └────────────────────────────────────┘
\`\`\`

## Configuration

| Field | Value |
|-------|-------|
| Transport | ${BB_RSHELL_MODE} |
| Operator host | ${_h} |
| Operator SSH user | ${_u} |
| busierbox-server listen port | ${_sp} |
| Remote forward port | ${_fp} |
| Target Dropbear bind | ${_bh}:${_tp} |
| Target→operator identity | ${_id} |
| Operator→target public key | ${_ak} |

## Usage

**On the target device:**
\`\`\`
busierbox rshell
\`\`\`

**On the operator workstation:**
\`\`\`
scripts/busierbox-server --rshell
\`\`\`

**Connect once the tunnel is up:**
\`\`\`
ssh -p ${_fp} root@127.0.0.1
\`\`\`
MDEOF
    printf '%s\n' "$_out"
}

configure_reverse_shell() {
    ensure_operator_session_defaults
    while :; do
        _host=${BB_OPERATOR_SERVER_HOST:-not set}
        _target_port=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
        dialog --title "Payload / Reverse shell" \
            --menu "Configure the reverse shell used by zero-arg shell mode and explicit 'busierbox rshell'. The current transport is SSH via Dropbear/dbclient." 20 88 8 \
            "1" "Transport: $BB_RSHELL_MODE" \
            "2" "Operator workstation host/IP: $_host" \
            "3" "Prepare local ephemeral keys/defaults" \
            "4" "Operator public key: ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-auto}" \
            "5" "Summary / diagram: remote=127.0.0.1:$BB_OPERATOR_REMOTE_FORWARD_PORT target-port=$_target_port" \
            "6" "Save connection info to file" \
            "7" "Advanced SSH settings" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Reverse shell transport" \
                    --radiolist "Select reverse shell transport. More transports can be added later without changing zero-arg behavior." 10 76 1 \
                    "ssh" "Dropbear/dbclient reverse SSH tunnel" "$(mode_onoff "$BB_RSHELL_MODE" ssh)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_RSHELL_MODE="$_v"
                ;;
            2) dialog --title "Operator workstation host/IP" --inputbox "Host/IP of your workstation sshd reachable from the target. This is normally the only required field." 10 82 "$BB_OPERATOR_SERVER_HOST" 2>"$temp_out" || true; BB_OPERATOR_SERVER_HOST=$(cat "$temp_out") ;;
            3) ensure_operator_session_defaults; dialog --title "Reverse shell defaults prepared" --msgbox "Prepared defaults under local/operator-session where needed.\n\nTarget -> operator identity:\n  ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-auto}\n\nOperator -> target public key:\n  ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-auto}\n\nTarget Dropbear port:\n  ${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}" 16 82 ;;
            4) choose_operator_public_key ;;
            5) dialog --title "Reverse shell summary" --msgbox "$(_rshell_summary_text)" 18 72 ;;
            6)
                dialog --title "Save connection info" --inputbox "Save reverse shell connection info to this file." 8 72 "local/reverse-shell.md" 2>"$temp_out" || true
                _savepath=$(cat "$temp_out")
                if [ -n "$_savepath" ]; then
                    _written=$(_rshell_save_info "$_savepath")
                    dialog --title "Saved" --msgbox "Connection info written to:\n  $_written" 8 60
                fi
                ;;
            7) configure_operator_reverse_ssh_advanced ;;
            0) return 0 ;;
        esac
    done
}

configure_remote_access() {
    while :; do
        _db_status="$BB_DROPBEAR_SERVER_MODE"
        has_item "$BB_HEAVY_TOOLS" "dropbear" || _db_status="(not in heavy tools)"
        dialog --title "BusierBox menuconfig / Remote Access and Debug Tools" \
            --menu "Configure SSH server and remote debugger settings:" 14 72 3 \
            "1" "Dropbear SSH options (server=$_db_status)" \
            "2" "gdbserver provider: $BB_GDBSERVER_PROVIDER" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_dropbear ;;
            2) configure_gdbserver_provider ;;
            0) return 0 ;;
        esac
    done
}

configure_applet_configuration() {
    while :; do
        _db_status="$BB_DROPBEAR_SERVER_MODE"
        has_item "$BB_HEAVY_TOOLS" "dropbear" || _db_status="not selected"
        _gdb_status="$BB_GDBSERVER_PROVIDER"
        has_item "$BB_HEAVY_TOOLS" "gdbserver" || _gdb_status="not selected"
        dialog --title "Payload / Applet configuration" \
            --menu "Configure options for selected payload applets and operator comfort. Main tool selection remains under BusyBox applet groups and Heavy tools." 19 86 5 \
            "1" "Dropbear SSH options (server=$_db_status)" \
            "2" "gdbserver provider ($_gdb_status)" \
            "3" "Reverse shell" \
            "4" "Dotfiles by app ($BB_DOTFILE_APPS)" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_dropbear ;;
            2) configure_gdbserver_provider ;;
            3) configure_reverse_shell ;;
            4) configure_dotfiles ;;
            0) return 0 ;;
        esac
    done
}

configure_dotfiles() {
    while :; do
        dialog --title "Payload / Dotfiles by app" \
            --menu "Choose which app-specific dotfiles are staged into payload/home/. The profile selects the source style; app selection decides which files are included." 18 82 5 \
            "1" "Dotfile apps: ${BB_DOTFILE_APPS:-none}" \
            "2" "Dotfile source profile: $BB_DOTFILE_PROFILE" \
            "3" "User dotfiles path: ${BB_DOTFILE_USER_PATH:-none}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Dotfile apps" \
                    --checklist "Select only the config files you want staged. User-supplied paths use the same filenames." 16 78 4 \
                    "profile" ".profile shell environment" "$(has_item "$BB_DOTFILE_APPS" profile && printf on || printf off)" \
                    "zsh" ".zshrc" "$(has_item "$BB_DOTFILE_APPS" zsh && printf on || printf off)" \
                    "tmux" ".tmux.conf" "$(has_item "$BB_DOTFILE_APPS" tmux && printf on || printf off)" \
                    "gdb" ".gdbinit" "$(has_item "$BB_DOTFILE_APPS" gdb && printf on || printf off)" \
                    2>"$temp_out" || true
                BB_DOTFILE_APPS=$(cat "$temp_out" | tr -d '"')
                ;;
            2)
                dialog --title "Dotfile profile" \
                    --radiolist "Select source profile for the selected app files:" 15 72 5 \
                    "default-comfort" "Comfort defaults for selected apps" "$([ "$BB_DOTFILE_PROFILE" = "default-comfort" ] && printf on || printf off)" \
                    "default-operator" "Operator defaults for selected apps" "$([ "$BB_DOTFILE_PROFILE" = "default-operator" ] && printf on || printf off)" \
                    "default-minimal" "Minimal defaults for selected apps" "$([ "$BB_DOTFILE_PROFILE" = "default-minimal" ] && printf on || printf off)" \
                    "user-supplied" "Use files from a custom path" "$([ "$BB_DOTFILE_PROFILE" = "user-supplied" ] && printf on || printf off)" \
                    "none" "No dotfiles" "$([ "$BB_DOTFILE_PROFILE" = "none" ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_DOTFILE_PROFILE="$_p"
                ;;
            3)
                dialog --title "User dotfiles path" \
                    --inputbox "Path to directory containing .zshrc, .tmux.conf, etc.:" 9 72 "$BB_DOTFILE_USER_PATH" \
                    2>"$temp_out" || true
                BB_DOTFILE_USER_PATH=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_tool_warnings() {
    write_current_config "$temp_cfg"
    warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    dialog --title "Payload / Tool compatibility" --msgbox "$warnings" 20 86
}

configure_payload() {
    while :; do
        _cb_summary="stager=$BB_STAGER_CALLBACK_ENABLE full=$BB_FULL_CALLBACK_ENABLE"
        dialog --title "BusierBox menuconfig / Payload Options" \
            --menu "Choose a submenu:" 22 78 10 \
            "1" "Artifact outputs: full=$BB_BUILD_FULL stager=$BB_BUILD_STAGER core=$BB_BUILD_INTERNAL_CORE" \
            "2" "Callbacks: $_cb_summary" \
            "3" "zero-arg: stager=$BB_STAGER_ZERO_ARG_MODE full=$BB_FULL_ZERO_ARG_MODE" \
            "4" "Archive format: $BB_PAYLOAD_FORMAT" \
            "5" "BusyBox applet groups" \
            "6" "Heavy tools" \
            "7" "Tool compatibility / warnings" \
            "8" "Applet configuration" \
            "9" "User overlay: $BB_USER_OVERLAY_ENABLE (${BB_USER_OVERLAY_ROOT:-not set})" \
            "10" "Payload version: $BB_PAYLOAD_VERSION" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_artifact_outputs ;;
            2) configure_callbacks ;;
            3) configure_autoexec ;;
            4) configure_payload_format ;;
            5) configure_busybox_groups ;;
            6) configure_heavy_tools ;;
            7) show_tool_warnings ;;
            8) configure_applet_configuration ;;
            9) configure_overlay ;;
            10)
                dialog --title "Payload version" --inputbox "Payload version string:" 9 60 "$BB_PAYLOAD_VERSION" 2>"$temp_out" || true
                BB_PAYLOAD_VERSION=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_summary() {
    summary=$(target_summary_text)
    _db_detail=""
    if [ "$BB_DROPBEAR_SERVER_MODE" = yes ]; then
        _db_detail=" (${BB_DROPBEAR_BIND_HOST:-0.0.0.0}:${BB_DROPBEAR_LISTEN_PORT:-22}"
        [ "$BB_DROPBEAR_NO_PASSWORD_AUTH" = yes ] && _db_detail="${_db_detail},no-pw"
        [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ] && _db_detail="${_db_detail},pregen-key"
        _db_detail="${_db_detail})"
    fi
    _cb_detail=""
    if [ "$BB_FULL_CALLBACK_ENABLE" = yes ]; then
        _cb_host="${BB_FULL_CALLBACK_HOST:-<runtime>}"
        _cb_detail=" (${_cb_host}:${BB_FULL_CALLBACK_PORT}, auto=${BB_FULL_CALLBACK_AUTO_EXEC})"
    fi
    dialog --title "BusierBox configuration summary" --msgbox \
"$summary

Payload:
  format=$BB_PAYLOAD_FORMAT  version=$BB_PAYLOAD_VERSION
  BusyBox groups: $BB_BUSYBOX_GROUPS
  heavy tools: ${BB_HEAVY_TOOLS:-none}
  zero-arg full=$BB_FULL_ZERO_ARG_MODE rshell=$BB_RSHELL_MODE
  dropbear server=$BB_DROPBEAR_SERVER_MODE$_db_detail
    keytypes=$BB_DROPBEAR_KEYTYPES
    auth_keys=${BB_DROPBEAR_AUTHORIZED_KEYS_FILE:-none}
  full callback=$BB_FULL_CALLBACK_ENABLE$_cb_detail
  stager callback=$BB_STAGER_CALLBACK_ENABLE
  dotfile apps=${BB_DOTFILE_APPS:-none}" 31 82
}

while :; do
    dialog --title "BusierBox menuconfig" \
        --menu "Edit categories, then save when ready. Normal make package builds one active target tuple." 17 78 7 \
        "1" "Target Configuration" \
        "2" "Payload Options" \
        "3" "Show Configuration Summary" \
        "4" "Save Configuration" \
        "5" "Save and Exit" \
        "6" "Exit Without Saving" \
        2>"$temp_out" || break
    choice=$(cat "$temp_out")
    case "$choice" in
        1) configure_target_tuple ;;
        2) configure_payload ;;
        3) show_summary ;;
        4) save_config ;;
        5) save_config && exit 0 ;;
        6) exit 0 ;;
    esac
done
