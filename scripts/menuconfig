        *) return 0 ;;
    esac

    _selected=$(cat "$temp_out" | tr -d '"')
    if has_item "$_selected" doom && ! has_item "$BB_HEAVY_TOOLS" doom; then
        dialog --title "Doom WAD path" \
            --inputbox "doom selected.\n\nBuildroot targets use doom-ascii for the engine. Enter the local path to a legally usable .wad file; BusierBox will stage it into the payload but will not fetch game data." \
            13 82 "$BB_DOOM_WAD_PATH" 2>"$temp_out" && BB_DOOM_WAD_PATH=$(cat "$temp_out")
        dialog --title "doom note" \
            --msgbox "doom selected.\n\nBusierBox can build the engine through its static Buildroot doom-ascii package. Game data is never downloaded; set BB_DOOM_WAD_PATH to the local .wad file to stage." \
            11 76
    fi
    _new=
    for _old in $BB_HEAVY_TOOLS; do
        _in_category=no
        for _tool in $_category_tools; do
            [ "$_old" = "$_tool" ] && _in_category=yes
        done
        [ "$_in_category" = yes ] && continue
        _new="${_new:+$_new }$_old"
    done
    for _tool in $_category_tools; do
        has_item "$_selected" "$_tool" && _new="${_new:+$_new }$_tool"
    done
    BB_HEAVY_TOOLS="$_new"
    check_gdbserver_compat_interactive
    return 0
}

configure_heavy_tools() {
    if [ "$BB_RUNTIME_MODE" = "core-only" ]; then
        if [ -n "${BB_HEAVY_TOOLS:-}" ]; then
            dialog --title "Payload / Heavy tools" \
                --yesno "Heavy tools cannot run in core-only runtime mode.\n\nCurrently selected:\n  $BB_HEAVY_TOOLS\n\nClear BB_HEAVY_TOOLS now?" \
                13 82 && BB_HEAVY_TOOLS=""
        else
            dialog --title "Payload / Heavy tools" \
                --msgbox "Heavy tools are not available in core-only runtime mode.\n\nChange Runtime mode to extract or no-residue to select staged tools." \
                10 78
        fi
        return 0
    fi
    while :; do
        _network='curl|HTTP client
dropbear|SSH client/server [config]
ethtool|Ethernet device inspection
iperf3|network throughput tester
iw|wireless device inspection
minicom|serial console client
mosh-client|Mosh client
mtr|network path diagnostics
nmap|network mapper
nmap-ncat|ncat from nmap suite
openssl|openssl CLI
rsync|file transfer/sync
socat|bidirectional relay tool
tcpdump|packet capture'
        _shell='bash|bash shell [dotfiles]
fd|fast find helper
htop|interactive process viewer
psmisc|pstree/fuser process utilities
screen|terminal multiplexer
tmux|terminal multiplexer
zoxide|smart cd helper
zsh|zsh shell [dotfiles]'
        _text='file|file type detection
jq|JSON processor
ripgrep|rg recursive search
xxd|hex dump applet/provider'
        _debug='gdb|full target gdb *
gdbserver|gdb remote debugging stub [config]
ltrace|library call tracer
objdump|object file disassembler
radare2|RE suite *
readelf|ELF inspector
strace|syscall tracer
rizin|RE suite *
tshark|packet analyzer *'
        _system='pciutils|lspci provider
usbutils|lsusb provider'
        _storage='e2fsprogs|debugfs/tune2fs/e2fsck
i2c-tools|i2c bus tools
mmc-utils|MMC/eMMC diagnostics
mtd-utils|flash/NAND tools
parted|partition editor
spi-tools|spidev utilities
ubi-utils|UBI volume tools'
        _misc='doom|Classic Doom runtime'
        dialog --title "Payload / Heavy tools" \
            --menu "Select optional payload tools by category. * means target binary required from drop-in/user/overlay." 20 86 9 \
            "1" "Networking / operator ($(heavy_category_summary "$_network"))" \
            "2" "Shell / terminal ($(heavy_category_summary "$_shell"))" \
            "3" "Text / data ($(heavy_category_summary "$_text"))" \
            "4" "Debugging / RE ($(heavy_category_summary "$_debug"))" \
            "5" "System inspection ($(heavy_category_summary "$_system"))" \
            "6" "Dangerous storage / flash diagnostics ($(heavy_category_summary "$_storage"))" \
            "7" "Misc ($(heavy_category_summary "$_misc"))" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_heavy_tool_category network ;;
            2) configure_heavy_tool_category shell ;;
            3) configure_heavy_tool_category text ;;
            4) configure_heavy_tool_category debug ;;
            5) configure_heavy_tool_category system ;;
            6) configure_heavy_tool_category storage ;;
            7) configure_heavy_tool_category misc ;;
            H) show_page_help heavy ;;
            0) return 0 ;;
        esac
    done
}

configure_dropbear() {
    if ! has_item "$BB_HEAVY_TOOLS" "dropbear"; then
        dialog --title "Payload / Dropbear" \
            --msgbox "Dropbear is not selected in Heavy tools.\nEnable it under Heavy Tools first." 9 56
        return 0
    fi
    while :; do
        _auth_keys_disp="${BB_DROPBEAR_AUTHORIZED_KEYS_FILE:-none}"
        _pregen_info=""
        [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ] && \
            _pregen_info=" (key will be embedded at build time)"
        dialog --title "Payload / Dropbear Options" \
            --menu "Configure how Dropbear is staged and launched.\ndropbear = SSH server  dbclient = SSH client  dropbearkey = key generator" 23 80 11 \
            "1" "Server mode (listen for incoming SSH):    $BB_DROPBEAR_SERVER_MODE" \
            "2" "Server bind host:                        ${BB_DROPBEAR_BIND_HOST:-0.0.0.0}" \
            "3" "Server listen port:                      ${BB_DROPBEAR_LISTEN_PORT:-22}" \
            "4" "Authorized keys file (stage from host):  $_auth_keys_disp" \
            "5" "Key types to stage/generate:             ${BB_DROPBEAR_KEYTYPES:-rsa ecdsa}" \
            "6" "Pre-generate host key at build time:     $BB_DROPBEAR_PREGENERATE_HOSTKEY$_pregen_info" \
            "7" "Disable password authentication:         $BB_DROPBEAR_NO_PASSWORD_AUTH" \
            "8" "Disable root password login:             $BB_DROPBEAR_NO_ROOT_PASSWORD" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_DROPBEAR_SERVER_MODE" = yes ]; then
                    BB_DROPBEAR_SERVER_MODE=no
                else
                    BB_DROPBEAR_SERVER_MODE=yes
                fi
                ;;
            2)
                dialog --title "Dropbear Bind Host" \
                    --inputbox "Interface to listen on (0.0.0.0 = all, 127.0.0.1 = loopback only).\nUsed by server mode wrapper." \
                    10 72 "${BB_DROPBEAR_BIND_HOST:-0.0.0.0}" 2>"$temp_out" || true
                BB_DROPBEAR_BIND_HOST=$(cat "$temp_out")
                ;;
            3)
                dialog --title "Dropbear Listen Port" \
                    --inputbox "Port for server mode. Use 22 for standard SSH,\nor a high port (e.g. 2222) to avoid conflicts." \
                    10 72 "${BB_DROPBEAR_LISTEN_PORT:-22}" 2>"$temp_out" || true
                BB_DROPBEAR_LISTEN_PORT=$(cat "$temp_out")
                ;;
            4)
                dialog --title "Authorized Keys File" \
                    --inputbox "Path to an authorized_keys file on this build machine.\nIt will be staged to payload/home/.ssh/authorized_keys.\nLeave blank to skip." \
                    11 78 "$BB_DROPBEAR_AUTHORIZED_KEYS_FILE" 2>"$temp_out" || true
                _f=$(cat "$temp_out")
                if [ -n "$_f" ] && [ ! -f "$_f" ]; then
                    dialog --title "Warning" --msgbox "File not found: $_f\nValue will be saved but staging may fail at build time." 8 72
                fi
                BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$_f"
                ;;
            5)
                dialog --title "Key Types" \
                    --checklist "Select key types to stage/generate for Dropbear:" 12 64 3 \
                    "rsa"     "RSA key (widely compatible)"     "$(has_item "$BB_DROPBEAR_KEYTYPES" rsa    && printf on || printf off)" \
                    "ecdsa"   "ECDSA key (faster handshake)"    "$(has_item "$BB_DROPBEAR_KEYTYPES" ecdsa  && printf on || printf off)" \
                    "ed25519" "Ed25519 key (modern, compact)"   "$(has_item "$BB_DROPBEAR_KEYTYPES" ed25519 && printf on || printf off)" \
                    2>"$temp_out" || true
                _sel=$(cat "$temp_out" | tr -d '"')
                BB_DROPBEAR_KEYTYPES=""
                has_item "$_sel" rsa     && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }rsa"
                has_item "$_sel" ecdsa   && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }ecdsa"
                has_item "$_sel" ed25519 && BB_DROPBEAR_KEYTYPES="${BB_DROPBEAR_KEYTYPES:+$BB_DROPBEAR_KEYTYPES }ed25519"
                [ -z "$BB_DROPBEAR_KEYTYPES" ] && BB_DROPBEAR_KEYTYPES="rsa"
                ;;
            6)
                if [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ]; then
                    BB_DROPBEAR_PREGENERATE_HOSTKEY=no
                else
                    dialog --title "Pre-generate Host Key" \
                        --yesno "Generate a Dropbear RSA host key during the build and stage it\ninto the payload? The same key will be in every artifact built\nfrom this config — appropriate for single-target deployments.\n\nContinue?" 12 72 && \
                        BB_DROPBEAR_PREGENERATE_HOSTKEY=yes || true
                fi
                ;;
            7)
                if [ "$BB_DROPBEAR_NO_PASSWORD_AUTH" = yes ]; then
                    BB_DROPBEAR_NO_PASSWORD_AUTH=no
                else
                    BB_DROPBEAR_NO_PASSWORD_AUTH=yes
                fi
                ;;
            8)
                if [ "$BB_DROPBEAR_NO_ROOT_PASSWORD" = yes ]; then
                    BB_DROPBEAR_NO_ROOT_PASSWORD=no
                else
                    BB_DROPBEAR_NO_ROOT_PASSWORD=yes
                fi
                ;;
            H) show_page_help dropbear ;;
            0) return 0 ;;
        esac
    done
}

mode_onoff() {
    [ "$1" = "$2" ] && printf on || printf off
}

configure_autoexec() {
    while :; do
        if [ "$BB_RSHELL_TRANSPORT" = none ]; then
            _rshell_label="Reverse access: DISABLED"
        else
            _rshell_label="Reverse access: transport=$BB_RSHELL_TRANSPORT host=${BB_OPERATOR_SERVER_HOST:-not set}"
        fi
        dialog --title "zero-arg" \
            --menu "Configure artifact-wide no-argument launch behavior. Network behavior only runs when explicitly selected." 20 88 8 \
            "1" "Zero-arg mode: $BB_ZERO_ARG_MODE" \
            "2" "Zero-arg log mode: $BB_ZERO_ARG_LOG_MODE" \
            "3" "$_rshell_label" \
            "4" "Autorun guard: enabled=$BB_AUTORUN_GUARD_ENABLE path=$BB_AUTORUN_GUARD_PATH" \
            "5" "Custom zero-arg command: ${BB_ZERO_ARG_CUSTOM_COMMAND:-not set}" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Zero-arg mode" \
                    --radiolist "What happens when the artifact is invoked without arguments? Default is help." 14 78 4 \
                    "help" "Print usage/help" "$(mode_onoff "$BB_ZERO_ARG_MODE" help)" \
                    "survey" "Run local survey" "$(mode_onoff "$BB_ZERO_ARG_MODE" survey)" \
                    "rshell" "Start configured reverse access" "$(mode_onoff "$BB_ZERO_ARG_MODE" rshell)" \
                    "custom" "Run configured system command" "$(mode_onoff "$BB_ZERO_ARG_MODE" custom)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_ZERO_ARG_MODE="$_v"
                ;;
            2)
                dialog --title "Zero-arg log mode" \
                    --radiolist "How much should zero-arg autorun print? Explicit commands remain verbose." 15 82 4 \
                    "none" "No stdout/stderr/logs (fragile launch contexts)" "$(mode_onoff "$BB_ZERO_ARG_LOG_MODE" none)" \
                    "quiet" "Prefer log/status files, minimal stdout" "$(mode_onoff "$BB_ZERO_ARG_LOG_MODE" quiet)" \
                    "status" "Print concise status lines" "$(mode_onoff "$BB_ZERO_ARG_LOG_MODE" status)" \
                    "verbose" "Print detailed launch output" "$(mode_onoff "$BB_ZERO_ARG_LOG_MODE" verbose)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_ZERO_ARG_LOG_MODE="$_v"
                ;;
            3) configure_reverse_shell ;;
            4)
                dialog --title "Autorun guard/re-entry behavior" \
                    --menu "The guard prevents repeated zero-arg reverse access launches. Explicit commands bypass it." 19 78 5 \
                    "1" "Guard enabled: $BB_AUTORUN_GUARD_ENABLE" \
                    "2" "Guard path: $BB_AUTORUN_GUARD_PATH" \
                    "3" "Re-entry action: $BB_AUTORUN_REENTRY_ACTION" \
                    "4" "Stale lock policy: $BB_AUTORUN_STALE_LOCK_POLICY" \
                    "0" "Back" \
                    2>"$temp_out" || true
                _g=$(cat "$temp_out")
                case "$_g" in
                    1) [ "$BB_AUTORUN_GUARD_ENABLE" = yes ] && BB_AUTORUN_GUARD_ENABLE=no || BB_AUTORUN_GUARD_ENABLE=yes ;;
                    2) dialog --title "Autorun guard path" --inputbox "Runtime status directory for zero-arg autorun." 9 78 "$BB_AUTORUN_GUARD_PATH" 2>"$temp_out" || true; BB_AUTORUN_GUARD_PATH=$(cat "$temp_out") ;;
                    3) dialog --title "Autorun re-entry action" --radiolist "What to do when autorun is already active?" 15 70 4 \
                        "help" "Print help" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" help)" \
                        "status" "Print autorun status" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" status)" \
                        "menu" "Print menu/help" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" menu)" \
                        "doctor" "Run doctor" "$(mode_onoff "$BB_AUTORUN_REENTRY_ACTION" doctor)" \
                        2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_AUTORUN_REENTRY_ACTION="$_v" ;;
                    4) dialog --title "Stale lock policy" --radiolist "Recover removes stale locks when the recorded PID is dead." 12 70 2 \
                        "recover" "Remove stale locks and retry once" "$(mode_onoff "$BB_AUTORUN_STALE_LOCK_POLICY" recover)" \
                        "conservative" "Never remove stale locks automatically" "$(mode_onoff "$BB_AUTORUN_STALE_LOCK_POLICY" conservative)" \
                        2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_AUTORUN_STALE_LOCK_POLICY="$_v" ;;
                esac
                ;;
            5)
                dialog --title "Custom zero-arg command" \
                    --inputbox "Command executed by system(3) when full zero-arg mode is custom. Leave blank to disable." 10 82 "$BB_ZERO_ARG_CUSTOM_COMMAND" \
                    2>"$temp_out" || true
                BB_ZERO_ARG_CUSTOM_COMMAND=$(cat "$temp_out")
                ;;
            H) show_page_help launch ;;
            0) return 0 ;;
        esac
    done
}

configure_operator_reverse_ssh_advanced() {
    while :; do
        dialog --title "Operator reverse SSH / Advanced" \
            --menu "Advanced reverse SSH settings. Defaults are generated under local/operator-session and use the Dropbear port from the Dropbear menu." 24 90 11 \
            "1" "Operator workstation SSH user: $BB_OPERATOR_SERVER_USER" \
            "2" "busierbox-server listener port: $BB_OPERATOR_SERVER_SSH_PORT" \
            "3" "Remote forward port: $BB_OPERATOR_REMOTE_FORWARD_PORT" \
            "4" "Target Dropbear bind host: $BB_OPERATOR_TARGET_BIND_HOST" \
            "5" "Target Dropbear port: $BB_OPERATOR_TARGET_DROPBEAR_PORT" \
            "6" "Target -> operator dbclient identity: ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-auto}" \
            "7" "Operator -> target public key: ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-auto}" \
            "8" "Known-hosts policy: $BB_OPERATOR_KNOWN_HOSTS_POLICY" \
            "9" "Regenerate target -> operator identity" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) dialog --title "Operator SSH user" --inputbox "SSH user on the operator workstation." 9 78 "$BB_OPERATOR_SERVER_USER" 2>"$temp_out" || true; BB_OPERATOR_SERVER_USER=$(cat "$temp_out") ;;
            2) dialog --title "busierbox-server listener port" --inputbox "Port busierbox-server listens on for incoming dbclient connections (no root needed for ports >= 1024)." 9 72 "$BB_OPERATOR_SERVER_SSH_PORT" 2>"$temp_out" || true; BB_OPERATOR_SERVER_SSH_PORT=$(cat "$temp_out") ;;
            3) dialog --title "Remote forward port" --inputbox "Port opened on the operator workstation and forwarded back to target Dropbear." 9 70 "$BB_OPERATOR_REMOTE_FORWARD_PORT" 2>"$temp_out" || true; BB_OPERATOR_REMOTE_FORWARD_PORT=$(cat "$temp_out") ;;
            4) dialog --title "Target Dropbear bind host" --inputbox "Target-side Dropbear bind address for the forwarded service." 9 70 "$BB_OPERATOR_TARGET_BIND_HOST" 2>"$temp_out" || true; BB_OPERATOR_TARGET_BIND_HOST=$(cat "$temp_out") ;;
            5) dialog --title "Target Dropbear port" --inputbox "Target-side Dropbear listen port. Defaults to the Dropbear menu listen port." 9 70 "$BB_OPERATOR_TARGET_DROPBEAR_PORT" 2>"$temp_out" || true; BB_OPERATOR_TARGET_DROPBEAR_PORT=$(cat "$temp_out") ;;
            6) dialog --title "dbclient identity" --inputbox "Private key staged to the target for target -> operator SSH authentication. Default: local/operator-session/id_dbclient." 10 82 "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" 2>"$temp_out" || true; BB_OPERATOR_DBCLIENT_IDENTITY_FILE=$(cat "$temp_out") ;;
            7) choose_operator_public_key ;;
            8) dialog --title "Known-hosts policy" --radiolist "Target dbclient host key policy for operator sshd." 12 70 2 \
                "off" "Disable strict known-host checks" "$(mode_onoff "$BB_OPERATOR_KNOWN_HOSTS_POLICY" off)" \
                "strict" "Require known_hosts to be valid" "$(mode_onoff "$BB_OPERATOR_KNOWN_HOSTS_POLICY" strict)" \
                2>"$temp_out" || true; _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_OPERATOR_KNOWN_HOSTS_POLICY="$_v" ;;
            9) generate_dbclient_identity "local/operator-session" ;;
            0) return 0 ;;
        esac
    done
}

_rshell_summary_text() {
    _h=${BB_OPERATOR_SERVER_HOST:-<not set>}
    _sp=$BB_OPERATOR_SERVER_SSH_PORT
    _fp=$BB_OPERATOR_REMOTE_FORWARD_PORT
    _tp=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
    _bh=$BB_OPERATOR_TARGET_BIND_HOST
    _shell_port=$BB_RSHELL_SOCAT_PORT
    case "$BB_RSHELL_TRANSPORT:$BB_RSHELL_ENCRYPTION" in
        ssh:*)
            cat <<EOF
Reverse access summary

Transport: ssh
Operator host: ${_h}
Server listener: scripts/busierbox-server --transport ssh --ssh-port ${_sp}
Target action: busierbox rshell
Target Dropbear: ${_bh}:${_tp}
Reverse forward: 127.0.0.1:${_fp} -> target ${_bh}:${_tp}
Connect from operator: ssh -p ${_fp} root@127.0.0.1
EOF
            ;;
        *)
            _transport="$BB_RSHELL_TRANSPORT + $BB_RSHELL_ENCRYPTION"
            _server_transport=plain-shell
            _connect_model="target opens plaintext shell stream to server"
            [ "$BB_RSHELL_ENCRYPTION" = tls ] && _server_transport=tls-shell
            [ "$BB_RSHELL_ENCRYPTION" = tls ] && _connect_model="target opens encrypted shell stream to server"
            cat <<EOF
Reverse access summary

Transport: ${_transport}
Operator host: ${_h}
Server listener: scripts/busierbox-server --transport ${_server_transport} --shell-port ${_shell_port}
Target action: busierbox rshell
Shell provider: ${BB_RSHELL_SHELL_PROVIDER}
Connect model: ${_connect_model}
EOF
            ;;
    esac
    if [ "$BB_ZERO_ARG_MODE" = rshell ]; then
        printf '%s\n' "Zero-arg behavior: will start reverse access automatically."
    else
        printf '%s\n' "Zero-arg behavior: will not start reverse access automatically."
        printf '%s\n' "Explicit target start: ./busierbox rshell start"
    fi
    printf '%s\n' "Zero-arg mode: ${BB_ZERO_ARG_MODE}"
    printf '%s\n' "Explicit reverse access: $([ "$BB_RSHELL_TRANSPORT" = none ] && printf disabled || printf enabled)"
    if [ "$BB_RSHELL_ENCRYPTION" = none ] && [ "$BB_RSHELL_TRANSPORT" != ssh ]; then
        printf '%s\n' "WARNING: plaintext shell transport is insecure/debug-only."
    fi
}

_rshell_server_command() {
    case "$BB_RSHELL_TRANSPORT:$BB_RSHELL_ENCRYPTION" in
        ssh:*) printf 'scripts/busierbox-server --transport ssh --ssh-port %s\n' "$BB_OPERATOR_SERVER_SSH_PORT" ;;
        *:none) printf 'scripts/busierbox-server --transport plain-shell --shell-port %s\n' "$BB_RSHELL_SOCAT_PORT" ;;
        *) printf 'scripts/busierbox-server --transport tls-shell --shell-port %s\n' "$BB_RSHELL_SOCAT_PORT" ;;
    esac
}

_rshell_operator_connect_command() {
    case "$BB_RSHELL_TRANSPORT" in
        ssh) printf 'ssh -p %s root@127.0.0.1\n' "$BB_OPERATOR_REMOTE_FORWARD_PORT" ;;
        *) printf '# shell stream is attached by scripts/busierbox-server\n' ;;
    esac
}

_rshell_scripted_test_command() {
    case "$BB_RSHELL_TRANSPORT:$BB_RSHELL_ENCRYPTION" in
        ssh:*) printf '# after the reverse forward is established: ssh -p %s root@127.0.0.1 "uname -a"\n' "$BB_OPERATOR_REMOTE_FORWARD_PORT" ;;
        *:none) printf 'printf "echo busierbox-rshell-ok; exit\\n" | scripts/busierbox-server --transport plain-shell --shell-port %s --script - --session-timeout 20\n' "$BB_RSHELL_SOCAT_PORT" ;;
        *) printf 'printf "echo busierbox-rshell-ok; exit\\n" | scripts/busierbox-server --transport tls-shell --shell-port %s --script - --session-timeout 20\n' "$BB_RSHELL_SOCAT_PORT" ;;
    esac
}

_rshell_save_info() {
    _out="${1:-local/reverse-shell.md}"
    mkdir -p "$(dirname "$_out")"
    _h=${BB_OPERATOR_SERVER_HOST:-<not set>}
    _u=${BB_OPERATOR_SERVER_USER:-root}
    _sp=$BB_OPERATOR_SERVER_SSH_PORT
    _fp=$BB_OPERATOR_REMOTE_FORWARD_PORT
    _tp=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
    _bh=$BB_OPERATOR_TARGET_BIND_HOST
    _id=${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-local/operator-session/id_dbclient}
    _ak=${BB_OPERATOR_AUTHORIZED_KEY_FILE:-<not set>}
    _server_cmd=$(_rshell_server_command)
    _connect_cmd=$(_rshell_operator_connect_command)
    _scripted_test_cmd=$(_rshell_scripted_test_command)
    cat >"$_out" <<MDEOF
# BusierBox Reverse Access Connection Info

## Summary

\`\`\`text
$(_rshell_summary_text)
\`\`\`

## Configuration

| Field | Value |
|-------|-------|
| Transport | ${BB_RSHELL_TRANSPORT} |
| Encryption | ${BB_RSHELL_ENCRYPTION} |
| Shell provider | ${BB_RSHELL_SHELL_PROVIDER} |
| Operator host | ${_h} |
| Operator SSH user | ${_u} |
| busierbox-server listen port | ${_sp} |
| Shell listener port | ${BB_RSHELL_SOCAT_PORT} |
| Remote forward port | ${_fp} |
| Target Dropbear bind | ${_bh}:${_tp} |
| Target→operator identity | ${_id} |
| Operator→target public key | ${_ak} |
| Zero-arg starts reverse access | $([ "$BB_ZERO_ARG_MODE" = rshell ] && printf yes || printf no) |
| Zero-arg mode | ${BB_ZERO_ARG_MODE} |
| Explicit reverse access | $([ "$BB_RSHELL_TRANSPORT" = none ] && printf disabled || printf enabled) |

## Zero-Arg Behavior

$([ "$BB_ZERO_ARG_MODE" = rshell ] && printf 'This artifact will initiate reverse access when run with no arguments.' || printf 'This artifact will not initiate reverse access when run with no arguments.')

$([ "$BB_ZERO_ARG_MODE" = rshell ] || printf 'Start explicitly on the target with:\n\n```sh\n./busierbox rshell start\n```\n')

## Usage

**On the target device:**
\`\`\`sh
./busierbox rshell start
\`\`\`

**On the operator workstation:**
\`\`\`sh
${_server_cmd}
\`\`\`

**Connect once the tunnel is up:**
\`\`\`sh
${_connect_cmd}
\`\`\`

**Scripted smoke test:**
\`\`\`sh
${_scripted_test_cmd}
\`\`\`

$([ "$BB_RSHELL_ENCRYPTION" = none ] && [ "$BB_RSHELL_TRANSPORT" != ssh ] && printf '## Plaintext Warning\n\nThis configuration uses plaintext shell transport. It is insecure and intended only for controlled debug sessions.\n')
MDEOF
    printf '%s\n' "$_out"
}

configure_rshell_enable_transport() {
    while :; do
        [ "$BB_RSHELL_TRANSPORT" = none ] && _enabled=no || _enabled=yes
        _enc_label="Encryption: $BB_RSHELL_ENCRYPTION"
        [ "$BB_RSHELL_ENCRYPTION" = none ] && _enc_label="Encryption: NONE (INSECURE/DEBUG)"
        set -- \
            "1" "Reverse access enabled: $_enabled" \
            "2" "Transport: $BB_RSHELL_TRANSPORT"
        case "$BB_RSHELL_TRANSPORT" in
            ssh|none) : ;;
            *) set -- "$@" "3" "$_enc_label" ;;
        esac
        set -- "$@" "H" "Help" "0" "Back"
        dialog --title "Payload / Reverse access / Enable / transport" \
            --menu "Enable reverse access and choose the transport. Encryption is only shown for builtin/socat shell transports." 17 90 6 \
            "$@" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_RSHELL_TRANSPORT" = none ]; then
                    BB_RSHELL_TRANSPORT="${_prev_rshell_transport:-ssh}"
                    BB_RSHELL_MODE="$BB_RSHELL_TRANSPORT"
                elif [ "$BB_ZERO_ARG_MODE" = rshell ]; then
                    if dialog --title "Disable reverse access" \
                        --yesno "Zero-arg mode is rshell. Disable zero-arg rshell first or switch zero-arg mode to help/survey/custom.\n\nAuto-fix now: switch BB_ZERO_ARG_MODE=help and set BB_RSHELL_TRANSPORT=none?" \
                        11 82
                    then
                        BB_ZERO_ARG_MODE=help
                        _prev_rshell_transport="$BB_RSHELL_TRANSPORT"
                        BB_RSHELL_TRANSPORT=none
                        BB_RSHELL_MODE=none
                    fi
                else
                    _prev_rshell_transport="$BB_RSHELL_TRANSPORT"
                    BB_RSHELL_TRANSPORT=none
                    BB_RSHELL_MODE=none
                fi
                ;;
            2)
                _core_only_note=""
                [ "$BB_RUNTIME_MODE" = core-only ] && _core_only_note="\n\ncore-only mode: only 'builtin' is available (no staged tools)."
                if [ "$BB_RUNTIME_MODE" = "core-only" ]; then
                    dialog --title "Reverse access transport" \
                        --radiolist "core-only mode: only builtin transport available (no staged Dropbear/socat).${_core_only_note}" 10 88 1 \
                        "builtin" "BusierBox-native /bin/sh transport; requires wolfSSL (TLS always)" "on" \
                        2>"$temp_out" || true
                else
                    dialog --title "Reverse access transport" \
                        --radiolist "Select reverse access transport.\n  builtin — BusierBox-native /bin/sh transport; requires wolfSSL (TLS always)\n  socat   — staged socat /bin/sh transport; TLS recommended\n  ssh     — Dropbear/dbclient reverse SSH (full featured)" 16 92 3 \
                        "ssh"     "Dropbear/dbclient reverse SSH tunnel" "$(mode_onoff "$BB_RSHELL_TRANSPORT" ssh)" \
                        "socat"   "Staged socat /bin/sh transport; TLS recommended" "$(mode_onoff "$BB_RSHELL_TRANSPORT" socat)" \
                        "builtin" "BusierBox-native /bin/sh transport; requires wolfSSL (TLS always)" "$(mode_onoff "$BB_RSHELL_TRANSPORT" builtin)" \
                        2>"$temp_out" || true
                fi
                _v=$(cat "$temp_out" | tr -d '"')
                if [ -n "$_v" ]; then
                    BB_RSHELL_TRANSPORT="$_v"
                    BB_RSHELL_MODE="$_v"
                    case "$_v" in
                        ssh)
                            has_item "$BB_HEAVY_TOOLS" dropbear || BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:+$BB_HEAVY_TOOLS }dropbear"
                            ;;
                        socat)
                            has_item "$BB_HEAVY_TOOLS" socat || BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS:+$BB_HEAVY_TOOLS }socat"
                            ;;
                    esac
                fi
                ;;
            3)
                dialog --title "Encryption" \
                    --radiolist "Select encryption for $BB_RSHELL_TRANSPORT transport.\nNone is INSECURE — debug/development use only." 12 78 2 \
                    "tls"  "TLS encryption (recommended)" "$(mode_onoff "$BB_RSHELL_ENCRYPTION" tls)" \
                    "none" "[INSECURE/DEBUG] Plaintext — no encryption" "$(mode_onoff "$BB_RSHELL_ENCRYPTION" none)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                if [ -n "$_v" ]; then
                    BB_RSHELL_ENCRYPTION="$_v"
                    if [ "$_v" = none ]; then
                        dialog --title "WARNING: Plaintext transport selected" \
                            --msgbox "You have selected plaintext (no encryption) for the $BB_RSHELL_TRANSPORT transport.\n\nThis is INSECURE and intended for debug/development only. Credentials and shell traffic will be exposed.\n\nYou must also set BB_RSHELL_ALLOW_PLAINTEXT=yes in your config." \
                            12 80
                        BB_RSHELL_ALLOW_PLAINTEXT=yes
                    fi
                fi
                ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_rshell_endpoint() {
    while :; do
        set -- \
            "1" "Operator workstation host/IP: ${BB_OPERATOR_SERVER_HOST:-not set}" \
            "2" "Prepare local ephemeral keys/defaults"
        case "$BB_RSHELL_TRANSPORT" in
            ssh)
                set -- "$@" \
                    "3" "Operator SSH listener port: $BB_OPERATOR_SERVER_SSH_PORT" \
                    "4" "Remote forward port: $BB_OPERATOR_REMOTE_FORWARD_PORT" \
                    "5" "Target Dropbear bind/port: ${BB_OPERATOR_TARGET_BIND_HOST}:${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}"
                ;;
            socat|builtin)
                set -- "$@" "6" "Shell listener port: $BB_RSHELL_SOCAT_PORT" ;;
        esac
        set -- "$@" "H" "Help" "0" "Back"
        dialog --title "Payload / Reverse access / Operator endpoint" \
            --menu "Configure where the target connects and which operator-side port receives the session." 18 92 8 \
            "$@" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) dialog --title "Operator workstation host/IP" --inputbox "Host/IP of your workstation reachable from the target. Normally the only required field." 10 82 "$BB_OPERATOR_SERVER_HOST" 2>"$temp_out" || true; BB_OPERATOR_SERVER_HOST=$(cat "$temp_out") ;;
            2)
                ensure_operator_session_defaults
                _tls_cert_status="local/operator-session/shell-server.crt"
                [ -f "$_tls_cert_status" ] || _tls_cert_status="(generation failed; check openssl-generate.log)"
                dialog --title "Reverse access defaults prepared" \
                    --msgbox "Prepared defaults under local/operator-session where needed.\n\nTarget -> operator identity:\n  ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-auto}\n\nOperator -> target public key:\n  ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-auto}\n\nTLS server cert (builtin/socat+tls):\n  $_tls_cert_status\n\nTarget Dropbear port:\n  ${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}" \
                    19 82
                ;;
            3) dialog --title "Operator SSH listener port" --inputbox "Port scripts/busierbox-server listens on for reverse SSH." 9 74 "$BB_OPERATOR_SERVER_SSH_PORT" 2>"$temp_out" || true; BB_OPERATOR_SERVER_SSH_PORT=$(cat "$temp_out") ;;
            4) dialog --title "Remote forward port" --inputbox "Operator-side localhost port forwarded to target Dropbear." 9 74 "$BB_OPERATOR_REMOTE_FORWARD_PORT" 2>"$temp_out" || true; BB_OPERATOR_REMOTE_FORWARD_PORT=$(cat "$temp_out") ;;
            5)
                dialog --title "Target Dropbear bind host" --inputbox "Host/interface Dropbear binds on the target." 9 74 "$BB_OPERATOR_TARGET_BIND_HOST" 2>"$temp_out" || true
                BB_OPERATOR_TARGET_BIND_HOST=$(cat "$temp_out")
                dialog --title "Target Dropbear port" --inputbox "Dropbear port on the target." 9 74 "${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}" 2>"$temp_out" || true
                BB_OPERATOR_TARGET_DROPBEAR_PORT=$(cat "$temp_out")
                ;;
            6) dialog --title "Shell listener port" --inputbox "Port scripts/busierbox-server listens on for the shell connection." 9 72 "$BB_RSHELL_SOCAT_PORT" 2>"$temp_out" || true; BB_RSHELL_SOCAT_PORT=$(cat "$temp_out") ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_rshell_launch_behavior() {
    while :; do
        dialog --title "Payload / Reverse access / Launch behavior" \
            --menu "Configure when reverse access runs. Zero-arg autorun remains separate from explicit 'busierbox rshell start'." 17 90 5 \
            "1" "Run mode: $BB_RSHELL_RUN_MODE" \
            "2" "Zero-arg behavior: $BB_ZERO_ARG_MODE" \
            "3" "Autorun guard: $BB_AUTORUN_GUARD_ENABLE path=$BB_AUTORUN_GUARD_PATH" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Reverse access run mode" \
                    --radiolist "Select how rshell starts. auto uses the transport default; SSH already starts Dropbear/dbclient in the background. builtin/socat foreground mode creates a new shell session on each reconnect." 14 88 3 \
                    "auto" "Use transport default" "$(mode_onoff "$BB_RSHELL_RUN_MODE" auto)" \
                    "foreground" "Run in current process/session" "$(mode_onoff "$BB_RSHELL_RUN_MODE" foreground)" \
                    "background" "Detach where the transport supports it" "$(mode_onoff "$BB_RSHELL_RUN_MODE" background)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_RSHELL_RUN_MODE="$_v"
                ;;
            2) configure_zero_arg ;;
            3) configure_autorun_guard ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_rshell_shell_provider() {
    dialog --title "Shell provider" \
        --radiolist "Select the shell used by socat/builtin shell transports." 16 84 6 \
        "auto" "Prefer staged BusyBox shell when available, else /bin/sh" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" auto)" \
        "target-sh" "Use target /bin/sh" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" target-sh)" \
        "payload-busybox-sh" "Use staged BusyBox sh (not valid in core-only)" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" payload-busybox-sh)" \
        "payload-busybox-ash" "Use staged BusyBox ash (not valid in core-only)" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" payload-busybox-ash)" \
        "payload-zsh" "Use staged zsh (requires zsh heavy tool)" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" payload-zsh)" \
        "custom" "Use BB_RSHELL_CUSTOM_SHELL" "$(mode_onoff "$BB_RSHELL_SHELL_PROVIDER" custom)" \
        2>"$temp_out" || true
    _v=$(cat "$temp_out" | tr -d '"')
    [ -n "$_v" ] && BB_RSHELL_SHELL_PROVIDER="$_v"
    if [ "$BB_RSHELL_SHELL_PROVIDER" = custom ]; then
        dialog --title "Custom shell" --inputbox "Path or command for custom shell provider." 9 78 "$BB_RSHELL_CUSTOM_SHELL" 2>"$temp_out" || true
        BB_RSHELL_CUSTOM_SHELL=$(cat "$temp_out")
    fi
}

configure_rshell_ssh_settings() {
    if [ "$BB_RSHELL_TRANSPORT" != ssh ]; then
        dialog --title "SSH tunnel settings" \
            --msgbox "SSH tunnel settings apply only when transport=ssh.\n\nCurrent transport: $BB_RSHELL_TRANSPORT" \
            8 66
        return 0
    fi
    while :; do
        dialog --title "Payload / Reverse access / SSH tunnel settings" \
            --menu "Configure Dropbear/dbclient reverse SSH tunnel details." 17 88 5 \
            "1" "Advanced SSH settings" \
            "2" "Generate host key if missing: $BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING" \
            "3" "Target Dropbear bind/port: ${BB_OPERATOR_TARGET_BIND_HOST}:${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_operator_reverse_ssh_advanced ;;
            2) [ "$BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING" = yes ] && BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING=no || BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING=yes ;;
            3)
                dialog --title "Target Dropbear bind host" --inputbox "Host/interface Dropbear binds on the target." 9 74 "$BB_OPERATOR_TARGET_BIND_HOST" 2>"$temp_out" || true
                BB_OPERATOR_TARGET_BIND_HOST=$(cat "$temp_out")
                dialog --title "Target Dropbear port" --inputbox "Dropbear port on the target." 9 74 "${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}" 2>"$temp_out" || true
                BB_OPERATOR_TARGET_DROPBEAR_PORT=$(cat "$temp_out")
                ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_rshell_credentials_policy() {
    if [ "$BB_RSHELL_TRANSPORT" != ssh ]; then
        dialog --title "Credentials / authkeys policy" \
            --msgbox "authorized_keys policy only applies to SSH reverse access.\n\nCurrent transport: $BB_RSHELL_TRANSPORT" \
            8 68
        return 0
    fi
    dialog --title "SSH authorized_keys behavior" \
        --radiolist "BusierBox never blindly appends to /root/.ssh/authorized_keys. Choose how SSH auth material is handled." 14 86 4 \
        "disabled"     "Do not write authorized_keys" "$(mode_onoff "$BB_RSHELL_AUTHKEYS_MODE" disabled)" \
        "payload-home" "Use payload home only where supported" "$(mode_onoff "$BB_RSHELL_AUTHKEYS_MODE" payload-home)" \
        "root-copy"    "Copy only when /root/.ssh/authorized_keys is absent" "$(mode_onoff "$BB_RSHELL_AUTHKEYS_MODE" root-copy)" \
        "root-merge"   "Idempotent marked BusierBox block" "$(mode_onoff "$BB_RSHELL_AUTHKEYS_MODE" root-merge)" \
        2>"$temp_out" || true
    _v=$(cat "$temp_out" | tr -d '"')
    [ -n "$_v" ] && BB_RSHELL_AUTHKEYS_MODE="$_v"
}

configure_rshell_retry_lifecycle() {
    dialog --title "Retry count" --inputbox "Connection setup retries. -1 retries indefinitely, 0 means one attempt only." 9 78 "$BB_RSHELL_RETRY_COUNT" 2>"$temp_out" || true
    _v=$(cat "$temp_out"); [ -n "$_v" ] && BB_RSHELL_RETRY_COUNT="$_v"
    dialog --title "Retry interval" --inputbox "Initial retry interval in seconds." 9 78 "$BB_RSHELL_RETRY_INTERVAL_SEC" 2>"$temp_out" || true
    _v=$(cat "$temp_out"); [ -n "$_v" ] && BB_RSHELL_RETRY_INTERVAL_SEC="$_v"
    dialog --title "Retry jitter" --inputbox "Retry jitter percentage." 9 78 "$BB_RSHELL_RETRY_JITTER_PCT" 2>"$temp_out" || true
    _v=$(cat "$temp_out"); [ -n "$_v" ] && BB_RSHELL_RETRY_JITTER_PCT="$_v"
    dialog --title "Retry backoff" \
        --radiolist "Select retry backoff model." 12 70 3 \
        "none" "Fixed interval" "$(mode_onoff "$BB_RSHELL_RETRY_BACKOFF" none)" \
        "linear" "Linear interval growth" "$(mode_onoff "$BB_RSHELL_RETRY_BACKOFF" linear)" \
        "exponential" "Exponential interval growth" "$(mode_onoff "$BB_RSHELL_RETRY_BACKOFF" exponential)" \
        2>"$temp_out" || true
    _v=$(cat "$temp_out" | tr -d '"'); [ -n "$_v" ] && BB_RSHELL_RETRY_BACKOFF="$_v"
    dialog --title "Retry max interval" --inputbox "Maximum retry interval in seconds." 9 78 "$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" 2>"$temp_out" || true
    _v=$(cat "$temp_out"); [ -n "$_v" ] && BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$_v"
}

configure_rshell_summary_export() {
    while :; do
        dialog --title "Payload / Reverse access / Summary / export" \
            --menu "Review operator instructions or save them to a file." 14 78 4 \
            "1" "Show summary" \
            "2" "Save connection info to file" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) dialog --title "Reverse access summary" --msgbox "$(_rshell_summary_text)" 18 72 ;;
            2)
                dialog --title "Save connection info" --inputbox "Save reverse access connection info to this file." 8 72 "local/reverse-shell.md" 2>"$temp_out" || true
                _savepath=$(cat "$temp_out")
                if [ -n "$_savepath" ]; then
                    _written=$(_rshell_save_info "$_savepath")
                    dialog --title "Saved" --msgbox "Connection info written to:\n  $_written" 8 60
                fi
                ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_reverse_shell() {
    ensure_operator_session_defaults
    while :; do
        if [ "$BB_RSHELL_TRANSPORT" != none ] && [ "$BB_RUNTIME_MODE" = "core-only" ] && [ "$BB_RSHELL_TRANSPORT" != "builtin" ]; then
            dialog --title "core-only: transport conflict" \
                --yesno "core-only runtime cannot use staged '${BB_RSHELL_TRANSPORT}' tools.\n\nSwitch rshell transport to 'builtin' (wolfSSL TLS shell)?" \
                9 70 && {
                BB_RSHELL_TRANSPORT=builtin
                BB_RSHELL_MODE=builtin
                BB_RSHELL_ENCRYPTION=tls
            } || true
        fi
        [ "$BB_RSHELL_TRANSPORT" = none ] && _enabled=no || _enabled=yes
        _host=${BB_OPERATOR_SERVER_HOST:-not set}
        _target_port=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-${BB_DROPBEAR_LISTEN_PORT:-2222}}
        set -- \
            "1" "Enable / transport: enabled=$_enabled transport=$BB_RSHELL_TRANSPORT" \
            "2" "Operator endpoint: host=$_host" \
            "3" "Launch behavior: run=$BB_RSHELL_RUN_MODE zero-arg=$BB_ZERO_ARG_MODE" \
            "4" "Shell provider: $BB_RSHELL_SHELL_PROVIDER"
        case "$BB_RSHELL_TRANSPORT" in
            ssh)
                set -- "$@" \
                    "5" "SSH tunnel settings" \
                    "6" "Credentials / authkeys policy: $BB_RSHELL_AUTHKEYS_MODE"
                ;;
            socat|builtin)
                set -- "$@" "5" "Shell listener: $BB_RSHELL_SOCAT_PORT" ;;
        esac
        set -- "$@" \
            "7" "Retry / lifecycle: count=$BB_RSHELL_RETRY_COUNT interval=${BB_RSHELL_RETRY_INTERVAL_SEC}s backoff=$BB_RSHELL_RETRY_BACKOFF" \
            "8" "Summary / export: remote=127.0.0.1:$BB_OPERATOR_REMOTE_FORWARD_PORT target-port=$_target_port"
        set -- "$@" "H" "Help" "0" "Back"

        dialog --title "Payload / Reverse access / rshell" \
            --menu "Configure reverse access by task. Transport-specific pages are hidden unless they apply." 22 94 10 \
            "$@" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_rshell_enable_transport ;;
            2) configure_rshell_endpoint ;;
            3) configure_rshell_launch_behavior ;;
            4) configure_rshell_shell_provider ;;
            5)
                case "$BB_RSHELL_TRANSPORT" in
                    ssh) configure_rshell_ssh_settings ;;
                    socat|builtin) configure_rshell_endpoint ;;
                esac
                ;;
            6) configure_rshell_credentials_policy ;;
            7) configure_rshell_retry_lifecycle ;;
            8) configure_rshell_summary_export ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_remote_access() {
    if [ "$BB_RUNTIME_MODE" = core-only ]; then
        dialog --title "Remote Access and Debug Tools" \
            --msgbox "Dropbear SSH server and gdbserver are payload tools — they require payload extraction to run.\n\nThese options are not available in core-only runtime mode.\n\nChange Payload Options -> Runtime mode to 'extract' or 'no-residue' to use these tools." \
            11 80
        return 0
    fi
    while :; do
        _db_status="$BB_DROPBEAR_SERVER_MODE"
        has_item "$BB_HEAVY_TOOLS" "dropbear" || _db_status="(not in heavy tools)"
        dialog --title "BusierBox menuconfig / Remote Access and Debug Tools" \
            --menu "Configure SSH server and remote debugger settings:" 14 72 3 \
            "1" "Dropbear SSH options (server=$_db_status)" \
            "2" "gdbserver provider: $BB_GDBSERVER_PROVIDER" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_dropbear ;;
            2) configure_gdbserver_provider ;;
            0) return 0 ;;
        esac
    done
}

configure_applet_configuration() {
    while :; do
        if [ "$BB_RUNTIME_MODE" = core-only ]; then
            _db_status="N/A (core-only)"
            _gdb_status="N/A (core-only)"
        else
            _db_status="$BB_DROPBEAR_SERVER_MODE"
            has_item "$BB_HEAVY_TOOLS" "dropbear" || _db_status="not selected"
            _gdb_status="$BB_GDBSERVER_PROVIDER"
            has_item "$BB_HEAVY_TOOLS" "gdbserver" || _gdb_status="not selected"
        fi
        dialog --title "Payload / Applet configuration" \
            --menu "Configure options for selected payload applets and operator comfort. Main tool selection remains under BusyBox applet groups and Heavy tools." 21 86 7 \
            "1" "Dropbear SSH options (server=$_db_status)" \
            "2" "gdbserver provider ($_gdb_status)" \
            "3" "Reverse shell" \
            "4" "Dotfiles by app" \
            "5" "Persistence binary name: $BB_RECOVERY_BINARY_NAME" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) configure_dropbear ;;
            2) configure_gdbserver_provider ;;
            3) configure_reverse_shell ;;
            4) configure_dotfiles ;;
            5)
                dialog --title "Persistence binary name" \
                    --inputbox "Default filename used by persistence install plans.\nInstallation still requires an explicit persistence install command." \
                    10 78 "$BB_RECOVERY_BINARY_NAME" 2>"$temp_out" || true
                _v=$(cat "$temp_out")
                [ -n "$_v" ] && BB_RECOVERY_BINARY_NAME="$_v"
                ;;
            H) show_page_help rshell ;;
            0) return 0 ;;
        esac
    done
}

configure_dotfiles() {
    while :; do
        if [ "$BB_RUNTIME_MODE" = core-only ]; then
            if [ "$BB_DOTFILES_ENABLE" = yes ]; then
                dialog --title "Payload / Dotfiles" \
                    --yesno "Dotfiles cannot be staged in core-only runtime mode because no payload HOME is extracted.\n\nSet BB_DOTFILES_ENABLE=no now?" \
                    10 78 && BB_DOTFILES_ENABLE=no
            else
                dialog --title "Payload / Dotfiles" \
                    --msgbox "Dotfiles are disabled in core-only runtime mode.\n\nChange Runtime mode to extract or no-residue to stage app dotfiles." \
                    9 78
            fi
            return 0
        fi
        dialog --title "Payload / Dotfiles by app" \
            --menu "Choose each app's config independently. 'default' means the BusierBox default initial config; 'user' stages the exact file you choose." 22 86 9 \
            "1" "Enable dotfiles: $BB_DOTFILES_ENABLE" \
            "2" "zsh config: $BB_DOTFILE_ZSH_MODE ${BB_DOTFILE_ZSH_USER_FILE:+($BB_DOTFILE_ZSH_USER_FILE)}" \
            "3" "bash config: $BB_DOTFILE_BASH_MODE ${BB_DOTFILE_BASH_USER_FILE:+($BB_DOTFILE_BASH_USER_FILE)}" \
            "4" "tmux config: $BB_DOTFILE_TMUX_MODE ${BB_DOTFILE_TMUX_USER_FILE:+($BB_DOTFILE_TMUX_USER_FILE)}" \
            "5" "gdb config: $BB_DOTFILE_GDB_MODE ${BB_DOTFILE_GDB_USER_FILE:+($BB_DOTFILE_GDB_USER_FILE)}" \
            "6" "profile / POSIX shell config: $BB_DOTFILE_PROFILE_MODE ${BB_DOTFILE_PROFILE_USER_FILE:+($BB_DOTFILE_PROFILE_USER_FILE)}" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) [ "$BB_DOTFILES_ENABLE" = yes ] && BB_DOTFILES_ENABLE=no || BB_DOTFILES_ENABLE=yes ;;
            2) configure_dotfile_app "zsh" BB_DOTFILE_ZSH_MODE BB_DOTFILE_ZSH_USER_FILE ".zshrc" ;;
            3) configure_dotfile_app "bash" BB_DOTFILE_BASH_MODE BB_DOTFILE_BASH_USER_FILE ".bashrc" ;;
            4) configure_dotfile_app "tmux" BB_DOTFILE_TMUX_MODE BB_DOTFILE_TMUX_USER_FILE ".tmux.conf" ;;
            5) configure_dotfile_app "gdb" BB_DOTFILE_GDB_MODE BB_DOTFILE_GDB_USER_FILE ".gdbinit" ;;
            6) configure_dotfile_app "profile / POSIX shell" BB_DOTFILE_PROFILE_MODE BB_DOTFILE_PROFILE_USER_FILE ".profile" ;;
            H) show_page_help dotfiles ;;
            0) return 0 ;;
        esac
    done
}

configure_dotfile_app() {
    _label=$1
    _mode_var=$2
    _file_var=$3
    _filename=$4
    eval "_mode=\${$_mode_var}"
    eval "_file=\${$_file_var}"
    dialog --title "Dotfiles / $_label" \
        --radiolist "Select the config source for $_filename." 13 78 3 \
        "default" "BusierBox default initial config" "$(mode_onoff "$_mode" default)" \
        "user" "User-supplied file" "$(mode_onoff "$_mode" user)" \
        "none" "Do not stage this config" "$(mode_onoff "$_mode" none)" \
        2>"$temp_out" || return 0
    _new=$(cat "$temp_out" | tr -d '"')
    [ -n "$_new" ] || return 0
    eval "$_mode_var=\$_new"
    if [ "$_new" = user ]; then
        dialog --title "Dotfiles / $_label user file" \
            --inputbox "Path to the $_filename file to stage. The build will fail if this file is missing." \
            9 82 "$_file" 2>"$temp_out" || true
        _file=$(cat "$temp_out")
        eval "$_file_var=\$_file"
        if [ -n "$_file" ] && [ ! -f "$_file" ]; then
            dialog --title "Missing dotfile" \
                --msgbox "The selected file does not exist yet:\n\n$_file\n\nYou can save this config, but the payload build will fail until the file exists." \
                11 78
        fi
    fi
}

show_tool_warnings() {
    write_current_config "$temp_cfg"
    warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    dialog --title "Payload / Tool compatibility" --msgbox "$warnings" 20 86
}

configure_payload_preset() {
    while :; do
        _dirty_note=""
        payload_preset_is_dirty "${BB_PAYLOAD_PRESET:-default}" && _dirty_note="\n\n* means current payload settings differ from the selected preset."
        set --
        _seen=""
        for _path in local/presets/payload/*.conf presets/payload/*.conf; do
            [ -f "$_path" ] || continue
            _name=${_path##*/}
            _name=${_name%.conf}
            has_item "$_seen" "$_name" && continue
            _seen="${_seen:+$_seen }$_name"
            case "$_path" in
                local/*) _scope="user" ;;
                *) _scope="built-in" ;;
            esac
            _desc=$(payload_preset_description "$_name")
            set -- "$@" "$_name" "$_scope: $_desc" "$(mode_onoff "${BB_PAYLOAD_PRESET:-default}" "$_name")"
        done
        [ "$#" -gt 0 ] || {
            dialog --title "Payload presets" --msgbox "No payload presets found under presets/payload or local/presets/payload." 8 78
            return 0
        }
        if dialog --title "Payload preset selection" \
            --extra-button --extra-label "Help" \
            --radiolist "$(printf '%b' "Select a payload preset to apply. Presets reset payload/runtime/tooling options, then you can edit any setting.${_dirty_note}")" \
            22 88 12 "$@" 2>"$temp_out"
        then
            _name=$(cat "$temp_out" | tr -d '"')
            [ -n "$_name" ] && apply_payload_preset "$_name"
            return 0
        else
            _rc=$?
            [ "$_rc" -eq 3 ] && { show_page_help payload-preset; continue; }
            return 0
        fi
    done
}

configure_payload() {
    while :; do
        _ht_label="Heavy tools"
        [ "$BB_RUNTIME_MODE" = "core-only" ] && _ht_label="Heavy tools  [clear only in core-only mode]"
        dialog --title "BusierBox menuconfig / Payload Options" \
            --menu "Choose a submenu:" 24 86 12 \
            "1" "Payload preset: $(payload_preset_label)" \
            "2" "Runtime mode: $BB_RUNTIME_MODE root=$BB_RUNTIME_ROOT" \
            "3" "Launch behavior: zero-arg=$BB_ZERO_ARG_MODE log=$BB_ZERO_ARG_LOG_MODE" \
            "4" "Artifact runtime overrides: $BB_TRAILER_OVERRIDES_ENABLE obfuscation=$BB_TRAILER_OBFUSCATION" \
            "5" "Archive format: $BB_PAYLOAD_FORMAT" \
            "6" "BusyBox applet groups" \
            "7" "$_ht_label" \
            "8" "Tool compatibility / warnings" \
            "9" "Reverse access / applet configuration" \
            "10" "User overlay: $BB_USER_OVERLAY_ENABLE (${BB_USER_OVERLAY_ROOT:-not set})" \
            "11" "Payload version: $BB_PAYLOAD_VERSION" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_payload_preset ;;
            2) configure_runtime_mode ;;
            3) configure_autoexec ;;
            4) configure_artifact_runtime_overrides ;;
            5) configure_payload_format ;;
            6) configure_busybox_groups ;;
            7) configure_heavy_tools ;;
            8) show_page_help tool-compat; show_tool_warnings ;;
            9) configure_applet_configuration ;;
            10) configure_overlay ;;
            11)
                dialog --title "Payload version" --inputbox "Payload version string:" 9 60 "$BB_PAYLOAD_VERSION" 2>"$temp_out" || true
                BB_PAYLOAD_VERSION=$(cat "$temp_out")
                ;;
            H) show_page_help payload ;;
            0) return 0 ;;
        esac
    done
}

show_summary() {
    summary=$(target_summary_text)
    _db_detail=""
    if [ "$BB_DROPBEAR_SERVER_MODE" = yes ]; then
        _db_detail=" (${BB_DROPBEAR_BIND_HOST:-0.0.0.0}:${BB_DROPBEAR_LISTEN_PORT:-22}"
        [ "$BB_DROPBEAR_NO_PASSWORD_AUTH" = yes ] && _db_detail="${_db_detail},no-pw"
        [ "$BB_DROPBEAR_PREGENERATE_HOSTKEY" = yes ] && _db_detail="${_db_detail},pregen-key"
        _db_detail="${_db_detail})"
    fi
    dialog --title "BusierBox configuration summary" --msgbox \
"$summary

Payload:
  runtime=$BB_RUNTIME_MODE root=$BB_RUNTIME_ROOT
  format=$BB_PAYLOAD_FORMAT  version=$BB_PAYLOAD_VERSION
  BusyBox groups: $BB_BUSYBOX_GROUPS
  heavy tools: ${BB_HEAVY_TOOLS:-none}
  zero-arg=$BB_ZERO_ARG_MODE log=$BB_ZERO_ARG_LOG_MODE
  rshell transport=$BB_RSHELL_TRANSPORT host=${BB_OPERATOR_SERVER_HOST:-not set}
  dropbear server=$BB_DROPBEAR_SERVER_MODE$_db_detail
    keytypes=$BB_DROPBEAR_KEYTYPES
    auth_keys=${BB_DROPBEAR_AUTHORIZED_KEYS_FILE:-none}
  dotfiles=${BB_DOTFILES_ENABLE} zsh=$BB_DOTFILE_ZSH_MODE bash=$BB_DOTFILE_BASH_MODE tmux=$BB_DOTFILE_TMUX_MODE gdb=$BB_DOTFILE_GDB_MODE profile=$BB_DOTFILE_PROFILE_MODE" 31 82
}

while :; do
    dialog --title "BusierBox menuconfig" \
        --menu "Edit categories, then save when ready. Normal make package builds one active target tuple." 18 78 8 \
        "1" "Target Configuration" \
        "2" "Payload Options" \
        "3" "Show Configuration Summary" \
        "4" "Save Configuration" \
        "5" "Save and Exit" \
        "6" "Exit Without Saving" \
        "H" "Help" \
        2>"$temp_out" || break
    choice=$(cat "$temp_out")
    case "$choice" in
        1) configure_target_tuple ;;
        2) configure_payload ;;
        3) show_summary ;;
        4) save_config ;;
        5) save_config && exit 0 ;;
        6) exit 0 ;;
        H) show_page_help top ;;
    esac
done
