#!/bin/sh
set -eu

if ! command -v dialog >/dev/null 2>&1; then
    printf 'Error: dialog is required to run menuconfig. Please install it first (e.g., sudo apt install dialog).\n' >&2
    exit 1
fi

CFG_FILE="configs/busierbox.conf"
mkdir -p configs

BB_TARGETS="native"
BB_PAYLOAD_FORMAT="tgz"
BB_PAYLOAD_VERSION="dev"
BB_BUSYBOX_GROUPS="shell fileops disk process network text system"
BB_HEAVY_TOOLS=""
BB_DROPBEAR_SERVER_MODE="no"
BB_ENABLE_CUSTOM_TARGET="no"
BB_CUSTOM_ARCH="mipsel"
BB_CUSTOM_ENDIAN="little"
BB_CUSTOM_LIBC="musl"
BB_CUSTOM_KERNEL_FLOOR="2.6"
BB_CUSTOM_ABI="default"

if [ -f "$CFG_FILE" ]; then
    . "./$CFG_FILE"
fi

temp_out=$(mktemp)
temp_cfg=$(mktemp)
trap 'rm -f "$temp_out" "$temp_cfg"' EXIT HUP INT TERM

has_item() {
    list="$1"
    item="$2"
    for x in $list; do
        if [ "$x" = "$item" ]; then
            return 0
        fi
    done
    return 1
}

onoff() {
    if [ "$1" = "yes" ]; then printf on; else printf off; fi
}

save_config() {
    cat >"$temp_cfg" <<EOF
# BusierBox build configuration
# Generated by: make menuconfig
# Edit manually or regenerate with: make menuconfig

BB_TARGETS="$BB_TARGETS"
BB_PAYLOAD_FORMAT="$BB_PAYLOAD_FORMAT"
BB_PAYLOAD_VERSION="$BB_PAYLOAD_VERSION"
BB_BUSYBOX_GROUPS="$BB_BUSYBOX_GROUPS"
BB_HEAVY_TOOLS="$BB_HEAVY_TOOLS"
BB_DROPBEAR_SERVER_MODE="$BB_DROPBEAR_SERVER_MODE"
BB_ENABLE_CUSTOM_TARGET="$BB_ENABLE_CUSTOM_TARGET"
BB_CUSTOM_ARCH="$BB_CUSTOM_ARCH"
BB_CUSTOM_ENDIAN="$BB_CUSTOM_ENDIAN"
BB_CUSTOM_LIBC="$BB_CUSTOM_LIBC"
BB_CUSTOM_KERNEL_FLOOR="$BB_CUSTOM_KERNEL_FLOOR"
BB_CUSTOM_ABI="$BB_CUSTOM_ABI"
EOF

    if [ -f "$CFG_FILE" ] && diff -u "$CFG_FILE" "$temp_cfg" >"$temp_out" 2>/dev/null; then
        dialog --title "BusierBox: No changes" --msgbox "Configuration matches current settings. Nothing to save." 8 55
        return 0
    fi

    if [ -f "$CFG_FILE" ]; then
        dialog --title "BusierBox: Confirm Changes" --textbox "$temp_out" 20 75 || return 1
    else
        dialog --title "BusierBox: Save New Config" --yesno "Save configuration to $CFG_FILE?" 8 50 || return 1
    fi
    cp "$temp_cfg" "$CFG_FILE"
    dialog --title "BusierBox: Success" --msgbox "Configuration written to $CFG_FILE." 8 55
}

configure_known_profiles() {
    if ! command -v python3 >/dev/null 2>&1 || [ ! -f targets/profiles.json ]; then
        dialog --title "Target Selection / Known profiles" --msgbox "python3 and targets/profiles.json are required to edit known profiles." 8 70
        return 0
    fi

    python3 - "$BB_TARGETS" >"$temp_cfg" <<'PY'
import json
import shlex
import sys

selected = set(sys.argv[1].split())
with open("targets/profiles.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)

args = []
for profile in data.get("profiles", []):
    name = profile.get("name", "")
    status = profile.get("status", "")
    arch = profile.get("arch", "")
    libc = profile.get("libc", "")
    kernel = profile.get("kernel_floor", "")
    abi = profile.get("abi", "")
    desc = f"{status}: {arch} linux {kernel} {libc}"
    if abi:
        desc = f"{desc} {abi}"
    args.extend([name, desc, "on" if name in selected else "off"])
print(" ".join(shlex.quote(arg) for arg in args))
PY

    eval "dialog --title 'Target Selection / Known profiles' \
        --checklist 'Select known release/test profiles:' 22 92 12 \
        $(cat "$temp_cfg") \
        2>'$temp_out'" || return 0
    BB_TARGETS=$(cat "$temp_out" | tr -d '"')
}

configure_custom_tuple() {
    while :; do
        dialog --title "Target Selection / Custom tuple" \
            --menu "Configure an optional experimental target tuple. Current: enabled=$BB_ENABLE_CUSTOM_TARGET arch=$BB_CUSTOM_ARCH libc=$BB_CUSTOM_LIBC kernel=$BB_CUSTOM_KERNEL_FLOOR abi=$BB_CUSTOM_ABI" 18 86 8 \
            "1" "Enable custom tuple: $BB_ENABLE_CUSTOM_TARGET" \
            "2" "Architecture: $BB_CUSTOM_ARCH" \
            "3" "Libc: $BB_CUSTOM_LIBC" \
            "4" "Kernel floor: $BB_CUSTOM_KERNEL_FLOOR" \
            "5" "ABI/floating point: $BB_CUSTOM_ABI" \
            "6" "Endianness override: $BB_CUSTOM_ENDIAN" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1)
                dialog --title "Enable custom tuple" --radiolist "Enable custom tuple generation?" 10 60 2 \
                    "yes" "Enable custom experimental tuple" "$(onoff "$BB_ENABLE_CUSTOM_TARGET")" \
                    "no" "Disable custom experimental tuple" "$( [ "$BB_ENABLE_CUSTOM_TARGET" = yes ] && printf off || printf on )" \
                    2>"$temp_out" || true
                BB_ENABLE_CUSTOM_TARGET=$(cat "$temp_out" | tr -d '"')
                ;;
            2)
                dialog --title "Custom architecture" --menu "Select architecture:" 17 60 9 \
                    "mipsel" "MIPS little-endian" \
                    "mips" "MIPS big-endian" \
                    "armv5" "ARMv5" \
                    "armv7" "ARMv7" \
                    "aarch64" "AArch64" \
                    "i386" "x86" \
                    "x86_64" "x86_64" \
                    "powerpc" "PowerPC" \
                    "riscv64" "RISC-V 64" \
                    2>"$temp_out" || true
                BB_CUSTOM_ARCH=$(cat "$temp_out" | tr -d '"')
                ;;
            3)
                dialog --title "Custom libc" --menu "Select libc:" 12 50 3 \
                    "musl" "musl libc" \
                    "uclibc" "uClibc-ng" \
                    "glibc" "glibc" \
                    2>"$temp_out" || true
                BB_CUSTOM_LIBC=$(cat "$temp_out" | tr -d '"')
                ;;
            4)
                dialog --title "Custom kernel floor" --menu "Select kernel floor:" 14 50 5 \
                    "2.4" "Linux 2.4" \
                    "2.6" "Linux 2.6" \
                    "3.x" "Linux 3.x" \
                    "4.x" "Linux 4.x" \
                    "current" "Current" \
                    2>"$temp_out" || true
                BB_CUSTOM_KERNEL_FLOOR=$(cat "$temp_out" | tr -d '"')
                ;;
            5)
                dialog --title "Custom ABI" --menu "Select ABI/floating-point profile:" 14 60 5 \
                    "default" "Default for architecture" \
                    "softfloat" "Soft float" \
                    "hardfloat" "Hard float" \
                    "eabi" "ARM EABI" \
                    "eabihf" "ARM EABI hard float" \
                    2>"$temp_out" || true
                BB_CUSTOM_ABI=$(cat "$temp_out" | tr -d '"')
                ;;
            6)
                dialog --title "Custom endianness" --menu "Select endianness override:" 12 50 3 \
                    "auto" "Infer from architecture" \
                    "little" "Little endian" \
                    "big" "Big endian" \
                    2>"$temp_out" || true
                BB_CUSTOM_ENDIAN=$(cat "$temp_out" | tr -d '"')
                ;;
            0) return 0 ;;
        esac
    done
}

configure_target_selection() {
    while :; do
        dialog --title "BusierBox menuconfig / Target Selection" \
            --menu "Choose a submenu:" 14 70 4 \
            "1" "Known release/test profiles" \
            "2" "Custom experimental tuple" \
            "3" "Show current target summary" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_known_profiles ;;
            2) configure_custom_tuple ;;
            3) dialog --title "Current target summary" --msgbox "Known profiles:\n$BB_TARGETS\n\nCustom tuple enabled: $BB_ENABLE_CUSTOM_TARGET\narch=$BB_CUSTOM_ARCH\nlibc=$BB_CUSTOM_LIBC\nkernel_floor=$BB_CUSTOM_KERNEL_FLOOR\nabi=$BB_CUSTOM_ABI\nendian=$BB_CUSTOM_ENDIAN" 16 70 ;;
            0) return 0 ;;
        esac
    done
}

configure_payload_format() {
    status_tgz=off
    status_tar=off
    if [ "$BB_PAYLOAD_FORMAT" = "tar" ]; then status_tar=on; else status_tgz=on; fi
    dialog --title "Payload / Archive format" \
        --radiolist "Select payload format. Both are extracted by BusierBox without external tar/gzip." 12 70 2 \
        "tgz" "Gzipped ustar payload (default, smaller)" "$status_tgz" \
        "tar" "Plain ustar payload (debug/recovery)" "$status_tar" \
        2>"$temp_out" || return 0
    BB_PAYLOAD_FORMAT=$(cat "$temp_out" | tr -d '"')
}

configure_busybox_groups() {
    status_shell=off; status_fileops=off; status_disk=off
    status_process=off; status_network=off; status_text=off; status_system=off
    has_item "$BB_BUSYBOX_GROUPS" "shell" && status_shell=on
    has_item "$BB_BUSYBOX_GROUPS" "fileops" && status_fileops=on
    has_item "$BB_BUSYBOX_GROUPS" "disk" && status_disk=on
    has_item "$BB_BUSYBOX_GROUPS" "process" && status_process=on
    has_item "$BB_BUSYBOX_GROUPS" "network" && status_network=on
    has_item "$BB_BUSYBOX_GROUPS" "text" && status_text=on
    has_item "$BB_BUSYBOX_GROUPS" "system" && status_system=on

    dialog --title "Payload / BusyBox applet groups" \
        --checklist "Select BusyBox applet groups:" 18 72 8 \
        "shell" "sh, ash, echo, test" "$status_shell" \
        "fileops" "cat, ls, cp, mv, rm, mkdir, chmod, touch" "$status_fileops" \
        "disk" "dd, df, mount, tar, gzip, gunzip, zcat" "$status_disk" \
        "process" "ps, free, kill, id, whoami, which, uname" "$status_process" \
        "network" "nc, ping, wget, ip, ifconfig, netstat" "$status_network" \
        "text" "grep, sed, awk, tee, xargs, find, sort" "$status_text" \
        "system" "dmesg, sysctl, date, hexdump" "$status_system" \
        2>"$temp_out" || return 0
    BB_BUSYBOX_GROUPS=$(cat "$temp_out" | tr -d '"')
}

configure_heavy_tools() {
    status_dropbear=off; status_curl=off; status_tmux=off
    status_zsh=off; status_strace=off; status_gdbserver=off
    has_item "$BB_HEAVY_TOOLS" "dropbear" && status_dropbear=on
    has_item "$BB_HEAVY_TOOLS" "curl" && status_curl=on
    has_item "$BB_HEAVY_TOOLS" "tmux" && status_tmux=on
    has_item "$BB_HEAVY_TOOLS" "zsh" && status_zsh=on
    has_item "$BB_HEAVY_TOOLS" "strace" && status_strace=on
    has_item "$BB_HEAVY_TOOLS" "gdbserver" && status_gdbserver=on

    dialog --title "Payload / Heavy tools" \
        --checklist "Select heavy tools to stage into the payload:" 18 72 6 \
        "dropbear" "Dropbear SSH client/server" "$status_dropbear" \
        "curl" "curl HTTP client" "$status_curl" \
        "tmux" "tmux terminal multiplexer" "$status_tmux" \
        "zsh" "zsh shell" "$status_zsh" \
        "strace" "strace syscall tracer" "$status_strace" \
        "gdbserver" "gdbserver debugger stub" "$status_gdbserver" \
        2>"$temp_out" || return 0
    BB_HEAVY_TOOLS=$(cat "$temp_out" | tr -d '"')
}

configure_dropbear() {
    if ! has_item "$BB_HEAVY_TOOLS" "dropbear"; then
        dialog --title "Payload / Dropbear" --msgbox "Dropbear is not selected in Heavy tools." 8 50
        return 0
    fi
    status_db_server=off
    [ "$BB_DROPBEAR_SERVER_MODE" = "yes" ] && status_db_server=on
    dialog --title "Payload / Dropbear options" \
        --checklist "Dropbear configuration sub-options:" 12 64 2 \
        "server" "Enable server wrapper (auto-generate host keys)" "$status_db_server" \
        2>"$temp_out" || return 0
    if grep -q "server" "$temp_out"; then
        BB_DROPBEAR_SERVER_MODE="yes"
    else
        BB_DROPBEAR_SERVER_MODE="no"
    fi
}

configure_payload() {
    while :; do
        dialog --title "BusierBox menuconfig / Payload" \
            --menu "Choose a submenu:" 16 72 6 \
            "1" "Archive format: $BB_PAYLOAD_FORMAT" \
            "2" "BusyBox applet groups" \
            "3" "Heavy tools" \
            "4" "Dropbear options" \
            "5" "Payload version: $BB_PAYLOAD_VERSION" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_payload_format ;;
            2) configure_busybox_groups ;;
            3) configure_heavy_tools ;;
            4) configure_dropbear ;;
            5)
                dialog --title "Payload version" --inputbox "Payload version string:" 9 60 "$BB_PAYLOAD_VERSION" 2>"$temp_out" || true
                BB_PAYLOAD_VERSION=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_summary() {
    dialog --title "BusierBox configuration summary" --msgbox "Known targets:\n$BB_TARGETS\n\nCustom target: $BB_ENABLE_CUSTOM_TARGET\n  arch=$BB_CUSTOM_ARCH\n  libc=$BB_CUSTOM_LIBC\n  kernel_floor=$BB_CUSTOM_KERNEL_FLOOR\n  abi=$BB_CUSTOM_ABI\n  endian=$BB_CUSTOM_ENDIAN\n\nPayload:\n  format=$BB_PAYLOAD_FORMAT\n  version=$BB_PAYLOAD_VERSION\n  BusyBox groups=$BB_BUSYBOX_GROUPS\n  heavy tools=$BB_HEAVY_TOOLS\n  dropbear server=$BB_DROPBEAR_SERVER_MODE" 24 78
}

while :; do
    dialog --title "BusierBox menuconfig" \
        --menu "Use arrow keys/Enter to configure BusierBox. This is intentionally Buildroot-style: edit categories, then save when ready." 17 78 7 \
        "1" "Target Selection" \
        "2" "Payload Options" \
        "3" "Show Configuration Summary" \
        "4" "Save Configuration" \
        "5" "Save and Exit" \
        "6" "Exit Without Saving" \
        2>"$temp_out" || break
    choice=$(cat "$temp_out")
    case "$choice" in
        1) configure_target_selection ;;
        2) configure_payload ;;
        3) show_summary ;;
        4) save_config ;;
        5) save_config && exit 0 ;;
        6) exit 0 ;;
    esac
done
