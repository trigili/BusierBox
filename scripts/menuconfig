}

configure_payload_format() {
    status_tgz=off
    status_tar=off
    if [ "$BB_PAYLOAD_FORMAT" = "tar" ]; then status_tar=on; else status_tgz=on; fi
    dialog --title "Payload / Archive format" \
        --radiolist "Select payload format. Both are extracted by BusierBox without external tar/gzip." 12 70 2 \
        "tgz" "Gzipped ustar payload (default, smaller)" "$status_tgz" \
        "tar" "Plain ustar payload (debug/recovery)" "$status_tar" \
        2>"$temp_out" || return 0
    BB_PAYLOAD_FORMAT=$(cat "$temp_out" | tr -d '"')
}

configure_artifact_outputs() {
    dialog --title "Artifact Outputs" \
        --checklist "Select artifacts to build. Core is internal/debug only and is staged under dist/internal/." 14 78 3 \
        "full" "Build full artifact with embedded payload" "$(onoff "$BB_BUILD_FULL")" \
        "stager" "Build stager artifact for bootstrap/fetch-full" "$(onoff "$BB_BUILD_STAGER")" \
        "core" "Build internal core artifact without embedded payload" "$(onoff "$BB_BUILD_INTERNAL_CORE")" \
        2>"$temp_out" || return 0
    _sel=$(cat "$temp_out" | tr -d '"')
    BB_BUILD_FULL=no
    BB_BUILD_STAGER=no
    BB_BUILD_INTERNAL_CORE=no
    has_item "$_sel" full && BB_BUILD_FULL=yes
    has_item "$_sel" stager && BB_BUILD_STAGER=yes
    has_item "$_sel" core && BB_BUILD_INTERNAL_CORE=yes
    return 0
}

configure_stager_callback() {
    while :; do
        _cb_status="disabled"
        [ "$BB_STAGER_CALLBACK_ENABLE" = yes ] && _cb_status="ENABLED"
        _host_disp="${BB_STAGER_CALLBACK_HOST:-not set}"
        _tok_disp="not set"
        [ -n "$BB_STAGER_TOKEN" ] && _tok_disp="set (${#BB_STAGER_TOKEN} chars)"
        dialog --title "Stager / Callback Configuration" \
            --menu "Stager callback: $_cb_status\nThe stager calls back to your server on first run (no args).\nConnection is explicit and non-persistent." 18 78 9 \
            "1" "Enable callback: $BB_STAGER_CALLBACK_ENABLE" \
            "2" "Server host: $_host_disp" \
            "3" "Server port: $BB_STAGER_CALLBACK_PORT" \
            "4" "Token: $_tok_disp" \
            "5" "Connect timeout: ${BB_STAGER_CONNECT_TIMEOUT}s" \
            "6" "Retry count: $BB_STAGER_RETRY_COUNT (-1 = unlimited)" \
            "7" "Retry delay: ${BB_STAGER_RETRY_DELAY}s" \
            "8" "Output path (where to write received artifact): $BB_STAGER_OUTPUT_PATH" \
            "9" "Post-receive behavior: configured under Payload Options -> zero-arg" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ "$BB_STAGER_CALLBACK_ENABLE" = yes ]; then
                    BB_STAGER_CALLBACK_ENABLE=no
                else
                    BB_STAGER_CALLBACK_ENABLE=yes
                fi
                ;;
            2)
                dialog --title "Stager Callback Host" \
                    --inputbox "Callback server host/IP (your workstation). Leave blank to configure later." \
                    9 72 "$BB_STAGER_CALLBACK_HOST" 2>"$temp_out" || true
                BB_STAGER_CALLBACK_HOST=$(cat "$temp_out")
                ;;
            3)
                dialog --title "Stager Callback Port" \
                    --inputbox "Server port (must match busierbox-server --listen port)." \
                    9 60 "$BB_STAGER_CALLBACK_PORT" 2>"$temp_out" || true
                BB_STAGER_CALLBACK_PORT=$(cat "$temp_out")
                ;;
            4) configure_token_value BB_STAGER_TOKEN "Stager Token" ;;
            5)
                dialog --title "Connect Timeout" \
                    --inputbox "Seconds before a connection attempt times out." \
                    9 60 "$BB_STAGER_CONNECT_TIMEOUT" 2>"$temp_out" || true
                BB_STAGER_CONNECT_TIMEOUT=$(cat "$temp_out")
                ;;
            6)
                dialog --title "Retry Count" \
                    --inputbox "Number of connection attempts before giving up.\nUse -1 for unlimited retry while the stager process is running." \
                    9 60 "$BB_STAGER_RETRY_COUNT" 2>"$temp_out" || true
                BB_STAGER_RETRY_COUNT=$(cat "$temp_out")
                ;;
            7)
                dialog --title "Retry Delay" \
                    --inputbox "Seconds between connection attempts." \
                    9 60 "$BB_STAGER_RETRY_DELAY" 2>"$temp_out" || true
                BB_STAGER_RETRY_DELAY=$(cat "$temp_out")
                ;;
            8)
                dialog --title "Output Path" \
                    --inputbox "Where the stager writes the received full artifact on target." \
                    9 78 "$BB_STAGER_OUTPUT_PATH" 2>"$temp_out" || true
                BB_STAGER_OUTPUT_PATH=$(cat "$temp_out")
                ;;
            9)
                dialog --title "Post-receive Behavior" \
                    --msgbox "Post-receive behavior is configured under:\n\n  Payload Options -> zero-arg\n\n'post-receive action' means what the stager asks the received full artifact to do after download." \
                    12 76
                ;;
            0) return 0 ;;
        esac
    done
}


busybox_group_status() {
    _group=$1
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && printf on || printf off
}

configure_busybox_group_applets() {
    _group=$1
    _title=$2
    _group_enabled=no
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && _group_enabled=yes

    scripts/busybox-applet-map | awk -v group="$_group" -v group_enabled="$_group_enabled" -v overrides="$BB_BUSYBOX_APPLET_OVERRIDES" '
        function quote(s,    q) {
            q = sprintf("%c", 39)
            gsub(q, q "\\" q q, s)
            return q s q
        }
        BEGIN {
            split(overrides, o)
            for (i in o) {
                if (o[i] ~ /^\+/) forced[substr(o[i], 2)] = 1
                else if (o[i] ~ /^-/) disabled[substr(o[i], 2)] = 1
            }
        }
        $1 == group {
            state = group_enabled == "yes" ? "on" : "off"
            if ($2 in forced) state = "on"
            if ($2 in disabled) state = "off"
            desc = ""
            for (i = 4; i <= NF; i++) desc = desc (i == 4 ? "" : " ") $i
            printf "%s %s %s ", quote($2), quote(desc), quote(state)
        }
    ' >"$temp_cfg"

    if ! eval "dialog --title 'BusyBox Applets / $_title' \
        --checklist 'Group checkbox sets the default. Changes here are stored as individual applet overrides.' 22 86 14 \
        $(cat "$temp_cfg") \
        2>'$temp_out'"
    then
        return 0
    fi

    _selected=$(cat "$temp_out" | tr -d '"')
    _new_overrides=
    for _old in $BB_BUSYBOX_APPLET_OVERRIDES; do
        case "$_old" in
            +*|-*)
                _name=${_old#?}
                if scripts/busybox-applet-map | awk -v group="$_group" -v applet="$_name" '$1 == group && $2 == applet { found = 1 } END { exit found ? 0 : 1 }'; then
                    continue
                fi
                ;;
        esac
        _new_overrides="${_new_overrides:+$_new_overrides }$_old"
    done
    while IFS= read -r _applet; do
        [ -n "$_applet" ] || continue
        _chosen=no
        has_item "$_selected" "$_applet" && _chosen=yes
        if [ "$_group_enabled" = yes ] && [ "$_chosen" = no ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }-$_applet"
        elif [ "$_group_enabled" = no ] && [ "$_chosen" = yes ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }+$_applet"
        fi
    done <<EOF
$(scripts/busybox-applet-map | awk -v group="$_group" '$1 == group { print $2 }')
EOF
    BB_BUSYBOX_APPLET_OVERRIDES="$_new_overrides"
    return 0
}

configure_busybox_groups() {
    while :; do
        dialog --title "BusyBox Applets" \
        --menu "Toggle sensible default groups or browse every BusyBox applet by source category for individual overrides." 25 92 20 \
        "1" "Group defaults" \
