                fi
                ;;
            6)
                if dialog --title "ABI/floating point" --menu "Select ABI/floating-point profile:" 15 64 6 \
                    "default" "Default for architecture" \
                    "softfloat" "Soft float" \
                    "hardfloat" "Hard float" \
                    "eabi" "ARM EABI" \
                    "eabihf" "ARM EABI hard float" \
                    "o32" "MIPS o32" \
                    2>"$temp_out"
                then
                    BB_TARGET_ABI=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            7)
                if dialog --title "Libc" --menu "Select libc:" 12 50 3 \
                    "musl" "musl libc" \
                    "uclibc" "uClibc-ng" \
                    "host" "Native host libc" \
                    2>"$temp_out"
                then
                    BB_TARGET_LIBC=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            8)
                if dialog --title "Kernel floor" --menu "Select kernel floor:" 15 50 6 \
                    "2.6" "Linux 2.6" \
                    "3.x" "Linux 3.x" \
                    "4.x" "Linux 4.x" \
                    "5.x" "Linux 5.x" \
                    "current" "Current" \
                    "host" "Native host" \
                    2>"$temp_out"
                then
                    BB_KERNEL_FLOOR=$(cat "$temp_out" | tr -d '"')
                fi
