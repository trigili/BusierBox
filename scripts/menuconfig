configure_payload_format() {
    status_tgz=off
    status_tar=off
    if [ "$BB_PAYLOAD_FORMAT" = "tar" ]; then status_tar=on; else status_tgz=on; fi
    dialog --title "Payload / Archive format" \
        --radiolist "Select payload format. Both are extracted by BusierBox without external tar/gzip." 12 70 2 \
        "tgz" "Gzipped ustar payload (default, smaller)" "$status_tgz" \
        "tar" "Plain ustar payload (debug/recovery)" "$status_tar" \
        2>"$temp_out" || return 0
    BB_PAYLOAD_FORMAT=$(cat "$temp_out" | tr -d '"')
}

configure_runtime_mode() {
    while :; do
        dialog --title "Runtime mode" \
            --menu "Configure filesystem impact. BusierBox controls its own writes but external payload tools may still have their own behavior." 21 88 8 \
            "1" "Runtime mode: $BB_RUNTIME_MODE" \
            "2" "Runtime root: $BB_RUNTIME_ROOT" \
            "3" "Allow fallback root: $BB_RUNTIME_ALLOW_FALLBACK_ROOT" \
            "4" "Fallback root: $BB_RUNTIME_FALLBACK_ROOT" \
            "5" "Allow external writes: $BB_RUNTIME_ALLOW_EXTERNAL_WRITES" \
            "6" "Build internal core artifact: $BB_BUILD_INTERNAL_CORE" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Runtime mode" \
                    --radiolist "extract is full-featured. core-only avoids payload extraction. no-residue uses temporary runtime state and best-effort cleanup." 13 82 3 \
                    "extract" "Extract payload under runtime root" "$(mode_onoff "$BB_RUNTIME_MODE" extract)" \
                    "core-only" "Do not extract payload; built-in applets only" "$(mode_onoff "$BB_RUNTIME_MODE" core-only)" \
                    "no-residue" "Temporary runtime with best-effort cleanup" "$(mode_onoff "$BB_RUNTIME_MODE" no-residue)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                if [ -n "$_v" ]; then
                    BB_RUNTIME_MODE="$_v"
                    if [ "$_v" = core-only ]; then
                        BB_HEAVY_TOOLS=""
                        BB_DOTFILES_ENABLE=no
                        BB_USER_OVERLAY_ENABLE=no
                    fi
                fi
                ;;
            2) dialog --title "Runtime root" --inputbox "Default BusierBox-controlled runtime directory." 9 78 "$BB_RUNTIME_ROOT" 2>"$temp_out" || true; BB_RUNTIME_ROOT=$(cat "$temp_out") ;;
            3) [ "$BB_RUNTIME_ALLOW_FALLBACK_ROOT" = yes ] && BB_RUNTIME_ALLOW_FALLBACK_ROOT=no || BB_RUNTIME_ALLOW_FALLBACK_ROOT=yes ;;
            4) dialog --title "Fallback runtime root" --inputbox "Used only when fallback is explicitly allowed." 9 78 "$BB_RUNTIME_FALLBACK_ROOT" 2>"$temp_out" || true; BB_RUNTIME_FALLBACK_ROOT=$(cat "$temp_out") ;;
            5) [ "$BB_RUNTIME_ALLOW_EXTERNAL_WRITES" = yes ] && BB_RUNTIME_ALLOW_EXTERNAL_WRITES=no || BB_RUNTIME_ALLOW_EXTERNAL_WRITES=yes ;;
            6) [ "$BB_BUILD_INTERNAL_CORE" = yes ] && BB_BUILD_INTERNAL_CORE=no || BB_BUILD_INTERNAL_CORE=yes ;;
            H) show_page_help runtime ;;
            0) return 0 ;;
        esac
    done
}

busybox_group_status() {
    _group=$1
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && printf on || printf off
}

configure_busybox_group_applets() {
    _group=$1
    _title=$2
    _group_enabled=no
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && _group_enabled=yes

    scripts/busybox-applet-map | awk -v group="$_group" -v group_enabled="$_group_enabled" -v overrides="$BB_BUSYBOX_APPLET_OVERRIDES" '
        function quote(s,    q) {
            q = sprintf("%c", 39)
            gsub(q, q "\\" q q, s)
            return q s q
        }
        BEGIN {
            split(overrides, o)
            for (i in o) {
                if (o[i] ~ /^\+/) forced[substr(o[i], 2)] = 1
                else if (o[i] ~ /^-/) disabled[substr(o[i], 2)] = 1
            }
        }
        $1 == group {
            state = group_enabled == "yes" ? "on" : "off"
            if ($2 in forced) state = "on"
            if ($2 in disabled) state = "off"
            desc = ""
            for (i = 4; i <= NF; i++) desc = desc (i == 4 ? "" : " ") $i
            printf "%s %s %s ", quote($2), quote(desc), quote(state)
        }
    ' >"$temp_cfg"

    if ! eval "dialog --title 'BusyBox Applets / $_title' \
        --checklist 'Group checkbox sets the default. Changes here are stored as individual applet overrides.' 22 86 14 \
        $(cat "$temp_cfg") \
        2>'$temp_out'"
    then
        return 0
    fi

    _selected=$(cat "$temp_out" | tr -d '"')
    _new_overrides=
    for _old in $BB_BUSYBOX_APPLET_OVERRIDES; do
        case "$_old" in
            +*|-*)
                _name=${_old#?}
                if scripts/busybox-applet-map | awk -v group="$_group" -v applet="$_name" '$1 == group && $2 == applet { found = 1 } END { exit found ? 0 : 1 }'; then
                    continue
                fi
                ;;
        esac
        _new_overrides="${_new_overrides:+$_new_overrides }$_old"
    done
    while IFS= read -r _applet; do
        [ -n "$_applet" ] || continue
        _chosen=no
        has_item "$_selected" "$_applet" && _chosen=yes
        if [ "$_group_enabled" = yes ] && [ "$_chosen" = no ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }-$_applet"
        elif [ "$_group_enabled" = no ] && [ "$_chosen" = yes ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }+$_applet"
        fi
    done <<EOF
$(scripts/busybox-applet-map | awk -v group="$_group" '$1 == group { print $2 }')
EOF
    BB_BUSYBOX_APPLET_OVERRIDES="$_new_overrides"
    return 0
}

configure_busybox_applet_search() {
    dialog --title "BusyBox Applet Search" \
        --inputbox "Search applet names, groups, and descriptions:" 9 72 "" \
        2>"$temp_out" || return 0
    _query=$(cat "$temp_out")
    [ -n "$_query" ] || return 0

    scripts/busybox-applet-map | awk -v query="$_query" -v groups="$BB_BUSYBOX_GROUPS" -v overrides="$BB_BUSYBOX_APPLET_OVERRIDES" '
        function quote(s,    q) {
            q = sprintf("%c", 39)
            gsub(q, q "\\" q q, s)
            return q s q
        }
        BEGIN {
            q = tolower(query)
            split(groups, g)
            for (i in g) enabled[g[i]] = 1
            split(overrides, o)
            for (i in o) {
                if (o[i] ~ /^\+/) forced[substr(o[i], 2)] = 1
                else if (o[i] ~ /^-/) disabled[substr(o[i], 2)] = 1
            }
        }
        {
            desc = ""
            for (i = 4; i <= NF; i++) desc = desc (i == 4 ? "" : " ") $i
            hay = tolower($1 " " $2 " " desc)
            if (index(hay, q) == 0) next
            state = enabled[$1] ? "on" : "off"
            if ($2 in forced) state = "on"
            if ($2 in disabled) state = "off"
            label = $2 " [" $1 "]"
            printf "%s %s %s ", quote($2), quote(label ": " desc), quote(state)
            print $2 > "'$temp_cfg'.matches"
            count++
        }
        END {
            if (count == 0) exit 2
        }
    ' >"$temp_cfg" || {
        dialog --title "BusyBox Applet Search" \
            --msgbox "No BusyBox applets matched: $_query" 8 64
        rm -f "$temp_cfg.matches"
        return 0
    }

    if ! eval "dialog --title 'BusyBox Applet Search: $_query' \
        --checklist 'Toggle matching applets. Search writes explicit per-applet overrides.' 22 92 14 \
        $(cat "$temp_cfg") \
        2>'$temp_out'"
    then
        rm -f "$temp_cfg.matches"
        return 0
    fi

    _selected=$(cat "$temp_out" | tr -d '"')
    _new_overrides=
    for _old in $BB_BUSYBOX_APPLET_OVERRIDES; do
        _name=${_old#?}
        if grep -qx "$_name" "$temp_cfg.matches"; then
            continue
        fi
        _new_overrides="${_new_overrides:+$_new_overrides }$_old"
    done
    while IFS= read -r _applet; do
        [ -n "$_applet" ] || continue
        _group=$(scripts/busybox-applet-map | awk -v applet="$_applet" '$2 == applet { print $1; exit }')
        _default=no
        has_item "$BB_BUSYBOX_GROUPS" "$_group" && _default=yes
        _chosen=no
        has_item "$_selected" "$_applet" && _chosen=yes
        if [ "$_default" = yes ] && [ "$_chosen" = no ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }-$_applet"
        elif [ "$_default" = no ] && [ "$_chosen" = yes ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }+$_applet"
        fi
    done <"$temp_cfg.matches"
    rm -f "$temp_cfg.matches"
    BB_BUSYBOX_APPLET_OVERRIDES="$_new_overrides"
    return 0
}

