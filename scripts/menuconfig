#!/bin/sh
set -eu

if ! command -v dialog >/dev/null 2>&1; then
    printf 'Error: dialog is required to run menuconfig. Please install it first (e.g., sudo apt install dialog).\n' >&2
    exit 1
fi

CFG_FILE="configs/busierbox.conf"
mkdir -p configs

BB_TARGET_PRESET="native"
BB_TARGET_NAME=""
BB_TARGET_ARCH="native"
BB_TARGET_ENDIAN="auto"
BB_TARGET_CPU="generic"
BB_TARGET_ABI="default"
BB_TARGET_LIBC="host"
BB_KERNEL_FLOOR="host"
BB_STATIC_POLICY="static-preferred"
BB_PAYLOAD_TIER="core"
BB_TARGET_QEMU_USER=""

BB_PAYLOAD_FORMAT="tgz"
BB_PAYLOAD_VERSION="dev"
BB_BUSYBOX_GROUPS="shell fileops disk process network text system"
BB_HEAVY_TOOLS=""
BB_DROPBEAR_SERVER_MODE="no"
BB_BUSYBOX_APPLETS=""
BB_DOTFILE_PROFILE="default-comfort"
BB_DOTFILE_USER_PATH=""

if [ -f "$CFG_FILE" ]; then
    . "./$CFG_FILE"
fi

temp_out=$(mktemp)
temp_cfg=$(mktemp)
temp_resolved=$(mktemp)
trap 'rm -f "$temp_out" "$temp_cfg" "$temp_resolved"' EXIT HUP INT TERM

has_item() {
    list="$1"
    item="$2"
    for x in $list; do
        [ "$x" = "$item" ] && return 0
    done
    return 1
}

onoff() {
    if [ "$1" = yes ]; then printf on; else printf off; fi
}

group_applets_shell="sh ash printf echo test"
group_applets_fileops="cat ls cp mv rm mkdir chmod touch readlink stat ln du install basename dirname"
group_applets_disk="dd df mount umount tar gzip gunzip zcat sync"
group_applets_process="ps free kill killall id whoami which uname env sleep nohup"
group_applets_network="nc ping wget ip ifconfig netstat route hostname dnsdomainname"
group_applets_text="grep egrep fgrep sed awk tee xargs find sort uniq cut head tail wc tr less"
group_applets_system="dmesg sysctl date hexdump xxd od strings stty"

configure_busybox_group_applets() {
    _grp=$1
    _title=$2
    eval "_applets=\"\$group_applets_$_grp\""

    # Determine which applets are currently enabled for this group
    _items=""
    for _a in $_applets; do
        if [ -n "$BB_BUSYBOX_APPLETS" ]; then
            has_item "$BB_BUSYBOX_APPLETS" "$_a" && _st=on || _st=off
        else
            has_item "$BB_BUSYBOX_GROUPS" "$_grp" && _st=on || _st=off
        fi
        _items="$_items $_a \"$_a\" $_st"
    done

    eval "dialog --title 'BusyBox: $_title applets' --checklist 'Select individual $_grp applets:' 22 64 16 $_items 2>'$temp_out'" || return 0
    _selected=$(cat "$temp_out" | tr -d '"')

    # Initialize BB_BUSYBOX_APPLETS from groups if not yet set explicitly
    if [ -z "$BB_BUSYBOX_APPLETS" ]; then
        for _g in $BB_BUSYBOX_GROUPS; do
            eval "_gapp=\"\$group_applets_$_g\""
            BB_BUSYBOX_APPLETS="${BB_BUSYBOX_APPLETS:+$BB_BUSYBOX_APPLETS }$_gapp"
        done
    fi

    # Remove all applets from this group from the explicit list
    _new=""
    for _a in $BB_BUSYBOX_APPLETS; do
        eval "_gapp=\"\$group_applets_$_grp\""
        if ! has_item "$_gapp" "$_a"; then
            _new="${_new:+$_new }$_a"
        fi
    done
    # Add back the selected ones
    BB_BUSYBOX_APPLETS="${_new:+$_new }${_selected}"
}

write_current_config() {
    out=$1
    cat >"$out" <<EOF
# BusierBox build configuration
# Generated by: make menuconfig
# Edit manually or regenerate with: make menuconfig

# Active target tuple. Presets populate these fields; the tuple is the source of truth.
BB_TARGET_PRESET="$BB_TARGET_PRESET"
BB_TARGET_NAME="$BB_TARGET_NAME"
BB_TARGET_ARCH="$BB_TARGET_ARCH"
BB_TARGET_ENDIAN="$BB_TARGET_ENDIAN"
BB_TARGET_CPU="$BB_TARGET_CPU"
BB_TARGET_ABI="$BB_TARGET_ABI"
BB_TARGET_LIBC="$BB_TARGET_LIBC"
BB_KERNEL_FLOOR="$BB_KERNEL_FLOOR"
BB_STATIC_POLICY="$BB_STATIC_POLICY"
BB_PAYLOAD_TIER="$BB_PAYLOAD_TIER"
BB_TARGET_QEMU_USER="$BB_TARGET_QEMU_USER"

# Legacy release-matrix selection is intentionally not used by normal make package.
BB_TARGETS="native"

BB_PAYLOAD_FORMAT="$BB_PAYLOAD_FORMAT"
BB_PAYLOAD_VERSION="$BB_PAYLOAD_VERSION"
BB_BUSYBOX_GROUPS="$BB_BUSYBOX_GROUPS"
BB_HEAVY_TOOLS="$BB_HEAVY_TOOLS"
BB_DROPBEAR_SERVER_MODE="$BB_DROPBEAR_SERVER_MODE"
BB_BUSYBOX_APPLETS="$BB_BUSYBOX_APPLETS"
BB_DOTFILE_PROFILE="$BB_DOTFILE_PROFILE"
BB_DOTFILE_USER_PATH="$BB_DOTFILE_USER_PATH"
EOF
}

target_summary_text() {
    write_current_config "$temp_cfg"
    BUSIERBOX_CONFIG="$temp_cfg" scripts/resolve-target --config >"$temp_resolved" 2>"$temp_out" || {
        printf '%s\n' "Unable to resolve target:"
        cat "$temp_out"
        return 0
    }
    cat "$temp_resolved"
}

save_config() {
    write_current_config "$temp_cfg"
    compat_warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    if [ -n "$compat_warnings" ] && [ "$compat_warnings" != "No heavy tools selected." ]; then
        dialog --title "Payload compatibility warnings" --msgbox "$compat_warnings" 18 86
    fi

    if [ -f "$CFG_FILE" ] && diff -u "$CFG_FILE" "$temp_cfg" >"$temp_out" 2>/dev/null; then
        dialog --title "BusierBox: No changes" --msgbox "Configuration matches current settings. Nothing to save." 8 55
        return 0
    fi

    if [ -f "$CFG_FILE" ]; then
        dialog --title "BusierBox: Confirm Changes" --textbox "$temp_out" 20 80 || return 1
    else
        dialog --title "BusierBox: Save New Config" --yesno "Save configuration to $CFG_FILE?" 8 50 || return 1
    fi
    cp "$temp_cfg" "$CFG_FILE"
    dialog --title "BusierBox: Success" --msgbox "Configuration written to $CFG_FILE." 8 55
}

apply_preset() {
    preset=$1
    eval "$(python3 - "$preset" <<'PY'
import json
import shlex
import sys

preset_name = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
for p in data.get("presets", []):
    if p.get("preset_name") == preset_name:
        def emit(k, v):
            print(f"{k}={shlex.quote(str(v or ''))}")
        emit("BB_TARGET_PRESET", p.get("preset_name"))
        emit("BB_TARGET_NAME", p.get("target_name", ""))
        emit("BB_TARGET_ARCH", p.get("arch"))
        emit("BB_TARGET_ENDIAN", p.get("endian", "auto"))
        emit("BB_TARGET_CPU", p.get("cpu", "generic"))
        emit("BB_TARGET_ABI", p.get("abi", "default"))
        emit("BB_TARGET_LIBC", p.get("libc"))
        emit("BB_KERNEL_FLOOR", p.get("kernel_floor"))
        emit("BB_STATIC_POLICY", p.get("static_policy", "static-preferred"))
        emit("BB_PAYLOAD_TIER", p.get("payload_tier", "core"))
        emit("BB_TARGET_QEMU_USER", p.get("qemu_user", ""))
        raise SystemExit(0)
print(f"unknown preset {preset_name}", file=sys.stderr)
raise SystemExit(1)
PY
)"
}

configure_presets() {
    if ! command -v python3 >/dev/null 2>&1 || [ ! -f targets/presets.json ]; then
        dialog --title "Target Configuration / Presets" --msgbox "python3 and targets/presets.json are required to edit presets." 8 70
        return 0
    fi

    python3 - "$BB_TARGET_PRESET" >"$temp_cfg" <<'PY'
import json
import shlex
import sys

selected = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
args = []
for p in data.get("presets", []):
    name = p.get("preset_name", "")
    desc = f"{p.get('support_status', '')}: {p.get('description', '')}"
    args.extend([name, desc, "on" if name == selected else "off"])
print(" ".join(shlex.quote(arg) for arg in args))
PY

    eval "dialog --title 'Target Configuration / Preset profiles' \
        --radiolist 'Select a preset to populate the active tuple. You can edit fields after applying it.' 22 92 12 \
        $(cat "$temp_cfg") \
        2>'$temp_out'" || return 0
    preset=$(cat "$temp_out" | tr -d '"')
    [ -n "$preset" ] || return 0
    apply_preset "$preset"
}

configure_target_tuple() {
    while :; do
        dialog --title "BusierBox menuconfig / Target Configuration" \
            --menu "Configure the active target tuple. Presets are templates; these fields drive make package." 22 86 12 \
            "1" "Preset profiles: $BB_TARGET_PRESET" \
            "2" "Target architecture: $BB_TARGET_ARCH" \
            "3" "CPU/family: $BB_TARGET_CPU" \
            "4" "Endianness: $BB_TARGET_ENDIAN" \
            "5" "ABI/floating point: $BB_TARGET_ABI" \
            "6" "Libc: $BB_TARGET_LIBC" \
            "7" "Kernel floor: $BB_KERNEL_FLOOR" \
            "8" "Static/dynamic policy: $BB_STATIC_POLICY" \
            "9" "Payload tier: $BB_PAYLOAD_TIER" \
            "10" "Target name override: ${BB_TARGET_NAME:-auto}" \
            "11" "Show target summary" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_presets ;;
            2)
                if dialog --title "Target architecture" --menu "Select architecture:" 17 60 9 \
                    "native" "Native host build" \
                    "mipsel" "MIPS little-endian" \
                    "mips" "MIPS big-endian" \
                    "armv7" "ARMv7" \
                    "aarch64" "AArch64" \
                    "i386" "x86" \
                    "x86_64" "x86_64" \
                    "powerpc" "PowerPC" \
                    "riscv64" "RISC-V 64" \
                    2>"$temp_out"
                then
                    BB_TARGET_ARCH=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            3)
                if dialog --title "CPU/family" --menu "Select CPU/family hint:" 15 64 6 \
                    "generic" "Generic for architecture" \
                    "mips32r2-24kc" "MIPS32r2 / 24Kc-ish" \
                    "cortex-a7" "ARM Cortex-A7" \
                    "cortex-a9" "ARM Cortex-A9" \
                    "cortex-a53" "ARM Cortex-A53" \
                    "host" "Native host" \
                    2>"$temp_out"
                then
                    BB_TARGET_CPU=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            4)
                if dialog --title "Endianness" --menu "Select endianness:" 12 50 3 \
                    "auto" "Infer from architecture" \
                    "little" "Little endian" \
                    "big" "Big endian" \
                    2>"$temp_out"
                then
                    BB_TARGET_ENDIAN=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            5)
                if dialog --title "ABI/floating point" --menu "Select ABI/floating-point profile:" 15 64 6 \
                    "default" "Default for architecture" \
                    "softfloat" "Soft float" \
                    "hardfloat" "Hard float" \
                    "eabi" "ARM EABI" \
                    "eabihf" "ARM EABI hard float" \
                    "o32" "MIPS o32" \
                    2>"$temp_out"
                then
                    BB_TARGET_ABI=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            6)
                if dialog --title "Libc" --menu "Select libc:" 12 50 3 \
                    "musl" "musl libc" \
                    "uclibc" "uClibc-ng" \
                    "host" "Native host libc" \
                    2>"$temp_out"
                then
                    BB_TARGET_LIBC=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            7)
                if dialog --title "Kernel floor" --menu "Select kernel floor:" 15 50 6 \
                    "2.6" "Linux 2.6" \
                    "3.x" "Linux 3.x" \
                    "4.x" "Linux 4.x" \
                    "5.x" "Linux 5.x" \
                    "current" "Current" \
                    "host" "Native host" \
                    2>"$temp_out"
                then
                    BB_KERNEL_FLOOR=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            8)
                if dialog --title "Static/dynamic policy" --menu "Select policy:" 12 64 3 \
                    "static-preferred" "Prefer static payload/core" \
                    "static-required" "Fail when static is unavailable" \
                    "dynamic" "Allow dynamic payload libraries" \
                    2>"$temp_out"
                then
                    BB_STATIC_POLICY=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            9)
                if dialog --title "Payload tier" --menu "Select payload tier:" 12 60 3 \
                    "core" "BusyBox-focused core tools" \
                    "debug" "Core plus debug-heavy tools" \
                    "minimal" "Smallest practical payload" \
                    2>"$temp_out"
                then
                    BB_PAYLOAD_TIER=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            10)
                if dialog --title "Target name override" --inputbox "Leave blank to generate from tuple fields." 9 70 "$BB_TARGET_NAME" 2>"$temp_out"
                then
                    BB_TARGET_NAME=$(cat "$temp_out")
                fi
                ;;
            11)
                summary=$(target_summary_text)
                dialog --title "Current target summary" --msgbox "$summary" 20 82
                ;;
            0) return 0 ;;
        esac
    done
}

configure_payload_format() {
    status_tgz=off
    status_tar=off
    if [ "$BB_PAYLOAD_FORMAT" = "tar" ]; then status_tar=on; else status_tgz=on; fi
    dialog --title "Payload / Archive format" \
        --radiolist "Select payload format. Both are extracted by BusierBox without external tar/gzip." 12 70 2 \
        "tgz" "Gzipped ustar payload (default, smaller)" "$status_tgz" \
        "tar" "Plain ustar payload (debug/recovery)" "$status_tar" \
        2>"$temp_out" || return 0
    BB_PAYLOAD_FORMAT=$(cat "$temp_out" | tr -d '"')
}

configure_busybox_groups() {
    while :; do
        status_shell=off; status_fileops=off; status_disk=off
        status_process=off; status_network=off; status_text=off; status_system=off
        has_item "$BB_BUSYBOX_GROUPS" "shell" && status_shell=on
        has_item "$BB_BUSYBOX_GROUPS" "fileops" && status_fileops=on
        has_item "$BB_BUSYBOX_GROUPS" "disk" && status_disk=on
        has_item "$BB_BUSYBOX_GROUPS" "process" && status_process=on
        has_item "$BB_BUSYBOX_GROUPS" "network" && status_network=on
        has_item "$BB_BUSYBOX_GROUPS" "text" && status_text=on
        has_item "$BB_BUSYBOX_GROUPS" "system" && status_system=on

        dialog --title "BusyBox Applet Groups" \
            --menu "Select a group to configure its applets, or toggle groups then go Back:" 20 72 9 \
            "groups" "Toggle groups (coarse selection)" "" \
            "shell" "Shell tools (sh, ash, echo, test) [$status_shell]" "" \
            "fileops" "File tools (cat, ls, cp, mv, rm, ...) [$status_fileops]" "" \
            "disk" "Disk tools (dd, df, mount, tar, ...) [$status_disk]" "" \
            "process" "Process tools (ps, kill, id, uname, ...) [$status_process]" "" \
            "network" "Network tools (nc, ping, wget, ...) [$status_network]" "" \
            "text" "Text tools (grep, sed, awk, find, ...) [$status_text]" "" \
            "system" "System tools (dmesg, date, hexdump, ...) [$status_system]" "" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            groups)
                dialog --title "Payload / BusyBox applet groups" \
                    --checklist "Select BusyBox applet groups (coarse):" 18 72 8 \
                    "shell" "sh, ash, echo, test" "$status_shell" \
                    "fileops" "cat, ls, cp, mv, rm, mkdir, chmod, touch" "$status_fileops" \
                    "disk" "dd, df, mount, tar, gzip, gunzip, zcat" "$status_disk" \
                    "process" "ps, free, kill, id, whoami, which, uname" "$status_process" \
                    "network" "nc, ping, wget, ip, ifconfig, netstat" "$status_network" \
                    "text" "grep, sed, awk, tee, xargs, find, sort" "$status_text" \
                    "system" "dmesg, sysctl, date, hexdump" "$status_system" \
                    2>"$temp_out" || true
                BB_BUSYBOX_GROUPS=$(cat "$temp_out" | tr -d '"')
                BB_BUSYBOX_APPLETS=""
                ;;
            shell) configure_busybox_group_applets shell "Shell" ;;
            fileops) configure_busybox_group_applets fileops "File" ;;
            disk) configure_busybox_group_applets disk "Disk" ;;
            process) configure_busybox_group_applets process "Process" ;;
            network) configure_busybox_group_applets network "Network" ;;
            text) configure_busybox_group_applets text "Text" ;;
            system) configure_busybox_group_applets system "System" ;;
            0) return 0 ;;
        esac
    done
}

configure_heavy_tools() {
    status_dropbear=off; status_curl=off; status_tmux=off
    status_zsh=off; status_strace=off; status_gdbserver=off
    has_item "$BB_HEAVY_TOOLS" "dropbear" && status_dropbear=on
    has_item "$BB_HEAVY_TOOLS" "curl" && status_curl=on
    has_item "$BB_HEAVY_TOOLS" "tmux" && status_tmux=on
    has_item "$BB_HEAVY_TOOLS" "zsh" && status_zsh=on
    has_item "$BB_HEAVY_TOOLS" "strace" && status_strace=on
    has_item "$BB_HEAVY_TOOLS" "gdbserver" && status_gdbserver=on

    dialog --title "Payload / Heavy tools" \
        --checklist "Select heavy tools to stage into the payload:" 18 72 6 \
        "dropbear" "Dropbear SSH client/server" "$status_dropbear" \
        "curl" "curl HTTP client" "$status_curl" \
        "tmux" "tmux terminal multiplexer" "$status_tmux" \
        "zsh" "zsh shell" "$status_zsh" \
        "strace" "strace syscall tracer" "$status_strace" \
        "gdbserver" "gdbserver debugger stub" "$status_gdbserver" \
        2>"$temp_out" || return 0
    BB_HEAVY_TOOLS=$(cat "$temp_out" | tr -d '"')
}

configure_dropbear() {
    if ! has_item "$BB_HEAVY_TOOLS" "dropbear"; then
        dialog --title "Payload / Dropbear" --msgbox "Dropbear is not selected in Heavy tools." 8 50
        return 0
    fi
    status_db_server=off
    [ "$BB_DROPBEAR_SERVER_MODE" = "yes" ] && status_db_server=on
    dialog --title "Payload / Dropbear options" \
        --checklist "Dropbear configuration sub-options:" 12 64 2 \
        "server" "Enable server wrapper (auto-generate host keys)" "$status_db_server" \
        2>"$temp_out" || return 0
    if grep -q "server" "$temp_out"; then
        BB_DROPBEAR_SERVER_MODE="yes"
    else
        BB_DROPBEAR_SERVER_MODE="no"
    fi
}

configure_dotfiles() {
    while :; do
        dialog --title "Payload / Dotfiles and Shell Personalization" \
            --menu "Configure dotfiles staged into payload/home/:" 17 72 6 \
            "1" "Dotfile profile: $BB_DOTFILE_PROFILE" \
            "2" "User dotfiles path: ${BB_DOTFILE_USER_PATH:-none}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Dotfile profile" \
                    --radiolist "Select dotfile profile:" 14 72 4 \
                    "default-comfort" "Full comfort config (zsh prompt, tmux, gdbinit)" "$([ "$BB_DOTFILE_PROFILE" = "default-comfort" ] && printf on || printf off)" \
                    "default-minimal" "Minimal config (prompt only)" "$([ "$BB_DOTFILE_PROFILE" = "default-minimal" ] && printf on || printf off)" \
                    "user-supplied" "Use files from a custom path" "$([ "$BB_DOTFILE_PROFILE" = "user-supplied" ] && printf on || printf off)" \
                    "none" "No dotfiles" "$([ "$BB_DOTFILE_PROFILE" = "none" ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_DOTFILE_PROFILE="$_p"
                ;;
            2)
                dialog --title "User dotfiles path" \
                    --inputbox "Path to directory containing .zshrc, .tmux.conf, etc.:" 9 72 "$BB_DOTFILE_USER_PATH" \
                    2>"$temp_out" || true
                BB_DOTFILE_USER_PATH=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_tool_warnings() {
    write_current_config "$temp_cfg"
    warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    dialog --title "Payload / Tool compatibility" --msgbox "$warnings" 20 86
}

configure_payload() {
    while :; do
        dialog --title "BusierBox menuconfig / Payload Options" \
            --menu "Choose a submenu:" 18 72 8 \
            "1" "Archive format: $BB_PAYLOAD_FORMAT" \
            "2" "BusyBox applet groups" \
            "3" "Heavy tools" \
            "4" "Tool compatibility / warnings" \
            "5" "Dropbear options" \
            "6" "Dotfiles / Shell personalization" \
            "7" "Payload version: $BB_PAYLOAD_VERSION" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_payload_format ;;
            2) configure_busybox_groups ;;
            3) configure_heavy_tools ;;
            4) show_tool_warnings ;;
            5) configure_dropbear ;;
            6) configure_dotfiles ;;
            7)
                dialog --title "Payload version" --inputbox "Payload version string:" 9 60 "$BB_PAYLOAD_VERSION" 2>"$temp_out" || true
                BB_PAYLOAD_VERSION=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_summary() {
    summary=$(target_summary_text)
    dialog --title "BusierBox configuration summary" --msgbox "$summary\n\nPayload:\n  format=$BB_PAYLOAD_FORMAT\n  version=$BB_PAYLOAD_VERSION\n  BusyBox groups=$BB_BUSYBOX_GROUPS\n  heavy tools=$BB_HEAVY_TOOLS\n  dropbear server=$BB_DROPBEAR_SERVER_MODE" 24 82
}

while :; do
    dialog --title "BusierBox menuconfig" \
        --menu "Edit categories, then save when ready. Normal make package builds one active target tuple." 17 78 7 \
        "1" "Target Configuration" \
        "2" "Payload Options" \
        "3" "Show Configuration Summary" \
        "4" "Save Configuration" \
        "5" "Save and Exit" \
        "6" "Exit Without Saving" \
        2>"$temp_out" || break
    choice=$(cat "$temp_out")
    case "$choice" in
        1) configure_target_tuple ;;
        2) configure_payload ;;
        3) show_summary ;;
        4) save_config ;;
        5) save_config && exit 0 ;;
        6) exit 0 ;;
    esac
done
