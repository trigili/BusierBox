#!/bin/sh
set -eu

if ! command -v dialog >/dev/null 2>&1; then
    printf 'Error: dialog is required to run menuconfig. Please install it first (e.g., sudo apt install dialog).\n' >&2
    exit 1
fi

CFG_FILE="configs/busierbox.conf"
mkdir -p configs

BB_TARGET_PRESET="native"
BB_TARGET_NAME=""
BB_TARGET_ARCH="native"
BB_TARGET_ENDIAN="auto"
BB_TARGET_CPU="generic"
BB_TARGET_ABI="default"
BB_TARGET_LIBC="host"
BB_KERNEL_FLOOR="host"
BB_STATIC_POLICY="static-preferred"
BB_PAYLOAD_TIER="core"
BB_TARGET_QEMU_USER=""

BB_PAYLOAD_FORMAT="tgz"
BB_PAYLOAD_VERSION="dev"
BB_BUSYBOX_GROUPS="shell fileops disk process network text system"
BB_HEAVY_TOOLS=""
BB_DROPBEAR_SERVER_MODE="no"
BB_BUSYBOX_APPLETS=""
BB_BUSYBOX_APPLET_OVERRIDES=""
BB_DOTFILE_PROFILE="default-comfort"
BB_DOTFILE_USER_PATH=""
BB_GDBSERVER_PROVIDER="auto"
BB_GDBSERVER_USER_PATH=""
BB_USER_OVERLAY_ENABLE="no"
BB_USER_OVERLAY_ROOT=""
BB_USER_OVERLAY_ALLOW_OVERRIDE="no"

if [ -f "$CFG_FILE" ]; then
    . "./$CFG_FILE"
fi

temp_out=$(mktemp)
temp_cfg=$(mktemp)
temp_resolved=$(mktemp)
trap 'rm -f "$temp_out" "$temp_cfg" "$temp_resolved"' EXIT HUP INT TERM

has_item() {
    list="$1"
    item="$2"
    for x in $list; do
        [ "$x" = "$item" ] && return 0
    done
    return 1
}

onoff() {
    if [ "$1" = yes ]; then printf on; else printf off; fi
}


write_current_config() {
    out=$1
    cat >"$out" <<EOF
# BusierBox build configuration
# Generated by: make menuconfig
# Edit manually or regenerate with: make menuconfig

# Active target tuple. Presets populate these fields; the tuple is the source of truth.
BB_TARGET_PRESET="$BB_TARGET_PRESET"
BB_TARGET_NAME="$BB_TARGET_NAME"
BB_TARGET_ARCH="$BB_TARGET_ARCH"
BB_TARGET_ENDIAN="$BB_TARGET_ENDIAN"
BB_TARGET_CPU="$BB_TARGET_CPU"
BB_TARGET_ABI="$BB_TARGET_ABI"
BB_TARGET_LIBC="$BB_TARGET_LIBC"
BB_KERNEL_FLOOR="$BB_KERNEL_FLOOR"
BB_STATIC_POLICY="$BB_STATIC_POLICY"
BB_PAYLOAD_TIER="$BB_PAYLOAD_TIER"
BB_TARGET_QEMU_USER="$BB_TARGET_QEMU_USER"

# Legacy release-matrix selection is intentionally not used by normal make package.
BB_TARGETS="native"

BB_PAYLOAD_FORMAT="$BB_PAYLOAD_FORMAT"
BB_PAYLOAD_VERSION="$BB_PAYLOAD_VERSION"
BB_BUSYBOX_GROUPS="$BB_BUSYBOX_GROUPS"
BB_HEAVY_TOOLS="$BB_HEAVY_TOOLS"
BB_DROPBEAR_SERVER_MODE="$BB_DROPBEAR_SERVER_MODE"
BB_BUSYBOX_APPLETS="$BB_BUSYBOX_APPLETS"
BB_BUSYBOX_APPLET_OVERRIDES="$BB_BUSYBOX_APPLET_OVERRIDES"
BB_DOTFILE_PROFILE="$BB_DOTFILE_PROFILE"
BB_DOTFILE_USER_PATH="$BB_DOTFILE_USER_PATH"
BB_GDBSERVER_PROVIDER="$BB_GDBSERVER_PROVIDER"
BB_GDBSERVER_USER_PATH="$BB_GDBSERVER_USER_PATH"
BB_USER_OVERLAY_ENABLE="$BB_USER_OVERLAY_ENABLE"
BB_USER_OVERLAY_ROOT="$BB_USER_OVERLAY_ROOT"
BB_USER_OVERLAY_ALLOW_OVERRIDE="$BB_USER_OVERLAY_ALLOW_OVERRIDE"
EOF
}

target_summary_text() {
    write_current_config "$temp_cfg"
    BUSIERBOX_CONFIG="$temp_cfg" scripts/resolve-target --config >"$temp_resolved" 2>"$temp_out" || {
        printf '%s\n' "Unable to resolve target:"
        cat "$temp_out"
        return 0
    }
    cat "$temp_resolved"
}

save_config() {
    write_current_config "$temp_cfg"
    compat_warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    if [ -n "$compat_warnings" ] && [ "$compat_warnings" != "No heavy tools selected." ]; then
        dialog --title "Payload compatibility warnings" --msgbox "$compat_warnings" 18 86
    fi

    if [ -f "$CFG_FILE" ] && diff -u "$CFG_FILE" "$temp_cfg" >"$temp_out" 2>/dev/null; then
        dialog --title "BusierBox: No changes" --msgbox "Configuration matches current settings. Nothing to save." 8 55
        return 0
    fi

    if [ -f "$CFG_FILE" ]; then
        dialog --title "BusierBox: Confirm Changes" --textbox "$temp_out" 20 80 || return 1
    else
        dialog --title "BusierBox: Save New Config" --yesno "Save configuration to $CFG_FILE?" 8 50 || return 1
    fi
    cp "$temp_cfg" "$CFG_FILE"
    dialog --title "BusierBox: Success" --msgbox "Configuration written to $CFG_FILE." 8 55
}

apply_preset() {
    preset=$1
    eval "$(python3 - "$preset" <<'PY'
import json
import shlex
import sys

preset_name = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
for p in data.get("presets", []):
    if p.get("preset_name") == preset_name:
        def emit(k, v):
            print(f"{k}={shlex.quote(str(v or ''))}")
        emit("BB_TARGET_PRESET", p.get("preset_name"))
        emit("BB_TARGET_NAME", p.get("target_name", ""))
        emit("BB_TARGET_ARCH", p.get("arch"))
        emit("BB_TARGET_ENDIAN", p.get("endian", "auto"))
        emit("BB_TARGET_CPU", p.get("cpu", "generic"))
        emit("BB_TARGET_ABI", p.get("abi", "default"))
        emit("BB_TARGET_LIBC", p.get("libc"))
        emit("BB_KERNEL_FLOOR", p.get("kernel_floor"))
        emit("BB_STATIC_POLICY", p.get("static_policy", "static-preferred"))
        emit("BB_PAYLOAD_TIER", p.get("payload_tier", "core"))
        emit("BB_TARGET_QEMU_USER", p.get("qemu_user", ""))
        raise SystemExit(0)
print(f"unknown preset {preset_name}", file=sys.stderr)
raise SystemExit(1)
PY
)"
}

configure_presets() {
    if ! command -v python3 >/dev/null 2>&1 || [ ! -f targets/presets.json ]; then
        dialog --title "Target Configuration / Presets" --msgbox "python3 and targets/presets.json are required to edit presets." 8 70
        return 0
    fi

    python3 - "$BB_TARGET_PRESET" >"$temp_cfg" <<'PY'
import json
import shlex
import sys

selected = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
args = []
for p in data.get("presets", []):
    name = p.get("preset_name", "")
    desc = f"{p.get('support_status', '')}: {p.get('description', '')}"
    args.extend([name, desc, "on" if name == selected else "off"])
print(" ".join(shlex.quote(arg) for arg in args))
PY

    eval "dialog --title 'Target Configuration / Preset profiles' \
        --radiolist 'Select a preset to populate the active tuple. You can edit fields after applying it.' 22 92 12 \
        $(cat "$temp_cfg") \
        2>'$temp_out'" || return 0
    preset=$(cat "$temp_out" | tr -d '"')
    [ -n "$preset" ] || return 0
    apply_preset "$preset"
}

configure_target_tuple() {
    while :; do
        dialog --title "BusierBox menuconfig / Target Configuration" \
            --menu "Configure the active target tuple. Presets are templates; these fields drive make package." 22 86 12 \
            "1" "Preset profiles: $BB_TARGET_PRESET" \
            "2" "Target architecture: $BB_TARGET_ARCH" \
            "3" "CPU/family: $BB_TARGET_CPU" \
            "4" "Endianness: $BB_TARGET_ENDIAN" \
            "5" "ABI/floating point: $BB_TARGET_ABI" \
            "6" "Libc: $BB_TARGET_LIBC" \
            "7" "Kernel floor: $BB_KERNEL_FLOOR" \
            "8" "Static/dynamic policy: $BB_STATIC_POLICY" \
            "9" "Payload tier: $BB_PAYLOAD_TIER" \
            "10" "Target name override: ${BB_TARGET_NAME:-auto}" \
            "11" "Show target summary" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_presets ;;
            2)
                if dialog --title "Target architecture" --menu "Select architecture:" 17 60 9 \
                    "native" "Native host build" \
                    "mipsel" "MIPS little-endian" \
                    "mips" "MIPS big-endian" \
                    "armv7" "ARMv7" \
                    "aarch64" "AArch64" \
                    "i386" "x86" \
                    "x86_64" "x86_64" \
                    "powerpc" "PowerPC" \
                    "riscv64" "RISC-V 64" \
                    2>"$temp_out"
                then
                    BB_TARGET_ARCH=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            3)
                if dialog --title "CPU/family" --menu "Select CPU/family hint:" 15 64 6 \
                    "generic" "Generic for architecture" \
                    "mips32r2-24kc" "MIPS32r2 / 24Kc-ish" \
                    "cortex-a7" "ARM Cortex-A7" \
                    "cortex-a9" "ARM Cortex-A9" \
                    "cortex-a53" "ARM Cortex-A53" \
                    "host" "Native host" \
                    2>"$temp_out"
                then
                    BB_TARGET_CPU=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            4)
                if dialog --title "Endianness" --menu "Select endianness:" 12 50 3 \
                    "auto" "Infer from architecture" \
                    "little" "Little endian" \
                    "big" "Big endian" \
                    2>"$temp_out"
                then
                    BB_TARGET_ENDIAN=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            5)
                if dialog --title "ABI/floating point" --menu "Select ABI/floating-point profile:" 15 64 6 \
                    "default" "Default for architecture" \
                    "softfloat" "Soft float" \
                    "hardfloat" "Hard float" \
                    "eabi" "ARM EABI" \
                    "eabihf" "ARM EABI hard float" \
                    "o32" "MIPS o32" \
                    2>"$temp_out"
                then
                    BB_TARGET_ABI=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            6)
                if dialog --title "Libc" --menu "Select libc:" 12 50 3 \
                    "musl" "musl libc" \
                    "uclibc" "uClibc-ng" \
                    "host" "Native host libc" \
                    2>"$temp_out"
                then
                    BB_TARGET_LIBC=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            7)
                if dialog --title "Kernel floor" --menu "Select kernel floor:" 15 50 6 \
                    "2.6" "Linux 2.6" \
                    "3.x" "Linux 3.x" \
                    "4.x" "Linux 4.x" \
                    "5.x" "Linux 5.x" \
                    "current" "Current" \
                    "host" "Native host" \
                    2>"$temp_out"
                then
                    BB_KERNEL_FLOOR=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            8)
                if dialog --title "Static/dynamic policy" --menu "Select policy:" 12 64 3 \
                    "static-preferred" "Prefer static payload/core" \
                    "static-required" "Fail when static is unavailable" \
                    "dynamic" "Allow dynamic payload libraries" \
                    2>"$temp_out"
                then
                    BB_STATIC_POLICY=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            9)
                if dialog --title "Payload tier" --menu "Select payload tier:" 12 60 3 \
                    "core" "BusyBox-focused core tools" \
                    "debug" "Core plus debug-heavy tools" \
                    "minimal" "Smallest practical payload" \
                    2>"$temp_out"
                then
                    BB_PAYLOAD_TIER=$(cat "$temp_out" | tr -d '"')
                fi
                ;;
            10)
                if dialog --title "Target name override" --inputbox "Leave blank to generate from tuple fields." 9 70 "$BB_TARGET_NAME" 2>"$temp_out"
                then
                    BB_TARGET_NAME=$(cat "$temp_out")
                fi
                ;;
            11)
                summary=$(target_summary_text)
                dialog --title "Current target summary" --msgbox "$summary" 20 82
                ;;
            0) return 0 ;;
        esac
    done
}

configure_payload_format() {
    status_tgz=off
    status_tar=off
    if [ "$BB_PAYLOAD_FORMAT" = "tar" ]; then status_tar=on; else status_tgz=on; fi
    dialog --title "Payload / Archive format" \
        --radiolist "Select payload format. Both are extracted by BusierBox without external tar/gzip." 12 70 2 \
        "tgz" "Gzipped ustar payload (default, smaller)" "$status_tgz" \
        "tar" "Plain ustar payload (debug/recovery)" "$status_tar" \
        2>"$temp_out" || return 0
    BB_PAYLOAD_FORMAT=$(cat "$temp_out" | tr -d '"')
}

busybox_group_status() {
    _group=$1
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && printf on || printf off
}

configure_busybox_group_applets() {
    _group=$1
    _title=$2
    _group_enabled=no
    has_item "$BB_BUSYBOX_GROUPS" "$_group" && _group_enabled=yes

    scripts/busybox-applet-map | awk -v group="$_group" -v group_enabled="$_group_enabled" -v overrides="$BB_BUSYBOX_APPLET_OVERRIDES" '
        function quote(s,    q) {
            q = sprintf("%c", 39)
            gsub(q, q "\\" q q, s)
            return q s q
        }
        BEGIN {
            split(overrides, o)
            for (i in o) {
                if (o[i] ~ /^\+/) forced[substr(o[i], 2)] = 1
                else if (o[i] ~ /^-/) disabled[substr(o[i], 2)] = 1
            }
        }
        $1 == group {
            state = group_enabled == "yes" ? "on" : "off"
            if ($2 in forced) state = "on"
            if ($2 in disabled) state = "off"
            desc = ""
            for (i = 4; i <= NF; i++) desc = desc (i == 4 ? "" : " ") $i
            printf "%s %s %s ", quote($2), quote(desc), quote(state)
        }
    ' >"$temp_cfg"

    if ! eval "dialog --title 'BusyBox Applets / $_title' \
        --checklist 'Group checkbox sets the default. Changes here are stored as individual applet overrides.' 22 86 14 \
        $(cat "$temp_cfg") \
        2>'$temp_out'"
    then
        return 0
    fi

    _selected=$(cat "$temp_out" | tr -d '"')
    _new_overrides=
    for _old in $BB_BUSYBOX_APPLET_OVERRIDES; do
        case "$_old" in
            +*|-*)
                _name=${_old#?}
                if scripts/busybox-applet-map | awk -v group="$_group" -v applet="$_name" '$1 == group && $2 == applet { found = 1 } END { exit found ? 0 : 1 }'; then
                    continue
                fi
                ;;
        esac
        _new_overrides="${_new_overrides:+$_new_overrides }$_old"
    done
    while IFS= read -r _applet; do
        [ -n "$_applet" ] || continue
        _chosen=no
        has_item "$_selected" "$_applet" && _chosen=yes
        if [ "$_group_enabled" = yes ] && [ "$_chosen" = no ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }-$_applet"
        elif [ "$_group_enabled" = no ] && [ "$_chosen" = yes ]; then
            _new_overrides="${_new_overrides:+$_new_overrides }+$_applet"
        fi
    done <<EOF
$(scripts/busybox-applet-map | awk -v group="$_group" '$1 == group { print $2 }')
EOF
    BB_BUSYBOX_APPLET_OVERRIDES="$_new_overrides"
}

configure_busybox_groups() {
    while :; do
        dialog --title "BusyBox Applets" \
        --menu "Toggle groups for sensible defaults or enter a submenu for individual applet overrides." 21 86 12 \
        "1" "Group defaults" \
        "2" "Shell tools ($(busybox_group_status shell))" \
        "3" "File tools ($(busybox_group_status fileops))" \
        "4" "Disk/archive tools ($(busybox_group_status disk))" \
        "5" "Process/system identity tools ($(busybox_group_status process))" \
        "6" "Network tools ($(busybox_group_status network))" \
        "7" "Text tools ($(busybox_group_status text))" \
        "8" "System inspection tools ($(busybox_group_status system))" \
        "9" "Dangerous / destructive tools ($(busybox_group_status dangerous))" \
        "0" "Back" \
        2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "BusyBox Applet Group Defaults" \
        --checklist "Select applet groups. Individual submenu overrides are preserved." 19 76 8 \
        "shell"   "sh, ash, printf, echo, test"                     "$(has_item "$BB_BUSYBOX_GROUPS" shell   && printf on || printf off)" \
        "fileops" "cat, ls, cp, mv, rm, mkdir, chmod, touch, stat"  "$(has_item "$BB_BUSYBOX_GROUPS" fileops && printf on || printf off)" \
        "disk"    "dd, df, mount, umount, tar, gzip, gunzip, sync"  "$(has_item "$BB_BUSYBOX_GROUPS" disk    && printf on || printf off)" \
        "process" "ps, free, kill, killall, id, whoami, uname, env" "$(has_item "$BB_BUSYBOX_GROUPS" process && printf on || printf off)" \
        "network" "nc, ping, wget, ip, ifconfig, netstat, route"    "$(has_item "$BB_BUSYBOX_GROUPS" network && printf on || printf off)" \
        "text"    "grep, sed, awk, find, sort, head, tail, less"    "$(has_item "$BB_BUSYBOX_GROUPS" text    && printf on || printf off)" \
        "system"  "dmesg, sysctl, date, hexdump, strings, stty"     "$(has_item "$BB_BUSYBOX_GROUPS" system  && printf on || printf off)" \
        "dangerous" "nuke, devmem, reboot, fdisk, mkfs, flash tools" "$(has_item "$BB_BUSYBOX_GROUPS" dangerous && printf on || printf off)" \
        2>"$temp_out" || return 0
                BB_BUSYBOX_GROUPS=$(cat "$temp_out" | tr -d '"')
                BB_BUSYBOX_APPLETS=""
                ;;
            2) configure_busybox_group_applets shell "Shell tools" ;;
            3) configure_busybox_group_applets fileops "File tools" ;;
            4) configure_busybox_group_applets disk "Disk/archive tools" ;;
            5) configure_busybox_group_applets process "Process/system identity tools" ;;
            6) configure_busybox_group_applets network "Network tools" ;;
            7) configure_busybox_group_applets text "Text tools" ;;
            8) configure_busybox_group_applets system "System inspection tools" ;;
            9) configure_busybox_group_applets dangerous "Dangerous / destructive tools" ;;
            0) return 0 ;;
        esac
    done
}

configure_gdbserver_provider() {
    while :; do
        dialog --title "gdbserver Provider" \
            --menu "Configure how gdbserver is obtained for the active target:" 17 78 6 \
            "1" "Provider: $BB_GDBSERVER_PROVIDER" \
            "2" "User binary path: ${BB_GDBSERVER_USER_PATH:-not set}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                dialog --title "gdbserver provider" \
                    --radiolist "Select how gdbserver is provided:" 17 78 5 \
                    "auto"      "Auto: try Buildroot, then user path, then overlay" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "auto"      ] && printf on || printf off)" \
                    "buildroot" "Buildroot only (may fail for some tuples)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "buildroot"  ] && printf on || printf off)" \
                    "user"      "User-supplied binary (set path below)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "user"       ] && printf on || printf off)" \
                    "overlay"   "Overlay: overlay-root/target/bin/gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "overlay"    ] && printf on || printf off)" \
                    "none"      "Disabled — do not stage gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "none"       ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_GDBSERVER_PROVIDER="$_p"
                ;;
            2)
                dialog --title "gdbserver user binary" \
                    --inputbox "Path to pre-built static gdbserver binary for target arch ($BB_TARGET_ARCH):" \
                    9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                    2>"$temp_out" || true
                BB_GDBSERVER_USER_PATH=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

check_gdbserver_compat_interactive() {
    has_item "$BB_HEAVY_TOOLS" "gdbserver" || return 0
    [ "$BB_TARGET_ARCH" = "native" ] && return 0
    command -v python3 >/dev/null 2>&1 || return 0
    [ -f payloads/tool-compat.json ] || return 0

    _arch=${BB_TARGET_ARCH:-}
    _libc=${BB_TARGET_LIBC:-}
    _policy=${BB_STATIC_POLICY:-static-preferred}
    _provider=${BB_GDBSERVER_PROVIDER:-auto}
    [ -n "$_arch" ] && [ -n "$_libc" ] || return 0

    _result=$(scripts/check-tool-providers \
        --arch "$_arch" --libc "$_libc" --static-policy "$_policy" \
        --tool gdbserver --provider "$_provider" 2>/dev/null) || return 0

    _severity=$(printf '%s\n' "$_result" | sed -n 's/^issue_severity=//p')
    [ "$_severity" = "warning" ] || return 0

    _message=$(printf '%s\n' "$_result" | sed -n 's/^issue_message=//p')
    _action=$(printf '%s\n' "$_result" | sed -n 's/^suggested_action=//p')

    dialog --title "  gdbserver: Compatibility Warning  " \
        --msgbox "gdbserver selected for ${_arch}/${_libc} (provider: ${_provider})\n\n${_message}\n\nSuggested: ${_action}" \
        14 84

    dialog --title "gdbserver: Choose Provider" \
        --menu "How should gdbserver be provided for ${_arch}/${_libc}?" 16 78 5 \
        "auto"      "Auto: try Buildroot, fallback to user path / overlay" \
        "user"      "User-supplied: specify path to a pre-built static binary" \
        "overlay"   "Overlay: place binary at overlay-root/target/bin/gdbserver" \
        "buildroot" "Buildroot anyway (will likely be pre-excluded at build time)" \
        "disable"   "Disable gdbserver" \
        2>"$temp_out" || return 0

    _choice=$(cat "$temp_out" | tr -d '"')
    case "$_choice" in
        disable)
            BB_HEAVY_TOOLS=$(printf '%s\n' $BB_HEAVY_TOOLS | grep -v '^gdbserver$' | tr '\n' ' ')
            BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS% }"
            BB_GDBSERVER_PROVIDER="none"
            ;;
        buildroot|auto)
            BB_GDBSERVER_PROVIDER="$_choice"
            ;;
        user)
            BB_GDBSERVER_PROVIDER="user"
            dialog --title "gdbserver: User-supplied binary" \
                --inputbox "Path to static gdbserver binary for target arch (${_arch}):" \
                9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                2>"$temp_out" || return 0
            _path=$(cat "$temp_out")
            [ -n "$_path" ] && BB_GDBSERVER_USER_PATH="$_path"
            if [ -n "${BB_GDBSERVER_USER_PATH:-}" ] && [ ! -f "$BB_GDBSERVER_USER_PATH" ]; then
                dialog --title "Warning" --msgbox \
                    "File not found: $BB_GDBSERVER_USER_PATH\n\nYou can still save this path and provide the binary before running make package." \
                    9 78
            fi
            ;;
        overlay)
            BB_GDBSERVER_PROVIDER="overlay"
            BB_USER_OVERLAY_ENABLE="yes"
            if [ -z "${BB_USER_OVERLAY_ROOT:-}" ]; then
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory:" 9 78 "" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
            fi
            _tname="${BB_TARGET_NAME:-${BB_TARGET_ARCH}-linux-${BB_KERNEL_FLOOR}-${BB_TARGET_LIBC}}"
            _expected="${BB_USER_OVERLAY_ROOT}/${_tname}/bin/gdbserver"
            dialog --title "gdbserver: Overlay path" \
                --msgbox "Place your static gdbserver binary at:\n\n  ${_expected}\n\nbefore running make package." \
                10 84
            ;;
    esac
}

configure_overlay() {
    while :; do
        dialog --title "Payload / User Overlay" \
            --menu "Stage extra binaries and files into the payload from a local directory:" 18 78 6 \
            "1" "Overlay enabled: $BB_USER_OVERLAY_ENABLE" \
            "2" "Overlay root: ${BB_USER_OVERLAY_ROOT:-not set}" \
            "3" "Allow override existing files: $BB_USER_OVERLAY_ALLOW_OVERRIDE" \
            "?" "Layout: overlay-root/common/ and overlay-root/<target>/  are applied" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                if [ "$BB_USER_OVERLAY_ENABLE" = "yes" ]; then
                    BB_USER_OVERLAY_ENABLE="no"
                else
                    BB_USER_OVERLAY_ENABLE="yes"
                fi
                ;;
            2)
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory.\n\nLayout: <root>/common/{bin,lib,share,home} and <root>/<target>/{bin,lib,share,home}" \
                    11 78 "${BB_USER_OVERLAY_ROOT:-}" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
                ;;
            3)
                if [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" = "yes" ]; then
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="no"
                else
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="yes"
                fi
                ;;
            0) return 0 ;;
        esac
    done
}

configure_heavy_tools() {
    status_dropbear=off; status_curl=off; status_tmux=off
    status_zsh=off; status_strace=off; status_gdbserver=off
    status_socat=off; status_tcpdump=off; status_rsync=off; status_mtr=off
    status_iperf3=off; status_ethtool=off; status_iw=off; status_minicom=off
    status_mosh_client=off; status_ripgrep=off; status_jq=off; status_file=off
    status_htop=off; status_screen=off; status_ltrace=off; status_readelf=off
    status_objdump=off; status_xxd=off; status_usbutils=off; status_pciutils=off
    has_item "$BB_HEAVY_TOOLS" "dropbear" && status_dropbear=on
    has_item "$BB_HEAVY_TOOLS" "curl" && status_curl=on
    has_item "$BB_HEAVY_TOOLS" "tmux" && status_tmux=on
    has_item "$BB_HEAVY_TOOLS" "zsh" && status_zsh=on
    has_item "$BB_HEAVY_TOOLS" "strace" && status_strace=on
    has_item "$BB_HEAVY_TOOLS" "gdbserver" && status_gdbserver=on
    has_item "$BB_HEAVY_TOOLS" "socat" && status_socat=on
    has_item "$BB_HEAVY_TOOLS" "tcpdump" && status_tcpdump=on
    has_item "$BB_HEAVY_TOOLS" "rsync" && status_rsync=on
    has_item "$BB_HEAVY_TOOLS" "mtr" && status_mtr=on
    has_item "$BB_HEAVY_TOOLS" "iperf3" && status_iperf3=on
    has_item "$BB_HEAVY_TOOLS" "ethtool" && status_ethtool=on
    has_item "$BB_HEAVY_TOOLS" "iw" && status_iw=on
    has_item "$BB_HEAVY_TOOLS" "minicom" && status_minicom=on
    has_item "$BB_HEAVY_TOOLS" "mosh-client" && status_mosh_client=on
    has_item "$BB_HEAVY_TOOLS" "ripgrep" && status_ripgrep=on
    has_item "$BB_HEAVY_TOOLS" "jq" && status_jq=on
    has_item "$BB_HEAVY_TOOLS" "file" && status_file=on
    has_item "$BB_HEAVY_TOOLS" "htop" && status_htop=on
    has_item "$BB_HEAVY_TOOLS" "screen" && status_screen=on
    has_item "$BB_HEAVY_TOOLS" "ltrace" && status_ltrace=on
    has_item "$BB_HEAVY_TOOLS" "readelf" && status_readelf=on
    has_item "$BB_HEAVY_TOOLS" "objdump" && status_objdump=on
    has_item "$BB_HEAVY_TOOLS" "xxd" && status_xxd=on
    has_item "$BB_HEAVY_TOOLS" "usbutils" && status_usbutils=on
    has_item "$BB_HEAVY_TOOLS" "pciutils" && status_pciutils=on

    dialog --title "Payload / Heavy tools" \
        --checklist "Select heavy tools to stage into the payload:" 28 86 20 \
        "dropbear" "Dropbear SSH client/server" "$status_dropbear" \
        "curl" "curl HTTP client" "$status_curl" \
        "tmux" "tmux terminal multiplexer" "$status_tmux" \
        "zsh" "zsh shell" "$status_zsh" \
        "strace" "strace syscall tracer" "$status_strace" \
        "gdbserver" "gdbserver debugger stub" "$status_gdbserver" \
        "socat" "bidirectional relay tool" "$status_socat" \
        "tcpdump" "packet capture" "$status_tcpdump" \
        "rsync" "file transfer/sync" "$status_rsync" \
        "mtr" "network path diagnostics" "$status_mtr" \
        "iperf3" "network throughput tester" "$status_iperf3" \
        "ethtool" "Ethernet device inspection" "$status_ethtool" \
        "iw" "wireless device inspection" "$status_iw" \
        "minicom" "serial console client" "$status_minicom" \
        "mosh-client" "Mosh client" "$status_mosh_client" \
        "ripgrep" "rg recursive search" "$status_ripgrep" \
        "jq" "JSON processor" "$status_jq" \
        "file" "file type detection" "$status_file" \
        "htop" "interactive process viewer" "$status_htop" \
        "screen" "terminal multiplexer" "$status_screen" \
        "ltrace" "library call tracer" "$status_ltrace" \
        "readelf" "ELF inspector" "$status_readelf" \
        "objdump" "object file disassembler" "$status_objdump" \
        "xxd" "hex dump applet" "$status_xxd" \
        "usbutils" "lsusb provider" "$status_usbutils" \
        "pciutils" "lspci provider" "$status_pciutils" \
        2>"$temp_out" || return 0
    BB_HEAVY_TOOLS=$(cat "$temp_out" | tr -d '"')
    check_gdbserver_compat_interactive
}

configure_dropbear() {
    if ! has_item "$BB_HEAVY_TOOLS" "dropbear"; then
        dialog --title "Payload / Dropbear" --msgbox "Dropbear is not selected in Heavy tools." 8 50
        return 0
    fi
    status_db_server=off
    [ "$BB_DROPBEAR_SERVER_MODE" = "yes" ] && status_db_server=on
    dialog --title "Payload / Dropbear options" \
        --checklist "Dropbear configuration sub-options:" 12 64 2 \
        "server" "Enable server wrapper (auto-generate host keys)" "$status_db_server" \
        2>"$temp_out" || return 0
    if grep -q "server" "$temp_out"; then
        BB_DROPBEAR_SERVER_MODE="yes"
    else
        BB_DROPBEAR_SERVER_MODE="no"
    fi
}

configure_dotfiles() {
    while :; do
        dialog --title "Payload / Dotfiles and Shell Personalization" \
            --menu "Configure dotfiles staged into payload/home/:" 17 72 6 \
            "1" "Dotfile profile: $BB_DOTFILE_PROFILE" \
            "2" "User dotfiles path: ${BB_DOTFILE_USER_PATH:-none}" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                dialog --title "Dotfile profile" \
                    --radiolist "Select dotfile profile:" 15 72 5 \
                    "default-comfort" "Full comfort config (zsh prompt, tmux, gdbinit)" "$([ "$BB_DOTFILE_PROFILE" = "default-comfort" ] && printf on || printf off)" \
                    "default-operator" "Operator config (aliases, vi tmux mode, diagnostics)" "$([ "$BB_DOTFILE_PROFILE" = "default-operator" ] && printf on || printf off)" \
                    "default-minimal" "Minimal config (prompt only)" "$([ "$BB_DOTFILE_PROFILE" = "default-minimal" ] && printf on || printf off)" \
                    "user-supplied" "Use files from a custom path" "$([ "$BB_DOTFILE_PROFILE" = "user-supplied" ] && printf on || printf off)" \
                    "none" "No dotfiles" "$([ "$BB_DOTFILE_PROFILE" = "none" ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_DOTFILE_PROFILE="$_p"
                ;;
            2)
                dialog --title "User dotfiles path" \
                    --inputbox "Path to directory containing .zshrc, .tmux.conf, etc.:" 9 72 "$BB_DOTFILE_USER_PATH" \
                    2>"$temp_out" || true
                BB_DOTFILE_USER_PATH=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_tool_warnings() {
    write_current_config "$temp_cfg"
    warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    dialog --title "Payload / Tool compatibility" --msgbox "$warnings" 20 86
}

configure_payload() {
    while :; do
        dialog --title "BusierBox menuconfig / Payload Options" \
            --menu "Choose a submenu:" 20 78 10 \
            "1" "Archive format: $BB_PAYLOAD_FORMAT" \
            "2" "BusyBox applet groups" \
            "3" "Heavy tools" \
            "4" "Tool compatibility / warnings" \
            "5" "Dropbear options" \
            "6" "Dotfiles / Shell personalization" \
            "7" "User overlay (stage extra binaries): $BB_USER_OVERLAY_ENABLE" \
            "8" "gdbserver provider: $BB_GDBSERVER_PROVIDER" \
            "9" "Payload version: $BB_PAYLOAD_VERSION" \
            "0" "Back" \
            2>"$temp_out" || return 0
        choice=$(cat "$temp_out")
        case "$choice" in
            1) configure_payload_format ;;
            2) configure_busybox_groups ;;
            3) configure_heavy_tools ;;
            4) show_tool_warnings ;;
            5) configure_dropbear ;;
            6) configure_dotfiles ;;
            7) configure_overlay ;;
            8) configure_gdbserver_provider ;;
            9)
                dialog --title "Payload version" --inputbox "Payload version string:" 9 60 "$BB_PAYLOAD_VERSION" 2>"$temp_out" || true
                BB_PAYLOAD_VERSION=$(cat "$temp_out")
                ;;
            0) return 0 ;;
        esac
    done
}

show_summary() {
    summary=$(target_summary_text)
    dialog --title "BusierBox configuration summary" --msgbox "$summary\n\nPayload:\n  format=$BB_PAYLOAD_FORMAT\n  version=$BB_PAYLOAD_VERSION\n  BusyBox groups=$BB_BUSYBOX_GROUPS\n  heavy tools=$BB_HEAVY_TOOLS\n  dropbear server=$BB_DROPBEAR_SERVER_MODE" 24 82
}

while :; do
    dialog --title "BusierBox menuconfig" \
        --menu "Edit categories, then save when ready. Normal make package builds one active target tuple." 17 78 7 \
        "1" "Target Configuration" \
        "2" "Payload Options" \
        "3" "Show Configuration Summary" \
        "4" "Save Configuration" \
        "5" "Save and Exit" \
        "6" "Exit Without Saving" \
        2>"$temp_out" || break
    choice=$(cat "$temp_out")
    case "$choice" in
        1) configure_target_tuple ;;
        2) configure_payload ;;
        3) show_summary ;;
        4) save_config ;;
        5) save_config && exit 0 ;;
        6) exit 0 ;;
    esac
done
