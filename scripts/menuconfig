configure_gdbserver_provider() {
    while :; do
        dialog --title "gdbserver Provider" \
            --menu "Configure how gdbserver is obtained for the active target:" 18 78 7 \
            "1" "Provider: $BB_GDBSERVER_PROVIDER" \
            "2" "User binary path: ${BB_GDBSERVER_USER_PATH:-not set}" \
            "3" "Local drop-in status" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                dialog --title "gdbserver provider" \
                    --radiolist "Select how gdbserver is provided:" 18 82 6 \
                    "auto"      "Auto: try Buildroot, local drop-in, user path, then overlay" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "auto"      ] && printf on || printf off)" \
                    "buildroot" "Buildroot only (may fail for some tuples)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "buildroot"  ] && printf on || printf off)" \
                    "local-dropin" "Local drop-in under local/tools/<target-or-arch>/bin" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "local-dropin" ] && printf on || printf off)" \
                    "user"      "User-supplied binary (set path below)" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "user"       ] && printf on || printf off)" \
                    "overlay"   "Overlay: overlay-root/target/bin/gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "overlay"    ] && printf on || printf off)" \
                    "none"      "Disabled — do not stage gdbserver" \
                        "$([ "$BB_GDBSERVER_PROVIDER" = "none"       ] && printf on || printf off)" \
                    2>"$temp_out" || true
                _p=$(cat "$temp_out" | tr -d '"')
                [ -n "$_p" ] && BB_GDBSERVER_PROVIDER="$_p"
                ;;
            2)
                dialog --title "gdbserver user binary" \
                    --inputbox "Path to pre-built static gdbserver binary for target arch ($BB_TARGET_ARCH):" \
                    9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                    2>"$temp_out" || true
                BB_GDBSERVER_USER_PATH=$(cat "$temp_out")
                ;;
            3)
                _status=$(scripts/tools/dropin-tool-status --tool gdbserver \
                    --target "${BB_TARGET_NAME:-${BB_TARGET_PRESET:-native}}" \
                    --arch "${BB_TARGET_ARCH:-native}" \
                    --libc "${BB_TARGET_LIBC:-host}" 2>/dev/null || true)
                dialog --title "gdbserver local drop-in status" \
                    --msgbox "$_status\n\nInstall helper:\n  scripts/tools/install-dropin-gdbserver --source ./gdbserver --target ${BB_TARGET_NAME:-${BB_TARGET_PRESET:-native}}\n\nCheck helper:\n  scripts/tools/check-dropin-tool --tool gdbserver --path <path> --arch ${BB_TARGET_ARCH:-native} --libc ${BB_TARGET_LIBC:-host}" \
                    24 100
                ;;
            H) show_page_help gdbserver ;;
            0) return 0 ;;
        esac
    done
}

check_gdbserver_compat_interactive() {
    has_item "$BB_HEAVY_TOOLS" "gdbserver" || return 0
    [ "$BB_TARGET_ARCH" = "native" ] && return 0
    command -v python3 >/dev/null 2>&1 || return 0
    [ -f payloads/tool-compat.json ] || return 0

    _arch=${BB_TARGET_ARCH:-}
    _libc=${BB_TARGET_LIBC:-}
    _policy=${BB_STATIC_POLICY:-static-preferred}
    _provider=${BB_GDBSERVER_PROVIDER:-auto}
    [ -n "$_arch" ] && [ -n "$_libc" ] || return 0

    _result=$(scripts/check-tool-providers \
        --arch "$_arch" --libc "$_libc" --static-policy "$_policy" \
        --tool gdbserver --provider "$_provider" 2>/dev/null) || return 0

    _severity=$(printf '%s\n' "$_result" | sed -n 's/^issue_severity=//p')
    [ "$_severity" = "warning" ] || return 0

    _message=$(printf '%s\n' "$_result" | sed -n 's/^issue_message=//p')
    _action=$(printf '%s\n' "$_result" | sed -n 's/^suggested_action=//p')

    dialog --title "  gdbserver: Compatibility Warning  " \
        --msgbox "gdbserver selected for ${_arch}/${_libc} (provider: ${_provider})\n\n${_message}\n\nSuggested: ${_action}" \
        14 84

    dialog --title "gdbserver: Choose Provider" \
        --menu "How should gdbserver be provided for ${_arch}/${_libc}?" 16 78 5 \
        "auto"      "Auto: try Buildroot, fallback to local drop-in / user path / overlay" \
        "local-dropin" "Local drop-in under local/tools/<target-or-arch>/bin" \
        "user"      "User-supplied: specify path to a pre-built static binary" \
        "overlay"   "Overlay: place binary at overlay-root/target/bin/gdbserver" \
        "buildroot" "Buildroot anyway (will likely be pre-excluded at build time)" \
        "disable"   "Disable gdbserver" \
        2>"$temp_out" || return 0

    _choice=$(cat "$temp_out" | tr -d '"')
    case "$_choice" in
        disable)
            BB_HEAVY_TOOLS=$(printf '%s\n' $BB_HEAVY_TOOLS | grep -v '^gdbserver$' | tr '\n' ' ')
            BB_HEAVY_TOOLS="${BB_HEAVY_TOOLS% }"
            BB_GDBSERVER_PROVIDER="none"
            ;;
        buildroot|auto)
            BB_GDBSERVER_PROVIDER="$_choice"
            ;;
        user)
            BB_GDBSERVER_PROVIDER="user"
            dialog --title "gdbserver: User-supplied binary" \
                --inputbox "Path to static gdbserver binary for target arch (${_arch}):" \
                9 78 "${BB_GDBSERVER_USER_PATH:-}" \
                2>"$temp_out" || return 0
            _path=$(cat "$temp_out")
            [ -n "$_path" ] && BB_GDBSERVER_USER_PATH="$_path"
            if [ -n "${BB_GDBSERVER_USER_PATH:-}" ] && [ ! -f "$BB_GDBSERVER_USER_PATH" ]; then
                dialog --title "Warning" --msgbox \
                    "File not found: $BB_GDBSERVER_USER_PATH\n\nYou can still save this path and provide the binary before running make package." \
                    9 78
            fi
            ;;
        overlay)
            BB_GDBSERVER_PROVIDER="overlay"
            BB_USER_OVERLAY_ENABLE="yes"
            if [ -z "${BB_USER_OVERLAY_ROOT:-}" ]; then
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory:" 9 78 "./overlay" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
            fi
            _expected="${BB_USER_OVERLAY_ROOT}/bin/gdbserver"
            dialog --title "gdbserver: Overlay path" \
                --msgbox "Place your static gdbserver binary at:\n\n  ${_expected}\n\nbefore running make package." \
                10 84
            ;;
    esac
}

_overlay_mkdir() {
    _root=$1
    [ -n "$_root" ] || return 0
    mkdir -p "$_root/bin" "$_root/lib" "$_root/share" "$_root/home" "$_root/etc"
    dialog --title "Overlay directories created" \
        --msgbox "Created overlay layout under: $_root\n\nPlace files in bin/, lib/, share/, home/, or etc/.\nThey are merged into the payload during build.\n\nFor target-specific files use a subdirectory named\nafter the target (e.g. $_root/mipsel-linux-musl/)." 14 72
}

configure_overlay() {
    while :; do
        if [ "$BB_RUNTIME_MODE" = core-only ] && [ "$BB_USER_OVERLAY_ENABLE" = yes ]; then
            dialog --title "Payload / User Overlay" \
                --yesno "User overlays cannot be staged in core-only runtime mode.\n\nSet BB_USER_OVERLAY_ENABLE=no now?" \
                9 76 && BB_USER_OVERLAY_ENABLE=no
            return 0
        fi
        dialog --title "Payload / User Overlay" \
            --menu "Stage extra files into the payload from a local directory.\nPlace files in bin/, lib/, share/, home/, or etc/ inside the root." 19 82 6 \
            "1" "Overlay enabled: $BB_USER_OVERLAY_ENABLE" \
            "2" "Overlay root: ${BB_USER_OVERLAY_ROOT:-not set}" \
            "3" "Allow override existing payload files: $BB_USER_OVERLAY_ALLOW_OVERRIDE" \
            "4" "Create overlay directories now" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _ch=$(cat "$temp_out")
        case "$_ch" in
            1)
                if [ "$BB_USER_OVERLAY_ENABLE" = "yes" ]; then
                    BB_USER_OVERLAY_ENABLE="no"
                else
                    BB_USER_OVERLAY_ENABLE="yes"
                fi
                ;;
            2)
                dialog --title "Overlay root path" \
                    --inputbox "Path to overlay root directory.\n\nFiles in bin/, lib/, share/, home/, and etc/ are merged into the payload.\nTarget-specific files go in a <target>/ subdirectory." \
                    12 78 "${BB_USER_OVERLAY_ROOT:-./overlay}" \
                    2>"$temp_out" || true
                BB_USER_OVERLAY_ROOT=$(cat "$temp_out")
                ;;
            3)
                if [ "$BB_USER_OVERLAY_ALLOW_OVERRIDE" = "yes" ]; then
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="no"
                else
                    BB_USER_OVERLAY_ALLOW_OVERRIDE="yes"
                fi
                ;;
            4)
                if [ -z "${BB_USER_OVERLAY_ROOT:-}" ]; then
                    dialog --title "No overlay root set" \
                        --msgbox "Set an overlay root path (option 2) first." 8 50
                else
                    _overlay_mkdir "$BB_USER_OVERLAY_ROOT"
                fi
                ;;
            H) show_page_help overlay ;;
            0) return 0 ;;
        esac
    done
}

heavy_tool_status() {
    has_item "$BB_HEAVY_TOOLS" "$1" && printf on || printf off
}

heavy_category_summary() {
    _items=$1
    _count=0
    while IFS='|' read -r _tool _desc; do
        [ -n "$_tool" ] || continue
        has_item "$BB_HEAVY_TOOLS" "$_tool" && _count=$((_count + 1))
    done <<EOF
$_items
EOF
    printf '%s selected' "$_count"
}

