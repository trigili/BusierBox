#!/bin/sh
set -eu

if ! command -v dialog >/dev/null 2>&1; then
    printf 'Error: dialog is required to run menuconfig. Please install it first (e.g., sudo apt install dialog).\n' >&2
    exit 1
fi

CFG_FILE="configs/busierbox.conf"

# Accept --config <path> or --config=<path> as first argument(s)
_i=0
for _a in "$@"; do
    _i=$((_i + 1))
    case "$_a" in
        --config=*) CFG_FILE="${_a#--config=}"; break ;;
        --config|-c)
            eval "_next=\${$((_i + 1)):-}"
            [ -n "$_next" ] && CFG_FILE="$_next"
            break
            ;;
    esac
done
unset _i _a _next

mkdir -p "$(dirname "$CFG_FILE")"

BB_TARGET_PRESET="native"
BB_TARGETS="native"
BB_TARGET_NAME=""
BB_TARGET_ARCH="native"
BB_TARGET_ENDIAN="auto"
BB_TARGET_CPU="generic"
BB_TARGET_ABI="default"
BB_TARGET_LIBC="host"
BB_KERNEL_FLOOR="host"
BB_STATIC_POLICY="static-preferred"
BB_PAYLOAD_TIER="core"
BB_TARGET_QEMU_USER=""

BB_PAYLOAD_FORMAT="tgz"
BB_PAYLOAD_VERSION="dev"
BB_PAYLOAD_PRESET="default"
BB_RUNTIME_MODE="extract"
BB_RUNTIME_ROOT="./.busierbox"
BB_RUNTIME_ALLOW_FALLBACK_ROOT="no"
BB_RUNTIME_FALLBACK_ROOT="/tmp/.busierbox"
BB_RUNTIME_ALLOW_EXTERNAL_WRITES="no"
BB_BUILD_FULL="yes"
BB_BUILD_INTERNAL_CORE="no"
BB_ZERO_ARG_MODE="${BB_FULL_ZERO_ARG_MODE:-help}"
BB_ZERO_ARG_LOG_MODE="quiet"
BB_FULL_ZERO_ARG_MODE="help"
BB_ZERO_ARG_CUSTOM_COMMAND=""
BB_RSHELL_TRANSPORT="${BB_RSHELL_MODE:-ssh}"
BB_RSHELL_ENCRYPTION="tls"
BB_RSHELL_ALLOW_PLAINTEXT="no"
BB_RSHELL_MODE="ssh"
BB_RSHELL_AUTHKEYS_MODE="disabled"
BB_RSHELL_RUN_MODE="auto"
BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING="no"
BB_RSHELL_SOCAT_PORT="22203"
BB_RSHELL_SHELL_PROVIDER="auto"
BB_RSHELL_CUSTOM_SHELL=""
BB_RSHELL_RETRY_COUNT="1"
BB_RSHELL_RETRY_INTERVAL_SEC="5"
BB_RSHELL_RETRY_JITTER_PCT="20"
BB_RSHELL_RETRY_BACKOFF="none"
BB_RSHELL_RETRY_MAX_INTERVAL_SEC="300"
BB_AUTORUN_GUARD_ENABLE="yes"
BB_AUTORUN_GUARD_PATH="${BB_RUNTIME_ROOT}/run"
BB_AUTORUN_REENTRY_ACTION="status"
BB_AUTORUN_STALE_LOCK_POLICY="recover"
BB_OPERATOR_SERVER_HOST=""
BB_OPERATOR_SERVER_USER="${USER:-operator}"
BB_OPERATOR_SERVER_SSH_PORT="22202"
BB_OPERATOR_REMOTE_FORWARD_PORT="2200"
BB_OPERATOR_TARGET_DROPBEAR_PORT="2222"
BB_OPERATOR_TARGET_BIND_HOST="127.0.0.1"
BB_OPERATOR_DBCLIENT_IDENTITY_FILE=""
BB_OPERATOR_AUTHORIZED_KEY_FILE=""
BB_OPERATOR_KNOWN_HOSTS_POLICY="off"
BB_OPERATOR_FILE_SERVICE_ENABLE="no"
BB_OPERATOR_FILE_SERVICE_PORT="22204"
BB_OPERATOR_FILE_SERVICE_TLS="yes"
BB_SERVER_CONFIG_PATH="local/server-config.json"
BB_BUSYBOX_GROUPS="shell fileops disk process network text system"
BB_HEAVY_TOOLS=""
BB_DROPBEAR_SERVER_MODE="no"
BB_DROPBEAR_BIND_HOST="0.0.0.0"
BB_DROPBEAR_LISTEN_PORT="22"
BB_DROPBEAR_AUTHORIZED_KEYS_FILE=""
BB_DROPBEAR_KEYTYPES="rsa ecdsa"
BB_DROPBEAR_NO_PASSWORD_AUTH="no"
BB_DROPBEAR_NO_ROOT_PASSWORD="no"
BB_DROPBEAR_PREGENERATE_HOSTKEY="no"
BB_BUSYBOX_APPLETS=""
BB_BUSYBOX_APPLET_OVERRIDES=""
BB_DOTFILES_ENABLE="yes"
BB_DOTFILE_ZSH_MODE="default"
BB_DOTFILE_ZSH_USER_FILE=""
BB_DOTFILE_BASH_MODE="default"
BB_DOTFILE_BASH_USER_FILE=""
BB_DOTFILE_TMUX_MODE="default"
BB_DOTFILE_TMUX_USER_FILE=""
BB_DOTFILE_GDB_MODE="default"
BB_DOTFILE_GDB_USER_FILE=""
BB_DOTFILE_PROFILE_MODE="default"
BB_DOTFILE_PROFILE_USER_FILE=""
BB_GDBSERVER_PROVIDER="auto"
BB_GDBSERVER_USER_PATH=""
BB_DOOM_USER_PATH=""
BB_DOOM_WAD_PATH=""
BB_RECOVERY_BINARY_NAME="busierbox_recovery"
BB_USER_OVERLAY_ENABLE="no"
BB_USER_OVERLAY_ROOT="./overlay"
BB_USER_OVERLAY_ALLOW_OVERRIDE="no"

if [ -f "$CFG_FILE" ]; then
    . "./$CFG_FILE"
fi

BB_RUNTIME_MODE="${BB_RUNTIME_MODE:-extract}"
BB_RUNTIME_ROOT="${BB_RUNTIME_ROOT:-./.busierbox}"
BB_RUNTIME_ALLOW_FALLBACK_ROOT="${BB_RUNTIME_ALLOW_FALLBACK_ROOT:-no}"
BB_RUNTIME_FALLBACK_ROOT="${BB_RUNTIME_FALLBACK_ROOT:-/tmp/.busierbox}"
BB_RUNTIME_ALLOW_EXTERNAL_WRITES="${BB_RUNTIME_ALLOW_EXTERNAL_WRITES:-no}"
BB_ZERO_ARG_MODE="${BB_ZERO_ARG_MODE:-${BB_FULL_ZERO_ARG_MODE:-help}}"
case "$BB_ZERO_ARG_MODE" in
    menu|doctor) BB_ZERO_ARG_MODE=help ;;
esac
BB_ZERO_ARG_LOG_MODE="${BB_ZERO_ARG_LOG_MODE:-quiet}"
BB_ZERO_ARG_CUSTOM_COMMAND="${BB_ZERO_ARG_CUSTOM_COMMAND:-}"
BB_TRAILER_OVERRIDES_ENABLE="${BB_TRAILER_OVERRIDES_ENABLE:-yes}"
BB_TRAILER_OVERRIDE_CATEGORIES="${BB_TRAILER_OVERRIDE_CATEGORIES:-runtime operator launch retry}"
BB_TRAILER_OBFUSCATION="${BB_TRAILER_OBFUSCATION:-none}"
BB_TRAILER_XOR_KEY="${BB_TRAILER_XOR_KEY:-}"
BB_RSHELL_TRANSPORT="${BB_RSHELL_TRANSPORT:-${BB_RSHELL_MODE:-ssh}}"
# Normalise old transport names
case "$BB_RSHELL_TRANSPORT" in
    builtin-tls) BB_RSHELL_TRANSPORT=builtin; BB_RSHELL_ENCRYPTION="${BB_RSHELL_ENCRYPTION:-tls}" ;;
    socat-tls)   BB_RSHELL_TRANSPORT=socat;   BB_RSHELL_ENCRYPTION="${BB_RSHELL_ENCRYPTION:-tls}" ;;
esac
BB_RSHELL_ENCRYPTION="${BB_RSHELL_ENCRYPTION:-tls}"
BB_RSHELL_ALLOW_PLAINTEXT="${BB_RSHELL_ALLOW_PLAINTEXT:-no}"
BB_RSHELL_MODE="$BB_RSHELL_TRANSPORT"
BB_RSHELL_AUTHKEYS_MODE="${BB_RSHELL_AUTHKEYS_MODE:-disabled}"
BB_RSHELL_RUN_MODE="${BB_RSHELL_RUN_MODE:-auto}"
BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING="${BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING:-no}"
BB_RSHELL_SOCAT_PORT="${BB_RSHELL_SOCAT_PORT:-22203}"
BB_RSHELL_SHELL_PROVIDER="${BB_RSHELL_SHELL_PROVIDER:-auto}"
BB_RSHELL_CUSTOM_SHELL="${BB_RSHELL_CUSTOM_SHELL:-}"
BB_RSHELL_RETRY_COUNT="${BB_RSHELL_RETRY_COUNT:-1}"
BB_RSHELL_RETRY_INTERVAL_SEC="${BB_RSHELL_RETRY_INTERVAL_SEC:-5}"
BB_RSHELL_RETRY_JITTER_PCT="${BB_RSHELL_RETRY_JITTER_PCT:-20}"
BB_RSHELL_RETRY_BACKOFF="${BB_RSHELL_RETRY_BACKOFF:-none}"
BB_RSHELL_RETRY_MAX_INTERVAL_SEC="${BB_RSHELL_RETRY_MAX_INTERVAL_SEC:-300}"
# BB_BUILTIN_TLS_ENABLE is derived from transport — not user-configurable
[ "$BB_RSHELL_TRANSPORT" = builtin ] && BB_BUILTIN_TLS_ENABLE=yes || BB_BUILTIN_TLS_ENABLE=no
BB_AUTORUN_GUARD_ENABLE="${BB_AUTORUN_GUARD_ENABLE:-yes}"
# Migrate old /tmp guard path to runtime-root-derived path
if [ "${BB_AUTORUN_GUARD_PATH:-/tmp/busierbox-autorun}" = "/tmp/busierbox-autorun" ]; then
    BB_AUTORUN_GUARD_PATH="${BB_RUNTIME_ROOT}/run"
fi
BB_AUTORUN_GUARD_PATH="${BB_AUTORUN_GUARD_PATH:-${BB_RUNTIME_ROOT}/run}"
BB_AUTORUN_REENTRY_ACTION="${BB_AUTORUN_REENTRY_ACTION:-status}"
BB_AUTORUN_STALE_LOCK_POLICY="${BB_AUTORUN_STALE_LOCK_POLICY:-recover}"
BB_OPERATOR_SERVER_HOST="${BB_OPERATOR_SERVER_HOST:-}"
BB_OPERATOR_SERVER_USER="${BB_OPERATOR_SERVER_USER:-${USER:-operator}}"
BB_OPERATOR_SERVER_SSH_PORT="${BB_OPERATOR_SERVER_SSH_PORT:-22202}"
BB_OPERATOR_REMOTE_FORWARD_PORT="${BB_OPERATOR_REMOTE_FORWARD_PORT:-2200}"
BB_OPERATOR_TARGET_DROPBEAR_PORT="${BB_OPERATOR_TARGET_DROPBEAR_PORT:-2222}"
BB_OPERATOR_TARGET_BIND_HOST="${BB_OPERATOR_TARGET_BIND_HOST:-127.0.0.1}"
BB_OPERATOR_DBCLIENT_IDENTITY_FILE="${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}"
BB_OPERATOR_AUTHORIZED_KEY_FILE="${BB_OPERATOR_AUTHORIZED_KEY_FILE:-}"
BB_OPERATOR_KNOWN_HOSTS_POLICY="${BB_OPERATOR_KNOWN_HOSTS_POLICY:-off}"
BB_OPERATOR_FILE_SERVICE_ENABLE="${BB_OPERATOR_FILE_SERVICE_ENABLE:-no}"
BB_OPERATOR_FILE_SERVICE_PORT="${BB_OPERATOR_FILE_SERVICE_PORT:-22204}"
BB_OPERATOR_FILE_SERVICE_TLS="${BB_OPERATOR_FILE_SERVICE_TLS:-yes}"
BB_SERVER_CONFIG_PATH="${BB_SERVER_CONFIG_PATH:-local/server-config.json}"
BB_TARGETS="${BB_TARGETS:-${BB_TARGET_PRESET:-native}}"
[ "$BB_TARGETS" = "native" ] && [ "${BB_TARGET_PRESET:-native}" != "native" ] && BB_TARGETS="$BB_TARGET_PRESET"
BB_DOTFILES_ENABLE="${BB_DOTFILES_ENABLE:-yes}"
BB_DOTFILE_ZSH_MODE="${BB_DOTFILE_ZSH_MODE:-default}"
BB_DOTFILE_ZSH_USER_FILE="${BB_DOTFILE_ZSH_USER_FILE:-}"
BB_DOTFILE_BASH_MODE="${BB_DOTFILE_BASH_MODE:-default}"
BB_DOTFILE_BASH_USER_FILE="${BB_DOTFILE_BASH_USER_FILE:-}"
BB_DOTFILE_TMUX_MODE="${BB_DOTFILE_TMUX_MODE:-default}"
BB_DOTFILE_TMUX_USER_FILE="${BB_DOTFILE_TMUX_USER_FILE:-}"
BB_DOTFILE_GDB_MODE="${BB_DOTFILE_GDB_MODE:-default}"
BB_DOTFILE_GDB_USER_FILE="${BB_DOTFILE_GDB_USER_FILE:-}"
BB_DOTFILE_PROFILE_MODE="${BB_DOTFILE_PROFILE_MODE:-default}"
BB_DOTFILE_PROFILE_USER_FILE="${BB_DOTFILE_PROFILE_USER_FILE:-}"
BB_PAYLOAD_PRESET="${BB_PAYLOAD_PRESET:-default}"

temp_out=$(mktemp)
temp_cfg=$(mktemp)
temp_resolved=$(mktemp)
trap 'rm -f "$temp_out" "$temp_cfg" "$temp_resolved"' EXIT HUP INT TERM

has_item() {
    list="$1"
    item="$2"
    for x in $list; do
        [ "$x" = "$item" ] && return 0
    done
    return 1
}

onoff() {
    if [ "$1" = yes ]; then printf on; else printf off; fi
}

is_int_value() {
    case "$1" in
        ""|-) return 1 ;;
        -*) _n=${1#-} ;;
        *) _n=$1 ;;
    esac
    case "$_n" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_uint_value() {
    case "$1" in
        ""|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

payload_preset_vars() {
    cat <<'EOF'
BB_RUNTIME_MODE
BB_RUNTIME_ROOT
BB_RUNTIME_ALLOW_FALLBACK_ROOT
BB_RUNTIME_ALLOW_EXTERNAL_WRITES
BB_BUILD_INTERNAL_CORE
BB_ZERO_ARG_MODE
BB_ZERO_ARG_LOG_MODE
BB_ZERO_ARG_CUSTOM_COMMAND
BB_TRAILER_OVERRIDES_ENABLE
BB_TRAILER_OVERRIDE_CATEGORIES
BB_TRAILER_OBFUSCATION
BB_TRAILER_XOR_KEY
BB_RSHELL_TRANSPORT
BB_RSHELL_ENCRYPTION
BB_RSHELL_ALLOW_PLAINTEXT
BB_RSHELL_AUTHKEYS_MODE
BB_RSHELL_RUN_MODE
BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING
BB_RSHELL_SOCAT_PORT
BB_RSHELL_SHELL_PROVIDER
BB_RSHELL_CUSTOM_SHELL
BB_RSHELL_RETRY_COUNT
BB_RSHELL_RETRY_INTERVAL_SEC
BB_RSHELL_RETRY_JITTER_PCT
BB_RSHELL_RETRY_BACKOFF
BB_RSHELL_RETRY_MAX_INTERVAL_SEC
BB_AUTORUN_GUARD_ENABLE
BB_BUSYBOX_GROUPS
BB_HEAVY_TOOLS
BB_DOTFILES_ENABLE
BB_DOTFILE_ZSH_MODE
BB_DOTFILE_ZSH_USER_FILE
BB_DOTFILE_BASH_MODE
BB_DOTFILE_BASH_USER_FILE
BB_DOTFILE_TMUX_MODE
BB_DOTFILE_TMUX_USER_FILE
BB_DOTFILE_GDB_MODE
BB_DOTFILE_GDB_USER_FILE
BB_DOTFILE_PROFILE_MODE
BB_DOTFILE_PROFILE_USER_FILE
BB_USER_OVERLAY_ENABLE
BB_USER_OVERLAY_ROOT
BB_USER_OVERLAY_ALLOW_OVERRIDE
BB_DROPBEAR_SERVER_MODE
BB_DROPBEAR_BIND_HOST
BB_DROPBEAR_LISTEN_PORT
BB_DROPBEAR_AUTHORIZED_KEYS_FILE
BB_DROPBEAR_KEYTYPES
BB_DROPBEAR_NO_PASSWORD_AUTH
BB_DROPBEAR_NO_ROOT_PASSWORD
BB_DROPBEAR_PREGENERATE_HOSTKEY
BB_GDBSERVER_PROVIDER
BB_GDBSERVER_USER_PATH
BB_DOOM_USER_PATH
BB_DOOM_WAD_PATH
BB_RECOVERY_BINARY_NAME
EOF
}

shell_assign_value() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\$/\\$/g; s/`/\\`/g'
}

payload_preset_valid_name() {
    case "$1" in
        ""|*/*|*..*|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

payload_preset_path() {
    _name=$1
    payload_preset_valid_name "$_name" || return 1
    if [ -f "local/presets/payload/$_name.conf" ]; then
        printf '%s\n' "local/presets/payload/$_name.conf"
    elif [ -f "presets/payload/$_name.conf" ]; then
        printf '%s\n' "presets/payload/$_name.conf"
    else
        return 1
    fi
}

payload_preset_meta_path() {
    _name=$1
    payload_preset_valid_name "$_name" || return 1
    if [ -f "local/presets/payload/$_name.meta.json" ]; then
        printf '%s\n' "local/presets/payload/$_name.meta.json"
    elif [ -f "presets/payload/$_name.meta.json" ]; then
        printf '%s\n' "presets/payload/$_name.meta.json"
    else
        return 1
    fi
}

payload_preset_description() {
    _name=$1
    _meta=$(payload_preset_meta_path "$_name" 2>/dev/null || true)
    if [ -n "$_meta" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$_meta" <<'PY' 2>/dev/null && return 0
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    data = json.load(fh)

desc = data.get("menu_label") or data.get("description") or "payload preset"
risk = data.get("risk_level")
size = data.get("size_hint")
parts = [desc]
if risk:
    parts.append(f"risk={risk}")
if size:
    parts.append(f"size={size}")
print("; ".join(parts))
PY
    fi
    printf '%s\n' "payload preset"
}

load_payload_preset() {
    _name=$1
    _path=$(payload_preset_path "$_name") || return 1
    . "./$_path"
}

normalize_payload_config() {
    BB_RUNTIME_MODE="${BB_RUNTIME_MODE:-extract}"
    BB_RUNTIME_ROOT="${BB_RUNTIME_ROOT:-./.busierbox}"
    BB_RUNTIME_ALLOW_FALLBACK_ROOT="${BB_RUNTIME_ALLOW_FALLBACK_ROOT:-no}"
    BB_RUNTIME_ALLOW_EXTERNAL_WRITES="${BB_RUNTIME_ALLOW_EXTERNAL_WRITES:-no}"
    BB_ZERO_ARG_MODE="${BB_ZERO_ARG_MODE:-help}"
    BB_ZERO_ARG_LOG_MODE="${BB_ZERO_ARG_LOG_MODE:-quiet}"
    BB_TRAILER_OVERRIDES_ENABLE="${BB_TRAILER_OVERRIDES_ENABLE:-yes}"
    BB_TRAILER_OVERRIDE_CATEGORIES="${BB_TRAILER_OVERRIDE_CATEGORIES:-runtime operator launch retry}"
    BB_TRAILER_OBFUSCATION="${BB_TRAILER_OBFUSCATION:-none}"
    BB_TRAILER_XOR_KEY="${BB_TRAILER_XOR_KEY:-}"
    BB_RSHELL_TRANSPORT="${BB_RSHELL_TRANSPORT:-none}"
    BB_RSHELL_ENCRYPTION="${BB_RSHELL_ENCRYPTION:-tls}"
    BB_RSHELL_ALLOW_PLAINTEXT="${BB_RSHELL_ALLOW_PLAINTEXT:-no}"
    BB_RSHELL_RUN_MODE="${BB_RSHELL_RUN_MODE:-auto}"
    BB_RSHELL_MODE="$BB_RSHELL_TRANSPORT"
    [ "$BB_RSHELL_TRANSPORT" = builtin ] && BB_BUILTIN_TLS_ENABLE=yes || BB_BUILTIN_TLS_ENABLE=no
    BB_AUTORUN_GUARD_PATH="${BB_AUTORUN_GUARD_PATH:-${BB_RUNTIME_ROOT}/run}"
    if [ "$BB_RUNTIME_MODE" = core-only ]; then
        BB_HEAVY_TOOLS=""
        BB_DOTFILES_ENABLE=no
        BB_USER_OVERLAY_ENABLE=no
    fi
}

apply_payload_preset() {
    _name=$1
    if ! load_payload_preset "$_name"; then
        dialog --title "Payload preset" --msgbox "Unknown payload preset: $_name" 8 60
        return 1
    fi
    BB_PAYLOAD_PRESET="$_name"
    normalize_payload_config
    return 0
}

current_payload_config_snapshot() {
    payload_preset_vars | while IFS= read -r _var; do
        eval "_val=\${$_var:-}"
        printf '%s\t%s\n' "$_var" "$_val"
    done
}

payload_preset_snapshot() {
    _name=$1
    (
        load_payload_preset "$_name" || exit 1
        normalize_payload_config
        current_payload_config_snapshot
    )
}

payload_preset_is_dirty() {
    _name=${1:-}
    [ -n "$_name" ] || return 1
    payload_preset_path "$_name" >/dev/null 2>&1 || return 1
    current_payload_config_snapshot >"$temp_cfg"
    payload_preset_snapshot "$_name" >"$temp_resolved" || return 1
    ! diff -u "$temp_resolved" "$temp_cfg" >/dev/null 2>&1
}

save_payload_preset() {
    _name=$1
    payload_preset_valid_name "$_name" || return 1
    mkdir -p local/presets/payload
    _out="local/presets/payload/$_name.conf"
    {
        printf '# BusierBox user payload preset: %s\n' "$_name"
        payload_preset_vars | while IFS= read -r _var; do
            eval "_val=\${$_var:-}"
            printf '%s="%s"\n' "$_var" "$(shell_assign_value "$_val")"
        done
    } >"$_out"
    BB_PAYLOAD_PRESET="$_name"
    printf '%s\n' "$_out"
}

payload_preset_label() {
    _label=${BB_PAYLOAD_PRESET:-default}
    if payload_preset_is_dirty "$_label"; then
        printf '%s*' "$_label"
    else
        printf '%s' "$_label"
    fi
}

write_current_config() {
    out=$1
    cat >"$out" <<EOF
# BusierBox build configuration
# Generated by: make menuconfig
# Edit manually or regenerate with: make menuconfig

# Active target tuple. Presets populate these fields; the tuple is the source of truth.
BB_TARGET_PRESET="$BB_TARGET_PRESET"
BB_TARGET_NAME="$BB_TARGET_NAME"
BB_TARGET_ARCH="$BB_TARGET_ARCH"
BB_TARGET_ENDIAN="$BB_TARGET_ENDIAN"
BB_TARGET_CPU="$BB_TARGET_CPU"
BB_TARGET_ABI="$BB_TARGET_ABI"
BB_TARGET_LIBC="$BB_TARGET_LIBC"
BB_KERNEL_FLOOR="$BB_KERNEL_FLOOR"
BB_STATIC_POLICY="$BB_STATIC_POLICY"
BB_PAYLOAD_TIER="$BB_PAYLOAD_TIER"
BB_TARGET_QEMU_USER="$BB_TARGET_QEMU_USER"

# Target presets to build when running normal make package without TARGET=.
BB_TARGETS="$BB_TARGETS"

BB_PAYLOAD_FORMAT="$BB_PAYLOAD_FORMAT"
BB_PAYLOAD_VERSION="$BB_PAYLOAD_VERSION"
BB_PAYLOAD_PRESET="$BB_PAYLOAD_PRESET"
BB_RUNTIME_MODE="$BB_RUNTIME_MODE"
BB_RUNTIME_ROOT="$BB_RUNTIME_ROOT"
BB_RUNTIME_ALLOW_FALLBACK_ROOT="$BB_RUNTIME_ALLOW_FALLBACK_ROOT"
BB_RUNTIME_FALLBACK_ROOT="$BB_RUNTIME_FALLBACK_ROOT"
BB_RUNTIME_ALLOW_EXTERNAL_WRITES="$BB_RUNTIME_ALLOW_EXTERNAL_WRITES"
BB_BUILD_INTERNAL_CORE="$BB_BUILD_INTERNAL_CORE"
BB_ZERO_ARG_MODE="$BB_ZERO_ARG_MODE"
BB_ZERO_ARG_LOG_MODE="$BB_ZERO_ARG_LOG_MODE"
BB_ZERO_ARG_CUSTOM_COMMAND="$BB_ZERO_ARG_CUSTOM_COMMAND"
BB_TRAILER_OVERRIDES_ENABLE="$BB_TRAILER_OVERRIDES_ENABLE"
BB_TRAILER_OVERRIDE_CATEGORIES="$BB_TRAILER_OVERRIDE_CATEGORIES"
BB_TRAILER_OBFUSCATION="$BB_TRAILER_OBFUSCATION"
BB_TRAILER_XOR_KEY="$BB_TRAILER_XOR_KEY"
BB_RSHELL_TRANSPORT="$BB_RSHELL_TRANSPORT"
BB_RSHELL_ENCRYPTION="$BB_RSHELL_ENCRYPTION"
BB_RSHELL_ALLOW_PLAINTEXT="$BB_RSHELL_ALLOW_PLAINTEXT"
BB_RSHELL_AUTHKEYS_MODE="$BB_RSHELL_AUTHKEYS_MODE"
BB_RSHELL_RUN_MODE="$BB_RSHELL_RUN_MODE"
BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING="$BB_RSHELL_GENERATE_HOSTKEY_IF_MISSING"
BB_RSHELL_SOCAT_PORT="$BB_RSHELL_SOCAT_PORT"
BB_RSHELL_SHELL_PROVIDER="$BB_RSHELL_SHELL_PROVIDER"
BB_RSHELL_CUSTOM_SHELL="$BB_RSHELL_CUSTOM_SHELL"
BB_RSHELL_RETRY_COUNT="$BB_RSHELL_RETRY_COUNT"
BB_RSHELL_RETRY_INTERVAL_SEC="$BB_RSHELL_RETRY_INTERVAL_SEC"
BB_RSHELL_RETRY_JITTER_PCT="$BB_RSHELL_RETRY_JITTER_PCT"
BB_RSHELL_RETRY_BACKOFF="$BB_RSHELL_RETRY_BACKOFF"
BB_RSHELL_RETRY_MAX_INTERVAL_SEC="$BB_RSHELL_RETRY_MAX_INTERVAL_SEC"
BB_BUILTIN_TLS_ENABLE="$([ "$BB_RSHELL_TRANSPORT" = builtin ] && printf yes || printf no)"
BB_AUTORUN_GUARD_ENABLE="$BB_AUTORUN_GUARD_ENABLE"
BB_AUTORUN_GUARD_PATH="$BB_AUTORUN_GUARD_PATH"
BB_AUTORUN_REENTRY_ACTION="$BB_AUTORUN_REENTRY_ACTION"
BB_AUTORUN_STALE_LOCK_POLICY="$BB_AUTORUN_STALE_LOCK_POLICY"
BB_OPERATOR_SERVER_HOST="$BB_OPERATOR_SERVER_HOST"
BB_OPERATOR_SERVER_USER="$BB_OPERATOR_SERVER_USER"
BB_OPERATOR_SERVER_SSH_PORT="$BB_OPERATOR_SERVER_SSH_PORT"
BB_OPERATOR_REMOTE_FORWARD_PORT="$BB_OPERATOR_REMOTE_FORWARD_PORT"
BB_OPERATOR_TARGET_DROPBEAR_PORT="$BB_OPERATOR_TARGET_DROPBEAR_PORT"
BB_OPERATOR_TARGET_BIND_HOST="$BB_OPERATOR_TARGET_BIND_HOST"
BB_OPERATOR_DBCLIENT_IDENTITY_FILE="$BB_OPERATOR_DBCLIENT_IDENTITY_FILE"
BB_OPERATOR_AUTHORIZED_KEY_FILE="$BB_OPERATOR_AUTHORIZED_KEY_FILE"
BB_OPERATOR_KNOWN_HOSTS_POLICY="$BB_OPERATOR_KNOWN_HOSTS_POLICY"
BB_OPERATOR_FILE_SERVICE_ENABLE="$BB_OPERATOR_FILE_SERVICE_ENABLE"
BB_OPERATOR_FILE_SERVICE_PORT="$BB_OPERATOR_FILE_SERVICE_PORT"
BB_OPERATOR_FILE_SERVICE_TLS="$BB_OPERATOR_FILE_SERVICE_TLS"
BB_SERVER_CONFIG_PATH="$BB_SERVER_CONFIG_PATH"
BB_BUSYBOX_GROUPS="$BB_BUSYBOX_GROUPS"
BB_HEAVY_TOOLS="$BB_HEAVY_TOOLS"
BB_DROPBEAR_SERVER_MODE="$BB_DROPBEAR_SERVER_MODE"
BB_DROPBEAR_BIND_HOST="$BB_DROPBEAR_BIND_HOST"
BB_DROPBEAR_LISTEN_PORT="$BB_DROPBEAR_LISTEN_PORT"
BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$BB_DROPBEAR_AUTHORIZED_KEYS_FILE"
BB_DROPBEAR_KEYTYPES="$BB_DROPBEAR_KEYTYPES"
BB_DROPBEAR_NO_PASSWORD_AUTH="$BB_DROPBEAR_NO_PASSWORD_AUTH"
BB_DROPBEAR_NO_ROOT_PASSWORD="$BB_DROPBEAR_NO_ROOT_PASSWORD"
BB_DROPBEAR_PREGENERATE_HOSTKEY="$BB_DROPBEAR_PREGENERATE_HOSTKEY"
BB_BUSYBOX_APPLETS="$BB_BUSYBOX_APPLETS"
BB_BUSYBOX_APPLET_OVERRIDES="$BB_BUSYBOX_APPLET_OVERRIDES"
BB_DOTFILES_ENABLE="$BB_DOTFILES_ENABLE"
BB_DOTFILE_ZSH_MODE="$BB_DOTFILE_ZSH_MODE"
BB_DOTFILE_ZSH_USER_FILE="$BB_DOTFILE_ZSH_USER_FILE"
BB_DOTFILE_BASH_MODE="$BB_DOTFILE_BASH_MODE"
BB_DOTFILE_BASH_USER_FILE="$BB_DOTFILE_BASH_USER_FILE"
BB_DOTFILE_TMUX_MODE="$BB_DOTFILE_TMUX_MODE"
BB_DOTFILE_TMUX_USER_FILE="$BB_DOTFILE_TMUX_USER_FILE"
BB_DOTFILE_GDB_MODE="$BB_DOTFILE_GDB_MODE"
BB_DOTFILE_GDB_USER_FILE="$BB_DOTFILE_GDB_USER_FILE"
BB_DOTFILE_PROFILE_MODE="$BB_DOTFILE_PROFILE_MODE"
BB_DOTFILE_PROFILE_USER_FILE="$BB_DOTFILE_PROFILE_USER_FILE"
BB_GDBSERVER_PROVIDER="$BB_GDBSERVER_PROVIDER"
BB_GDBSERVER_USER_PATH="$BB_GDBSERVER_USER_PATH"
BB_DOOM_USER_PATH="$BB_DOOM_USER_PATH"
BB_DOOM_WAD_PATH="$BB_DOOM_WAD_PATH"
BB_RECOVERY_BINARY_NAME="$BB_RECOVERY_BINARY_NAME"
BB_USER_OVERLAY_ENABLE="$BB_USER_OVERLAY_ENABLE"
BB_USER_OVERLAY_ROOT="$BB_USER_OVERLAY_ROOT"
BB_USER_OVERLAY_ALLOW_OVERRIDE="$BB_USER_OVERLAY_ALLOW_OVERRIDE"
EOF
}

target_summary_text() {
    write_current_config "$temp_cfg"
    BUSIERBOX_CONFIG="$temp_cfg" scripts/resolve-target --config >"$temp_resolved" 2>"$temp_out" || {
        printf '%s\n' "Unable to resolve target:"
        cat "$temp_out"
        return 0
    }
    cat "$temp_resolved"
}

default_pubkey() {
    for _k in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub" "$HOME/.ssh/id_ecdsa.pub"; do
        [ -f "$_k" ] && { printf '%s\n' "$_k"; return 0; }
    done
    return 1
}

generate_dbclient_identity() {
    _dir="${1:-local/operator-session}"
    _path="$_dir/id_dbclient"
    mkdir -p "$_dir"
    if [ -e "$_path" ]; then
        dialog --title "dbclient identity exists" --yesno "$_path already exists.\n\nOverwrite it?" 9 60 || return 0
        rm -f "$_path" "$_path.pub"
    fi
    if command -v dropbearkey >/dev/null 2>&1; then
        dropbearkey -t rsa -f "$_path" >/dev/null 2>&1 || {
            dialog --title "Key generation failed" --msgbox "dropbearkey failed to generate $_path." 8 68
            return 0
        }
        dropbearkey -y -f "$_path" 2>/dev/null | awk '/^ssh-/ { print; exit }' >"$_path.pub" || true
    elif command -v ssh-keygen >/dev/null 2>&1; then
        ssh-keygen -q -m PEM -t rsa -b 2048 -N "" -C "busierbox-dbclient" -f "$_path" || {
            dialog --title "Key generation failed" --msgbox "ssh-keygen failed to generate $_path." 8 68
            return 0
        }
    else
        dialog --title "No key generator" --msgbox "Install dropbearkey or ssh-keygen, or enter an existing dbclient identity path manually." 8 78
        return 0
    fi
    chmod 600 "$_path" 2>/dev/null || true
    BB_OPERATOR_DBCLIENT_IDENTITY_FILE="$_path"
    dialog --title "Generated dbclient identity" \
        --msgbox "Generated target -> operator identity:\n\n  $_path\n\nAdd $_path.pub to the operator workstation user's authorized_keys for dbclient authentication." \
        12 78
}

generate_operator_keypair() {
    _dir="${1:-local/operator-session}"
    _path="$_dir/operator_ed25519"
    mkdir -p "$_dir"
    if [ -e "$_path" ]; then
        dialog --title "Operator key exists" --yesno "$_path already exists.\n\nOverwrite it?" 9 60 || return 0
        rm -f "$_path" "$_path.pub"
    fi
    if ! command -v ssh-keygen >/dev/null 2>&1; then
        dialog --title "No ssh-keygen" --msgbox "ssh-keygen is required to generate an operator keypair." 8 68
        return 0
    fi
    ssh-keygen -q -t ed25519 -N "" -C "busierbox-operator" -f "$_path" || {
        dialog --title "Key generation failed" --msgbox "ssh-keygen failed to generate $_path." 8 68
        return 0
    }
    chmod 600 "$_path" 2>/dev/null || true
    BB_OPERATOR_AUTHORIZED_KEY_FILE="$_path.pub"
    BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$BB_OPERATOR_AUTHORIZED_KEY_FILE"
    dialog --title "Generated operator key" \
        --msgbox "Generated operator -> target keypair:\n\n  private: $_path\n  public:  $_path.pub\n\nThe public key will be staged as target authorized_keys." \
        12 78
}

ensure_operator_session_defaults() {
    mkdir -p local/operator-session
    [ -n "${BB_OPERATOR_SERVER_USER:-}" ] || BB_OPERATOR_SERVER_USER="${USER:-operator}"
    [ -n "${BB_OPERATOR_SERVER_SSH_PORT:-}" ] || BB_OPERATOR_SERVER_SSH_PORT="22202"
    [ -n "${BB_OPERATOR_REMOTE_FORWARD_PORT:-}" ] || BB_OPERATOR_REMOTE_FORWARD_PORT="2200"
    [ -n "${BB_OPERATOR_TARGET_DROPBEAR_PORT:-}" ] || BB_OPERATOR_TARGET_DROPBEAR_PORT="${BB_DROPBEAR_LISTEN_PORT:-2222}"
    [ -n "${BB_OPERATOR_TARGET_BIND_HOST:-}" ] || BB_OPERATOR_TARGET_BIND_HOST="${BB_DROPBEAR_BIND_HOST:-127.0.0.1}"
    [ "$BB_OPERATOR_TARGET_BIND_HOST" = "0.0.0.0" ] && BB_OPERATOR_TARGET_BIND_HOST="127.0.0.1"
    [ -n "${BB_OPERATOR_KNOWN_HOSTS_POLICY:-}" ] || BB_OPERATOR_KNOWN_HOSTS_POLICY="off"
    [ -n "${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-}" ] || BB_OPERATOR_DBCLIENT_IDENTITY_FILE="local/operator-session/id_dbclient"
    if [ ! -f "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" ]; then
        if command -v dropbearkey >/dev/null 2>&1; then
            dropbearkey -t rsa -f "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" >/dev/null 2>&1 || true
            dropbearkey -y -f "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" 2>/dev/null | awk '/^ssh-/ { print; exit }' >"$BB_OPERATOR_DBCLIENT_IDENTITY_FILE.pub" || true
        elif command -v ssh-keygen >/dev/null 2>&1; then
            ssh-keygen -q -m PEM -t rsa -b 2048 -N "" -C "busierbox-dbclient" -f "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" >/dev/null 2>&1 || true
        fi
        chmod 600 "$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" 2>/dev/null || true
    fi
    if [ -z "${BB_OPERATOR_AUTHORIZED_KEY_FILE:-}" ]; then
        if _pub=$(default_pubkey 2>/dev/null); then
            BB_OPERATOR_AUTHORIZED_KEY_FILE="$_pub"
        elif command -v ssh-keygen >/dev/null 2>&1; then
            _opkey="local/operator-session/operator_ed25519"
            [ -f "$_opkey" ] || ssh-keygen -q -t ed25519 -N "" -C "busierbox-operator" -f "$_opkey" >/dev/null 2>&1 || true
            [ -f "$_opkey.pub" ] && BB_OPERATOR_AUTHORIZED_KEY_FILE="$_opkey.pub"
        fi
    fi
    [ -n "${BB_OPERATOR_AUTHORIZED_KEY_FILE:-}" ] && BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$BB_OPERATOR_AUTHORIZED_KEY_FILE"
    # TLS cert/key for the shell server (builtin and socat+tls transports)
    _tls_cert="local/operator-session/shell-server.crt"
    _tls_key="local/operator-session/shell-server.key"
    if [ ! -f "$_tls_cert" ] || [ ! -f "$_tls_key" ]; then
        if command -v openssl >/dev/null 2>&1; then
            openssl req -x509 -newkey rsa:2048 \
                -keyout "$_tls_key" -out "$_tls_cert" \
                -days 3650 -nodes -subj /CN=busierbox \
                >"local/operator-session/openssl-generate.log" 2>&1 && \
                chmod 600 "$_tls_key" || true
        fi
    fi
}

choose_operator_public_key() {
    _default_pub=$(default_pubkey 2>/dev/null || true)
    while :; do
        dialog --title "Operator SSH public key" \
            --menu "This public key is staged into target authorized_keys for operator -> target login through the reverse tunnel." 15 82 5 \
            "1" "Use detected local key: ${_default_pub:-none found}" \
            "2" "Enter public key path manually" \
            "3" "Generate local/operator-session/operator_ed25519" \
            "4" "Clear configured public key" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1)
                if [ -n "$_default_pub" ]; then
                    BB_OPERATOR_AUTHORIZED_KEY_FILE="$_default_pub"
                    BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$BB_OPERATOR_AUTHORIZED_KEY_FILE"
                    return 0
                fi
                dialog --title "No local public key" --msgbox "No ~/.ssh/id_ed25519.pub, id_rsa.pub, or id_ecdsa.pub was found." 8 72
                ;;
            2)
                dialog --title "Public key path" --inputbox "Path to an operator public key (*.pub)." 9 78 "$BB_OPERATOR_AUTHORIZED_KEY_FILE" 2>"$temp_out" || true
                _v=$(cat "$temp_out")
                [ -n "$_v" ] && BB_OPERATOR_AUTHORIZED_KEY_FILE="$_v" && BB_DROPBEAR_AUTHORIZED_KEYS_FILE="$_v"
                return 0
                ;;
            3) generate_operator_keypair "local/operator-session"; return 0 ;;
            4) BB_OPERATOR_AUTHORIZED_KEY_FILE=""; return 0 ;;
            0) return 0 ;;
        esac
    done
}

write_server_config() {
    ensure_operator_session_defaults
    mkdir -p "$(dirname "$BB_SERVER_CONFIG_PATH")"
    SERVER_CONFIG_PATH="$BB_SERVER_CONFIG_PATH" \
    SERVER_TRANSPORT="$BB_RSHELL_TRANSPORT" \
    SERVER_ENCRYPTION="$BB_RSHELL_ENCRYPTION" \
    SERVER_LISTEN_HOST="0.0.0.0" \
    SERVER_OPERATOR_HOST="$BB_OPERATOR_SERVER_HOST" \
    SERVER_OPERATOR_USER="$BB_OPERATOR_SERVER_USER" \
    SERVER_OPERATOR_SSH_PORT="$BB_OPERATOR_SERVER_SSH_PORT" \
    SERVER_OPERATOR_FORWARD_PORT="$BB_OPERATOR_REMOTE_FORWARD_PORT" \
    SERVER_OPERATOR_TARGET_PORT="$BB_OPERATOR_TARGET_DROPBEAR_PORT" \
    SERVER_OPERATOR_TARGET_BIND="$BB_OPERATOR_TARGET_BIND_HOST" \
    SERVER_OPERATOR_IDENTITY="$BB_OPERATOR_DBCLIENT_IDENTITY_FILE" \
    SERVER_OPERATOR_AUTH_KEY="$BB_OPERATOR_AUTHORIZED_KEY_FILE" \
    SERVER_OPERATOR_KNOWN_HOSTS="$BB_OPERATOR_KNOWN_HOSTS_POLICY" \
    SERVER_FILE_SERVICE_ENABLE="$BB_OPERATOR_FILE_SERVICE_ENABLE" \
    SERVER_FILE_SERVICE_PORT="$BB_OPERATOR_FILE_SERVICE_PORT" \
    SERVER_FILE_SERVICE_TLS="$BB_OPERATOR_FILE_SERVICE_TLS" \
    SERVER_SHELL_PORT="$BB_RSHELL_SOCAT_PORT" \
    python3 - <<'PY'
import json
from pathlib import Path
import os

path = Path(os.environ["SERVER_CONFIG_PATH"])
transport = os.environ["SERVER_TRANSPORT"] or "ssh"
encryption = os.environ["SERVER_ENCRYPTION"] or "tls"
identity = os.environ["SERVER_OPERATOR_IDENTITY"] or "local/operator-session/id_dbclient"
data = {
    "transport": transport,
    "encryption": encryption,
    "listen_host": os.environ["SERVER_LISTEN_HOST"] or "0.0.0.0",
    "ssh_listen_port": int(os.environ["SERVER_OPERATOR_SSH_PORT"] or "22202"),
    "shell_listen_port": int(os.environ["SERVER_SHELL_PORT"] or "22203"),
    "forward_host": "127.0.0.1",
    "forward_port": int(os.environ["SERVER_OPERATOR_FORWARD_PORT"] or "2200"),
    "authorized_dbclient_pubkey": identity + ".pub",
    "operator_host_key": str(Path(identity).parent / "operator_ssh_host_key"),
    "tls_cert": "local/operator-session/shell-server.crt",
    "tls_key": "local/operator-session/shell-server.key",
    "tls_verify": "no",
    "session_root": "local/sessions",
    "operator_server_host": os.environ["SERVER_OPERATOR_HOST"],
    "operator_server_user": os.environ["SERVER_OPERATOR_USER"],
    "operator_target_dropbear_port": int(os.environ["SERVER_OPERATOR_TARGET_PORT"] or "2222"),
    "operator_target_bind_host": os.environ["SERVER_OPERATOR_TARGET_BIND"] or "127.0.0.1",
    "operator_dbclient_identity_file": identity,
    "operator_authorized_key_file": os.environ["SERVER_OPERATOR_AUTH_KEY"],
    "operator_known_hosts_policy": os.environ["SERVER_OPERATOR_KNOWN_HOSTS"] or "off",
    "file_service_enable": os.environ["SERVER_FILE_SERVICE_ENABLE"] or "no",
    "file_service_port": int(os.environ["SERVER_FILE_SERVICE_PORT"] or "22204"),
    "file_service_tls": os.environ["SERVER_FILE_SERVICE_TLS"] or "yes",
}
path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
try:
    path.chmod(0o600)
except OSError:
    pass
PY
}

clear_for_stdout() {
    clear 2>/dev/null || printf '\033c'
}

can_build_builtin_tls() {
    _cc=${CC:-cc}
    _cflags=${WOLFSSL_CFLAGS:-}
    _libs=${WOLFSSL_LIBS:-}
    if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists wolfssl 2>/dev/null; then
        _cflags="${_cflags:-$(pkg-config --cflags wolfssl 2>/dev/null || true)}"
        _libs="${_libs:-$(pkg-config --libs wolfssl 2>/dev/null || true)}"
    fi
    _libs="${_libs:--lwolfssl}"
    command -v "$_cc" >/dev/null 2>&1 || return 1
    _probe_dir=$(mktemp -d)
    printf '#include <wolfssl/ssl.h>\nint main(void){wolfSSL_Init();wolfSSL_Cleanup();return 0;}\n' >"$_probe_dir/probe.c"
    if "$_cc" $_cflags "$_probe_dir/probe.c" -o "$_probe_dir/probe" $_libs >/dev/null 2>&1; then
        rm -rf "$_probe_dir"
        return 0
    fi
    rm -rf "$_probe_dir"
    return 1
}

validate_config() {
    _errors=""
    _warnings=""

    if [ "$BB_RUNTIME_MODE" = "core-only" ]; then
        case "$BB_RSHELL_TRANSPORT" in
            ssh|socat)
                _errors="$_errors\n- core-only + transport=$BB_RSHELL_TRANSPORT: staged tools unavailable in core-only mode."
                ;;
        esac
        [ -z "${BB_HEAVY_TOOLS:-}" ] || _errors="$_errors\n- core-only runtime cannot stage heavy tools. Clear BB_HEAVY_TOOLS or change runtime mode."
        [ "$BB_DOTFILES_ENABLE" != yes ] || _errors="$_errors\n- core-only runtime cannot stage per-app dotfiles. Set BB_DOTFILES_ENABLE=no."
        [ "$BB_USER_OVERLAY_ENABLE" != yes ] || _errors="$_errors\n- core-only runtime cannot stage a user overlay. Set BB_USER_OVERLAY_ENABLE=no."
    fi

    if [ "$BB_ZERO_ARG_MODE" = rshell ] && [ "$BB_RSHELL_TRANSPORT" = none ]; then
        _errors="$_errors\n- zero-arg mode is 'rshell' but reverse shell is disabled (transport=none)."
    fi

    if [ "$BB_ZERO_ARG_MODE" = rshell ] && [ "$BB_RSHELL_TRANSPORT" != none ] && [ -z "${BB_OPERATOR_SERVER_HOST:-}" ]; then
        _errors="$_errors\n- zero-arg rshell mode requires operator host/IP to be set."
    fi

    if [ "$BB_RSHELL_TRANSPORT" = builtin ] && [ "$BB_RSHELL_ENCRYPTION" = none ]; then
        _errors="$_errors\n- builtin plaintext is not implemented. Use encryption=tls or a different transport."
    elif [ "$BB_RSHELL_ENCRYPTION" = none ]; then
        if [ "$BB_RSHELL_ALLOW_PLAINTEXT" != yes ]; then
            _errors="$_errors\n- encryption=none requires BB_RSHELL_ALLOW_PLAINTEXT=yes."
        elif [ "$BB_RSHELL_TRANSPORT" != none ]; then
            _warnings="$_warnings\n- encryption=none is insecure and intended only for explicit debug use."
        fi
    fi

    if [ "$BB_RSHELL_TRANSPORT" = ssh ] && [ "$BB_RUNTIME_MODE" != core-only ]; then
        if ! has_item "$BB_HEAVY_TOOLS" dropbear; then
            _errors="$_errors\n- transport=ssh but dropbear is not in heavy tools."
        fi
    fi

    if [ "$BB_RSHELL_TRANSPORT" = socat ] && [ "$BB_RUNTIME_MODE" != core-only ]; then
        if ! has_item "$BB_HEAVY_TOOLS" socat; then
            _errors="$_errors\n- transport=socat but socat is not in heavy tools."
        fi
    fi

    if [ "$BB_ZERO_ARG_MODE" = custom ] && [ -z "${BB_ZERO_ARG_CUSTOM_COMMAND:-}" ]; then
        _errors="$_errors\n- zero-arg custom mode requires BB_ZERO_ARG_CUSTOM_COMMAND to be set."
    fi

    case "$BB_RSHELL_AUTHKEYS_MODE" in
        root-copy|root-merge)
            [ "$BB_RUNTIME_ALLOW_EXTERNAL_WRITES" = yes ] || _errors="$_errors\n- authkeys mode $BB_RSHELL_AUTHKEYS_MODE writes outside the runtime root. Set BB_RUNTIME_ALLOW_EXTERNAL_WRITES=yes or choose another authkeys mode."
            ;;
        disabled|payload-home) ;;
        *) _errors="$_errors\n- invalid rshell authkeys mode: $BB_RSHELL_AUTHKEYS_MODE." ;;
    esac

    case "$BB_RSHELL_RUN_MODE" in
        foreground|background|auto) ;;
        *) _errors="$_errors\n- invalid rshell run mode: $BB_RSHELL_RUN_MODE." ;;
    esac

    if [ "$BB_RSHELL_TRANSPORT" = builtin ] && [ "$BB_RSHELL_ENCRYPTION" = tls ] && ! can_build_builtin_tls; then
        _errors="$_errors\n- builtin+tls requires wolfSSL support to be buildable. Install wolfSSL development headers/libs or set WOLFSSL_CFLAGS/WOLFSSL_LIBS."
    fi

    case "$BB_RSHELL_SHELL_PROVIDER" in
        auto|target-sh) ;;
        payload-busybox-sh|payload-busybox-ash)
            [ "$BB_RUNTIME_MODE" != core-only ] || _errors="$_errors\n- shell provider $BB_RSHELL_SHELL_PROVIDER is invalid in core-only mode."
            ;;
        payload-zsh)
            [ "$BB_RUNTIME_MODE" != core-only ] || _errors="$_errors\n- shell provider payload-zsh is invalid in core-only mode."
            has_item "$BB_HEAVY_TOOLS" zsh || _errors="$_errors\n- shell provider payload-zsh requires zsh in heavy tools."
            ;;
        custom)
            [ -n "${BB_RSHELL_CUSTOM_SHELL:-}" ] || _errors="$_errors\n- shell provider custom requires BB_RSHELL_CUSTOM_SHELL to be set."
            ;;
        *) _errors="$_errors\n- invalid shell provider: $BB_RSHELL_SHELL_PROVIDER." ;;
    esac

    case "$BB_RSHELL_RETRY_BACKOFF" in
        none|linear|exponential) ;;
        *) _errors="$_errors\n- invalid rshell retry backoff: $BB_RSHELL_RETRY_BACKOFF." ;;
    esac
    is_int_value "$BB_RSHELL_RETRY_COUNT" || _errors="$_errors\n- BB_RSHELL_RETRY_COUNT must be an integer (-1 means retry indefinitely)."
    is_uint_value "$BB_RSHELL_RETRY_INTERVAL_SEC" || _errors="$_errors\n- BB_RSHELL_RETRY_INTERVAL_SEC must be a non-negative integer."
    is_uint_value "$BB_RSHELL_RETRY_JITTER_PCT" || _errors="$_errors\n- BB_RSHELL_RETRY_JITTER_PCT must be a non-negative integer."
    is_uint_value "$BB_RSHELL_RETRY_MAX_INTERVAL_SEC" || _errors="$_errors\n- BB_RSHELL_RETRY_MAX_INTERVAL_SEC must be a non-negative integer."

    if [ "$BB_ZERO_ARG_LOG_MODE" = none ] && [ "$BB_AUTORUN_GUARD_ENABLE" = yes ]; then
        _warnings="$_warnings\n- zero-arg log mode none suppresses output, but minimal autorun guard files may still be written."
    fi
    if [ "$BB_RUNTIME_MODE" = no-residue ]; then
        _warnings="$_warnings\n- no-residue cleanup is best-effort."
    fi

    if [ -n "$_errors" ]; then
        dialog --title "Invalid Configuration" \
            --msgbox "$(printf '%b' "Configuration cannot be saved until these errors are fixed:\n$_errors")" 22 90
        return 1
    fi

    if [ -n "$_warnings" ]; then
        dialog --title "Configuration Warnings" \
            --yesno "$(printf '%b' "Warnings:\n$_warnings\n\nSave anyway?")" 18 90 || return 1
    fi
    return 0
}

handle_dirty_payload_preset_on_save() {
    _preset=${BB_PAYLOAD_PRESET:-default}
    payload_preset_is_dirty "$_preset" || return 0

    dialog --title "Payload preset modified" \
        --menu "Current settings differ from payload preset: ${_preset}\n\nBuilt-in presets will not be modified.\nChoose what to do:" \
        17 82 4 \
        "1" "Save this config as-is" \
        "2" "Save these payload settings as a new user preset" \
        "3" "Discard edits and restore preset defaults" \
        "0" "Cancel" \
        2>"$temp_out" || return 1
    _choice=$(cat "$temp_out")
    case "$_choice" in
        1) return 0 ;;
        2)
            dialog --title "New payload preset name" \
                --inputbox "Use letters, numbers, dot, dash, or underscore.\n\nThis writes a new user preset under:\n  local/presets/payload/<name>.conf\n\nBuilt-in presets are not modified." \
                9 82 "${_preset}-custom" 2>"$temp_out" || return 1
            _name=$(cat "$temp_out" | tr -d '"')
            if ! payload_preset_valid_name "$_name"; then
                dialog --title "Invalid preset name" \
                    --msgbox "Invalid preset name: $_name\n\nUse only letters, numbers, dot, dash, or underscore." 9 72
                return 1
            fi
            _written=$(save_payload_preset "$_name") || {
                dialog --title "Save preset failed" --msgbox "Could not save payload preset: $_name" 8 64
                return 1
            }
            dialog --title "Payload preset saved" --msgbox "Saved current payload settings to:\n\n  $_written" 9 72
            return 0
            ;;
        3)
            apply_payload_preset "$_preset" || return 1
            dialog --title "Payload preset reapplied" \
                --msgbox "Discarded current payload edits and restored preset defaults from: $_preset\n\nReview the settings, then save again." 10 72
            return 1
            ;;
        0) return 1 ;;
    esac
    return 1
}

save_config() {
    handle_dirty_payload_preset_on_save || return 1
    validate_config || return 1
    write_current_config "$temp_cfg"
    compat_warnings=$(scripts/print-tool-compat "$temp_cfg" 2>/dev/null || true)
    case "$compat_warnings" in
        ""|"No heavy tools selected."|"No compatibility warnings for selected heavy tools.") ;;
        *)
        dialog --title "Payload compatibility warnings" --msgbox "$compat_warnings" 18 86
        ;;
    esac

    if [ -f "$CFG_FILE" ] && diff -u "$CFG_FILE" "$temp_cfg" >"$temp_out" 2>/dev/null; then
        dialog --title "BusierBox: No changes" --msgbox "Configuration matches current settings. Nothing to save." 8 55
        write_server_config
        clear_for_stdout
        printf '%s\n' "Configuration unchanged: $CFG_FILE."
        printf '%s\n' "Server defaults written to $BB_SERVER_CONFIG_PATH."
        return 0
    fi

    if [ -f "$CFG_FILE" ]; then
        dialog --title "BusierBox: Confirm Changes" --textbox "$temp_out" 20 80 || return 1
    else
        dialog --title "BusierBox: Save New Config" --yesno "Save configuration to $CFG_FILE?" 8 50 || return 1
    fi
    cp "$temp_cfg" "$CFG_FILE"
    write_server_config
    dialog --title "BusierBox: Success" --msgbox "Configuration written to $CFG_FILE." 8 55
    clear_for_stdout
    printf '%s\n' "Configuration written to $CFG_FILE."
    printf '%s\n' "Server defaults written to $BB_SERVER_CONFIG_PATH."
    print_operator_session_instructions
}

operator_session_enabled() {
    [ "${BB_ZERO_ARG_MODE:-help}" = rshell ] && return 0
    return 1
}

print_operator_session_instructions() {
    operator_session_enabled || return 0
    _op_host=${BB_OPERATOR_SERVER_HOST:-<operator_host>}
    _op_user=${BB_OPERATOR_SERVER_USER:-operator}
    _op_ssh_port=${BB_OPERATOR_SERVER_SSH_PORT:-22}
    _fwd_port=${BB_OPERATOR_REMOTE_FORWARD_PORT:-2200}
    _target_port=${BB_OPERATOR_TARGET_DROPBEAR_PORT:-2222}
    _target_bind=${BB_OPERATOR_TARGET_BIND_HOST:-127.0.0.1}
    cat <<EOF

BusierBox reverse shell catch instructions
------------------------------------------
This is the Dropbear/dbclient reverse SSH path used by zero-arg rshell mode and
explicit 'busierbox rshell'. scripts/busierbox-server can also listen for the
reverse SSH connection using the saved defaults.

# On operator workstation, ensure sshd is running and authorized_keys contains
# the public half of the target -> operator identity.
sudo systemctl status sshd 2>/dev/null || sudo systemctl status ssh

# Target dbclient will connect to:
ssh ${_op_user}@${_op_host} -p ${_op_ssh_port} \\
  -R 127.0.0.1:${_fwd_port}:${_target_bind}:${_target_port}

# Then connect from the operator workstation to the target Dropbear service:
ssh -p ${_fwd_port} root@127.0.0.1

# Or let BusierBox load the saved defaults and wait for the reverse tunnel:
scripts/busierbox-server --transport ssh --ssh-port ${_op_ssh_port}

Configured files:
  target -> operator identity: ${BB_OPERATOR_DBCLIENT_IDENTITY_FILE:-<not set>}
  operator -> target public key: ${BB_OPERATOR_AUTHORIZED_KEY_FILE:-<not set>}
  known-hosts policy: ${BB_OPERATOR_KNOWN_HOSTS_POLICY:-off}

EOF
}

apply_preset() {
    preset=$1
    eval "$(python3 - "$preset" <<'PY'
import json
import shlex
import sys

preset_name = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
for p in data.get("presets", []):
    if p.get("preset_name") == preset_name:
        def emit(k, v):
            print(f"{k}={shlex.quote(str(v) if v is not None else '')}")
        emit("BB_TARGET_PRESET", p.get("preset_name"))
        emit("BB_TARGET_NAME", p.get("target_name", ""))
        emit("BB_TARGET_ARCH", p.get("arch", ""))
        emit("BB_TARGET_ENDIAN", p.get("endian", "auto"))
        emit("BB_TARGET_CPU", p.get("cpu", "generic"))
        emit("BB_TARGET_ABI", p.get("abi", "default"))
        emit("BB_TARGET_LIBC", p.get("libc", ""))
        emit("BB_KERNEL_FLOOR", p.get("kernel_floor", ""))
        emit("BB_STATIC_POLICY", p.get("static_policy", "static-preferred"))
        emit("BB_PAYLOAD_TIER", p.get("payload_tier", "core"))
        emit("BB_TARGET_QEMU_USER", p.get("qemu_user", ""))
        raise SystemExit(0)
print(f"unknown preset {preset_name}", file=sys.stderr)
raise SystemExit(1)
PY
)"
}

show_page_help() {
    case "$1" in
        top)
            _title="Top-level menu"
            _text="This menu switches between target configuration, payload behavior, summary, and saving.\n\nTarget Configuration answers what target is being built. Payload Options answers what artifact and runtime behavior you want.\n\nSave Configuration writes the config and reverse-access server defaults."
            ;;
        target)
            _title="Target Configuration help"
            _text="Target presets populate the active architecture/libc/kernel tuple and optional multi-target build list.\n\nUse this for platform selection only. Payload presets are separate and do not change BB_TARGET_* fields.\n\nThe active tuple is the source of truth after a preset is applied."
            ;;
        payload)
            _title="Payload Options help"
            _text="Payload Options control runtime extraction behavior, launch behavior, BusyBox applets, heavy tools, dotfiles, overlays, and applet-specific settings.\n\nPayload presets are starting points. After applying one, edit any setting. An asterisk after the preset name means current payload settings differ from that preset."
            ;;
        payload-preset)
            _title="Payload Preset help"
            _text="Payload presets answer what kind of artifact/runtime behavior you want. They intentionally do not set target architecture/libc/kernel fields.\n\nBuilt-in presets live in presets/payload/. User presets are saved under local/presets/payload/.\n\n* means current payload settings differ from the selected preset. On save you can save config only, save the current payload settings as a new preset, reapply the original preset, or cancel."
            ;;
        runtime)
            _title="Runtime mode help"
            _text="extract: full-featured; writes under the runtime root, normally ./.busierbox.\n\ncore-only: no payload extraction; built-in applets only. Heavy tools, dotfiles, and user overlays are ignored/unavailable.\n\nno-residue: temporary runtime with best-effort cleanup. Payload tools may still have their own behavior.\n\nExternal writes are required only for choices such as root authorized_keys handling."
            ;;
        launch)
            _title="Launch behavior help"
            _text="Zero-arg behavior controls what the artifact does with no arguments: help, survey, configured reverse access, or a custom command.\n\nReverse access only runs when explicitly selected. The autorun guard prevents repeated zero-arg launches and writes status under the configured guard path."
            ;;
        artifact-overrides)
            _title="Artifact runtime overrides help"
            _text="Post-build runtime override trailers let selected runtime/operator settings be changed on an existing artifact with scripts/artifact-config, without rebuilding the payload or changing target tuple, compiled features, heavy tools, dotfiles, or overlay contents.\n\nXOR mode is only casual string hiding. It is not encryption and must not be used for private keys or credentials."
            ;;
        rshell)
            _title="Reverse access help"
            _text="builtin: BusierBox-native shell transport, TLS via wolfSSL.\n\nsocat: staged socat shell transport; TLS recommended.\n\nssh: Dropbear/dbclient reverse SSH. SSH-only fields are hidden unless transport=ssh.\n\nnone: no reverse shell.\n\nRun mode foreground keeps the transport in the current session. background is transport-specific; SSH already launches Dropbear/dbclient in the background. auto uses the transport default and does not imply persistent shell-session resume.\n\ncore-only supports builtin only because staged Dropbear/socat tools are unavailable."
            ;;
        busybox)
            _title="BusyBox applets help"
            _text="BusyBox applet groups select useful upstream BusyBox functionality. Group choices provide defaults; per-applet submenus store explicit overrides.\n\nBusierBox core should remain supervisor-only. Standard Unix utilities are provided by BusyBox or other payload tools."
            ;;
        heavy)
            _title="Heavy tools help"
            _text="Heavy tools are optional payload tools staged in addition to BusyBox. They require extract or no-residue runtime mode.\n\nTools marked with * require you to provide a target-compatible binary through a local drop-in, user path, or overlay; BusierBox will include them in the artifact when a matching binary is available.\n\nReverse SSH requires dropbear. socat transport requires socat. gdbserver availability depends on the configured provider and target compatibility."
            ;;
        dotfiles)
            _title="Dotfiles by app help"
            _text="Dotfiles stage app-specific config into payload HOME. Each app can use the BusierBox default, a user-supplied file, or no file.\n\nDotfiles are ignored in core-only mode because no payload HOME is extracted."
            ;;
        overlay)
            _title="User overlay help"
            _text="User overlays stage local files into the payload from bin/, lib/, share/, home/, and etc/ under the configured overlay root.\n\nUse overlays for personal binaries or config not fetched by BusierBox. Overlays are unavailable in core-only mode."
            ;;
        tool-compat)
            _title="Tool compatibility help"
            _text="Tool compatibility checks selected heavy tools against the active target tuple and provider map.\n\nWarnings explain when a selected tool may be unavailable, dynamically linked, or provider-specific before packaging."
            ;;
        dropbear)
            _title="Dropbear options help"
            _text="Dropbear options configure staged SSH client/server behavior when dropbear is selected in Heavy tools.\n\nServer mode listens on the target. Reverse SSH uses dbclient and local/operator-session defaults. Authorized key modes that write under /root require external writes to be explicitly allowed."
            ;;
        gdbserver)
            _title="gdbserver provider help"
            _text="gdbserver can be provided automatically, by Buildroot, by local drop-in, by user path, by overlay, or disabled.\n\nLocal drop-ins are searched under local/tools/<target>/bin, local/tools/<arch>-<libc>/bin, and local/tools/generic/<arch>/bin.\n\nProvider choices are ignored unless gdbserver is selected in Heavy tools. Some target/libc tuples cannot build gdbserver statically."
            ;;
        *) _title="Help"; _text="No help is available for this page." ;;
    esac
    dialog --title "$_title" --msgbox "$(printf '%b' "$_text")" 20 84
}

configure_artifact_runtime_overrides() {
    while :; do
        dialog --title "Artifact runtime overrides" \
            --menu "Post-build override trailers are edited with scripts/artifact-config after packaging." 21 86 7 \
            "1" "Enable post-build trailer workflow: $BB_TRAILER_OVERRIDES_ENABLE" \
            "2" "Allowed categories: $BB_TRAILER_OVERRIDE_CATEGORIES" \
            "3" "Obfuscation mode: $BB_TRAILER_OBFUSCATION" \
            "4" "XOR key: $([ -n "$BB_TRAILER_XOR_KEY" ] && printf set || printf random/manual at edit time)" \
            "5" "Command hints" \
            "H" "Help" \
            "0" "Back" \
            2>"$temp_out" || return 0
        _choice=$(cat "$temp_out")
        case "$_choice" in
            1) [ "$BB_TRAILER_OVERRIDES_ENABLE" = yes ] && BB_TRAILER_OVERRIDES_ENABLE=no || BB_TRAILER_OVERRIDES_ENABLE=yes ;;
            2)
                dialog --title "Allowed override categories" \
                    --inputbox "Informational category list for post-build runtime overrides. The runtime still enforces the built-in allowed key list." \
                    10 82 "$BB_TRAILER_OVERRIDE_CATEGORIES" 2>"$temp_out" || true
                BB_TRAILER_OVERRIDE_CATEGORIES=$(cat "$temp_out")
                ;;
            3)
                dialog --title "Override trailer obfuscation" \
                    --radiolist "XOR is not encryption; it only hides casual strings in the artifact." 13 76 2 \
                    "none" "Plain KEY=VALUE trailer payload" "$(mode_onoff "$BB_TRAILER_OBFUSCATION" none)" \
                    "xor" "XOR obfuscation, not secret protection" "$(mode_onoff "$BB_TRAILER_OBFUSCATION" xor)" \
                    2>"$temp_out" || true
                _v=$(cat "$temp_out" | tr -d '"')
                [ -n "$_v" ] && BB_TRAILER_OBFUSCATION="$_v"
                ;;
            4)
                dialog --title "XOR key" \
                    --inputbox "Optional hex XOR key for scripts/artifact-config --key. Leave blank to let artifact-config generate a random key. This is not encryption." \
                    10 84 "$BB_TRAILER_XOR_KEY" 2>"$temp_out" || true
                BB_TRAILER_XOR_KEY=$(cat "$temp_out")
                ;;
            5)
                dialog --title "Post-build command hints" \
                    --msgbox "Show overrides:\n  scripts/artifact-config show dist/busierbox-<target>-full\n\nSet values:\n  scripts/artifact-config set dist/busierbox-<target>-full BB_OPERATOR_SERVER_HOST=host BB_ZERO_ARG_MODE=rshell\n\nClear overrides:\n  scripts/artifact-config clear dist/busierbox-<target>-full\n\nXOR is not encryption and should not be used for credentials or private keys." \
                    18 86
                ;;
            H) show_page_help artifact-overrides ;;
            0) return 0 ;;
        esac
    done
}

configure_presets() {
    if ! command -v python3 >/dev/null 2>&1 || [ ! -f targets/presets.json ]; then
        dialog --title "Target Configuration / Presets" --msgbox "python3 and targets/presets.json are required to edit presets." 8 70
        return 0
    fi

    python3 - "$BB_TARGET_PRESET" >"$temp_cfg" <<'PY'
import json
import shlex
import sys

selected = sys.argv[1]
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
args = []
for p in data.get("presets", []):
    name = p.get("preset_name", "")
    display = p.get("display_path") or name
    desc = f"{p.get('support_status', '')}: {display} - {p.get('description', '')}"
    args.extend([name, desc, "on" if name == selected else "off"])
print(" ".join(shlex.quote(arg) for arg in args))
PY

    eval "dialog --title 'Target Configuration / Preset profiles' \
        --radiolist 'Select a preset to populate the active tuple. You can edit fields after applying it.' 22 92 12 \
        $(cat "$temp_cfg") \
        2>'$temp_out'" || return 0
    preset=$(cat "$temp_out" | tr -d '"')
    [ -n "$preset" ] || return 0
    apply_preset "$preset"
    BB_TARGETS="$preset"
}

configure_build_targets() {
    if ! command -v python3 >/dev/null 2>&1 || [ ! -f targets/presets.json ]; then
        dialog --title "Target Configuration / Build targets" --msgbox "python3 and targets/presets.json are required to edit build target selection." 8 76
        return 0
    fi
    python3 - "$BB_TARGETS" >"$temp_cfg" <<'PY'
import json
import shlex
import sys

selected = set(sys.argv[1].split())
with open("targets/presets.json", "r", encoding="utf-8") as fh:
    data = json.load(fh)
args = []
for p in data.get("presets", []):
    name = p.get("preset_name", "")
    status = p.get("support_status", "")
    if status == "blank":
        continue
    display = p.get("display_path") or name
    desc = p.get("description", "")
    args.extend([name, f"{status}: {display} - {desc}", "on" if name in selected else "off"])
if not args:
    args = ["native", "native host build", "on" if "native" in selected else "off"]
print(" ".join(shlex.quote(arg) for arg in args))
PY
    eval "dialog --title 'Target Configuration / Build targets' \
        --checklist 'Select one or more presets for make package when TARGET= is not supplied. The active tuple below is still used for editing and summaries.' 24 96 14 \
        $(cat "$temp_cfg") \
        2>'$temp_out'" || return 0
    _sel=$(cat "$temp_out" | tr -d '"')
    [ -n "$_sel" ] || _sel="$BB_TARGET_PRESET"
    BB_TARGETS="$_sel"
}

