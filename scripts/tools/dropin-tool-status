#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/tools/dropin-tool-status --tool TOOL [options]

Options:
  --target NAME
  --arch ARCH
  --libc LIBC
  --dest-root DIR      default: local/tools
  --json
EOF
}

tool=
target=
arch=
libc=
dest_root=local/tools
json=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tool) tool=$2; shift 2 ;;
        --tool=*) tool=${1#--tool=}; shift ;;
        --target) target=$2; shift 2 ;;
        --target=*) target=${1#--target=}; shift ;;
        --arch) arch=$2; shift 2 ;;
        --arch=*) arch=${1#--arch=}; shift ;;
        --libc) libc=$2; shift 2 ;;
        --libc=*) libc=${1#--libc=}; shift ;;
        --dest-root) dest_root=$2; shift 2 ;;
        --dest-root=*) dest_root=${1#--dest-root=}; shift ;;
        --json) json=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$tool" ] || { usage; exit 2; }

target=${target:-native}
arch=${arch:-native}
libc=${libc:-host}

if [ "$json" -eq 1 ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "dropin-tool-status: --json requires python3" >&2
        exit 1
    fi
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    python3 - "$script_dir/check-dropin-tool" "$tool" "$target" "$arch" "$libc" "$dest_root" <<'PY'
import json
import pathlib
import subprocess
import sys

check_tool, tool, target, arch, libc, dest_root = sys.argv[1:]

paths = [
    pathlib.Path(dest_root) / target / "bin" / tool,
    pathlib.Path(dest_root) / f"{arch}-{libc}" / "bin" / tool,
    pathlib.Path(dest_root) / "generic" / arch / "bin" / tool,
]

records = []
found = False
for path in paths:
    record = {
        "path": str(path),
        "exists": path.exists(),
        "executable": path.is_file() and path.stat().st_mode & 0o111 != 0,
        "status": "missing",
    }
    if record["executable"]:
        found = True
        proc = subprocess.run(
            [
                check_tool,
                "--tool",
                tool,
                "--path",
                str(path),
                "--target",
                target,
                "--arch",
                arch,
                "--libc",
                libc,
            ],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        details = {}
        for line in proc.stdout.splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                details[key] = value
        record["status"] = details.get("status", "unknown")
        record["check"] = details
        if proc.returncode != 0:
            record["check_exit_code"] = proc.returncode
        if proc.stderr:
            record["check_stderr"] = proc.stderr
        meta = path.parent / "metadata.json"
        if meta.exists():
            record["metadata_path"] = str(meta)
            try:
                record["metadata"] = json.loads(meta.read_text(encoding="utf-8"))
            except Exception as exc:  # pragma: no cover - defensive path
                record["metadata_warning"] = str(exc)
    elif record["exists"]:
        record["status"] = "not-executable"
    records.append(record)

doc = {
    "schema": 1,
    "tool": tool,
    "target": target,
    "arch": arch,
    "libc": libc,
    "dest_root": dest_root,
    "overall": "found" if found else "missing",
    "search_paths": records,
}
print(json.dumps(doc, indent=2, sort_keys=True))
PY
    exit 0
fi

paths="
$dest_root/$target/bin/$tool
$dest_root/$arch-$libc/bin/$tool
$dest_root/generic/$arch/bin/$tool
"

found=0
printf 'Search paths:\n'
for path in $paths; do
    printf '  %s' "$path"
    if [ -x "$path" ]; then
        found=1
        printf ' [found]\n'
        scripts/tools/check-dropin-tool --tool "$tool" --path "$path" \
            --target "$target" --arch "$arch" --libc "$libc" | sed 's/^/    /'
        meta=${path%/*}/metadata.json
        if [ -f "$meta" ]; then
            printf '    metadata=%s\n' "$meta"
            if command -v python3 >/dev/null 2>&1; then
                python3 - "$meta" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    data = json.load(fh)

for key in ("sha256", "file"):
    value = data.get(key)
    if value:
        print(f"    metadata_{key}={value}")
PY
            else
                printf '    metadata_detail=python3 unavailable\n'
            fi || printf '    metadata_warning=unreadable metadata\n'
        fi
    elif [ -e "$path" ]; then
        printf ' [not executable]\n'
    else
        printf ' [missing]\n'
    fi
done

if [ "$found" -eq 1 ]; then
    printf 'Overall: found\n'
else
    printf 'Overall: missing\n'
fi
