#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/tools/install-dropin-tool --tool TOOL --source FILE [options]

Options:
  --target NAME
  --arch ARCH
  --libc LIBC
  --dest-root DIR      default: local/tools
  --strict             fail installation on detected arch/endian mismatch
EOF
}

tool=
source=
target=
arch=
libc=
dest_root=local/tools
strict=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tool) tool=$2; shift 2 ;;
        --tool=*) tool=${1#--tool=}; shift ;;
        --source) source=$2; shift 2 ;;
        --source=*) source=${1#--source=}; shift ;;
        --target) target=$2; shift 2 ;;
        --target=*) target=${1#--target=}; shift ;;
        --arch) arch=$2; shift 2 ;;
        --arch=*) arch=${1#--arch=}; shift ;;
        --libc) libc=$2; shift 2 ;;
        --libc=*) libc=${1#--libc=}; shift ;;
        --dest-root) dest_root=$2; shift 2 ;;
        --dest-root=*) dest_root=${1#--dest-root=}; shift ;;
        --strict) strict=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$tool" ] || { usage; exit 2; }
[ -n "$source" ] || { usage; exit 2; }
[ -f "$source" ] || { printf '%s\n' "install-dropin-tool: missing source $source" >&2; exit 1; }

if [ -n "$target" ]; then
    dest_dir="$dest_root/$target/bin"
elif [ -n "$arch" ] && [ -n "$libc" ]; then
    dest_dir="$dest_root/$arch-$libc/bin"
elif [ -n "$arch" ]; then
    dest_dir="$dest_root/generic/$arch/bin"
else
    printf '%s\n' "install-dropin-tool: provide --target, --arch+--libc, or --arch" >&2
    exit 2
fi

mkdir -p "$dest_dir"
dest="$dest_dir/$tool"
cp "$source" "$dest"
chmod 0755 "$dest"

sha=unknown

set -- --tool "$tool" --path "$dest"
[ -z "$target" ] || set -- "$@" --target "$target"
[ -z "$arch" ] || set -- "$@" --arch "$arch"
[ -z "$libc" ] || set -- "$@" --libc "$libc"
if [ "$strict" -eq 1 ]; then
    check_out=$(scripts/tools/check-dropin-tool "$@" --strict --metadata-out "$dest_dir/metadata.json") || {
        rc=$?
        rm -f "$dest" "$dest_dir/metadata.json"
        printf '%s\n' "$check_out"
        exit "$rc"
    }
else
    check_out=$(scripts/tools/check-dropin-tool "$@" --metadata-out "$dest_dir/metadata.json" || true)
fi
sha=$(printf '%s\n' "$check_out" | sed -n 's/^sha256=//p' | sed -n '1p')
printf 'installed=%s\n' "$dest"
printf 'metadata=%s\n' "$dest_dir/metadata.json"
printf 'sha256=%s\n' "$sha"
