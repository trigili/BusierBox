#!/bin/sh
set -eu

usage() {
    cat >&2 <<'EOF'
usage: scripts/tools/check-dropin-tool --tool TOOL --path PATH [options]

Options:
  --target NAME
  --arch ARCH
  --libc LIBC
  --endian little|big|auto
  --metadata-out PATH
  --strict
EOF
}

tool=
path=
target=
arch=
libc=
endian=auto
metadata_out=
strict=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tool) tool=$2; shift 2 ;;
        --tool=*) tool=${1#--tool=}; shift ;;
        --path) path=$2; shift 2 ;;
        --path=*) path=${1#--path=}; shift ;;
        --target) target=$2; shift 2 ;;
        --target=*) target=${1#--target=}; shift ;;
        --arch) arch=$2; shift 2 ;;
        --arch=*) arch=${1#--arch=}; shift ;;
        --libc) libc=$2; shift 2 ;;
        --libc=*) libc=${1#--libc=}; shift ;;
        --endian) endian=$2; shift 2 ;;
        --endian=*) endian=${1#--endian=}; shift ;;
        --metadata-out) metadata_out=$2; shift 2 ;;
        --metadata-out=*) metadata_out=${1#--metadata-out=}; shift ;;
        --strict) strict=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

[ -n "$tool" ] || { usage; exit 2; }
[ -n "$path" ] || { usage; exit 2; }

if [ ! -e "$path" ]; then
    printf 'status=missing\n'
    printf 'path=%s\n' "$path"
    exit 2
fi
if [ ! -x "$path" ]; then
    printf 'status=not-executable\n'
    printf 'path=%s\n' "$path"
    exit 2
fi

file_out=
readelf_h=
if command -v file >/dev/null 2>&1; then
    file_out=$(file "$path" 2>/dev/null || true)
fi
if command -v readelf >/dev/null 2>&1; then
    readelf_h=$(readelf -h "$path" 2>/dev/null || true)
fi

detected_arch=unknown
detected_endian=unknown
dynamic=unknown
interpreter=
sha=unknown

if command -v sha256sum >/dev/null 2>&1; then
    sha=$(sha256sum "$path" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
    sha=$(shasum -a 256 "$path" | awk '{print $1}')
fi

case "$file_out $readelf_h" in
    *MIPS*) detected_arch=mips ;;
    *ARM\ aarch64*|*AArch64*) detected_arch=aarch64 ;;
    *ARM*) detected_arch=armv7 ;;
    *x86-64*|*X86-64*) detected_arch=x86_64 ;;
    *80386*|*Intel\ 80386*) detected_arch=i386 ;;
esac
case "$file_out $readelf_h" in
    *LSB*|*little\ endian*) detected_endian=little ;;
    *MSB*|*big\ endian*) detected_endian=big ;;
esac
case "$file_out" in
    *statically\ linked*) dynamic=no ;;
    *dynamically\ linked*|*interpreter*) dynamic=yes ;;
esac
if command -v readelf >/dev/null 2>&1; then
    interpreter=$(readelf -l "$path" 2>/dev/null | sed -n 's/.*Requesting program interpreter: \(.*\)]/\1/p' | sed -n '1p')
    [ -z "$interpreter" ] || dynamic=yes
fi

warn=
fatal=
case "$arch:$detected_arch" in
    "":*|native:*|*:unknown) ;;
    mipsel:mips|mips:mips) ;;
    armv7:armv7|aarch64:aarch64|x86_64:x86_64|i386:i386) ;;
    *) warn="${warn}${warn:+; }arch mismatch expected=$arch detected=$detected_arch" ;;
esac
if [ "$strict" -eq 1 ] && [ -n "$arch" ] && [ "$arch" != "native" ] && [ "$detected_arch" = "unknown" ]; then
    warn="${warn}${warn:+; }unable to detect arch expected=$arch"
fi
case "$endian:$detected_endian" in
    auto:*|"":*|*:unknown) ;;
    little:little|big:big) ;;
    *) warn="${warn}${warn:+; }endian mismatch expected=$endian detected=$detected_endian" ;;
esac
if [ "$strict" -eq 1 ] && [ "$endian" != "auto" ] && [ -n "$endian" ] && [ "$detected_endian" = "unknown" ]; then
    warn="${warn}${warn:+; }unable to detect endian expected=$endian"
fi

if [ "$strict" -eq 1 ] && [ -n "$warn" ]; then
    fatal=$warn
fi

status=$([ -n "$fatal" ] && printf incompatible || printf ok)

printf 'status=%s\n' "$status"
printf 'tool=%s\n' "$tool"
printf 'path=%s\n' "$path"
printf 'sha256=%s\n' "$sha"
printf 'target=%s\n' "$target"
printf 'expected_arch=%s\n' "$arch"
printf 'expected_libc=%s\n' "$libc"
printf 'detected_arch=%s\n' "$detected_arch"
printf 'detected_endian=%s\n' "$detected_endian"
printf 'dynamic=%s\n' "$dynamic"
printf 'interpreter=%s\n' "$interpreter"
printf 'warning=%s\n' "$warn"

if [ -n "$metadata_out" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$metadata_out" "$status" "$tool" "$path" "$sha" "$target" "$arch" "$libc" "$endian" "$detected_arch" "$detected_endian" "$dynamic" "$interpreter" "$warn" "$file_out" "$readelf_h" <<'PY'
import json
import pathlib
import sys

(
    out,
    status,
    tool,
    path,
    sha,
    target,
    arch,
    libc,
    endian,
    detected_arch,
    detected_endian,
    dynamic,
    interpreter,
    warning,
    file_out,
    readelf_header,
) = sys.argv[1:]

data = {
    "status": status,
    "tool": tool,
    "path": path,
    "sha256": sha,
    "target": target,
    "expected_arch": arch,
    "expected_libc": libc,
    "expected_endian": endian,
    "detected_arch": detected_arch,
    "detected_endian": detected_endian,
    "dynamic": dynamic,
    "interpreter": interpreter,
    "warning": warning,
    "file": file_out,
    "readelf_header": readelf_header,
}
dest = pathlib.Path(out)
dest.parent.mkdir(parents=True, exist_ok=True)
dest.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
    else
        printf '%s\n' "check-dropin-tool: python3 unavailable; cannot write metadata $metadata_out" >&2
    fi
fi

[ -z "$fatal" ] || exit 1
exit 0
