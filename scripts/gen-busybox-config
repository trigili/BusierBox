#!/bin/sh
# scripts/gen-busybox-config — generate a BusyBox .config from GRIT_BUSYBOX_GROUPS
# Usage: GRIT_BUSYBOX_GROUPS="shell fileops network" scripts/gen-busybox-config
# Writes third_party/busybox/.config and runs make olddefconfig.
set -eu

BUSYBOX_DIR="${BUSYBOX_DIR:-third_party/busybox}"
GROUPS="${GRIT_BUSYBOX_GROUPS:-shell fileops disk process network text system}"
APPLETS="${GRIT_BUSYBOX_APPLETS:-}"
OVERRIDES="${GRIT_BUSYBOX_APPLET_OVERRIDES:-}"

if [ ! -d "$BUSYBOX_DIR" ]; then
    printf '%s\n' "gen-busybox-config: $BUSYBOX_DIR not found; run: git submodule update --init" >&2
    exit 1
fi

applet_map() {
    scripts/busybox-applet-map
}

selected_configs() {
    applet_map | awk -v groups="$GROUPS" -v applets="$APPLETS" -v overrides="$OVERRIDES" '
        BEGIN {
            split(groups, g)
            for (i in g) enabled_group[g[i]] = 1
            split(applets, a)
            for (i in a) if (a[i] != "") forced[a[i]] = 1
            split(overrides, o)
            for (i in o) {
                if (o[i] ~ /^\+/) forced[substr(o[i], 2)] = 1
                else if (o[i] ~ /^-/) disabled[substr(o[i], 2)] = 1
                else if (o[i] != "") forced[o[i]] = 1
            }
        }
        ($1 in enabled_group || $2 in forced) && !($2 in disabled) { print $3 }
    '
}

all_mapped_configs() {
    applet_map | awk '{ print $3 }' | sort -u
}

# Start from allnoconfig to ensure we only get what we asked for.
# Then layer our selections on top and let olddefconfig fill in dependencies.
printf '%s\n' "gen-busybox-config: generating config for groups: $GROUPS"

(cd "$BUSYBOX_DIR" && yes "" | make allnoconfig >/dev/null 2>&1) || true

cfg_file="$BUSYBOX_DIR/.config"

# Helper functions to enable symbols and set strings
enable() {
    sym=$1
    if grep -q "^# $sym is not set" "$cfg_file"; then
        sed -i "s/^# $sym is not set/$sym=y/" "$cfg_file"
    elif grep -q "^$sym=" "$cfg_file"; then
        sed -i "s/^$sym=.*/$sym=y/" "$cfg_file"
    else
        printf '%s=y\n' "$sym" >>"$cfg_file"
    fi
}

disable() {
    sym=$1
    if grep -q "^$sym=" "$cfg_file"; then
        sed -i "s/^$sym=.*/# $sym is not set/" "$cfg_file"
    elif ! grep -q "^# $sym is not set" "$cfg_file"; then
        printf '# %s is not set\n' "$sym" >>"$cfg_file"
    fi
}

setstr() {
    sym=$1
    val=$2
    if grep -q "^$sym=" "$cfg_file"; then
        sed -i "s|^$sym=.*|$sym=\"$val\"|" "$cfg_file"
    else
        printf '%s="%s"\n' "$sym" "$val" >>"$cfg_file"
    fi
}

# Enable required infrastructure
for sym in CONFIG_STATIC CONFIG_INSTALL_NO_USR CONFIG_BUSYBOX CONFIG_SHOW_USAGE CONFIG_FEATURE_VERBOSE_USAGE CONFIG_LONG_OPTS CONFIG_FEATURE_PREFER_APPLETS; do
    enable "$sym"
done

# Disable feature individual
if grep -q "CONFIG_FEATURE_INDIVIDUAL=" "$cfg_file"; then
    sed -i "s/^CONFIG_FEATURE_INDIVIDUAL=.*/CONFIG_FEATURE_INDIVIDUAL=n/" "$cfg_file"
fi

setstr CONFIG_CROSS_COMPILER_PREFIX ""
setstr CONFIG_BUSYBOX_EXEC_PATH "/proc/self/exe"

# Enable selected applets
for sym_name in $(all_mapped_configs); do
    disable "$sym_name"
done
for sym in $(selected_configs | sort -u); do
    enable "$sym"
done

# Resolve dependencies
(cd "$BUSYBOX_DIR" && yes "" | make oldconfig >/dev/null 2>&1)

n_applets=$(selected_configs | sort -u | wc -l)
printf '%s\n' "gen-busybox-config: config written ($n_applets applet entries, dependencies resolved)"
