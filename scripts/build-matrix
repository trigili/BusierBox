#!/usr/bin/env python3
"""Build or plan griTTYkit target/payload matrices."""

import argparse
import datetime as dt
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys

import grit_matrix as matrix

ROOT = pathlib.Path(__file__).resolve().parents[1]


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def command_for(job, config, args):
    env = {
        "GRIT_CONFIG": str(config),
        "PAYLOAD_FORMAT": job["format"],
    }
    if args.offline:
        env["GRIT_OFFLINE"] = "1"
    if args.mirror_dir:
        mirror = pathlib.Path(args.mirror_dir)
        env["GRIT_MIRROR_DIR"] = str(mirror)
        env["BUILDROOT_DL_DIR"] = str(mirror / "buildroot-dl")
    if args.buildroot_output_base:
        env["BUILDROOT_OUTPUT_BASE"] = args.buildroot_output_base
    prefix = " ".join(f"{key}={matrix.shell_quote(value)}" for key, value in sorted(env.items()))
    return f"{prefix} scripts/package-target {matrix.shell_quote(job['target'])}"


def run_job(job, run_dir, args):
    config_dir = run_dir / "configs"
    artifact_dir = run_dir / "artifacts"
    log_dir = run_dir / "logs"
    config_dir.mkdir(parents=True, exist_ok=True)
    artifact_dir.mkdir(parents=True, exist_ok=True)
    log_dir.mkdir(parents=True, exist_ok=True)

    stem = f"{job['target']}-{job['payload']}-{job['format']}"
    config = config_dir / f"{stem}.conf"
    log = log_dir / f"{stem}.log"
    matrix.write_config(config, job["target"], job["payload"], job["format"], job["variant"])
    try:
        resolved = matrix.resolve_target(job["target"], config=config)
    except RuntimeError as exc:
        if args.dry_run:
            resolved = {"TARGET_NAME": job["target"], "TARGET_ARCH": "unknown"}
        else:
            raise SystemExit(f"build-matrix: {exc}")
    resolved_target = resolved.get("TARGET_NAME") or job["target"]
    cmd_text = command_for(job, config, args)
    record = {
        "name": job["name"],
        "target": job["target"],
        "resolved_target": resolved_target,
        "payload": job["payload"],
        "format": job["format"],
        "config": str(config),
        "command": cmd_text,
        "log": str(log),
    }
    if args.dry_run:
        record["status"] = "dry-run"
        return record

    env = os.environ.copy()
    env["GRIT_CONFIG"] = str(config)
    env["PAYLOAD_FORMAT"] = job["format"]
    if args.offline:
        env["GRIT_OFFLINE"] = "1"
    if args.mirror_dir:
        mirror = pathlib.Path(args.mirror_dir)
        env["GRIT_MIRROR_DIR"] = str(mirror)
        env["BUILDROOT_DL_DIR"] = str(mirror / "buildroot-dl")
    if args.buildroot_output_base:
        env["BUILDROOT_OUTPUT_BASE"] = args.buildroot_output_base

    with open(log, "w", encoding="utf-8") as fh:
        proc = subprocess.run(
            [str(ROOT / "scripts" / "package-target"), job["target"]],
            cwd=ROOT,
            env=env,
            stdout=fh,
            stderr=subprocess.STDOUT,
            check=False,
        )
    record["exit_code"] = proc.returncode
    if proc.returncode != 0:
        record["status"] = "fail"
        return record

    source = ROOT / "dist" / f"grit-{resolved_target}-full"
    if not source.exists():
        record["status"] = "fail"
        record["reason"] = f"missing artifact {source}"
        return record
    dest = artifact_dir / f"grit-{resolved_target}-{job['payload']}-{job['format']}-full"
    shutil.copy2(source, dest)
    digest = sha256_file(dest)
    (dest.with_suffix(dest.suffix + ".sha256")).write_text(f"{digest}  {dest.name}\n", encoding="utf-8")
    record.update({
        "status": "pass",
        "artifact": str(dest),
        "size": dest.stat().st_size,
        "sha256": digest,
    })
    return record


def write_summary(path, run_dir, args, records):
    summary = {
        "schema": 1,
        "run_dir": str(run_dir),
        "dry_run": bool(args.dry_run),
        "offline": bool(args.offline),
        "mirror_dir": args.mirror_dir,
        "buildroot_dl_dir": str(pathlib.Path(args.mirror_dir) / "buildroot-dl") if args.mirror_dir else None,
        "matrix": matrix.matrix_identity(args),
        "jobs_requested": len(records),
        "jobs": records,
    }
    path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def print_table(records):
    print(f"{'Status':<8} {'Target':<36} {'Payload':<20} {'Format':<6} Artifact")
    for rec in records:
        print(
            f"{rec.get('status',''):<8} {rec['target']:<36} {rec['payload']:<20} "
            f"{rec['format']:<6} {rec.get('artifact','')}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list-targets", action="store_true")
    parser.add_argument("--list-payloads", action="store_true")
    parser.add_argument("--targets", help="comma-separated targets, or all")
    parser.add_argument("--payloads", help="comma-separated payload presets, or all")
    parser.add_argument("--payload-presets", dest="payload_presets", help="alias for --payloads")
    parser.add_argument("--formats", help="comma-separated formats; default tgz or matrix formats")
    parser.add_argument("--matrix", help="matrix JSON file")
    parser.add_argument("--jobs", type=int, default=1, help="accepted for CLI compatibility; builds are serialized")
    parser.add_argument("--fail-fast", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--run-dir", help="run directory under local/matrix-runs by default")
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--mirror-dir")
    parser.add_argument("--skip-offline-preflight", action="store_true")
    parser.add_argument("--strict-offline", action="store_true")
    parser.add_argument("--buildroot-output-base")
    args = parser.parse_args()

    if args.list_targets:
        print("\n".join(matrix.list_targets()))
        return 0
    if args.list_payloads:
        print("\n".join(matrix.list_payloads()))
        return 0
    if args.jobs != 1:
        print("build-matrix: --jobs is accepted, but builds are serialized to avoid shared output collisions", file=sys.stderr)

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S")
    run_dir = pathlib.Path(args.run_dir) if args.run_dir else ROOT / "local" / "matrix-runs" / stamp
    run_dir.mkdir(parents=True, exist_ok=True)
    records = []
    if args.offline and not args.mirror_dir:
        args.mirror_dir = os.environ.get("GRIT_MIRROR_DIR")
    if args.offline and not args.mirror_dir:
        raise SystemExit("build-matrix: --offline requires --mirror-dir or GRIT_MIRROR_DIR")
    if args.offline and not args.dry_run and not args.skip_offline_preflight:
        preflight = [str(ROOT / "scripts" / "check-offline-readiness"), "--mirror", args.mirror_dir]
        if args.strict_offline:
            preflight.append("--strict")
        if args.matrix:
            preflight.extend(["--matrix", args.matrix])
        else:
            if args.targets:
                preflight.extend(["--targets", args.targets])
            if args.payloads:
                preflight.extend(["--payloads", args.payloads])
            if args.payload_presets:
                preflight.extend(["--payload-presets", args.payload_presets])
            if args.formats:
                preflight.extend(["--formats", args.formats])
        proc = subprocess.run(preflight, cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr)
            raise SystemExit("build-matrix: offline preflight failed; rerun mirror-sources online or use --skip-offline-preflight")

    for job in matrix.expand_jobs(args):
        rec = run_job(job, run_dir, args)
        records.append(rec)
        if args.fail_fast and rec.get("status") == "fail":
            break
    write_summary(run_dir / "summary.json", run_dir, args, records)
    print_table(records)
    print(f"summary={run_dir / 'summary.json'}")
    return 1 if any(rec.get("status") == "fail" for rec in records) else 0


if __name__ == "__main__":
    raise SystemExit(main())
