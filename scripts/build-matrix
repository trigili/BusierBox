#!/usr/bin/env python3
"""Build or plan BusierBox target/payload matrices."""

import argparse
import csv
import datetime as dt
import hashlib
import json
import os
import pathlib
import shlex
import shutil
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
PAYLOAD_PRESETS = ROOT / "presets" / "payload"


def csv_items(value):
    if not value:
        return []
    return [item.strip() for item in value.split(",") if item.strip()]


def list_targets():
    proc = subprocess.run(
        [str(ROOT / "scripts" / "resolve-target"), "--list"],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        check=True,
    )
    targets = []
    for row in csv.reader(proc.stdout.splitlines(), delimiter="\t"):
        if len(row) >= 2 and row[1] == "supported":
            targets.append(row[0])
    return targets


def list_payloads():
    return sorted(path.stem for path in PAYLOAD_PRESETS.glob("*.conf"))


def load_matrix(path):
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def write_config(path, target, payload, fmt, variant=None):
    preset = PAYLOAD_PRESETS / f"{payload}.conf"
    if not preset.exists():
        raise SystemExit(f"build-matrix: missing payload preset {payload}")
    text = preset.read_text(encoding="utf-8")
    variant = variant or {}
    lines = [
        text.rstrip(),
        "",
        "# generated by scripts/build-matrix",
        f"BB_TARGET_PRESET={shell_quote(target)}",
        f"BB_PAYLOAD_PRESET={shell_quote(payload)}",
        f"PAYLOAD_FORMAT={shell_quote(fmt)}",
    ]
    for key, value in sorted(variant.items()):
        if key in {"target", "payload", "payload_preset", "format", "formats"}:
            continue
        if isinstance(value, bool):
            value = "yes" if value else "no"
        lines.append(f"{key}={shell_quote(value)}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def expand_jobs(args):
    matrix = load_matrix(args.matrix) if args.matrix else {}
    targets = csv_items(args.targets) or matrix.get("targets") or ["native"]
    payloads = csv_items(args.payloads) or matrix.get("payloads") or ["default"]
    formats = csv_items(args.formats) or matrix.get("formats") or ["tgz"]
    if targets == ["all"]:
        targets = list_targets()
    if payloads == ["all"]:
        payloads = list_payloads()

    jobs = []
    for target in targets:
        for payload in payloads:
            for fmt in formats:
                jobs.append({
                    "name": f"{target}-{payload}-{fmt}",
                    "target": target,
                    "payload": payload,
                    "format": fmt,
                    "variant": {},
                })

    variants = matrix.get("variants") or {}
    for name, data in sorted(variants.items()):
        v_targets = data.get("targets") or ([data.get("target")] if data.get("target") else targets)
        v_payloads = data.get("payloads") or ([data.get("payload_preset") or data.get("payload")] if (data.get("payload_preset") or data.get("payload")) else payloads)
        v_formats = data.get("formats") or ([data.get("format")] if data.get("format") else formats)
        for target in v_targets:
            for payload in v_payloads:
                for fmt in v_formats:
                    jobs.append({
                        "name": name,
                        "target": target,
                        "payload": payload,
                        "format": fmt,
                        "variant": data,
                    })
    return jobs


def shell_quote(value):
    return shlex.quote(str(value))


def command_for(job, config, args):
    env = {
        "BUSIERBOX_CONFIG": str(config),
        "PAYLOAD_FORMAT": job["format"],
    }
    if args.offline:
        env["BUSIERBOX_OFFLINE"] = "1"
    if args.mirror_dir:
        mirror = pathlib.Path(args.mirror_dir)
        env["BUSIERBOX_MIRROR_DIR"] = str(mirror)
        env["BUILDROOT_DL_DIR"] = str(mirror / "buildroot-dl")
    if args.buildroot_output_base:
        env["BUILDROOT_OUTPUT_BASE"] = args.buildroot_output_base
    prefix = " ".join(f"{key}={shell_quote(value)}" for key, value in sorted(env.items()))
    return f"{prefix} scripts/package-target {shell_quote(job['target'])}"


def run_job(job, run_dir, args):
    config_dir = run_dir / "configs"
    artifact_dir = run_dir / "artifacts"
    log_dir = run_dir / "logs"
    config_dir.mkdir(parents=True, exist_ok=True)
    artifact_dir.mkdir(parents=True, exist_ok=True)
    log_dir.mkdir(parents=True, exist_ok=True)

    stem = f"{job['target']}-{job['payload']}-{job['format']}"
    config = config_dir / f"{stem}.conf"
    log = log_dir / f"{stem}.log"
    write_config(config, job["target"], job["payload"], job["format"], job["variant"])
    cmd_text = command_for(job, config, args)
    record = {
        "name": job["name"],
        "target": job["target"],
        "payload": job["payload"],
        "format": job["format"],
        "config": str(config),
        "command": cmd_text,
        "log": str(log),
    }
    if args.dry_run:
        record["status"] = "dry-run"
        return record

    env = os.environ.copy()
    env["BUSIERBOX_CONFIG"] = str(config)
    env["PAYLOAD_FORMAT"] = job["format"]
    if args.offline:
        env["BUSIERBOX_OFFLINE"] = "1"
    if args.mirror_dir:
        mirror = pathlib.Path(args.mirror_dir)
        env["BUSIERBOX_MIRROR_DIR"] = str(mirror)
        env["BUILDROOT_DL_DIR"] = str(mirror / "buildroot-dl")
    if args.buildroot_output_base:
        env["BUILDROOT_OUTPUT_BASE"] = args.buildroot_output_base

    with open(log, "w", encoding="utf-8") as fh:
        proc = subprocess.run(
            [str(ROOT / "scripts" / "package-target"), job["target"]],
            cwd=ROOT,
            env=env,
            stdout=fh,
            stderr=subprocess.STDOUT,
            check=False,
        )
    record["exit_code"] = proc.returncode
    if proc.returncode != 0:
        record["status"] = "fail"
        return record

    source = ROOT / "dist" / f"busierbox-{job['target']}-full"
    if not source.exists():
        record["status"] = "fail"
        record["reason"] = f"missing artifact {source}"
        return record
    dest = artifact_dir / f"busierbox-{job['target']}-{job['payload']}-full"
    shutil.copy2(source, dest)
    digest = sha256_file(dest)
    (dest.with_suffix(dest.suffix + ".sha256")).write_text(f"{digest}  {dest.name}\n", encoding="utf-8")
    record.update({
        "status": "pass",
        "artifact": str(dest),
        "size": dest.stat().st_size,
        "sha256": digest,
    })
    return record


def write_summary(path, run_dir, args, records):
    summary = {
        "schema": 1,
        "run_dir": str(run_dir),
        "dry_run": bool(args.dry_run),
        "offline": bool(args.offline),
        "mirror_dir": args.mirror_dir,
        "buildroot_dl_dir": str(pathlib.Path(args.mirror_dir) / "buildroot-dl") if args.mirror_dir else None,
        "jobs_requested": len(records),
        "jobs": records,
    }
    path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def print_table(records):
    print(f"{'Status':<8} {'Target':<36} {'Payload':<20} {'Format':<6} Artifact")
    for rec in records:
        print(
            f"{rec.get('status',''):<8} {rec['target']:<36} {rec['payload']:<20} "
            f"{rec['format']:<6} {rec.get('artifact','')}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list-targets", action="store_true")
    parser.add_argument("--list-payloads", action="store_true")
    parser.add_argument("--targets", help="comma-separated targets, or all")
    parser.add_argument("--payloads", help="comma-separated payload presets, or all")
    parser.add_argument("--formats", default="tgz", help="comma-separated formats; default tgz")
    parser.add_argument("--matrix", help="matrix JSON file")
    parser.add_argument("--jobs", type=int, default=1, help="accepted for CLI compatibility; builds are serialized")
    parser.add_argument("--fail-fast", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--run-dir", help="run directory under local/matrix-runs by default")
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--mirror-dir")
    parser.add_argument("--buildroot-output-base")
    args = parser.parse_args()

    if args.list_targets:
        print("\n".join(list_targets()))
        return 0
    if args.list_payloads:
        print("\n".join(list_payloads()))
        return 0
    if args.jobs != 1:
        print("build-matrix: --jobs is accepted, but builds are serialized to avoid shared output collisions", file=sys.stderr)

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S")
    run_dir = pathlib.Path(args.run_dir) if args.run_dir else ROOT / "local" / "matrix-runs" / stamp
    run_dir.mkdir(parents=True, exist_ok=True)
    records = []
    for job in expand_jobs(args):
        rec = run_job(job, run_dir, args)
        records.append(rec)
        if args.fail_fast and rec.get("status") == "fail":
            break
    write_summary(run_dir / "summary.json", run_dir, args, records)
    print_table(records)
    print(f"summary={run_dir / 'summary.json'}")
    return 1 if any(rec.get("status") == "fail" for rec in records) else 0


if __name__ == "__main__":
    raise SystemExit(main())
